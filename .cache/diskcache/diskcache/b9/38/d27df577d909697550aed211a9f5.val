elated_name", "qualified_name": "test_recursive_m2m_add_via_related_name", "args": ["self"], "decorators": [], "docstring": "", "start_line": 126, "end_line": 142, "is_async": false, "is_method": false}, {"name": "test_recursive_m2m_add_in_both_directions", "qualified_name": "test_recursive_m2m_add_in_both_directions", "args": ["self"], "decorators": [], "docstring": "Adding the same relation twice results in a single relation.", "start_line": 144, "end_line": 162, "is_async": false, "is_method": false}, {"name": "test_recursive_m2m_related_to_self", "qualified_name": "test_recursive_m2m_related_to_self", "args": ["self"], "decorators": [], "docstring": "", "start_line": 164, "end_line": 182, "is_async": false, "is_method": false}], "classes": [{"name": "RecursiveM2MTests", "bases": ["TestCase"], "methods": ["setUpTestData", "test_recursive_m2m_all", "test_recursive_m2m_reverse_add", "test_recursive_m2m_remove", "test_recursive_m2m_clear", "test_recursive_m2m_add_via_related_name", "test_recursive_m2m_add_in_both_directions", "test_recursive_m2m_related_to_self"], "docstring": "", "start_line": 8, "end_line": 182}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "tests/m2m_recursive/__init__.py", "file_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "tests/m2m_recursive/models.py", "file_hash": "905f772b830b6ca05957c8a09b797e29b9e5bcc746cfeb0ff09f8441cde7739c", "imports": [{"module": "django.db", "names": ["models"], "is_from": true, "alias": ""}], "functions": [{"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 27, "end_line": 28, "is_async": false, "is_method": false}], "classes": [{"name": "Person", "bases": ["models.Model"], "methods": ["__str__"], "docstring": "", "start_line": 22, "end_line": 28}], "calls": [], "module_docstring": "Many-to-many relationships between the same two tables\n\nIn this example, a ``Person`` can have many friends, who are also ``Person``\nobjects. Friendship is a symmetrical relationship - if I am your friend, you\nare my friend. Here, ``friends`` is an example of a symmetrical\n``ManyToManyField``.\n\nA ``Person`` can also have many idols - but while I may idolize you, you may\nnot think the same of me. Here, ``idols`` is an example of a non-symmetrical\n``ManyToManyField``. Only recursive ``ManyToManyField`` fields may be\nnon-symmetrical, and they are symmetrical by default.\n\nThis test validates that the many-to-many table is created using a mangled name\nif there is a name clash, and tests that symmetry is preserved where\nappropriate.", "parse_error": ""}, {"file_path": "tests/requests/tests.py", "file_hash": "929fd437ef9307511504a7bf63e0ad02e3aed26e0c682a35003554c59aad2b6f", "imports": [{"module": "io", "names": ["BytesIO"], "is_from": true, "alias": ""}, {"module": "itertools", "names": ["chain"], "is_from": true, "alias": ""}, {"module": "urllib.parse", "names": ["urlencode"], "is_from": true, "alias": ""}, {"module": "django.core.exceptions", "names": ["DisallowedHost"], "is_from": true, "alias": ""}, {"module": "django.core.handlers.wsgi", "names": ["LimitedStream", "WSGIRequest"], "is_from": true, "alias": ""}, {"module": "django.http", "names": ["HttpRequest", "RawPostDataException", "UnreadablePostError"], "is_from": true, "alias": ""}, {"module": "django.http.request", "names": ["HttpHeaders", "split_domain_port"], "is_from": true, "alias": ""}, {"module": "django.test", "names": ["RequestFactory", "SimpleTestCase", "override_settings"], "is_from": true, "alias": ""}, {"module": "django.test.client", "names": ["FakePayload"], "is_from": true, "alias": ""}], "functions": [{"name": "test_httprequest", "qualified_name": "test_httprequest", "args": ["self"], "decorators": [], "docstring": "", "start_line": 14, "end_line": 29, "is_async": false, "is_method": false}, {"name": "test_httprequest_full_path", "qualified_name": "test_httprequest_full_path", "args": ["self"], "decorators": [], "docstring": "", "start_line": 31, "end_line": 38, "is_async": false, "is_method": false}, {"name": "test_httprequest_full_path_with_query_string_and_fragment", "qualified_name": "test_httprequest_full_path_with_query_string_and_fragment", "args": ["self"], "decorators": [], "docstring": "", "start_line": 40, "end_line": 46, "is_async": false, "is_method": false}, {"name": "test_httprequest_repr", "qualified_name": "test_httprequest_repr", "args": ["self"], "decorators": [], "docstring": "", "start_line": 48, "end_line": 56, "is_async": false, "is_method": false}, {"name": "test_httprequest_repr_invalid_method_and_path", "qualified_name": "test_httprequest_repr_invalid_method_and_path", "args": ["self"], "decorators": [], "docstring": "", "start_line": 58, "end_line": 66, "is_async": false, "is_method": false}, {"name": "test_wsgirequest", "qualified_name": "test_wsgirequest", "args": ["self"], "decorators": [], "docstring": "", "start_line": 68, "end_line": 86, "is_async": false, "is_method": false}, {"name": "test_wsgirequest_with_script_name", "qualified_name": "test_wsgirequest_with_script_name", "args": ["self"], "decorators": [], "docstring": "The request's path is correctly assembled, regardless of whether or\nnot the SCRIPT_NAME has a trailing slash (#20169).", "start_line": 88, "end_line": 108, "is_async": false, "is_method": false}, {"name": "test_wsgirequest_script_url_double_slashes", "qualified_name": "test_wsgirequest_script_url_double_slashes", "args": ["self"], "decorators": [], "docstring": "WSGI squashes multiple successive slashes in PATH_INFO, WSGIRequest\nshould take that into account when populating request.path and\nrequest.META['SCRIPT_NAME'] (#17133).", "start_line": 110, "end_line": 123, "is_async": false, "is_method": false}, {"name": "test_wsgirequest_with_force_script_name", "qualified_name": "test_wsgir