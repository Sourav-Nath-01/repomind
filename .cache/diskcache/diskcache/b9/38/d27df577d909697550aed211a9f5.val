perty"], "docstring": "Return the field precisions for the features.", "start_line": 158, "end_line": 161, "is_async": false, "is_method": false}, {"name": "_get_spatial_filter", "qualified_name": "_get_spatial_filter", "args": ["self"], "decorators": [], "docstring": "", "start_line": 163, "end_line": 167, "is_async": false, "is_method": false}, {"name": "_set_spatial_filter", "qualified_name": "_set_spatial_filter", "args": ["self", "filter"], "decorators": [], "docstring": "", "start_line": 169, "end_line": 182, "is_async": false, "is_method": false}, {"name": "get_fields", "qualified_name": "get_fields", "args": ["self", "field_name"], "decorators": [], "docstring": "Return a list containing the given field name for every Feature\nin the Layer.", "start_line": 187, "end_line": 194, "is_async": false, "is_method": false}, {"name": "get_geoms", "qualified_name": "get_geoms", "args": ["self", "geos"], "decorators": [], "docstring": "Return a list containing the OGRGeometry for every Feature in\nthe Layer.", "start_line": 196, "end_line": 205, "is_async": false, "is_method": false}, {"name": "test_capability", "qualified_name": "test_capability", "args": ["self", "capability"], "decorators": [], "docstring": "Return a bool indicating whether the this Layer supports the given\ncapability (a string).  Valid capability strings include:\n  'RandomRead', 'SequentialWrite', 'RandomWrite', 'FastSpatialFilter',\n  'FastFeatureCount', 'FastGetExtent', 'CreateField', 'Transactions',\n  'DeleteFeature', and 'FastSetNex", "start_line": 207, "end_line": 215, "is_async": false, "is_method": false}], "classes": [{"name": "Layer", "bases": ["GDALBase"], "methods": ["__init__", "__getitem__", "__iter__", "__len__", "__str__", "_make_feature", "extent", "name", "num_feat", "num_fields", "geom_type", "srs", "fields", "field_types", "field_widths", "field_precisions", "_get_spatial_filter", "_set_spatial_filter", "get_fields", "get_geoms", "test_capability"], "docstring": "A class that