cstring": "Return the WKB of this Geometry in hexadecimal form. Please note\nthat the SRID is not included in this representation because it is not\na part of the OGC specification (use the `hexewkb` property instead).", "start_line": 363, "end_line": 371, "is_async": false, "is_method": false}, {"name": "hexewkb", "qualified_name": "hexewkb", "args": ["self"], "decorators": ["property"], "docstring": "Return the EWKB of this Geometry in hexadecimal form. This is an\nextension of the WKB specification that includes SRID value that are\na part of this geometry.", "start_line": 374, "end_line": 380, "is_async": false, "is_method": false}, {"name": "json", "qualified_name": "json", "args": ["self"], "decorators": ["property"], "docstring": "Return GeoJSON representation of this Geometry.", "start_line": 383, "end_line": 387, "is_async": false, "is_method": false}, {"name": "wkb", "qualified_name": "wkb", "args": ["self"], "decorators": ["property"], "docstring": "Return the WKB (Well-Known Binary) representation of this Geometry\nas a Python buffer.  SRID and Z values are not included, use the\n`ewkb` property instead.", "start_line": 391, "end_line": 397, "is_async": false, "is_method": false}, {"name": "ewkb", "qualified_name": "ewkb", "args": ["self"], "decorators": ["property"], "docstring": "Return the EWKB representation of this Geometry as a Python buffer.\nThis is an extension of the WKB specification that includes any SRID\nvalue that are a part of this geometry.", "start_line": 400, "end_line": 406, "is_async": false, "is_method": false}, {"name": "kml", "qualified_name": "kml", "args": ["self"], "decorators": ["property"], "docstring": "Return the KML representation of this Geometry.", "start_line": 409, "end_line": 412, "is_async": false, "is_method": false}, {"name": "prepared", "qualified_name": "prepared", "args": ["self"], "decorators": ["property"], "docstring": "Return a PreparedGeometry corresponding to this geometry -- it is\noptimized for the contains, intersects, and covers operations.", "start_line": 415, "end_line": 420, "is_async": false, "is_method": false}, {"name": "_ogr_ptr", "qualified_name": "_ogr_ptr", "args": ["self"], "decorators": [], "docstring": "", "start_line": 423, "end_line": 424, "is_async": false, "is_method": false}, {"name": "ogr", "qualified_name": "ogr", "args": ["self"], "decorators": ["property"], "docstring": "Return the OGR Geometry for this Geometry.", "start_line": 427, "end_line": 429, "is_async": false, "is_method": false}, {"name": "srs", "qualified_name": "srs", "args": ["self"], "decorators": ["property"], "docstring": "Return the OSR SpatialReference for SRID of this Geometry.", "start_line": 432, "end_line": 439, "is_async": false, "is_method": false}, {"name": "crs", "qualified_name": "crs", "args": ["self"], "decorators": ["property"], "docstring": "Alias for `srs` property.", "start_line": 442, "end_line": 444, "is_async": false, "is_method": false}, {"name": "transform", "qualified_name": "transform", "args": ["self", "ct", "clone"], "decorators": [], "docstring": "Requires GDAL. Transform the geometry according to the given\ntransformation object, which may be an integer SRID, and WKT or\nPROJ.4 string. By default, transform the geometry in-place and return\nnothing. However if the `clone` keyword is set, don't modify the\ngeometry and return a transformed clone ", "start_line": 446, "end_line": 486, "is_async": false, "is_method": false}, {"name": "_topology", "qualified_name": "_topology", "args": ["self", "gptr"], "decorators": [], "docstring": "Return Geometry from the given pointer.", "start_line": 489, "end_line": 491, "is_async": false, "is_method": false}, {"name": "boundary", "qualified_name": "boundary", "args": ["self"], "decorators": ["property"], "docstring": "Return the boundary as a newly allocated Geometry object.", "start_line": 494, "end_line": 496, "is_async": false, "is_method": false}, {"name": "buffer", "qualified_name": "buffer", "args": ["self", "width", "quadsegs"], "decorators": [], "docstring": "Return a geometry that represents all points whose distance from this\nGeometry is less than or equal to distance. Calculations are in the\nSpatial Reference System of this Geometry. The optional third parameter sets\nthe number of segment used to approximate a quarter circle (defaults to 8).\n(Text fro", "start_line": 498, "end_line": 506, "is_async": false, "is_method": false}, {"name": "buffer_with_style", "qualified_name": "buffer_with_style", "args": ["self", "width", "quadsegs", "end_cap_style", "join_style", "mitre_limit"], "decorators": [], "docstring": "Same as buffer() but allows customizing the style of the buffer.\n\nEnd cap style can be round (1), flat (2), or square (3).\nJoin style can be round (1), mitre (2), or bevel (3).\nMitre ratio limit only affects mitered join style.", "start_line": 508, "end_line": 518, "is_async": false, "is_method": false}, {"name": "centroid", "qualified_name": "centroid", "args": ["self"], "decorators": ["property"], "docstring": "The centroid is equal to the centroid of the set of component Geometries\nof highest dimension (since the lower-dimension geometries contribute zero\n\"weight\" to the centroid).", "start_line": 521, "end_line": 527, "is_async": false, "is_method": false}, {"name": "convex_hull", "qualified_name": "convex_hull", "args": ["self"], "decorators": ["property"], "docstring": "Return the smallest convex Polygon that contains all the points\nin the Geometry.", "start_line": 530, "end_line": 535, "is_async": false, "is_method": false}, {"name": "difference", "qualified_name": "difference", "args": ["self", "other"], "decorators": [], "docstring": "Return a Geometry representing the points making up this Geometry\nthat do not make up other.", "start_line": 537, "end_line": 542, "is_async": false, "is_method": false}, {"name": "envelope", "qualified_name": "envelope", "args": ["self"], "decorators": ["property"], "docstring": "Return the envelope for this geometry (a polygon).", "start_line": 545, "end_line": 547, "is_async": false, "is_method": false}, {"name": "intersection", "qualified_name": "intersection", "args": ["self", "other"], "decorators": [], "docstring": "Return a Geometry representing the points shared by this Geometry and other.", "start_line": 549, "end_line": 551, "is_async": false, "is_method": false}, {"name": "point_on_surface", "qualified_name": "point_on_surface", "args": ["self"], "decorators": ["property"], "docstring": "Compute an interior point of this Geometry.", "start_line": 554, "end_line": 556, "is_async": false, "is_method": false}, {"name": "relate", "qualified_name": "relate", "args": ["self", "other"], "decorators": [], "docstring": "Return the DE-9IM intersection matrix for this Geometry and the other.", "start_line": 558, "end_line": 560, "is_async": false, "is_method": false}, {"name": "simplify", "qualified_name": "simplify", "args": ["self", "tolerance", "preserve_topology"], "decorators": [], "docstring": "Return the Geometry, simplified using the Douglas-Peucker algorithm\nto the specified tolerance (higher tolerance => less points).  If no\ntolerance provided, defaults to 0.\n\nBy default, don't preserve topology - e.g. polygons can be split,\ncollapse to lines or disappear holes can be created or disapp", "start_line": 562, "end_line": 577, "is_async": false, "is_method": false}, {"name": "sym_difference", "qualified_name": "sym_difference", "args": ["self", "other"], "decorators": [], "docstring": "Return a set combining the points in this Geometry not in other,\nand the points in other not in this Geometry.", "start_line": 579, "end_line": 584, "is_async": false, "is_method": false}, {"name": "unary_union", "qualified_name": "unary_union", "args": ["self"], "decorators": ["property"], "docstring": "Return the union of all the elements of this geometry.", "start_line": 587, "end_line": 589, "is_async": false, "is_method": false}, {"name": "union", "qualified_name": "union", "args": ["self", "other"], "decorators": [], "docstring": "Return a Geometry representing all the points in this Geometry and other.", "start_line": 591, "end_line": 593, "is_async": false, "is_method": false}, {"name": "area", "qualified_name": "area", "args": ["self"], "decorators": ["property"], "docstring": "Return the area of the Geometry.", "start_line": 597, "end_line": 599, "is_async": false, "is_method": false}, {"name": "distance", "qualified_name": "distance", "args": ["self", "other"], "decorators": [], "docstring": "Return the distance between the closest points on this Geometry\nand the other. Units will be in those of the coordinate system of\nthe Geometry.", "start_line": 601, "end_line": 609, "is_async": false, "is_method": false}, {"name": "extent", "qualified_name": "extent", "args": ["self"], "decorators": ["property"], "docstring": "Return the extent of this geometry as a 4-tuple, consisting of\n(xmin, ymin, xmax, ymax).", "start_line": 612, "end_line": 625, "is_async": false, "is_method": false}, {"name": "length", "qualified_name": "length", "args": ["self"], "decorators": ["property"], "docstring": "Return the length of this Geometry (e.g., 0 for point, or the\ncircumference of a Polygon).", "start_line": 628, "end_line": 633, "is_async": false, "is_method": false}, {"name": "clone", "qualified_name": "clone", "args": ["self"], "decorators": [], "docstring": "Clone this Geometry.", "start_line": 635, "end_line": 637, "is_async": false, "is_method": false}, {"name": "interpolate", "qualified_name": "interpolate", "args": ["self", "distance"], "decorators": [], "docstring": "", "start_line": 644, "end_line": 645, "is_async": false, "is_method": false}, {"name": "interpolate_normalized", "qualified_name": "interpolate_normalized", "args": ["self", "distance"], "decorators": [], "docstring": "", "start_line": 647, "end_line": 648, "is_async": false, "is_method": false}, {"name": "project", "qualified_name": "project", "args": ["self", 