header_query"], "decorators": [], "docstring": "Check to see if the response has a given header name in its Vary header.", "start_line": 276, "end_line": 284, "is_async": false, "is_method": false}, {"name": "_i18n_cache_key_suffix", "qualified_name": "_i18n_cache_key_suffix", "args": ["request", "cache_key"], "decorators": [], "docstring": "If necessary, add the current locale or time zone to the cache key.", "start_line": 287, "end_line": 296, "is_async": false, "is_method": false}, {"name": "_generate_cache_key", "qualified_name": "_generate_cache_key", "args": ["request", "method", "headerlist", "key_prefix"], "decorators": [], "docstring": "Return a cache key from the headers given in the header list.", "start_line": 299, "end_line": 309, "is_async": false, "is_method": false}, {"name": "_generate_cache_header_key", "qualified_name": "_generate_cache_header_key", "args": ["key_prefix", "request"], "decorators": [], "docstring": "Return a cache key for the header cache.", "start_line": 312, "end_line": 317, "is_async": false, "is_method": false}, {"name": "get_cache_key", "qualified_name": "get_cache_key", "args": ["request", "key_prefix", "method", "cache"], "decorators": [], "docstring": "Return a cache key based on the request URL and query. It can be used\nin the request phase because it pulls the list of headers to take into\naccount from the global URL registry and uses those to build a cache key\nto check against.\n\nIf there isn't a headerlist stored, return None, indicating that th", "start_line": 320, "end_line": 339, "is_async": false, "is_method": false}, {"name": "learn_cache_key", "qualified_name": "learn_cache_key", "args": ["request", "response", "cache_timeout", "key_prefix", "cache"], "decorators": [], "docstring": "Learn what headers to take into account for some request URL from the\nresponse object. Store those headers in a global URL registry so that\nlater access to that URL will know what headers to take into account\nwithout building the response object itself. The headers are named in the\nVary header of th", "start_line": 342, "end_line": 380, "is_async": false, "is_method": false}, {"name": "_to_tuple", "qualified_name": "_to_tuple", "args": ["s"], "decorators": [], "docstring": "", "start_line": 383, "end_line": 387, "is_async": false, "is_method": false}, {"name": "dictitem", "qualified_name": "dictitem", "args": ["s"], "decorators": [], "docstring": "", "start_line": 49, "end_line": 54, "is_async": false, "is_method": false}, {"name": "dictvalue", "qualified_name": "dictvalue", "args": ["t"], "decorators": [], "docstring": "", "start_line": 56, "end_line": 60, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This module contains helper functions for controlling caching. It does so by\nmanaging the \"Vary\" header of responses. It includes functions to patch the\nheader of response objects directly and decorators that change functions to do\nthat header-patching themselves.\n\nFor information on the Vary header, see:\n\n    https://tools.ietf.org/html/rfc7231#section-7.1.4\n\nEssentially, the \"Vary\" HTTP header defines which headers a cache should take\ninto account when building its cache key. Requests with the same path but\ndifferent header content for headers named in \"Vary\" need to get different\ncache keys to prevent delivery of wrong content.\n\nAn example: i18n middleware would need to distinguish caches by the\n\"Accept-language\" header.", "parse_error": ""}, {"file_path": "django/utils/functional.py", "file_hash": "c28ea717d027ecc2c8a981dec62b5e004b8b8e6d04c65b2a4c483761c8776177", "imports": [{"module": "copy", "names": [], "is_from": false, "alias": ""}, {"module": "itertools", "names": [], "is_from": false, "alias": ""}, {"module": "operator", "names": [], "is_from": false, "alias": ""}, {"module": "functools", "names": ["total_ordering", "wraps"], "is_from": true, "alias": ""}], "functions": [{"name": "lazy", "qualified_name": "lazy", "args": ["func"], "decorators": [], "docstring": "Turn any callable into a lazy evaluated callable. result classes or types\nis required -- at least one is needed so that the automatic forcing of\nthe lazy evaluation code is triggered. Results are not memoized; the\nfunction is evaluated on every access.", "start_line": 60, "end_line": 175, "is_async": false, "is_method": false}, {"name": "_lazy_proxy_unpickle", "qualified_name": "_lazy_proxy_unpickle", "args": ["func", "args", "kwargs"], "decorators": [], "docstring": "", "start_line": 178, "end_line": 179, "is_async": false, "is_method": false}, {"name": "lazystr", "qualified_name": "lazystr", "args": ["text"], "decorators": [], "docstring": "Shortcut for the common case of a lazy callable that returns str.", "start_line": 182, "end_line": 186, "is_async": false, "is_method": false}, {"name": "keep_lazy", "qualified_name": "keep_lazy", "args": [], "decorators": [], "docstring": "A decorator that allows a function to be called with one or more lazy\narguments. If none of the args are lazy, the function is evaluated\nimmediately, otherwise a __proxy__ is returned that will evaluate the\nfunction when needed.", "start_line": 189, "end_line": 208, "is_async": false, "is_method": false}, {"name": "keep_lazy_text", "qualified_name": "keep_lazy_text", "args": ["func"], "decorators": [], "docstring": "A decorator for functions that accept lazy arguments and return text.", "start_line": 211, "end_line": 215, "is_async": false, "is_method": false}, {"name": "new_method_proxy", "qualified_name": "new_method_proxy", "args": ["func"], "decorators": [], "docstring": "", "start_line": 221, "end_line": 226, "is_async": false, "is_method": false}, {"name": "unpickle_lazyobject", "qualified_name": "unpickle_lazyobject", "args": ["wrapped"], "decorators": [], "docstring": "Used to unpickle lazy objects. Just return its argument, which will be the\nwrapped object.", "start_line": 332, "end_line": 337, "is_async": false, "is_method": false}, {"name": "partition", "qualified_name": "partition", "args": ["predicate", "values"], "decorators": [], "docstring": "Split the values into two sets, based on the return value of the function\n(True/False). e.g.:\n\n    >>> partition(lambda x: x > 3, range(5))\n    [0, 1, 2, 3], [4]", "start_line": 390, "end_line": 401, "is_async": false, "is_method": false}, {"name": "func", "qualified_name": "func", "args": ["instance"], "decorators": ["staticmethod"], "docstring": "", "start_line": 20, "end_line": 24, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "func", "name"], "decorators": [], "docstring": "", "start_line": 26, "end_line": 28, "is_async": false, "is_method": false}, {"name": "__set_name__", "qualified_name": "__set_name__", "args": ["self", "owner", "name"], "decorators": [], "docstring": "", "start_line": 30, "end_line": 38, "is_async": false, "is_method": false}, {"name": "__get__", "qualified_name": "__get__", "args": ["self", "instance", "cls"], "decorators": [], "docstring": "Call the function and put the return value in instance.__dict__ so that\nsubsequent attribute access on the instance returns the cached value\ninstead of calling cached_property.__get__().", "start_line": 40, "end_line": 49, "is_async": false, "is_method": false}, {"name": "__wrapper__", "qualified_name": "__wrapper__", "args": [], "decorators": ["wraps(func)"], "docstring": "", "start_line": 171, "end_line": 173, "is_async": false, "is_method": false}, {"name": "decorator", "qualified_name": "decorator", "args": ["func"], "decorators": [], "docstring": "", "start_line": 199, "end_line": 207, "is_async": false, "is_method": false}, {"name": "inner", "qualified_name": "inner", "args": ["self"], "decorators": [], "docstring": "", "start_line": 222, "end_line": 225, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_li