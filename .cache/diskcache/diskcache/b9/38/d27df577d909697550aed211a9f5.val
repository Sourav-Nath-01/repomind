c": false, "is_method": false}], "classes": [{"name": "Driver", "bases": ["GDALBase"], "methods": ["__init__", "__str__", "ensure_registered", "driver_count", "name"], "docstring": "Wrap a GDAL/OGR Data Source Driver.\nFor more information, see the C API source code:\nhttps://www.gdal.org/gdal_8h.html - https://www.gdal.org/ogr__api_8h.html", "start_line": 9, "end_line": 97}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/contrib/gis/gdal/datasource.py", "file_hash": "c58e67a160073405d6bdbfd07f392a411094a536f1ac9d1b865053b603bf8277", "imports": [{"module": "ctypes", "names": ["byref"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.base", "names": ["GDALBase"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.driver", "names": ["Driver"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.error", "names": ["GDALException"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.layer", "names": ["Layer"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.prototypes", "names": ["ds"], "is_from": true, "alias": ""}, {"module": "django.utils.encoding", "names": ["force_bytes", "force_str"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "ds_input", "ds_driver", "write", "encoding"], "decorators": [], "docstring": "", "start_line": 54, "end_line": 85, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "index"], "decorators": [], "docstring": "Allows use of the index [] operator to get a layer at the index.", "start_line": 87, "end_line": 101, "is_async": false, "is_method": false}, {"name": "__len__", "qualified_name": "__len__", "args": ["self"], "decorators": [], "docstring": "Return the number of layers within the data source.", "start_line": 103, "end_line": 105, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "Return OGR GetName and Driver for the Data Source.", "start_line": 107, "end_line": 109, "is_async": false, "is_method": false}, {"name": "layer_count", "qualified_name": "layer_count", "args": ["self"], "decorators": ["property"], "docstring": "Return the number of layers in the data source.", "start_line": 112, "end_line": 114, "is_async": false, "is_method": false}, {"name": "name", "qualified_name": "name", "args": ["self"], "decorators": ["property"], "docstring": "Return the name of the data source.", "start_line": 117, "end_line": 120, "is_async": false, "is_method": false}], "classes": [{"name": "DataSource", "bases": ["GDALBase"], "methods": ["__init__", "__getitem__", "__len__", "__str__", "layer_count", "name"], "docstring": "Wraps an OGR Data Source object.", "start_line": 50, "end_line": 120}], "calls": [], "module_docstring": "DataSource is a wrapper for the OGR Data Source object, which provides\nan interface for reading vector geometry data from many different file\nformats (including ESRI shapefiles).\n\nWhen instantiating a DataSource object, use the filename of a\nGDAL-supported data source.  For example, a SHP file or a\nTIGER/Line file from the government.\n\nThe ds_driver keyword is used internally when a ctypes pointer\nis passed in directly.\n\nExample:\n ds = DataSource('/home/foo/bar.shp')\n for layer in ds:\n     for feature in layer:\n         # Getting the geometry for the feature.\n         g = feature.geom\n\n         # Getting the 'description' field for the feature.\n         desc = feature['description']\n\n         # We can also increment through all of the fields\n         #  attached to this feature.\n         for field in feature:\n             # Get the name of the field (e.g. 'description')\n             nm = field.name\n\n             # Get the type (integer) of the field, e.g. 0 => OFTInteger\n             t = field.type\n\n             # Returns the value the field; OFTIntegers return ints,\n             #  OFTReal returns floats, all else returns string.\n             val = field.value", "parse_error": ""}, {"file_path": "django/contrib/gis/gdal/field.py", "file_hash": "01eadd27db0b7abbbd677f4f12d4c05e9d78bda6cc7305ff2c86638341320c01", "imports": [{"module": "ctypes", "names": ["byref", "c_int"], "is_from": true, "alias": ""}, {"module": "datetime", "names": ["date", "datetime", "time"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.base", "names": ["GDALBase"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.error", "names": ["GDALException"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.prototypes", "names": ["ds"], "is_from": true, "alias": ""}, {"module": "django.utils.encoding", "names": ["force_str"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "feat", "index"], "decorators": [], "docstring": "Initialize on the feature object and the integer index of\nthe field within the feature.", "start_line": 19, "end_line": 35, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "Return the string representation of the Field.", "start_line": 37, "end_line": 39, "is_async": false, "is_method": false}, {"name": "as_double", "qualified_name": "as_double", "args": ["self"], "decorators": [], "docstring": "Retrieve the Field's value as a double (float).", "start_line": 42, "end_line": 44, "is_async": false, "is_method": false}, {"name": "as_int", "qualified_name": "as_int", "args": ["self", "is_64"], "decorators": [], "docstring": "Retrieve the Field's value as an integer.", "start_line": 46, "end_line": 51, "is_async": false, "is_method": false}, {"name": "as_string", "qualified_name": "as_string", "args": ["self"], "decorators": [], "docstring": "Retrieve the Field's value as a string.", "start_line": 53, "end_line": 58, "is_async": false, "is_method": false}, {"name": "as_datetime", "qualified_name": "as_datetime", "args": ["self"], "decorators": [], "docstring": "Retrieve the Field's value as a tuple of date & time components.", "start_line": 60, "end_line": 71, "is_async": false, "is_method": false}, {"name": "is_set", "qualified_name": "is_set", "args": ["self"], "decorators": ["property"], "docstring": "Return True if the value of this field isn't null, False otherwise.", "start_line": 75, "end_line": 77, "is_async": false, "is_method": false}, {"name": "name", "qualified_name": "name", "args": ["self"], "decorators": ["property"], "docstring": "Return the name of this Field.", "start_line": 80, "end_line": 83, "is_async": false, "is_method": false}, {"name": "precision", "qualified_name": "precision", "args": ["self"], "decorators": ["property"], "docstring": "Return the precision of this Field.", "start_line": 86, "end_line": 88, "is_async": false, "is_method": false}, {"name": "type", "qualified_name": "type", "args": ["self"], "decorators": ["property"], "docstring": "Return the OGR type of this Field.", "start_line": 91, "end_line": 93, "is_async": false, "is_method": false}, {"name": "type_name", "qualified_name": "type_name", "args": ["self"], "decorators": ["property"], "docstring": "Return the OGR field type name for this Field.", "start_line": 96, "end_line": 98, "is_async": false, "is_method": false}, {"name": "value", "qualified_name": "value", "args": ["self"], "decorators": ["property"], "docstring": "Return the value of this Field.", "start_line": 101, "end_line": 104, "is_async": false, "is_method": false}, {"name": "width", "qualified_name": "width", "args": ["self"], "decorators": ["property"], "docstring": "Return the width of this Field.", "start_line": 107, "end_line": 109, "is_async": false, "is_method": false}, {"name": "value", "qualified_name": "value", "args": ["self"], "decorators": ["property"], "docstring": "Return an integer contained in this field.", "start_line": 117, "end_line": 119, "is_async": false, "is_method": false}, {"name": "type", "qualified_name": "type", "args": ["self"], "decorators": ["property"], "docstring": "GDAL uses OFTReals to represent OFTIntegers in created\nshapefiles -- forcing the type here since the underlying field\ntype may actually be OFTReal.", "start_line": 122, "end_line": 128, "is_async": false, "is_method": false}, {"name": "value", "qualified_name": "value", "args": ["self"], "decorators": ["property"], "docstring": "Return a float contained in this field.", "start_line": 133, "end_line": 135, "is_async": false, "is_method": false}, {"name": "value", "qualified_name": "value", "args": ["self"], "decorators": ["property"], "docstring": "Return a Python `date` object for the OFTDate field.", "start_line": 154, "end_line": 160, "is_async": false, "is_method": false}, {"name": "value", "qualified_name": "value", "args": ["self"], "decorators": ["property"], "docstring": "Return a Python `datetime` object for this OFTDateTime field.", "start_line": 165, "end_line": 175, "is_async": false, "is_method": false}, {"name": "value", "qualified_name": "value", "args": ["self"], "decorators": ["property"], "docstring": "Return a Python `time` object for this OFTTime field.", "start_line": 180, "end_line": 186, "is_async": false, "is_method": false}], "classes": [{"name": "Field", "bases": ["GDALBase"], "methods": ["__init__", "__str__", "as_double", "as_int", "as_string", "as_datetime", "is_set", "name", "precision", "type", "type_name", "value", "width"], "docstring": "Wrap an OGR Field. Needs to be instantiated from a Feature object.", "start_line": 14, "end_line": 109}, {"name": "OFTInteger", "bases": ["Field"], "methods": ["value", "type"], "docstring": "", "start_line": 113, "end_line": 128}, {"name": "OFTReal", "bases": ["Field"], "methods": ["value"], "docstring": "", "start_line": 131, "end_line": 135}, {"name": "OFTString", "bases": ["Field"], "methods": [], "docstring": "", "start_line": 139, "end_line": 140}, {"name": "OFTWideString", "bases": ["Field"], "methods": [], "docstring": "", "start_line": 143, "end_line": 144}, {"name": "OFTBinary", "bases": ["Field"], "methods": [], "docstring": "", "start_line": 147, "end_line": 148}, {"name": "OFTDate", "bases": ["Field"], "methods": ["value"], "docstring": "", "start_line": 152, "end_line": 160}, {"name": "OFTDateTime", "bases": ["Field"], "methods": ["value"], "docstring": "", "start_line": 163, "end_line": 175}, {"name": "OFTTime", "bases": ["Field"], "methods": ["value"], "docstring": "", "start_line": 178, "end_line": 186}, {"name": "OFTInteger64", "bases": ["OFTInteger"], "methods": [], "docstring": "", "start_line": 189, "end_line": 190}, {"name": "OFTIntegerList", "bases": ["Field"], "methods": [], "docstring": "", "start_line": 194, "end_line": 195}, {"name": "OFTRealList", "bases": ["Field"], "methods": [], "docstring": "", "start_line": 198, "end_line": 199}, {"name": "OFTStringList", "bases": ["Field"], "methods": [], "docstring": "", "start_line": 202, "end_line": 203}, {"name": "OFTWideStringList", "bases": ["Field"], "methods": [], "docstring": "", "start_line": 206, "end_line": 207}, {"name": "OFTInteger64List", "bases": ["Field"], "methods": [], "docstring": "", "start_line": 210, "end_line": 211}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/contrib/gis/gdal/srs.py", "file_hash": "8b0fbc4e528289e5decc6a3e17f0eb5c53efbe95c188d3b84dd1ea201fd51082", "imports": [{"module": "ctypes", "names": ["byref", "c_char_p", "c_int"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.base", "names": ["GDALBase"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.error", "names": ["SRSException"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.prototypes", "names": ["srs"], "is_from": true, "alias": ""}, {"module": "django.utils.encoding", "names": ["force_bytes", "force_str"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "srs_input", "srs_type"], "decorators": [], "docstring": "Create a GDAL OSR Spatial Reference object from the given input.\nThe input may be string of OGC Well Known Text (WKT), an integer\nEPSG code, a PROJ.4 string, and/or a projection \"well known\" shorthand\nstring (one of 'WGS84', 'WGS72', 'NAD27', 'NAD83').", "start_line": 45, "end_line": 92, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "target"], "decorators": [], "docstring": "Return the value of the given string attribute node, None if the node\ndoesn't exist.  Can also take a tuple as a parameter, (target, child),\nwhere child is the index of the attribute in the WKT.  For example:\n\n>>> wkt = 'GEOGCS[\"WGS 84\", DATUM[\"WGS_1984, ... AUTHORITY[\"EPSG\",\"4326\"]]'\n>>> srs = Spat", "start_line": 94, "end_line": 120, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "Use 'pretty' WKT.", "start_line": 122, "end_line": 124, "is_async": false, "is_method": false}, {"name": "attr_value", "qualified_name": "attr_value", "args": ["self", "target", "index"], "decorators": [], "docstring": "The attribute value for the given target node (e.g. 'PROJCS'). The index\nkeyword specifies an index of the child node to return.", "start_line": 127, "end_line": 134, "is_async": false, "is_method": false}, {"name": "auth_name", "qualified_name": "auth_name", "args": ["self", "target"], "decorators": [], "docstring": "Return the authority name for the given string target node.", "start_line": 136, "end_line": 138, "is_async": false, "is_method": false}, {"name": "auth_code", "qualified_name": "auth_code", "args": ["self", "target"], "decorators": [], "docstring": "Return the authority code for the given string target node.", "start_line": 140, "end_line": 142, "is_async": false, "is_method": false}, {"name": "clone", "qualified_name": "clone", "args": ["self"], "decorators": [], "docstring": "Return a clone of this SpatialReference object.", "start_line": 144, "end_line": 146, "is_async": false, "is_method": false}, {"name": "from_esri", "qualified_name": "from_esri", "args": ["self"], "decorators": [], "docstring": "Morph this SpatialReference from ESRI's format to EPSG.", "start_line": 148, "end_line": 150, "is_async": false, "is_method": false}, {"name": "identify_epsg", "qualified_name": "identify_epsg", "args": ["self"], "decorators": [], "docstring": "This method inspects the WKT of this SpatialReference, and will\nadd EPSG authority nodes where an EPSG identifier is applicable.", "start_line": 152, "end_line": 157, "is_async": false, "is_method": false}, {"name": "to_esri", "qualified_name": "to_esri", "args": ["self"], "decorators": [], "docstring": "Morph this SpatialReference to ESRI's format.", "start_line": 159, "end_line": 161, "is_async": false, "is_method": false}, {"name": "validate", "qualified_name": "validate", "args": ["self"], "decorators": [], "docstring": "Check to see if the given spatial reference is valid.", "start_line": 163, "end_line": 165, "is_async": false, "is_method": false}, {"name": "name", "qualified_name": "name", "args": ["self"], "decorators": ["property"], "docstring": "Return the name of this Spatial Reference.", "start_line": 169, "end_line": 178, "is_async": false, "is_method": false}, {"name": "srid", "qualified_name": "srid", "args": ["self"], "decorators": ["property"], "docstring": "Return the SRID of top-level authority, or None if undefined.", "start_line": 181, "end_line": 186, "is_async": false, "is_method": false}, {"name": "linear_name", "qualified_name": "linear_name", "args": ["self"], "decorators": ["property"], "docstring": "Return the name of the linear units.", "start_line": 190, "end_line": 193, "is_async": false, "is_method": false}, {"name": "linear_units", "qualified_name": "linear_units", "args": ["self"], "decorators": ["property"], "docstring": "Return the value of the linear units.", "start_line": 196, "end_line": 199, "is_async": false, "is_method": false}, {"name": "angular_name", "qualified_name": "angular_name", "args": ["self"], "decorators": ["property"], "docstring": "Return the name of the angular units.", "start_line": 202, "end_line": 205, "is_async": false, "is_method": false}, {"name": "angular_units", "qualified_name": "angular_units", "args": ["self"], "decorators": ["property"], "docstring": "Return the value of the angular units.", "start_line": 208, "end_line": 211, "is_async": false, "is_method": false}, {"name": "units", "qualified_name": "units", "args": ["self"], "decorators": ["property"], "docstring": "Return a 2-tuple of the units value and the units name. Automatically\ndetermine whether to return the linear or angular units.", "start_line": 214, "end_line": 226, "is_async": false, "is_method": false}, {"name": "ellipsoid", "qualified_name": "ellipsoid", "args": ["self"], "decorators": ["property"], "docstring": "Return a tuple of the ellipsoid parameters:\n (semimajor axis, semiminor axis, and inverse flattening)", "start_line": 230, "end_line": 235, "is_async": false, "is_method": false}, {"name": "semi_major", "qualified_name": "semi_major", "args": ["self"], "decorators": ["property"], "docstring": "Return the Semi Major Axis for this Spatial Reference.", "start_line": 238, "end_line": 240, "is_async": false, "is_method": false}, {"name": "semi_minor", "qualified_name": "semi_minor", "args": ["self"], "decorators": ["property"], "docstring": "Return the Semi Minor Axis for this Spatial Reference.", "start_line": 243, "end_line": 245, "is_async": false, "is_method": false}, {"name": "inverse_flattening", "qualified_name": "inverse_flattening", "args": ["self"], "decorators": ["property"], "docstring": "Return the Inverse Flattening for this Spatial Reference.", "start_line": 248, "end_line": 250, "is_async": false, "is_method": false}, {"name": "geographic", "qualified_name": "geographic", "args": ["self"], "decorators": ["property"], "docstring": "Return True if this SpatialReference is geographic\n (root node is GEOGCS).", "start_line": 254, "end_line": 259, "is_async": false, "is_method": false}, {"name": "local", "qualified_name": "local", "args": ["self"], "decorators": ["property"], "docstring": "Return True if this SpatialReference is local (root node is LOCAL_CS).", "start_line": 262, "end_line": 264, "is_async": false, "is_method": false}, {"name": "projected", "qualified_name": "projected", "args": ["self"], "decorators": ["property"], "docstring": "Return True if this SpatialReference is a projected coordinate system\n (root node is PROJCS).", "start_line": 267, "end_line": 272, "is_async": false, "is_method": false}, {"name": "import_epsg", "qualified_name": "import_epsg", "args": ["self", "epsg"], "decorators": [], "docstring": "Import the Spatial Reference from the EPSG code (an integer).", "start_line": 275, "end_line": 277, "is_async": false, "is_method": false}, {"name": "import_proj", "qualified_name": "import_proj", "args": ["self", "proj"], "decorators": [], "docstring": "Import the Spatial Reference from a PROJ.4 string.", "start_line": 279, "end_line": 281, "is_async": false, "is_method": false}, {"name": "import_user_input", "qualified_name": "import_user_input", "args": ["self", "user_input"], "decorators": [], "docstring": "Import the Spatial Reference from the given user input string.", "start_line": 283, "end_line": 285, "is_async": false, "is_method": false}, {"name": "import_wkt", "qualified_name": "import_wkt", "args": ["self", "wkt"], "decorators": [], "docstring": "Import the Spatial Reference from OGC WKT (string)", "start_line": 287, "end_line": 289, "is_async": false, "is_method": false}, {"name": "import_xml", "qualified_name": "import_xml", "args": ["self", "xml"], "decorators": [], "docstring": "Import the Spatial Reference from an XML string.", "start_line": 291, "end_line": 293, "is_async": false, "is_method": false}, {"name": "wkt", "qualified_name": "wkt", "args": ["self"], "decorators": ["property"], "docstring": "Return the WKT representation of this Spatial Reference.", "start_line": 297, "end_line": 299, "is_async": false, "is_method": false}, {"name": "pretty_wkt", "qualified_name": "pretty_wkt", "args": ["self", "simplify"], "decorators": ["property"], "docstring": "Return the 'pretty' representation of the WKT.", "start_line": 302, "end_line": 304, "is_async": false, "is_method": false}, {"name": "proj", "qualified_name": "proj", "args": ["self"], "decorators": ["property"], "docstring": "Return the PROJ.4 representation for this Spatial Reference.", "start_line": 307, "end_line": 309, "is_async": false, "is_method": false}, {"name": "proj4", "qualified_name": "proj4", "args": ["self"], "decorators": ["property"], "docstring": "Alias for proj().", "start_line": 312, "end_line": 314, "is_async": false, "is_method": false}, {"name": "xml", "qualified_name": "xml", "args": ["self", "dialect"], "decorators": ["property"], "docstring": "Return the XML representation of this Spatial Reference.", "start_line": 317, "end_line": 319, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "source", "target"], "decorators": [], "docstring": "Initialize on a source and target SpatialReference objects.", "start_line": 326, "end_line": 332, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 334, "end_line": 335, "is_async": false, "is_method": false}], "classes": [{"name": "SpatialReference", "bases": ["GDALBase"], "methods": ["__init__", "__getitem__", "__str__", "attr_value", "auth_name", "auth_code", "clone", "from_esri", "identify_epsg", "to_esri", "validate", "name", "srid", "linear_name", "linear_units", "angular_name", "angular_units", "units", "ellipsoid", "semi_major", "semi_minor", "inverse_flattening", "geographic", "local", "projected", "import_epsg", "import_proj", "import_user_input", "import_wkt", "import_xml", "wkt", "pretty_wkt", "proj", "proj4", "xml"], "docstring": "A wrapper for the OGRSpatialReference object.  According to the GDAL Web site,\nthe SpatialReference object \"provide[s] services to represent coordinate\nsystems (projections and datums) and to transform between them.\"", "start_line": 37, "end_line": 319}, {"name": "CoordTransform", "bases": ["GDALBase"], "methods": ["__init__", "__str__"], "docstring": "The coordinate system transformation object.", "start_line": 322, "end_line": 335}], "calls": [], "module_docstring": "The Spatial Reference class, represents OGR Spatial Reference objects.\n\nExample:\n>>> from django.contrib.gis.gdal import SpatialReference\n>>> srs = SpatialReference('WGS84')\n>>> print(srs)\nGEOGCS[\"WGS 84\",\n    DATUM[\"WGS_1984\",\n        SPHEROID[\"WGS 84\",6378137,298.257223563,\n            AUTHORITY[\"EPSG\",\"7030\"]],\n        TOWGS84[0,0,0,0,0,0,0],\n        AUTHORITY[\"EPSG\",\"6326\"]],\n    PRIMEM[\"Greenwich\",0,\n        AUTHORITY[\"EPSG\",\"8901\"]],\n    UNIT[\"degree\",0.01745329251994328,\n        AUTHORITY[\"EPSG\",\"9122\"]],\n    AUTHORITY[\"EPSG\",\"4326\"]]\n>>> print(srs.proj)\n+proj=longlat +ellps=WGS84 +datum=WGS84 +no_defs\n>>> print(srs.ellipsoid)\n(6378137.0, 6356752.3142451793, 298.25722356300003)\n>>> print(srs.projected, srs.geographic)\nFalse True\n>>> srs.import_epsg(32140)\n>>> print(srs.name)\nNAD83 / Texas South Central", "parse_error": ""}, {"file_path": "django/contrib/gis/gdal/geometries.py", "file_hash": "a371b01b9573646b1395c99e7ce320b4d1b8994d378ea8488341895003fd0bcb", "imports": [{"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "binascii", "names": ["b2a_hex"], "is_from": true, "alias": ""}, {"module": "ctypes", "names": ["byref", "c_char_p", "c_double", "c_ubyte", "c_void_p", "string_at"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.base", "names": ["GDALBase"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.envelope", "names": ["Envelope", "OGREnvelope"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.error", "names": ["GDALException", "SRSException"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.geomtype", "names": ["OGRGeomType"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.prototypes", "names": ["geom", "srs"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.srs", "names": ["CoordTransform", "SpatialReference"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.geometry", "names": ["hex_regex", "json_regex", "wkt_regex"], "is_from": true, "alias": ""}, {"module": "django.utils.encoding", "names": ["force_bytes"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.geos", "names": ["GEOSGeometry"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.geos", "names": ["GEOSGeometry"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis", "names": ["geos"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "geom_input", "srs"], "decorators": [], "docstring": "Initialize Geometry on either WKT or an OGR pointer as input.", "start_line": 63, "end_line": 117, "is_async": false, "is_method": false}, {"name": "__getstate__", "qualified_name": "__getstate__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 120, "end_line": 126, "is_async": false, "is_method": false}, {"name": "__setstate__", "qualified_name": "__setstate__", "args": ["self", "state"], "decorators": [], "docstring": "", "start_line": 128, "end_line": 134, "is_async": false, "is_method": false}, {"name": "_from_wkb", "qualified_name": "_from_wkb", "args": ["cls", "geom_input"], "decorators": ["classmethod"], "docs