lf"], "decorators": [], "docstring": "Return a query set in which the returned objects have been annotated\nwith extra data or aggregations.", "start_line": 1011, "end_line": 1055, "is_async": false, "is_method": false}, {"name": "order_by", "qualified_name": "order_by", "args": ["self"], "decorators": [], "docstring": "Return a new QuerySet instance with the ordering changed.", "start_line": 1057, "end_line": 1064, "is_async": false, "is_method": false}, {"name": "distinct", "qualified_name": "distinct", "args": ["self"], "decorators": [], "docstring": "Return a new QuerySet instance that will select only distinct results.", "start_line": 1066, "end_line": 1074, "is_async": false, "is_method": false}, {"name": "extra", "qualified_name": "extra", "args": ["self", "select", "where", "params", "tables", "order_by", "select_params"], "decorators": [], "docstring": "Add extra SQL fragments to the query.", "start_line": 1076, "end_line": 1083, "is_async": false, "is_method": false}, {"name": "reverse", "qualified_name": "reverse", "args": ["self"], "decorators": [], "docstring": "Reverse the ordering of the QuerySet.", "start_line": 1085, "end_line": 1091, "is_async": false, "is_method": false}, {"name": "defer", "qualified_name": "defer", "args": ["self"], "decorators": [], "docstring": "Defer the loading of data for certain fields until they are accessed.\nAdd the set of deferred fields to any existing set of deferred fields.\nThe only exception to this is if None is passed in as the only\nparameter, in which case removal all deferrals.", "start_line": 1093, "end_line": 1107, "is_async": false, "is_method": false}, {"name": "only", "qualified_name": "only", "args": ["self"], "decorators": [], "docstring": "Essentially, the opposite of defer(). Only the fields passed into this\nmethod and that are not already specified as deferred are loaded\nimmediately when the queryset is evaluated.", "start_line": 1109, "end_line": 1127, "is_async": false, "is_method": false}, {"nam