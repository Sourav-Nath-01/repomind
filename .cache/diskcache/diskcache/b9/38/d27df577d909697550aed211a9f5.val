ression being cast.", "start_line": 83, "end_line": 89, "is_async": false, "is_method": false}, {"name": "date_extract_sql", "qualified_name": "date_extract_sql", "args": ["self", "lookup_type", "field_name"], "decorators": [], "docstring": "Given a lookup_type of 'year', 'month', or 'day', return the SQL that\nextracts a value from the given date field field_name.", "start_line": 91, "end_line": 96, "is_async": false, "is_method": false}, {"name": "date_interval_sql", "qualified_name": "date_interval_sql", "args": ["self", "timedelta"], "decorators": [], "docstring": "Implement the date interval functionality for expressions.", "start_line": 98, "end_line": 102, "is_async": false, "is_method": false}, {"name": "date_trunc_sql", "qualified_name": "date_trunc_sql", "args": ["self", "lookup_type", "field_name"], "decorators": [], "docstring": "Given a lookup_type of 'year', 'month', or 'day', return the SQL that\ntruncates the given date field field_name to a date object with only\nthe given specificity.", "start_line": 104, "end_line": 110, "is_async": false, "is_method": false}, {"name": "datetime_cast_date_sql", "qualified_name": "datetime_cast_date_sql", "args": ["self", "field_name", "tzname"], "decorators": [], "docstring": "Return the SQL to cast a datetime value to date value.", "start_line": 112, "end_line": 119, "is_async": false, "is_method": false}, {"name": "datetime_cast_time_sql", "qualified_name": "datetime_cast_time_sql", "args": ["self", "field_name", "tzname"], "decorators": [], "docstring": "Return the SQL to cast a datetime value to time value.", "start_line": 121, "end_line": 125, "is_async": false, "is_method": false}, {"name": "datetime_extract_sql", "qualified_name": "datetime_extract_sql", "args": ["self", "lookup_type", "field_name", "tzname"], "decorators": [], "docstring": "Given a lookup_type of 'year', 'month', 'day', 'hour', 'minute', or\n'second', return the SQL that extracts a value from the given\ndatetime field field_name.", "start_