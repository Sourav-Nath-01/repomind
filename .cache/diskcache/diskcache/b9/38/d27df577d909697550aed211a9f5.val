xError"], "is_from": true, "alias": ""}, {"module": "engine", "names": ["Engine"], "is_from": true, "alias": ""}], "functions": [{"name": "linebreak_iter", "qualified_name": "linebreak_iter", "args": ["template_source"], "decorators": [], "docstring": "", "start_line": 279, "end_line": 285, "is_async": false, "is_method": false}, {"name": "render_value_in_context", "qualified_name": "render_value_in_context", "args": ["value", "context"], "decorators": [], "docstring": "Convert any value to a string to become part of a rendered template. This\nmeans escaping, if required, and conversion to a string. If value is a\nstring, it's expected to already be translated.", "start_line": 962, "end_line": 975, "is_async": false, "is_method": false}, {"name": "token_kwargs", "qualified_name": "token_kwargs", "args": ["bits", "parser", "support_legacy"], "decorators": [], "docstring": "Parse token keyword arguments and return a dictionary of the arguments\nretrieved from the ``bits`` token list.\n\n`bits` is a list containing the remainder of the token (split by spaces)\nthat is to be checked for arguments. Valid arguments are removed from this\nlist.\n\n`support_legacy` - if True, the l", "start_line": 1000, "end_line": 1044, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "msg", "params"], "decorators": [], "docstring": "", "start_line": 109, "end_line": 111, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 113, "end_line": 114, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "name", "template_name", "loader"], "decorators": [], "docstring": "", "start_line": 118, "end_line": 121, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 123, "end_line": 124, "is_async": false, "is_method": false}, {"name": "__eq__", "qualified_name": "__eq__", "args": ["self", "other"], "decorators": [], "docstring": "", "start_line": 126, "end_line": 131, "is_async": false, "is_method": false}, {"name": "loader_name", "qualified_name": "loader_name", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 134, "end_line": 138, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "template_string", "origin", "name", "engine"], "decorators": [], "docstring": "", "start_line": 142, "end_line": 156, "is_async": false, "is_method": false}, {"name": "__iter__", "qualified_name": "__iter__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 158, "end_line": 160, "is_async": false, "is_method": false}, {"name": "_render", "qualified_name": "_render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 162, "end_line": 163, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "Display stage -- can be called many times", "start_line": 165, "end_line": 173, "is_async": false, "is_method": false}, {"name": "compile_nodelist", "qualified_name": "compile_nodelist", "args": ["self"], "decorators": [], "docstring": "Parse and compile the template source into a nodelist. If debug\nis True and an exception occurs during parsing, the exception is\nis annotated with contextual line information where it occurred in the\ntemplate source.", "start_line": 175, "end_line": 198, "is_async": false, "is_method": false}, {"name": "get_exception_info", "qualified_name": "get_exception_info", "args": ["self", "exception", "token"], "decorators": [], "docstring": "Return a dictionary containing contextual line information of where\nthe exception occurred in the template. The following information is\nprovided:\n\nmessage\n    The message of the exception raised.\n\nsource_lines\n    The lines before, after, and including the line the exception\n    occurred on.\n\nline\n", "start_line": 200, "end_line": 276, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "token_type", "contents", "position", "lineno"], "decorators": [], "docstring": "A token representing a string from the template.\n\ntoken_type\n    A TokenType, either .TEXT, .VAR, .BLOCK, or .COMMENT.\n\ncontents\n    The token source string.\n\nposition\n    An optional tuple containing the start and end index of the token\n    in the template source. This is used for traceback informa", "start_line": 289, "end_line": 310, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 312, "end_line": 315, "is_async": false, "is_method": false}, {"name": "split_contents", "qualified_name": "split_contents", "args": ["self"], "decorators": [], "docstring": "", "start_line": 317, "end_line": 330, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "template_string"], "decorators": [], "docstring": "", "start_line": 334, "end_line": 336, "is_async": false, "is_method": false}, {"name": "tokenize", "qualified_name": "tokenize", "args": ["self"], "decorators": [], "docstring": "Return a list of tokens from a given template_string.", "start_line": 338, "end_line": 350, "is_async": false, "is_method": false}, {"name": "create_token", "qualified_name": "create_token", "args": ["self", "token_string", "position", "lineno", "in_tag"], "decorators": [], "docstring": "Convert the given token string into a new Token object and return it.\nIf in_tag is True, we are processing something that matched a tag,\notherwise it should be treated as a literal string.", "start_line": 352, "end_line": 379, "is_async": false, "is_method": false}, {"name": "tokenize", "qualified_name": "tokenize", "args": ["self"], "decorators": [], "docstring": "Split a template string into tokens and annotates each token with its\nstart and end position in the source. This is slower than the default\nlexer so only use it when debug is True.", "start_line": 383, "end_line": 406, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "tokens", "libraries", "builtins", "origin"], "decorators": [], "docstring": "", "start_line": 410, "end_line": 424, "is_async": false, "is_method": false}, {"name": "parse", "qualified_name": "parse", "args": ["self", "parse_until"], "decorators": [], "docstring": "Iterate through the parser tokens and compiles each one into a node.\n\nIf parse_until is provided, parsing will stop once one of the\nspecified tokens has been reached. This is formatted as a list of\ntokens, e.g. ['elif', 'else', 'endif']. If no matching token is\nreached, raise an exception with the u", "start_line": 426, "end_line": 484, "is_async": false, "is_method": false}, {"name": "skip_past", "qualified_name": "skip_past", "args": ["self", "endtag"], "decorators": [], "docstring": "", "start_line": 486, "end_line": 491, "is_async": false, "is_method": false}, {"name": "extend_nodelist", "qualified_name": "extend_nodelist", "args": ["self", "nodelist", "node", "token"], "decorators": [], "docstring": "", "start_line": 493, "end_line": 505, "is_async": false, "is_method": false}, {"name": "error", "qualified_name": "error", "args": ["self", "token", "e"], "decorators": [], "docstring": "Return an exception annotated with the originating token. Since the\nparser can be called recursively, check if a token is already set. This\nensures the innermost token is highlighted if an exception occurs,\ne.g. a compile error within the body of an if statement.", "start_line": 507, "end_line": 518, "is_async": false, "is_method": false}, {"name": "invalid_block_tag", "qualified_name": "invalid_block_tag", "args": ["self", "token", "command", "parse_until"], "decorators": [], "docstring": "", "start_line": 520, "end_line": 535, "is_async": false, "is_method": false}, {"name": "unclosed_block_tag", "qualified_name": "unclosed_block_tag", "args": ["self", "parse_until"], "decorators": [], "docstring": "", "start_line": 537, "end_line": 544, "is_async": false, "is_method": false}, {"name": "next_token", "qualified_name": "next_token", "args": ["self"], "decorators": [], "docstring": "", "start_line": 546, "end_line": 547, "is_async": false, "is_method": false}, {"name": "prepend_token", "qualified_name": "prepend_token", "args": ["self", "token"], "decorators": [], "docstring": "", "start_line": 549, "end_line": 550, "is_async": false, "is_method": false}, {"name": "delete_first_token", "qualified_name": "delete_first_token", "args": ["self"], "decorators": [], "docstring": "", "start_line": 552, "end_line": 553, "is_async": false, "is_method": false}, {"name": "add_library", "qualified_name": "add_library", "args": ["self", "lib"], "decorators": [], "docstring": "", "start_line": 555, "end_line": 557, "is_async": false, "is_method": false}, {"name": "compile_filter", "qualified_name": "compile_filter", "args": ["self", "token"], "decorators": [], "docstring": "Convenient wrapper for FilterExpression", "start_line": 559, "end_line": 563, "is_async": false, "is_method": false}, {"name": "find_filter", "qualified_name": "find_filter", "args": ["self", "filter_name"], "decorators": [], "docstring": "", "start_line": 565, "end_line": 569, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "token", "parser"], "decorators": [], "docstring": "", "start_line": 624, "end_line": 666, "is_async": false, "is_method": false}, {"name": "resolve", "qualified_name": "resolve", "args": ["self", "context", "ignore_failures"], "decorators": [], "docstring": "", "start_line": 668, "end_line": 703, "is_async": false, "is_method": false}, {"name": "args_check", "qualified_name": "args_check", "args": ["name", "func", "provided"], "decorators": [], "docstring": "", "start_line": 705, "end_line": 720, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 723, "end_line": 724, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "var"], "decorators": [], "docstring": "", "start_line": 746, "end_line": 790, "is_async": false, "is_method": false}, {"name": "resolve", "qualified_name": "resolve", "args": ["self", "context"], "decorators": [], "docstring": "Resolve this variable against a given context.", "start_line": 792, "end_line": 808, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 810, "end_line": 811, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 813, "end_line": 814, "is_async": false, "is_method": false}, {"name": "_resolve_lookup", "qualified_name": "_resolve_lookup", "args": ["self", "context"], "decorators": [], "docstring": "Perform resolution of a real variable (i.e. not a literal) against the\ngiven context.\n\nAs indicated by the method's name, this method is an implementation\ndetail and shouldn't be called by external code. Use Variable.resolve()\ninstead.", "start_line": 816, "end_line": 880, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "Return the node rendered as a string.", "start_line": 890, "end_line": 894, "is_async": false, "is_method": false}, {"name": "render_annotated", "qualified_name": "render_annotated", "args": ["self", "context"], "decorators": [], "docstring": "Render the node. If debug is True and an exception occurs during\nrendering, the exception is annotated with contextual line information\nwhere it occurred in the template. For internal usage this method is\npreferred over using the render method directly.", "start_line": 896, "end_line": 908, "is_async": false, "is_method": false}, {"name": "__iter__", "qualified_name": "__iter__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 910, "end_line": 911, "is_async": false, "is_method": false}, {"name": "get_nodes_by_type", "qualified_name": "get_nodes_by_type", "args": ["self", "nodetype"], "decorators": [], "docstring": "Return a list of all nodes (within this node and its nodelist)\nof the given type", "start_line": 913, "end_line": 925, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 933, "end_line": 941, "is_async": false, "is_method": false}, {"name": "get_nodes_by_type", "qualified_name": "get_nodes_by_type", "args": ["self", "nodetype"], "decorators": [], "docstring": "Return a list of all nodes of the given type", "start_line": 943, "end_line": 948, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "s"], "decorators": [], "docstring": "", "start_line": 952, "end_line": 953, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 955, "end_line": 956, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 958, "end_line": 959, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "filter_expression"], "decorators": [], "docstring": "", "start_line": 979, "end_line": 980, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 982, "end_line": 983, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 985, "end_line": 993, "is_async": false, "is_method": false}], "classes": [{"name": "TokenType", "bases": ["Enum"], "methods": [], "docstring": "", "start_line": 100, "end_line": 104}, {"name": "VariableDoesNotExist", "bases": ["Exception"], "methods": ["__init__", "__str__"], "docstring": "", "start_line": 107, "end_line": 114}, {"name": "Origin", "bases": [], "methods": ["__init__", "__str__", "__eq__", "loader_name"], "docstring": "", "start_line": 117, "end_line": 138}, {"name": "Template", "bases": [], "methods": ["__init__", "__iter__", "_render", "render", "compile_nodelist", "get_exception_info"], "docstring": "", "start_line": 141, "end_line": 276}, {"name": "Token", "bases": [], "methods": ["__init__", "__str__", "split_contents"], "docstring": "", "start_line": 288, "end_line": 330}, {"name": "Lexer", "bases": [], "methods": ["__init__", "tokenize", "create_token"], "docstring": "", "start_line": 333, "end_line": 379}, {"name": "DebugLexer", "bases": ["Lexer"], "methods": ["tokenize"], "docstring": "", "start_line": 382, "end_line": 406}, {"name": "Parser", "bases": [], "methods": ["__init__", "parse", "skip_past", "extend_nodelist", "error", "invalid_block_tag", "unclosed_block_tag", "next_token", "prepend_token", "delete_first_token", "add_library", "compile_filter", "find_filter"], "docstring": "", "start_line": 409, "end_line": 569}, {"name": "FilterExpression", "bases": [], "methods": ["__init__", "resolve", "args_check", "__str__"], "docstring": "Parse a variable token and its optional filters (all as a single string),\nand return a list of tuples of the filter name and arguments.\nSample::\n\n    >>> token = 'variable|default:\"Default value\"|date:\"Y-m-d\"'\n    >>> p = Parser('')\n    >>> fe = FilterExpression(token, p)\n    >>> len(fe.filters)\n   ", "start_line": 610, "end_line": 724}, {"name": "Variable", "bases": [], "methods": ["__init__", "resolve", "__repr__", "__str__", "_resolve_lookup"], "docstring": "A template variable, resolvable against a given context. The variable may\nbe a hard-coded string (if it begins and ends with single or double quote\nmarks)::\n\n    >>> c = {'article': {'section':'News'}}\n    >>> Variable('article.section').resolve(c)\n    'News'\n    >>> Variable('article').resolve(c)\n ", "start_line": 727, "end_line": 880}, {"name": "Node", "bases": [], "methods": ["render", "render_annotated", "__iter__", "get_nodes_by_type"], "docstring": "", "start_line": 883, "end_line": 925}, {"name": "NodeList", "bases": ["list"], "methods": ["render", "get_nodes_by_type"], "docstring": "", "start_line": 928, "end_line": 948}, {"name": "TextNode", "bases": ["Node"], "methods": ["__init__", "__repr__", "render"], "docstring": "", "start_line": 951, "end_line": 959}, {"name": "VariableNode", "bases": ["Node"], "methods": ["__init__", "__repr__", "render"], "docstring": "", "start_line": 978, "end_line": 993}], "calls": [], "module_docstring": "This is the Django template system.\n\nHow it works:\n\nThe Lexer.tokenize() method converts a template string (i.e., a string\ncontaining markup with custom template tags) to tokens, which can be either\nplain text (TokenType.TEXT), variables (TokenType.VAR), or block statements\n(TokenType.BLOCK).\n\nThe Parser() class takes a list of tokens in its constructor, and its parse()\nmethod returns a compiled template -- which is, under the hood, a list of\nNode objects.\n\nEach Node is responsible for creating some sort of output -- e.g. simple text\n(TextNode), variable values in a given context (VariableNode), results of basic\nlogic (IfNode), results of looping (ForNode), or anything else. The core Node\ntypes are TextNode, VariableNode, IfNode and ForNode, but plugin modules can\ndefine their own custom node types.\n\nEach Node has a render() method, which takes a Context and returns a string of\nthe rendered node. For example, the render() method of a Variable Node returns\nthe variable's value as a string. The render() method of a ForNode returns the\nrendered output of whatever was inside the loop, recursively.\n\nThe Template class is a convenient wrapper that takes care of template\ncompilation and rendering.\n\nUsage:\n\nThe only thing you should ever use directly in this file is the Template class.\nCreate a compiled template object with a template_string, then call render()\nwith a context. In the compilation stage, the TemplateSyntaxError exception\nwill be raised if the template doesn't have proper syntax.\n\nSample code:\n\n>>> from django import template\n>>> s = '<html>{% if test %}<h1>{{ varvalue }}</h1>{% endif %}</html>'\n>>> t = template.Template(s)\n\n(t is now a compiled template, and its render() method can be called multiple\ntimes with multiple contexts)\n\n>>> c = template.Context({'test':True, 'varvalue': 'Hello'})\n>>> t.render(c)\n'<html><h1>Hello</h1></html>'\n>>> c = template.Context({'test':False, 'varvalue': 'Hello'})\n>>> t.render(c)\n'<html></html>'", "parse_error": ""}, {"file_path": "django/template/__init__.py", "file_hash": "b79a274f6e833929f2e108bb8b3fdaf36339589c9dbcfa646fa8458c4d35d021", "imports": [{"module": "engine", "names": ["Engine"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["EngineHandler"], "is_from": true, "alias": ""}, {"module": "base", "names": ["VariableDoesNotExist"], "is_from": true, "alias": ""}, {"module": "context", "names": ["ContextPopException"], "is_from": true, "alias": ""}, {"module": "exceptions", "names": ["TemplateDoesNotExist", "TemplateSyntaxError"], "is_from": true, "alias": ""}, {"module": "base", "names": ["Context", "Node", "NodeList", "Origin", "RequestContext", "Template", "Variable"], "is_from": true, "alias": ""}, {"module": "library", "names": ["Library"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "Django's support for templates.\n\nThe django.template namespace contains two independent subsystems:\n\n1. Multiple Template Engines: support for pluggable template backends,\n   built-in backends and backend-independent APIs\n2. Django Template Language: Django's own template engine, including its\n   built-in loaders, context processors, tags and filters.\n\nIdeally these subsystems would be implemented in distinct packages. However\nkeeping them together made the implementation of Multiple Template Engines\nless disruptive .\n\nHere's a breakdown of which modules belong to which subsystem.\n\nMultiple Template Engines:\n\n- django.template.backends.*\n- django.template.loader\n- django.template.response\n\nDjango Template Language:\n\n- django.template.base\n- django.template.context\n- django.template.context_processors\n- django.template.loaders.*\n- django.template.debug\n- django.template.defaultfilters\n- django.template.defaulttags\n- django.template.engine\n- django.template.loader_tags\n- django.template.smartif\n\nShared:\n\n- django.template.utils", "parse_error": ""}, {"file_path": "django/template/defaultfilters.py", "file_hash": "0f02baa0207aa2f3fdfbf27cb5ff9cf9cf5cecb9c817635edb7b0242842e1013", "imports": [{"module": "random", "names": [], "is_from": false, "alias": "random_module"}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "types", "names": [], "is_from": false, "alias": ""}, {"module": "decimal", "names": ["ROUND_HALF_UP", "Context", "Decimal", "InvalidOperation"], "is_from": true, "alias": ""}, {"module": "functools", "names": ["wraps"], "is_from": true, "alias": ""}, {"module": "operator", "names": ["itemgetter"], "is_from": true, "alias": ""}, {"module": "pprint", "names": ["pformat"], "is_from": true, "alias": ""}, {"module": "urllib.parse", "names": ["quote"], "is_from": true, "alias": ""}, {"module": "django.utils", "names": ["formats"], "is_from": true, "alias": ""}, {"module": "django.utils.dateformat", "names": ["format", "time_format"], "is_from": true, "alias": ""}, {"module": "django.utils.encoding", "names": ["iri_to_uri"], "is_from": true, "alias": ""}, {"module": "django.utils.html", "names": ["avoid_wrapping", "conditional_escape", "escape", "escapejs", "json_script", "linebreaks", "strip_tags", "urlize"], "is_from": true, "alias": ""}, {"module": "django.utils.safestring", "names": ["SafeData", "mark_safe"], "is_from": true, "alias": ""}, {"module": "django.utils.text", "names": ["Truncator", "normalize_newlines", "phone2numeric", "slugify", "wrap"], "is_from": true, "alias": ""}, {"module": "django.utils.timesince", "names": ["timesince", "timeuntil"], "is_from": true, "alias": ""}, {"module": "django.utils.translation", "names": ["gettext", "ngettext"], "is_from": true, "alias": ""}, {"module": "base", "names": ["Variable", "VariableDoesNotExist"], "is_from": true, "alias": ""}, {"module": "library", "names": ["Library"], "is_from": true, "alias": ""}], "functions": [{"name": "stringfilter", "qualified_name": "stringfilter", "args": ["func"], "decorators": [], "docstring": "Decorator for filters which should only receive strings. The object\npassed as the first positional argument will be converted to a string.", "start_line": 35, "end_line": 53, "is_async": false, "is_method": false}, {"name": "addslashes", "qualified_name": "addslashes", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Add slashes before quotes. Useful for escaping strings in CSV, for\nexample. Less useful for escaping JavaScript; use the ``escapejs``\nfilter instead.", "start_line": 62, "end_line": 68, "is_async": false, "is_method": false}, {"name": "capfirst", "qualified_name": "capfirst", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Capitalize the first character of the value.", "start_line": 73, "end_lin