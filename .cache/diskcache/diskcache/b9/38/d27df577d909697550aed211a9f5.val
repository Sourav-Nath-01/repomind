": false}, {"name": "get_prefetch_queryset", "qualified_name": "get_prefetch_queryset", "args": ["self", "instances", "queryset"], "decorators": [], "docstring": "", "start_line": 893, "end_line": 930, "is_async": false, "is_method": false}, {"name": "constrained_target", "qualified_name": "constrained_target", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 933, "end_line": 949, "is_async": false, "is_method": false}, {"name": "exists", "qualified_name": "exists", "args": ["self"], "decorators": [], "docstring": "", "start_line": 951, "end_line": 953, "is_async": false, "is_method": false}, {"name": "count", "qualified_name": "count", "args": ["self"], "decorators": [], "docstring": "", "start_line": 955, "end_line": 957, "is_async": false, "is_method": false}, {"name": "add", "qualified_name": "add", "args": ["self"], "decorators": [], "docstring": "", "start_line": 959, "end_line": 972, "is_async": false, "is_method": false}, {"name": "remove", "qualified_name": "remove", "args": ["self"], "decorators": [], "docstring": "", "start_line": 975, "end_line": 977, "is_async": false, "is_method": false}, {"name": "clear", "qualified_name": "clear", "args": ["self"], "decorators": [], "docstring": "", "start_line": 980, "end_line": 996, "is_async": false, "is_method": false}, {"name": "set", "qualified_name": "set", "args": ["self", "objs"], "decorators": [], "docstring": "", "start_line": 999, "end_line": 1024, "is_async": false, "is_method": false}, {"name": "create", "qualified_name": "create", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1027, "end_line": 1031, "is_async": false, "is_method": false}, {"name": "get_or_create", "qualified_name": "get_or_create", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1034, "end_line": 1041, "is_async": false, "is_method": false}, {"name": "update_or_create", "qualified_name": "update_or_create", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1044, "end_line": 1051, "is_async": false, "is_method": false}, {"name": "_add_items", "qualified_name": "_add_items", "args": ["self", "source_field_name", "target_field_name"], "decorators": [], "docstring": "", "start_line": 1054, "end_line": 1122, "is_async": false, "is_method": false}, {"name": "_remove_items", "qualified_name": "_remove_items", "args": ["self", "source_field_name", "target_field_name"], "decorators": [], "docstring": "", "start_line": 1124, "end_line": 1161, "is_async": false, "is_method": false}, {"name": "check_and_update_obj", "qualified_name": "check_and_update_obj", "args": ["obj"], "decorators": [], "docstring": "", "start_line": 638, "end_line": 643, "is_async": false, "is_method": false}, {"name": "remove", "qualified_name": "remove", "args": ["self"], "decorators": [], "docstring": "", "start_line": 685, "end_line": 698, "is_async": false, "is_method": false}, {"name": "clear", "qualified_name": "clear", "args": ["self"], "decorators": [], "docstring": "", "start_line": 701, "end_line": 702, "is_async": false, "is_method": false}, {"name": "_clear", "qualified_name": "_clear", "args": ["self", "queryset", "bulk"], "decorators": [], "docstring": "", "start_line": 705, "end_line": 716, "is_async": false, "is_method": false}], "classes": [{"name": "ForwardManyToOneDescriptor", "bases": [], "methods": ["__init__", "RelatedObjectDoesNotExist", "is_cached", "get_queryset", "get_prefetch_queryset", "get_object", "__get__", "__set__", "__reduce__"], "docstring": "Accessor to the related object on the forward side of a many-to-one or\none-to-one (via ForwardOneToOneDescriptor subclass) relation.\n\nIn the example::\n\n    class Child(Model):\n        parent = ForeignKey(Parent, related_name='children')\n\n``Child.parent`` is a ``ForwardManyToOneDescriptor`` instance.", "start_line": 73, "end_line": 266}, {"name": "ForwardOneToOneDescriptor", "bases": ["ForwardManyToOneDescriptor"], "methods": ["get_object", "__set__"], "docstring": "Accessor to the related object on the forward side of a one-to-one relation.\n\nIn the example::\n\n    class Restaurant(Model):\n        place = OneToOneField(Place, related_name='restaurant')\n\n``Restaurant.place`` is a ``ForwardOneToOneDescriptor`` instance.", "start_line": 269, "end_line": 314}, {"name": "ReverseOneToOneDescriptor", "bases": [], "methods": ["__init__", "RelatedObjectDoesNotExist", "is_cached", "get_queryset", "get_prefetch_queryset", "__get__", "__set__", "__reduce__"], "docstring": "Accessor to the related object on the reverse side of a one-to-one\nrelation.\n\nIn the example::\n\n    class Restaurant(Model):\n        place = OneToOneField(Place, related_name='restaurant')\n\n``Place.restaurant`` is a ``ReverseOneToOneDescriptor`` instance.", "start_line": 317, "end_line": 482}, {"name": "ReverseManyToOneDescriptor", "bases": [], "methods": ["__init__", "related_manager_cls", "__get__", "_get_set_deprecation_msg_params", "__set__"], "docstring": "Accessor to the related objects manager on the reverse side of a\nmany-to-one relation.\n\nIn the example::\n\n    class Child(Model):\n        parent = ForeignKey(Parent, related_name='children')\n\n``Parent.children`` is a ``ReverseManyToOneDescriptor`` instance.\n\nMost of the implementation is delegated t", "start_line": 485, "end_line": 539}, {"name": "ManyToManyDescriptor", "bases": ["ReverseManyToOneDescriptor"], "methods": ["__init__", "through", "related_manager_cls", "_get_set_deprecation_msg_params"], "docstring": "Accessor to the related objects manager on the forward and reverse sides of\na many-to-many relation.\n\nIn the example::\n\n    class Pizza(Model):\n        toppings = ManyToManyField(Topping, related_name='pizzas')\n\n``Pizza.toppings`` and ``Topping.pizzas`` are ``ManyToManyDescriptor``\ninstances.\n\nMost ", "start_line": 748, "end_line": 791}, {"name": "RelatedManager", "bases": ["superclass"], "methods": ["__init__", "__call__", "_apply_rel_filters", "_remove_prefetched_objects", "get_queryset", "get_prefetch_queryset", "add", "create", "get_or_create", "update_or_create", "set"], "docstring": "", "start_line": 550, "end_line": 743}, {"name": "ManyRelatedManager", "bases": ["superclass"], "methods": ["__init__", "__call__", "_build_remove_filters", "_apply_rel_filters", "_remove_prefetched_objects", "get_queryset", "get_prefetch_queryset", "constrained_target", "exists", "count", "add", "remove", "clear", "set", "create", "get_or_create", "update_or_create", "_add_items", "_remove_items"], "docstring": "", "start_line": 802, "end_line": 1161}], "calls": [], "module_docstring": "Accessors for related objects.\n\nWhen a field defines a relation between two models, each model class provides\nan attribute to access related instances of the other model class (unless the\nreverse accessor has been disabled with related_name='+').\n\nAccessors are implemented as descriptors in order to customize access and\nassignment. This module defines the descriptor classes.\n\nForward accessors follow foreign keys. Reverse accessors trace them back. For\nexample, with the following models::\n\n    class Parent(Model):\n        pass\n\n    class Child(Model):\n        parent = ForeignKey(Parent, related_name='children')\n\n ``child.parent`` is a forward many-to-one relation. ``parent.children`` is a\nreverse many-to-one relation.\n\nThere are three types of relations (many-to-one, one-to-one, and many-to-many)\nand two directions (forward and reverse) for a total of six combinations.\n\n1. Related instance on the forward side of a many-to-one relation:\n   ``ForwardManyToOneDescriptor``.\n\n   Uniqueness of foreign key values is irrelevant to accessing the related\n   instance, making the many-to-one and one-to-one cases identical as far as\n   the descriptor is concerned. The constraint is checked upstream (unicity\n   validation in forms) or downstream (unique indexes in the database).\n\n2. Related instance on the forward side of a one-to-one\n   relation: ``ForwardOneToOneDescriptor``.\n\n   It avoids querying the database when accessing the parent link field in\n   a multi-table inheritance scenario.\n\n3. Related instance on the reverse side of a one-to-one relation:\n   ``ReverseOneToOneDescriptor``.\n\n   One-to-one relations are asymmetrical, despite the apparent symmetry of the\n   name, because they're implemented in the database with a foreign key from\n   one table to another. As a consequence ``ReverseOneToOneDescriptor`` is\n   slightly different from ``ForwardManyToOneDescriptor``.\n\n4. Related objects manager for related instances on the reverse side of a\n   many-to-one relation: ``ReverseManyToOneDescriptor``.\n\n   Unlike the previous two classes, this one provides access to a collection\n   of objects. It returns a manager rather than an instance.\n\n5. Related objects manager for related instances on the forward or reverse\n   sides of a many-to-many relation: ``ManyToManyDescriptor``.\n\n   Many-to-many relations are symmetrical. The syntax of Django models\n   requires declaring them on one side but that's an implementation detail.\n   They could be declared on the other side without any change in behavior.\n   Therefore the forward and reverse descriptors can be the same.\n\n   If you're looking for ``ForwardManyToManyDescriptor`` or\n   ``ReverseManyToManyDescriptor``, use ``ManyToManyDescriptor`` instead.", "parse_error": ""}, {"file_path": "django/db/models/fields/related.py", "file_hash": "b673e9f51e92a741cd736f8e890af511607bec30e2ca130f520f9abd2c4cea0e", "imports": [{"module": "functools", "names": [], "is_from": false, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "functools", "names": ["partial"], "is_from": true, "alias": ""}, {"module": "django", "names": ["forms"], "is_from": true, "alias": ""}, {"module": "django.apps", "names": ["apps"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["SettingsReference"], "is_from": 