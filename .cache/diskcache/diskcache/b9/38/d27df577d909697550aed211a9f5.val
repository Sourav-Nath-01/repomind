ire quoting should be redirected to their slash version.", "start_line": 248, "end_line": 258, "is_async": false, "is_method": false}, {"name": "test_prepend_www_custom_urlconf", "qualified_name": "test_prepend_www_custom_urlconf", "args": ["self"], "decorators": ["override_settings(APPEND_SLASH=False, PREPEND_WWW=True)"], "docstring": "", "start_line": 261, "end_line": 266, "is_async": false, "is_method": false}, {"name": "test_prepend_www_append_slash_have_slash_custom_urlconf", "qualified_name": "test_prepend_www_append_slash_have_slash_custom_urlconf", "args": ["self"], "decorators": ["override_settings(APPEND_SLASH=True, PREPEND_WWW=True)"], "docstring": "", "start_line": 269, "end_line": 274, "is_async": false, "is_method": false}, {"name": "test_prepend_www_append_slash_slashless_custom_urlconf", "qualified_name": "test_prepend_www_append_slash_slashless_custom_urlconf", "args": ["self"], "decorators": ["override_settings(APPEND_SLASH=True, PREPEND_WWW=True)"], "docstring": "", "start_line": 277, "end_line": 282, "is_async": false, "is_method": false}, {"name": "test_content_length_header_added", "qualified_name": "test_content_length_header_added", "args": ["self"], "decorators": [], "docstring": "", "start_line": 286, "end_line": 290, "is_async": false, "is_method": false}, {"name": "test_content_length_header_not_added_for_streaming_response", "qualified_name": "test_content_length_header_not_added_for_streaming_response", "args": ["self"], "decorators": [], "docstring": "", "start_line": 292, "end_line": 296, "is_async": false, "is_method": false}, {"name": "test_content_length_header_not_changed", "qualified_name": "test_content_length_header_not_changed", "args": ["self"], "decorators": [], "docstring": "", "start_line": 298, "end_line": 303, "is_async": false, "is_method": false}, {"name": "test_disallowed_user_agents", "qualified_name": "test_disallowed_user_agents", "args": ["self"], "decorators": ["override_settings(DISALLOWED_USER_AGENTS=[re.compil