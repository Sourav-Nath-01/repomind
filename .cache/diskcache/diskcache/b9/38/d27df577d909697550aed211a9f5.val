  palette is a named palette; one of 'light', 'dark', or 'nocolor'.\n    role is a named st", "start_line": 137, "end_line": 215, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "termcolors.py", "parse_error": ""}, {"file_path": "django/utils/hashable.py", "file_hash": "a0a03b6f828c485628bbcdbbf2ea0a37c3a122bd6fff81efaa99c5b965fa09c6", "imports": [{"module": "django.utils.itercompat", "names": ["is_iterable"], "is_from": true, "alias": ""}], "functions": [{"name": "make_hashable", "qualified_name": "make_hashable", "args": ["value"], "decorators": [], "docstring": "", "start_line": 4, "end_line": 19, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/utils/lorem_ipsum.py", "file_hash": "3ff0522ec2130cfd995bd1093f2e9c8859de89bd22cfd7b3073d8b0fb0958911", "imports": [{"module": "random", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "sentence", "qualified_name": "sentence", "args": [], "decorators": [], "docstring": "Return a randomly generated sentence of lorem ipsum text.\n\nThe first word is capitalized, and the sentence ends in either a period or\nquestion mark. Commas are added at random.", "start_line": 56, "end_line": 68, "is_async": false, "is_method": false}, {"name": "paragraph", "qualified_name": "paragraph", "args": [], "decorators": [], "docstring": "Return a randomly generated paragraph of lorem ipsum text.\n\nThe paragraph consists of between 1 and 4 sentences, inclusive.", "start_line": 71, "end_line": 77, "is_async": false, "is_method": false}, {"name": "paragraphs", "qualified_name": "paragraphs", "args": ["count", "common"], "decorators": [], "docstring": "Return a list of paragraphs as returned by paragraph().\n\nIf `common` is True, then the first paragraph will be the standard\n'lorem ipsum' paragraph. Otherwise, the first paragraph will be random\nLatin text. Either way, subsequent paragraphs will be 