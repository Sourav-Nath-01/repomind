orators": [], "docstring": "Return a dict of migration plans which will achieve the\nchange from from_state to to_state. The dict has app labels\nas keys and a list of migrations as values.\n\nThe resulting migrations aren't specially named, but the names\ndo matter for dependencies inside the set.\n\nconvert_apps is the list of apps", "start_line": 104, "end_line": 199, "is_async": false, "is_method": false}, {"name": "_prepare_field_lists", "qualified_name": "_prepare_field_lists", "args": ["self"], "decorators": [], "docstring": "Prepare field lists and a list of the fields that used through models\nin the old state so dependencies can be made from the through model\ndeletion to the field that uses it.", "start_line": 201, "end_line": 223, "is_async": false, "is_method": false}, {"name": "_generate_through_model_map", "qualified_name": "_generate_through_model_map", "args": ["self"], "decorators": [], "docstring": "Through model map generation.", "start_line": 225, "end_line": 238, "is_async": false, "is_method": false}, {"name": "_resolve_dependency", "qualified_name": "_resolve_dependency", "args": ["dependency"], "decorators": ["staticmethod"], "docstring": "Return the resolved dependency and a boolean denoting whether or not\nit was swappable.", "start_line": 241, "end_line": 249, "is_async": false, "is_method": false}, {"name": "_build_migration_list", "qualified_name": "_build_migration_list", "args": ["self", "graph"], "decorators": [], "docstring": "Chop the lists of operations up into migrations with dependencies on\neach other. Do this by going through an app's list of operations until\none is found that has an outgoing dependency that isn't in another\napp's migration yet (hasn't been chopped off its list). Then chop off\nthe operations before i", "start_line": 251, "end_line": 336, "is_async": false, "is_method": false}, {"name": "_sort_migrations", "qualified_name": "_sort_migrations", "args": ["self"], "decorators": [], "docstring": "Reorder to make