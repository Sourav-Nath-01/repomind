cstring": "Get the Geometry at the specified index.", "start_line": 639, "end_line": 644, "is_async": false, "is_method": false}, {"name": "__len__", "qualified_name": "__len__", "args": ["self"], "decorators": [], "docstring": "Return the number of geometries in this Geometry Collection.", "start_line": 646, "end_line": 648, "is_async": false, "is_method": false}, {"name": "add", "qualified_name": "add", "args": ["self", "geom"], "decorators": [], "docstring": "Add the geometry to this Geometry Collection.", "start_line": 650, "end_line": 662, "is_async": false, "is_method": false}, {"name": "point_count", "qualified_name": "point_count", "args": ["self"], "decorators": ["property"], "docstring": "Return the number of Points in this Geometry Collection.", "start_line": 665, "end_line": 668, "is_async": false, "is_method": false}, {"name": "tuple", "qualified_name": "tuple", "args": ["self"], "decorators": ["property"], "docstring": "Return a tuple representation of this Geometry Collection.", "start_line": 671, "end_line": 673, "is_async": false, "is_method": false}], "classes": [{"name": "OGRGeometry", "bases": ["GDALBase"], "methods": ["__init__", "__getstate__", "__setstate__", "_from_wkb", "_from_json", "from_bbox", "from_json", "from_gml", "__or__", "__and__", "__sub__", "__xor__", "__eq__", "__str__", "dimension", "_get_coord_dim", "_set_coord_dim", "geom_count", "point_count", "num_points", "num_coords", "geom_type", "geom_name", "area", "envelope", "empty", "extent", "_get_srs", "_set_srs", "_get_srid", "_set_srid", "_geos_ptr", "geos", "gml", "hex", "json", "kml", "wkb_size", "wkb", "wkt", "ewkt", "clone", "close_rings", "transform", "_topology", "intersects", "equals", "disjoint", "touches", "crosses", "within", "contains", "overlaps", "_geomgen", "boundary", "convex_hull", "difference", "intersection", "sym_difference", "union"], "docstring": "Encapsulate an OGR geometry.", "start_line": 59, "end_line": 498}, {"name": "Point", "bases": ["OGRGeometry"], "methods": ["_geos_ptr", "_create_empty", "x", "y", "z", "tuple"], "docstring": "", "start_line": 502, "end_line": 535}, {"name": "LineString", "bases": ["OGRGeometry"], "methods": ["__getitem__", "__len__", "tuple", "_listarr", "x", "y", "z"], "docstring": "", "start_line": 538, "end_line": 586}, {"name": "LinearRing", "bases": ["LineString"], "methods": [], "docstring": "", "start_line": 590, "end_line": 591}, {"name": "Polygon", "bases": ["OGRGeometry"], "methods": ["__len__", "__getitem__", "shell", "tuple", "point_count", "centroid"], "docstring": "", "start_line": 594, "end_line": 632}, {"name": "GeometryCollection", "bases": ["OGRGeometry"], "methods": ["__getitem__", "__len__", "add", "point_count", "tuple"], "docstring": "The Geometry Collection class.", "start_line": 636, "end_line": 674}, {"name": "MultiPoint", "bases": ["GeometryCollection"], "methods": [], "docstring": "", "start_line": 678, "end_line": 679}, {"name": "MultiLineString", "bases": ["GeometryCollection"], "methods": [], "docstring": "", "start_line": 682, "end_line": 683}, {"name": "MultiPolygon", "bases": ["GeometryCollection"], "methods": [], "docstring": "", "start_line": 686, "end_line": 687}], "calls": [], "module_docstring": "The OGRGeometry is a wrapper for using the OGR Geometry class\n(see https://www.gdal.org/classOGRGeometry.html).  OGRGeometry\nmay be instantiated when reading geometries from OGR Data Sources\n(e.g. SHP files), or when given OGC WKT (a string).\n\nWhile the 'full' API is not present yet, the API is \"pythonic\" unlike\nthe traditional and \"next-generation\" OGR Python bindings.  One major\nadvantage OGR Geometries have over their GEOS counterparts is support\nfor spatial reference systems and their transformation.\n\nExample:\n >>> from django.contrib.gis.gdal import OGRGeometry, OGRGeomType, SpatialReference\n >>> wkt1, wkt2 = 'POINT(-90 30)', 'POLYGON((0 0, 5 0, 5 5, 0 5)'\n >>> pnt = OGRGeometry(wkt1)\n >>> print(pnt)\n POINT (-90 30)\n >>> mpnt = OGRGeometry(OGRGeomType('MultiPoint'), SpatialReference('WGS84'))\n >>> mpnt.add(wkt1)\n >>> mpnt.add(wkt1)\n >>> print(mpnt)\n MULTIPOINT (-90 30,-90 30)\n >>> print(mpnt.srs.name)\n WGS 84\n >>> print(mpnt.srs.proj)\n +proj=longlat +ellps=WGS84 +datum=WGS84 +no_defs\n >>> mpnt.transform(SpatialReference('NAD27'))\n >>> print(mpnt.proj)\n +proj=longlat +ellps=clrk66 +datum=NAD27 +no_defs\n >>> print(mpnt)\n MULTIPOINT (-89.999930378602485 29.999797886557641,-89.999930378602485 29.999797886557641)\n\n The OGRGeomType class is to make it easy to specify an OGR geometry type:\n >>> from django.contrib.gis.gdal import OGRGeomType\n >>> gt1 = OGRGeomType(3) # Using an integer for the type\n >>> gt2 = OGRGeomType('Polygon') # Using a string\n >>> gt3 = OGRGeomType('POLYGON') # It's case-insensitive\n >>> print(gt1 == 3, gt1 == 'Polygon') # Equivalence works w/non-OGRGeomType objects\n True True", "parse_error": ""}, {"file_path": "django/contrib/gis/gdal/libgdal.py", "file_hash": "aeb8e51c05ab48c325ef6b7809b99d52b0176e4fcab6ac0c54c9e7760c81de9e", "imports": [{"module": "logging", "names": [], "is_from": false, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "ctypes", "names": ["CDLL", "CFUNCTYPE", "c_char_p", "c_int"], "is_from": true, "alias": ""}, {"module": "ctypes.util", "names": ["find_library"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.error", "names": ["GDALException"], "is_from": true, "alias": ""}, {"module": "django.core.exceptions", "names": ["ImproperlyConfigured"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "ctypes", "names": ["WinDLL"], "is_from": true, "alias": ""}], "functions": [{"name": "std_call", "qualified_name": "std_call", "args": ["func"], "decorators": [], "docstring": "Return the correct STDCALL function for certain OSR routines on Win32\nplatforms.", "