ers('password', 'credit_", "start_line": 41, "end_line": 78, "is_async": false, "is_method": false}, {"name": "decorator", "qualified_name": "decorator", "args": ["func"], "decorators": [], "docstring": "", "start_line": 29, "end_line": 37, "is_async": false, "is_method": false}, {"name": "decorator", "qualified_name": "decorator", "args": ["view"], "decorators": [], "docstring": "", "start_line": 64, "end_line": 77, "is_async": false, "is_method": false}, {"name": "sensitive_variables_wrapper", "qualified_name": "sensitive_variables_wrapper", "args": [], "decorators": ["functools.wraps(func)"], "docstring": "", "start_line": 31, "end_line": 36, "is_async": false, "is_method": false}, {"name": "sensitive_post_parameters_wrapper", "qualified_name": "sensitive_post_parameters_wrapper", "args": ["request"], "decorators": ["functools.wraps(view)"], "docstring": "", "start_line": 66, "end_line": 76, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/core/servers/basehttp.py", "file_hash": "81ec42f49c41aa84662c8be22958b0adc2b316c7a18f35b461c2cbbd4e2cb63b", "imports": [{"module": "logging", "names": [], "is_from": false, "alias": ""}, {"module": "socket", "names": [], "is_from": false, "alias": ""}, {"module": "socketserver", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "wsgiref", "names": ["simple_server"], "is_from": true, "alias": ""}, {"module": "django.core.exceptions", "names": ["ImproperlyConfigured"], "is_from": true, "alias": ""}, {"module": "django.core.handlers.wsgi", "names": ["LimitedStream"], "is_from": true, "alias": ""}, {"module": "django.core.wsgi", "names": ["get_wsgi_application"], "is_from": true, "alias": ""}, {"module": "django.utils.module_loading", "names": ["import_string"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}], "functi