od": false}, {"name": "catalog", "qualified_name": "catalog", "args": [], "decorators": [], "docstring": "Return the current active catalog for further processing.\nThis can be used if you need to modify the catalog or want to access the\nwhole message catalog instead of just translating one string.", "start_line": 257, "end_line": 270, "is_async": false, "is_method": false}, {"name": "gettext", "qualified_name": "gettext", "args": ["message"], "decorators": [], "docstring": "Translate the 'message' string. It uses the current thread to find the\ntranslation object to use. If no current translation is activated, the\nmessage will be run through the default translation object.", "start_line": 273, "end_line": 296, "is_async": false, "is_method": false}, {"name": "pgettext", "qualified_name": "pgettext", "args": ["context", "message"], "decorators": [], "docstring": "", "start_line": 299, "end_line": 307, "is_async": false, "is_method": false}, {"name": "gettext_noop", "qualified_name": "gettext_noop", "args": ["message"], "decorators": [], "docstring": "Mark strings for translation but don't translate them now. This can be\nused to store strings in global variables that should stay in the base\nlanguage (because they might be used externally) and will be translated\nlater.", "start_line": 310, "end_line": 317, "is_async": false, "is_method": false}, {"name": "do_ntranslate", "qualified_name": "do_ntranslate", "args": ["singular", "plural", "number", "translation_function"], "decorators": [], "docstring": "", "start_line": 320, "end_line": 328, "is_async": false, "is_method": false}, {"name": "ngettext", "qualified_name": "ngettext", "args": ["singular", "plural", "number"], "decorators": [], "docstring": "Return a string of the translation of either the singular or plural,\nbased on the number.", "start_line": 331, "end_line": 336, "is_async": false, "is_method": false}, {"name": "npgettext", "qualified_name": "npgettext", "args": ["context", "singular", "plural", "n