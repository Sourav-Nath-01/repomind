, "calls": [], "module_docstring": "Interfaces for serializing Django objects.\n\nUsage::\n\n    from django.core import serializers\n    json = serializers.serialize(\"json\", some_queryset)\n    objects = list(serializers.deserialize(\"json\", json))\n\nTo add your own serializers, use the SERIALIZATION_MODULES setting::\n\n    SERIALIZATION_MODULES = {\n        \"csv\": \"path.to.csv.serializer\",\n        \"txt\": \"path.to.txt.serializer\",\n    }", "parse_error": ""}, {"file_path": "django/core/serializers/xml_serializer.py", "file_hash": "a99e680f2fc0575ea263b7f5520a9c27b81af30a00d656fd49573db2bd3a6c55", "imports": [{"module": "xml.dom", "names": ["pulldom"], "is_from": true, "alias": ""}, {"module": "xml.sax", "names": ["handler"], "is_from": true, "alias": ""}, {"module": "xml.sax.expatreader", "names": ["ExpatParser"], "is_from": true, "alias": ""}, {"module": "django.apps", "names": ["apps"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.core.exceptions", "names": ["ObjectDoesNotExist"], "is_from": true, "alias": ""}, {"module": "django.core.serializers", "names": ["base"], "is_from": true, "alias": ""}, {"module": "django.db", "names": ["DEFAULT_DB_ALIAS", "models"], "is_from": true, "alias": ""}, {"module": "django.utils.xmlutils", "names": ["SimplerXMLGenerator", "UnserializableContentError"], "is_from": true, "alias": ""}], "functions": [{"name": "getInnerText", "qualified_name": "getInnerText", "args": ["node"], "decorators": [], "docstring": "Get all the inner text of a DOM node (recursively).", "start_line": 323, "end_line": 334, "is_async": false, "is_method": false}, {"name": "indent", "qualified_name": "indent", "args": ["self", "level"], "decorators": [], "docstring": "", "start_line": 22, "end_line": 24, "is_async": false, "is_method": false}, {"name": "start_serialization", "qualified_name": "start_serialization", "args": ["self"], "decorators": [], "docstring