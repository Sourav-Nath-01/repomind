erty"], "docstring": "Has this model been swapped out for another? If so, return the model\nname of the replacement; otherwise, return None.\n\nFor historical reasons, model name lookups using get_model() are\ncase insensitive, so we make sure we are case insensitive here.", "start_line": 321, "end_line": 343, "is_async": false, "is_method": false}, {"name": "managers", "qualified_name": "managers", "args": ["self"], "decorators": ["cached_property"], "docstring": "", "start_line": 346, "end_line": 363, "is_async": false, "is_method": false}, {"name": "managers_map", "qualified_name": "managers_map", "args": ["self"], "decorators": ["cached_property"], "docstring": "", "start_line": 366, "end_line": 367, "is_async": false, "is_method": false}, {"name": "base_manager", "qualified_name": "base_manager", "args": ["self"], "decorators": ["cached_property"], "docstring": "", "start_line": 370, "end_line": 395, "is_async": false, "is_method": false}, {"name": "default_manager", "qualified_name": "default_manager", "args": ["self"], "decorators": ["cached_property"], "docstring": "", "start_line": 398, "end_line": 419, "is_async": false, "is_method": false}, {"name": "fields", "qualified_name": "fields", "args": ["self"], "decorators": ["cached_property"], "docstring": "Return a list of all forward fields on the model and its parents,\nexcluding ManyToManyFields.\n\nPrivate API intended only to be used by Django itself; get_fields()\ncombined with filtering of field properties is the public API for\nobtaining this field list.", "start_line": 422, "end_line": 453, "is_async": false, "is_method": false}, {"name": "concrete_fields", "qualified_name": "concrete_fields", "args": ["self"], "decorators": ["cached_property"], "docstring": "Return a list of all concrete fields on the model and its parents.\n\nPrivate API intended only to be used by Django itself; get_fields()\ncombined with filtering of field properties is the public API for\nobtaining this field list.", "start_lin