rators": [], "docstring": "Undo the effects of quote().", "start_line": 75, "end_line": 77, "is_async": false, "is_method": false}, {"name": "flatten", "qualified_name": "flatten", "args": ["fields"], "decorators": [], "docstring": "Return a list which is a single level of flattening of the original list.", "start_line": 80, "end_line": 90, "is_async": false, "is_method": false}, {"name": "flatten_fieldsets", "qualified_name": "flatten_fieldsets", "args": ["fieldsets"], "decorators": [], "docstring": "Return a list of field names from an admin fieldsets structure.", "start_line": 93, "end_line": 100, "is_async": false, "is_method": false}, {"name": "get_deleted_objects", "qualified_name": "get_deleted_objects", "args": ["objs", "request", "admin_site"], "decorators": [], "docstring": "Find all objects related to ``objs`` that should also be deleted. ``objs``\nmust be a homogeneous iterable of objects (e.g. a QuerySet).\n\nReturn a nested list of strings suitable for display in the\ntemplate with the ``unordered_list`` filter.", "start_line": 103, "end_line": 156, "is_async": false, "is_method": false}, {"name": "model_format_dict", "qualified_name": "model_format_dict", "args": ["obj"], "decorators": [], "docstring": "Return a `dict` with keys 'verbose_name' and 'verbose_name_plural',\ntypically for use with string formatting.\n\n`obj` may be a `Model` instance, `Model` subclass, or `QuerySet` instance.", "start_line": 222, "end_line": 238, "is_async": false, "is_method": false}, {"name": "model_ngettext", "qualified_name": "model_ngettext", "args": ["obj", "n"], "decorators": [], "docstring": "Return the appropriate `verbose_name` or `verbose_name_plural` value for\n`obj` depending on the count `n`.\n\n`obj` may be a `Model` instance, `Model` subclass, or `QuerySet` instance.\nIf `obj` is a `QuerySet` instance, `n` is optional and the length of the\n`QuerySet` is used.", "start_line": 241, "end_line": 256, "is_async": false, "is_method": false}, {"name": "lookup_field", "qualified_name": "lookup_field", "args": ["name", "obj", "model_admin"], "decorators": [], "docstring": "", "start_line": 259, "end_line": 282, "is_async": false, "is_method": false}, {"name": "_get_non_gfk_field", "qualified_name": "_get_non_gfk_field", "args": ["opts", "name"], "decorators": [], "docstring": "For historical reasons, the admin app relies on GenericForeignKeys as being\n\"not found\" by get_field(). This could likely be cleaned up.\n\nReverse relations should also be excluded as these aren't attributes of the\nmodel (rather something like `foo_set`).", "start_line": 285, "end_line": 303, "is_async": false, "is_method": false}, {"name": "label_for_field", "qualified_name": "label_for_field", "args": ["name", "model", "model_admin", "return_attr", "form"], "decorators": [], "docstring": "Return a sensible label for a field name. The name can be a callable,\nproperty (but not created with @property decorator), or the name of an\nobject's attribute, as well as a model field. If return_attr is True, also\nreturn the resolved attribute (which could be a callable). This will be\nNone if (and", "start_line": 306, "end_line": 363, "is_async": false, "is_method": false}, {"name": "help_text_for_field", "qualified_name": "help_text_for_field", "args": ["name", "model"], "decorators": [], "docstring": "", "start_line": 366, "end_line": 375, "is_async": false, "is_method": false}, {"name": "display_for_field", "qualified_name": "display_for_field", "args": ["value", "field", "empty_value_display"], "decorators": [], "docstring": "", "start_line": 378, "end_line": 400, "is_async": false, "is_method": false}, {"name": "display_for_value", "qualified_name": "display_for_value", "args": ["value", "empty_value_display", "boolean"], "decorators": [], "docstring": "", "start_line": 403, "end_line": 421, "is_async": false, "is_method": false}, {"name": "get_model_from_relation", "qualified_name": "get_model_from_relation", "args": ["field"], "decorators": [], "do