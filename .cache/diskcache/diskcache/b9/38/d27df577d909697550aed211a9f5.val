 ["mock"], "is_from": true, "alias": ""}, {"module": "django.forms", "names": ["BaseForm", "CharField", "DateField", "FileField", "Form", "IntegerField", "SplitDateTimeField", "ValidationError", "formsets"], "is_from": true, "alias": ""}, {"module": "django.forms.formsets", "names": ["BaseFormSet", "all_valid", "formset_factory"], "is_from": true, "alias": ""}, {"module": "django.forms.utils", "names": ["ErrorList"], "is_from": true, "alias": ""}, {"module": "django.test", "names": ["SimpleTestCase"], "is_from": true, "alias": ""}], "functions": [{"name": "clean", "qualified_name": "clean", "args": ["self"], "decorators": [], "docstring": "", "start_line": 27, "end_line": 34, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 43, "end_line": 45, "is_async": false, "is_method": false}, {"name": "make_choiceformset", "qualified_name": "make_choiceformset", "args": ["self", "formset_data", "formset_class", "total_forms", "initial_forms", "max_num_forms", "min_num_forms"], "decorators": [], "docstring": "Make a ChoiceFormset from the given formset_data.\nThe data should be given as a list of (choice, votes) tuples.", "start_line": 50, "end_line": 80, "is_async": false, "is_method": false}, {"name": "test_basic_formset", "qualified_name": "test_basic_formset", "args": ["self"], "decorators": [], "docstring": "A FormSet constructor takes the same arguments as Form. Create a\nFormSet for adding data. By default, it displays 1 blank form.", "start_line": 82, "end_line": 109, "is_async": false, "is_method": false}, {"name": "test_form_kwargs_formset", "qualified_name": "test_form_kwargs_formset", "args": ["self"], "decorators": [], "docstring": "Custom kwargs set on the formset instance are passed to the\nunderlying forms.", "start_line": 111, "end_line": 120, "is_async": false, "is_method": false}, {"name": "test_form_kwargs_formset_dynamic", "qualified_name": "test_form_kwargs_formset_dynamic", "args": ["self"], "decorators": [], "docstring": "Form kwargs can be passed dynamically in a formset.", "start_line": 122, "end_line": 132, "is_async": false, "is_method": false}, {"name": "test_form_kwargs_empty_form", "qualified_name": "test_form_kwargs_empty_form", "args": ["self"], "decorators": [], "docstring": "", "start_line": 134, "end_line": 138, "is_async": false, "is_method": false}, {"name": "test_formset_validation", "qualified_name": "test_formset_validation", "args": ["self"], "decorators": [], "docstring": "", "start_line": 140, "end_line": 145, "is_async": false, "is_method": false}, {"name": "test_formset_validation_count", "qualified_name": "test_formset_validation_count", "args": ["self"], "decorators": [], "docstring": "A formset's ManagementForm is validated once per FormSet.is_valid()\ncall and each form of the formset is cleaned once.", "start_line": 147, "end_line": 171, "is_async": false, "is_method": false}, {"name": "test_formset_has_changed", "qualified_name": "test_formset_has_changed", "args": ["self"], "decorators": [], "docstring": "FormSet.has_changed() is True if any data is passed to its forms, even\nif the formset didn't validate.", "start_line": 173, "end_line": 187, "is_async": false, "is_method": false}, {"name": "test_formset_initial_data", "qualified_name": "test_formset_initial_data", "args": ["self"], "decorators": [], "docstring": "A FormSet can be prefilled with existing data by providing a list of\ndicts to the `initial` argument. By default, an extra blank form is\nincluded.", "start_line": 189, "end_line": 206, "is_async": false, "is_method": false}, {"name": "test_blank_form_unfilled", "qualified_name": "test_blank_form_unfilled", "args": ["self"], "decorators": [], "docstring": "A form that's displayed as blank may be submitted as blank.", "start_line": 208, "end_line": 212, "is_async": false, "is_method": false}, {"name": "test_second_form_partially_filled", "qualified_name": "test_second_form_partially_filled", "args": ["self"], "decorators": [], "docstring": "If at least one field is filled out on a blank form, it will be\nvalidated.", "start_line": 214, "end_line": 221, "is_async": false, "is_method": false}, {"name": "test_delete_prefilled_data", "qualified_name": "test_delete_prefilled_data", "args": ["self"], "decorators": [], "docstring": "Deleting prefilled data is an error. Removing data from form fields\nisn't the proper way to delete it.", "start_line": 223, "end_line": 233, "is_async": false, "is_method": false}, {"name": "test_displaying_more_than_one_blank_form", "qualified_name": "test_displaying_more_than_one_blank_form", "args": ["self"], "decorators": [], "docstring": "More than 1 empty form can be displayed using formset_factory's\n`extra` argument.", "start_line": 235, "end_line": 271, "is_async": false, "is_method": false}, {"name": "test_min_num_displaying_more_than_one_blank_form", "qualified_name": "test_min_num_displaying_more_than_one_blank_form", "args": ["self"], "decorators": [], "docstring": "\"\nMore than 1 empty form can also be displayed using formset_factory's\nmin_num argument. It will (essentially) increment the extra argument.", "start_line": 273, "end_line": 292, "is_async": false, "is_method": false}, {"name": "test_min_num_displaying_more_than_one_blank_form_with_zero_extra", "qualified_name": "test_min_num_displaying_more_than_one_blank_form_with_zero_extra", "args": ["self"], "decorators": [], "docstring": "More than 1 empty form can be displayed using min_num.", "start_line": 294, "end_line": 309, "is_async": false, "is_method": false}, {"name": "test_single_form_completed", "qualified_name": "test_single_form_completed", "args": ["self"], "decorators": [], "docstring": "Just one form may be completed.", "start_line": 311, "end_line": 328, "is_async": false, "is_method": false}, {"name": "test_formset_validate_max_flag", "qualified_name": "test_formset_validate_max_flag", "args": ["self"], "decorators": [], "docstring": "If validate_max is set and max_num is less than TOTAL_FORMS in the\ndata, a ValidationError is raised. MAX_NUM_FORMS in the data is\nirrelevant here (it's output as a hint for the client but its value\nin the returned data is not checked).", "start_line": 330, "end_line": 350, "is_async": false, "is_method": false}, {"name": "test_formset_validate_min_flag", "qualified_name": "test_formset_validate_min_flag", "args": ["self"], "decorators": [], "docstring": "If validate_min is set and min_num is more than TOTAL_FORMS in the\ndata, a ValidationError is raised. MIN_NUM_FORMS in the data is\nirrelevant here (it's output as a hint for the client but its value\nin the returned data is not checked).", "start_line": 352, "end_line": 372, "is_async": false, "is_method": false}, {"name": "test_formset_validate_min_unchanged_forms", "qualified_name": "test_formset_validate_min_unchanged_forms", "args": ["self"], "decorators": [], "docstring": "min_num validation doesn't consider unchanged forms with initial data\nas \"empty\".", "start_line": 374, "end_line": 397, "is_async": false, "is_method": false}, {"name": "test_formset_validate_min_excludes_empty_forms", "qualified_name": "test_formset_validate_min_excludes_empty_forms", "args": ["self"], "decorators": [], "docstring": "", "start_line": 399, "end_line": 408, "is_async": false, "is_method": false}, {"name": "test_second_form_partially_filled_2", "qualified_name": "test_second_form_partially_filled_2", "args": ["self"], "decorators": [], "docstring": "A partially completed form is invalid.", "start_line": 410, "end_line": 427, "is_async": false, "is_method": false}, {"name": "test_more_initial_data", "qualified_name": "test_more_initial_data", "args": ["self"], "decorators": [], "docstring": "The extra argument works when the formset is pre-filled with initial\ndata.", "start_line": 429, "end_line": 457, "is_async": false, "is_method": false}, {"name": "test_formset_with_deletion", "qualified_name": "test_formset_with_deletion", "args": ["self"], "decorators": [], "docstring": "formset_factory's can_delete argument adds a boolean \"delete\" field to\neach form. When that boolean field is True, the form will be in\nformset.deleted_forms.", "start_line": 459, "end_line": 513, "is_async": false, "is_method": false}, {"name": "test_formset_with_deletion_remove_deletion_flag", "qualified_name": "test_formset_with_deletion_remove_deletion_flag", "args": ["self"], "decorators": [], "docstring": "If a form is filled with something and can_delete is also checked, that\nform's errors shouldn't make the entire formset invalid since it's\ngoing to be deleted.", "start_line": 515, "end_line": 542, "is_async": false, "is_method": false}, {"name": "test_formset_with_deletion_invalid_deleted_form", "qualified_name": "test_formset_with_deletion_invalid_deleted_form", "args": ["self"], "decorators": [], "docstring": "deleted_forms works on a valid formset even if a deleted form would\nhave been invalid.", "start_line": 544, "end_line": 563, "is_async": false, "is_method": false}, {"name": "test_formsets_with_ordering", "qualified_name": "test_formsets_with_ordering", "args": ["self"], "decorators": [], "docstring": "formset_factory's can_order argument adds an integer field to each\nform. When form validation succeeds, [form.cleaned_data for form in formset.forms]\nwill have the data in the correct order specified by the ordering\nfields. If a number is duplicated in the set of ordering fields, for\ninstance form 0", "start_line": 565, "end_line": 618, "is_async": false, "is_method": false}, {"name": "test_empty_ordered_fields", "qualified_name": "test_empty_ordered_fields", "args": ["self"], "decorators": [], "docstring": "Ordering fields are allowed to be left blank. If they are left blank,\nthey'll be sorted below everything else.", "start_line": 620, "end_line": 654, "is_async": false, "is_method": false}, {"name": "test_ordering_blank_fieldsets", "qualified_name": "test_ordering_blank_fieldsets", "args": ["self"], "decorators": [], "docstring": "Ordering works with blank fieldsets.", "start_line": 656, "end_line": 670, "is_async": false, "is_method": false}, {"name": "test_formset_with_ordering_and_deletion", "qualified_name": "test_formset_with_ordering_and_deletion", "args": ["self"], "decorators": [], "docstring": "FormSets with ordering + deletion.", "start_line": 672, "end_line": 739, "is_async": false, "is_method": false}, {"name": "test_invalid_deleted_form_with_ordering", "qualified_name": "test_invalid_deleted_form_with_ordering", "args": ["self"], "decorators": [], "docstring": "Can get ordered_forms from a valid formset even if a deleted form\nwould have been invalid.", "start_line": 741, "end_line": 759, "is_async": false, "is_method": false}, {"name": "test_clean_hook", "qualified_name": "test_clean_hook", "args": ["self"], "decorators": [], "docstring": "FormSets have a clean() hook for doing extra validation that isn't tied\nto any form. It follows the same pattern as the clean() hook on Forms.", "start_line": 761, "end_line": 792, "is_async": false, "is_method": false}, {"name": "test_limiting_max_forms", "qualified_name": "test_limiting_max_forms", "args": ["self"], "decorators": [], "docstring": "Limiting the maximum number of forms with max_num.", "start_line": 794, "end_line": 818, "is_async": false, "is_method": false}, {"name": "test_limited_max_forms_two", "qualified_name": "test_limited_max_forms_two", "args": ["self"], "decorators": [], "docstring": "", "start_line": 820, "end_line": 832, "is_async": false, "is_method": false}, {"name": "test_limiting_extra_lest_than_max_num", "qualified_name": "test_limiting_extra_lest_than_max_num", "args": ["self"], "decorators": [], "docstring": "max_num has no effect when extra is less than max_num.", "start_line": 834, "end_line": 845, "is_async": false, "is_method": false}, {"name": "test_max_num_with_initial_data", "qualified_name": "test_max_num_with_initial_data", "args": ["self"], "decorators": [], "docstring": "max_num with initial data.", "start_line": 847, "end_line": 866, "is_async": false, "is_method": false}, {"name": "test_max_num_zero", "qualified_name": "test_max_num_zero", "args": ["self"], "decorators": [], "docstring": "If max_num is 0 then no form is rendered at all, regardless of extra,\nunless initial data is present.", "start_line": 868, "end_line": 878, "is_async": false, "is_method": false}, {"name": "test_max_num_zero_with_initial", "qualified_name": "test_max_num_zero_with_initial", "args": ["self"], "decorators": [], "docstring": "", "start_line": 880, "end_line": 897, "is_async": false, "is_method": false}, {"name": "test_more_initial_than_max_num", "qualified_name": "test_more_initial_than_max_num", "args": ["self"], "decorators": [], "docstring": "More initial forms than max_num results in all initial forms being\ndisplayed (but no extra forms).", "start_line": 899, "end_line": 922, "is_async": false, "is_method": false}, {"name": "test_more_initial_form_result_in_one", "qualified_name": "test_more_initial_form_result_in_one", "args": ["self"], "decorators": [], "docstring": "One form from initial and extra=3 with max_num=2 results in the one\ninitial form and one extra.", "start_line": 924, "end_line": 943, "is_async": false, "is_method": false}, {"name": "test_management_form_prefix", "qualified_name": "test_management_form_prefix", "args": ["self"], "decorators": [], "docstring": "The management form has the correct prefix.", "start_line": 945, "end_line": 958, "is_async": false, "is_method": false}, {"name": "test_non_form_errors", "qualified_name": "test_non_form_errors", "args": ["self"], "decorators": [], "docstring": "", "start_line": 960, "end_line": 971, "is_async": false, "is_method": false}, {"name": "test_formset_iteration", "qualified_name": "test_formset_iteration", "args": ["self"], "decorators": [], "docstring": "Formset instances are iterable.", "start_line": 973, "end_line": 1000, "is_asyn