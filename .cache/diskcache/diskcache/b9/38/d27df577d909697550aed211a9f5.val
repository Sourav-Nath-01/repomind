", "args": ["self", "include_auto_created", "include_swapped"], "decorators": [], "docstring": "Return an iterable of models.\n\nBy default, the following models aren't included:\n\n- auto-created models for many-to-many relations without\n  an explicit intermediate table,\n- models that have been swapped out.\n\nSet the corresponding keyword argument to True to include such models.\nKeyword arguments ", "start_line": 183, "end_line": 202, "is_async": false, "is_method": false}, {"name": "import_models", "qualified_name": "import_models", "args": ["self"], "decorators": [], "docstring": "", "start_line": 204, "end_line": 211, "is_async": false, "is_method": false}, {"name": "ready", "qualified_name": "ready", "args": ["self"], "decorators": [], "docstring": "Override this method in subclasses to run code when Django starts.", "start_line": 213, "end_line": 216, "is_async": false, "is_method": false}], "classes": [{"name": "AppConfig", "bases": [], "methods": ["__init__", "__repr__", "_path_from_module", "create", "get_model", "get_models", "import_models", "ready"], "docstring": "Class representing a Django application and its configuration.", "start_line": 10, "end_line": 216}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/apps/__init__.py", "file_hash": "b74178c9c794e126f26cc79606fa6e13a46c19a10d9900956cd49d4ae5e210cb", "imports": [{"module": "config", "names": ["AppConfig"], "is_from": true, "alias": ""}, {"module": "registry", "names": ["apps"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/apps/registry.py", "file_hash": "d1e5b3cbadd6446604bccdb1e631cdb263035efc5c1d8e311dbb1207fe4ea5ab", "imports": [{"module": "functools", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "threading", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], 