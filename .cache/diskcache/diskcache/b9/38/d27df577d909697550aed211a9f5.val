ors": [], "docstring": "Removing an FK and the model it targets in the same change must remove\nthe FK field before the model to maintain consistency.", "start_line": 1872, "end_line": 1884, "is_async": false, "is_method": false}, {"name": "test_add_many_to_many", "qualified_name": "test_add_many_to_many", "args": ["self", "mocked_ask_method"], "decorators": ["mock.patch('django.db.migrations.questioner.MigrationQuestioner.ask_not_null_addition', side_effect=AssertionError('Should not have prompted for not null addition'))"], "docstring": "#22435 - Adding a ManyToManyField should not prompt for a default.", "start_line": 1888, "end_line": 1894, "is_async": false, "is_method": false}, {"name": "test_alter_many_to_many", "qualified_name": "test_alter_many_to_many", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1896, "end_line": 1903, "is_async": false, "is_method": false}, {"name": "test_create_with_through_model", "qualified_name": "test_create_with_through_model", "args": ["self"], "decorators": [], "docstring": "Adding a m2m with a through model and the models that use it should be\nordered correctly.", "start_line": 1905, "end_line": 1919, "is_async": false, "is_method": false}, {"name": "test_many_to_many_removed_before_through_model", "qualified_name": "test_many_to_many_removed_before_through_model", "args": ["self"], "decorators": [], "docstring": "Removing a ManyToManyField and the \"through\" model in the same change\nmust remove the field before the model to maintain consistency.", "start_line": 1921, "end_line": 1935, "is_async": false, "is_method": false}, {"name": "test_many_to_many_removed_before_through_model_2", "qualified_name": "test_many_to_many_removed_before_through_model_2", "args": ["self"], "decorators": [], "docstring": "Removing a model that contains a ManyToManyField and the \"through\" model\nin the same change must remove the field before the model to maintain\nconsistency.", "start_line": 1937, "end_line": 1953, "is_