t_with_slash() returns True.", "start_line": 98, "end_line": 114, "is_async": false, "is_method": false}, {"name": "process_response", "qualified_name": "process_response", "args": ["self", "request", "response"], "decorators": [], "docstring": "Send broken link emails for relevant 404 NOT FOUND responses.", "start_line": 119, "end_line": 138, "is_async": false, "is_method": false}, {"name": "is_internal_request", "qualified_name": "is_internal_request", "args": ["self", "domain", "referer"], "decorators": [], "docstring": "Return True if the referring URL is the same domain as the current\nrequest.", "start_line": 140, "end_line": 146, "is_async": false, "is_method": false}, {"name": "is_ignorable_request", "qualified_name": "is_ignorable_request", "args": ["self", "request", "uri", "domain", "referer"], "decorators": [], "docstring": "Return True if the given request *shouldn't* notify the site managers\naccording to project settings or in situations outlined by the inline\ncomments.", "start_line": 148, "end_line": 173, "is_async": false, "is_method": false}], "classes": [{"name": "CommonMiddleware", "bases": ["MiddlewareMixin"], "methods": ["process_request", "should_redirect_with_slash", "get_full_path_with_slash", "process_response"], "docstring": "\"Common\" middleware for taking care of some basic operations:\n\n    - Forbid access to User-Agents in settings.DISALLOWED_USER_AGENTS\n\n    - URL rewriting: Based on the APPEND_SLASH and PREPEND_WWW settings,\n      append missing slashes and/or prepends missing \"www.\"s.\n\n        - If APPEND_SLASH is s", "start_line": 13, "end_line": 114}, {"name": "BrokenLinkEmailsMiddleware", "bases": ["MiddlewareMixin"], "methods": ["process_response", "is_internal_request", "is_ignorable_request"], "docstring": "", "start_line": 117, "end_line": 173}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/middleware/http.py", "file_hash": "2624465efb5f997c584e89b2ee075ee69706e39197ed1d2aa57888e45934e9d1", "imports": [{"module": "django.utils.cache", "names": ["cc_delim_re", "get_conditional_response", "set_response_etag"], "is_from": true, "alias": ""}, {"module": "django.utils.deprecation", "names": ["MiddlewareMixin"], "is_from": true, "alias": ""}, {"module": "django.utils.http", "names": ["parse_http_date_safe"], "is_from": true, "alias": ""}], "functions": [{"name": "process_response", "qualified_name": "process_response", "args": ["self", "request", "response"], "decorators": [], "docstring": "", "start_line": 14, "end_line": 36, "is_async": false, "is_method": false}, {"name": "needs_etag", "qualified_name": "needs_etag", "args": ["self", "response"], "decorators": [], "docstring": "Return True if an ETag header should be added to response.", "start_line": 38, "end_line": 41, "is_async": false, "is_method": false}], "classes": [{"name": "ConditionalGetMiddleware", "bases": ["MiddlewareMixin"], "methods": ["process_response", "needs_etag"], "docstring": "Handle conditional GET operations. If the response has an ETag or\nLast-Modified header and the request has If-None-Match or If-Modified-Since,\nreplace the response with HttpNotModified. Add an ETag header if needed.", "start_line": 8, "end_line": 41}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/middleware/cache.py", "file_hash": "3b6a3fa32fd6aaa39d213f277204ce16ffbe5900d9c6c9553e029e57464659cf", "imports": [{"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.core.cache", "names": ["DEFAULT_CACHE_ALIAS", "caches"], "is_from": true, "alias": ""}, {"module": "django.utils.cache", "names": ["get_cache_key", "get_max_age", "has_vary_header", "learn_cache_key", "patch_response_headers"], "is_from": true, "alias": ""}, {"module": "django.utils.deprecation", "names": ["MiddlewareMixin"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "get_response"], "decorators": [], "docstring": "", "start_line": 64, "end_line": 69, "is_async": false, "is_method": false}, {"name": "_should_update_cache", "qualified_name": "_should_update_cache", "args": ["self", "request", "response"], "decorators": [], "docstring": "", "start_line": 71, "end_line": 72, "is_async": false, "is_method": false}, {"name": "process_response", "qualified_name": "process_response", "args": ["self", "request", "response"], "decorators": [], "docstring": "Set the cache, if needed.", "start_line": 74, "end_line": 110, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "get_response"], "decorators": [], "docstring": "", "start_line": 121, "end_line": 125, "is_async": false, "is_method": false}, {"name": "process_request", "qualified_name": "process_request", "args": ["self", "request"], "decorators": [], "docstring": "Check whether the page is already cached and return the cached\nversion if available.", "start_line": 127, "end_line": 153, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "get_response", "cache_timeout"], "decorators": [], "docstring": "", "start_line": 163, "end_line": 189, "is_async": false, "is_method": false}], "classes": [{"name": "UpdateCacheMiddleware", "bases": ["MiddlewareMixin"], "methods": ["__init__", "_should_update_cache", "process_response"], "docstring": "Response-phase cache middleware that updates the cache if the response is\ncacheable.\n\nMust be used as part of the two-part update/fetch cache middleware.\nUpdateCacheMiddleware must be the first piece of middleware in MIDDLEWARE\nso that it'll get called last during the response phase.", "start_line": 55, "end_line": 110}, {"name": "FetchFromCacheMiddleware", "bases": ["MiddlewareMixin"], "methods": ["__init__", "process_request"], "docstring": "Request-phase cache middleware that fetches a page from the cache.\n\nMust be used as part of the two-part update/fetch cache middleware.\nFetchFromCacheMiddleware must be the last piece of middleware in MIDDLEWARE\nso that it'll get called last during the request phase.", "start_line": 113, "end_line": 153}, {"name": "CacheMiddleware", "bases": ["UpdateCacheMiddleware", "FetchFromCacheMiddleware"], "methods": ["__init__"], "docstring": "Cache middleware that provides basic behavior for many simple sites.\n\nAlso used as the hook point for the cache decorator, which is generated\nusing the decorator-from-middleware utility.", "start_line": 156, "end_line": 189}], "calls": [], "module_docstring": "Cache middleware. If enabled, each Django-powered page will be cached based on\nURL. The canonical way to enable cache middleware is to set\n``UpdateCacheMiddleware`` as your first piece of middleware, and\n``FetchFromCacheMiddleware`` as the last::\n\n    MIDDLEWARE = [\n        'django.middleware.cache.UpdateCacheMiddleware',\n        ...\n        'django.middleware.cache.FetchFromCacheMiddleware'\n    ]\n\nThis is counter-intuitive, but correct: ``UpdateCacheMiddleware`` needs to run\nlast during the response phase, which processes middleware bottom-up;\n``FetchFromCacheMiddleware`` needs to run last during the request phase, which\nprocesses middleware top-down.\n\nThe single-class ``CacheMiddleware`` can be used for some simple sites.\nHowever, if any other piece of middleware needs to affect the cache key, you'll\nneed to use the two-part ``UpdateCacheMiddleware`` and\n``FetchFromCacheMiddleware``. This'll most often happen when you're using\nDjango's ``LocaleMiddleware``.\n\nMore details about how the caching works:\n\n* Only GET or HEAD-requests with status code 200 are cached.\n\n* The number of seconds each page is stored for is set by the \"max-age\" section\n  of the response's \"Cache-Control\" header, falling back to the\n  CACHE_MIDDLEWARE_SECONDS setting if the section was not found.\n\n* This middleware expects that a HEAD request is answered with the same response\n  headers exactly like the corresponding GET request.\n\n* When a hit occurs, a shallow copy of the original response object is returned\n  from process_request.\n\n* Pages will be cached based on the contents of the request headers listed in\n  the response's \"Vary\" header.\n\n* This middleware also sets ETag, Last-Modified, Expires and Cache-Control\n  headers on the response object.", "parse_error": ""}, {"file_path": "django/middleware/clickjacking.py", "file_hash": "e2bcec1b99bf67655a6cdec9ff96557858f5e17dc501bb34894e4b2a805bf63b", "imports": [{"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.utils.deprecation", "names": ["MiddlewareMixin"], "is_from": true, "alias": ""}], "functions": [{"name": "process_response", "qualified_name": "process_response", "args": ["self", "request", "response"], "decorators": [], "docstring": "", "start_line": 24, "end_line": 35, "is_async": false, "is_method": false}, {"name": "get_xframe_options_value", "qualified_name": "get_xframe_options_value", "args": ["self", "request", "response"], "decorators": [], "docstring": "Get the value to set for the X_FRAME_OPTIONS header. Use the value from\nthe X_FRAME_OPTIONS setting, or 'SAMEORIGIN' if not set.\n\nThis method can be overridden if needed, allowing it to vary based on\nthe request or response.", "start_line": 37, "end_line": 45, "is_async": false, "is_method": false}], "classes": [{"name": "XFrameOptionsMiddleware", "bases": ["MiddlewareMixin"], "methods": ["process_response", "get_xframe_options_value"], "docstring": "Set the X-Frame-Options HTTP header in HTTP responses.\n\nDo not set the header if it's already set or if the response contains\na xframe_options_exempt value set to True.\n\nBy default, set the X-Frame-Options header to 'SAMEORIGIN', meaning the\nresponse can only be loaded on a frame within the same sit", "start_line": 12, "end_line": 45}], "calls": [], "module_docstring": "Clickjacking Protection Middleware.\n\nThis module provides a middleware that implements protection against a\nmalicious site loading resources from your site in a hidden frame.", "parse_error": ""}, {"file_path": "django/middleware/csrf.py", "file_hash": "9336230c07a4a6eca01dd1d6193fe421b733e3d254ad36a4977b7a5e1226f2f5", "imports": [{"module": "logging", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "string", "names": [], "is_from": false, "alias": ""}, {"module": "urllib.parse", "names": ["urlparse"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.core.exceptions", "names": ["DisallowedHost", "ImproperlyConfigured"], "is_from": true, "alias": ""}, {"module": "django.urls", "names": ["get_callable"], "is_from": true, "alias": ""}, {"module": "django.utils.cache", "names": ["patch_vary_headers"], "is_from": true, "alias": ""}, {"module": "django.utils.crypto", "names": ["constant_time_compare", "get_random_string"], "is_from": true, "alias": ""}, {"module": "django.utils.deprecation", "names": ["MiddlewareMixin"], "is_from": true, "alias": ""}, {"module": "django.utils.http", "names": ["is_same_domain"], "is_from": true, "alias": ""}, {"module": "django.utils.log", "names": ["log_response"], "is_from": true, "alias": ""}], "functions": [{"name": "_get_failure_view", "qualified_name": "_get_failure_view", "args": [], "decorators": [], "docstring": "Return the view to be used for CSRF rejections.", "start_line": 36, "end_line": 38, "is_async": false, "is_method": false}, {"name": "_get_new_csrf_string", "qualified_name": "_get_new_csrf_string", "args": [], "decorators": [], "docstring": "", "start_line": 41, "end_line": 42, "is_async": false, "is_method": false}, {"name": "_salt_cipher_secret", "qualified_name": "_salt_cipher_secret", "args": ["secret"], "decorators": [], "docstring": "Given a secret (assumed to be a string of CSRF_ALLOWED_CHARS), generate a\ntoken by adding a salt and using it to encrypt the secret.", "start_line": 45, "end_line": 54, "is_async": false, "is_method": false}, {"name": "_unsalt_cipher_token", "qualified_name": "_unsalt_cipher_token", "args": ["token"], "decorators": [], "docstring": "Given a token (assumed to be a string of CSRF_ALLOWED_CHARS, of length\nCSRF_TOKEN_LENGTH, and that its first half is a salt), use it to decrypt\nthe second half to produce the original secret.", "start_line": 57, "end_line": 68, "is_async": false, "is_method": false}, {"name": "_get_new_csrf_token", "qualified_name": "_get_new_csrf_token", "args": [], "decorators": [], "docstring": "", "start_line": 71, "end_line": 72, "is_async": false, "is_method": false}, {"name": "get_token", "qualified_name": "get_token", "args": ["request"], "decorators": [], "docstring": "Return the CSRF token required for a POST form. The token is an\nalphanumeric value. A new token is created if one is not already set.\n\nA side effect of calling this function is to make the csrf_protect\ndecorator and the CsrfViewMiddleware add a CSRF cookie and a 'Vary: Cookie'\nheader to the outgoing", "start_line": 75, "end_line": 91, "is_async": false, "is_method": false}, {"name": "rotate_token", "qualified_name": "rotate_token", "args": ["request"], "decorators": [], "docstring": "Change the CSRF token in use for a request - should be done on login\nfor security purposes.", "start_line": 94, "end_line": 103, "is_async": false, "is_method": false}, {"name": "_sanitize_token", "qualified_name": "_sanitize_token", "args": ["token"], "decorators": [], "docstring": "", "start_line": 106, "end_line": 120, "is_async": false, "is_method": false}, {"name": "_compare_salted_tokens", "qualified_name": "_compare_salted_tokens", "args": ["request_csrf_token", "csrf_token"], "decorators": [], "docstring": "", "start_line": 123, "end_line": 129, "is_async": false, "is_method": false}, {"name": "_accept", "qualified_name": "_accept", "args": ["self", "request