o_list", "qualified_name": "do_get_language_info_list", "args": ["parser", "token"], "decorators": ["register.tag('get_language_info_list')"], "docstring": "Store a list of language information dictionaries for the given language\ncodes in a context variable. The language codes can be specified either as\na list of strings or a settings.LANGUAGES style list (or any sequence of\nsequences whose first items are language codes).\n\nUsage::\n\n    {% get_language_", "start_line": 232, "end_line": 253, "is_async": false, "is_method": false}, {"name": "language_name", "qualified_name": "language_name", "args": ["lang_code"], "decorators": ["register.filter"], "docstring": "", "start_line": 257, "end_line": 258, "is_async": false, "is_method": false}, {"name": "language_name_translated", "qualified_name": "language_name_translated", "args": ["lang_code"], "decorators": ["register.filter"], "docstring": "", "start_line": 262, "end_line": 264, "is_async": false, "is_method": false}, {"name": "language_name_local", "qualified_name": "language_name_local", "args": ["lang_code"], "decorators": ["register.filter"], "docstring": "", "start_line": 268, "end_line": 269, "is_async": false, "is_method": false}, {"name": "language_bidi", "qualified_name": "language_bidi", "args": ["lang_code"], "decorators": ["register.filter"], "docstring": "", "start_line": 273, "end_line": 274, "is_async": false, "is_method": false}, {"name": "do_get_current_language", "qualified_name": "do_get_current_language", "args": ["parser", "token"], "decorators": ["register.tag('get_current_language')"], "docstring": "Store the current language in the context.\n\nUsage::\n\n    {% get_current_language as language %}\n\nThis fetches the currently active language and puts its value into the\n``language`` context variable.", "start_line": 278, "end_line": 293, "is_async": false, "is_method": false}, {"name": "do_get_current_language_bidi", "qualified_name": "do_get_current_language_bidi", "args": ["parser", "