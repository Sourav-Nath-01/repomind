field_name", "kind", "order", "tzinfo"], "decorators": [], "docstring": "Return a list of datetime objects representing all available\ndatetimes for the given field_name, scoped to 'kind'.", "start_line": 838, "end_line": 857, "is_async": false, "is_method": false}, {"name": "none", "qualified_name": "none", "args": ["self"], "decorators": [], "docstring": "Return an empty QuerySet.", "start_line": 859, "end_line": 863, "is_async": false, "is_method": false}, {"name": "all", "qualified_name": "all", "args": ["self"], "decorators": [], "docstring": "Return a new QuerySet that is a copy of the current one. This allows a\nQuerySet to proxy for a model manager in some cases.", "start_line": 869, "end_line": 874, "is_async": false, "is_method": false}, {"name": "filter", "qualified_name": "filter", "args": ["self"], "decorators": [], "docstring": "Return a new QuerySet instance with the args ANDed to the existing\nset.", "start_line": 876, "end_line": 881, "is_async": false, "is_method": false}, {"name": "exclude", "qualified_name": "exclude", "args": ["self"], "decorators": [], "docstring": "Return a new QuerySet instance with NOT (args) ANDed to the existing\nset.", "start_line": 883, "end_line": 888, "is_async": false, "is_method": false}, {"name": "_filter_or_exclude", "qualified_name": "_filter_or_exclude", "args": ["self", "negate"], "decorators": [], "docstring": "", "start_line": 890, "end_line": 900, "is_async": false, "is_method": false}, {"name": "complex_filter", "qualified_name": "complex_filter", "args": ["self", "filter_obj"], "decorators": [], "docstring": "Return a new QuerySet instance with filter_obj added to the filters.\n\nfilter_obj can be a Q object or a dictionary of keyword lookup\narguments.\n\nThis exists to support framework features such as 'limit_choices_to',\nand usually it will be more natural to use other methods.", "start_line": 902, "end_line": 917, "is_async": false, "is_method": false}, {"name": "_combinator_query", "qualified_name": 