ates.\n * Run this script.\n * Test extraction - verify the new msgid in sampleproject's django.po.\n * Add a translation to sampleproject's django.po.\n * Run this script.\n * Test interpolation - verify templatetag rendering, test each in a template\n   that is rendered using an activated language from sampleproject's locale.\n * Tests should fail, issue captured.\n * Fix issue.\n * Run this script.\n * Tests all pass.", "parse_error": ""}, {"file_path": "tests/i18n/sampleproject/manage.py", "file_hash": "80b8ea9e5f4dd44baf6f68b4cb51c0bff9c5b00da37bf3f9aa297d17bea5f71d", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "django.core.management", "names": ["execute_from_command_line"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "tests/i18n/patterns/tests.py", "file_hash": "f3f438f643e88bb78c7ec9639c9864e5a6a18ce8d872f3cbd8a624c78f5bd93a", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.core.exceptions", "names": ["ImproperlyConfigured"], "is_from": true, "alias": ""}, {"module": "django.http", "names": ["HttpResponsePermanentRedirect"], "is_from": true, "alias": ""}, {"module": "django.middleware.locale", "names": ["LocaleMiddleware"], "is_from": true, "alias": ""}, {"module": "django.template", "names": ["Context", "Template"], "is_from": true, "alias": ""}, {"module": "django.test", "names": ["SimpleTestCase", "override_settings"], "is_from": true, "alias": ""}, {"module": "django.test.client", "names": ["RequestFactory"], "is_from": true, "alias": ""}, {"module": "django.test.utils", "names": ["override_script_prefix"], "is_from": true, "alias": ""}, {"module": "django.urls", "names": ["clear_url_caches", "reverse", "translate_url"], "is_from": true, "a