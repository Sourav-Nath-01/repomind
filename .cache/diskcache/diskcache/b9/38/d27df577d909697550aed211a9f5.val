ied_name": "covers", "args": ["self", "other"], "decorators": [], "docstring": "Return True if the DE-9IM Intersection Matrix for the two geometries is\nT*****FF*, *T****FF*, ***T**FF*, or ****T*FF*. If either geometry is\nempty, return False.", "start_line": 262, "end_line": 268, "is_async": false, "is_method": false}, {"name": "crosses", "qualified_name": "crosses", "args": ["self", "other"], "decorators": [], "docstring": "Return true if the DE-9IM intersection matrix for the two Geometries\nis T*T****** (for a point and a curve,a point and an area or a line and\nan area) 0******** (for two curves).", "start_line": 270, "end_line": 276, "is_async": false, "is_method": false}, {"name": "disjoint", "qualified_name": "disjoint", "args": ["self", "other"], "decorators": [], "docstring": "Return true if the DE-9IM intersection matrix for the two Geometries\nis FF*FF****.", "start_line": 278, "end_line": 283, "is_async": false, "is_method": false}, {"name": "equals", "qualified_name": "equals", "args": ["self", "other"], "decorators": [], "docstring": "Return true if the DE-9IM intersection matrix for the two Geometries\nis T*F**FFF*.", "start_line": 285, "end_line": 290, "is_async": false, "is_method": false}, {"name": "equals_exact", "qualified_name": "equals_exact", "args": ["self", "other", "tolerance"], "decorators": [], "docstring": "Return true if the two Geometries are exactly equal, up to a\nspecified tolerance.", "start_line": 292, "end_line": 297, "is_async": false, "is_method": false}, {"name": "intersects", "qualified_name": "intersects", "args": ["self", "other"], "decorators": [], "docstring": "Return true if disjoint return false.", "start_line": 299, "end_line": 301, "is_async": false, "is_method": false}, {"name": "overlaps", "qualified_name": "overlaps", "args": ["self", "other"], "decorators": [], "docstring": "Return true if the DE-9IM intersection matrix for the two Geometries\nis T*T***T** (for two points or two surfaces) 1*T***T** (for two curve