ine": 562, "is_async": false, "is_method": false}, {"name": "test_no_unsafe", "qualified_name": "test_no_unsafe", "args": ["self"], "decorators": [], "docstring": "ConditionalGetMiddleware shouldn't return a conditional response on an\nunsafe request. A response has already been generated by the time\nConditionalGetMiddleware is called, so it's too late to return a 412\nPrecondition Failed.", "start_line": 564, "end_line": 576, "is_async": false, "is_method": false}, {"name": "test_no_head", "qualified_name": "test_no_head", "args": ["self"], "decorators": [], "docstring": "ConditionalGetMiddleware shouldn't compute and return an ETag on a\nHEAD request since it can't do so accurately without access to the\nresponse body of the corresponding GET.", "start_line": 578, "end_line": 587, "is_async": false, "is_method": false}, {"name": "test_same_origin", "qualified_name": "test_same_origin", "args": ["self"], "decorators": [], "docstring": "The X_FRAME_OPTIONS setting can be set to SAMEORIGIN to have the\nmiddleware use that value for the HTTP header.", "start_line": 595, "end_line": 606, "is_async": false, "is_method": false}, {"name": "test_deny", "qualified_name": "test_deny", "args": ["self"], "decorators": [], "docstring": "The X_FRAME_OPTIONS setting can be set to DENY to have the middleware\nuse that value for the HTTP header.", "start_line": 608, "end_line": 619, "is_async": false, "is_method": false}, {"name": "test_defaults_sameorigin", "qualified_name": "test_defaults_sameorigin", "args": ["self"], "decorators": [], "docstring": "If the X_FRAME_OPTIONS setting is not set then it defaults to\nSAMEORIGIN.", "start_line": 621, "end_line": 629, "is_async": false, "is_method": false}, {"name": "test_dont_set_if_set", "qualified_name": "test_dont_set_if_set", "args": ["self"], "decorators": [], "docstring": "If the X-Frame-Options header is already set then the middleware does\nnot attempt to override it.", "start_line": 631, "end_line": 646, "is_async": false, "is_method": false}, {"name": "test_response_exempt", "qualified_name": "test_response_exempt", "args": ["self"], "decorators": [], "docstring": "If the response has an xframe_options_exempt attribute set to False\nthen it still sets the header, but if it's set to True then it doesn't.", "start_line": 648, "end_line": 662, "is_async": false, "is_method": false}, {"name": "test_is_extendable", "qualified_name": "test_is_extendable", "args": ["self"], "decorators": [], "docstring": "The XFrameOptionsMiddleware method that determines the X-Frame-Options\nheader value can be overridden based on something in the request or\nresponse.", "start_line": 664, "end_line": 692, "is_async": false, "is_method": false}, {"name": "setUp", "qualified_name": "setUp", "args": ["self"], "decorators": [], "docstring": "", "start_line": 706, "end_line": 717, "is_async": false, "is_method": false}, {"name": "decompress", "qualified_name": "decompress", "args": ["gzipped_string"], "decorators": ["staticmethod"], "docstring": "", "start_line": 720, "end_line": 722, "is_async": false, "is_method": false}, {"name": "get_mtime", "qualified_name": "get_mtime", "args": ["gzipped_string"], "decorators": ["staticmethod"], "docstring": "", "start_line": 725, "end_line": 728, "is_async": false, "is_method": false}, {"name": "test_compress_response", "qualified_name": "test_compress_response", "args": ["self"], "decorators": [], "docstring": "Compression is performed on responses with compressible content.", "start_line": 730, "end_line": 737, "is_async": false, "is_method": false}, {"name": "test_compress_streaming_response", "qualified_name": "test_compress_streaming_response", "args": ["self"], "decorators": [], "docstring": "Compression is performed on responses with streaming content.", "start_line": 739, "end_line": 746, "is_async": false, "is_method": false}, {"name": "test_compress_streaming_response_unicode", "qualified_name": "test_compress_streaming_response_unicode", "args": ["self"], "decorators": [], "docstring": "Compression is performed on responses with streaming Unicode content.", "start_line": 748, "end_line": 758, "is_async": false, "is_method": false}, {"name": "test_compress_file_response", "qualified_name": "test_compress_file_response", "args": ["self"], "decorators": [], "docstring": "Compression is performed on FileResponse.", "start_line": 760, "end_line": 771, "is_async": false, "is_method": false}, {"name": "test_compress_non_200_response", "qualified_name": "test_compress_non_200_response", "args": ["self"], "decorators": [], "docstring": "Compression is performed on responses with a status other than 200\n(#10762).", "start_line": 773, "end_line": 781, "is_async": false, "is_method": false}, {"name": "test_no_compress_short_response", "qualified_name": "test_no_compress_short_response", "args": ["self"], "decorators": [], "docstring": "Compression isn't performed on responses with short content.", "start_line": 783, "end_line": 790, "is_async": false, "is_method": false}, {"name": "test_no_compress_compressed_response", "qualified_name": "test_no_compress_compressed_response", "args": ["self"], "decorators": [], "docstring": "Compression isn't performed on responses that are already compressed.", "start_line": 792, "end_line": 799, "is_async": false, "is_method": false}, {"name": "test_no_compress_incompressible_response", "qualified_name": "test_no_compress_incompressible_response", "args": ["self"], "decorators": [], "docstring": "Compression isn't performed on responses with incompressible content.", "start_line": 801, "end_line": 808, "is_async": false, "is_method": false}, {"name": "test_compress_deterministic", "qualified_name": "test_compress_deterministic", "args": ["self"], "decorators": [], "docstring": "Compression results are the same for the same content and don't\ninclude a modification time (since that would make the results\nof compression non-deterministic and prevent\nConditionalGetMiddleware from recognizing condi