rything. Their subclasses\n      have references back to them, created automatically.\n\nBoth styles are demonstrated here.", "parse_error": ""}, {"file_path": "tests/app_loading/tests.py", "file_hash": "6726dc1fb74e31cf414c8a95c66c21121a083f862a531c7eb31892b72382e59f", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "django.apps", "names": ["apps"], "is_from": true, "alias": ""}, {"module": "django.test", "names": ["SimpleTestCase"], "is_from": true, "alias": ""}, {"module": "django.test.utils", "names": ["extend_sys_path"], "is_from": true, "alias": ""}, {"module": "not_installed", "names": ["models"], "is_from": true, "alias": ""}], "functions": [{"name": "setUp", "qualified_name": "setUp", "args": ["self"], "decorators": [], "docstring": "", "start_line": 10, "end_line": 11, "is_async": false, "is_method": false}, {"name": "tearDown", "qualified_name": "tearDown", "args": ["self"], "decorators": [], "docstring": "", "start_line": 13, "end_line": 14, "is_async": false, "is_method": false}, {"name": "test_egg1", "qualified_name": "test_egg1", "args": ["self"], "decorators": [], "docstring": "Models module can be loaded from an app in an egg", "start_line": 16, "end_line": 23, "is_async": false, "is_method": false}, {"name": "test_egg2", "qualified_name": "test_egg2", "args": ["self"], "decorators": [], "docstring": "Loading an app from an egg that has no models returns no models (and no error)", "start_line": 25, "end_line": 32, "is_async": false, "is_method": false}, {"name": "test_egg3", "qualified_name": "test_egg3", "args": ["self"], "decorators": [], "docstring": "Models module can be loaded from an app located under an egg's top-level package", "start_line": 34, "end_line": 41, "is_async": false, "is_method": false}, {"name": "test_egg4", "qualified_name": "test_egg4", "args": ["self"], "decorators": [], "docstring": "Loading an app with no models from under the top-level egg package generates no error", "start_line": 43,