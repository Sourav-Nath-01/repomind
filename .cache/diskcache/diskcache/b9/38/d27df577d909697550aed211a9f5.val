, "autoescape"], "decorators": ["register.filter(is_safe=True, needs_autoescape=True)", "stringfilter"], "docstring": "Convert URLs into clickable links, truncating URLs to the given character\nlimit, and adding 'rel=nofollow' attribute to discourage spamming.\n\nArgument: Length to truncate URLs to.", "start_line": 333, "end_line": 340, "is_async": false, "is_method": false}, {"name": "wordcount", "qualified_name": "wordcount", "args": ["value"], "decorators": ["register.filter(is_safe=False)", "stringfilter"], "docstring": "Return the number of words.", "start_line": 345, "end_line": 347, "is_async": false, "is_method": false}, {"name": "wordwrap", "qualified_name": "wordwrap", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Wrap words at `arg` line length.", "start_line": 352, "end_line": 354, "is_async": false, "is_method": false}, {"name": "ljust", "qualified_name": "ljust", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Left-align the value in a field of a given width.", "start_line": 359, "end_line": 361, "is_async": false, "is_method": false}, {"name": "rjust", "qualified_name": "rjust", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Right-align the value in a field of a given width.", "start_line": 366, "end_line": 368, "is_async": false, "is_method": false}, {"name": "center", "qualified_name": "center", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Center the value in a field of a given width.", "start_line": 373, "end_line": 375, "is_async": false, "is_method": false}, {"name": "cut", "qualified_name": "cut", "args": ["value", "arg"], "decorators": ["register.filter", "stringfilter"], "docstring": "Remove all values of arg from the given string.", "start_line": 380, "end_line": 386, "is_async": false, "is_method": false}, {"name": "escape_filter", "qualified_name": "escape_filter", "args": ["value"], "decorators": ["register.filter('escape', is_safe=True)", "stringfilter"], "docstring": "Mark the value as a string that should be auto-escaped.", "start_line": 395, "end_line": 397, "is_async": false, "is_method": false}, {"name": "force_escape", "qualified_name": "force_escape", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Escape a string's HTML. Return a new string containing the escaped\ncharacters (as opposed to \"escape\", which marks the content for later\npossible escaping).", "start_line": 402, "end_line": 408, "is_async": false, "is_method": false}, {"name": "linebreaks_filter", "qualified_name": "linebreaks_filter", "args": ["value", "autoescape"], "decorators": ["register.filter('linebreaks', is_safe=True, needs_autoescape=True)", "stringfilter"], "docstring": "Replace line breaks in plain text with appropriate HTML; a single\nnewline becomes an HTML line break (``<br>``) and a new line\nfollowed by a blank line becomes a paragraph break (``</p>``).", "start_line": 413, "end_line": 420, "is_async": false, "is_method": false}, {"name": "linebreaksbr", "qualified_name": "linebreaksbr", "args": ["value", "autoescape"], "decorators": ["register.filter(is_safe=True, needs_autoescape=True)", "stringfilter"], "docstring": "Convert all newlines in a piece of plain text to HTML line breaks\n(``<br>``).", "start_line": 425, "end_line": 434, "is_async": false, "is_method": false}, {"name": "safe", "qualified_name": "safe", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Mark the value as a string that should not be auto-escaped.", "start_line": 439, "end_line": 441, "is_async": false, "is_method": false}, {"name": "safeseq", "qualified_name": "safeseq", "args": ["value"], "decorators": ["register.filter(is_safe=True)"], "docstring": "A \"safe\" filter for sequences. Mark each element in the sequence,\nindividually, as safe, after converting them to strings. Return a list\nwith the results.", "start_line": 445, "end_line": 451, "is_async": false, "is_method": false}, {"name": "striptags", "qualified_name": "striptags", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Strip all [X]HTML tags.", "start_line": 456, "end_line": 458, "is_async": false, "is_method": false}, {"name": "_property_resolver", "qualified_name": "_property_resolver", "args": ["arg"], "decorators": [], "docstring": "When arg is convertible to float, behave like operator.itemgetter(arg)\nOtherwise, behave like Variable(arg).resolve\n\n>>> _property_resolver(1)('abc')\n'b'\n>>> _property_resolver('1')('abc')\nTraceback (most recent call last):\n...\nTypeError: string indices must be integers\n>>> class Foo:\n...     a = 42", "start_line": 465, "end_line": 488, "is_async": false, "is_method": false}, {"name": "dictsort", "qualified_name": "dictsort", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=False)"], "docstring": "Given a list of dicts, return that list sorted by the property given in\nthe argument.", "start_line": 492, "end_line": 500, "is_async": false, "is_method": false}, {"name": "dictsortreversed", "qualified_name": "dictsortreversed", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=False)"], "docstring": "Given a list of dicts, return that list sorted in reverse order by the\nproperty given in the argument.", "start_line": 504, "end_line": 512, "is_async": false, "is_method": false}, {"name": "first", "qualified_name": "first", "args": ["value"], "decorators": ["register.filter(is_safe=False)"], "docstring": "Return the first item in a list.", "start_line": 516, "end_line": 521, "is_async": false, "is_method": false}, {"name": "join", "qualified_name": "join", "args": ["value", "arg", "autoescape"], "decorators": ["register.filter(is_safe=True, needs_autoescape=True)"], "docstring": "Join