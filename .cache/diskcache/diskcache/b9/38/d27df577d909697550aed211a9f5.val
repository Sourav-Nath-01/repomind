corators": [], "docstring": "", "start_line": 22, "end_line": 30, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "A set of request processors that return dictionaries to be merged into a\ntemplate context. Each function takes the request object as its only parameter\nand returns a dictionary to add to the context.\n\nThese are referenced from the 'context_processors' option of the configuration\nof a DjangoTemplates backend and used by RequestContext.", "parse_error": ""}, {"file_path": "django/template/defaulttags.py", "file_hash": "e8ed95bac52c841fafb2a477cc5887c99d664afd8c48373d3a3271de28f1fd76", "imports": [{"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "collections", "names": ["namedtuple"], "is_from": true, "alias": ""}, {"module": "datetime", "names": ["datetime"], "is_from": true, "alias": ""}, {"module": "itertools", "names": ["cycle", "groupby"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.utils", "names": ["timezone"], "is_from": true, "alias": ""}, {"module": "django.utils.html", "names": ["conditional_escape", "format_html"], "is_from": true, "alias": ""}, {"module": "django.utils.lorem_ipsum", "names": ["paragraphs", "words"], "is_from": true, "alias": ""}, {"module": "django.utils.safestring", "names": ["mark_safe"], "is_from": true, "alias": ""}, {"module": "base", "names": ["BLOCK_TAG_END", "BLOCK_TAG_START", "COMMENT_TAG_END", "COMMENT_TAG_START", "FILTER_SEPARATOR", "SINGLE_BRACE_END", "SINGLE_BRACE_START", "VARIABLE_ATTRIBUTE_SEPARATOR", "VARIABLE_TAG_END", "VARIABLE_TAG_START", "Context", "Node", "NodeList", "TemplateSyntaxError", "VariableDoesNotExist", "kwarg_re", "render_value_in_context", "token_kwargs"], "is_from": true, "alias": ""}, {"module": "defaultfilters", "names": ["date"], "is_from": true, "alias": ""}, {"module": "library", "names": ["Library"], "is_from": true, "alias": ""}, {"module": "smartif", "names": ["IfParser", "Literal"], "is_from": true, "alias": ""}, {"module": "pprint", "names": ["pformat"], "is_from": true, "alias": ""}, {"module": "django.utils.html", "names": ["strip_spaces_between_tags"], "is_from": true, "alias": ""}, {"module": "django.urls", "names": ["reverse", "NoReverseMatch"], "is_from": true, "alias": ""}], "functions": [{"name": "autoescape", "qualified_name": "autoescape", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Force autoescape behavior for this block.", "start_line": 517, "end_line": 530, "is_async": false, "is_method": false}, {"name": "comment", "qualified_name": "comment", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Ignore everything between ``{% comment %}`` and ``{% endcomment %}``.", "start_line": 534, "end_line": 539, "is_async": false, "is_method": false}, {"name": "cycle", "qualified_name": "cycle", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Cycle among the given strings each time this tag is encountered.\n\nWithin a loop, cycles among the given strings each time through\nthe loop::\n\n    {% for o in some_list %}\n        <tr class=\"{% cycle 'row1' 'row2' %}\">\n            ...\n        </tr>\n    {% endfor %}\n\nOutside of a loop, give the values", "start_line": 543, "end_line": 627, "is_async": false, "is_method": false}, {"name": "csrf_token", "qualified_name": "csrf_token", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "", "start_line": 631, "end_line": 632, "is_async": false, "is_method": false}, {"name": "debug", "qualified_name": "debug", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Output a whole load of debugging information, including the current\ncontext and imported modules.\n\nSample usage::\n\n    <pre>\n        {% debug %}\n    </pre>", "start_line": 636, "end_line": 647, "is_async": false, "is_method": false}, {"name": "do_filter", "qualified_name": "do_filter", "args": ["parser", "token"], "decorators": ["register.tag('filter')"], "docstring": "Filter the contents of the block through variable filters.\n\nFilters can also be piped through each other, and they can have\narguments -- just like in variable syntax.\n\nSample usage::\n\n    {% filter force_escape|lower %}\n        This text will be HTML-escaped, and will appear in lowercase.\n    {% end", "start_line": 651, "end_line": 677, "is_async": false, "is_method": false}, {"name": "firstof", "qualified_name": "firstof", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Output the first variable passed that is not False.\n\nOutput nothing if all the passed variables are False.\n\nSample usage::\n\n    {% firstof var1 var2 var3 as myvar %}\n\nThis is equivalent to::\n\n    {% if var1 %}\n        {{ var1 }}\n    {% elif var2 %}\n        {{ var2 }}\n    {% elif var3 %}\n        {{ v", "start_line": 681, "end_line": 726, "is_async": false, "is_method": false}, {"name": "do_for", "qualified_name": "do_for", "args": ["parser", "token"], "decorators": ["register.tag('for')"], "docstring": "Loop over each item in an array.\n\nFor example, to display a list of athletes given ``athlete_list``::\n\n    <ul>\n    {% for athlete in athlete_list %}\n        <li>{{ athlete.name }}</li>\n    {% endfor %}\n    </ul>\n\nYou can loop over a list in reverse by using\n``{% for obj in list reversed %}``.\n\nYou ", "start_line": 730, "end_line": 818, "is_async": false, "is_method": false}, {"name": "do_ifequal", "qualified_name": "do_ifequal", "args": ["parser", "token", "negate"], "decorators": [], "docstring": "", "start_line": 821, "end_line": 835, "is_async": false, "is_method": false}, {"name": "ifequal", "qualified_name": "ifequal", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Output the contents of the block if the two arguments equal each other.\n\nExamples::\n\n    {% ifequal user.id comment.user_id %}\n        ...\n    {% endifequal %}\n\n    {% ifnotequal user.id comment.user_id %}\n        ...\n    {% else %}\n        ...\n    {% endifnotequal %}", "start_line": 839, "end_line": 855, "is_async": false, "is_method": false}, {"name": "ifnotequal", "qualified_name": "ifnotequal", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Output the contents of the block if the two arguments are not equal.\nSee ifequal.", "start_line": 859, "end_line": 864, "is_async": false, "is_method": false}, {"name": "do_if", "qualified_name": "do_if", "args": ["parser", "token"], "decorators": ["register.tag('if')"], "docstring": "Evaluate a variable, and if that variable is \"true\" (i.e., exists, is not\nempty, and is not a false boolean value), output the contents of the block:\n\n::\n\n    {% if athlete_list %}\n        Number of athletes: {{ athlete_list|count }}\n    {% elif athlete_in_locker_room_list %}\n        Athletes should", "start_line": 891, "end_line": 974, "is_async": false, "is_method": false}, {"name": "ifchanged", "qualified_name": "ifchanged", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Check if a value has changed from the last iteration of a loop.\n\nThe ``{% ifchanged %}`` block tag is used within a loop. It has two\npossible uses.\n\n1. Check its own rendered contents against its previous state and only\n   displays the content if it has changed. For example, this displays a\n   list ", "start_line": 978, "end_line": 1016, "is_async": false, "is_method": false}, {"name": "find_library", "qualified_name": "find_library", "args": ["parser", "name"], "decorators": [], "docstring": "", "start_line": 1019, "end_line": 1027, "is_async": false, "is_method": false}, {"name": "load_from_library", "qualified_name": "load_from_library", "args": ["library", "label", "names"], "decorators": [], "docstring": "Return a subset of tags and filters from a library.", "start_line": 1030, "end_line": 1049, "is_async": false, "is_method": false}, {"name": "load", "qualified_name": "load", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Load a custom template tag library into the parser.\n\nFor example, to load the template tags in\n``django/templatetags/news/photos.py``::\n\n    {% load news.photos %}\n\nCan also be used to load an individual tag/filter from\na library::\n\n    {% load byline from news %}", "start_line": 1053, "end_line": 1080, "is_async": false, "is_method": false}, {"name": "lorem", "qualified_name": "lorem", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Create random Latin text useful for providing test data in templates.\n\nUsage format::\n\n    {% lorem [count] [method] [random] %}\n\n``count`` is a number (or variable) containing the number of paragraphs or\nwords to generate (default is 1).\n\n``method`` is either ``w`` for words, ``p`` for HTML paragra", "start_line": 1084, "end_line": 1127, "is_async": false, "is_method": false}, {"name": "now", "qualified_name": "now", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Display the date, formatted according to the given string.\n\nUse the same format as PHP's ``date()`` function; see https://php.net/date\nfor all the possible values.\n\nSample usage::\n\n    It is {% now \"jS F Y H:i\" %}", "start_line": 1131, "end_line": 1150, "is_async": false, "is_method": false}, {"name": "regroup", "qualified_name": "regroup", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Regroup a list of alike objects by a common attribute.\n\nThis complex tag is best illustrated by use of an example: say that\n``musicians`` is a list of ``Musician`` objects that have ``name`` and\n``instrument`` attributes, and you'd like to display a list that\nlooks like:\n\n    * Guitar:\n        * Dja", "start_line": 1154, "end_line": 1219, "is_async": false, "is_method": false}, {"name": "resetcycle", "qualified_name": "resetcycle", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Reset a cycle tag.\n\nIf an argument is given, reset the last rendered cycle tag whose name\nmatches the argument, else reset the last rendered cycle tag (named or\nunnamed).", "start_line": 1223, "end_line": 1245, "is_async": false, "is_method": false}, {"name": "spaceless", "qualified_name": "spaceless", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Remove whitespace between HTML tags, including tab and newline characters.\n\nExample usage::\n\n    {% spaceless %}\n        <p>\n            <a href=\"foo/\">Foo</a>\n        </p>\n    {% endspaceless %}\n\nThis example returns this HTML::\n\n    <p><a href=\"foo/\">Foo</a></p>\n\nOnly space between *tags* is norma", "start_line": 1249, "end_line": 1276, "is_async": false, "is_method": false}, {"name": "templatetag", "qualified_name": "templatetag", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Output one of the bits used to compose template tags.\n\nSince the template system has no concept of \"escaping\", to display one of\nthe bits used in template tags, you must use the ``{% templatetag %}`` tag.\n\nThe argument tells which template bit to output:\n\n    ==================  =======\n    Argument", "start_line": 1280, "end_line": 1311, "is_async": false, "is_method": false}, {"name": "url", "qualified_name": "url", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Return an absolute URL matching the given view with its parameters.\n\nThis is a way to define links that aren't tied to a particular URL\nconfiguration::\n\n    {% url \"url_name\" arg1 arg2 %}\n\n    or\n\n    {% url \"url_name\" name1=value1 name2=value2 %}\n\nThe first argument is a URL pattern name. Other arg", "start_line": 1315, "end_line": 1378, "is_async": false, "is_method": false}, {"name": "verbatim", "qualified_name": "verbatim", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Stop the template engine from rendering the contents of this block tag.\n\nUsage::\n\n    {% verbatim %}\n        {% don't process this %}\n    {% endverbatim %}\n\nYou can also designate a specific closing tag block (allowing the\nunrendered use of ``{% endverbatim %}``)::\n\n    {% verbatim myblock %}\n      ", "start_line": 1382, "end_line": 1401, "is_async": false, "is_method": false}, {"name": "widthratio", "qualified_name": "widthratio", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "For creating bar charts and such. Calculate the ratio of a given value to a\nmaximum value, and then apply that ratio to a constant.\n\nFor example::\n\n    <img src=\"bar.png\" alt=\"Bar\"\n         height=\"10\" width=\"{% widthratio this_value max_value max_width %}\">\n\nIf ``this_value`` is 175, ``max_value`` ", "start_line": 1405, "end_line": 1439, "is_async": false, "is_method": false}, {"name": "do_with", "qualified_name": "do_with", "args": ["parser", "token"], "decorators": ["register.tag('with')"], "docstring": "Add one or more values to the context (inside of this block) for caching\nand easy access.\n\nFor example::\n\n    {% with total=person.some_sql_method %}\n        {{ total }} object{{ total|pluralize }}\n    {% endwith %}\n\nMultiple values can be added to the context::\n\n    {% with foo=1 bar=2 %}\n        .", "start_line": 1443, "end_line": 1474, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "setting", "nodelist"], "decorators": [], "docstring": "", "start_line": 31, "end_line": 32, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 34, "end_line": 42, "is_async": false, "is_method": false}, {"name": "render", "qualifi