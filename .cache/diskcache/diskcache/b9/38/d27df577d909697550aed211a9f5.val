t added line breaks consume the space on\nwhich they break the line.\n\nDon't wrap long words, thus the output text may have lines longer than\n``width``.", "start_line": 26, "end_line": 53, "is_async": false, "is_method": false}, {"name": "get_valid_filename", "qualified_name": "get_valid_filename", "args": ["s"], "decorators": ["keep_lazy_text"], "docstring": "Return the given string converted to a string that can be used for a clean\nfilename. Remove leading and trailing spaces; convert other spaces to\nunderscores; and remove anything that is not an alphanumeric, dash,\nunderscore, or dot.\n>>> get_valid_filename(\"john's portrait in 2004.jpg\")\n'johns_portra", "start_line": 219, "end_line": 229, "is_async": false, "is_method": false}, {"name": "get_text_list", "qualified_name": "get_text_list", "args": ["list_", "last_word"], "decorators": ["keep_lazy_text"], "docstring": ">>> get_text_list(['a', 'b', 'c', 'd'])\n'a, b, c or d'\n>>> get_text_list(['a', 'b', 'c'], 'and')\n'a, b and c'\n>>> get_text_list(['a', 'b'], 'and')\n'a and b'\n>>> get_text_list(['a'])\n'a'\n>>> get_text_list([])\n''", "start_line": 233, "end_line": 253, "is_async": false, "is_method": false}, {"name": "normalize_newlines", "qualified_name": "normalize_newlines", "args": ["text"], "decorators": ["keep_lazy_text"], "docstring": "Normalize CRLF and CR newlines to just LF.", "start_line": 257, "end_line": 259, "is_async": false, "is_method": false}, {"name": "phone2numeric", "qualified_name": "phone2numeric", "args": ["phone"], "decorators": ["keep_lazy_text"], "docstring": "Convert a phone number with letters into its numeric equivalent.", "start_line": 263, "end_line": 271, "is_async": false, "is_method": false}, {"name": "compress_string", "qualified_name": "compress_string", "args": ["s"], "decorators": [], "docstring": "", "start_line": 276, "end_line": 280, "is_async": false, "is_method": false}, {"name": "compress_sequence", "qualified_name": "compress_sequence", "args": ["sequence"],