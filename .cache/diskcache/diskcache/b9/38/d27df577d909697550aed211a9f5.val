eturn a tuple of the django version. If version argument is non-empty,\ncheck for correctness of the tuple provided.", "start_line": 49, "end_line": 60, "is_async": false, "is_method": false}, {"name": "get_docs_version", "qualified_name": "get_docs_version", "args": ["version"], "decorators": [], "docstring": "", "start_line": 63, "end_line": 68, "is_async": false, "is_method": false}, {"name": "get_git_changeset", "qualified_name": "get_git_changeset", "args": [], "decorators": ["functools.lru_cache()"], "docstring": "Return a numeric identifier of the latest git changeset.\n\nThe result is the UTC timestamp of the changeset in YYYYMMDDHHMMSS format.\nThis value isn't guaranteed to be unique, but collisions are very unlikely,\nso it's sufficient for generating the development version numbers.", "start_line": 72, "end_line": 90, "is_async": false, "is_method": false}, {"name": "get_version_tuple", "qualified_name": "get_version_tuple", "args": ["version"], "decorators": [], "docstring": "Return a tuple of version numbers (e.g. (1, 2, 3)) from the version\nstring (e.g. '1.2.3').", "start_line": 93, "end_line": 104, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/utils/deconstruct.py", "file_hash": "85c3bfeea6acb122397537d0e423edb40f2cddff72685f149ea28a99addb23a3", "imports": [{"module": "importlib", "names": ["import_module"], "is_from": true, "alias": ""}, {"module": "django.utils.version", "names": ["get_docs_version"], "is_from": true, "alias": ""}], "functions": [{"name": "deconstructible", "qualified_name": "deconstructible", "args": [], "decorators": [], "docstring": "Class decorator that allows the decorated class to be serialized\nby the migrations subsystem.\n\nThe `path` kwarg specifies the import path.", "start_line": 6, "end_line": 55, "is_async": false, "is_method": false}, {"name": "decorator", "qualified_name": "decorator", "args": ["klass"], "decorators": [], "docs