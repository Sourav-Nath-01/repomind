"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "django.core.exceptions", "names": ["ImproperlyConfigured"], "is_from": true, "alias": ""}, {"module": "django.utils.module_loading", "names": ["import_string"], "is_from": true, "alias": ""}], "functions": [{"name": "default_key_func", "qualified_name": "default_key_func", "args": ["key", "key_prefix", "version"], "decorators": [], "docstring": "Default function to generate keys.\n\nConstruct the key used by all other methods. By default, prepend\nthe `key_prefix'. KEY_FUNCTION can be used to specify an alternate\nfunction with custom key making behavior.", "start_line": 25, "end_line": 33, "is_async": false, "is_method": false}, {"name": "get_key_func", "qualified_name": "get_key_func", "args": ["key_func"], "decorators": [], "docstring": "Function to decide which key function to use.\n\nDefault to ``default_key_func``.", "start_line": 36, "end_line": 47, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "params"], "decorators": [], "docstring": "", "start_line": 51, "end_line": 75, "is_async": false, "is_method": false}, {"name": "get_backend_timeout", "qualified_name": "get_backend_timeout", "args": ["self", "timeout"], "decorators": [], "docstring": "Return the timeout value usable by this backend based upon the provided\ntimeout.", "start_line": 77, "end_line": 87, "is_async": false, "is_method": false}, {"name": "make_key", "qualified_name": "make_key", "args": ["self", "key", "version"], "decorators": [], "docstring": "Construct the key used by all other methods. By default, use the\nkey_func to generate a key (which, by default, prepends the\n`key_prefix' and 'version'). A different key function can be provided\nat the time of cache construction; alternatively, you can subclass the\ncache backend to provide custom ke", "start_line": 89, "end_line": 101, "is_async": false, "is_method": false}, {"name": "add", "qualified_name": "add", "args": ["self", "key", "value", "timeout", "version"], "decorators": [], "docstring": "Set a value in the cache if the key does not already exist. If\ntimeout is given, use that timeout for the key; otherwise use the\ndefault cache timeout.\n\nReturn True if the value was stored, False otherwise.", "start_line": 103, "end_line": 111, "is_async": false, "is_method": false}, {"name": "get", "qualified_name": "get", "args": ["self", "key", "default", "version"], "decorators": [], "docstring": "Fetch a given key from the cache. If the key does not exist, return\ndefault, which itself defaults to None.", "start_line": 113, "end_line": 118, "is_async": false, "is_method": false}, {"name": "set", "qualified_name": "set", "args": ["self", "key", "value", "timeout", "version"], "decorators": [], "docstring": "Set a value in the cache. If timeout is given, use that timeout for the\nkey; otherwise use the default cache timeout.", "start_line": 120, "end_line": 125, "is_async": false, "is_method": false}, {"name": "touch", "qualified_name": "touch", "args": ["self", "key", "timeout", "version"], "decorators": [], "docstring": "Update the key's expiry time using timeout. Return True if successful\nor False if the key does not exist.", "start_line": 127, "end_line": 132, "is_async": false, "is_method": false}, {"name": "delete", "qualified_name": "delete", "args": ["self", "key", "version"], "decorators": [], "docstring": "Delete a key from the cache, failing silently.", "start_line": 134, "end_line": 138, "is_async": false, "is_method": false}, {"name": "get_many", "qualified_name": "get_many", "args": ["self", "keys", "version"], "decorators": [], "docstring": "Fetch a bunch of keys from the cache. For certain backends (memcached,\npgsql) this can be *much* faster when fetching multiple values.\n\nReturn a dict mapping each key in keys to its value. If the given\nkey is missing, it will be missing from the response dict.", "start_line": 140, "end_line": 153, "is_async": false, "is_method": false}, {"name": "get_or_set", "qualified_name": "get_or_set", "args": ["self", "key", "default", "timeout", "version"], "decorators": [], "docstring": "Fetch a given key from the cache. If the key does not exist,\nadd the key and set it to the default value. The default value can\nalso be any callable. If timeout is given, use that timeout for the\nkey; otherwise use the default cache timeout.\n\nReturn the value of the key stored or retrieved.", "start_line": 155, "end_line": 174, "is_async": false, "is_method": false}, {"name": "has_key", "qualified_name": "has_key", "args": ["self", "key", "version"], "decorators": [], "docstring": "Return True if the key is in the cache and has not expired.", "start_line": 176, "end_line": 180, "is_async": false, "is_method": false}, {"name": "incr", "qualified_name": "incr", "args": ["self", "key", "delta", "version"], "decorators": [], "docstring": "Add delta to value in the cache. If the key does not exist, raise a\nValueError exception.", "start_line": 182, "end_line": 192, "is_async": false, "is_method": false}, {"name": "decr", "qualified_name": "decr", "args": ["self", "key", "delta", "version"], "decorators": [], "docstring": "Subtract delta from value in the cache. If the key does not exist, raise\na ValueError exception.", "start_line": 194, "end_line": 199, "is_async": false, "is_method": false}, {"name": "__contains__", "qualified_name": "__contains__", "args": ["self", "key"], "decorators": [], "docstring": "Return True if the key is in the cache and has not expired.", "start_line": 201, "end_line": 208, "is_async": false, "is_method": false}, {"name": "set_many", "qualified_name": "set_many", "args": ["self", "data", "timeout", "version"], "decorators": [], "docstring": "Set a bunch of values in the cache at once from a dict of key/value\npairs.  For certain backends (memcached), this is much more efficient\nthan calling set() multiple times.\n\nIf timeout is given, use that timeout for the key; otherwise use the\ndefault cache timeout.\n\nOn backends that support it, retu", "start_line": 210, "end_line": 224, "is_async": false, "is_method": false}, {"name": "delete_many", "qualified_name": "delete_many", "args": ["self", "keys", "version"], "decorators": [], "docstring": "Delete a bunch of values in the cache at once. For certain backends\n(memcached), this is much more efficient than calling delete() multiple\ntimes.", "start_line": 226, "end_line": 233, "is_async": false, "is_method": false}, {"name": "clear", "qualified_name": "clear", "args": ["self"], "decorators": [], "docstring": "Remove *all* values from the cache at once.", "start_line": 235, "end_line": 237, "is_async": false, "is_method": false}, {"name": "validate_key", "qualified_name": "validate_key", "args": ["self", "key"], "decorators": [], "docstring": "Warn about keys that would not be portable to the memcached\nbackend. This encourages (but does not force) writing backend-portable\ncache code.", "start_line": 239, "end_line": 256, "is_async": false, "is_method": false}, {"name": "incr_version", "qualified_name": "incr_version", "args": ["self", "key", "delta", "version"], "decorators": [], "docstring": "Add delta to the cache version for the supplied key. Return the new\nversion.", "start_line": 258, "end_line": 272, "is_async": false, "is_method": false}, {"name": "decr_version", "qualified_name": "decr_version", "args": ["self", "key", "delta", "version"], "decorators": [], "docstring": "Subtract delta from the cache version for the supplied key. Return the\nnew version.", "start_line": 274, "end_line": 279, "is_async": false, "is_method": false}, {"name": "close", "qualified_name": "close", "args": ["self"], "decorators": [], "docstring": "Close the cache connection", "start_line": 281, "end_line": 283, "is_async": false, "is_method": false}], "classes": [{"name": "InvalidCacheBackendError", "bases": ["ImproperlyConfigured"], "methods": [], "docstring": "", "start_line": 9, "en