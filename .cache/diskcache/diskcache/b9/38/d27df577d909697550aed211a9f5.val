Return the value of the minimum X coordinate.", "start_line": 137, "end_line": 139, "is_async": false, "is_method": false}, {"name": "min_y", "qualified_name": "min_y", "args": ["self"], "decorators": ["property"], "docstring": "Return the value of the minimum Y coordinate.", "start_line": 142, "end_line": 144, "is_async": false, "is_method": false}, {"name": "max_x", "qualified_name": "max_x", "args": ["self"], "decorators": ["property"], "docstring": "Return the value of the maximum X coordinate.", "start_line": 147, "end_line": 149, "is_async": false, "is_method": false}, {"name": "max_y", "qualified_name": "max_y", "args": ["self"], "decorators": ["property"], "docstring": "Return the value of the maximum Y coordinate.", "start_line": 152, "end_line": 154, "is_async": false, "is_method": false}, {"name": "ur", "qualified_name": "ur", "args": ["self"], "decorators": ["property"], "docstring": "Return the upper-right coordinate.", "start_line": 157, "end_line": 159, "is_async": false, "is_method": false}, {"name": "ll", "qualified_name": "ll", "args": ["self"], "decorators": ["property"], "docstring": "Return the lower-left coordinate.", "start_line": 162, "end_line": 164, "is_async": false, "is_method": false}, {"name": "tuple", "qualified_name": "tuple", "args": ["self"], "decorators": ["property"], "docstring": "Return a tuple representing the envelope.", "start_line": 167, "end_line": 169, "is_async": false, "is_method": false}, {"name": "wkt", "qualified_name": "wkt", "args": ["self"], "decorators": ["property"], "docstring": "Return WKT representing a Polygon for this envelope.", "start_line": 172, "end_line": 178, "is_async": false, "is_method": false}], "classes": [{"name": "OGREnvelope", "bases": ["Structure"], "methods": [], "docstring": "Represent the OGREnvelope C Structure.", "start_line": 21, "end_line": 27}, {"name": "Envelope", "bases": [], "methods": ["__init__", "__eq__", "__str__", "_from_sequence", "expand_to_include", "min_x", "min_y", "max_x", "max_y", "ur", "ll", "tuple", "wkt"], "docstring": "The Envelope object is a C structure that contains the minimum and\nmaximum X, Y coordinates for a rectangle bounding box.  The naming\nof the variables is compatible with the OGR Envelope structure.", "start_line": 30, "end_line": 178}], "calls": [], "module_docstring": "The GDAL/OGR library uses an Envelope structure to hold the bounding\nbox information for a geometry.  The envelope (bounding box) contains\ntwo pairs of coordinates, one for the lower left coordinate and one\nfor the upper right coordinate:\n\n                          +----------o Upper right; (max_x, max_y)\n                          |          |\n                          |          |\n                          |          |\nLower left (min_x, min_y) o----------+", "parse_error": ""}, {"file_path": "django/contrib/gis/gdal/geomtype.py", "file_hash": "8421dfc50b1e7016a4219503670124102747edd83709d17863f900158916f4e8", "imports": [{"module": "django.contrib.gis.gdal.error", "names": ["GDALException"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "type_input"], "decorators": [], "docstring": "Figure out the correct OGR Type based upon the input.", "start_line": 33, "end_line": 52, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "Return the value of the name property.", "start_line": 54, "end_line": 56, "is_async": false, "is_method": false}, {"name": "__eq__", "qualified_name": "__eq__", "args": ["self", "other"], "decorators": [], "docstring": "Do an equivalence test on the OGR type with the given\nother OGRGeomType, the short-hand string, or the integer.", "start_line": 58, "end_line": 70, "is_async": false, "is_method": false}, {"name": "name", "qualified_name": "name", "args": ["self"], "decorators": ["property"], "docstring": "Return a short-hand string form of the OGR Geometry type.", "start_line": 73, "end_line": 75, "is_async": false, "is_method": false}, {"name": "django", "qualified_name": "django", "args": ["self"], "decorators": ["property"], "docstring": "Return the Django GeometryField for this OGR Type.", "start_line": 78, "end_line": 87, "is_async": false, "is_method": false}, {"name": "to_multi", "qualified_name": "to_multi", "args": ["self"], "decorators": [], "docstring": "Transform Point, LineString, Polygon, and their 25D equivalents\nto their Multi... counterpart.", "start_line": 89, "end_line": 95, "is_async": false, "is_method": false}], "classes": [{"name": "OGRGeomType", "bases": [], "methods": ["__init__", "__str__", "__eq__", "name", "django", "to_multi"], "docstring": "Encapsulate OGR Geometry Types.", "start_line": 4, "end_line": 95}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/contrib/gis/gdal/base.py", "file_hash": "cb29b22f4bd944c05f885533ade86f69e6ae9c8c4c1f9b9c1a33d17ca8feac0a", "imports": [{"module": "django.contrib.gis.gdal.error", "names": ["GDALException"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.ptr", "names": ["CPointerBase"], "is_from": true, "alias": ""}], "functions": [], "classes": [{"name": "GDALBase", "bases": ["CPointerBase"], "methods": [], "docstring": "", "start_line": 5, "end_line": 6}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/contrib/gis/gdal/__init__.py", "file_hash": "66cf5b3869bd452b588619560a7a913428491b82bfa160cf45763296996eaf54", "imports": [{"module": "django.contrib.gis.gdal.datasource", "names": ["DataSource"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.driver", "names": ["Driver"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.envelope", "names": ["Envelope"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.error", "names": ["GDALException", "SRSException", "check_err"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.geometries", "names": ["OGRGeometry"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.geomtype", "names": ["OGRGeomType"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.libgdal", "names": ["GDAL_VERSION", "gdal_full_version", "gdal_version"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.raster.source", "names": ["GDALRaster"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.srs", "names": ["CoordTransform", "SpatialReference"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "This module houses ctypes interfaces for GDAL objects.  The following GDAL\nobjects are supported:\n\nCoordTransform: Used for coordinate transformations from one spatial\n reference system to another.\n\nDriver: Wraps an OGR data source driver.\n\nDataSource: Wrapper for the OGR data source object, supports\n OGR-supported data sources.\n\nEnvelope: A ctypes structure for bounding boxes (GDAL library\n not required).\n\nOGRGeometry: Object for accessing OGR Geometry functionality.\n\nOGRGeomType: A class for representing the different OGR Geometry\n types (GDAL library not required).\n\nSpatialReference: Represents OSR Spatial Reference objects.\n\nThe GDAL library will be imported from the system path using the default\nlibrary name for the current OS. The default library path may be overridden\nby setting `GDAL_LIBRARY_PATH` in your settings with the path to the GDAL C\nlibrary on your system.", "parse_error": ""}, {"file_path": "django/contrib/gis/gdal/feature.py", "file_hash": "2981b24183565eb1099b62347881b529c77b5933995a20be6ac2231790e63bd2", "imports": [{"module": "django.contrib.gis.gdal.base", "names": ["GDALBase"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.error", "names": ["GDALException"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.field", "names": ["Field"], "is_from": true, "alias": ""}, {"module"