_to_spaces", "qualified_name": "camel_case_to_spaces", "args": ["value"], "decorators": [], "docstring": "Split CamelCase and convert to lowercase. Strip surrounding whitespace.", "start_line": 401, "end_line": 405, "is_async": false, "is_method": false}, {"name": "_format_lazy", "qualified_name": "_format_lazy", "args": ["format_string"], "decorators": [], "docstring": "Apply str.format() on 'format_string' where format_string, args,\nand/or kwargs might be lazy.", "start_line": 408, "end_line": 413, "is_async": false, "is_method": false}, {"name": "_generator", "qualified_name": "_generator", "args": [], "decorators": [], "docstring": "", "start_line": 37, "end_line": 52, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "text"], "decorators": [], "docstring": "", "start_line": 60, "end_line": 61, "is_async": false, "is_method": false}, {"name": "add_truncation_text", "qualified_name": "add_truncation_text", "args": ["self", "text", "truncate"], "decorators": [], "docstring": "", "start_line": 63, "end_line": 76, "is_async": false, "is_method": false}, {"name": "chars", "qualified_name": "chars", "args": ["self", "num", "truncate", "html"], "decorators": [], "docstring": "Return the text truncated to be no longer than the specified number\nof characters.\n\n`truncate` specifies what should be used to notify that the string has\nbeen truncated, defaulting to a translatable string of an ellipsis.", "start_line": 78, "end_line": 99, "is_async": false, "is_method": false}, {"name": "_text_chars", "qualified_name": "_text_chars", "args": ["self", "length", "truncate", "text", "truncate_len"], "decorators": [], "docstring": "Truncate a string after a certain number of chars.", "start_line": 101, "end_line": 119, "is_async": false, "is_method": false}, {"name": "words", "qualified_name": "words", "args": ["self", "num", "truncate", "html"], "decorators": [], "docstring": "Truncate a string after a certain number o