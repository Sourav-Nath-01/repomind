ed_name": "save", "args": ["self", "name", "content", "max_length"], "decorators": [], "docstring": "Save new content to the file specified by name. The content should be\na proper File object or any Python file-like object, ready to be read\nfrom the beginning.", "start_line": 38, "end_line": 52, "is_async": false, "is_method": false}, {"name": "get_valid_name", "qualified_name": "get_valid_name", "args": ["self", "name"], "decorators": [], "docstring": "Return a filename, based on the provided filename, that's suitable for\nuse in the target storage system.", "start_line": 56, "end_line": 61, "is_async": false, "is_method": false}, {"name": "get_available_name", "qualified_name": "get_available_name", "args": ["self", "name", "max_length"], "decorators": [], "docstring": "Return a filename that's free on the target storage system and\navailable for new content to be written to.", "start_line": 63, "end_line": 92, "is_async": false, "is_method": false}, {"name": "generate_filename", "qualified_name": "generate_filename", "args": ["self", "filename"], "decorators": [], "docstring": "Validate the filename by calling get_valid_name() and return a filename\nto be passed to the save() method.", "start_line": 94, "end_line": 101, "is_async": false, "is_method": false}, {"name": "path", "qualified_name": "path", "args": ["self", "name"], "decorators": [], "docstring": "Return a local filesystem path where the file can be retrieved using\nPython's built-in open() function. Storage systems that can't be\naccessed using open() should *not* implement this method.", "start_line": 103, "end_line": 109, "is_async": false, "is_method": false}, {"name": "delete", "qualified_name": "delete", "args": ["self", "name"], "decorators": [], "docstring": "Delete the specified file from the storage system.", "start_line": 114, "end_line": 118, "is_async": false, "is_method": false}, {"name": "exists", "qualified_name": "exists", "args": ["self", "name"], "decorators": [], "docstring": "Ret