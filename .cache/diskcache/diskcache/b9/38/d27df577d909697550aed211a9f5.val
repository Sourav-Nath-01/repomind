change_view", "qualified_name": "test_change_view", "args": ["self"], "decorators": [], "docstring": "Change view should restrict access and allow users to edit items.", "start_line": 1757, "end_line": 1871, "is_async": false, "is_method": false}, {"name": "test_change_view_without_object_change_permission", "qualified_name": "test_change_view_without_object_change_permission", "args": ["self"], "decorators": [], "docstring": "The object should be read-only if the user has permission to view it\nand change objects of that type but not to change the current object.", "start_line": 1873, "end_line": 1883, "is_async": false, "is_method": false}, {"name": "test_change_view_post_without_object_change_permission", "qualified_name": "test_change_view_post_without_object_change_permission", "args": ["self"], "decorators": [], "docstring": "A POST redirects to changelist without modifications.", "start_line": 1885, "end_line": 1898, "is_async": false, "is_method": false}, {"name": "test_change_view_save_as_new", "qualified_name": "test_change_view_save_as_new", "args": ["self"], "decorators": [], "docstring": "'Save as new' should raise PermissionDenied for users without the 'add'\npermission.", "start_line": 1900, "end_line": 1936, "is_async": false, "is_method": false}, {"name": "test_change_view_with_view_only_inlines", "qualified_name": "test_change_view_with_view_only_inlines", "args": ["self"], "decorators": [], "docstring": "User with change permission to a section but view-only for inlines.", "start_line": 1938, "end_line": 1964, "is_async": false, "is_method": false}, {"name": "test_change_view_with_view_and_add_inlines", "qualified_name": "test_change_view_with_view_and_add_inlines", "args": ["self"], "decorators": [], "docstring": "User has view and add permissions on the inline model.", "start_line": 1966, "end_line": 1998, "is_async": false, "is_method": false}, {"name": "test_change_view_with_view_and_delete_inlines", "qualified_name": "test_change_view_with_view_and_delete_inlines", "args": ["self"], "decorators": [], "docstring": "User has view and delete permissions on the inline model.", "start_line": 2000, "end_line": 2026, "is_async": false, "is_method": false}, {"name": "test_delete_view", "qualified_name": "test_delete_view", "args": ["self"], "decorators": [], "docstring": "Delete view should restrict access and actually delete items.", "start_line": 2028, "end_line": 2071, "is_async": false, "is_method": false}, {"name": "test_delete_view_with_no_default_permissions", "qualified_name": "test_delete_view_with_no_default_permissions", "args": ["self"], "decorators": [], "docstring": "The delete view allows users to delete collected objects without a\n'delete' permission (ReadOnlyPizza.Meta.default_permissions is empty).", "start_line": 2073, "end_line": 2088, "is_async": false, "is_method": false}, {"name": "test_delete_view_nonexistent_obj", "qualified_name": "test_delete_view_nonexistent_obj", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2090, "end_line": 2098, "is_async": false, "is_method": false}, {"name": "test_history_view", "qualified_name": "test_history_view", "args": ["self"], "decorators": [], "docstring": "History view should restrict access.", "start_line": 2100, "end_line": 2146, "is_async": false, "is_method": false}, {"name": "test_history_view_bad_url", "qualified_name": "test_history_view_bad_url", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2148, "end_line": 2155, "is_async": false, "is_method": false}, {"name": "test_conditionally_show_add_section_link", "qualified_name": "test_conditionally_show_add_section_link", "args": ["self"], "decorators": [], "docstring": "The foreign key widget should only show the \"add related\" button if the\nuser has permission to add that related item.", "start_line": 2157, "end_line": 2173, "is_async": false, "is_method": false}, {"name": "test_conditionally_show_change_section_link", "qualified_name": "test_conditionally_show_change_section_link", "args": ["self"], "decorators": [], "docstring": "The foreign key widget should only show the \"change related\" button if\nthe user has permission to change that related item.", "start_line": 2175, "end_line": 2196, "is_async": false, "is_method": false}, {"name": "test_conditionally_show_delete_section_link", "qualified_name": "test_conditionally_show_delete_section_link", "args": ["self"], "decorators": [], "docstring": "The foreign key widget should only show the \"delete related\" button if\nthe user has permission to delete that related item.", "start_line": 2198, "end_line": 2219, "is_async": false, "is_method": false}, {"name": "test_disabled_permissions_when_logged_in", "qualified_name": "test_disabled_permissions_when_logged_in", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2221, "end_line": 2232, "is_async": false, "is_method": false}, {"name": "test_disabled_staff_permissions_when_logged_in", "qualified_name": "test_disabled_staff_permissions_when_logged_in", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2234, "end_line": 2245, "is_async": false, "is_method": false}, {"name": "test_app_list_permissions", "qualified_name": "test_app_list_permissions", "args": ["self"], "decorators": [], "docstring": "If a user has no module perms, the app list returns a 404.", "start_line": 2247, "end_line": 2265, "is_async": false, "is_method": false}, {"name": "test_shortcut_view_only_available_to_staff", "qualified_name": "test_shortcut_view_only_available_to_staff", "args": ["self"], "decorators": [], "docstring": "Only admin users should be able to use the admin shortcut view.", "start_line": 2267, "end_line": 2285, "is_async": false, "is_method": false}, {"name": "test_has_module_permission", "qualified_name": "test_has_module_permission", "args": ["self"], "decorators": [], "docstring": "has_module_permission() returns True for all users who\nhave any permission for that module (add, change, or delete), so that\nthe module is displayed on the admin index page.", "start_line": 2287, "end_line": 2320, "is_async": false, "is_method": false}, {"name": "test_overriding_has_module_permission", "qualified_name": "test_overriding_has_module_permission", "args": ["self"], "decorators": [], "docstring": "If has_module_permission() always returns False, the module shouldn't\nbe displayed on the admin index page for any users.", "start_line": 2322, "end_line": 2364, "is_async": false, "is_method": false}, {"name": "test_post_save_message_no_forbidden_links_visible", "qualified_name": "test_post_save_message_no_forbidden_links_visible", "args": ["self"], "decorators": [], "docstring": "Post-save message shouldn't contain a link to the change form if the\nuser doesn't have the change permission.", "start_line": 2366, "end_line": 2385, "is_async": false, "is_method": false}, {"name": "setUpTestData", "qualified_name": "setUpTestData", "args": ["cls"], "decorators": ["classmethod"], "docstring": "", "start_line": 2405, "end_line": 2417, "is_async": false, "is_method": false}, {"name": "test_add", "qualified_name": "test_add", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2419, "end_line": 2430, "is_async": false, "is_method": false}, {"name": "test_view", "qualified_name": "test_view", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2432, "end_line": 2439, "is_async": false, "is_method": false}, {"name": "test_change", "qualified_name": "test_change", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2441, "end_line": 2453, "is_async": false, "is_method": false}, {"name": "test_delete", "qualified_name": "test_delete", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2455, "end_line": 2460, "is_async": false, "is_method": false}, {"name": "setUpTestData", "qualified_name": "setUpTestData", "args": ["cls"], "decorators": ["classmethod"], "docstring": "", "start_line": 2468, "end_line": 2471, "is_async": false, "is_method": false}, {"name": "test_no_standard_modeladmin_urls", "qualified_name": "test_no_standard_modeladmin_urls", "args": ["self"], "decorators": [], "docstring": "Admin index views don't break when user's ModelAdmin removes standard urls", "start_line": 2473, "end_line": 2479, "is_async": false, "is_method": false}, {"name": "setUpTestData", "qualified_name": "setUpTestData", "args": ["cls"], "decorators": ["classmethod"], "docstring": "", "start_line": 2487, "end_line": 2513, "is_async": false, "is_method": false}, {"name": "setUp", "qualified_name": "setUp", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2515, "end_line": 2516, "is_async": false, "is_method": false}, {"name": "test_nesting", "qualified_name": "test_nesting", "args": ["self"], "decorators": [], "docstring": "Objects should be nested to display the relationships that\ncause them to be scheduled for deletion.", "start_line": 2518, "end_line": 2531, "is_async": false, "is_method": false}, {"name": "test_cyclic", "qualified_name": "test_cyclic", "args": ["self"], "decorators": [], "docstring": "Cyclic relationships should still cause each object to only be\nlisted once.", "start_line": 2533, "end_line": 2547, "is_async": false, "is_method": false}, {"name": "test_perms_needed", "qualified_name": "test_perms_needed", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2549, "end_line": 2557, "is_async": false, "is_method": false}, {"name": "test_protected", "qualified_name": "test_protected", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2559, "end_line": 2573, "is_async": false, "is_method": false}, {"name": "test_post_delete_protected", "qualified_name": "test_post_delete_protected", "args": ["self"], "decorators": [], "docstring": "A POST request to delete protected objects should display the page\nwhich says the deletion is prohibited.", "start_line": 2575, "end_line": 2585, "is_async": false, "is_method": false}, {"name": "test_not_registered", "qualified_name": "test_not_registered", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2587, "end_line": 2590, "is_async": false, "is_method": false}, {"name": "test_multiple_fkeys_to_same_model", "qualified_name": "test_multiple_fkeys_to_same_model", "args": ["self"], "decorators": [], "docstring": "If a deleted object has two relationships from another model,\nboth of those should be followed in looking for related\nobjects to delete.", "start_line": 2592, "end_line": 2604, "is_async": false, "is_method": false}, {"name": "test_multiple_fkeys_to_same_instance", "qualified_name": "test_multiple_fkeys_to_same_instance", "args": ["self"], "decorators": [], "docstring": "If a deleted object has two relationships pointing to it from\nanother object, the other object should still only be listed\nonce.", "start_line": 2606, "end_line": 2616, "is_async": false, "is_method": false}, {"name": "test_inheritance", "qualified_name": "test_inheritance", "args": ["self"], "decorators": [], "docstring": "In the case of an inherited model, if either the child or\nparent-model instance is deleted, both instances are listed\nfor deletion, as well as any relationships they have.", "start_line": 2618, "end_line": 2637, "is_async": false, "is_method": false}, {"name": "test_generic_relations", "qualified_name": "test_generic_relations", "args": ["self"], "decorators": [], "docstring": "If a deleted object has GenericForeignKeys pointing to it,\nthose objects should be listed for deletion.", "start_line": 2639, "end_line": 2649, "is_async": false, "is_method": false}, {"name": "test_generic_relations_with_related_query_name", "qualified_name": "test_generic_relations_with_related_query_name", "args": ["self"], "decorators": [], "docstring": "If a deleted object has GenericForeignKey with\nGenericRelation(related_query_name='...') pointing to it, those objects\nshould be listed for deletion.", "start_line": 2651, "end_line": 2662, "is_async":