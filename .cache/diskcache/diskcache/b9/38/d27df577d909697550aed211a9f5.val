h can be stored as\nplain text.\n\nSince the data will be retrieved from the client-side, the encoded data\nalso contains a hash to ensure that the data was not tampered with.", "start_line": 131, "end_line": 142, "is_async": false, "is_method": false}, {"name": "_decode", "qualified_name": "_decode", "args": ["self", "data"], "decorators": [], "docstring": "Safely decode an encoded text stream back into a list of messages.\n\nIf the encoded text stream contained an invalid hash or was in an\ninvalid format, return None.", "start_line": 144, "end_line": 166, "is_async": false, "is_method": false}, {"name": "stored_length", "qualified_name": "stored_length", "args": ["val"], "decorators": [], "docstring": "", "start_line": 110, "end_line": 111, "is_async": false, "is_method": false}], "classes": [{"name": "MessageEncoder", "bases": ["json.JSONEncoder"], "methods": ["default"], "docstring": "Compactly serialize instances of the ``Message`` class as JSON.", "start_line": 10, "end_line": 24}, {"name": "MessageDecoder", "bases": ["json.JSONDecoder"], "methods": ["process_messages", "decode"], "docstring": "Decode JSON that includes serialized ``Message`` instances.", "start_line": 27, "end_line": 49}, {"name": "CookieStorage", "bases": ["BaseStorage"], "methods": ["_get", "_update_cookie", "_store", "_hash", "_encode", "_decode"], "docstring": "Store messages in a cookie.", "start_line": 52, "end_line": 166}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/contrib/sitemaps/management/commands/ping_google.py", "file_hash": "82a7c2a6877e5a9de714173c9a95a16cfd90496b1613be0827e865726f3fed26", "imports": [{"module": "django.contrib.sitemaps", "names": ["ping_google"], "is_from": true, "alias": ""}, {"module": "django.core.management.base", "names": ["BaseCommand"], "is_from": true, "alias": ""}], "functions": [{"name": "add_arguments", "qualified_name": "add_arguments", "args": ["self", "parser"], "decorators": [], "docstring": "", "start_line"