{"name": "get_field_type", "qualified_name": "get_field_type", "args": ["self", "data_type", "description"], "decorators": [], "docstring": "Hook for a database backend to use the cursor description to\nmatch a Django field type to a database column.\n\nFor Oracle, the column data_type on its own is insufficient to\ndistinguish between a FloatField and IntegerField, for example.", "start_line": 17, "end_line": 25, "is_async": false, "is_method": false}, {"name": "identifier_converter", "qualified_name": "identifier_converter", "args": ["self", "name"], "decorators": [], "docstring": "Apply a conversion to the identifier for the purposes of comparison.\n\nThe default identifier converter is for case sensitive comparison.", "start_line": 27, "end_line": 33, "is_async": false, "is_method": false}, {"name": "table_names", "qualified_name": "table_names", "args": ["self", "cursor", "include_views"], "decorators": [], "docstring": "Return a list of names of all tables that exist in the database.\nSort the returned table list by Python's default sorting. Do NOT use\nthe database's ORDER BY here to avoid subtle differences in sorting\norder between databases.", "start_line": 35, "end_line": 48, "is_async": false, "is_method": false}, {"name": "get_table_list", "qualified_name": "get_table_list", "args": ["self", "cursor"], "decorators": [], "docstring": "Return an unsorted list of TableInfo named tuples of all tables and\nviews that exist in the database.", "start_line": 50, "end_line": 55, "is_async": false, "is_method": false}, {"name": "django_table_names", "qualified_name": "django_table_names", "args": ["self", "only_existing", "include_views"], "decorators": [], "docstring": "Return a list of all table names that have associated Django models and\nare in INSTALLED_APPS.\n\nIf only_existing is True, include only the tables in the database.", "start_line": 57, "end_line": 84, "is_async": false, "is_method": false}, {"name": "installed_models", "qualified_name": "installed_models", "args": ["self", "tables"], "decorators": [], "docstring": "Return a set of all models represented by the provided list of table\nnames.", "start_line": 86, "end_line": 100, "is_async": false, "is_method": false}, {"name": "sequence_list", "qualified_name": "sequence_list", "args": ["self"], "decorators": [], "docstring": "Return a list of information about all DB sequences for all models in\nall apps.", "start_line": 102, "end_line": 125, "is_async": false, "is_method": false}, {"name": "get_sequences", "qualified_name": "get_sequences", "args": ["self", "cursor", "table_name", "table_fields"], "decorators": [], "docstring": "Return a list of introspected sequences for table_name. Each sequence\nis a dict: {'table': <table_name>, 'column': <column_name>}. An optional\n'name' key can be added if the backend supports named sequences.", "start_line": 127, "end_line": 133, "is_async": false, "is_method": false}, {"name": "get_key_columns", "qualified_name": "get_key_columns", "args": ["self", "cursor", "table_name"], "decorators": [], "docstring": "Backends can override this to return a list of:\n    (column_name, referenced_table_name, referenced_column_name)\nfor all key columns in given table.", "start_line": 135, "end_line": 141, "is_async": false, "is_method": false}, {"name": "get_primary_key_column", "qualified_name": "get_primary_key_column", "args": ["self", "cursor", "table_name"], "decorators": [], "docstring": "Return the name of the primary key column for the given table.", "start_line": 143, "end_line": 150, "is_async": false, "is_method": false}, {"name": "get_constraints", "qualified_name": "get_constraints", "args": ["self", "cursor", "table_name"], "decorators": [], "docstring": "Retrieve any constraints or keys (unique, pk, fk, check, index)\nacross one or more columns.\n\nReturn a dict mapping constraint names to their attributes,\nwhere attributes is a dict with keys:\n * columns: List of columns this covers\n * primary_key: True if primary key, False otherwise\n * unique: True ", "start_line": 152, "end_line": 171, "is_async": false, "is_method": false}, {"name": "get_names", "qualified_name": "get_names", "args": ["cursor"], "decorators": [], "docstring": "", "start_line": 42, "end_line": 44, "is_async": false, "is_method": false}], "classes": [{"name": "BaseDatabaseIntrospection", "bases": [], "methods": ["__init__", "get_field_type", "identifier_converter", "table_names", "get_table_list", "django_table_names", "installed_models", "sequence_list", "get_sequences", "get_key_columns", "get_primary_key_column", "get_constraints"], "docstring": "Encapsulate backend-specific introspection utilities.", "start_line": 10, "end_line": 171}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/db/backends/base/client.py", "file_hash": "afa75c461639b4fc7d9730d985b7030b5cfd2c3757c517bfbed9206104a6b842", "imports": [], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "connection"], "decorators": [], "docstring": "", "start_line": 7, "end_line": 9, "is_async": false, "is_method": false}, {"name": "runshell", "qualified_name": "runshell", "args": ["self"], "decorators": [], "docstring": "", "start_line": 11, "end_line": 12, "is_async": false, "is_method": false}], "classes": [{"name": "BaseDatabaseClient", "bases": [], "methods": ["__init__", "runshell"], "docstring": "Encapsulate backend-specific methods for opening a client shell.", "start_line": 1, "end_line": 12}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/db/models/fields/related_descriptors.py", "file_hash": "c551eb12bfc32aa29ad00c0d47e93fd06c4133ba7d8d621ca9aa3ef87c2e9254", "imports": [{"module": "django.core.exceptions", "names": ["FieldError"], "is_from": true, "alias": ""}, {"module": "django.db", "names": ["connections", "router", "transaction"], "is_from": true, "alias": ""}, {"module": "django.db.models", "names": ["Q", "signals"], "is_from": true, "