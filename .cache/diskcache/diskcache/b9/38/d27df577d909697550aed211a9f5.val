 settings.SECRET_KEY instead.\n\nIf compress is True (not the default), check if compressing using zlib can\nsave some space. Prepend a '.' to signify compression. This is included\nin the signature, to protect against z", "start_line": 93, "end_line": 123, "is_async": false, "is_method": false}, {"name": "loads", "qualified_name": "loads", "args": ["s", "key", "salt", "serializer", "max_age"], "decorators": [], "docstring": "Reverse of dumps(), raise BadSignature if signature fails.\n\nThe serializer is expected to accept a bytestring.", "start_line": 126, "end_line": 142, "is_async": false, "is_method": false}, {"name": "dumps", "qualified_name": "dumps", "args": ["self", "obj"], "decorators": [], "docstring": "", "start_line": 86, "end_line": 87, "is_async": false, "is_method": false}, {"name": "loads", "qualified_name": "loads", "args": ["self", "data"], "decorators": [], "docstring": "", "start_line": 89, "end_line": 90, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "key", "sep", "salt"], "decorators": [], "docstring": "", "start_line": 147, "end_line": 156, "is_async": false, "is_method": false}, {"name": "signature", "qualified_name": "signature", "args": ["self", "value"], "decorators": [], "docstring": "", "start_line": 158, "end_line": 159, "is_async": false, "is_method": false}, {"name": "sign", "qualified_name": "sign", "args": ["self", "value"], "decorators": [], "docstring": "", "start_line": 161, "end_line": 162, "is_async": false, "is_method": false}, {"name": "unsign", "qualified_name": "unsign", "args": ["self", "signed_value"], "decorators": [], "docstring": "", "start_line": 164, "end_line": 170, "is_async": false, "is_method": false}, {"name": "timestamp", "qualified_name": "timestamp", "args": ["self"], "decorators": [], "docstring": "", "start_line": 175, "end_line": 176, "is_async": false, "is_method": false}, {"name": "sign", "qualified_name": "sign", "args": ["self", "value"], "decorators": [], "docstring": "", "start_line": 178, "end_line": 180, "is_async": false, "is_method": false}, {"name": "unsign", "qualified_name": "unsign", "args": ["self", "value", "max_age"], "decorators": [], "docstring": "Retrieve original value and check it wasn't signed more\nthan max_age seconds ago.", "start_line": 182, "end_line": 198, "is_async": false, "is_method": false}], "classes": [{"name": "BadSignature", "bases": ["Exception"], "methods": [], "docstring": "Signature does not match.", "start_line": 52, "end_line": 54}, {"name": "SignatureExpired", "bases": ["BadSignature"], "methods": [], "docstring": "Signature timestamp is older than required max_age.", "start_line": 57, "end_line": 59}, {"name": "JSONSerializer", "bases": [], "methods": ["dumps", "loads"], "docstring": "Simple wrapper around json to be used in signing.dumps and\nsigning.loads.", "start_line": 81, "end_line": 90}, {"name": "Signer", "bases": [], "methods": ["__init__", "signature", "sign", "unsign"], "docstring": "", "start_line": 145, "end_line": 170}, {"name": "TimestampSigner", "bases": ["Signer"], "methods": ["timestamp", "sign", "unsign"], "docstring": "", "start_line": 173, "end_line": 198}], "calls": [], "module_docstring": "Functions for creating and restoring url-safe signed JSON objects.\n\nThe format used looks like this:\n\n>>> signing.dumps(\"hello\")\n'ImhlbGxvIg:1QaUZC:YIye-ze3TTx7gtSv422nZA4sgmk'\n\nThere are two components here, separated by a ':'. The first component is a\nURLsafe base64 encoded JSON of the object passed to dumps(). The second\ncomponent is a base64 encoded hmac/SHA1 hash of \"$first_component:$secret\"\n\nsigning.loads(s) checks the signature and returns the deserialized object.\nIf the signature fails, a BadSignature exception is raised.\n\n>>> signing.loads(\"ImhlbGxvIg:1QaUZC:YIye-ze3TTx7gtSv422nZA4sgmk\")\n'hello'\n>>> signing.loads(\"ImhlbGxvIg:1QaUZC:YIye-ze3TTx7gtSv422nZA4sgmk-modified\")\n...\nBadSignature: Signature failed: ImhlbGxvIg:1QaUZC:YIye-ze3TTx7gtSv422nZA4sgmk-modified\n\nYou can optionally compress the JSON prior to base64 encoding it to save\nspace, using the compress=True argument. This checks if compression actually\nhelps and only applies compression if the result is a shorter string:\n\n>>> signing.dumps(list(range(1, 20)), compress=True)\n'.eJwFwcERACAIwLCF-rCiILN47r-GyZVJsNgkxaFxoDgxcOHGxMKD_T7vhAml:1QaUaL:BA0thEZrp4FQVXIXuOvYJtLJSrQ'\n\nThe fact that the string is compressed is signalled by the prefixed '.' at the\nstart of the base64 JSON.\n\nThere are 65 url-safe characters: the 64 used by url-safe base64 and the ':'.\nThese functions make use of all of them.", "parse_error": ""}, {"file_path": "django/core/__init__.py", "file_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/core/paginator.py", "file_hash": "ac16e3ec6d300d33c7b8b2f1bd600722f27a963f7939a71119e44ac6dc952a88", "imports": [{"module": "collections.abc", "names": [], "is_from": false, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "math", "names": ["ceil"], "is_from": true, "alias": ""}, {"module": "django.utils.deprecation", "names": ["RemovedInDjango31Warning"], "is_from": true, "alias": ""}, {"module": "django.utils.functional", "names": ["cached_property"], "is_from": true, "alias": ""}, {"module": "django.utils.inspect", "names": ["method_has_no_args"], "is_from": true, "alias": ""}, {"module": "django.utils.translation", "names": ["gettext_lazy"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "object_list", "per_page", "orphans", "allow_empty_first_page"], "decorators": [], "docstring": "", "start_line": 30, "end_line": 36, "is_async": false, "is_method": false}, {"name": "validate_num