 false}, {"name": "make_list", "qualified_name": "make_list", "args": ["value"], "decorators": ["register.filter(is_safe=False)", "stringfilter"], "docstring": "Return the value turned into a list.\n\nFor an integer, it's a list of digits.\nFor a string, it's a list of characters.", "start_line": 199, "end_line": 206, "is_async": false, "is_method": false}, {"name": "slugify", "qualified_name": "slugify", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Convert to ASCII. Convert spaces to hyphens. Remove characters that aren't\nalphanumerics, underscores, or hyphens. Convert to lowercase. Also strip\nleading and trailing whitespace.", "start_line": 211, "end_line": 217, "is_async": false, "is_method": false}, {"name": "stringformat", "qualified_name": "stringformat", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)"], "docstring": "Format the variable according to the arg, a string formatting specifier.\n\nThis specifier uses Python string formatting syntax, with the exception\nthat the leading \"%\" is dropped.\n\nSee https://docs.python.org/library/stdtypes.html#printf-style-string-formatting\nfor documentation of Python string form", "start_line": 221, "end_line": 236, "is_async": false, "is_method": false}, {"name": "title", "qualified_name": "title", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Convert a string into titlecase.", "start_line": 241, "end_line": 244, "is_async": false, "is_method": false}, {"name": "truncatechars", "qualified_name": "truncatechars", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Truncate a string after `arg` number of characters.", "start_line": 249, "end_line": 255, "is_async": false, "is_method": false}, {"name": "truncatechars_html", "qualified_name": "truncatechars_html", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "s