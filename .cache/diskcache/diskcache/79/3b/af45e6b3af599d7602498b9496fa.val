umnFormat", "bases": ["_BaseColumnFormat"], "methods": ["__new__", "from_column_format", "from_recformat", "recformat", "canonical"], "docstring": "Similar to _ColumnFormat but specifically for columns in ASCII tables.\n\nThe formats of ASCII table columns and binary table columns are inherently\nincompatible in FITS.  They don't support the same ranges and types of\nvalues, and even reuse format codes in subtly different ways.  For example\nthe for", "start_line": 344, "end_line": 405}, {"name": "_FormatX", "bases": ["str"], "methods": ["__new__", "__getnewargs__", "tform"], "docstring": "For X format in binary tables.", "start_line": 408, "end_line": 423}, {"name": "_FormatP", "bases": ["str"], "methods": ["__new__", "__getnewargs__", "from_tform", "tform"], "docstring": "For P format in variable length table.", "start_line": 429, "end_line": 468}, {"name": "_FormatQ", "bases": ["_FormatP"], "methods": [], "docstring": "Carries type description of the Q format for variable length arrays.\n\nThe Q format is like the P format but uses 64-bit integers in the array\ndescriptors, allowing for heaps stored beyond 2GB into a file.", "start_line": 471, "end_line": 480}, {"name": "ColumnAttribute", "bases": [], "methods": ["__init__", "__get__", "__set__", "__call__", "__repr__"], "docstring": "Descriptor for attributes of `Column` that are associated with keywords\nin the FITS header and describe properties of the column as specified in\nthe FITS standard.\n\nEach `ColumnAttribute` may have a ``validator`` method defined on it.\nThis validates values set on this attribute to ensure that they m", "start_line": 483, "end_line": 550}, {"name": "Column", "bases": ["NotifierMixin"], "methods": ["__init__", "__repr__", "__eq__", "__hash__", "array", "array", "array", "name", "coord_type", "coord_unit", "coord_ref_point", "coord_ref_value", "coord_inc", "time_ref_pos", "ascii", "dtype", "copy", "_convert_format", "_verify_keywords", "_determine_formats", "_guess_format", "_conve