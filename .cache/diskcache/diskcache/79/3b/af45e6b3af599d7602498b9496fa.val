.", "start_line": 847, "end_line": 885, "is_async": false, "is_method": false}, {"name": "_convert_other", "qualified_name": "_convert_other", "args": ["self", "column", "field", "recformat"], "decorators": [], "docstring": "Perform conversions on any other fixed-width column data types.\n\nThis may not perform any conversion at all if it's not necessary, in\nwhich case the original column array is returned.", "start_line": 887, "end_line": 1018, "is_async": false, "is_method": false}, {"name": "_get_heap_data", "qualified_name": "_get_heap_data", "args": ["self"], "decorators": [], "docstring": "Returns a pointer into the table's raw data to its heap (if present).\n\nThis is returned as a numpy byte array.", "start_line": 1020, "end_line": 1031, "is_async": false, "is_method": false}, {"name": "_get_raw_data", "qualified_name": "_get_raw_data", "args": ["self"], "decorators": [], "docstring": "Returns the base array of self that \"raw data array\" that is the\narray in the format that it was first read from a file before it was\nsliced or viewed as a different type in any way.\n\nThis is determined by walking through the bases until finding one that\nhas at least the same number of bytes as self", "start_line": 1033, "end_line": 1061, "is_async": false, "is_method": false}, {"name": "_get_scale_factors", "qualified_name": "_get_scale_factors", "args": ["self", "column"], "decorators": [], "docstring": "Get all the scaling flags and factors for one column.", "start_line": 1063, "end_line": 1087, "is_async": false, "is_method": false}, {"name": "_scale_back", "qualified_name": "_scale_back", "args": ["self", "update_heap_pointers"], "decorators": [], "docstring": "Update the parent array, using the (latest) scaled array.\n\nIf ``update_heap_pointers`` is `False`, this will leave all the heap\npointers in P/Q columns as they are verbatim--it only makes sense to do\nthis if there is already data on the heap and it can be guaranteed that\nthat data has not been modif", "start_line": 1089, "end_line": 1194, "is_async": false, "is_method": false}, {"name": "_scale_back_strings", "qualified_name": "_scale_back_strings", "args": ["self", "col_idx", "input_field", "output_field"], "decorators": [], "docstring": "", "start_line": 1196, "end_line": 1238, "is_async": false, "is_method": false}, {"name": "_scale_back_ascii", "qualified_name": "_scale_back_ascii", "args": ["self", "col_idx", "input_field", "output_field"], "decorators": [], "docstring": "Convert internal array values back to ASCII table representation.\n\nThe ``input_field`` is the internal representation of the values, and\nthe ``output_field`` is the character array representing the ASCII\noutput that will be written.", "start_line": 1240, "end_line": 1309, "is_async": false, "is_method": false}, {"name": "tolist", "qualified_name": "tolist", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1311, "end_line": 1316, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "encoding", "object_", "start", "end", "reason", "index"], "decorators": [], "docstring": "", "start_line": 1335, "end_line": 1337, "is_async": false, "is_method": false}], "classes": [{"name": "FITS_record", "bases": [], "methods": ["__init__", "__getitem__", "__setitem__", "__len__", "__repr__", "field", "setfield", "_bases", "_get_index"], "docstring": "FITS record class.\n\n`FITS_record` is used to access records of the `FITS_rec` object.\nThis will allow us to deal with scaled columns.  It also handles\nconversion/scaling of columns in ASCII tables.  The `FITS_record`\nclass expects a `FITS_rec` object as input.", "start_line": 34, "end_line": 146}, {"name": "FITS_rec", "bases": ["np.recarray"], "methods": ["__new__", "__setstate__", "__reduce__", "__array_finalize__", "_init", "from_columns", "__repr__", "__getattribute__", "__getitem__", "__setitem__", "_ipython_key_completions_", "copy", "columns", "_coldefs", "_coldefs", "_coldef