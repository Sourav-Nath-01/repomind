_name": "__init__", "args": ["self", "matrix", "translation"], "decorators": [], "docstring": "", "start_line": 1576, "end_line": 1579, "is_async": false, "is_method": false}, {"name": "inverse", "qualified_name": "inverse", "args": ["self"], "decorators": ["property"], "docstring": "Inverse transformation.\n\nRaises `~astropy.modeling.InputParameterError` if the transformation cannot be inverted.", "start_line": 1582, "end_line": 1601, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["cls", "x", "y", "matrix", "translation"], "decorators": ["classmethod"], "docstring": "Apply the transformation to a set of 2D Cartesian coordinates given as\ntwo lists--one for the x coordinates and one for a y coordinates--or a\nsingle coordinate pair.\n\nParameters\n----------\nx, y : array, float\n      x and y coordinates", "start_line": 1604, "end_line": 1632, "is_async": false, "is_method": false}, {"name": "_create_augmented_matrix", "qualified_name": "_create_augmented_matrix", "args": ["matrix", "translation"], "decorators": ["staticmethod"], "docstring": "", "start_line": 1635, "end_line": 1654, "is_async": false, "is_method": false}, {"name": "input_units", "qualified_name": "input_units", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 1657, "end_line": 1666, "is_async": false, "is_method": false}], "classes": [{"name": "_ParameterDS", "bases": ["Parameter"], "methods": ["__init__", "validate"], "docstring": "Same as `Parameter` but can indicate its modified status via the ``dirty``\nproperty. This flag also gets set automatically when a parameter is\nmodified.\n\nThis ability to track parameter's modified status is needed for automatic\nupdate of WCSLIB's prjprm structure (which may be a more-time intensive\n", "start_line": 83, "end_line": 101}, {"name": "Projection", "bases": ["Model"], "methods": ["__init__", "inverse", "prjprm", "_update_prj", "__getstate__", "__setstate__"], "docstring": "Base class for all sky projections.", "start_line": 104, "end_line": 171}, {"name": "Pix2SkyProjection", "bases": ["Projection"], "methods": ["__new__", "__init__", "input_units", "return_units", "evaluate", "inverse"], "docstring": "Base class for all Pix2Sky projections.", "start_line": 174, "end_line": 216}, {"name": "Sky2PixProjection", "bases": ["Projection"], "methods": ["__new__", "__init__", "input_units", "return_units", "evaluate", "inverse"], "docstring": "Base class for all Sky2Pix projections.", "start_line": 219, "end_line": 261}, {"name": "Zenithal", "bases": ["Projection"], "methods": [], "docstring": "Base class for all Zenithal projections.\n\nZenithal (or azimuthal) projections map the sphere directly onto a\nplane.  All zenithal projections are specified by defining the\nradius as a function of native latitude, :math:`R_\\theta`.\n\nThe pixel-to-sky transformation is defined as:\n\n.. math::\n    \\phi &", "start_line": 264, "end_line": 282}, {"name": "Pix2Sky_ZenithalPerspective", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": ["_mu_validator"], "docstring": "Zenithal perspective projection - pixel to sky.\n\nCorresponds to the ``AZP`` projection in FITS WCS.\n\n.. math::\n    \\phi &= \\arg(-y \\cos \\gamma, x) \\\\\n    \\theta &= \\left\\{\\genfrac{}{}{0pt}{}{\\psi - \\omega}{\\psi + \\omega + 180^{\\circ}}\\right.\n\nwhere:\n\n.. math::\n    \\psi &= \\arg(\\rho, 1) \\\\\n    \\omega", "start_line": 285, "end_line": 330}, {"name": "Sky2Pix_ZenithalPerspective", "bases": ["Sky2PixProjection", "Zenithal"], "methods": ["_mu_validator"], "docstring": "Zenithal perspective projection - sky to pixel.\n\nCorresponds to the ``AZP`` projection in FITS WCS.\n\n.. math::\n    x &= R \\sin \\phi \\\\\n    y &= -R \\sec \\gamma \\cos \\theta\n\nwhere:\n\n.. math::\n    R = \\frac{180^{\\circ}}{\\pi} \\frac{(\\mu + 1) \\cos \\theta}\n        {(\\mu + \\sin \\theta) + \\cos \\theta \\cos \\", "start_line": 333, "end_line": 376}, {"name": "Pix2Sky_SlantZenithalPerspective", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": ["_mu_validator"], "docstring": "Slant zenithal perspective projection - pixel to sky.\n\nCorresponds to the ``SZP`` projection in FITS WCS.\n\nParameters\n----------\nmu : float\n    Distance from point of projection to center of sphere\n    in spherical radii, \u03bc.  Default is 0.\n\nphi0 : float\n    The longitude \u03c6\u2080 of the reference point, i", "start_line": 379, "end_line": 423}, {"name": "Sky2Pix_SlantZenithalPerspective", "bases": ["Sky2PixProjection", "Zenithal"], "methods": ["_mu_validator"], "docstring": "Zenithal perspective projection - sky to pixel.\n\nCorresponds to the ``SZP`` projection in FITS WCS.\n\nParameters\n----------\nmu : float\n    distance from point of projection to center of sphere\n    in spherical radii, \u03bc.  Default is 0.\n\nphi0 : float\n    The longitude \u03c6\u2080 of the reference point, in degr", "start_line": 426, "end_line": 470}, {"name": "Pix2Sky_Gnomonic", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": [], "docstring": "Gnomonic projection - pixel to sky.\n\nCorresponds to the ``TAN`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    \\theta = \\tan^{-1}\\left(\\frac{180^{\\circ}}{\\pi R_\\theta}\\right)", "start_line": 473, "end_line": 483}, {"name": "Sky2Pix_Gnomonic", "bases": ["Sky2PixProjection", "Zenithal"], "methods": [], "docstring": "Gnomonic Projection - sky to pixel.\n\nCorresponds to the ``TAN`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    R_\\theta = \\frac{180^{\\circ}}{\\pi}\\cot \\theta", "start_line": 486, "end_line": 496}, {"name": "Pix2Sky_Stereographic", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": [], "docstring": "Stereographic Projection - pixel to sky.\n\nCorresponds to the ``STG`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    \\theta = 90^{\\circ} - 2 \\tan^{-1}\\left(\\frac{\\pi R_\\theta}{360^{\\circ}}\\right)", "start_line": 499, "end_line": 509}, {"name": "Sky2Pix_Stereographic", "bases": ["Sky2PixProjection", "Zenithal"], "methods": [], "docstring": "Stereographic Projection - sky to pixel.\n\nCorresponds to the ``STG`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    R_\\theta = \\frac{180^{\\circ}}{\\pi}\\frac{2 \\cos \\theta}{1 + \\sin \\theta}", "start_line": 512, "end_line": 522}, {"name": "Pix2Sky_SlantOrthographic", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": [], "docstring": "Slant orthographic projection - pixel to sky.\n\nCorresponds to the ``SIN`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\nThe following transformation applies when :math:`\\xi` and\n:math:`\\eta` are both zero.\n\n.. math::\n    \\theta = \\cos^{-1}\\left(\\frac{\\pi}{180^", "start_line": 525, "end_line": 557}, {"name": "Sky2Pix_SlantOrthographic", "bases": ["Sky2PixProjection", "Zenithal"], "methods": [], "docstring": "Slant orthographic projection - sky to pixel.\n\nCorresponds to the ``SIN`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\nThe following transformation applies when :math:`\\xi` and\n:math:`\\eta` are both zero.\n\n.. math::\n    R_\\theta = \\frac{180^{\\circ}}{\\pi}\\cos ", "start_line": 560, "end_line": 583}, {"name": "Pix2Sky_ZenithalEquidistant", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": [], "docstring": "Zenithal equidistant projection - pixel to sky.\n\nCorresponds to the ``ARC`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    \\theta = 90^\\circ - R_\\theta", "start_line": 586, "end_line": 596}, {"name": "Sky2Pix_ZenithalEquidistant", "bases": ["Sky2PixProjection", "Zenithal"], "methods": [], "docstring": "Zenithal equidistant projection - sky to pixel.\n\nCorresponds to the ``ARC`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    R_\\theta = 90^\\circ - \\theta", "start_line": 599, "end_line": 609}, {"name": "Pix2Sky_ZenithalEqualArea", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": [], "docstring": "Zenithal equidistant projection - pixel to sky.\n\nCorresponds to the ``ZEA`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    \\theta = 90^\\circ - 2 \\sin^{-1} \\left(\\frac{\\pi R_\\theta}{360^\\circ}\\right)", "start_line": 612, "end_line": 622}, {"name": "Sky2Pix_ZenithalEqualArea", "bases": ["Sky2PixProjection", "Zenithal"], "methods": [], "docstring": "Zenithal equidistant projection - sky to pixel.\n\nCorresponds to the ``ZEA`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    R_\\theta &= \\frac{180^\\circ}{\\pi} \\sqrt{2(1 - \\sin\\theta)} \\\\\n             &= \\frac{360^\\circ}{\\pi} \\sin\\left(\\frac{90^\\circ", "start_line": 625, "end_line": 636}, {"name": "Pix2Sky_Airy", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": [], "docstring": "Airy projection - pixel to sky.\n\nCorresponds to the ``AIR`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\nParameters\n----------\ntheta_b : float\n    The latitude :math:`\\theta_b` at which to minimize the error,\n    in degrees.  Default is 90\u00b0.", "start_line": 639, "end_line": 654}, {"name": "Sky2Pix_Airy", "bases": ["Sky2PixProjection", "Zenithal"], "methods": [], "docstring": "Airy - sky to pixel.\n\nCorresponds to the ``AIR`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    R_\\theta = -2 \\frac{180^\\circ}{\\pi}\\left(\\frac{\\ln(\\cos \\xi)}{\\tan \\xi} +\n        \\frac{\\ln(\\cos \\xi_b)}{\\tan^2 \\xi_b} \\tan \\xi \\right)\n\nwhere:\n\n.. mat", "start_line": 657, "end_line": 686}, {"name": "Cylindrical", "bases": ["Projection"], "methods": [], "docstring": "Base class for Cylindrical projections.\n\nCylindrical projections are so-named because the surface of\nprojection is a cylinder.", "start_line": 689, "end_line": 696}, {"name": "Pix2Sky_CylindricalPerspective", "bases": ["Pix2SkyProjection", "Cylindrical"], "methods": ["_mu_validator", "_lam_validator"], "docstring": "Cylindrical perspective - pixel to sky.\n\nCorresponds to the ``CYP`` projection in FITS WCS.\n\n.. math::\n    \\phi &= \\frac{x}{\\lambda} \\\\\n    \\theta &= \\arg(1, \\eta) + \\sin{-1}\\left(\\frac{\\eta \\mu}{\\sqrt{\\eta^2 + 1}}\\right)\n\nwhere:\n\n.. math::\n    \\eta = \\frac{\\pi}{180^{\\circ}}\\frac{y}{\\mu + \\lambda}\n\n", "start_line": 699, "end_line": 738}, {"name": "Sky2Pix_CylindricalPerspective", "bases": ["Sky2PixProjection", "Cylindrical"], "methods": ["_mu_validator", "_lam_validator"], "docstring": "Cylindrical Perspective - sky to pixel.\n\nCorresponds to the ``CYP`` projection in FITS WCS.\n\n.. math::\n    x &= \\lambda \\phi \\\\\n    y &= \\frac{180^{\\circ}}{\\pi}\\left(\\frac{\\mu + \\lambda}{\\mu + \\cos \\theta}\\right)\\sin \\theta\n\nParameters\n----------\nmu : float\n    Distance from center of sphere in the ", "start_line": 741, "end_line": 779}, {"name": "Pix2Sky_CylindricalEqualArea", "bases": ["Pix2SkyProjection", "Cylindrical"], "methods": [], "docstring": "Cylindrical equal area projection - pixel to sky.\n\nCorresponds to the ``CEA`` projection in FITS WCS.\n\n.. math::\n    \\phi &= x \\\\\n    \\theta &= \\sin^{-1}\\left(\\frac{\\pi}{180^{\\circ}}\\lambda y\\right)\n\nParameters\n----------\nlam : float\n    Radius of the cylinder in spherical radii, \u03bb.  Default is 1.", "start_line": 782, "end_line": 798}, {"name": "Sky2Pix_CylindricalEqualArea", "bases": ["Sky2PixProjection", "Cylindrical"], "methods": [], "docstring": "Cylindrical equal area projection - sky to pixel.\n\nCorresponds to the ``CEA`` projection in FITS WCS.\n\n.. math::\n    x &= \\phi \\\\\n    y &= \\frac{180^{\\circ}}{\\pi}\\frac{\\sin \\theta}{\\lambda}\n\nParameters\n----------\nlam : float\n    Radius of the cylinder in spherical radii, \u03bb.  Default is 0.", "start_line": 801, "end_line": 817}, {"name": "Pix2Sky_PlateCarree", "bases": ["Pix2SkyProjection", "Cylindrical"], "methods": ["evaluate"], "docstring": "Plate carr\u00e9e projection - pixel to sky.\n\nCorresponds to the ``CAR`` projection in FITS WCS.\n\n.. math::\n    \\phi &= x \\\\\n    \\theta &= y", "start_line": 820, "end_line": 836}, {"name": "Sky2Pix_PlateCarree", "bases": ["Sky2PixProjection", "Cylindrical"], "methods": ["evaluate"], "docstring": "Plate carr\u00e9e projection - sky to pixel.\n\nCorresponds to the ``CAR`` projection in FITS WCS.\n\n.. math::\n    x &= \\phi \\\\\n    y &= \\theta", "start_line": 839, "end_line": 855}, {"name": "Pix2Sky_Mercator", "bases": ["Pix2SkyProjection", "Cylindrical"], "methods": [], "docstring": "Mercator - pixel to sky.\n\nCorresponds to the ``MER`` projection in FITS WCS.\n\n.. math::\n    \\phi &= x \\\\\n    \\theta &= 2 \\tan^{-1}\\left(e^{y \\pi / 180^{\\circ}}\\right)-90^{\\circ}", "start_line": 858, "end_line": 867}, {"name": "Sky2Pix_Mercator", "bases": ["Sky2PixProjection", "Cylindrical"], "methods": [], "docstring": "Mercator - sky to pixel.\n\nCorresponds to the ``MER`` projection in FITS WCS.\n\n.. math::\n    x &= \\phi \\\\\n    y &= \\frac{180^{\\circ}}{\\pi}\\ln \\tan \\left(\\frac{90^{\\circ} + \\theta}{2}\\right)", "start_line": 870, "end_line": 879}, {"name": "PseudoCylindrical", "bases": ["Projection"], "methods": [], "docstring": "Base class for pseudocylindrical projections.\n\nPseudocylindrical projections are like cylindrical projections\nexcept the parallels of latitude are projected at diminishing\nlengths toward the polar regions in order to reduce lateral\ndistortion there.  Consequently, the meridians are curved.", "start_line": 882, "end_line": 891}, {"name": "Pix2Sky_SansonFlamsteed", "bases": ["Pix2SkyProjection", "PseudoCylindrical"], "methods": [], "docstring": "Sanson-Flamsteed projection - pixel to sky.\n\nCorresponds to the ``SFL`` projection in FITS WCS.\n\n.. math::\n    \\phi &= \\frac{x}{\\cos y} \\\\\n    \\theta &= y", "start_line": 894, "end_line": 903}, {"name": "Sky2Pix_SansonFlamsteed", "bases": ["Sky2PixProjection", "PseudoCylindrical"], "methods": [], "docstring": "Sanson-Flamsteed projection - sky to pixel.\n\nCorresponds to the ``SFL`` projection in FITS WCS.\n\n.. math::\n    x &= \\phi \\cos \\theta \\\\\n    y &= \\theta", "start_line": 906, "end_line": 915}, {"name": "Pix2Sky_Parabolic", "bases": ["Pix2SkyProjection", "PseudoCylindrical"], "methods": [], "docstring": "Parabolic projection - pixel to sky.\n\nCorresponds to the ``PAR`` projection in FITS WCS.\n\n.. math::\n    \\phi &= \\frac{180^\\circ}{\\pi} \\frac{x}{1 - 4(y / 180^\\circ)^2} \\\\\n    \\theta &= 3 \\sin^{-1}\\left(\\frac{y}{180^\\circ}\\right)", "start_line": 918, "end_line": 927}, {"name": "Sky2Pix_Parabolic", "bases": ["Sky2PixProjection", "PseudoCylindrical"], "methods": [], "docstring": "Parabolic projection - sky to pixel.\n\nCorresponds to the ``PAR`` projection in FITS WCS.\n\n.. math::\n    x &= \\phi \\left(2\\cos\\frac{2\\theta}{3} - 1\\right) \\\\\n    y &= 180^\\circ \\sin \\frac{\\theta}{3}", "start_line": 930, "end_line": 939}, {"name": "Pix2Sky_Molleweide", "bases": ["Pix2SkyProjection", "PseudoCylindrical"], "methods": [], "docstring": "Molleweide's projection - pixel to sky.\n\nCorresponds to the ``MOL`` projection in FITS WCS.\n\n.. math::\n    \\phi &= \\frac{\\pi x}{2 \\sqrt{2 - \\left(\\frac{\\pi}{180^\\circ}y\\right)^2}} \\\\\n    \\theta &= \\sin^{-1}\\left(\n            \\frac{1}{90^\\circ}\\sin^{-1}\\left(\\frac{\\pi}{180^\\circ}\\frac{y}{\\sqrt{2}}\\ri", "start_line": 942, "end_line": 954}, {"name": "Sky2Pix_Molleweide", "bases": ["Sky2PixProjection", "PseudoCylindrical"], "methods": [], "docstring": "Molleweide's projection - sky to pixel.\n\nCorresponds to the ``MOL`` projection in FITS WCS.\n\n.. math::\n    x &= \\frac{2 \\sqrt{2}}{\\pi} \\phi \\cos \\gamma \\\\\n    y &= \\sqrt{2} \\frac{180^\\circ}{\\pi} \\sin \\gamma\n\nwhere :math:`\\gamma` is defined as the solution of the\ntranscendental equation:\n\n.. math::\n\n", "start_line": 957, "end_line": 973}, {"name": "Pix2Sky_HammerAitoff", "bases": ["Pix2SkyProjection", "PseudoCylindrical"], "methods": [], "docstring": "Hammer-Aitoff projection - pixel to sky.\n\nCorresponds to the ``AIT`` projection in FITS WCS.\n\n.. math::\n    \\phi &= 2 \\arg \\left(2Z^2 - 1, \\frac{\\pi}{180^\\circ} \\frac{Z}{2}x\\right) \\\\\n    \\theta &= \\sin^{-1}\\left(\\frac{\\pi}{180^\\circ}yZ\\right)", "start_line": 976, "end_line": 985}, {"name": "Sky2Pix_HammerAitoff", "bases": ["Sky2PixProjection", "PseudoCylindrical"], "methods": [], "docstring": "Hammer-Aitoff projection - sky to pixel.\n\nCorresponds to the ``AIT`` projection in FITS WCS.\n\n.. math::\n    x &= 2 \\gamma \\cos \\theta \\sin \\frac{\\phi}{2} \\\\\n    y &= \\gamma \\sin \\theta\n\nwhere:\n\n.. math::\n    \\gamma = \\frac{180^\\circ}{\\pi} \\sqrt{\\frac{2}{1 + \\cos \\theta \\cos(\\phi / 2)}}", "start_line": 988, "end_line": 1002}, {"name": "Conic", "bases": ["Projection"], "methods": [], "docstring": "Base class for conic projections.\n\nIn conic projections, the sphere is thought to be projected onto\nthe surface of a cone which is then opened out.\n\nIn a general sense, the pixel-to-sky transformation is defined as:\n\n.. math::\n\n    \\phi &= \\arg\\left(\\frac{Y_0 - y}{R_\\theta}, \\frac{x}{R_\\theta}\\right", "start_line": 1005, "end_line": 1031}, {"name": "Pix2Sky_ConicPerspective", "bases": ["Pix2SkyProjection", "Conic"], "methods": [], "docstring": "Colles' conic perspective projection - pixel to sky.\n\nCorresponds to the ``COP`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formulae are:\n\n.. math::\n    C &= \\sin \\theta_a \\\\\n    R_\\theta &= \\frac{180^\\circ}{\\pi} \\cos \\eta [ \\cot \\theta_a - \\tan(\\t", "start_line": 1034, "end_line": 1060}, {"name": "Sky2Pix_ConicPerspective", "bases": ["Sky2PixProjection", "Conic"], "methods": [], "docstring": "Colles' conic perspective projection - sky to pixel.\n\nCorresponds to the ``COP`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formulae are:\n\n.. math::\n    C &= \\sin \\theta_a \\\\\n    R_\\theta &= \\frac{180^\\circ}{\\pi} \\cos \\eta [ \\cot \\theta_a - \\tan(\\t", "start_line": 1063, "end_line": 1089}, {"name": "Pix2Sky_ConicEqualArea", "bases": ["Pix2SkyProjection", "Conic"], "methods": [], "docstring": "Alber's conic equal area projection - pixel to sky.\n\nCorresponds to the ``COE`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formulae are:\n\n.. math::\n    C &= \\gamma / 2 \\\\\n    R_\\theta &= \\frac{180^\\circ}{\\pi} \\frac{2}{\\gamma}\n        \\sqrt{1 + \\sin", "start_line": 1092, "end_line": 1125}, {"name": "Sky2Pix_ConicEqualArea", "bases": ["Sky2PixProjection", "Conic"], "methods": [], "docstring": "Alber's conic equal area projection - sky to pixel.\n\nCorresponds to the ``COE`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formulae are:\n\n.. math::\n    C &= \\gamma / 2 \\\\\n    R_\\theta &= \\frac{180^\\circ}{\\pi} \\frac{2}{\\gamma}\n        \\sqrt{1 + \\sin", "start_line": 1128, "end_line": 1161}, {"name": "Pix2Sky_ConicEquidistant", "bases": ["Pix2SkyProjection", "Conic"], "methods": [], "docstring": "Conic equidistant projection - pixel to sky.\n\nCorresponds to the ``COD`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formulae are:\n\n.. math::\n\n    C &= \\frac{180^\\circ}{\\pi} \\frac{\\sin\\theta_a\\sin\\eta}{\\eta} \\\\\n    R_\\theta &= \\theta_a - \\theta + \\e", "start_line": 1164, "end_line": 1191}, {"name": "Sky2Pix_ConicEquidistant", "bases": ["Sky2PixProjection", "Conic"], "methods": [], "docstring": "Conic equidistant projection - sky to pixel.\n\nCorresponds to the ``COD`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formulae are:\n\n.. math::\n\n    C &= \\frac{180^\\circ}{\\pi} \\frac{\\sin\\theta_a\\sin\\eta}{\\eta} \\\\\n    R_\\theta &= \\theta_a - \\theta + \\e", "start_line": 1194, "end_line": 1221}, {"name": "Pix2Sky_ConicOrthomorphic", "bases": ["Pix2SkyProjection", "Conic"], "methods": [], "docstring": "Conic orthomorphic projection - pixel to sky.\n\nCorresponds to the ``COO`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formulae are:\n\n.. math::\n\n    C &= \\frac{\\ln \\left( \\frac{\\cos\\theta_2}{\\cos\\theta_1} \\right)}\n              {\\ln \\left[ \\frac{\\tan", "start_line": 1224, "end_line": 1260}, {"name": "Sky2Pix_ConicOrthomorphic", "bases": ["Sky2PixProjection", "Conic"], "methods": [], "docstring": "Conic orthomorphic projection - sky to pixel.\n\nCorresponds to the ``COO`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formulae are:\n\n.. math::\n\n    C &= \\frac{\\ln \\left( \\frac{\\cos\\theta_2}{\\cos\\theta_1} \\right)}\n              {\\ln \\left[ \\frac{\\tan", "start_line": 1263, "end_line": 1299}, {"name": "PseudoConic", "bases": ["Projection"], "methods": [], "docstring": "Base class for pseudoconic projections.\n\nPseudoconics are a subclass of conics with concentric parallels.", "start_line": 1302, "end_line": 1306}, {"name": "Pix2Sky_BonneEqualArea", "bases": ["Pix2SkyProjection", "PseudoConic"], "methods": [], "docstring": "Bonne's equal area pseudoconic projection - pixel to sky.\n\nCorresponds to the ``BON`` projection in FITS WCS.\n\n.. math::\n\n    \\phi &= \\frac{\\pi}{180^\\circ} A_\\phi R_\\theta / \\cos \\theta \\\\\n    \\theta &= Y_0 - R_\\theta\n\nwhere:\n\n.. math::\n\n    R_\\theta &= \\mathrm{sign} \\theta_1 \\sqrt{x^2 + (Y_0 - y)^2", "start_line": 1309, "end_line": 1335}, {"name": "Sky2Pix_BonneEqualArea", "bases": ["Sky2PixProjection", "PseudoConic"], "methods": [], "docstring": "Bonne's equal area pseudoconic projection - sky to pixel.\n\nCorresponds to the ``BON`` projection in FITS WCS.\n\n.. math::\n    x &= R_\\theta \\sin A_\\phi \\\\\n    y &= -R_\\theta \\cos A_\\phi + Y_0\n\nwhere:\n\n.. math::\n    A_\\phi &= \\frac{180^\\circ}{\\pi R_\\theta} \\phi \\cos \\theta \\\\\n    R_\\theta &= Y_0 - \\th", "start_line": 1338, "end_line": 1368}, {"name": "Pix2Sky_Polyconic", "bases": ["Pix2SkyProjection", "PseudoConic"], "methods": [], "docstring": "Polyconic projection - pixel to sky.\n\nCorresponds to the ``PCO`` projection in FITS WCS.", "start_line": 1371, "end_line": 1376}, {"name": "Sky2Pix_Polyconic", "bases": ["Sky2PixProjection", "PseudoConic"], "methods": [], "docstring": "Polyconic projection - sky to pixel.\n\nCorresponds to the ``PCO`` projection in FITS WCS.", "start_line": 1379, "end_line": 1384}, {"name": "QuadCube", "bases": ["Projection"], "methods": [], "docstring": "Base class for quad cube projections.\n\nQuadrilateralized spherical cube (quad-cube) projections belong to\nthe class of polyhedral projections in which the sphere is\nprojected onto the surface of an enclosing polyhedron.\n\nThe six faces of the quad-cube projections are numbered and laid\nout as::\n\n    ", "start_line": 1387, "end_line": 1401}, {"name": "Pix2Sky_TangentialSphericalCube", "bases": ["Pix2SkyProjection", "QuadCube"], "methods": [], "docstring": "Tangential spherical cube projection - pixel to sky.\n\nCorresponds to the ``TSC`` projection in FITS WCS.", "start_line": 1404, "end_line": 1409}, {"name": "Sky2Pix_TangentialSphericalCube", "bases": ["Sky2PixProjection", "QuadCube"], "methods": [], "docstring": "Tangential spherical cube projection - sky to pixel.\n\nCorresponds to the ``TSC`` projection in FITS WCS.", "start_line": 1412, "end_line": 1417}, {"name": "Pix2Sky_COBEQuadSphericalCube", "bases": ["Pix2SkyProjection", "QuadCube"], "methods": [], "docstring": "COBE quadrilateralized spherical cube projection - pixel to sky.\n\nCorresponds to the ``CSC`` projection in FITS WCS.", "start_line": 1420, "end_line": 1425}, {"name": "Sky2Pix_COBEQuadSphericalCube", "bases": ["Sky2PixProjection", "QuadCube"], "methods": [], "docstring": "COBE quadrilateralized spherical cube projection - sky to pixel.\n\nCorresponds to the ``CSC`` projection in FITS WCS.", "start_line": 1428, "end_line": 1433}, {"name": "Pix2Sky_QuadSphericalCube", "bases": ["Pix2SkyProjection", "QuadCube"], "methods": [], "docstring": "Quadrilateralized spherical cube projection - pixel to sky.\n\nCorresponds to the ``QSC`` projection in FITS WCS.", "start_line": 1436, "end_line": 1441}, {"name": "Sky2Pix_QuadSphericalCube", "bases": ["Sky2PixProjection", "QuadCube"], "methods": [], "docstring": "Quadrilateralized spherical cube projection - sky to pixel.\n\nCorresponds to the ``QSC`` projection in FITS WCS.", "start_line": 1444, "end_line": 1449}, {"name": "HEALPix", "bases": ["Projection"], "methods": [], "docstring": "Base class for HEALPix projections.", "start_line": 1452, "end_line": 1453}, {"name": "Pix2Sky_HEALPix", "bases": ["Pix2SkyProjection", "HEALPix"], "methods": [], "docstring": "HEALPix - pixel to sky.\n\nCorresponds to the ``HPX`` projection in FITS WCS.\n\nParameters\n----------\nH : float\n    The number of facets in longitude direction.\n\nX : float\n    The number of facets in latitude direction.", "start_line": 1456, "end_line": 1479}, {"name": "Sky2Pix_HEALPix", "bases": ["Sky2PixProjection", "HEALPix"], "methods": [], "docstring": "HEALPix projection - sky to pixel.\n\nCorresponds to the ``HPX`` projection in FITS WCS.\n\nParameters\n----------\nH : float\n    The number of facets in longitude direction.\n\nX : float\n    The number of facets in latitude direction.", "start_line": 1482, "end_line": 1505}, {"name": "Pix2Sky_HEALPixPolar", "bases": ["Pix2SkyProjection", "HEALPix"], "methods": [], "docstring": "HEALPix polar, aka \"butterfly\" projection - pixel to sky.\n\nCorresponds to the ``XPH`` projection in FITS WCS.", "start_line": 1508, "end_line": 1513}, {"name": "Sky2Pix_HEALPixPolar", "bases": ["Sky2PixProjection", "HEALPix"], "methods": [], "docstring": "HEALPix polar, aka \"butterfly\" projection - pixel to sky.\n\nCorresponds to the ``XPH`` projection in FITS WCS.", "start_line": 1516, "end_line": 1521}, {"name": "AffineTransformation2D", "bases": ["Model"], "methods": ["_matrix_validator", "_translation_validator", "__init__", "inverse", "evaluate", "_create_augmented_matrix", "input_units"], "docstring": "Perform an affine transformation in 2 dimensions.\n\nParameters\n----------\nmatrix : array\n    A 2x2 matrix specifying the linear transformation to apply to the\n    inputs\n\ntranslation : array\n    A 2D vector (given as either a 2x1 or 1x2 array) specifying a\n    translation to apply to the inputs", "start_line": 1524, "end_line": 1666}], "calls": [], "module_docstring": "Implements projections--particularly sky projections defined in WCS Paper II\n[1]_.\n\nAll angles are set and and displayed in degrees but internally computations are\nperformed in radians. All functions expect inputs and outputs degrees.\n\nReferences\n----------\n.. [1] Calabretta, M.R., Greisen, E.W., 2002, A&A, 395, 1077 (Paper II)", "parse_error": ""}, {"file_path": "astropy/modeling/mappings.py", "file_hash": "decc975998cb985da59a5146a60c07a247a9aa58bd8f8ecd487f1fed1d178602", "imports": [{"module": "astropy.units", "names": ["Quantity"], "is_from": true, "alias": ""}, {"module": "core", "names": ["FittableModel", "Model"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "mapping", "n_inputs", "name", "meta"], "decorators": [], "docstri