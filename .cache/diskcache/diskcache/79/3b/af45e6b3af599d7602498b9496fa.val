: 422, "end_line": 427, "is_async": false, "is_method": false}], "classes": [{"name": "FastBasic", "bases": [], "methods": ["__init__", "_read_header", "read", "make_table", "check_header", "write", "_write"], "docstring": "This class is intended to handle the same format addressed by the\nordinary :class:`Basic` writer, but it acts as a wrapper for underlying C\ncode and is therefore much faster. Unlike the other ASCII readers and\nwriters, this class is not very extensible and is restricted\nby optimization requirements.", "start_line": 13, "end_line": 214}, {"name": "FastCsv", "bases": ["FastBasic"], "methods": ["__init__", "write"], "docstring": "A faster version of the ordinary :class:`Csv` writer that uses the\noptimized C parsing engine. Note that this reader will append empty\nfield values to the end of any row with not enough columns, while\n:class:`FastBasic` simply raises an error.", "start_line": 217, "end_line": 238}, {"name": "FastTab", "bases": ["FastBasic"], "methods": ["__init__"], "docstring": "A faster version of the ordinary :class:`Tab` reader that uses\nthe optimized C parsing engine.", "start_line": 241, "end_line": 254}, {"name": "FastNoHeader", "bases": ["FastBasic"], "methods": ["__init__", "write"], "docstring": "This class uses the fast C engine to read tables with no header line. If\nthe names parameter is unspecified, the columns will be autonamed with\n\"col{}\".", "start_line": 257, "end_line": 276}, {"name": "FastCommentedHeader", "bases": ["FastBasic"], "methods": ["__init__", "make_table", "_read_header", "write"], "docstring": "A faster version of the :class:`CommentedHeader` reader, which looks for\ncolumn names in a commented line. ``header_start`` denotes the index of\nthe header line among all commented lines and is 0 by default.", "start_line": 279, "end_line": 339}, {"name": "FastRdb", "bases": ["FastBasic"], "methods": ["__init__", "_read_header", "write"], "docstring": "A faster version of the :class:`Rdb` reader. This format is similar to\ntab-delimited, but it also contains a header line after the column\nname line denoting the type of each column (N for numeric, S for string).", "start_line": 342, "end_line": 427}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/io/ascii/ecsv.py", "file_hash": "76021cd5a72477ce1fe2f285f814792623cf81a884ceb468c39df19871e27118", "imports": [{"module": "json", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "collections", "names": ["OrderedDict"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy.io.ascii.core", "names": ["convert_numpy"], "is_from": true, "alias": ""}, {"module": "astropy.table", "names": ["meta", "serialize"], "is_from": true, "alias": ""}, {"module": "astropy.utils.data_info", "names": ["serialize_context_as"], "is_from": true, "alias": ""}, {"module": "astropy.utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}, {"module": "", "names": ["basic", "core"], "is_from": true, "alias": ""}], "functions": [{"name": "_check_dtype_is_str", "qualified_name": "_check_dtype_is_str", "args": ["col"], "decorators": [], "docstring": "", "start_line": 233, "end_line": 235, "is_async": false, "is_method": false}, {"name": "process_lines", "qualified_name": "process_lines", "args": ["self", "lines"], "decorators": [], "docstring": "Return only non-blank lines that start with the comment regexp.  For these\nlines strip out the matching characters and leading/trailing whitespace.", "start_line": 52, "end_line": 68, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "lines"], "decorators": [], "docstring": "Write header information in the ECSV ASCII format.\n\nThis function is called at the point when preprocessing has been done to\nconvert the input table columns to `self.cols` which is a list of\n`astropy.io.ascii.core.Column` objects. In particular `col.str_vals`\nis available for each column with the st", "start_line": 70, "end_line": 108, "is_async": false, "is_method": false}, {"name": "write_comments", "qualified_name": "write_comments", "args": ["self", "lines", "meta"], "decorators": [], "docstring": "WRITE: Override the default write_comments to do nothing since this is handled\nin the custom write method.", "start_line": 110, "end_line": 115, "is_async": false, "is_method": false}, {"name": "update_meta", "qualified_name": "update_meta", "args": ["self", "lines", "meta"], "decorators": [], "docstring": "READ: Override the default update_meta to do nothing.  This process is done\nin get_cols() for this reader.", "start_line": 117, "end_line": 122, "is_async": false, "is_method": false}, {"name": "get_cols", "qualified_name": "get_cols", "args": ["self", "lines"], "decorators": [], "docstring": "READ: Initialize the header Column objects from the table ``lines``.\n\nParameters\n----------\nlines : list\n    List of table lines", "start_line": 124, "end_line": 230, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "cols", "meta"], "decorators": [], "docstring": "", "start_line": 248, "end_line": 259, "is_async": false, "is_method": false}, {"name": "_convert_vals", "qualified_name": "_convert_vals", "args": ["self", "cols"], "decorators": [], "docstring": "READ: Convert str_vals in `cols` to final arrays with correct dtypes.\n\nThis is adapted from ``BaseOutputter._convert_vals``. In the case of ECSV\nthere is no guessing and all types are known in advance. A big change\nis handling the possibility of JSON-encoded values, both unstructured\nobject data and", "start_line": 261, "end_line": 373, "is_async": false, "is_method": false}, {"name": "_set_fill_values", "qualified_name": "_set_fill_values", "args": ["self", "cols"], "decorators": [], "docstring": "READ: Set the fill values of the individual cols based on fill_values of BaseData.\n\nFor ECSV handle the corner case of data that has been serialized using\nthe serialize_method='data_mask' option, which writes the full data and\nmask directly, AND where that table includes a string column with zero-le", "start_line": 377, "end_line": 407, "is_async": false, "is_method": false}, {"name": "str_vals", "qualified_name": "str_vals", "args": ["self"], "decorators": [], "docstring": "WRITE: convert all values in table to a list of lists of strings.\n\nThis version considerably simplifies the base method:\n- No need to set fill values and column formats\n- No per-item formatting, just use repr()\n- Use JSON for object-type or multidim values\n- Only Column or MaskedColumn can end up as", "start_line": 409, "end_line": 449, "is_async": false, "is_method": false}, {"name": "update_table_data", "qualified_name": "update_table_data", "args": ["self", "table"], "decorators": [], "docstring": "Update table columns in place if mixin columns are present.\n\nThis is a hook to allow updating the table columns after name\nfiltering but before setting up to write the data.  This is currently\nonly used by ECSV and is otherwise just a pass-through.\n\nParameters\n----------\ntable : `astropy.table.Table", "start_line": 494, "end_line": 514, "is_async": false, "is_method": false}, {"name": "format_col_item", "qualified_name": "format_col_item", "args": ["idx"], "decorators": [], "docstring": "", "start_line": 422, "end_line": 428, "is_async": false, "is_method": false}, {"name": "format_col_item", "qualified_name": "format_col_item", "args": ["idx"], "decorators": [], "docstring": "", "start_line": 432, "end_line": 433, "is_async": false, "is_method": false}], "classes": [{"name": "InvalidEcsvDatatypeWarning", "bases": ["AstropyUserWarning"], "methods": [], "docstring": "ECSV specific Astropy warning class.", "start_line": 41, "end_line": 44}, {"name": "EcsvHead