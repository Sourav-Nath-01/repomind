poundModel"], "methods": ["__init__", "clear_cache", "_get_convolution", "_convolution_inputs", "_convolution_outputs", "__call__"], "docstring": "Wrapper class for a convolution model.\n\nParameters\n----------\noperator: tuple\n    The SPECIAL_OPERATORS entry for the convolution being used.\nmodel : Model\n    The model for the convolution.\nkernel: Model\n    The kernel model for the convolution.\nbounding_box : tuple\n    A bounding box to define the", "start_line": 10, "end_line": 115}], "calls": [], "module_docstring": "Convolution Model.", "parse_error": ""}, {"file_path": "astropy/modeling/models.py", "file_hash": "32650f299da513a7ce971d1541c8cce546e7d417854f9bfb9a9d8a8524b281da", "imports": [{"module": "", "names": ["math_functions"], "is_from": true, "alias": ""}, {"module": "core", "names": ["custom_model", "fix_inputs", "hide_inverse"], "is_from": true, "alias": ""}, {"module": "functional_models", "names": ["*"], "is_from": true, "alias": ""}, {"module": "mappings", "names": ["*"], "is_from": true, "alias": ""}, {"module": "physical_models", "names": ["*"], "is_from": true, "alias": ""}, {"module": "polynomial", "names": ["*"], "is_from": true, "alias": ""}, {"module": "powerlaws", "names": ["*"], "is_from": true, "alias": ""}, {"module": "projections", "names": ["*"], "is_from": true, "alias": ""}, {"module": "rotations", "names": ["*"], "is_from": true, "alias": ""}, {"module": "spline", "names": ["*"], "is_from": true, "alias": ""}, {"module": "tabular", "names": ["*"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "Creates a common namespace for all pre-defined models.", "parse_error": ""}, {"file_path": "astropy/modeling/separable.py", "file_hash": "eda0a52a913cef9eb1bf031c124784624c1f9a7f3e2cf511484ca002b7a29276", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "core", "names": ["CompoundModel", "Model", "ModelDefinitionError"], "is_from": true, "alias": ""}, {"module": "mappings", "names": ["Mapping"], "is_from": true, "alias": ""}], "functions": [{"name": "is_separable", "qualified_name": "is_separable", "args": ["transform"], "decorators": [], "docstring": "A separability test for the outputs of a transform.\n\nParameters\n----------\ntransform : `~astropy.modeling.core.Model`\n    A (compound) model.\n\nReturns\n-------\nis_separable : ndarray\n    A boolean array with size ``transform.n_outputs`` where\n    each element indicates whether the output is independe", "start_line": 26, "end_line": 62, "is_async": false, "is_method": false}, {"name": "separability_matrix", "qualified_name": "separability_matrix", "args": ["transform"], "decorators": [], "docstring": "Compute the correlation between outputs and inputs.\n\nParameters\n----------\ntransform : `~astropy.modeling.core.Model`\n    A (compound) model.\n\nReturns\n-------\nseparable_matrix : ndarray\n    A boolean correlation matrix of shape (n_outputs, n_inputs).\n    Indicates the dependence of outputs on inputs", "start_line": 65, "end_line": 100, "is_async": false, "is_method": false}, {"name": "_compute_n_outputs", "qualified_name": "_compute_n_outputs", "args": ["left", "right"], "decorators": [], "docstring": "Compute the number of outputs of two models.\n\nThe two models are the left and right model to an operation in\nthe expression tree of a compound model.\n\nParameters\n----------\nleft, right : `astropy.modeling.Model` or ndarray\n    If input is of an array, it is the output of `coord_matrix`.", "start_line": 103, "end_line": 125, "is_async": false, "is_method": false}, {"name": "_arith_oper", "qualified_name": "_arith_oper", "args": ["left", "right"], "decorators": [], "docstring": "Function corresponding to one of the arithmetic operators\n['+', '-'. '*', '/', '**'].\n\nThis always returns a nonseparable output.\n\nParameters\n----------\nleft, right : `astropy.modeling.Model` or ndarray\n    If input is of an array, it is the output of `coord_matrix`.\n\nReturns\n-------\nresult : ndarra", "start_line": 128, "end_line": 166, "is_async": false, "is_method": false}, {"name": "_coord_matrix", "qualified_name": "_coord_matrix", "args": ["model", "pos", "noutp"], "decorators": [], "docstring": "Create an array representing inputs and outputs of a simple model.\n\nThe array has a shape (noutp, model.n_inputs).\n\nParameters\n----------\nmodel : `astropy.modeling.Model`\n    model\npos : str\n    Position of this model in the expression tree.\n    One of ['left', 'right'].\nnoutp : int\n    Number of ou", "start_line": 169, "end_line": 214, "is_async": false, "is_method": false}, {"name": "_cstack", "qualified_name": "_cstack", "args": ["left", "right"], "decorators": [], "docstring": "Function corresponding to '&' operation.\n\nParameters\n----------\nleft, right : `astropy.modeling.Model` or ndarray\n    If input is of an array, it is the output of `coord_matrix`.\n\nReturns\n-------\nresult : ndarray\n    Result from this operation.", "start_line": 217, "end_line": 245, "is_async": false, "is_method": false}, {"name": "_cdot", "qualified_name": "_cdot", "args": ["left", "right"], "decorators": [], "docstring": "Function corresponding to \"|\" operation.\n\nParameters\n----------\nleft, right : `astropy.modeling.Model` or ndarray\n    If input is of an array, it is the output of `coord_matrix`.\n\nReturns\n-------\nresult : ndarray\n    Result from this operation.", "start_line": 248, "end_line": 284, "is_async": false, "is_method": false}, {"name": "_separable", "qualified_name": "_separable", "args": ["transform"], "decorators": [], "docstring": "Calculate the separability of outputs.\n\nParameters\n----------\ntransform : `astropy.modeling.Model`\n    A transform (usually a compound model).\n\nReturns :\nis_separable : ndarray of dtype np.bool\n    An array of shape (transform.n_outputs,) of boolean type\n    Each element represents the separablity o", "start_line": 287, "end_line": 310, "is_async": false, "is_method": false}, {"name": "_n_inputs_outputs", "qualified_name": "_n_inputs_outputs", "args": ["input"], "decorators": [], "docstring": "", "start_line": 146, "end_line": 152, "is_async": false, "is_method": false}, {"name": "_n_inputs_outputs", "qualified_name": "_n_inputs_outputs", "args": ["input", "position"], "decorators": [], "docstring": "Return ``n_inputs``, ``n_outputs`` for a model or coord_matrix.", "start_line": 264, "end_line": 272, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "Functions to determine if a model is separable, i.e.\nif the model outputs are independent.\n\nIt analyzes ``n_inputs``, ``n_outputs`` and the operators\nin a compound model by stepping through the transforms\nand creating a ``coord_matrix`` of shape (``n_outputs``, ``n_inputs``).\n\n\nEach modeling operator is represented by a function which\ntakes two simple models (or two ``coord_matrix`` arrays) and\nreturns an array of shape (``n_outputs``, ``n_inputs``).", "parse_error": ""}, {"file_path": "astropy/modeling/fitting.py", "file_hash": "a763b9e765b942027e6f2a84bb714ccfe85e8524f90a1ab4a4c3417f5b1bdaa0", "imports": [{"module": "abc", "names": [], "is_from": false, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "operator", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "functools", "names": ["reduce", "wraps"], "is_from": true, "alias": ""}, {"module": "importlib.metadata", "names": ["entry_points"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy.units", "names": ["Quantity"], "is_from": true, "alias": ""}, {"module": "astropy.utils.decorators", "names": ["deprecated"], "is_from": true, "alias": ""}, {"module": "astropy.utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}, {"module": "optimizers", "names": ["DEFA