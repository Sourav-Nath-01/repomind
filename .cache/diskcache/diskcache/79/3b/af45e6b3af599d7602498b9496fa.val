ethods": ["__init__", "__call__", "from_data"], "docstring": "Formatter for masked array scalars.\n\nFor use in `numpy.array2string`, wrapping the regular formatters such\nthat if a value is masked, its formatted string is replaced.\n\nTypically initialized using the ``from_data`` class method.", "start_line": 879, "end_line": 932}], "calls": [], "module_docstring": "Helpers for letting numpy functions interact with Masked arrays.\n\nThe module supplies helper routines for numpy functions that propagate\nmasks appropriately., for use in the ``__array_function__``\nimplementation of `~astropy.utils.masked.MaskedNDArray`.  They are not\nvery useful on their own, but the ones with docstrings are included in\nthe documentation so that there is a place to find out how the mask is\ninterpreted.", "parse_error": ""}, {"file_path": "astropy/utils/masked/core.py", "file_hash": "8ecb93b205bcb16e6e222fc1470a09abdc047f4ec4cb2f2804e7b0b0c9907173", "imports": [{"module": "builtins", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy.utils.compat", "names": ["NUMPY_LT_1_22"], "is_from": true, "alias": ""}, {"module": "astropy.utils.data_info", "names": ["ParentDtypeInfo"], "is_from": true, "alias": ""}, {"module": "astropy.utils.shapes", "names": ["NDArrayShapeMethods"], "is_from": true, "alias": ""}, {"module": "function_helpers", "names": ["APPLY_TO_BOTH_FUNCTIONS", "DISPATCHED_FUNCTIONS", "MASKED_SAFE_FUNCTIONS", "UNSUPPORTED_FUNCTIONS"], "is_from": true, "alias": ""}], "functions": [{"name": "_comparison_method", "qualified_name": "_comparison_method", "args": ["op"], "decorators": [], "docstring": "Create a comparison operator for MaskedNDArray.\n\nNeeded since for string dtypes the base operators bypass __array_ufunc__\nand hence return unmasked results.", "start_line": 394, "end_line": 410, "is_async": false, "is_method": false}, {"name": "__new__", "qualified_name": "__new__", "args": ["cls"], "decorators": [], "docstring": "", "start_line": 70, "end_line": 80, "is_async": false, "is_method": false}, {"name": "__init_subclass__", "qualified_name": "__init_subclass__", "args": ["cls", "base_cls", "data_cls"], "decorators": [], "docstring": "Register a Masked subclass.\n\nParameters\n----------\nbase_cls : type, optional\n    If given, it is taken to mean that ``cls`` can be used as\n    a base for masked versions of all subclasses of ``base_cls``,\n    so it is registered as such in ``_base_classes``.\ndata_cls : type, optional\n    If given, `", "start_line": 82, "end_line": 108, "is_async": false, "is_method": false}, {"name": "from_unmasked", "qualified_name": "from_unmasked", "args": ["cls", "data", "mask", "copy"], "decorators": ["classmethod"], "docstring": "Create an instance from unmasked data and a mask.", "start_line": 114, "end_line": 116, "is_async": false, "is_method": false}, {"name": "_get_masked_instance", "qualified_name": "_get_masked_instance", "args": ["cls", "data", "mask", "copy"], "decorators": ["classmethod"], "docstring": "", "start_line": 119, "end_line": 125, "is_async": false, "is_method": false}, {"name": "_get_masked_cls", "qualified_name": "_get_masked_cls", "args": ["cls", "data_cls"], "decorators": ["classmethod"], "docstring": "Get the masked wrapper for a given data class.\n\nIf the data class does not exist yet but is a subclass of any of the\nregistered base data classes, it is automatically generated\n(except we skip `~numpy.ma.MaskedArray` subclasses, since then the\nmasking mechanisms would interfere).", "start_line": 128, "end_line": 167, "is_async": false, "is_method": false}, {"name": "_get_data_and_mask", "qualified_name": "_get_data_and_mask", "args": ["cls", "data", "allow_ma_masked"], "decorators": ["classmethod"], "docstring": "Split data into unmasked and mask, if present.\n\nParameters\n----------\ndata : array-like\n    Possibly masked item, judged by whether it has a ``mask`` attribute.\n    If so, check