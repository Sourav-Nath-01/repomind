rious PicklingError until I moved this\nfunction into ", "start_line": 8, "end_line": 19, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/utils/iers/iers.py", "file_hash": "e692d89b6cb836fc341000b4852d3ae71044f58de83c4b875949fe9878ab88d5", "imports": [{"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "datetime", "names": ["datetime"], "is_from": true, "alias": ""}, {"module": "urllib.parse", "names": ["urlparse"], "is_from": true, "alias": ""}, {"module": "warnings", "names": ["warn"], "is_from": true, "alias": ""}, {"module": "erfa", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy", "names": ["config"], "is_from": true, "alias": ""}, {"module": "astropy", "names": ["units"], "is_from": true, "alias": ""}, {"module": "astropy", "names": ["utils"], "is_from": true, "alias": ""}, {"module": "astropy.table", "names": ["MaskedColumn", "QTable"], "is_from": true, "alias": ""}, {"module": "astropy.time", "names": ["Time", "TimeDelta"], "is_from": true, "alias": ""}, {"module": "astropy.utils.data", "names": ["clear_download_cache", "get_pkg_data_filename", "get_readable_fileobj", "is_url_in_cache"], "is_from": true, "alias": ""}, {"module": "astropy.utils.exceptions", "names": ["AstropyWarning"], "is_from": true, "alias": ""}, {"module": "astropy.utils.state", "names": ["ScienceState"], "is_from": true, "alias": ""}, {"module": "astropy.io.ascii", "names": ["convert_numpy"], "is_from": true, "alias": ""}], "functions": [{"name": "download_file", "qualified_name": "download_file", "args": [], "decorators": [], "docstring": "Overload astropy.utils.data.download_file within iers module to use a\ncustom (longer) wait time.  This just passes through ``*args`` and\n``**kwargs`` after temporarily setting the download_file remote timeout to\nthe local ``iers.conf.remote_timeout`` value.",