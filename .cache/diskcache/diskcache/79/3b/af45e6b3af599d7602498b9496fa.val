sses": [], "calls": [], "module_docstring": "This subpackage contains implementations of command-line scripts that are\nincluded with Astropy.\n\nThe actual scripts that are installed in bin/ are simple wrappers for these\nmodules that will run in any Python version.", "parse_error": ""}, {"file_path": "astropy/io/fits/scripts/fitsinfo.py", "file_hash": "150ed688b985727e8c1cc9cbe8bdc34bcf6cb9e4c477e50570c39931c950b997", "imports": [{"module": "argparse", "names": [], "is_from": false, "alias": ""}, {"module": "astropy.io.fits", "names": [], "is_from": false, "alias": "fits"}, {"module": "astropy", "names": ["__version__", "log"], "is_from": true, "alias": ""}], "functions": [{"name": "fitsinfo", "qualified_name": "fitsinfo", "args": ["filename"], "decorators": [], "docstring": "Print a summary of the HDUs in a FITS file.\n\nParameters\n----------\nfilename : str\n    The path to a FITS file.", "start_line": 40, "end_line": 52, "is_async": false, "is_method": false}, {"name": "main", "qualified_name": "main", "args": ["args"], "decorators": [], "docstring": "The main function called by the `fitsinfo` script.", "start_line": 55, "end_line": 73, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "``fitsinfo`` is a command-line script based on astropy.io.fits for\nprinting a summary of the HDUs in one or more FITS files(s) to the\nstandard output.\n\nExample usage of ``fitsinfo``:\n\n1. Print a summary of the HDUs in a FITS file::\n\n    $ fitsinfo filename.fits\n\n    Filename: filename.fits\n    No.    Name         Type      Cards   Dimensions   Format\n    0    PRIMARY     PrimaryHDU     138   ()\n    1    SCI         ImageHDU        61   (800, 800)   int16\n    2    SCI         ImageHDU        61   (800, 800)   int16\n    3    SCI         ImageHDU        61   (800, 800)   int16\n    4    SCI         ImageHDU        61   (800, 800)   int16\n\n2. Print a summary of HDUs of all the FITS files in the current directory::\n\n    $ fitsinfo *.fits", "parse_error": ""}, {"file_path": "astropy/io/fits/scripts/fitscheck.py", "file_hash": "3409caaa742c8846e972a93a1c0e6cb9c0b63d00d4b9d1f766179cec927f313a", "imports": [{"module": "argparse", "names": [], "is_from": false, "alias": ""}, {"module": "logging", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "astropy", "names": ["__version__"], "is_from": true, "alias": ""}, {"module": "astropy.io", "names": ["fits"], "is_from": true, "alias": ""}], "functions": [{"name": "handle_options", "qualified_name": "handle_options", "args": ["args"], "decorators": [], "docstring": "", "start_line": 66, "end_line": 147, "is_async": false, "is_method": false}, {"name": "setup_logging", "qualified_name": "setup_logging", "args": [], "decorators": [], "docstring": "", "start_line": 150, "end_line": 160, "is_async": false, "is_method": false}, {"name": "verify_checksums", "qualified_name": "verify_checksums", "args": ["filename"], "decorators": [], "docstring": "Prints a message if any HDU in `filename` has a bad checksum or datasum.", "start_line": 163, "end_line": 193, "is_async": false, "is_method": false}, {"name": "verify_compliance", "qualified_name": "verify_compliance", "args": ["filename"], "decorators": [], "docstring": "Check for FITS standard compliance.", "start_line": 196, "end_line": 204, "is_async": false, "is_method": false}, {"name": "update", "qualified_name": "update", "args": ["filename"], "decorators": [], "docstring": "Sets the ``CHECKSUM`` and ``DATASUM`` keywords for each HDU of `filename`.\n\nAlso updates fixes standards violations if possible and requested.", "start_line": 207, "end_line": 228, "is_async": false, "is_method": false}, {"name": "process_file", "qualified_name": "process_file", "args": ["filename"], "decorators": [], "docstring": "Handle a single .fits file,  returning the count of checksum and compliance\nerrors.", "start_line": 231, "end_line": 247, "is_async": false, "is_method": false}, {"name": "main", "qualified_name": "main", "args": ["args"], "decorators": [], "docstring": "Processes command line parameters into options and files,  then checks\nor update FITS DATASUM and CHECKSUM keywords for the specified files.", "start_line": 250, "end_line": 262, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "``fitscheck`` is a command line script based on astropy.io.fits for verifying\nand updating the CHECKSUM and DATASUM keywords of .fits files.  ``fitscheck``\ncan also detect and often fix other FITS standards violations.  ``fitscheck``\nfacilitates re-writing the non-standard checksums originally generated by\nastropy.io.fits with standard checksums which will interoperate with CFITSIO.\n\n``fitscheck`` will refuse to write new checksums if the checksum keywords are\nmissing or their values are bad.  Use ``--force`` to write new checksums\nregardless of whether or not they currently exist or pass.  Use\n``--ignore-missing`` to tolerate missing checksum keywords without comment.\n\nExample uses of fitscheck:\n\n1. Add checksums::\n\n    $ fitscheck --write *.fits\n\n2. Write new checksums, even if existing checksums are bad or missing::\n\n    $ fitscheck --write --force *.fits\n\n3. Verify standard checksums and FITS compliance without changing the files::\n\n    $ fitscheck --compliance *.fits\n\n4. Only check and fix compliance problems,  ignoring checksums::\n\n    $ fitscheck --checksum none --compliance --write *.fits\n\n5. Verify standard interoperable checksums::\n\n    $ fitscheck *.fits\n\n6. Delete checksum keywords::\n\n    $ fitscheck --checksum remove --write *.fits", "parse_error": ""}, {"file_path": "astropy/io/fits/scripts/fitsheader.py", "file_hash": "c535999e4859c942daf1df548e24e5d6a87104f6059fb2ba2568f6bae68338a6", "imports": [{"module": "argparse", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy", "names": ["__version__", "log"], "is_from": true, "alias": ""}, {"module": "astropy.io", "names": ["fits"], "is_from": true, "alias": ""}, {"module": "astropy", "names": ["table"], "is_from": true, "alias": ""}, {"module": "astropy", "names": ["table"], "is_from": true, "alias": ""}, {"module": "astropy", "names": ["table"], "is_from": true, "alias": ""}], "functions": [{"name": "print_headers_traditional", "qualified_name": "print_headers_traditional", "args": ["args"], "decorators": [], "docstring": "Prints FITS header(s) using the traditional 80-char format.\n\nParameters\n----------\nargs : argparse.Namespace\n    Arguments passed from the command-line as defined below.", "start_line": 271, "end_line": 293, "is_async": false, "is_method": false}, {"name": "print_headers_as_table", "qualified_name": "print_headers_as_table", "args": ["args"], "decorators": [], "docstring": "Prints FITS header(s) in a machine-readable table format.\n\nParameters\n----------\nargs : argparse.Namespace\n    Arguments passed from the command-line as defined below.", "start_line": 296, "end_line": 329, "is_async": false, "is_method": false}, {"name": "print_headers_as_comparison", "qualified_name": "print_headers_as_comparison", "args": ["args"], "decorators": [], "docstring": "Prints FITS header(s) with keywords as columns.\n\nThis follows the dfits+fitsort format.\n\nParameters\n----------\nargs : argparse.Namespace\n    Arguments passed from the command-line as defined below.", "start_line": 332, "end_line": 400, "is_async": false, "is_method": false}, {"name": "main", "qualified_name": "main", "args": ["args"], "decorators": [], "docstring": "This is the main function called by the `fitsheader` script.", "start_line": 403, "end_line": 513, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "filename", "verbose"], "decorators": [], "docstring": "", "start_line": 112, "end_line": 115, "is_async": false, "is_method": false}, {"name": "parse", "qualified_name": "parse", "args": ["self", "extensions", "keywords", "compressed"], "decorators": [], "docstring": "Returns the FITS file header(s) in a readable format.\n\nParameters\n----------\nextensions : list of int or str, optional\n    Format only specific HDU(s), identified by number or name.\n    The name can be composed of the \"EXTNAME\" or \"EXTNAME,EXTVER\"\n    keywords.\n\nkeywords : list of str, optional\n    ", "start_line": 117, "end_line": 162, "is_async": false, "is_method": false}, {"name": "_parse_internal", "qualified_name": "_parse_internal", "args": ["self", "hdukeys", "keywords", "compressed"], "decorators": [], "docstring": "The meat of the formatting; in a separate method to allow overriding.", "start_line": 164, "end_line": 178, "is_async": false, "is_method": false}, {"name": "_get_cards", "qualified_name": "_get_cards", "args": ["self", "hdukey", "keywords", "compressed"], "decorators": [], "docstring": "Returns a list of `astropy.io.fits.card.Card` objects.\n\nThis function will return the desired header cards, taking into\naccount the user's preference to see the compressed or uncompressed\nversion.\n\nParameters\n----------\nhdukey : int or str\n    Key of a single HDU in the HDUList.\n\nkeywords : list of ", "start_line": 180, "end_line": 233, "is_async": false, "is_method": false}, {"name": "close", "qualified_name": "close", "args": ["self"], "decorators": [], "docstring": "", "start_line": 235, "end_line": 236, "is_async": false, "is_method": false}, {"name": "_parse_internal", "qualified_name": "_parse_internal", "args": ["self", "hdukeys", "keywords", "compressed"], "decorators": [], "docstring": "Method called by the parse method in the parent class.", "start_line": 247, "end_line": 268, "is_async": false, "is_method": false}], "classes": [{"name": "ExtensionNotFoundException", "bases": ["Exception"], "methods": [], "docstring": "Raised if an HDU extension requested by the user does not exist.", "start_line": 84, "end_line": 87}, {"name": "HeaderFormatter", "bases": [], "methods": ["__init__", "parse", "_parse_internal", "_get_cards", "close"], "docstring": "Class to format the header(s) of a FITS file for display by the\n`fitsheader` tool; essentially a wrapper around a `HDUList` object.\n\nExample usage:\nfmt = HeaderFormatter('/path/to/file.fits')\nprint(fmt.parse(extensions=[0, 3], keywords=['NAXIS', 'BITPIX']))\n\nParameters\n----------\nfilename : str\n    ", "start_line": 90, "end_line": 236}, {"name": "TableHeaderFormatter", "bases": ["HeaderFormatter"], "methods": ["_parse_internal"], "docstring": "Class to convert the header(s) of a FITS file into a Table object.\nThe table returned by the `parse` method will contain four columns:\nfilename, hdu, keyword, and value.\n\nSubclassed from HeaderFormatter, which contains the meat of the formatting.", "start_line": 239, "end_line": 268}], "calls": [], "module_docstring": "``fitsheader`` is a command line script based on astropy.io.fits for printing\nthe header(s) of one or more FITS file(s) to the standard output in a human-\nreadable format.\n\nExample uses of fitsheader:\n\n1. Print the header of all the HDUs of a .fits file::\n\n    $ fitsheader filename.fits\n\n2. Print the header of the third and fifth HDU extension::\n\n    $ fitsheader --extension 3 --extension 5 filename.fits\n\n3. Print the header of a named extension, e.g. select the HDU containing\n   keywords EXTNAME='SCI' and EXTVER='2'::\n\n    $ fitsheader --extension \"SCI,2\" filename.fits\n\n4. Print only specific keywords::\n\n    $ fitsheader --keyword BITPIX --keyword NAXIS filename.fits\n\n5. Print keywords NAXIS, NAXIS1, NAXIS2, etc using a wildcard::\n\n    $ fitsheader --keyword NAXIS* filename.fits\n\n6. Dump the header keywords of all the files in the current directory into a\n   machine-readable csv file::\n\n    $ fitsheader --table ascii.csv *.fits > keywords.csv\n\n7. Specify hierarchical keywords with the dotted or spaced notation::\n\n    $ fitsheader --keyword ESO.INS.ID filename.fits\n    $ fitsheader --keyword \"ESO INS ID\" filename.fits\n\n8. Compare the headers of different fits files, following ESO's ``fitsort``\n   format::\n\n    $ fitsheader --fitsort --extension 0 --keyword ESO.INS.ID *.fits\n\n9. Same as above, sorting the output along a specified keyword::\n\n    $ fitsheader -f -s DATE-OBS -e 0 -k DATE-OBS -k ESO.INS.ID *.fits\n\n10. Sort first by OBJECT, then DATE-OBS::\n\n    $ fitsheader -f -s OBJECT -s DATE-OBS *.fits\n\nNote that compressed images (HDUs of type\n:class:`~astropy.io.fits.CompImageHDU`) really have two headers: a real\nBINTABLE header to describe the compressed data, and a fake IMAGE header\nrepresenting the image that was compressed. Astropy returns the latter by\ndefault. You must supply the ``--compressed`` option if you require the real\nheader that describes the compression.\n\nWith Astropy installed, please run ``fitsheader --help`` to see the full usage\ndocumentation.", "parse_error": ""}, {"file_path": "astropy/io/fits/_tiled_compression/tests/__init__.py", "file_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/io/fits/_tiled_compression/tests/conftest.py", "file_hash": "5556e48619710d94583c10882ced2cefcd1fe7c603f24ed99d31337cc6cd996e", "imports": [{"module": "itertools", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "pytest", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "fitsio_param_to_astropy_param", "qualified_name": "fitsio_param_to_astropy_param", "args": ["param"], "decorators": [], "docstring": "", "start_line": 16, "end_line": 25, "is_async":