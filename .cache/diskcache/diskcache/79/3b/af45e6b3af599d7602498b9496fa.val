ion.", "start_line": 277, "end_line": 296, "is_async": false, "is_method": false}, {"name": "quantity_asanyarray", "qualified_name": "quantity_asanyarray", "args": ["a", "dtype"], "decorators": [], "docstring": "", "start_line": 299, "end_line": 311, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "Miscellaneous utilities for `astropy.units`.\n\nNone of the functions in the module are meant for use outside of the\npackage.", "parse_error": ""}, {"file_path": "astropy/units/physical.py", "file_hash": "c11209465d4aa2dfe16b92cda20cee9f0b4513bf025e3c4388ee842b8a04ebf0", "imports": [{"module": "numbers", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "astropy.utils.exceptions", "names": ["AstropyDeprecationWarning"], "is_from": true, "alias": ""}, {"module": "", "names": ["imperial"], "is_from": true, "alias": ""}, {"module": "", "names": ["astrophys", "cgs", "core", "misc", "quantity", "si"], "is_from": true, "alias": ""}], "functions": [{"name": "_physical_type_from_str", "qualified_name": "_physical_type_from_str", "args": ["name"], "decorators": [], "docstring": "Return the `PhysicalType` instance associated with the name of a\nphysical type.", "start_line": 134, "end_line": 147, "is_async": false, "is_method": false}, {"name": "_replace_temperatures_with_kelvin", "qualified_name": "_replace_temperatures_with_kelvin", "args": ["unit"], "decorators": [], "docstring": "If a unit contains a temperature unit besides kelvin, then replace\nthat unit with kelvin.\n\nTemperatures cannot be converted directly between K, \u00b0F, \u00b0C, and\n\u00b0Ra, in particular since there would be different conversions for\nT and \u0394T.  However, each of these temperatures each represents the\nphysical ty", "start_line": 150, "end_line": 175, "is_async": false, "is_method": false}, {"name": "_standardize_physical_type_names", "qualified_name": "_standardize_physical_type_names", "args": ["physical_type_input"], "decorators": [], "docstring": "Convert a string or `set` of strings into a `set` containing\nstring representations of physical types.\n\nThe strings provided in ``physical_type_input`` can each contain\nmultiple physical types that are separated by a regular slash.\nUnderscores are treated as spaces so that variable names could\nbe id", "start_line": 178, "end_line": 200, "is_async": false, "is_method": false}, {"name": "def_physical_type", "qualified_name": "def_physical_type", "args": ["unit", "name"], "decorators": [], "docstring": "Add a mapping between a unit and the corresponding physical type(s).\n\nIf a physical type already exists for a unit, add new physical type\nnames so long as those names are not already in use for other\nphysical types.\n\nParameters\n----------\nunit : `~astropy.units.Unit`\n    The unit to be represented b", "start_line": 432, "end_line": 492, "is_async": false, "is_method": false}, {"name": "get_physical_type", "qualified_name": "get_physical_type", "args": ["obj"], "decorators": [], "docstring": "Return the physical type that corresponds to a unit (or another\nphysical type representation).\n\nParameters\n----------\nobj : quantity-like or `~astropy.units.PhysicalType`-like\n    An object that (implicitly or explicitly) has a corresponding\n    physical type. This object may be a unit, a\n    `~astr", "start_line": 495, "end_line": 563, "is_async": false, "is_method": false}, {"name": "__getattr__", "qualified_name": "__getattr__", "args": ["name"], "decorators": [], "docstring": "Checks for physical types using lazy import.\n\nThis also allows user-defined physical types to be accessible from the\n:mod:`astropy.units.physical` module.\nSee `PEP 562 <https://www.python.org/dev/peps/pep-0562/>`_\n\nParameters\n----------\nname : str\n    The name of the attribute in this module. If it ", "start_line": 575, "end_line": 600, "is_async": false, "is_method": false}, {"name": "__dir__", "qua