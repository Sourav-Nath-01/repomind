erty", "bases": [], "methods": ["description", "description", "description"], "docstring": "", "start_line": 467, "end_line": 482}, {"name": "Element", "bases": [], "methods": ["_add_unknown_tag", "_ignore_add", "_add_definitions", "parse", "to_xml"], "docstring": "A base class for all classes that represent XML elements in the\nVOTABLE file.", "start_line": 487, "end_line": 540}, {"name": "SimpleElement", "bases": ["Element"], "methods": ["__init__", "__repr__", "parse", "to_xml"], "docstring": "A base class for simple elements, such as FIELD, PARAM and INFO\nthat don't require any special parsing or outputting machinery.", "start_line": 543, "end_line": 567}, {"name": "SimpleElementWithContent", "bases": ["SimpleElement"], "methods": ["__init__", "parse", "to_xml", "content", "content", "content"], "docstring": "A base class for simple elements, such as FIELD, PARAM and INFO\nthat don't require any special parsing or outputting machinery.", "start_line": 570, "end_line": 611}, {"name": "Link", "bases": ["SimpleElement", "_IDProperty"], "methods": ["__init__", "content_role", "content_role", "content_role", "content_type", "content_type", "content_type", "href", "href", "href", "to_table_column", "from_table_column"], "docstring": "LINK_ elements: used to reference external documents and servers through a URI.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.", "start_line": 614, "end_line": 739}, {"name": "Info", "bases": ["SimpleElementWithContent", "_IDProperty", "_XtypeProperty", "_UtypeProperty"], "methods": ["__init__", "name", "name", "value", "value", "content", "content", "content", "ref", "ref", "ref", "unit", "unit", "unit", "to_xml"], "docstring": "INFO_ elements: arbitrary key-value pairs for extensions to the standard.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.", "start_line": 742, "end_line": 915}, {"name": "Values", "bases": ["Element", "_IDProperty"], "methods": ["__init__", "__repr__", "null", "null", "null", "type", "type", "ref", "ref", "ref", "min", "min", "min", "min_inclusive", "min_inclusive", "min_inclusive", "max", "max", "max", "max_inclusive", "max_inclusive", "max_inclusive", "options", "parse", "is_defaults", "to_xml", "to_table_column", "from_table_column"], "docstring": "VALUES_ element: used within FIELD_ and PARAM_ elements to define the domain of values.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.", "start_line": 918, "end_line": 1243}, {"name": "Field", "bases": ["SimpleElement", "_IDProperty", "_NameProperty", "_XtypeProperty", "_UtypeProperty", "_UcdProperty"], "methods": ["__init__", "uniqify_names", "_setup", "datatype", "datatype", "precision", "precision", "precision", "width", "width", "width", "ref", "ref", "ref", "unit", "unit", "unit", "arraysize", "arraysize", "arraysize", "type", "type", "type", "values", "values", "values", "links", "parse", "to_xml", "to_table_column", "from_table_column"], "docstring": "FIELD_ element: describes the datatype of a particular column of data.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.\n\nIf *ID* is provided, it is used for the column name in the\nresulting recarray of the table.  If no *ID* is provided, *name*\nis used instead", "start_line": 1246, "end_line": 1720}, {"name": "Param", "bases": ["Field"], "methods": ["__init__", "value", "value", "_setup", "to_xml"], "docstring": "PARAM_ element: constant-valued columns in the data.\n\n:class:`Param` objects are a subclass of :class:`Field`, and have\nall of its methods and members.  Additionally, it defines :attr:`value`.", "start_line": 1723, "end_line": 1801}, {"name": "CooSys", "bases": ["SimpleElement"], "methods": ["__init__", "ID", "ID", "system", "system", "system", "equinox", "equinox", "equinox", "epoch", "epoch", "epoch"], "docstring": "COOSYS_ element: defines a coordinate system.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.", "start_line": 1804, "end_line": 1928}, {"name": "TimeSys", "bases": ["SimpleElement"], "methods": ["__init__", "ID", "ID", "timeorigin", "timeorigin", "timeorigin", "timescale", "timescale", "timescale", "refposition", "refposition", "refposition"], "docstring": "TIMESYS_ element: defines a time system.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.", "start_line": 1931, "end_line": 2062}, {"name": "FieldRef", "bases": ["SimpleElement", "_UtypeProperty", "_UcdProperty"], "methods": ["__init__", "ref", "ref", "ref", "get_ref"], "docstring": "FIELDref_ element: used inside of GROUP_ elements to refer to remote FIELD_ elements.", "start_line": 2065, "end_line": 2128}, {"name": "ParamRef", "bases": ["SimpleElement", "_UtypeProperty", "_UcdProperty"], "methods": ["__init__", "ref", "ref", "ref", "get_ref"], "docstring": "PARAMref_ element: used inside of GROUP_ elements to refer to remote PARAM_ elements.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.\n\nIt contains the following publicly-accessible members:\n\n  *ref*: An XML ID referring to a <PARAM> element.", "start_line": 2131, "end_line": 2193}, {"name": "Group", "bases": ["Element", "_IDProperty", "_NameProperty", "_UtypeProperty", "_UcdProperty", "_DescriptionProperty"], "methods": ["__init__", "__repr__", "ref", "ref", "ref", "entries", "_add_fieldref", "_add_paramref", "_add_param", "_add_group", "parse", "to_xml", "iter_fields_and_params", "iter_groups"], "docstring": "GROUP_ element: groups FIELD_ and PARAM_ elements.\n\nThis information is currently ignored by the vo package---that is\nthe columns in the recarray are always flat---but the grouping\ninformation is stored so that it can be written out again to the\nXML file.\n\nThe keyword arguments correspond to setting", "start_line": 2196, "end_line": 2350}, {"name": "Table", "bases": ["Element", "_IDProperty", "_NameProperty", "_UcdProperty", "_DescriptionProperty"], "methods": ["__init__", "__repr__", "__bytes__", "__str__", "ref", "ref", "ref", "format", "format", "nrows", "fields", "params", "groups", "links", "infos", "is_empty", "create_arrays", "_resize_strategy", "_add_field", "_add_param", "_add_group", "_add_link", "_add_info", "parse", "_parse_tabledata", "_get_binary_data_stream", "_parse_binary", "_parse_fits", "to_xml", "_write_tabledata", "_write_binary", "to_table", "from_table", "iter_fields_and_params", "iter_groups", "iter_info"], "docstring": "TABLE_ element: optionally contains data.\n\nIt contains the following publicly-accessible and mutable\nattribute:\n\n    *array*: A Numpy masked array of the data itself, where each\n    row is a row of votable data, and columns are named and typed\n    based on the <FIELD> elements of the table.  The mas", "start_line": 2353, "end_line": 3375}, {"name": "Resource", "bases": ["Element", "_IDProperty", "_NameProperty", "_UtypeProperty", "_DescriptionProperty"], "methods": ["__init__", "__repr__", "type", "type", "extra_attributes", "coordinate_systems", "time_systems", "infos", "groups", "params", "links", "tables", "resources", "_add_table", "_add_info", "_add_group", "_add_param", "_add_coosys", "_add_timesys", "_add_resource", "_add_link", "parse", "to_xml", "iter_tables", "iter_fields_and_params", "iter_coosys", "iter_timesys", "iter_info"], "docstring": "RESOURCE_ element: Groups TABLE_ and RESOURCE_ elements.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.", "start_line": 3378, "end_line": 3660}, {"name": "VOTableFile", "bases": ["Element", "_IDProperty", "_DescriptionProperty"], "methods": ["__init__", "__repr__", "version", "version", "coordinate_systems", "time_systems", "params", "infos", "resources", "groups", "_add_param", "_add_resource", "_add_coosys", "_add_timesys", "_add_info", "_add_group", "_get_version_checks", "parse", "to_xml", "iter_tables", "get_first_table", "get_table_by_index", "iter_fields_and_params", "iter_values", "iter_groups", "iter_coosys", "iter_timesys", "iter_info", "set_all_tables_format", "from_table"], "docstring": "VOTABLE_ element: represents an entire file.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.\n\n*version* is settable at construction time only, since conformance\ntests for building the rest of the structure depend on it.", "start_line": 3663, "end_line": 4215}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/io/votable/util.py", "file_hash": "159d67c0728a1d409a77b3a81d85d111e6270be8b088b040b7c6a255adc5eee8", "imports": [{"module": "codecs", "names": [], "is_from": false, "alias": ""}, {"module": "contextlib", "names": [], "is_from": false, "alias": ""}, {"module": "gzip", "names": [], "is_from": false, "alias": ""}, {"module": "io", "names": [], "is_from": false, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "packaging.version", "names": ["Version"], "is_from": true, "alias": ""}], "functions": [{"name": "convert_to_writable_filelike", "qualified_name": "convert_to_writable_filelike", "args": ["fd", "compressed"], "decorators": ["contextlib.contextmanager"], "docstring": "Returns a writable file-like object suitable for streaming output.\n\nParameters\n----------\nfd : str or file-like\n    May be:\n\n        - a file path string, in which case it is opened, and the file\n          object is returned.\n\n        - an object with a :meth:``write`` method, in which case that\n   ", "start_line": 25, "end_line": 86, "is_async": false, "is_method": false}, {"name": "coerce_range_list_param", "qualified_name": "coerce_range_list_param", "args": ["p", "frames", "numeric"], "decorators": [], "docstring": "Coerces and/or verifies the object *p* into a valid range-list-format parameter.\n\nAs defined in `Section 8.7.2 of Simple\nSpectral Access Protocol\n<http://www.ivoa.net/documents/REC/DAL/SSA-20080201.html>`_.\n\nParameters\n----------\np : str or sequence\n    May be a string as passed verbatim to the serv", "start_line": 137, "end_line": 236, "is_async": false, "is_method": false}, {"name": "version_compare", "qualified_name": "version_compare", "args": ["a", "b"], "decorators": [], "docstring": "Compare two VOTable version identifiers.", "start_line": 239, "end_line": 252, "is_async": false, "is_method": false}, {"name": "str_or_none", "qualified_name": "str_or_none", "args": ["x"], "decorators": [], "docstring": "", "start_line": 180, "end_line": 185, "is_async": false, "is_method": false}, {"name": "numeric_or_range", "qualified_name": "numeric_or_range", "args": ["x"], "decorators": [], "docstring": "", "start_line": 187, "end_line": 191, "is_async": false, "is_method": false}, {"name": "is_frame_of_reference", "qualified_name": "is_frame_of_reference", "args": ["x"], "decorators": [], "docstring": "", "start_line": 193, "end_line": 194, "is_async": false, "is_method": false}, {"name": "version_to_tuple", "qualified_name": "version_to_tuple", "args": ["v"], "decorators": [], "docstring": "", "start_line": 244, "end_line": 247, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "Various utilities and cookbook-like things.", "parse_error": ""}, {"file_path": "astropy/io/votable/exceptions.py", "file_hash": "853c004f372f1cc7f2d06428bec4bdf83ef39b33bdbe0fc31936350ca896743f", "imports": [{"module": "io", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "textwrap", "names": ["dedent"], "is_from": true, "alias": ""}, {"module": "warnings", "names": ["warn"], "is_from": true, "alias": ""}, {"module": "astropy", "names": ["config"], "is_from": true, "alias": ""}, {"module": "astropy.utils.exceptions", "names": ["AstropyWarning"], "is_from": true, "alias": ""}], "functions": [{"name": "_format_message", "qualified_name": "_format_message", "args": ["message", "name", "config", "pos"], "decorators": [], "docstring": "", "start_line": 76, "end_line": 82, "is_async": false, "is_method": false}, {"name": "_suppressed_warning", "qualified_name": "_suppressed_warning", "args": ["warning", "config", "stacklevel"], "decorators": [], "docstring": "", "start_line": 85, "end_line": 95, "is_async": false, "is_method": false}, {"name": "warn_or_raise", "qualified_name": "warn_or_raise", "args": ["warning_class", "exception_class", "args", "config", "pos", "stacklevel"], "decorators": [], "docstring": "Warn or raise an exception, depending on the verify setting.", "start_line": 98, "end_line": 115, "is_async": false, "is_method": false}, {"name": "vo_raise", "qualified_name": "vo_raise", "args": ["exception_class", "args", "config", "pos"], "decorators": [], "docstring": "Raise an exception, with proper position information if available.", "start_line": 118, "end_line": 124, "is_async": false, "is_method": false}, {"name": "vo_reraise", "qualified_name": "vo_reraise", "args": ["exc", "config", "pos", "additional"], "decorators": [], "docstring": "Raise an exception, with proper position information if available.\n\nRestores the original traceback of the exception, and should only\nbe called within an \"except:\" block of code.", "start_line": 127, "end_line": 142, "is_async": false, "is_method": false}, {"name": "vo_warn", "qualified_name": "vo_warn", "args": ["warning_class", "args", "config", "pos", "stacklevel"], "decorators": [], "docstring": "Warn, with proper position information if available.", "start_line": 145, "end_line": 156, "is_async": false, "is_method": false}, {"name": "warn_unknown_attrs", "qualified_name": "warn_unknown_attrs", "args": ["element", "attrs", "config", "pos", "good_attr", "stacklevel"], "decorators": [], "docstring": "", "start_line": 159, "end_line": 162, "is_async": false, "is_method": false}, {"name": "parse_vowarning", "qualified_name": "parse_vowarning", "args": ["line"], "decorators": [], "docstring": "Parses the vo warning string back into its parts.", "start_line": 171, "end_line": 210, "is_async": false, "is_method": false}, {"name": "_get_warning_and_exception_classes", "qualified_name": "_get_warning_and_exception_classes", "args": ["prefix"], "decorators": [], "docstring": "", "start_line": 1527, "end_line": 1533, "is_async": false, "is_method": false}, {"name": "_build_doc_string", "qualified_name": "_build_doc_string", "args": [], "decorators": [], "docstring": "", "start_line": 1536, "end_line": 1562, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "args", "config", "pos"], "decorators": [], "docstring": "", "start_line": 224, "end_line": 234, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 236, "end_line": 237, "is_async": false, "is_method": false}, {"name": "get_short_name", "qualified_name": "get_short_name", "args": ["cls"], "decorators": ["classmethod"], "docstring": "", "start_line": 240, "end_line": 243, "is_async": false, "is_method": false}, {"name": "generate_set", "qualified_name": "generate_set", "args": ["prefix"], "decorators": [], "docstring": "", "start_line": 1537, "end_line": 1557, "is_async": false, "is_method": false}], "classes": [{"name": "Conf", "bases": ["_config.ConfigNamespace"], "methods": [], "docstring": "Configuration parameters for `astropy.io.votable.exceptions`.", "start_line": 61, "end_line": 70}, {"name": "VOWarning", "bases": ["AstropyWarning"], "methods": ["__init__", "__str__", "get_short_name"], "docstring": "The base class of all VO warnings and exceptions.\n\nHandles the formatting of the message with a warning or exception\ncode, filename, line and column number.", "start_line": 213, "end_line": 243}, {"name": "VOTableChangeWarning", "bases": ["VOWarning", "SyntaxWarning"], "methods": [], "docstring": "A change has been made to the input XML file.", "start_line": 246, "end_line": 249}, {"name": "VOTableSpecWarning", "bases": ["VOWarning", "SyntaxWarning"], "methods": [], "docstring": "The input XML file violates the spec, but there is an obvious workaround.", "start_line": 252, "end_line": 255}, {"name": "UnimplementedWarning", "bases": ["VOWarning", "SyntaxWarning"], "methods": [], "docstring": "A feature of the VOTABLE_ spec is not implemented.", "start_line": 258, "end_line": 261}, {"name": "IOWarning", "bases": ["VOWarning", "RuntimeWarning"], "methods": [], "docstring": "A network or IO error occurred, but was recovered using the cache.", "start_line": 264, "end_line": 267}, {"name": "VOTableSpecError", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The input XML file violates the spec and there is no good workaround.", "start_line": 270, "end_line": 273}, {"name": "W01", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Array uses commas rather than whitespace.\n\nThe VOTable spec states:\n\n    If a cell contains an array or complex number, it should be\n    encoded as multiple numbers separated by whitespace.\n\nMany VOTable files in the wild use commas as a separator instead,\nand ``astropy.io.votable`` can support this", "start_line": 276, "end_line": 297}, {"name": "W02", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Nonstandard XML id.\n\nXML ids must match the following regular expression::\n\n    ^[A-Za-z_][A-Za-z0-9_\\.\\-]*$\n\nThe VOTable 1.1 says the following:\n\n    According to the XML standard, the attribute ``ID`` is a\n    string beginning with a letter or underscore (``_``), followed\n    by a sequence of lett", "start_line": 300, "end_line": 327}, {"name": "W03", "bases": ["VOTableChangeWarning"], "methods": [], "docstring": "Implicitly generating an ID from a name.\n\nThe VOTable 1.1 spec says the following about ``name`` vs. ``ID``\non ``FIELD`` and ``VALUE`` elements:\n\n    ``ID`` and ``name`` attributes have a different role in\n    VOTable: the ``ID`` is meant as a *unique identifier* of an\n    element seen as a VOTable ", "start_line": 330, "end_line": 381}, {"name": "W04", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The ``content-type`` attribute must use MIME content-type syntax as\ndefined in `RFC 2046 <https://tools.ietf.org/html/rfc2046>`__.\n\nThe current check for validity is somewhat over-permissive.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:link", "start_line": 384, "end_line": 398}, {"name": "W05", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The attribute must be a valid URI as defined in `RFC 2396\n<https://www.ietf.org/rfc/rfc2396.txt>`_.", "start_line": 401, "end_line": 408}, {"name": "W06", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "This warning is emitted when a ``ucd`` attribute does not match\nthe syntax of a `unified content descriptor\n<https://vizier.unistra.fr/doc/UCD.htx>`__.\n\nIf the VOTable version is 1.2 or later, the UCD will also be\nchecked to ensure it conforms to the controlled vocabulary defined\nby UCD1+.\n\n**Refere", "start_line": 411, "end_line": 428}, {"name": "W07", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Invalid astroYear.\n\nAs astro year field is a Besselian or Julian year matching the\nregular expression::\n\n    ^[JB]?[0-9]+([.][0-9]*)?$\n\nDefined in this XML Schema snippet::\n\n    <xs:simpleType  name=\"astroYear\">\n      <xs:restriction base=\"xs:token\">\n        <xs:pattern  value=\"[JB]?[0-9]+([.][0-9]*", "start_line": 431, "end_line": 449}, {"name": "W08", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "To avoid local-dependent number parsing differences, ``astropy.io.votable``\nmay require a string or unicode string where a numeric type may\nmake more sense.", "start_line": 452, "end_line": 461}, {"name": "W09", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The VOTable specification uses the attribute name ``ID`` (with\nuppercase letters) to specify unique identifiers.  Some\nVOTable-producing tools use the more standard lowercase ``id``\ninstead. ``astropy.io.votable`` accepts ``id`` and emits this warning if\n``verify`` is ``'warn'``.\n\n**References**: `1", "start_line": 464, "end_line": 478}, {"name": "W10", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The parser has encountered an element that does not exist in the\nspecification, or appears in an invalid context.  Check the file\nagainst the VOTable schema (with a tool such as `xmllint\n<http://xmlsoft.org/xmllint.html>`__.  If the file validates\nagainst the schema, and you still receive this warni", "start_line": 481, "end_line": 497}, {"name": "W11", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Earlier versions of the VOTable specification used a ``gref``\nattribute on the ``LINK`` element to specify a `GLU reference\n<http://aladin.unistra.fr/glu/>`__.  New files should\nspecify a ``glu:`` protocol using the ``href`` attribute.\n\nSince ``astropy.io.votable`` does not currently support GLU ref", "start_line": 500, "end_line": 517}, {"name": "W12", "bases": ["VOTableChangeWarning"], "methods": [], "docstring": "In order to name the columns of the Numpy record array, each\n``FIELD`` element must have either an ``ID`` or ``name`` attribute\nto derive a name from.  Strictly speaking, according to the\nVOTable schema, the ``name`` attribute is required.  However, if\n``name`` is not present by ``ID`` is, and ``ver", "start_line": 520, "end_line": 538}, {"name": "W13", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Invalid VOTable datatype.\n\nSome VOTable files in the wild use non-standard datatype names.  These\nare mapped to standard ones using the following mapping::\n\n   string        -> char\n   unicodeString -> unicodeChar\n   int16         -> short\n   int32         -> int\n   int64         -> long\n   float32 ", "start_line": 541, "end_line": 567}, {"name": "W15", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The ``name`` attribute is required on every ``FIELD`` element.\nHowever, many VOTable files in the wild omit it and provide only\nan ``ID`` instead.  In this case, when ``verify`` is not ``'exception'``\n``astropy.io.votable`` will copy the ``name`` attribute to a new ``ID``\nattribute.\n\n**References**:", "start_line": 573, "end_line": 588}, {"name": "W17", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "A ``DESCRIPTION`` element can only appear once within its parent\nelement.\n\nAccording to the schema, it may only occur once (`1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#ToC54>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#ToC58>`_", "start_line": 594, "end_line": 610}, {"name": "W18", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The number of rows explicitly specified in the ``nrows`` attribute\ndoes not match the actual number of rows (``TR`` elements) present\nin the ``TABLE``.  This may indicate truncation of the file, or an\ninternal error in the tool that produced it.  If ``verify`` is not\n``'exception'``, parsing will pr", "start_line": 613, "end_line": 628}, {"name": "W19", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The column fields as defined using ``FIELD`` elements do not match\nthose in the headers of the embedded FITS file.  If ``verify`` is not\n``'exception'``, the embedded FITS file will take precedence.", "start_line": 631, "end_line": 641}, {"name": "W20", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "If no version number is explicitly given in the VOTable file, the\nparser assumes it is written to the VOTable 1.1 specification.", "start_line": 644, "end_line": 651}, {"name": "W21", "bases": ["UnimplementedWarning"], "methods": [], "docstring": "Unknown issues may arise using ``astropy.io.votable`` with VOTable files\nfrom a version other than 1.1, 1.2, 1.3, or 1.4.", "start_line": 654, "end_line": 664}, {"name": "W22", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Version 1.0 of the VOTable specification used the ``DEFINITIONS``\nelement to define coordinate systems.  Version 1.1 now uses\n``COOSYS`` elements throughout the document.\n\n**References:** `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:definitions>`__,\n`1.2\n<ht", "start_line": 667, "end_line": 679}, {"name": "W23", "bases": ["IOWarning"], "methods": [], "docstring": "Raised when the VO service database can not be updated (possibly\ndue to a network outage).  This is only a warning, since an older\nand possible out-of-date VO service database was available\nlocally.", "start_line": 682, "end_line": 691}, {"name": "W24", "bases": ["VOWarning", "FutureWarning"], "methods": [], "docstring": "The VO catalog database retrieved from the www is designed for a\nnewer version of ``astropy.io.votable``.  This may cause problems or limited\nfeatures performing service queries.  Consider upgrading ``astropy.io.votable``\nto the latest version.", "start_line": 694, "end_line": 704}, {"name": "W25", "bases": ["IOWarning"], "methods": [], "docstring": "A VO service query failed due to a network error or malformed\narguments.  Another alternative service may be attempted.  If all\nservices fail, an exception will be raised.", "start_line": 707, "end_line": 715}, {"name": "W26", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The given element was not supported inside of the given element\nuntil the specified VOTable version, however the version declared\nin the file is for an earlier version.  These attributes may not\nbe written out to the file.", "start_line": 718, "end_line": 727}, {"name": "W27", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The ``COOSYS`` element was deprecated in VOTABLE version 1.2 in\nfavor of a reference to the Space-Time Coordinate (STC) data\nmodel (see `utype\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#sec:utype>`__\nand the IVOA note `referencing STC in VOTable\n<http://ivoa.net/Documents/l", "start_line": 730, "end_line": 740}, {"name": "W28", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The given attribute was not supported on the given element until the\nspecified VOTable version, however the version declared in the file is\nfor an earlier version.  These attributes may not be written out to\nthe file.", "start_line": 743, "end_line": 752}, {"name": "W29", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Some VOTable files specify their version number in the form \"v1.0\",\nwhen the only supported forms in the spec are \"1.0\".\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#ToC54>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2", "start_line": 755, "end_line": 767}, {"name": "W30", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Some VOTable files write missing floating-point values in non-standard ways,\nsuch as \"null\" and \"-\".  If ``verify`` is not ``'exception'``, any\nnon-standard floating-point literals are treated as missing values.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20", "start_line": 770, "end_line": 783}, {"name": "W31", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Since NaN's can not be represented in integer fields directly, a null\nvalue must be specified in the FIELD descriptor to support reading\nNaN's from the tabledata.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:datatypes>`__,\n`1.2\n<http://www.i", "start_line": 786, "end_line": 798}, {"name": "W32", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Each field in a table must have a unique ID.  If two or more fields\nhave the same ID, some will be renamed to ensure that all IDs are\nunique.\n\nFrom the VOTable 1.2 spec:\n\n    The ``ID`` and ``ref`` attributes are defined as XML types\n    ``ID`` and ``IDREF`` respectively. This means that the\n    con", "start_line": 801, "end_line": 823}, {"name": "W33", "bases": ["VOTableChangeWarning"], "methods": [], "docstring": "Each field in a table must have a unique name.  If two or more\nfields have the same name, some will be renamed to ensure that all\nnames are unique.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:name>`__,\n`1.2\n<http://www.ivoa.net/documents/VO", "start_line": 826, "end_line": 839}, {"name": "W34", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The attribute requires the value to be a valid XML token, as\ndefined by `XML 1.0\n<http://www.w3.org/TR/2000/WD-xml-2e-20000814#NT-Nmtoken>`__.", "start_line": 842, "end_line": 850}, {"name": "W35", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The ``name`` and ``value`` attributes are required on all ``INFO``\nelements.\n\n**References:** `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#ToC54>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#ToC32>`__", "start_line": 853, "end_line": 865}, {"name": "W36", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "If the field specifies a ``null`` value, that value must conform\nto the given ``datatype``.\n\n**References:** `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:values>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#sec:values>`__", "start_line": 868, "end_line": 880}, {"name": "W37", "bases": ["UnimplementedWarning"], "methods": [], "docstring": "The 3 datatypes defined in the VOTable specification and supported by\n``astropy.io.votable`` are ``TABLEDATA``, ``BINARY`` and ``FITS``.\n\n**References:** `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:data>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091", "start_line": 883, "end_line": 895}, {"name": "W38", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The only encoding for local binary data supported by the VOTable\nspecification is base64.", "start_line": 898, "end_line": 905}, {"name": "W39", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Bit values do not support masking.  This warning is raised upon\nsetting masked data in a bit column.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:datatypes>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#sec:da", "start_line": 908, "end_line": 919}, {"name": "W40", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "This is a terrible hack to support Simple Image Access Protocol\nresults from `NOIRLab Astro Data Archive <https://astroarchive.noirlab.edu/>`__.  It\ncreates a field for the coordinate projection type of type \"double\",\nwhich actually contains character data.  We have to hack the field\nto store charac", "start_line": 922, "end_line": 932}, {"name": "W41", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "An XML namespace was specified on the ``VOTABLE`` element, but the\nnamespace does not match what is expected for a ``VOTABLE`` file.\n\nThe ``VOTABLE`` namespace is::\n\n  http://www.ivoa.net/xml/VOTable/vX.X\n\nwhere \"X.X\" is the version number.\n\nSome files in the wild set the namespace to the location o", "start_line": 935, "end_line": 954}, {"name": "W42", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The root element should specify a namespace.\n\nThe ``VOTABLE`` namespace is::\n\n    http://www.ivoa.net/xml/VOTable/vX.X\n\nwhere \"X.X\" is the version number.", "start_line": 957, "end_line": 967}, {"name": "W43", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Referenced elements should be defined before referees.\n\nFrom the VOTable 1.2 spec:\n\n   In VOTable1.2, it is further recommended to place the ID\n   attribute prior to referencing it whenever possible.", "start_line": 970, "end_line": 980}, {"name": "W44", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "``VALUES`` elements that reference another element should not have\ntheir own content.\n\nFrom the VOTable 1.2 spec:\n\n    The ``ref`` attribute of a ``VALUES`` element can be used to\n    avoid a repetition of the domain definition, by referring to a\n    previously defined ``VALUES`` element having the ", "start_line": 983, "end_line": 999}, {"name": "W45", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "Invalid content-role attribute.\n\nThe ``content-role`` attribute on the ``LINK`` element must be one of\nthe following::\n\n    query, hints, doc, location\n\nAnd in VOTable 1.3, additionally::\n\n    type\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#To", "start_line": 1002, "end_line": 1023}, {"name": "W46", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The given char or unicode string is too long for the specified\nfield length.", "start_line": 1026, "end_line": 1033}, {"name": "W47", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "If no arraysize is specified on a char field, the default of '1'\nis implied, but this is rarely what is intended.", "start_line": 1036, "end_line": 1042}, {"name": "W48", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The attribute is not defined in the specification.", "start_line": 1045, "end_line": 1051}, {"name": "W49", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Prior to VOTable 1.3, the empty cell was illegal for integer\nfields.\n\nIf a \"null\" value was specified for the cell, it will be used\nfor the value, otherwise, 0 will be used.", "start_line": 1054, "end_line": 1063}, {"name": "W50", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Invalid unit string as defined in the `Units in the VO, Version 1.0\n<https://www.ivoa.net/documents/VOUnits>`_ (VOTable version >= 1.4)\nor `Standards for Astronomical Catalogues, Version 2.0\n<https://cdsarc.cds.unistra.fr/doc/catstd-3.2.htx>`_ (version < 1.4).\n\nConsider passing an explicit ``unit_fo", "start_line": 1066, "end_line": 1078}, {"name": "W51", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The integer value is out of range for the size of the field.", "start_line": 1081, "end_line": 1087}, {"name": "W52", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The BINARY2 format was introduced in VOTable 1.3.  It should\nnot be present in files marked as an earlier version.", "start_line": 1090, "end_line": 1100}, {"name": "W53", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The VOTABLE element must contain at least one RESOURCE element.", "start_line": 1103, "end_line": 1109}, {"name": "W54", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The TIMESYS element was introduced in VOTable 1.4.  It should\nnot be present in files marked as an earlier version.", "start_line": 1112, "end_line": 1122}, {"name": "W55", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "When non-ASCII characters are detected when reading\na TABLEDATA value for a FIELD with ``datatype=\"char\"``, we\ncan issue this warning.", "start_line": 1125, "end_line": 1135}, {"name": "E01", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "Invalid size specifier for a field.\n\nThe size specifier for a ``char`` or ``unicode`` field must be\nonly a number followed, optionally, by an asterisk.\nMulti-dimensional size specifiers are not supported for these\ndatatypes.\n\nStrings, which are defined as a set of characters, can be\nrepresented in V", "start_line": 1138, "end_line": 1159}, {"name": "E02", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "Incorrect number of elements in array.\n\nThe number of array elements in the data does not match that specified\nin the FIELD specifier.", "start_line": 1162, "end_line": 1172}, {"name": "E03", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "Complex numbers should be two values separated by whitespace.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:datatypes>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#sec:datatypes>`__", "start_line": 1175, "end_line": 1185}, {"name": "E04", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "A ``bit`` array should be a string of '0's and '1's.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:datatypes>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#sec:datatypes>`__", "start_line": 1188, "end_line": 1198}, {"name": "E05", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "Invalid boolean value.\n\nA ``boolean`` value should be one of the following strings (case\ninsensitive) in the ``TABLEDATA`` format::\n\n    'TRUE', 'FALSE', '1', '0', 'T', 'F', '\\0', ' ', '?'\n\nand in ``BINARY`` format::\n\n    'T', 'F', '1', '0', '\\0', ' ', '?'\n\n**References**: `1.1\n<http://www.ivoa.net/", "start_line": 1201, "end_line": 1220}, {"name": "E06", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "Unknown datatype on a field.\n\nThe supported datatypes are::\n\n    double, float, bit, boolean, unsignedByte, short, int, long,\n    floatComplex, doubleComplex, char, unicodeChar\n\nThe following non-standard aliases are also supported, but in\nthese case :ref:`W13 <W13>` will be raised::\n\n    string    ", "start_line": 1223, "end_line": 1254}, {"name": "E08", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The ``type`` attribute on the ``VALUES`` element must be either\n``legal`` or ``actual``.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:values>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#sec:values>`__", "start_line": 1260, "end_line": 1272}, {"name": "E09", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The ``MIN``, ``MAX`` and ``OPTION`` elements must always have a\n``value`` attribute.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:values>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#sec:values>`__", "start_line": 1275, "end_line": 1287}, {"name": "E10", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "From VOTable 1.1 and later, ``FIELD`` and ``PARAM`` elements must have\na ``datatype`` field.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#elem:FIELD>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#elem:FIELD>`__", "start_line": 1290, "end_line": 1302}, {"name": "E11", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The precision attribute is meant to express the number of significant\ndigits, either as a number of decimal places (e.g. ``precision=\"F2\"`` or\nequivalently ``precision=\"2\"`` to express 2 significant figures\nafter the decimal point), or as a number of significant figures\n(e.g. ``precision=\"E5\"`` indi", "start_line": 1305, "end_line": 1324}, {"name": "E12", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The width attribute is meant to indicate to the application the\nnumber of characters to be used for input or output of the\nquantity.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:form>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/", "start_line": 1327, "end_line": 1340}, {"name": "E13", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "Invalid arraysize attribute.\n\nFrom the VOTable 1.2 spec:\n\n    A table cell can contain an array of a given primitive type,\n    with a fixed or variable number of elements; the array may\n    even be multidimensional. For instance, the position of a\n    point in a 3D space can be defined by the follow", "start_line": 1343, "end_line": 1383}, {"name": "E14", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "All ``PARAM`` elements must have a ``value`` attribute.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#elem:FIELD>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#elem:FIELD>`__", "start_line": 1386, "end_line": 1396}, {"name": "E15", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "All ``COOSYS`` elements must have an ``ID`` attribute.\n\nNote that the VOTable 1.1 specification says this attribute is\noptional, but its corresponding schema indicates it is required.\n\nIn VOTable 1.2, the ``COOSYS`` element is deprecated.", "start_line": 1399, "end_line": 1408}, {"name": "E16", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Incorrect ``system`` attribute on COOSYS element.\n\nThe ``system`` attribute must be one of the following::\n\n  'eq_FK4', 'eq_FK5', 'ICRS', 'ecl_FK4', 'ecl_FK5', 'galactic',\n  'supergalactic', 'xy', 'barycentric', 'geo_app'\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTa", "start_line": 1411, "end_line": 1424}, {"name": "E17", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "``extnum`` attribute must be a positive integer.\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#ToC54>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#ToC58>`__", "start_line": 1427, "end_line": 1437}, {"name": "E18", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The ``type`` attribute of the ``RESOURCE`` element must be one of\n\"results\" or \"meta\".\n\n**References**: `1.1\n<http://www.ivoa.net/documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#ToC54>`__,\n`1.2\n<http://www.ivoa.net/documents/VOTable/20091130/REC-VOTable-1.2.html#ToC58>`__", "start_line": 1440, "end_line": 1452}, {"name": "E19", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "Raised either when the file doesn't appear to be XML, or the root\nelement is not VOTABLE.", "start_line": 1455, "end_line": 1461}, {"name": "E20", "bases": ["VOTableSpecError"], "methods": [], "docstring": "The table had only *x* fields defined, but the data itself has more\ncolumns than that.", "start_line": 1464, "end_line": 1471}, {"name": "E21", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The table had *x* fields defined, but the data itself has only *y*\ncolumns.", "start_line": 1474, "end_line": 1481}, {"name": "E22", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "All ``TIMESYS`` elements must have an ``ID`` attribute.", "start_line": 1484, "end_line": 1489}, {"name": "E23", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The ``timeorigin`` attribute on the ``TIMESYS`` element must be\neither a floating point literal specifying a valid Julian Date,\nor, for convenience, the string \"MJD-origin\" (standing for 2400000.5)\nor the string \"JD-origin\" (standing for 0).\n\n**References**: `1.4\n<http://www.ivoa.net/documents/VOTab", "start_line": 1492, "end_line": 1504}, {"name": "E24", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "Non-ASCII unicode values should not be written when the FIELD ``datatype=\"char\"``,\nand cannot be written in BINARY or BINARY2 serialization.", "start_line": 1507, "end_line": 1516}, {"name": "E25", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "A VOTable cannot have a DATA section without any defined FIELD; DATA will be ignored.", "start_line": 1519, "end_line": 1524}], "calls": [], "module_docstring": "VOTable exceptions and warnings.\n\n.. _warnings:\n\nWarnings\n--------\n.. note::\n    Most of the following warnings indicate violations of the VOTable\n    specification.  They should be reported to the authors of the\n    tools that produced the VOTable file.\n\n    To control the warnings emitted, use the standard Python\n    :mod:`warnings` module and the ``astropy.io.votable.exceptions.conf.max_warnings``\n    configuration item.  Most of these are of the type `VOTableSpecWarning`.\n\n{warnings}\n\n.. _exceptions:\n\nExceptions\n----------\n\n.. note::\n\n    This is a list of many of the fatal exceptions emitted by ``astropy.io.votable``\n    when the file does not conform to spec.  Other exceptions may be\n    raised due to unforeseen cases or bugs in ``astropy.io.votable`` itself.\n\n{exceptions}", "parse_error": ""}, {"file_path": "astropy/io/votable/table.py", "file_hash": "a4bcc13248940c0560460b4dcc790b745d35c52ddff309c6cadd405ca4eea3fb", "imports": [{"module": "io", "names": [], "is_from": false, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "textwrap", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "astropy.utils", "names": ["data"], "is_from": true, "alias": ""}, {"module": "astropy.utils.xml", "names": ["iterparser"], "is_from": true, "alias": ""}, {"module": "", "names": ["exceptions", "tree"], "is_from": true, "alias": ""}, {"module": "", "names": ["conf", "VERIFY_OPTIONS"], "is_from": true, "alias": ""}, {"module": "astropy.table", "names": ["Table"], "is_from": true, "alias": ""}, {"module": "astropy.utils.console", "names": ["color_print", "print_code_line"], "is_from": true, "alias": ""}, {"module": "", "names": ["converters", "xmlutil"], "is_from": true, "alias": ""}, {"module": "", "names": ["xmlutil"], "is_from": true, "alias": ""}], "functions": [{"name": "parse", "qualified_name": "parse", "args": ["source", "columns", "invalid", "verify", "chunk_size", "table_number", "table_id", "filename", "unit_format", "datatype_mapping", "_debug_python_based_parser"], "decorators": [], "docstring": "Parses a VOTABLE_ xml file (or file-like object), and returns a\n`~astropy.io.votable.tree.VOTableFile` object.\n\nParameters\n----------\nsource : path-like or file-like\n    Path or file-like object containing a VOTABLE_ xml file.\n    If file, must be readable.\n\ncolumns : sequence of str, optional\n    L", "start_line": 31, "end_line": 164, "is_async": false, "is_method": false}, {"name": "parse_single_table", "qualified_name": "parse_single_table", "args": ["source"], "decorators": [], "docstring": "Parses a VOTABLE_ xml file (or file-like object), reading and\nreturning only the first `~astropy.io.votable.tree.Table`\ninstance.\n\nSee `parse` for a description of the keyword arguments.\n\nReturns\n-------\nvotable : `~astropy.io.votable.tree.Table` object", "start_line": 167, "end_line": 184, "is_async": false, "is_method": false}, {"name": "writeto", "qualified_name": "writeto", "args": ["table", "file", "tabledata_format"], "decorators": [], "docstring": "Writes a `~astropy.io.votable.tree.VOTableFile` to a VOTABLE_ xml file.\n\nParameters\n----------\ntable : `~astropy.io.votable.tree.VOTableFile` or `~astropy.table.Table` instance.\n\nfile : str or writable file-like\n    Path or file object to write to\n\ntabledata_format : str, optional\n    Override the f", "start_line": 187, "end_line": 216, "is_async": false, "is_method": false}, {"name": "validate", "qualified_name": "validate", "args": ["source", "output", "xmllint", "filename"], "decorators": [], "docstring": "Prints a validation report for the given file.\n\nParameters\n----------\nsource : path-like or file-like\n    Path to a VOTABLE_ xml file or `~pathlib.Path`\n    object having Path to a VOTABLE_ xml file.\n    If file-like object, must be readable.\n\noutput : file-like, optional\n    Where to output the rep", "start_line": 219, "end_line": 351, "is_async": false, "is_method": false}, {"name": "from_table", "qualified_name": "from_table", "args": ["table", "table_id"], "decorators": [], "docstring": "Given an `~astropy.table.Table` object, return a\n`~astropy.io.votable.tree.VOTableFile` file structure containing\njust that single table.\n\nParameters\n----------\ntable : `~astropy.table.Table` instance\n\ntable_id : str, optional\n    If not `None`, set the given id on the returned\n    `~astropy.io.vota", "start_line": 354, "end_line": 372, "is_async": false, "is_method": false}, {"name": "is_votable", "qualified_name": "is_votable", "args": ["source"], "decorators": [], "docstring": "Reads the header of a file to determine if it is a VOTable file.\n\nParameters\n----------\nsource : path-like or file-like\n    Path or file object containing a VOTABLE_ xml file.\n    If file, must be readable.\n\nReturns\n-------\nis_votable : bool\n    Returns `True` if the given file is a VOTable file.", "start_line": 375, "end_line": 406, "is_async": false, "is_method": false}, {"name": "reset_vo_warnings", "qualified_name": "reset_vo_warnings", "args": [], "decorators": [], "docstring": "Resets all of the vo warning state so that warnings that\nhave already been emitted will be emitted again. This is\nused, for example, by `validate` which must emit all\nwarnings each time it is called.", "start_line": 409, "end_line": 429, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This file contains a contains the high-level functions to read a\nVOTable file.", "parse_error": ""}, {"file_path": "astropy/io/ascii/cds.py", "file_hash": "0cdae15e2194386be868da9010f5e34c3d4b33bc09b3b284a5a7a6a12986dc45", "imports": [{"module": "fnmatch", "names": [], "is_from": false, "alias": ""}, {"module": "itertools", "names": [], "is_from": false, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "contextlib", "names": ["suppress"], "is_from": true, "alias": ""}, {"module": "astropy.units", "names": ["Unit"], "is_from": true, "alias": ""}, {"module": "", "names": ["core", "fixedwidth"], "is_from": true, "alias": ""}], "functions": [{"name": "get_type_map_key", "qualified_name": "get_type_map_key", "args": ["self", "col"], "decorators": [], "docstring": "", "start_line": 38, "end_line": 45, "is_async": false, "is_method": false}, {"name": "get_cols", "qualified_name": "get_cols", "args": ["self", "lines"], "decorators": [], "docstring": "Initialize the header Column objects from the table ``lines`` for a CDS/MRT\nheader.\n\nParameters\n----------\nlines : list\n    List of table lines", "start_line": 47, "end_line": 182, "is_async": false, "is_method": false}, {"name": "process_lines", "qualified_name": "process_lines", "args": ["self", "lines"], "decorators": [], "docstring": "Skip over CDS/MRT header by finding the last section delimiter.", "start_line": 191, "end_line": 206, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "readme"], "decorators": [], "docstring": "", "start_line": 323, "end_line": 325, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "table"], "decorators": [], "docstring": "Not available for the CDS class (raises NotImplementedError).", "start_line": 327, "end_line": 329, "is_async": false, "is_method": false}, {"name": "read", "qualified_name": "read", "args": ["self", "table"], "decorators": [], "docstring": "", "start_line": 331, "end_line": 357, "is_async": false, "is_method": false}], "classes": [{"name": "CdsHeader", "bases": ["core.BaseHeader"], "methods": ["get_type_map_key", "get_cols"], "docstring": "", "start_line": 25, "end_line": 182}, {"name": "CdsData", "bases": ["core.BaseData"], "methods": ["process_lines"], "docstring": "CDS table data reader.", "start_line": 185, "end_line": 206}, {"name": "Cds", "bases": ["core.BaseReader"], "methods": ["__init__", "write", "read"], "docstring": "CDS format table.\n\nSee: https://vizier.unistra.fr/doc/catstd.htx\n\nExample::\n\n  Table: Table name here\n  = ==============================================================================\n  Catalog reference paper\n      Bibliography info here\n  ==========================================================", "start_line": 209, "end_line": 357}], "calls": [], "module_docstring": "An extensible ASCII table reader and writer.\n\ncds.py:\n  Classes to read CDS / Vizier table format\n\n:Copyright: Smithsonian Astrophysical Observatory (2011)\n:Author: Tom Aldcroft (aldcroft@head.cfa.harvard.edu)", "parse_error": ""}, {"file_path": "astropy/io/ascii/fixedwidth.py", "file_hash": "7255c76760d08f45dd66e2a81ddff7418b715bea9949095b82c3abc4e55f9f22", "imports": [{"module": "", "names": ["basic", "core"], "is_from": true, "alias": ""}, {"module": "core", "names": ["DefaultSplitter", "InconsistentTableError"], "is_from": true, "alias": ""}], "functions": [{"name": "__call__", "qualified_name": "__call__", "args": ["self", "lines"], "decorators": [], "docstring": "", "start_line": 37, "end_line": 43, "is_async": false, "is_method": false}, {"name": "join", "qualified_name": "join", "args": ["self", "vals", "widths"], "decorators": [], "docstring": "", "start_line": 45, "end_line": 56, "is_async": false, "is_method": false}, {"name": "get_line", "qualified_name": "get_line", "args": ["self", "lines", "index"], "decorators": [], "docstring": "", "start_line": 76, "end_line": 82, "is_async": false, "is_method": false}, {"name": "get_cols", "qualified_name": "get_cols", "args": ["self", "lines"], "decorators": [], "docstring": "Initialize the header Column objects from the table ``lines``.\n\nBased on the previously set Header attributes find or create the column names.\nSets ``self.cols`` with the list of Columns.\n\nParameters\n----------\nlines : list\n    List of table lines", "start_line": 84, "end_line": 179, "is_async": false, "is_method": false}, {"name": "get_fixedwidth_params", "qualified_name": "get_fixedwidth_params", "args": ["self", "line"], "decorators": [], "docstring": "Split ``line`` on the delimiter and determine column values and\ncolumn start and end positions.  This might include null columns with\nzero length (e.g. for ``header row = \"| col1 || col2 | col3 |\"`` or\n``header2_row = \"----- ------- -----\"``).  The null columns are\nstripped out.  Returns the values ", "start_line": 181, "end_line": 243, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "lines"], "decorators": [], "docstring": "", "start_line": 245, "end_line": 248, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "lines"], "decorators": [], "docstring": "", "start_line": 260, "end_line": 302, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "col_starts", "col_ends", "delimiter_pad", "bookend", "header_rows"], "decorators": [], "docstring": "", "start_line": 338, "end_line": 356, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "col_starts", "col_ends", "delimiter_pad", "bookend"], "decorators": [], "docstring": "", "start_line": 404, "end_line": 411, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "position_line", "position_char", "delimiter_pad", "bookend", "header_rows"], "decorators": [], "docstring": "", "start_line": 470, "end_line": 489, "is_async": false, "is_method": false}], "classes": [{"name": "FixedWidthSplitter", "bases": ["core.BaseSplitter"], "methods": ["__call__", "join"], "docstring": "Split line based on fixed start and end positions for each ``col`` in\n``self.cols``.\n\nThis class requires that the Header class will have defined ``col.start``\nand ``col.end`` for each column.  The reference to the ``header.cols`` gets\nput in the splitter object by the base Reader.read() function ju", "start_line": 16, "end_line": 56}, {"name": "FixedWidthHeaderSplitter", "bases": ["DefaultSplitter"], "methods": [], "docstring": "Splitter class that splits on ``|``.", "start_line": 59, "end_line": 62}, {"name": "FixedWidthHeader", "bases": ["basic.BasicHeader"], "methods": ["get_line", "get_cols", "get_fixedwidth_params", "write"], "docstring": "Fixed width table header reader.", "start_line": 65, "end_line": 248}, {"name": "FixedWidthData", "bases": ["basic.BasicData"], "methods": ["write"], "docstring": "Base table data reader.", "start_line": 251, "end_line": 302}, {"name": "FixedWidth", "bases": ["basic.Basic"], "methods": ["__init__"], "docstring": "Fixed width table with single header line defining column names and positions.\n\nExamples::\n\n  # Bar delimiter in header and data\n\n  |  Col1 |   Col2      |  Col3 |\n  |  1.2  | hello there |     3 |\n  |  2.4  | many words  |     7 |\n\n  # Bar delimiter in header only\n\n  Col1 |   Col2      | Col3\n  1.2", "start_line": 305, "end_line": 356}, {"name": "FixedWidthNoHeaderHeader", "bases": ["FixedWidthHeader"], "methods": [], "docstring": "Header reader for fixed with tables with no header line.", "start_line": 359, "end_line": 362}, {"name": "FixedWidthNoHeaderData", "bases": ["FixedWidthData"], "methods": [], "docstring": "Data reader for fixed width tables with no header line.", "start_line": 365, "end_line": 368}, {"name": "FixedWidthNoHeader", "bases": ["FixedWidth"], "methods": ["__init__"], "docstring": "Fixed width table which has no header line.\n\nWhen reading, column names are either input (``names`` keyword) or\nauto-generated.  Column positions are determined either by input\n(``col_starts`` and ``col_stops`` keywords) or by splitting the first data\nline.  In the latter case a ``delimiter`` is req", "start_line": 371, "end_line": 411}, {"name": "FixedWidthTwoLineHeader", "bases": ["FixedWidthHeader"], "methods": [], "docstring": "Header reader for fixed width tables splitting on whitespace.\n\nFor fixed width tables with several header lines, there is typically\na white-space delimited format line, so splitting on white space is\nneeded.", "start_line": 414, "end_line": 422}, {"name": "FixedWidthTwoLineDataSplitter", "bases": ["FixedWidthSplitter"], "methods": [], "docstring": "Splitter for fixed width tables splitting on ``' '``.", "start_line": 425, "end_line": 428}, {"name": "FixedWidthTwoLineData", "bases": ["FixedWidthData"], "methods": [], "docstring": "Data reader for fixed with tables with two header lines.", "start_line": 431, "end_line": 434}, {"name": "FixedWidthTwoLine", "bases": ["FixedWidth"], "methods": ["__init__"], "docstring": "Fixed width table which has two header lines.\n\nThe first header line defines the column names and the second implicitly\ndefines the column positions.\n\nExamples::\n\n  # Typical case with column extent defined by ---- under column names.\n\n   col1    col2         <== header_start = 0\n  -----  ----------", "start_line": 437, "end_line": 489}], "calls": [], "module_docstring": "An extensible ASCII table reader and writer.\n\nfixedwidth.py:\n  Read or write a table with fixed width columns.\n\n:Copyright: Smithsonian Astrophysical Observatory (2011)\n:Author: Tom Aldcroft (aldcroft@head.cfa.harvard.edu)", "parse_error": ""}, {"file_path": "astropy/io/ascii/connect.py", "file_hash": "fbfe2816a4f49d218bda91bdff4ff6ea44ed245698972fa09af533f843d0f2e1", "imports": [{"mo