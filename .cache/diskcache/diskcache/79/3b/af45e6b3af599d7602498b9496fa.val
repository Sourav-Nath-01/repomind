imension of the array so that we can then use axis=0.", "start_line": 22, "end_line": 45, "is_async": false, "is_method": false}, {"name": "_nanmean", "qualified_name": "_nanmean", "args": ["array", "axis"], "decorators": [], "docstring": "Bottleneck nanmean function that handle tuple axis.", "start_line": 48, "end_line": 57, "is_async": false, "is_method": false}, {"name": "_nanmedian", "qualified_name": "_nanmedian", "args": ["array", "axis"], "decorators": [], "docstring": "Bottleneck nanmedian function that handle tuple axis.", "start_line": 60, "end_line": 69, "is_async": false, "is_method": false}, {"name": "_nanstd", "qualified_name": "_nanstd", "args": ["array", "axis", "ddof"], "decorators": [], "docstring": "Bottleneck nanstd function that handle tuple axis.", "start_line": 72, "end_line": 81, "is_async": false, "is_method": false}, {"name": "_nanmadstd", "qualified_name": "_nanmadstd", "args": ["array", "axis"], "decorators": [], "docstring": "mad_std function that ignores NaNs by default.", "start_line": 84, "end_line": 86, "is_async": false, "is_method": false}, {"name": "sigma_clip", "qualified_name": "sigma_clip", "args": ["data", "sigma", "sigma_lower", "sigma_upper", "maxiters", "cenfunc", "stdfunc", "axis", "masked", "return_bounds", "copy", "grow"], "decorators": [], "docstring": "Perform sigma-clipping on the provided data.\n\nThe data will be iterated over, each time rejecting values that are\nless or more than a specified number of standard deviations from a\ncenter value.\n\nClipped (rejected) pixels are those where::\n\n    data < center - (sigma_lower * std)\n    data > center +", "start_line": 682, "end_line": 889, "is_async": false, "is_method": false}, {"name": "sigma_clipped_stats", "qualified_name": "sigma_clipped_stats", "args": ["data", "mask", "mask_value", "sigma", "sigma_lower", "sigma_upper", "maxiters", "cenfunc", "stdfunc", "std_ddof", "axis", "grow"], "decorators": [], "docstring": "Calculate sigma-clipped statistics on the provided data.\n\nParameters\n----------\ndata : array-like or `~numpy.ma.MaskedArray`\n    Data array or object that can be converted to an array.\n\nmask : `numpy.ndarray` (bool), optional\n    A boolean mask with the same shape as ``data``, where a `True`\n    val", "start_line": 892, "end_line": 1031, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "sigma", "sigma_lower", "sigma_upper", "maxiters", "cenfunc", "stdfunc", "grow"], "decorators": [], "docstring": "", "start_line": 222, "end_line": 250, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 252, "end_line": 257, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 259, "end_line": 272, "is_async": false, "is_method": false}, {"name": "_parse_cenfunc", "qualified_name": "_parse_cenfunc", "args": ["cenfunc"], "decorators": ["staticmethod"], "docstring": "", "start_line": 275, "end_line": 292, "is_async": false, "is_method": false}, {"name": "_parse_stdfunc", "qualified_name": "_parse_stdfunc", "args": ["stdfunc"], "decorators": ["staticmethod"], "docstring": "", "start_line": 295, "end_line": 307, "is_async": false, "is_method": false}, {"name": "_compute_bounds", "qualified_name": "_compute_bounds", "args": ["self", "data", "axis"], "decorators": [], "docstring": "", "start_line": 309, "end_line": 317, "is_async": false, "is_method": false}, {"name": "_sigmaclip_fast", "qualified_name": "_sigmaclip_fast", "args": ["self", "data", "axis", "masked", "return_bounds", "copy"], "decorators": [], "docstring": "Fast C implementation for simple use cases.", "start_line": 319, "end_line": 415, "is_async": false, "is_method": false}, {"name": "_sigmaclip_noaxis", "qualified_name": "_sigmaclip_noaxis", "args": ["self", "data", "masked", "return_bounds", 