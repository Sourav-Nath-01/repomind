, "start_line": 152, "end_line": 204}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/modeling/tests/test_quantities_parameters.py", "file_hash": "d9197ad30044948f61d8d330598bd336975fce08a43daa5fc3ffc7152474b59c", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "pytest", "names": [], "is_from": false, "alias": ""}, {"module": "astropy", "names": ["coordinates"], "is_from": true, "alias": ""}, {"module": "astropy", "names": ["units"], "is_from": true, "alias": ""}, {"module": "astropy.modeling.core", "names": ["Fittable1DModel", "InputParameterError"], "is_from": true, "alias": ""}, {"module": "astropy.modeling.models", "names": ["Const1D", "Gaussian1D", "Pix2Sky_TAN", "RotateNative2Celestial", "Rotation2D", "BlackBody"], "is_from": true, "alias": ""}, {"module": "astropy.modeling.parameters", "names": ["Parameter", "ParameterDefinitionError"], "is_from": true, "alias": ""}, {"module": "astropy.tests.helper", "names": ["assert_quantity_allclose"], "is_from": true, "alias": ""}, {"module": "astropy.units", "names": ["UnitsError"], "is_from": true, "alias": ""}], "functions": [{"name": "test_parameter_quantity", "qualified_name": "test_parameter_quantity", "args": [], "decorators": [], "docstring": "Basic tests for initializing general models (that do not require units)\nwith parameters that have units attached.", "start_line": 31, "end_line": 42, "is_async": false, "is_method": false}, {"name": "test_parameter_set_quantity", "qualified_name": "test_parameter_set_quantity", "args": [], "decorators": [], "docstring": "Make sure that parameters that start off as quantities can be set to any\nother quantity, regardless of whether the units of the new quantity are\ncompatible with the original ones.\n\nWe basically leave it up to the evaluate method to raise errors if there\nare issues with incompatible units, and we don", "start_line": 45, "end_line": 75, "is_async": false, "is_method": false}, {"name": "test_parameter_lose_units", "qualified_name": "test_parameter_lose_units", "args": [], "decorators": [], "docstring": "Check that parameters that have been set to a quantity that are then set to\na value with no units raise an exception. We do this because setting a\nparameter to a value with no units is ambiguous if units were set before:\nif a parameter is 1 * u.Jy and the parameter is then set to 4, does this mean\n2", "start_line": 78, "end_line": 94, "is_async": false, "is_method": false}, {"name": "test_parameter_add_units", "qualified_name": "test_parameter_add_units", "args": [], "decorators": [], "docstring": "On the other hand, if starting from a parameter with no units, we should be\nable to add units since this is unambiguous.", "start_line": 97, "end_line": 106, "is_async": false, "is_method": false}, {"name": "test_parameter_change_unit", "qualified_name": "test_parameter_change_unit", "args": [], "decorators": [], "docstring": "Test that changing the unit on a parameter does not work. This is an\nambiguous operation because it's not clear if it means that the value should\nbe converted or if the unit should be changed without conversion.", "start_line": 109, "end_line": 132, "is_async": false, "is_method": false}, {"name": "test_parameter_set_value", "qualified_name": "test_parameter_set_value", "args": [], "decorators": [], "docstring": "Test that changing the value on a parameter works as expected.", "start_line": 135, "end_line": 158, "is_async": false, "is_method": false}, {"name": "test_parameter_quantity_property", "qualified_name": "test_parameter_quantity_property", "args": [], "decorators": [], "docstring": "Test that the quantity property of Parameters behaves as expected", "start_line": 161, "end_line": 187, "is_async": false, "is_method": false}, {"name": "test_parameter_default_units_match", "qualified_name": "test_parameter_default_units_match", "args": [], "decorators": [], "docstring": "", "start_line": 190, "end_line": 199, "i