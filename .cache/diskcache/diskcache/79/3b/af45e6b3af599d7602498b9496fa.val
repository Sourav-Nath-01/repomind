ld try to convert each column to ints. If this fails, the\nreader should try to convert to floats. Failing this, i.e. on parsing\nnon-numeric input including isolated positive/negative signs, it should\nfall back to strings.", "start_line": 345, "end_line": 366, "is_async": false, "is_method": false}, {"name": "test_delimiter", "qualified_name": "test_delimiter", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure that different delimiters work as expected.", "start_line": 370, "end_line": 385, "is_async": false, "is_method": false}, {"name": "test_include_names", "qualified_name": "test_include_names", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "If include_names is not None, the parser should read only those columns in include_names.", "start_line": 389, "end_line": 397, "is_async": false, "is_method": false}, {"name": "test_exclude_names", "qualified_name": "test_exclude_names", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "If exclude_names is not None, the parser should exclude the columns in exclude_names.", "start_line": 401, "end_line": 409, "is_async": false, "is_method": false}, {"name": "test_include_exclude_names", "qualified_name": "test_include_exclude_names", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure that include_names is applied before exclude_names if both are specified.", "start_line": 413, "end_line": 431, "is_async": false, "is_method": false}, {"name": "test_doubled_quotes", "qualified_name": "test_doubled_quotes", "args": ["read_csv"], "decorators": [], "docstring": "Test #8283 (fix for #8281), parsing doubled-quotes \"ab\"\"cd\" in a quoted\nfield was incorrect.", "start_line": 434, "end_line": 459, "is_async": false, "is_method": false}, {"name": "test_doubled_quotes_segv", "qualified_name": "test_doubled_quotes_segv", "args": [], "decorators": ["pytest.mark.filterwarnings('ignore:OverflowError converting to IntType in column TIMESTAMP')"], "docstring": "Test the exact example from #8281 which resulted in SEGV prior to #8283\n(in contrast to the tests above that just gave the wrong answer).\nAttempts to produce a more minimal example were unsuccessful, so the whole\nthing is included.", "start_line": 465, "end_line": 478, "is_async": false, "is_method": false}, {"name": "test_quoted_fields", "qualified_name": "test_quoted_fields", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "The character quotechar (default '\"') should denote the start of a field which can\ncontain the field delimiter and newlines.", "start_line": 482, "end_line": 503, "is_async": false, "is_method": false}, {"name": "test_invalid_parameters", "qualified_name": "test_invalid_parameters", "args": ["key", "val"], "decorators": ["pytest.mark.parametrize('key,val', [('delimiter', ',,'), ('comment', '##'), ('data_start', None), ('data_start', -1), ('quotechar', '##'), ('header_start', -1), ('converters', {i + 1: ascii.convert_numpy(np.uint) for i in range(3)}), ('Inputter', ascii.ContinuationLinesInputter), ('header_Splitter', ascii.DefaultSplitter), ('data_Splitter', ascii.DefaultSplitter)])"], "docstring": "Make sure the C reader raises an error if passed parameters it can't handle.", "start_line": 524, "end_line": 531, "is_async": false, "is_method": false}, {"name": "test_invalid_parameters_other", "qualified_name": "test_invalid_parameters_other", "args": [], "decorators": [], "docstring": "", "start_line": 534, "end_line": 541, "is_async": false, "is_method": false}, {"name": "test_too_many_cols1", "qualified_name": "test_too_many_cols1", "args": [], "decorators": [], "docstring": "If a row contains too many columns, the C reader should raise an error.", "start_line": 544, "end_line": 562, "is_async": false, "is_method": false}, {"name": "test_too_many_cols2", "qualified_name": "test_too_many_cols2", "args": [], "decorators": [], "docstring": "", "start_line": 565, "end_line": 576, "is_async": false, "is_method": false}, {"name": "test_too_many_cols3", "qualified_name": "test_too_many_cols3", "args": [], "decorators": [], "docstring": "", "start_line": 579, "end_line": 590, "is_async": false, "is_method": false}, {"name": "test_too_many_cols4", "qualified_name": "test_too_many_cols4", "args": [], "decorators": [], "docstring": "", "start_line": 593, "end_line": 599, "is_async": false, "is_method": false}, {"name": "test_not_enough_cols", "qualified_name": "test_not_enough_cols", "args": ["parallel", "read_csv"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "If a row does not have enough columns, the FastCsv reader should add empty\nfields while the FastBasic reader should raise an error.", "start_line": 603, "end_line": 619, "is_async": false, "is_method": false}, {"name": "test_data_end", "qualified_name": "test_data_end", "args": ["parallel", "read_basic", "read_rdb"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "The parameter data_end should specify where data reading ends.", "start_line": 623, "end_line": 662, "is_async": false, "is_method": false}, {"name": "test_inf_nan", "qualified_name": "test_inf_nan", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Test that inf and nan-like values are correctly parsed on all platforms.\n\nRegression test for https://github.com/astropy/astropy/pull/3525", "start_line": 666, "end_line": 706, "is_async": false, "is_method": false}, {"name": "test_fill_values", "qualified_name": "test_fill_values", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure that the parameter fill_values works as intended. If fill_values\nis not specified, the default behavior should be to convert '' to 0.", "start_line": 710, "end_line": 761, "is_async": false, "is_method": false}, {"name": "test_fill_include_exclude_names", "qualified_name": "test_fill_include_exclude_names", "args": ["parallel", "read_csv"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "fill_include_names and fill_exclude_names should filter missing/empty value handling\nin the same way that include_names and exclude_names filter output columns.", "start_line": 765, "end_line": 792, "is_async": false, "is_method": false}, {"name": "test_many_rows", "qualified_name": "test_many_rows", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure memory reallocation works okay when the number of rows\nis large (so that each column string is longer than INITIAL_COL_SIZE).", "start_line": 796, "end_line": 808, "is_async": false, "is_method": false}, {"name": "test_many_columns", "qualified_name": "test_many_columns", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure memory reallocation works okay when the number of columns\nis large (so that each header string is longer than INITIAL_HEADER_SIZE).", "start_line": 812, "end_line": 822, "is_async": false, "is_method": false}, {"name": "test_fast_reader", "qualified_name": "test_fast_reader", "args": [], "decorators": [], "docstring": "Make sure that ascii.read() works as expected by default and with\nfast_reader specified.", "start_line": 825, "end_line": 861, "is_async": false, "is_method": false}, {"name": "test_read_tab", "qualified_name": "test_read_tab", "args": ["parallel", "read_tab"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "The fast reader for tab-separated values should not strip whitespace, unlike\nthe basic reader.", "start_line": 865, "end_line": 878, "is_async": false, "is_method": false}, {"name": "test_default_data_start", "qualified_name": "test_default_data_start", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "If data_start is not explicitly passed to read(), data processing should\nbeginning right after the header.", "start_line": 882, "end_line": 890, "is_async": false, "is_method": false}, {"name": "test_commented_header", "qualified_name": "test_commented_header", "args": ["parallel", "read_commented_header"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "The FastCommentedHeader reader should mimic the behavior of the\nCommentedHeader by overriding the default header behavior of FastBasic.", "start_line": 894, "end_line": 922, "is_async": false, "is_method": false}, {"name": "test_rdb", "qualified_name": "test_rdb", "args": ["parallel", "read_rdb"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure the FastRdb reader works as expected.", "start_line": 926, "end_line": 956, "is_async": false, "is_method": false}, {"name": "test_data_start", "qualified_name": "test_data_start", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure that data parsing begins at data_start (ignoring empty and\ncommented lines but not taking quoted values into account).", "start_line": 960, "end_line": 1012, "is_async": false, "is_method": false}, {"name": "test_quoted_empty_values", "qualified_name": "test_quoted_empty_values", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Quoted empty values spanning multiple lines should be treated correctly.", "start_line": 1016, "end_line": 1024, "is_async": false, "is_method": false}, {"name": "test_csv_comment_default", "qualified_name": "test_csv_comment_default", "args": ["parallel", "read_csv"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Unless the comment parameter is specified, the CSV reader should\nnot treat any lines as comments.", "start_line": 1028, "end_line": 1036, "is_async": false, "is_method": false}, {"name": "test_whitespace_before_comment", "qualified_name": "test_whitespace_before_comment", "args": ["parallel", "read_tab"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Readers that don't strip whitespace from data (Tab, RDB)\nshould still treat lines with leading whitespace and then\nthe comment char as comment lines.", "start_line": 1040, "end_line": 1049, "is_async": false, "is_method": false}, {"name": "test_strip_line_trailing_whitespace", "qualified_name": "test_strip_line_trailing_whitespace", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Readers that strip whitespace from lines should ignore\ntrailing whitespace after the last data value of each\nrow.", "start_line": 1053, "end_line": 1069, "is_async": false, "is_method": false}, {"name": "test_no_data", "qualified_name": "test_no_data", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "As long as column names are supplied, the C reader\nshould return an empty table in the absence of data.", "start_line": 1073, "end_line": 1083, "is_async": false, "is_method": false}, {"name": "test_line_endings", "qualified_name": "test_line_endings", "args": ["parallel", "read_basic", "read_commented_header", "read_rdb"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure the fast reader accepts CR and CR+LF\nas newlines.", "start_line": 1087, "end_line": 1116, "is_async": false, "is_method": false}, {"name": "test_store_comments", "qualified_name": "test_store_comments", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure that the output Table produced by the fast\nreader stores any comment lines in its meta attribute.", "start_line": 1120, "end_line": 1134, "is_async": false, "is_method": false}, {"name": "test_empty_quotes", "qualified_name": "test_empty_quotes", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure the C reader doesn't segfault when the\ninput data contains empty quotes. [#3407]", "start_line": 1138, "end_line": 1145, "is_async": false, "is_method": false}, {"name": "test_fast_tab_with_names", "qualified_name": "test_fast_tab_with_names", "args": ["parallel", "read_tab"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure the C reader doesn't segfault when the header for the\nfirst column is missing [#3545]", "start_line": 1149, "end_line": 1158, "is_async": false, "is_method": false}, {"name": "test_read_big_table", "qualified_name": "test_read_big_table", "args": ["tmp_path"], "decorators": ["pytest.mark.hugemem"], "docstring": "Test reading of a huge file.\n\nThis test generates a huge CSV file (~2.3Gb) before reading it (see\nhttps://github.com/astropy/astropy/pull/5319). The test is run only if the\n``--run-hugemem`` cli option is given. Note that running the test requires\nquite a lot of memory (~18Gb when reading the file) ", "start_line": 1162, "end_line": 1192, "is_async": false, "is_method": false}, {"name": "test_read_big_table2", "qualified_name": "test_read_big_table2", "args": ["tmp_path"], "decorators": ["pytest.mark.hugemem"], "docstring": "Test reading of a file with a huge column.", "start_line": 1196, "end_line": 1220, "is_async": false, "is_method": false}, {"name": "test_data_out_of_range", "qualified_name": "test_data_out_of_range", "args": ["parallel", "fast_reader", "guess"], "decorators": ["pytest.mark.parametrize('guess', [True, False])", "pytest.mark.parametrize('fast_reader', [False, {'use_fast_converter': False}, {'use_fast_converter': True}])", "pytest.mark.parametrize('parallel', [False, True])"], "docstring": "Numbers with exponents beyond float64 range (|~4.94e-324 to 1.7977e+308|)\nshall be returned as 0 and +-inf respectively by the C parser, just like\nthe Python parser.\nTest fast converter only to nominal accuracy.", "start_line": 1231, "end_line": 1335, "is_async": false, "is_method": false}, {"name": "test_data_at_range_limit", "qualified_name": "test_data_at_range_limit", "args": ["parallel", "fast_reader", "guess"], "decorators": ["pytest.mark.parametrize('guess', [True, False])", "pytest.mark.parametrize('fast_reader', [False, {'use_fast_converter': False}, {'use_fast_converter': True}])", "pytest.mark.parametrize('parallel', [False, True])"], "docstring": "Test parsing of fixed-format float64 numbers near range limits\n(|~4.94e-324 to 1.7977e+308|) - within limit for full precision\n(|~2.5e-307| for strtod C parser, factor 10 better for fast_converter)\nexact numbers shall be returned, beyond that an Overflow warning raised.\nInput of exactly 0.0 must not", "start_line": 1345, "end_line": 1417, "is_async": false, "is_method": false}, {"name": "test_int_out_of_range", "qualified_name": "test_int_out_of_range", "args": ["parallel", "guess"], "decorators": ["pytest.mark.parametrize('guess', [True, False])", "pytest.mark.parametrize('parallel', [False, True])"], "docstring": "Integer numbers outside int range shall be returned as string columns\nconsistent with the standard (Python) parser (no 'upcasting' to float).", "start_line": 1422, "end_line": 1459, "is_async": false, "is_method": false}, {"name": "test_int_out_of_order", "qualified_name": "test_int_out_of_order", "args": ["guess"], "decorators": ["pytest.mark.parametrize('guess', [True, False])"], "docstring": "Mixed columns should be returned as float, but if the out-of-range integer\nshows up first, it will produce a string column - with both readers.\nBroken with the parallel fast_reader.", "start_line": 1463, "end_line": 1486, "is_async": false, "is_method": false}, {"name": "test_fortran_reader", "qualified_name": "test_fortran_reader", "args": ["parallel", "guess"], "decorators": ["pytest.mark.parametrize('guess', [True, False])", "pytest.mark.parametrize('parallel', [False, True])"], "docstring": "Make sure that ascii.read() can read Fortran-style exponential notation\nusing the fast_reader.", "start_line": 1491, "end_line": 1549, "is_async": false, "is_method": false}, {"name": "test_fortran_invalid_exp", "qualified_name": "test_fortran_invalid_exp", "args": ["parallel", "guess"], "decorators": ["pytest.mark.parametrize('guess', [True, False])", "pytest.mark.parametrize('parallel', [False, True])"], "docstring": "Test Fortran-style exponential notation in the fast_reader with invalid\nexponent-like patterns (no triple-digits) to make sure they are returned\nas strings instead, as with the standard C parser.", "start_line": 1554, "end_line": 1638, "is_async": false, "is_method": false}, {"name": "test_fortran_reader_notbasic", "qualified_name": "test_fortran_reader_notbasic", "args": [], "decorators": [], "docstring": "Check if readers without a fast option raise a value error when a\nfast_reader is asked for (implies the default 'guess=True').", "start_line": 1641, "end_line": 1719, "is_async": false, "is_method": false}, {"name": "test_dict_kwarg_integrity", "qualified_name": "test_dict_kwarg_integrity", "args": ["fast_reader", "guess"], "decorators": ["pytest.mark.parametrize('guess', [True, False])", "pytest.mark.parametrize('fast_reader', [{'exponent_style': 'D'}, {'exponent_style': 'A'}])"], "docstring": "Check if dictionaries passed as kwargs (fast_reader in this test) are\nleft intact by ascii.read()", "start_line": 1726, "end_line": 1735, "is_async": false, "is_method": false}, {"name": "test_read_empty_basic_table_with_comments", "qualified_name": "test_read_empty_basic_table_with_comments", "args": ["fast_reader"], "decorators": ["pytest.mark.parametrize('fast_reader', [False, {'parallel': True}, {'parallel': False}])"], "docstring": "Test for reading a \"basic\" format table that has no data but has comments.\nTests the fix for #8267.", "start_line": 1741, "end_line": 1754, "is_async": false, "is_method": false}, {"name": "test_conversion_fast", "qualified_name": "test_conversion_fast", "args": ["fast_reader"], "decorators": ["pytest.mark.parametrize('fast_reader', [{'use_fast_converter': True}, {'exponent_style': 'A'}])"], "docstring": "The reader should try to convert each column to ints. If this fails, the\nreader should try to convert to floats. Failing this, i.e. on parsing\nnon-numeric input including isolated positive/negative signs, it should\nfall back to strings.", "start_line": 1760, "end_line": 1781, "is_async": false, "is_method": false}, {"name": "test_newline_as_delimiter", "qualified_name": "test_newline_as_delimiter", "args": ["delimiter", "fast_reader"], "decorators": ["pytest.mark.parametrize('delimiter', ['\\n', '\\r'])", "pytest.mark.parametrize('fast_reader', [False, True, 'force'])"], "docstring": "Check that newline characters are correctly handled as delimiters.\nTests the fix for #9928.", "start_line": 1786, "end_line": 1819, "is_async": false, "is_method": false}, {"name": "test_single_line_string", "qualified_name": "test_single_line_string", "args": ["delimiter", "fast_reader"], "decorators": ["pytest.mark.parametrize('delimiter', [' ', '|', '\\n', '\\r'])", "pytest.mark.parametrize('fast_reader', [False, True, 'force'])"], "docstring": "String input without a newline character is interpreted as filename,\nunless element of an iterable. Maybe not logical, but test that it is\nat least treated consistently.", "start_line": 1824, "end_line": 1848, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_err