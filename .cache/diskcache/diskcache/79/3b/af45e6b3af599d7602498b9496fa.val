tart_line": 378, "end_line": 420, "is_async": false, "is_method": false}, {"name": "test_scales_for_delta_minus_delta", "qualified_name": "test_scales_for_delta_minus_delta", "args": ["self"], "decorators": [], "docstring": "dT(X) +/- dT2(Y) -- Add/subtract JDs for dT(X) and dT(Y).X\n\nI.e. this will succeed if dT(Y) can be converted to scale X.\nReturns delta time in scale X", "start_line": 422, "end_line": 492, "is_async": false, "is_method": false}, {"name": "test_scales_for_delta_scale_is_none", "qualified_name": "test_scales_for_delta_scale_is_none", "args": ["self", "scale", "op"], "decorators": ["pytest.mark.parametrize(('scale', 'op'), list(itertools.product(TIME_SCALES, (operator.add, operator.sub))))"], "docstring": "T(X) +/- dT(None) or T(X) +/- Quantity(time-like)\n\nThis is always allowed and just adds JDs, i.e., the scale of\nthe TimeDelta or time-like Quantity will be taken to be X.\nThe one exception is again for X=UTC, where TAI is assumed instead,\nso that a day is always defined as 86400 seconds.", "start_line": 498, "end_line": 531, "is_async": false, "is_method": false}, {"name": "test_delta_day_is_86400_seconds", "qualified_name": "test_delta_day_is_86400_seconds", "args": ["self", "scale"], "decorators": ["pytest.mark.parametrize('scale', TIME_SCALES)"], "docstring": "TimeDelta or Quantity holding 1 day always means 24*60*60 seconds\n\nThis holds true for all timescales but UTC, for which leap-second\ndays are longer or shorter by one second.", "start_line": 534, "end_line": 555, "is_async": false, "is_method": false}, {"name": "is_consistent", "qualified_name": "is_consistent", "args": ["time_delta"], "decorators": [], "docstring": "", "start_line": 229, "end_line": 234, "is_async": false, "is_method": false}], "classes": [{"name": "TestTimeDelta", "bases": [], "methods": ["setup_method", "test_sub", "test_add", "test_add_vector", "test_sub_vector", "test_copy_timedelta", "test_neg_abs", "test_mul_div", "test_mean", "test_keep_properties", "t