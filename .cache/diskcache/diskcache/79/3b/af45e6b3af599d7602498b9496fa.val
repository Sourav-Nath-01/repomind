 "keyword", "args": ["self"], "decorators": ["property"], "docstring": "Returns the keyword name parsed from the card image.", "start_line": 222, "end_line": 231, "is_async": false, "is_method": false}, {"name": "keyword", "qualified_name": "keyword", "args": ["self", "keyword"], "decorators": ["keyword.setter"], "docstring": "Set the key attribute; once set it cannot be modified.", "start_line": 234, "end_line": 282, "is_async": false, "is_method": false}, {"name": "value", "qualified_name": "value", "args": ["self"], "decorators": ["property"], "docstring": "The value associated with the keyword stored in this card.", "start_line": 285, "end_line": 303, "is_async": false, "is_method": false}, {"name": "value", "qualified_name": "value", "args": ["self", "value"], "decorators": ["value.setter"], "docstring": "", "start_line": 306, "end_line": 383, "is_async": false, "is_method": false}, {"name": "value", "qualified_name": "value", "args": ["self"], "decorators": ["value.deleter"], "docstring": "", "start_line": 386, "end_line": 398, "is_async": false, "is_method": false}, {"name": "rawkeyword", "qualified_name": "rawkeyword", "args": ["self"], "decorators": ["property"], "docstring": "On record-valued keyword cards this is the name of the standard <= 8\ncharacter FITS keyword that this RVKC is stored in.  Otherwise it is\nthe card's normal keyword.", "start_line": 401, "end_line": 412, "is_async": false, "is_method": false}, {"name": "rawvalue", "qualified_name": "rawvalue", "args": ["self"], "decorators": ["property"], "docstring": "On record-valued keyword cards this is the raw string value in\nthe ``<field-specifier>: <value>`` format stored in the card in order\nto represent a RVKC.  Otherwise it is the card's normal value.", "start_line": 415, "end_line": 426, "is_async": false, "is_method": false}, {"name": "comment", "qualified_name": "comment", "args": ["self"], "decorators": ["property"], "docstring": "Get the comment attribute from the card image if not already set.", "start_line": 429, "end_line": 438, "is_async": false, "is_method": false}, {"name": "comment", "qualified_name": "comment", "args": ["self", "comment"], "decorators": ["comment.setter"], "docstring": "", "start_line": 441, "end_line": 471, "is_async": false, "is_method": false}, {"name": "comment", "qualified_name": "comment", "args": ["self"], "decorators": ["comment.deleter"], "docstring": "", "start_line": 474, "end_line": 481, "is_async": false, "is_method": false}, {"name": "field_specifier", "qualified_name": "field_specifier", "args": ["self"], "decorators": ["property"], "docstring": "The field-specifier of record-valued keyword cards; always `None` on\nnormal cards.", "start_line": 484, "end_line": 494, "is_async": false, "is_method": false}, {"name": "field_specifier", "qualified_name": "field_specifier", "args": ["self", "field_specifier"], "decorators": ["field_specifier.setter"], "docstring": "", "start_line": 497, "end_line": 512, "is_async": false, "is_method": false}, {"name": "field_specifier", "qualified_name": "field_specifier", "args": ["self"], "decorators": ["field_specifier.deleter"], "docstring": "", "start_line": 515, "end_line": 519, "is_async": false, "is_method": false}, {"name": "image", "qualified_name": "image", "args": ["self"], "decorators": ["property"], "docstring": "The card \"image\", that is, the 80 byte character string that represents\nthis card in an actual FITS header.", "start_line": 522, "end_line": 531, "is_async": false, "is_method": false}, {"name": "is_blank", "qualified_name": "is_blank", "args": ["self"], "decorators": ["property"], "docstring": "`True` if the card is completely blank--that is, it has no keyword,\nvalue, or comment.  It appears in the header as 80 spaces.\n\nReturns `False` otherwise.", "start_line": 534, "end_line": 553, "is_async": false, "is_method": false}, {"name": "fromstring", "qualified_name": "fromstring", "args": ["cls", "image"], "decorators": ["classmethod"], "docstring": "Construct a `Card` object from a (raw) string. It will pad the string\nif it is not the length of a card image (80 columns).  If the card\nimage is longer than 80 columns, assume it contains ``CONTINUE``\ncard(s).", "start_line": 556, "end_line": 573, "is_async": false, "is_method": false}, {"name": "normalize_keyword", "qualified_name": "normalize_keyword", "args": ["cls", "keyword"], "decorators": ["classmethod"], "docstring": "`classmethod` to convert a keyword value that may contain a\nfield-specifier to uppercase.  The effect is to raise the key to\nuppercase and leave the field specifier in its original case.\n\nParameters\n----------\nkeyword : or str\n    A keyword value or a ``keyword.field-specifier`` value", "start_line": 576, "end_line": 606, "is_async": false, "is_method": false}, {"name": "_check_if_rvkc", "qualified_name": "_check_if_rvkc", "args": ["self"], "decorators": [], "docstring": "Determine whether or not the card is a record-valued keyword card.\n\nIf one argument is given, that argument is treated as a full card image\nand parsed as such.  If two arguments are given, the first is treated\nas the card keyword (including the field-specifier if the card is\nintended as a RVKC), and", "start_line": 608, "end_line": 656, "is_async": false, "is_method": false}, {"name": "_check_if_rvkc_image", "qualified_name": "_check_if_rvkc_image", "args": ["self"], "decorators": [], "docstring": "Implements `Card._check_if_rvkc` for the case of an unparsed card\nimage.  If given one argument this is the full intact image.  If given\ntwo arguments the card has already been split between keyword and\nvalue+comment at the standard value indicator '= '.", "start_line": 658, "end_line": 692, "is_async": false, "is_method": false}, {"name": "_init_rvkc", "qualified_name": "_init_rvkc", "args": ["self", "keyword", "field_specifier", "field", "value"], "decorators": [], "docstring": "Sort of addendum to Card.__init__ to set the appropriate internal\nattributes if the card was determined to be a RVKC.", "start_line": 694, "end_line": 704, "is_async": false, "is_method": false}, {"name": "_parse_keyword", "qualified_name": "_parse_keyword", "args": ["self"], "decorators": [], "docstring": "", "start_line": 706, "end_line": 749, "is_async": false, "is_method": false}, {"name": "_parse_value", "qualified_name": "_parse_value", "args": ["self"], "decorators": [], "docstring": "Extract the keyword value from the card image.", "start_line": 751, "end_line": 803, "is_async": false, "is_method": false}, {"name": "_parse_comment", "qualified_name": "_parse_comment", "args": ["self"], "decorators": [], "docstring": "Extract the keyword value from the card image.", "start_line": 805, "end_line": 827, "is_async": false, "is_method": false}, {"name": "_split", "qualified_name": "_split", "args": ["self"], "decorators": [], "docstring": "Split the card image between the keyword and the rest of the card.", "start_line": 829, "end_line": 895, "is_async": false, "is_method": false}, {"name": "_fix_keyword", "qualified_name": "_fix_keyword", "args": ["self"], "decorators": [], "docstring": "", "start_line": 897, "end_line": 903, "is_async": false, "is_method": false}, {"name": "_fix_value", "qualified_name": "_fix_value", "args": ["self"], "decorators": [], "docstring": "Fix the card image for fixable non-standard compliance.", "start_line": 905, "end_line": 942, "is_async": false, "is_method": false}, {"name": "_format_keyword", "qualified_name": "_format_keyword", "args": ["self"], "decorators": [], "docstring": "", "start_line": 944, "end_line": 954, "is_async": false, "is_method": false}, {"name": "_format_value", "qualified_name": "_format_value", "args": ["self"], "decorators": [], "docstring": "", "start_line": 956, "end_line": 987, "is_async": false, "is_method": false}, {"name": "_format_comment", "qualified_name": "_format_comment", "args": ["self"], "decorators": [], "docstring": "", "start_line": 989, "end_line": 993, "is_async": false, "is_method": false}, {"name": "_format_image", "qualified_name": "_format_image", "args": ["self"], "decorators": [], "docstring": "", "start_line": 995, "end_line": 1042, "is_async": false, "is_method": false}, {"name": "_format_long_image", "qualified_name": "_format_long_image", "args": ["self"], "decorators": [], "docstring": "Break up long string value/comment into ``CONTINUE`` cards.\nThis is a primitive implementation: it will put the value\nstring in one block and the comment string in another.  Also,\nit does not break at the blank space between words.  So it may\nnot look pretty.", "start_line": 1044, "end_line": 1093, "is_async": false, "is_method": false}, {"name": "_format_long_commentary_image", "qualified_name": "_format_long_commentary_image", "args": ["self"], "decorators": [], "docstring": "If a commentary card's value is too long to fit on a single card, this\nwill render the card as multiple consecutive commentary card of the\nsame type.", "start_line": 1095, "end_line": 1108, "is_async": false, "is_method": false}, {"name": "_verify", "qualified_name": "_verify", "args": ["self", "option"], "decorators": [], "docstring": "", "start_line": 1110, "end_line": 1217, "is_async": false, "is_method": false}, {"name": "_itersubcards", "qualified_name": "_itersubcards", "args": ["self"], "decorators": [], "docstring": "If the card image is greater than 80 characters, it should consist of a\nnormal card followed by one or more CONTINUE card.  This method returns\nthe subcards that make up this logical card.\n\nThis can also support the case where a HISTORY or COMMENT card has a\nlong value that is stored internally as m", "start_line": 1219, "end_line": 1243, "is_async": false, "is_method": false}], "classes": [{"name": "Undefined", "bases": [], "methods": ["__init__"], "docstring": "Undefined value.", "start_line": 30, "end_line": 35}, {"name": "Card", "bases": ["_Verify"], "methods": ["__init__", "__repr__", "__str__", "__len__", "__getitem__", "keyw