ias": ""}, {"module": "numpy.core.arrayprint", "names": ["_get_format_function"], "is_from": true, "alias": ""}, {"module": "astropy.utils.masked", "names": ["Masked"], "is_from": true, "alias": ""}], "functions": [{"name": "_get_data_and_masks", "qualified_name": "_get_data_and_masks", "args": [], "decorators": [], "docstring": "Separate out arguments into tuples of data and masks.\n\nAn all-False mask is created if an argument does not have a mask.", "start_line": 164, "end_line": 175, "is_async": false, "is_method": false}, {"name": "datetime_as_string", "qualified_name": "datetime_as_string", "args": ["arr"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 180, "end_line": 181, "is_async": false, "is_method": false}, {"name": "sinc", "qualified_name": "sinc", "args": ["x"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 185, "end_line": 186, "is_async": false, "is_method": false}, {"name": "iscomplex", "qualified_name": "iscomplex", "args": ["x"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 190, "end_line": 191, "is_async": false, "is_method": false}, {"name": "unwrap", "qualified_name": "unwrap", "args": ["p"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 195, "end_line": 196, "is_async": false, "is_method": false}, {"name": "nan_to_num", "qualified_name": "nan_to_num", "args": ["x", "copy", "nan", "posinf", "neginf"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 200, "end_line": 202, "is_async": false, "is_method": false}, {"name": "masked_a_helper", "qualified_name": "masked_a_helper", "args": ["a"], "decorators": ["apply_to_both(helps={np.copy, np.asfarray, np.resize, np.moveaxis, np.rollaxis, np.roll})"], "docstring": "", "start_line": 211, "end_line": 213, "is_async": false, "is_method": false}, {"name": "masked_m_helper", "qualified_name": "masked_m_helper", "args": ["m"], "decorators": ["apply_to_both(helps={np.flip, np.flipud, np.fliplr, np.rot90, np.triu, np.tril})"], "docstring": "", "start_line": 217, "end_line": 219, "is_async": false, "is_method": false}, {"name": "masked_v_helper", "qualified_name": "masked_v_helper", "args": ["v"], "decorators": ["apply_to_both(helps={np.diag, np.diagflat})"], "docstring": "", "start_line": 223, "end_line": 225, "is_async": false, "is_method": false}, {"name": "masked_arr_helper", "qualified_name": "masked_arr_helper", "args": ["array"], "decorators": ["apply_to_both(helps={np.delete})"], "docstring": "", "start_line": 229, "end_line": 231, "is_async": false, "is_method": false}, {"name": "broadcast_to", "qualified_name": "broadcast_to", "args": ["array", "shape", "subok"], "decorators": ["apply_to_both"], "docstring": "Broadcast array to the given shape.\n\nLike `numpy.broadcast_to`, and applied to both unmasked data and mask.\nNote that ``subok`` is taken to mean whether or not subclasses of\nthe unmasked data and mask are allowed, i.e., for ``subok=False``,\na `~astropy.utils.masked.MaskedNDArray` will be returned.", "start_line": 235, "end_line": 244, "is_async": false, "is_method": false}, {"name": "outer", "qualified_name": "outer", "args": ["a", "b", "out"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 248, "end_line": 249, "is_async": false, "is_method": false}, {"name": "empty_like", "qualified_name": "empty_like", "args": ["prototype", "dtype", "order", "subok", "shape"], "decorators": ["dispatched_function"], "docstring": "Return a new array with the same shape and type as a given array.\n\nLike `numpy.empty_like`, but will add an empty mask.", "start_line": 253, "end_line": 271, "is_async": false, "is_method": false}, {"name": "zeros_like", "qualified_name": "zeros_like", "args": ["a", "dtype", "order", "subok", "shape"], "decorators": ["dispatched_function"], "docstring": "Return an array of zeros with the same shape and type as a given array.\n\nLike `numpy.zeros_like`, but will add an all-false mask.", "start_line": 275, "end_line": 283, "is_async": false, "is_method": false}, {"name": "ones_like", "qualified_name": "ones_like", "args": ["a", "dtype", "order", "subok", "shape"], "decorators": ["dispatched_function"], "docstring": "Return an array of ones with the same shape and type as a given array.\n\nLike `numpy.ones_like`, but will add an all-false mask.", "start_line": 287, "end_line": 295, "is_async": false, "is_method": false}, {"name": "full_like", "qualified_name": "full_like", "args": ["a", "fill_value", "dtype", "order", "subok", "shape"], "decorators": ["dispatched_function"], "docstring": "Return a full array with the same shape and type as a given array.\n\nLike `numpy.full_like`, but with a mask that is also set.\nIf ``fill_value`` is `numpy.ma.masked`, the data will be left unset\n(i.e., as created by `numpy.empty_like`).", "start_line": 299, "end_line": 308, "is_async": false, "is_method": false}, {"name": "put", "qualified_name": "put", "args": ["a", "ind", "v", "mode"], "decorators": ["dispatched_function"], "docstring": "Replaces specified elements of an array with given values.\n\nLike `numpy.put`, but for masked array ``a`` and possibly masked\nvalue ``v``.  Masked indices ``ind`` are not supported.", "start_line": 312, "end_line": 327, "is_async": false, "is_method": false}, {"name": "putmask", "qualified_name": "putmask", "args": ["a", "mask", "values"], "decorators": ["dispatched_function"], "docstring": "Changes elements of an array based on conditional and input values.\n\nLike `numpy.putmask`, but for masked array ``a`` and possibly masked\n``values``.  Masked ``mask`` is not supported.", "start_line": 331, "end_line": 345, "is_async": false, "is_method": false}, {"name": "place", "qualified_name": "place", "args": ["arr", "mask", "vals"], "decorators": ["dispatched_function"], "docstring": "Change elements of an array based on conditional and input values.\n\nLike `numpy.place`, but for masked array ``a`` and possibly masked\n``values``.  Masked ``mask`` is not supported.", "start_line": 349, "end_line": 363, "is_async": false, "is_method": false}, {"name": "copyto", "qualified_name": "copyto", "args": ["dst", "src", "casting", "where"], "decorators": ["dispatched_function"], "docstring": "Copies values from one array to another, broadcasting as necessary.\n\nLike `numpy.copyto`, but for masked destination ``dst`` and possibly\nmasked source ``src``.", "start_line": 367, "end_line": 383, "is_async": false, "is_method": false}, {"name": "packbits", "qualified_name": "packbits", "args": ["a"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 387, "end_line": 390, "is_async": false, "is_method": false}, {"name": "unpackbits", "qualified_name": "unpackbits", "args": ["a"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 394, "end_line": 399, "is_async": false, "is_method": false}, {"name": "bincount", "qualified_name": "bincount", "args": ["x", "weights", "minlength"], "decorators": ["dispatched_function"], "docstring": "Count number of occurrences of each value in array of non-negative ints.\n\nLike `numpy.bincount`, but masked entries in ``x`` will be skipped.\nAny masked entries in ``weights`` will lead the corresponding bin to\nbe masked.", "start_line": 403, "end_line": 425, "is_async": false, "is_method": false}, {"name": "msort", "qualified_name": "msort", "args": ["a"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 429, "end_line": 432, "is_async": false, "is_method": false}, {"name": "sort_complex", "qualified_name": "sort_complex", "args": ["a"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 436, "end_line": 448, "is_async": false, "is_method": false}, {"name": "concatenate", "qualified_name": "concatenate", "args": ["arrays", "axis", "out", "dtype", "casting"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 452, "end_line": 467, "is_async": false, "is_method": false}, {"name": "append", "qualified_name": "append", "args": ["arr", "values", "axis"], "decorators": ["apply_to_both"], "docstring": "", "start_line": 471, "end_line": 473, "is_async": false, "is_method": false}, {"name": "block", "qualified_name": "block", "args": ["arrays"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 477, "end_line": 498, "is_async": false, "is_method": false}, {"name": "broadcast_arrays", "qualified_name": "broadcast_arrays", "args": [], "decorators": ["dispatched_function"], "docstring": "Broadcast arrays to a common shape.\n\nLike `numpy.broadcast_arrays`, applied to both unmasked data and masks.\nNote that ``subok`` is taken to mean whether or not subclasses of\nthe unmasked data and masks are allowed, i.e., for ``subok=False``,\n`~astropy.utils.masked.MaskedNDArray` instances will be r", "start_line": 502, "end_line": 527, "is_async": false, "is_method": false}, {"name": "insert", "qualified_name": "insert", "args": ["arr", "obj", "values", "axis"], "decorators": ["apply_to_both"], "docstring": "Insert values along the given axis before the given indices.\n\nLike `numpy.insert` but for possibly masked ``arr`` and ``values``.\nMasked ``obj`` is not supported.", "start_line": 531, "end_line": 543, "is_async": false, "is_method": false}, {"name": "count_nonzero", "qualified_name": "count_nonzero", "args": ["a", "axis"], "decorators": ["dispatched_function"], "docstring": "Counts the number of non-zero values in the array ``a``.\n\nLike `numpy.count_nonzero`, with masked values counted as 0 or `False`.", "start_line": 547, "end_line": 553, "is_async": false, "is_method": false}, {"name": "_masked_median_1d", "qualified_name": "_masked_median_1d", "args": ["a", "overwrite_input"], "decorators": [], "docstring": "", "start_line": 556, "end_line": 562, "is_async": false, "is_method": false}, {"name": "_masked_median", "qualified_name": "_masked_median", "args": ["a", "axis", "out", "overwrite_input"], "decorators": [], "docstring": "", "start_line": 565, "end_line": 574, "is_async": false, "is_method": false}, {"name": "median", "qualified_name": "median", "args": ["a", "axis", "out"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 578, "end_line": 596, "is_async": false, "is_method": false}, {"name": "_masked_quantile_1d", "qualified_name": "_masked_quantile_1d", "args": ["a", "q"], "decorators": [], "docstring": "Private function for rank 1 arrays. Compute quantile ignoring NaNs.\nSee nanpercentile for parameter usage.", "start_line": 599, "end_line": 609, "is_async": false, "is_method": false}, {"name": "_masked_quantile", "qualified_name": "_masked_quantile", "args": ["a", "q", "axis", "out"], "decorators": [], "docstring": "", "start_line": 612, "end_line": 627, "is_async": false, "is_method": false}, {"name": "quantile", "qualified_name": "quantile", "args": ["a", "q", "axis", "out"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 631, "end_line": 651, "is_async": false, "is_method": false}, {"name": "percentile", "qualified_name": "percentile", "args": ["a", "q"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 655, "end_line": 657, "is_async": false, "is_method": false}, {"name": "array_equal", "qualified_name": "array_equal", "args": ["a1", "a2", "equal_nan"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 661, "end_line": 669, "is_async": false, "is_method": false}, {"name": "array_equiv", "qualified_name": "array_equiv", "args": ["a1", "a2"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 673, "end_line": 674, "is_async": false, "is_method": false}, {"name": "where", "qualified_name": "where", "args": ["condition"], "decorators": ["dispatched_function"], "docstring": "", "start_line": 678, "end_line": 691, "is_async": false, "is_method": false}, {"name": "choose", "qualified_name": "choose", "args": ["a", "choices", "out", "mode"], "decorators": ["dispatched_function"], "docstring": "Construct an array from an index array and a set of arrays to choose from.\n\nLike `numpy.choose`.  Masked indices in ``a`` will lead to masked output\nvalues and underlying data values are ignored if out of bounds (for\n``mode='raise'``).  Any values masked in ``choices`` will be propagated\nif chosen.", "start_line": 695, "end_line": 726, "is_async": false, "is_method": false}, {"name": "select", "qualified_name": "select", "args": ["condlist", "choicelist", "default"], "decorators": ["apply_to_both"], "docstring": "Return an array drawn from elements in choicelist, depending on conditions.\n\nLike `numpy.select`, with masks in ``choicelist`` are propagated.\nAny masks in ``condlist`` are ignored.", "start_line": 730, "end_line": 748, "is_async": false, "is_method": false}, {"name": "piecewise", "qualified_name": "piecewise", "args": ["x", "condlist", "funclist"], "decorators": ["dispatched_function"], "docstring": "Evaluate a piecewise-defined function.\n\nLike `numpy.piecewise` but for masked input array ``x``.\nAny masks in ``condlist`` are ignored.", "start_line": 752, "end_line": 798, "is_async": false, "is_method": false}, {"name": "interp", "qualified_name": "interp", "args": ["x", "xp", "fp"], "decorators": ["dispatched_function"], "docstring": "One-dimensional linear interpolation.\n\nLike `numpy.interp`, but any masked points in ``xp`` and ``fp``\nare ignored.  Any masked values in ``x`` will still be evaluated,\nbut masked on output.", "start_line": 802, "end_line": 821, "is_async": false, "is_method": false}, {"name": "lexsort", "qualified_name": "lexsort", "args": ["keys", "axis"], "decorators": ["dispatched_function"], "docstring": "Perform an indirect stable sort using a sequence of keys.\n\nLike `numpy.lexsort` but for possibly masked ``keys``.  Masked\nvalues are sorted towards the end for each key.", "start_line": 825, "end_line": 847, "is_async": false, "is_method": false}, {"name": "apply_over_axes", "qualified_name": "apply_over_axes", "args": ["