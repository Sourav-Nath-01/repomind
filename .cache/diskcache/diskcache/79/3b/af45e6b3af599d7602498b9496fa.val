ven class, in depth first order.\n\n>>> class A: pass\n>>> class B(A): pass\n>>> class C(A): pass\n>>> class D(B,C): pass\n>>> class E(D): pass\n>>>\n>>> for cls in itersubclasses(A):\n...     print(cls.__name__)\nB\nD\nE\nC\n>>> # get ALL classes currently defined\n>>> [cls.__", "start_line": 158, "end_line": 190, "is_async": false, "is_method": false}, {"name": "ignore_sigint", "qualified_name": "ignore_sigint", "args": ["func"], "decorators": [], "docstring": "This decorator registers a custom SIGINT handler to catch and ignore SIGINT\nuntil the wrapped function is completed.", "start_line": 193, "end_line": 238, "is_async": false, "is_method": false}, {"name": "encode_ascii", "qualified_name": "encode_ascii", "args": ["s"], "decorators": [], "docstring": "", "start_line": 258, "end_line": 268, "is_async": false, "is_method": false}, {"name": "decode_ascii", "qualified_name": "decode_ascii", "args": ["s"], "decorators": [], "docstring": "", "start_line": 271, "end_line": 304, "is_async": false, "is_method": false}, {"name": "isreadable", "qualified_name": "isreadable", "args": ["f"], "decorators": [], "docstring": "Returns True if the file-like object can be read from.  This is a common-\nsense approximation of io.IOBase.readable.", "start_line": 307, "end_line": 327, "is_async": false, "is_method": false}, {"name": "iswritable", "qualified_name": "iswritable", "args": ["f"], "decorators": [], "docstring": "Returns True if the file-like object can be written to.  This is a common-\nsense approximation of io.IOBase.writable.", "start_line": 330, "end_line": 350, "is_async": false, "is_method": false}, {"name": "isfile", "qualified_name": "isfile", "args": ["f"], "decorators": [], "docstring": "Returns True if the given object represents an OS-level file (that is,\n``isinstance(f, file)``).\n\nOn Python 3 this also returns True if the given object is higher level\nwrapper on top of a FileIO object, such as a TextIOWrapper.", "start_line": 353, "end_line": 367, "is_async": false, "is_method": false}, {"name": "fileobj_name", "qualified_name": "fileobj_name", "args": ["f"], "decorators": [], "docstring": "Returns the 'name' of file-like object *f*, if it has anything that could be\ncalled its name.  Otherwise f's class or type is returned.  If f is a\nstring f itself is returned.", "start_line": 370, "end_line": 394, "is_async": false, "is_method": false}, {"name": "fileobj_closed", "qualified_name": "fileobj_closed", "args": ["f"], "decorators": [], "docstring": "Returns True if the given file-like object is closed or if *f* is a string\n(and assumed to be a pathname).\n\nReturns False for all other types of objects, under the assumption that\nthey are file-like objects with no sense of a 'closed' state.", "start_line": 397, "end_line": 415, "is_async": false, "is_method": false}, {"name": "fileobj_mode", "qualified_name": "fileobj_mode", "args": ["f"], "decorators": [], "docstring": "Returns the 'mode' string of a file-like object if such a thing exists.\nOtherwise returns None.", "start_line": 418, "end_line": 447, "is_async": false, "is_method": false}, {"name": "_fileobj_normalize_mode", "qualified_name": "_fileobj_normalize_mode", "args": ["f"], "decorators": [], "docstring": "Takes care of some corner cases in Python where the mode string\nis either oddly formatted or does not truly represent the file mode.", "start_line": 450, "end_line": 472, "is_async": false, "is_method": false}, {"name": "fileobj_is_binary", "qualified_name": "fileobj_is_binary", "args": ["f"], "decorators": [], "docstring": "Returns True if the give file or file-like object has a file open in binary\nmode.  When in doubt, returns True by default.", "start_line": 475, "end_line": 492, "is_async": false, "is_method": false}, {"name": "translate", "qualified_name": "translate", "args": ["s", "table", "deletechars"], "decorators": [], "docstring": "", "start_line": 495, "end_line": 500, "is_async": false, "is_method": false}, {"name": "fill", "qualified_name": "fill", "args": ["text", "width"], "decorators": [], "docstring": "Like :func:`textwrap.wrap` but preserves existing paragraphs which\n:func:`textwrap.wrap` does not otherwise handle well.  Also handles section\nheaders.", "start_line": 503, "end_line": 517, "is_async": false, "is_method": false}, {"name": "_array_from_file", "qualified_name": "_array_from_file", "args": ["infile", "dtype", "count"], "decorators": [], "docstring": "Create a numpy array from a file or a file-like object.", "start_line": 528, "end_line": 562, "is_async": false, "is_method": false}, {"name": "_array_to_file", "qualified_name": "_array_to_file", "args": ["arr", "outfile"], "decorators": [], "docstring": "Write a numpy array to a file or a file-like object.\n\nParameters\n----------\narr : ndarray\n    The Numpy array to write.\noutfile : file-like\n    A file-like object such as a Python file object, an `io.BytesIO`, or\n    anything else with a ``write`` method.  The file object must support\n    the buffer", "start_line": 569, "end_line": 624, "is_async": false, "is_method": false}, {"name": "_array_to_file_like", "qualified_name": "_array_to_file_like", "args": ["arr", "fileobj"], "decorators": [], "docstring": "Write a `~numpy.ndarray` to a file-like object (which is not supported by\n`numpy.ndarray.tofile`).", "start_line": 627, "end_line": 666, "is_async": false, "is_method": false}, {"name": "_write_string", "qualified_name": "_write_string", "args": ["f", "s"], "decorators": [], "docstring": "Write a string to a file, encoding to ASCII if the file is open in binary\nmode, or decoding if the file is open in text mode.", "start_line": 669, "end_line": 683, "is_async": false, "is_method": false}, {"name": "_convert_array", "qualified_name": "_convert_array", "args": ["array", "dtype"], "decorators": [], "docstring": "Converts an array to a new dtype--if the itemsize of the new dtype is\nthe same as the old dtype and both types are not numeric, a view is\nreturned.  Otherwise a new array must be created.", "start_line": 686, "end_line": 701, "is_async": false, "is_method": false}, {"name": "_pseudo_zero", "qualified_name": "_pseudo_zero", "args": ["dtype"], "decorators": [], "docstring": "Given a numpy dtype, finds its \"zero\" point, which is exactly in the\nmiddle of its range.", "start_line": 704, "end_line": 714, "is_async": false, "is_method": false}, {"name": "_is_pseudo_integer", "qualified_name": "_is_pseudo_integer", "args": ["dtype"], "decorators": [], "docstring": "", "start_line": 717, "end_line": 720, "is_async": false, "is_method": false}, {"name": "_is_int", "qualified_name": "_is_int", "args": ["val"], "decorators": [], "docstring": "", "start_line": 723, "end_line": 724, "is_async": false, "is_method": false}, {"name": "_str_to_num", "qualified_name": "_str_to_num", "args": ["val"], "decorators": [], "docstring": "Converts a given string to either an int or a float if necessary.", "start_line": 727, "end_line": 734, "is_async": false, "is_method": false}, {"name": "_words_group", "qualified_name": "_words_group", "args": ["s", "width"], "decorators": [], "docstring": "Split a long string into parts where each part is no longer than ``strlen``\nand no word is cut into two pieces.  But if there are any single words\nwhich are longer than ``strlen``, then they will be split in the middle of\nthe word.", "start_line": 737, "end_line": 777, "is_async": false, "is_method": false}, {"name": "_tmp_name", "qualified_name": "_tmp_name", "args": ["input"], "decorators": [], "docstring": "Create a temporary file name which should not already exist.  Use the\ndirectory of the input file as the base name of the mkstemp() output.", "start_line": 780, "end_line": 789, "is_async": false, "is_method": false}, {"name": "_get_array_mmap", "qualified_name": "_get_array_mmap", "args": ["array"], "decorators": [], "docstring": "If the array has an mmap.mmap at base of its base chain, return the mmap\nobject; otherwise return None.", "start_