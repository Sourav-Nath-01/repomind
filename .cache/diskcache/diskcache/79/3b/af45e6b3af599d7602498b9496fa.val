coord_equal"], "is_from": true, "alias": ""}, {"module": "astropy.coordinates.tests.test_representation", "names": ["representation_equal"], "is_from": true, "alias": ""}, {"module": "astropy.table", "names": ["Column", "NdarrayMixin", "QTable", "Table", "hstack", "join", "serialize", "table_helpers", "vstack"], "is_from": true, "alias": ""}, {"module": "astropy.table.column", "names": ["BaseColumn"], "is_from": true, "alias": ""}, {"module": "astropy.table.serialize", "names": ["represent_mixins_as_columns"], "is_from": true, "alias": ""}, {"module": "astropy.table.table_helpers", "names": ["ArrayWrapper"], "is_from": true, "alias": ""}, {"module": "astropy.utils.data_info", "names": ["ParentDtypeInfo"], "is_from": true, "alias": ""}, {"module": "astropy.utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}, {"module": "astropy.utils.metadata", "names": ["MergeConflictWarning"], "is_from": true, "alias": ""}, {"module": "conftest", "names": ["MIXIN_COLS"], "is_from": true, "alias": ""}, {"module": "astropy.io.ascii.connect", "names": ["_get_connectors_table"], "is_from": true, "alias": ""}], "functions": [{"name": "test_attributes", "qualified_name": "test_attributes", "args": ["mixin_cols"], "decorators": [], "docstring": "Required attributes for a column can be set.", "start_line": 37, "end_line": 76, "is_async": false, "is_method": false}, {"name": "check_mixin_type", "qualified_name": "check_mixin_type", "args": ["table", "table_col", "in_col"], "decorators": [], "docstring": "", "start_line": 79, "end_line": 91, "is_async": false, "is_method": false}, {"name": "test_make_table", "qualified_name": "test_make_table", "args": ["table_types", "mixin_cols"], "decorators": [], "docstring": "Make a table with the columns in mixin_cols, which is an ordered dict of\nthree cols: 'a' and 'b' are table_types.Column type, and 'm' is a mixin.", "start_line": 94, "end_line": 107, "is_async": false, "is_method": false}, {"name": "test_io_ascii_write", "qualified_name": "test_io_ascii_write", "args": [], "decorators": [], "docstring": "Test that table with mixin column can be written by io.ascii for\nevery pure Python writer.  No validation of the output is done,\nthis just confirms no exceptions.", "start_line": 110, "end_line": 122, "is_async": false, "is_method": false}, {"name": "test_votable_quantity_write", "qualified_name": "test_votable_quantity_write", "args": ["tmp_path"], "decorators": [], "docstring": "Test that table with Quantity mixin column can be round-tripped by\nio.votable.  Note that FITS and HDF5 mixin support are tested (much more\nthoroughly) in their respective subpackage tests\n(io/fits/tests/test_connect.py and io/misc/tests/test_hdf5.py).", "start_line": 125, "end_line": 139, "is_async": false, "is_method": false}, {"name": "test_io_time_write_fits_standard", "qualified_name": "test_io_time_write_fits_standard", "args": ["tmp_path", "table_types"], "decorators": ["pytest.mark.remote_data", "pytest.mark.parametrize('table_types', (Table, QTable))"], "docstring": "Test that table with Time mixin columns can be written by io.fits.\nValidation of the output is done. Test that io.fits writes a table\ncontaining Time mixin columns that can be partially round-tripped\n(metadata scale, location).\n\nNote that we postpone checking the \"local\" scale, since that cannot\nbe ", "start_line": 144, "end_line": 224, "is_async": false, "is_method": false}, {"name": "test_io_time_write_fits_local", "qualified_name": "test_io_time_write_fits_local", "args": ["tmp_path", "table_types"], "decorators": ["pytest.mark.parametrize('table_types', (Table, QTable))"], "docstring": "Test that table with a Time mixin with scale local can also be written\nby io.fits. Like ``test_io_time_write_fits_standard`` above, but avoiding\n``cxcsec`` format, which requires an epoch and thus cannot be used for a\nlocal time scale.", "start_line": 228, "end_line": 299, "is_async": false, "is_method": false}, {"name": "test_votable_mixin_write_fail", "qualified_name": "test_votable_mixin_write_fail", "args": ["mixin_cols"], "decorators": [], "docstring": "Test that table with mixin columns (excluding Quantity) cannot be written by\nio.votable.", "start_line": 302, "end_line": 318, "is_async": false, "is_method": false}, {"name": "test_join", "qualified_name": "test_join", "args": ["table_types"], "decorators": [], "docstring": "Join tables with mixin cols.  Use column \"i\" as proxy for what the\nresult should be for each mixin.", "start_line": 321, "end_line": 366, "is_async": false, "is_method": false}, {"name": "test_hstack", "qualified_name": "test_hstack", "args": ["table_types"], "decorators": [], "docstring": "Hstack tables with mixin cols.  Use column \"i\" as proxy for what the\nresult should be for each mixin.", "start_line": 369, "end_line": 406, "is_async": false, "is_method": false}, {"name": "assert_table_name_col_equal", "qualified_name": "assert_table_name_col_equal", "args": ["t", "name", "col"], "decorators": [], "docstring": "Assert all(t[name] == col), with special handling for known mixin cols.", "start_line": 409, "end_line": 424, "is_async": false, "is_method": false}, {"name": "test_get_items", "qualified_name": "test_get_items", "args": ["mixin_cols"], "decorators": [], "docstring": "Test that slicing / indexing table gives right values and col attrs inherit", "start_line": 427, "end_line": 444, "is_async": false, "is_method": false}, {"name": "test_info_preserved_pickle_copy_init", "qualified_name": "test_info_preserved_pickle_copy_init", "args": ["mixin_cols"], "decorators": [], "docstring": "Test copy, pickle, and init from class roundtrip preserve info.  This\ntests not only the mixin classes but a regular column as well.", "start_line": 447, "end_line": 480, "is_async": false, "is_method": false}, {"name": "check_share_memory", "qualified_name": "check_share_memory", "args": ["col1", "col2", "copy"], "decorators": [], "docstring": "Check whether data attributes in col1 and col2 share memory.\n\nIf copy=True, this should not be the case for any, while\nif copy=False, all should share memory.", "start_line": 483, "end_line": 508, "is_async": false, "is_method": false}, {"name": "test_add_column", "qualified_name": "test_add_column", "args": ["mixin_cols", "copy"], "decorators": ["pytest.mark.parametrize('copy', [True, False])"], "docstring": "Test that adding a column preserves values and attributes.\nFor copy=True, the data should be independent;\nfor copy=False, the data should be shared, but the instance independent.", "start_line": 512, "end_line": 575, "is_async": false, "is_method": false}, {"name": "test_vstack", "qualified_name": "test_vstack", "args": [], "decorators": [], "docstring": "Vstack tables with mixin cols.", "start_line": 578, "end_line": 585, "is_async": false, "is_method": false}, {"name": "test_insert_row", "qualified_name": "test_insert_row", "args": ["mixin_cols"], "decorators": [], "docstring": "Test inserting a row, which works for Column, Quantity, Time and SkyCoord.", "start_line": 588, "end_line": 612, "is_async": false, "is_method": false}, {"name": "test_insert_row_bad_unit", "qualified_name": "test_insert_row_bad_unit", "args": [], "decorators": [], "docstring": "Insert a row into a QTable with the wrong unit", "start_line": 615, "end_line": 624, "is_async": false, "is_method": false}, {"name": "test_convert_np_array", "qualified_name": "test_convert_np_array", "args": ["mixin_cols"], "decorators": [], "docstring": "Test that converting to numpy array creates an object dtype and that\neach instance in the array has the expected type.", "start_line": 627, "end_line": 636, "is_async": false, "is_method": false}, {"name": "test_assignment_and_copy", "qualified_name": "test_assignment_and_copy", "args": [], "decorators": [], "docstring": "Test that assignment of an int, slice, and fancy index works.\nAlong the way test that copying table works.", "start_line": 639, "end_line": 661, "is_async": false, "is_method": false}, {"name": "test_conversion_qtable_table", "qualified_name": "test_conversion_qtable_table", "args": [], "decorators": [], "docstring": "Test that a table round trips from QTable => Table => QTable", "start_line": 664, "end_line": 686, "is_async": false, "is_method": false}, {"name": "test_setitem_as_column_name", "qualified_name": "test_setitem_as_column_name", "args": [], "decorators": [], "docstring": "Test for mixin-related regression described in #3321.", "start_line": 689, "end_line": 697, "is_async": false, "is_method": false}, {"name": "test_quantity_representation", "qualified_name": "test_quantity_representation", "args": [], "decorators": [], "docstring": "Test that table representation of quantities does not have unit", "start_line": 700, "end_line": 711, "is_async": false, "is_method": false}, {"name": "test_representation_representation", "qualified_name": "test_representation_representation", "args": [], "decorators": [], "docstring": "Test that Representations are represented correctly.", "start_line": 714, "end_line": 763, "is_async": false, "is_method": false}, {"name": "test_skycoord_representation", "qualified_name": "test_skycoord_representation", "args": [], "decorators": [], "docstring": "Test that skycoord representation works, both in the way that the\nvalues are output and in changing the frame representation.", "start_line": 766, "end_line": 805, "is_async": false, "is_method": false}, {"name": "test_ndarray_mixin", "qualified_name": "test_ndarray_mixin", "args": ["as_ndarray_mixin"], "decorators": ["pytest.mark.parametrize('as_ndarray_mixin', [True, False])"], "docstring": "Test directly adding various forms of structured ndarray columns to a table.\nAdding as NdarrayMixin is expected to be somewhat unusual after #12644\n(which provides full support for structured array Column's). This test shows\nthat the end behavior is the same in both cases.", "start_line": 809, "end_line": 882, "is_async": false, "is_method": false}, {"name": "test_possible_string_format_functions", "qualified_name": "test_possible_string_format_functions", "args": [], "decorators": [], "docstring": "The QuantityInfo info class for Quantity implements a\npossible_string_format_functions() method that overrides the\nstandard pprint._possible_string_format_functions() function.\nTest this.", "start_line": 885, "end_line": 918, "is_async": false, "is_method": false}, {"name": "test_rename_mixin_columns", "qualified_name": "test_rename_mixin_columns", "args": ["mixin_cols"], "decorators": [], "docstring": "Rename a mixin column.", "start_line": 921, "end_line": 937, "is_async": false, "is_method": false}, {"name": "test_represent_mixins_as_columns_unit_fix", "qualified_name": "test_represent_mixins_as_columns_unit_fix", "args": [], "decorators": [], "docstring": "If the unit is invalid for a column that gets serialized this would\ncause an exception.  Fixed in #7481.", "start_line": 940, "end_line": 948, "is_async": false, "is_method": false}, {"name": "test_primary_data_column_gets_description", "qualified_name": "test_primary_data_column_gets_description", "args": [], "decorators": [], "docstring": "If the mixin defines a primary data column, that should get the\ndescription, format, etc., so no __info__ should be needed.", "start_line": 951, "end_line": 962, "is_async": false, "is_method": false}, {"name": "test_skycoord_with_velocity", "qualified_name": "test_skycoord_with_velocity", "args": [], "decorators": [], "docstring": "", "start_line": 965, "end_line": 973, "is_async": false, "is_method": false}, {"name": "test_ensure_input_info_is_unchanged", "qualified_name": "test_ensure_input_info_is_unchanged", "args": ["table_cls", "copy"], "decorators": ["pytest.mark.parametrize('copy', [True, False])", "pytest.mark.parametrize('table_cls', [Table, QTable])"], "docstring": "If a mixin input to a table has no info, it should stay that way.\n\nThis since having 'info' slows down slicing, etc.\nSee gh-11