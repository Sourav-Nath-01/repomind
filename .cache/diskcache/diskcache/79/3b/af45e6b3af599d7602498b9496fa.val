e": "_compute_matrix", "qualified_name": "_compute_matrix", "args": ["angle"], "decorators": ["staticmethod"], "docstring": "", "start_line": 555, "end_line": 561, "is_async": false, "is_method": false}], "classes": [{"name": "RotationSequence3D", "bases": ["Model"], "methods": ["__init__", "inverse", "evaluate"], "docstring": "Perform a series of rotations about different axis in 3D space.\n\nPositive angles represent a counter-clockwise rotation.\n\nParameters\n----------\nangles : array-like\n    Angles of rotation in deg in the order of axes_order.\naxes_order : str\n    A sequence of 'x', 'y', 'z' corresponding to axis of rota", "start_line": 69, "end_line": 136}, {"name": "SphericalRotationSequence", "bases": ["RotationSequence3D"], "methods": ["__init__", "n_inputs", "n_outputs", "evaluate"], "docstring": "Perform a sequence of rotations about arbitrary number of axes\nin spherical coordinates.\n\nParameters\n----------\nangles : list\n    A sequence of angles (in deg).\naxes_order : str\n    A sequence of characters ('x', 'y', or 'z') corresponding to the\n    axis of rotation and matching the order in ``angl", "start_line": 139, "end_line": 173}, {"name": "_EulerRotation", "bases": [], "methods": ["evaluate", "input_units", "return_units"], "docstring": "Base class which does the actual computation.", "start_line": 176, "end_line": 210}, {"name": "EulerAngleRotation", "bases": ["_EulerRotation", "Model"], "methods": ["__init__", "inverse", "evaluate"], "docstring": "Implements Euler angle intrinsic rotations.\n\nRotates one coordinate system into another (fixed) coordinate system.\nAll coordinate systems are right-handed. The sign of the angles is\ndetermined by the right-hand rule..\n\nParameters\n----------\nphi, theta, psi : float or `~astropy.units.Quantity` ['angl", "start_line": 213, "end_line": 287}, {"name": "_SkyRotation", "bases": ["_EulerRotation", "Model"], "methods": ["__init__", "_evaluate"], "docstring": "Base class for RotateNative2Celestial and RotateCelestial2Native.", "start_line": 290, "end_line": 324}, {"name": "RotateNative2Celestial", "bases": ["_SkyRotation"], "methods": ["input_units", "return_units", "__init__", "evaluate", "inverse"], "docstring": "Transform from Native to Celestial Spherical Coordinates.\n\nParameters\n----------\nlon : float or `~astropy.units.Quantity` ['angle']\n    Celestial longitude of the fiducial point.\nlat : float or `~astropy.units.Quantity` ['angle']\n    Celestial latitude of the fiducial point.\nlon_pole : float or `~as", "start_line": 327, "end_line": 398}, {"name": "RotateCelestial2Native", "bases": ["_SkyRotation"], "methods": ["input_units", "return_units", "__init__", "evaluate", "inverse"], "docstring": "Transform from Celestial to Native Spherical Coordinates.\n\nParameters\n----------\nlon : float or `~astropy.units.Quantity` ['angle']\n    Celestial longitude of the fiducial point.\nlat : float or `~astropy.units.Quantity` ['angle']\n    Celestial latitude of the fiducial point.\nlon_pole : float or `~as", "start_line": 401, "end_line": 474}, {"name": "Rotation2D", "bases": ["Model"], "methods": ["__init__", "inverse", "evaluate", "_compute_matrix"], "docstring": "Perform a 2D rotation given an angle.\n\nPositive angles represent a counter-clockwise rotation and vice-versa.\n\nParameters\n----------\nangle : float or `~astropy.units.Quantity` ['angle']\n    Angle of rotation (if float it should be in deg).", "start_line": 477, "end_line": 561}], "calls": [], "module_docstring": "Implements rotations, including spherical rotations as defined in WCS Paper II [1]_.\n\n`RotateNative2Celestial` and `RotateCelestial2Native` follow the convention in\nWCS Paper II to rotate to/from a native sphere and the celestial sphere.\n\nThe implementation uses `EulerAngleRotation`. The model parameters are\nthree angles: the longitude (``lon``) and latitude (``lat``) of the fiducial point\nin the celestial system (``CRVAL`` keywords in FITS), and the longitude of the celestial\npole in the native system (``lon_pole``). The Euler angles are ``lon+90``, ``90-lat``\nand ``-(lon_pole-90)``.\n\n\nReferences\n----------\n.. [1] Calabretta, M.R., Greisen, E.W., 2002, A&A, 395, 1077 (Paper II)", "parse_error": ""}, {"file_path": "astropy/modeling/tabular.py", "file_hash": "e3c058627a089df2d1ec0f4222ef30ec4e9d47d2b2f358032c17cc056b721a37", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy", "names": ["units"], "is_from": true, "alias": ""}, {"module": "core", "names": ["Model"], "is_from": true, "alias": ""}, {"module": "scipy.interpolate", "names": ["interpn"], "is_from": true, "alias": ""}], "functions": [{"name": "tabular_model", "qualified_name": "tabular_model", "args": ["dim", "name"], "decorators": [], "docstring": "Make a ``Tabular`` model where ``n_inputs`` is\nbased on the dimension of the lookup_table.\n\nThis model has to be further initialized and when evaluated\nreturns the interpolated values.\n\nParameters\n----------\ndim : int\n    Dimensions of the lookup table.\nname : str\n    Name for the class.\n\nExamples\n-", "start_line": 292, "end_line": 349, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "points", "lookup_table", "method", "bounds_error", "fill_value"], "decorators": [], "docstring": "", "start_line": 91, "end_line": 146, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 148, "end_line": 152, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 154, "end_line": 174, "is_async": false, "is_method": false}, {"name": "input_units", "qualified_name": "input_units", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 177, "end_line": 181, "is_async": false, "is_method": false}, {"name": "return_units", "qualified_name": "return_units", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 184, "end_line": 187, "is_async": false, "is_method": false}, {"name": "bounding_box", "qualified_name": "bounding_box", "args": ["self"], "decorators": ["property"], "docstring": "Tuple defining the default ``bounding_box`` limits,\n``(points_low, points_high)``.\n\nExamples\n--------\n>>> from astropy.modeling.models import Tabular1D, Tabular2D\n>>> t1 = Tabular1D(points=[1, 2, 3], lookup_table=[10, 20, 30])\n>>> t1.bounding_box\nModelBoundingBox(\n    intervals={\n        x: Interval", "start_line": 190, "end_line": 223, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["self"], "decorators": [], "docstring": "Return the interpolated values at the input coordinates.\n\nParameters\n----------\ninputs : list of scalar or list of ndarray\n    Input coordinates. The number of inputs must be equal\n    to the dimensions of the lookup table.", "start_line": 225, "end_line": 261, "is_async": false, "is_method": false}, {"name": "inverse", "qualified_name": "inverse", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 264, "end_line": 289, "is_async": false, "is_method": false}], "classes": [{"name": "_Tabular", "bases": ["Model"], "methods": ["__init__", "__repr__", "__str__", "input_units", "return_units", "bounding_box", "evaluate", "inverse"], "docstring": "Returns an interpolated lookup table value.\n\nParameters\n----------\npoints : tuple of ndarray of float, optional\n    The points defining the regular grid in n dimensions.\n    ndarray must have shapes (m1, ), ..., (mn, ),\nlookup_table : array-like\n    The data on a regular grid in n dimensions.\n    Mu", "start_line": 39, "end_line": 289}], "calls": [], "module_docstring": "Tabular models.\n\nTabular models of any dimension can be created using `tabular_model`.\nFor convenience `Tabular1D` and `Tabular2D` are provided.\n\nExamples\n--------\n>>> table = np.array([[ 3.,  0.,  0.],\n...                  [ 0.,  2.,  0.],\n...                  [ 0.,  0.,  0.]])\n>>> points = ([1, 2, 3], [1, 2, 3])\n>>> t2 = Tabular2D(points, lookup_table=table, bounds_error=False,\n...                fill_value=None, method='nearest')", "parse_error": ""}, {"file_path": "astropy/modeling/math_functions.py", "file_hash": "b0f949c3badf7fb1c22720148c7583735f8effc58fb3a8d90c28601dad36e094", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy.modeling.core", "names": ["Model"], "is_from": true, "alias": ""}], "functions": [{"name": "_make_class_name", "qualified_name": "_make_class_name", "args": ["name"], "decorators": [], "docstring": "Make a ufunc model class name from the name of the ufunc.", "start_line": 81, "end_line": 83, "is_async": false, "is_method": false}, {"name": "ufunc_model", "qualified_name": "ufunc_model", "args": ["name"], "decorators": [], "docstring": "Define a Model from a Numpy ufunc name.", "start_line": 86, "end_line": 118, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 77, "end_line": 78, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["self", "x"], "decorators": [], "docstring": "", "start_line": 94, "end_line": 95, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["self", "x", "y"], "decorators": [], "docstring": "", "start_line": 100, "end_line": 101, "is_async": false, "is_method": false}], "classes": [{"name": "_NPUfuncModel", "bases": ["Model"], "methods": ["__init__"], "docstring": "", "start_line": 74, "end_line": 78}], "calls": [], "module_docstring": "Define Numpy Ufuncs as Models.", "parse_error": ""}, {"file_path": "astropy/modeling/optimizers.py", "file_hash": "a00e634df69915e87d366cde6825f4