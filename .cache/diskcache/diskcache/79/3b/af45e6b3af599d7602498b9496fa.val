ransformations in FITS files.  These transformations map the\npixel locations in an image to their real-world units, such as their\nposition on the sky sphere.\n\nIt performs three separate classes of WCS transformations:\n\n- Core WCS, as defined in the `FITS WCS standard`_, based on Mark\n  Calabretta's `wcslib`_.  See `~astropy.wcs.Wcsprm`.\n- Simple Imaging Polynomial (`SIP`_) convention.  See\n  `~astropy.wcs.Sip`.\n- table lookup distortions as defined in WCS `distortion paper`_.  See\n  `~astropy.wcs.DistortionLookupTable`.\n\nEach of these transformations can be used independently or together in\na standard pipeline.", "parse_error": ""}, {"file_path": "astropy/wcs/docstrings.py", "file_hash": "c51950b15016434dfcf1fbfec154046f47512b9eef17090e4792da5592b470dc", "imports": [], "functions": [{"name": "_fix", "qualified_name": "_fix", "args": ["content", "indent"], "decorators": [], "docstring": "", "start_line": 12, "end_line": 15, "is_async": false, "is_method": false}, {"name": "TWO_OR_MORE_ARGS", "qualified_name": "TWO_OR_MORE_ARGS", "args": ["naxis", "indent"], "decorators": [], "docstring": "", "start_line": 18, "end_line": 35, "is_async": false, "is_method": false}, {"name": "RETURNS", "qualified_name": "RETURNS", "args": ["out_type", "indent"], "decorators": [], "docstring": "", "start_line": 38, "end_line": 45, "is_async": false, "is_method": false}, {"name": "ORIGIN", "qualified_name": "ORIGIN", "args": ["indent"], "decorators": [], "docstring": "", "start_line": 48, "end_line": 57, "is_async": false, "is_method": false}, {"name": "RA_DEC_ORDER", "qualified_name": "RA_DEC_ORDER", "args": ["indent"], "decorators": [], "docstring": "", "start_line": 60, "end_line": 70, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/wcs/utils.py", "file_hash": "a2d625c3624a8f38bef851643a7b346b7af558d30b455ed6543c33662d6a2127", "imports": [{"module": "copy", "names": [], "is_from": fal