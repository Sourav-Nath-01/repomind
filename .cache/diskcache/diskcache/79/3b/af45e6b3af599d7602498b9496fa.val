": "si", "qualified_name": "si", "args": ["self"], "decorators": ["property"], "docstring": "If the Constant is defined in the SI system return that instance of\nthe constant, else convert to a Quantity in the appropriate SI units.", "start_line": 237, "end_line": 241, "is_async": false, "is_method": false}, {"name": "cgs", "qualified_name": "cgs", "args": ["self"], "decorators": ["property"], "docstring": "If the Constant is defined in the CGS system return that instance of\nthe constant, else convert to a Quantity in the appropriate CGS units.", "start_line": 244, "end_line": 248, "is_async": false, "is_method": false}, {"name": "__array_finalize__", "qualified_name": "__array_finalize__", "args": ["self", "obj"], "decorators": [], "docstring": "", "start_line": 250, "end_line": 262, "is_async": false, "is_method": false}, {"name": "cgs", "qualified_name": "cgs", "args": ["self"], "decorators": ["property"], "docstring": "Overridden for EMConstant to raise a `TypeError`\nemphasizing that there are multiple EM extensions to CGS.", "start_line": 269, "end_line": 279, "is_async": false, "is_method": false}, {"name": "wrap", "qualified_name": "wrap", "args": ["meth"], "decorators": [], "docstring": "", "start_line": 34, "end_line": 58, "is_async": false, "is_method": false}, {"name": "wrapper", "qualified_name": "wrapper", "args": ["self"], "decorators": ["functools.wraps(meth)"], "docstring": "", "start_line": 36, "end_line": 56, "is_async": false, "is_method": false}], "classes": [{"name": "ConstantMeta", "bases": ["type"], "methods": ["__new__"], "docstring": "Metaclass for `~astropy.constants.Constant`. The primary purpose of this\nis to wrap the double-underscore methods of `~astropy.units.Quantity`\nwhich is the superclass of `~astropy.constants.Constant`.\n\nIn particular this wraps the operator overloads such as `__add__` to\nprevent their use with consta", "start_line": 17, "end_line": 88}, {"name": "Constant", "bases": ["Quantity"], "methods": ["__new__", "_