_efuncs"], "is_from": true, "alias": ""}, {"module": "base", "names": ["FLRW", "FlatFLRWMixin"], "is_from": true, "alias": ""}, {"module": "scipy.special", "names": ["ellipkinc", "hyp2f1"], "is_from": true, "alias": ""}], "functions": [{"name": "ellipkinc", "qualified_name": "ellipkinc", "args": [], "decorators": [], "docstring": "", "start_line": 21, "end_line": 22, "is_async": false, "is_method": false}, {"name": "hyp2f1", "qualified_name": "hyp2f1", "args": [], "decorators": [], "docstring": "", "start_line": 24, "end_line": 25, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "H0", "Om0", "Ode0", "Tcmb0", "Neff", "m_nu", "Ob0"], "decorators": [], "docstring": "", "start_line": 90, "end_line": 142, "is_async": false, "is_method": false}, {"name": "_optimize_flat_norad", "qualified_name": "_optimize_flat_norad", "args": ["self"], "decorators": [], "docstring": "Set optimizations for flat LCDM cosmologies with no radiation.", "start_line": 144, "end_line": 161, "is_async": false, "is_method": false}, {"name": "w", "qualified_name": "w", "args": ["self", "z"], "decorators": [], "docstring": "Returns dark energy equation of state at redshift ``z``.\n\nParameters\n----------\nz : Quantity-like ['redshift'], array-like, or `~numbers.Number`\n    Input redshift.\n\nReturns\n-------\nw : ndarray or float\n    The dark energy equation of state.\n    Returns `float` if the input is scalar.\n\nNotes\n-----\nT", "start_line": 163, "end_line": 185, "is_async": false, "is_method": false}, {"name": "de_density_scale", "qualified_name": "de_density_scale", "args": ["self", "z"], "decorators": [], "docstring": "Evaluates the redshift dependence of the dark energy density.\n\nParameters\n----------\nz : Quantity-like ['redshift'], array-like, or `~numbers.Number`\n    Input redshift.\n\nReturns\n-------\nI : ndarray or float\n    The scaling of the energy density of dark energy with redshift.\n    Returns `float` if t", "start_line": 187, "end_line": 207, "is_async": false, "is_method": false}, {"name": "_elliptic_comoving_distance_z1z2", "qualified_name": "_elliptic_comoving_distance_z1z2", "args": ["self", "z1", "z2"], "decorators": [], "docstring": "Comoving transverse distance in Mpc between two redshifts.\n\nThis value is the transverse comoving distance at redshift ``z``\ncorresponding to an angular separation of 1 radian. This is the same as\nthe comoving distance if :math:`\\Omega_k` is zero.\n\nFor :math:`\\Omega_{rad} = 0` the comoving distance ", "start_line": 209, "end_line": 284, "is_async": false, "is_method": false}, {"name": "_dS_comoving_distance_z1z2", "qualified_name": "_dS_comoving_distance_z1z2", "args": ["self", "z1", "z2"], "decorators": [], "docstring": "Comoving line-of-sight distance in Mpc between objects at redshifts\n``z1`` and ``z2`` in a flat, :math:`\\Omega_{\\Lambda}=1` cosmology\n(de Sitter).\n\nThe comoving distance along the line-of-sight between two objects\nremains constant with time for objects in the Hubble flow.\n\nThe de Sitter case has an ", "start_line": 286, "end_line": 312, "is_async": false, "is_method": false}, {"name": "_EdS_comoving_distance_z1z2", "qualified_name": "_EdS_comoving_distance_z1z2", "args": ["self", "z1", "z2"], "decorators": [], "docstring": "Comoving line-of-sight distance in Mpc between objects at redshifts\n``z1`` and ``z2`` in a flat, :math:`\\Omega_M=1` cosmology\n(Einstein - de Sitter).\n\nThe comoving distance along the line-of-sight between two objects\nremains constant with time for objects in the Hubble flow.\n\nFor :math:`\\Omega_M=1`,", "start_line": 314, "end_line": 342, "is_async": false, "is_method": false}, {"name": "_hypergeometric_comoving_distance_z1z2", "qualified_name": "_hypergeometric_comoving_distance_z1z2", "args": ["self", "z1", "z2"], "decorators": [], "docstring": "Comoving line-of-sight distance in Mpc between objects at redshifts\n``z1`` and ``z2``.\n\nThe comoving distance along the line-of-sight between two objects\nremains constant with time for objects in the Hubble flow.\n\nFor :math:`\\Omega_{rad} = 0` the comoving distance can be directly\ncalculated as a hyp", "start_line": 344, "end_line": 382, "is_async": false, "is_method": false}, {"name": "_T_hypergeometric", "qualified_name": "_T_hypergeometric", "args": ["self", "x"], "decorators": [], "docstring": "Compute value using Gauss Hypergeometric function 2F1.\n\n.. math::\n\n   T(x) = 2 \\sqrt(x) _{2}F_{1}\\left(\\frac{1}{6}, \\frac{1}{2};\n                                    \\frac{7}{6}; -x^3 \\right)\n\nNotes\n-----\nThe :func:`scipy.special.hyp2f1` code already implements the\nhypergeometric transformation sugge", "start_line": 384, "end_line": 404, "is_async": false, "is_method": false}, {"name": "_dS_age", "qualified_name": "_dS_age", "args": ["self", "z"], "decorators": [], "docstring": "Age of the universe in Gyr at redshift ``z``.\n\nThe age of a de Sitter Universe is infinite.\n\nParameters\n----------\nz : Quantity-like ['redshift'], array-like, or `~numbers.Number`\n    Input redshift.\n\nReturns\n-------\nt : `~astropy.units.Quantity` ['time']\n    The age of the universe in Gyr at each i", "start_line": 406, "end_line": 422, "is_async": false, "is_method": false}, {"name": "_EdS_age", "qualified_name": "_EdS_age", "args": ["self", "z"], "decorators": [], "docstring": "Age of the universe in Gyr at redshift ``z``.\n\nFor :math:`\\Omega_{rad} = 0` (:math:`T_{CMB} = 0`; massless neutrinos)\nthe age can be directly calculated as an elliptic integral [1]_.\n\nParameters\n----------\nz : Quantity-like ['redshift'], array-like, or `~numbers.Number`\n    Input redshift.\n\nReturns\n", "start_line": 424, "end_line": 445, "is_async": false, "is_method": false}, {"name": "_flat_age", "qualified_name": "_flat_age", "args": ["self", "z"], "decorators": [], "docstring": "Age of the universe in Gyr at redshift ``z``.\n\nFor :math:`\\Omega_{rad} = 0` (:math:`T_{CMB} = 0`; massless neutrinos)\nt