d fit_mean=False.\n\nParameters\n----------\ny : array-like\n    data values\ndy : float, array, or None, optional\n    data uncertainties\ncenter_data : bool\n    specify whether data should be pre-center", "start_line": 6, "end_line": 36, "is_async": false, "is_method": false}, {"name": "convert_normalization", "qualified_name": "convert_normalization", "args": ["Z", "N", "from_normalization", "to_normalization", "chi2_ref"], "decorators": [], "docstring": "Convert power from one normalization to another.\n\nThis currently only works for standard & floating-mean models.\n\nParameters\n----------\nZ : array-like\n    the periodogram output\nN : int\n    the number of data points\nfrom_normalization, to_normalization : str\n    the normalization to convert from and", "start_line": 39, "end_line": 104, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/timeseries/periodograms/lombscargle/_statistics.py", "file_hash": "8ac927ba8fc677ec666dff47435db77c8b6a821ef90e6e91a4e9a96521bfe294", "imports": [{"module": "functools", "names": ["wraps"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy", "names": ["units"], "is_from": true, "alias": ""}, {"module": "scipy.special", "names": ["gammaln"], "is_from": true, "alias": ""}, {"module": "scipy", "names": ["optimize"], "is_from": true, "alias": ""}, {"module": "scipy", "names": ["optimize"], "is_from": true, "alias": ""}, {"module": "core", "names": ["LombScargle"], "is_from": true, "alias": ""}], "functions": [{"name": "_weighted_sum", "qualified_name": "_weighted_sum", "args": ["val", "dy"], "decorators": [], "docstring": "", "start_line": 16, "end_line": 20, "is_async": false, "is_method": false}, {"name": "_weighted_mean", "qualified_name": "_weighted_mean", "args": ["val", "dy"], "decorators": [], "docstring": "", "start_line": 23, "end_line": 27, "is_async": false, "is