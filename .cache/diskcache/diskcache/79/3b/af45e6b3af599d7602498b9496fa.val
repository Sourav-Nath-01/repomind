numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy.units", "names": ["Quantity"], "is_from": true, "alias": ""}, {"module": "scipy.stats", "names": ["norm"], "is_from": true, "alias": ""}], "functions": [{"name": "_components", "qualified_name": "_components", "args": ["data", "p", "phi", "axis", "weights"], "decorators": [], "docstring": "", "start_line": 30, "end_line": 43, "is_async": false, "is_method": false}, {"name": "_angle", "qualified_name": "_angle", "args": ["data", "p", "phi", "axis", "weights"], "decorators": [], "docstring": "", "start_line": 46, "end_line": 57, "is_async": false, "is_method": false}, {"name": "_length", "qualified_name": "_length", "args": ["data", "p", "phi", "axis", "weights"], "decorators": [], "docstring": "", "start_line": 60, "end_line": 63, "is_async": false, "is_method": false}, {"name": "circmean", "qualified_name": "circmean", "args": ["data", "axis", "weights"], "decorators": [], "docstring": "Computes the circular mean angle of an array of circular data.\n\nParameters\n----------\ndata : ndarray or `~astropy.units.Quantity`\n    Array of circular (directional) data, which is assumed to be in\n    radians whenever ``data`` is ``numpy.ndarray``.\naxis : int, optional\n    Axis along which circular", "start_line": 66, "end_line": 105, "is_async": false, "is_method": false}, {"name": "circvar", "qualified_name": "circvar", "args": ["data", "axis", "weights"], "decorators": [], "docstring": "Computes the circular variance of an array of circular data.\n\nThere are some concepts for defining measures of dispersion for circular\ndata. The variance implemented here is based on the definition given by\n[1]_, which is also the same used by the R package 'CircStats' [2]_.\n\nParameters\n----------\nd", "start_line": 108, "end_line": 160, "is_async": false, "is_method": false}, {"name": "circstd", "qualified_name": "circstd", "args": ["data", "axis", "weights", "method"], "decorators": [], "docstring": "Computes the circular standard deviation of an array of circular data.\n\nThe standard deviation implemented here is based on the definitions given\nby [1]_, which is also the same used by the R package 'CirStat' [2]_.\n\nTwo methods are implemented: 'angular' and 'circular'. The former is\ndefined as sqr", "start_line": 163, "end_line": 238, "is_async": false, "is_method": false}, {"name": "circmoment", "qualified_name": "circmoment", "args": ["data", "p", "centered", "axis", "weights"], "decorators": [], "docstring": "Computes the ``p``-th trigonometric circular moment for an array\nof circular data.\n\nParameters\n----------\ndata : ndarray or `~astropy.units.Quantity`\n    Array of circular (directional) data, which is assumed to be in\n    radians whenever ``data`` is ``numpy.ndarray``.\np : float, optional\n    Order ", "start_line": 241, "end_line": 292, "is_async": false, "is_method": false}, {"name": "circcorrcoef", "qualified_name": "circcorrcoef", "args": ["alpha", "beta", "axis", "weights_alpha", "weights_beta"], "decorators": [], "docstring": "Computes the circular correlation coefficient between two array of\ncircular data.\n\nParameters\n----------\nalpha : ndarray or `~astropy.units.Quantity`\n    Array of circular (directional) data, which is assumed to be in\n    radians whenever ``data`` is ``numpy.ndarray``.\nbeta : ndarray or `~astropy.un", "start_line": 295, "end_line": 355, "is_async": false, "is_method": false}, {"name": "rayleightest", "qualified_name": "rayleightest", "args": ["data", "axis", "weights"], "decorators": [], "docstring": "Performs the Rayleigh test of uniformity.\n\nThis test is  used to identify a non-uniform distribution, i.e. it is\ndesigned for detecting an unimodal deviation from uniformity. More\nprecisely, it assumes the following hypotheses:\n- H0 (null hypothesis): The population is distributed uniformly around t", "start_line": 358, "end_line": 424, "is_async": false, "is_method": false}, {"name": "vtest", "qualified_name": "vtest", "args": ["data", "mu", "axis", "weights"], "decorators": [], "docstring": "Performs the Rayleigh test of uniformity where the alternative\nhypothesis H1 is assumed to have a known mean angle ``mu``.\n\nParameters\n----------\ndata : ndarray or `~astropy.units.Quantity`\n    Array of circular (directional) data, which is assumed to be in\n    radians whenever ``data`` is ``numpy.n", "start_line": 427, "end_line": 493, "is_async": false, "is_method": false}, {"name": "_A1inv", "qualified_name": "_A1inv", "args": ["x"], "decorators": [], "docstring": "", "start_line": 496, "end_line": 510, "is_async": false, "is_method": false}, {"name": "vonmisesmle", "qualified_name": "vonmisesmle", "args": ["data", "axis", "weights"], "decorators": [], "docstring": "Computes the Maximum Likelihood Estimator (MLE) for the parameters of\nthe von Mises distribution.\n\nParameters\n----------\ndata : ndarray or `~astropy.units.Quantity`\n    Array of circular (directional) data, which is assumed to be in\n    radians whenever ``data`` is ``numpy.ndarray``.\naxis : int, opt", "start_line": 513, "end_line": 557, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This module contains simple functions for dealing with circular statistics, for\ninstance, mean, variance, standard deviation, correlation coefficient, and so\non. This module also cover tests of uniformity, e.g., the Rayleigh and V tests.\nThe Maximum Likelihood Estimator for the Von Mises distribution along with the\nCramer-Rao Lower Bounds are also implemented. Almost all of the implementations\nare based on reference [1]_, which is also the basis for the R package\n'CircStats' [2]_.", "parse_error": ""}, {"file_path": "astropy/stats/bayesian_blocks.py", "file_hash": "4aea8766341cf46517eea41d8e6201e6058d3fe87298d8eef394782c91168c37", "imports": [{"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "inspect", "names": ["signature"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy.utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}], "functions": [{"name": "bayesian_blocks", "qualified_name": "bayesian_blocks", "args": ["t", "x", "sigma", "fitness"], "decorators": [], "docstring": "Compute optimal segmentation of data with Scargle's Bayesian Blocks.\n\nThis is a flexible implementation of the Bayesian Blocks algorithm\ndescribed in Scargle 2013 [1]_.\n\nParameters\n----------\nt : array-like\n    data times (one dimensional, length N)\nx : array-like, optional\n    data values\nsigma : a", "start_line": 59, "end_line": 172, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "p0", "gamma", "ncp_prior"], "decorators": [], "docstring": "", "start_line": 212, "end_line": 215, "is_async": false, "is_method": false}, {"name": "validate_input", "qualified_name": "validate_input", "args": ["self", "t", "x", "sigma"], "decorators": [], "docstring": "Validate inputs to the model.\n\nParameters\n----------\nt : array-like\n    times of observations\nx : array-like, optional\n    values observed at each time\nsigma : float or array-like, optional\n    errors in values x\n\nReturns\n-------\nt, x, sigma : array-like, float or None\n    validated and perhaps modi", "start_line": 217, "end_line": 281, "is_async": false, "is_method": false}, {"name": "fitness", "qualified_name": "fitness", "args": ["self"], "decorators": [], "docstring": "", "start_line": 283, "end_line": 284, "is_async": false, "is_method": false}, {"name": "p0_prior", "qualified_name": "p0_prior", "args": ["self", "N"], "decorators": [], "docstring": "Empirical prior, parametrized by the false alarm probability ``p0``.\n\nSee eq. 21 in Scargle (2013).\n\nNote that there was an error in this equation in the original Scargle\npaper (the \"log\" was missing). The following corrected form is taken\nfrom https://arxiv.org/abs/1304.2818", "start_line": 286, "end_line": 295, "is_async": false, "is_method": false}, {"name": "_fitness_args", "qualified_name": "_fitness_args", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 300, "end_line": 301, "is_async": false, "is_method": false}, {"name": "compute_ncp_prior", "qualified_name": "compute_ncp_prior", "args": ["self", "N"], "decorators": [], "docstring": "If ``ncp_prior`` is not explicitly defined, compute it from ``gamma``\nor ``p0``.", "start_line": 303, "end_line": 316, "is_async": false, "is_method": false}, {"name": "fit", "qualified_name": "fit", "args": ["self", "t", "x", "sigma"], "decorators": [], "docstring": "Fit the Bayesian Blocks model given the specified fitness function.\n\nParameters\n----------\nt : array-like\n    data times (one dimensional, length N)\nx : array-like, optional\n    data values\nsigma : array-like or float, optional\n    data errors\n\nReturns\n-------\nedges : ndarray\n    array containing th", "start_line": 318, "end_line": 413, "is_async": false, "is_method": false}, {"name": "fitness", "qualified_name": "fitness", "args": ["self", "N_k", "T_k"], "decorators": [], "docstring": "", "start_line": 441, "end_line": 443, "is_async": false, "is_method": false}, {"name": "validate_input", "qualified_name": "validate_input", "args": ["self", "t", "x", "sigma"], "decorators": [], "docstring": "", "start_line": 445, "end_line": 449, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "dt", "p0", "gamma", "ncp_prior"], "decorators": [], "docstring": "", "start_line": 474, "end_line": 476, "is_async": false, "is_method": false}, {"name": "validate_input", "qualified_name": "validate_input", "args": ["self", "t", "x", "sigma"], "decorators": [], "docstring": "", "start_line": 478, "end_line": 482, "is_async": false, "is_method": false}, {"name": "fitness", "qualified_name": "fitness", "args": ["self", "T_k", "N_k"], "decorators": [], "docstring": "", "start_line": 484, "end_line": 500, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "p0", "gamma", "ncp_prior"], "decorators": [], "docstring": "", "start_line": 519, "end_line": 520, "is_async": false, "is_method": false}, {"name": "fitness", "qualified_name": "fitness", "args": ["self", "a_k", "b_k"], "decorators": [], "docstring": "", "start_line": 522, "end_line": 524, "is_async": false, "is_method": false}, {"name": "validate_input", "qualified_name": "validate_input", "args": ["self", "t", "x", "sigma"], "decorators": [], "docstring": "", "start_line": 526, "end_line": 529, "is_async": false, "is_method": false}], "classes": [{"name": "FitnessFunc", "bases": [], "methods": ["__init__", "validate_input", "fitness", "p0_prior", "_fitness_args", "compute_ncp_prior", "fit"], "docstring": "Base class for bayesian blocks fitness functions.\n\nDerived classes should overload the following method:\n\n``fitness(self, **kwargs)``:\n  Compute the fitness given a set of named arguments.\n  Arguments accepted by fitness must be among ``[T_k, N_k, a_k, b_k, c_k]``\n  (See [1]_ for details on the mean", "start_line": 175, "end_line": 413}, {"name": "Events", "bases": ["FitnessFunc"], "methods": ["fitness", "validate_input"], "docstring": "Bayesian blocks fitness for binned or unbinned events.\n\nParameters\n----------\np0 : float, optional\n    False alarm probability, used to compute the prior on\n    :math:`N_{\\rm blocks}` (see eq. 21 of Scargle 2013). For the Events\n    type data, ``p0`` does not seem to be an accurate representation of", "start_line": 416, "end_line": 449}, {"name": "RegularEvents", "bases": ["FitnessFunc"], "methods": ["__init__", "validate_input", "fitness"], "docstring": "Bayesian blocks fitness for regular events.\n\nThis is for data which has a fundamental \"tick\" length, so that all\nmeasured values are multiples of this tick length.  In each tick, there\nare either zero or one counts.\n\nParameters\n----------\ndt : float\n    tick rate for data\np0 : float, optional\n    Fa", "start_line": 452, "end_line": 500}, {"name": "PointMeasures", "bases": ["FitnessFunc"], "methods": ["__init__", "fitness", "validate_input"], "docstring": "Bayesian blocks fitness for point measures.\n\nParameters\n----------\np0 : float, optional\n    False alarm probability, used to compute the prior on :math:`N_{\\rm\n    blocks}` (see eq. 21 of Scargle 2013). If gamma is specified, p0 is\n    ignored.\nncp_prior : float, optional\n    If specified, use the v", "start_line": 503, "end_line": 529}], "calls": [], "module_docstring": "Bayesian Blocks for Time Series Analysis.\n\nBayesian Blocks for Time Series Analysis\n========================================\n\nDynamic programming algorithm for solving a piecewise-constant model for\nvarious datasets. This is based on the algorithm presented in Scargle\net al 2013 [1]_. This code was ported from the astroML project [2]_.\n\nApplications include:\n\n- finding an optimal histogram with adaptive bin widths\n- finding optimal segmentation of time series data\n- detecting inflection points in the rate of event data\n\nThe primary interface to these routines is the :func:`bayesian_blocks`\nfunction. This module provides fitness functions suitable for three types\nof data:\n\n- Irregularly-spaced event data via the :class:`Events` class\n- Regularly-spaced event data via the :class:`RegularEvents` class\n- Irregularly-spaced point measurements via the :class:`PointMeasures` class\n\nFor more fine-tuned control over the fitness functions used, it is possible\nto define custom :class:`FitnessFunc` classes directly and use them with\nthe :func:`bayesian_blocks` routine.\n\nOne common application of the Bayesian Blocks algorithm is the determination\nof optimal adaptive-width histogram bins. This uses the same fitness function\nas for irregularly-spaced time series events. The easiest interface for\ncreating Bayesian Blocks histograms is the :func:`astropy.stats.histogram`\nfunction.\n\nReferences\n----------\n.. [1] https://ui.adsabs.harvard.edu/abs/2013ApJ...764..167S\n.. [2] https://www.astroml.org/ https://github.com//astroML/astroML/\n.. [3] Bellman, R.E., Dreyfus, S.E., 1962. Applied Dynamic\n   Programming. Princeton University Press, Princeton.\n   https://press.princeton.edu/books/hardcover/9780691651873/applied-dynamic-programming\n.. [4] Bellman, R., Roth, R., 1969. Curve fitting by segmented\n   straight lines. J. Amer. Statist. Assoc. 64, 1079\u20131084.\n   https://www.tandfonline.com/doi/abs/10.1080/01621459.1969.10501038", "parse_error": ""}, {"file_path": "astropy/stats/__init__.py", "file_hash": "57229797b75922ac534dba62e95731ad639aa670e7674ba99f70a0840a4031fc", "imports": [{"module": "", "names": ["bayesian_blocks"], "is_from": true, "alias": ""}, {"module": "", "names": ["biweight", "circstats", "funcs"], "is_from": true, "alias": ""}, {"module": "", "names": ["histogram"], "is_from": true, "alias": ""}, {"module": "", "names": ["info_theory", "jackknife", "sigma_clipping", "spatial"], "is_from": true, "alias": ""}, {"module": "bayesian_blocks", "names": ["*"], "is_from": true, "alias": ""}, {"module": "biweight", "names": ["*"], "is_from": true, "alias": ""}, {"module": "bls", "names": ["*"], "is_from": true, "alias": ""}, {"module": "circstats", "names": ["*"], "is_from": true, "alias": ""}, {"module": "funcs", "names": ["*"], "is_from": true, "alias": ""}, {"module": "histogram", "names": ["*"], "is_from": true, "alias": ""}, {"module": "info_theory", "names": ["*"], "is_from": true, "alias": ""}, {"module": "jackknife", "names": ["*"], "is_from": true, "alias": ""}, {"module": "lombscargle", "names": ["*"], "is_from": true, "alias": ""}, {"module": "sigma_clipping", "names": ["*"], "is_from": true, "alias": ""}, {"module": "spatial", "names": ["*"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "This subpackage contains statistical tools provided for or used by Astropy.\n\nWhile the `scipy.stats` package contains a wide range of statistical\ntools, it is a general-purpose package, and is missing some that are\nparticularly useful to astronomy or are used in an atypical way in\nastronomy. This package is intended to provide such functionality, but\n*not* to replace `scipy.stats` if its implementation satisfies\nastronomers' needs.", "parse_error": ""}, {"file_path": "astropy/stats/histogram.py", "file_hash": "514d302adf93d056a62e753a15ba44cb658c192f517800d1840c3a6181999e5c", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "bayesian_blocks", "names": ["bayesian_blocks"], "is_from": true, "alias": ""}, {"module": "scipy", "names": ["optimize"], "is_from": true, "alias": ""}, {"module": "scipy", "names": ["special"], "is_from": true, "alias": ""}], "functions": [{"name": "calculate_bin_edges", "qualified_name": "calculate_bin_edges", "args": ["a", "bins", "range", "weights"], "decorators": [], "docstring": "Calculate histogram bin edges like ``numpy.histogram_bin_edges``.\n\nParameters\n----------\na : array-like\n    Input data. The bin edges are calculated over the flattened array.\n\nbins : int, list, or str, optional\n    If ``bins`` is an int, it is the number of bins. If it is a list\n    it is taken to b", "start_line": 22, "end_line": 89, "is_async": false, "is_method": false}, {"name": "histogram", "qualified_name": "histogram", "args": ["a", "bins", "range", "weights"], "decorators": [], "docstring": "Enhanced histogram function, providing adaptive binnings.\n\nThis is a histogram function that enables the use of more sophisticated\nalgorithms for determining bins.  Aside from the ``bins`` argument allowing\na string specified how bins are computed, the parameters are the same\nas ``numpy.histogram()`", "start_line": 92, "end_line": 142, "is_async": false, "is_method": false}, {"name": "scott_bin_width", "qualified_name": "scott_bin_width", "args": ["data", "return_bins"], "decorators": [], "docstring": "Return the optimal histogram bin width using Scott's rule.\n\nScott's rule is a normal reference rule: it minimizes the integrated\nmean squared error in the bin approximation under the assumption that the\ndata is approximately Gaussian.\n\nParameters\n----------\ndata : array-like, ndim=1\n    observed (on", "start_line": 145, "end_line": 203, "is_async": false, "is_method": false}, {"name": "freedman_bin_width", "qualified_name": "freedman_bin_width", "args": ["data", "return_bins"], "decorators": [], "docstring": "Return the optimal histogram bin width using the Freedman-Diaconis rule.\n\nThe Freedman-Diaconis rule is a normal reference rule like Scott's\nrule, but uses rank-based statistics for results which are more robust\nto deviations from a normal distribution.\n\nParameters\n----------\ndata : array-like, ndim", "start_line": 206, "end_line": 278, "is_async": false, "is_method": false}, {"name": "knuth_bin_width", "qualified_name": "knuth_bin_width", "args": ["data", "return_bins", "quiet"], "decorators": [], "docstring": "Return the optimal histogram bin width using Knuth's rule.\n\nKnuth's rule is a fixed-width, Bayesian approach to determining\nthe optimal bin width of a histogram.\n\nParameters\n----------\ndata : array-like, ndim=1\n    observed (one-dimensional) data\nreturn_bins : bool, optional\n    if True, then return", "start_line": 281, "end_line": 341, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "data"], "decorators": [], "docstring": "", "start_line": 370, "end_line": 383, "is_async": false, "is_method": false}, {"name": "bins", "qualified_name": "bins", "args": ["self", "M"], "decorators": [], "docstring": "Return the bin edges given M number of bins.", "start_line": 385, "end_line": 387, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "M"], "decorators": [], "docstring": "", "start_line": 389, "end_line": 390, "is_async": false, "is_method": false}, {"name": "eval", "qualified_name": "eval", "args": ["self", "M"], "decorators": [], "docstring": "Evaluate the Knuth function.\n\nParameters\n----------\nM : int\n    Number of bins\n\nReturns\n-------\nF : float\n    evaluation of the negative Knuth loglikelihood function:\n    smaller values indicate a better fit.", "start_line": 392, "end_line": 422, "is_async": false, "is_method": false}], "classes": [{"name": "_KnuthF", "bases": [], "methods": ["__init__", "bins", "__call__", "eval"], "docstring": "Class which implements the function minimized by knuth_bin_width.\n\nParameters\n----------\ndata : array-like, one dimension\n    data to be histogrammed\n\nNotes\n-----\nthe function F is given by\n\n.. math::\n    F(M|x,I) = n\\log(M) + \\log\\Gamma(\\frac{M}{2})\n    - M\\log\\Gamma(\\frac{1}{2})\n    - \\log\\Gamma(\\", "start_line": 344, "end_line": 422}], "calls": [], "module_docstring": "Methods for selecting the bin width of histograms.\n\nPorted from the astroML project: https://www.astroml.org/", "parse_error": ""}, {"file_path": "astropy/stats/info_theory.py", "file_hash": "43d698ae13b41173e91ca458e60bfa8c789523c8f24ecc348e9836af55e2b126", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}], "functions": [{"name": "bayesian_info_criterion", "qualified_name": "bayesian_info_criterion", "args": ["log_likelihood", "n_params", "n_samples"], "decorators": [], "docstring": "Computes the Bayesian Information Criterion (BIC) given the log of the\nlikelihood function evaluated at the estimated (or analytically derived)\nparameters, the number of parameters, and the number of samples.\n\nThe BIC is usually applied to decide whether increasing the number of free\nparameters (hen", "start_line": 22, "end_line": 117, "is_async": false, "is_method": false}, {"name": "bayesian_info_criterion_lsq", "qualified_name": "bayesian_info_criterion_lsq", "args": ["ssr", "n_params", "n_samples"], "decorators": [], "docstring": "Computes the Bayesian Information Criterion (BIC) assuming that the\nobservations come from a Gaussian distribution.\n\nIn this case, BIC is given as\n\n.. math::\n\n    \\mathrm{BIC} = n\\ln\\left(\\dfrac{\\mathrm{SSR}}{n}\\right) + k\\ln(n)\n\nin which :math:`n` is the sample size, :math:`k` is the number of free", "start_line": 122, "end_line": 205, "is_async": false, "is_method": false}, {"name": "akaike_info_criterion", "qualified_name": "akaike_info_criterion", "args": ["log_likelihood", "n_params", "n_samples"], "decorators": [], "docstring": "Computes the Akaike Information Criterion (AIC).\n\nLike the Bayesian Information Criterion, the AIC is a measure of\nrelative fitting quality which is used for fitting evaluation and model\nselection. The decision is in favor of the model with the lowest AIC.\n\nAIC is given as\n\n.. math::\n\n    \\mathrm{AI", "start_line": 208, "end_line": 310, "is_async": false, "is_method": false}, {"name": "akaike_info_criterion_lsq", "qualified_name": "akaike_info_criterion_lsq", "args": ["ssr", "n_params", "n_samples"], "decorators": [], "docstring": "Computes the Akaike Information Criterion assuming that the observations\nare Gaussian distributed.\n\nIn this case, AIC is given as\n\n.. math::\n\n    \\mathrm{AIC} = n\\ln\\left(\\dfrac{\\mathrm{SSR}}{n}\\right) + 2k\n\nIn case that the sample size is not \"large enough\", a correction is\napplied, i.e.\n\n.. math::", "start_line": 313, "end_line": 407, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This module contains simple functions for model selection.", "parse_error": ""}, {"file_path": "astropy/stats/spatial.py", "file_hash": "0b98e5fd06be74e8e2985581099dba4263eb908521840f1095831432c8168e92", "imports": [{"module": "math", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, 