s in cgs units.  See :mod:`astropy.constants`\nfor a complete listing of constants defined in Astropy.", "parse_error": ""}, {"file_path": "astropy/time/__init__.py", "file_hash": "3518d62684f1d71ec7c02f0ad6052740b3363b1a51cffb08f3c40fadf1cc332f", "imports": [{"module": "astropy", "names": ["config"], "is_from": true, "alias": ""}, {"module": "formats", "names": ["*"], "is_from": true, "alias": ""}, {"module": "core", "names": ["*"], "is_from": true, "alias": ""}], "functions": [], "classes": [{"name": "Conf", "bases": ["_config.ConfigNamespace"], "methods": [], "docstring": "Configuration parameters for `astropy.table`.", "start_line": 5, "end_line": 17}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/time/utils.py", "file_hash": "1330c34a95e573d978fc2dc145b2b1ef373f0ea4e71086368d3d7cba2a279dc4", "imports": [{"module": "decimal", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy.units", "names": [], "is_from": false, "alias": "u"}], "functions": [{"name": "day_frac", "qualified_name": "day_frac", "args": ["val1", "val2", "factor", "divisor"], "decorators": [], "docstring": "Return the sum of ``val1`` and ``val2`` as two float64s.\n\nThe returned floats are an integer part and the fractional remainder,\nwith the latter guaranteed to be within -0.5 and 0.5 (inclusive on\neither side, as the integer is rounded to even).\n\nThe arithmetic is all done with exact floating point op", "start_line": 18, "end_line": 75, "is_async": false, "is_method": false}, {"name": "quantity_day_frac", "qualified_name": "quantity_day_frac", "args": ["val1", "val2"], "decorators": [], "docstring": "Like ``day_frac``, but for quantities with units of time.\n\nThe quantities are separately converted to days. Here, we need to take\ncare with the conversion since while the routines here can do accurate\nmultiplication, the conversion factor itself may not be accurate.  For\ninstance, if the quantity is", "start_line": 78, "end_line": 118, "is_async": false, "is_method": false}, {"name": "two_sum", "qualified_name": "two_sum", "args": ["a", "b"], "decorators": [], "docstring": "Add ``a`` and ``b`` exactly, returning the result as two float64s.\nThe first is the approximate sum (with some floating point error)\nand the second is the error of the float64 sum.\n\nUsing the procedure of Shewchuk, 1997,\nDiscrete & Computational Geometry 18(3):305-363\nhttp://www.cs.berkeley.edu/~jrs", "start_line": 121, "end_line": 141, "is_async": false, "is_method": false}, {"name": "two_product", "qualified_name": "two_product", "args": ["a", "b"], "decorators": [], "docstring": "Multiple ``a`` and ``b`` exactly, returning the result as two float64s.\nThe first is the approximate product (with some floating point error)\nand the second is the error of the float64 product.\n\nUses the procedure of Shewchuk, 1997,\nDiscrete & Computational Geometry 18(3):305-363\nhttp://www.cs.berke", "start_line": 144, "end_line": 170, "is_async": false, "is_method": false}, {"name": "split", "qualified_name": "split", "args": ["a"], "decorators": [], "docstring": "Split float64 in two aligned parts.\n\nUses the procedure of Shewchuk, 1997,\nDiscrete & Computational Geometry 18(3):305-363\nhttp://www.cs.berkeley.edu/~jrs/papers/robustr.pdf", "start_line": 173, "end_line": 186, "is_async": false, "is_method": false}, {"name": "longdouble_to_twoval", "qualified_name": "longdouble_to_twoval", "args": ["val1", "val2"], "decorators": [], "docstring": "", "start_line": 192, "end_line": 203, "is_async": false, "is_method": false}, {"name": "decimal_to_twoval1", "qualified_name": "decimal_to_twoval1", "args": ["val1", "val2"], "decorators": [], "docstring": "", "start_line": 206, "end_line": 212, "is_async": false, "is_method": false}, {"name": "bytes_to_twoval1", "qualified_name": "bytes_to_twoval1", "args": ["val1", "val2"], "decorators": [], "docstring": "", "start_line": 215, "end