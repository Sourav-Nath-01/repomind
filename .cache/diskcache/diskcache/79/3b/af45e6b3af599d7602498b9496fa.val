ing": "", "start_line": 508, "end_line": 526, "is_async": false, "is_method": false}, {"name": "test_gcrs_altaz_sunish", "qualified_name": "test_gcrs_altaz_sunish", "args": ["testframe"], "decorators": ["pytest.mark.parametrize('testframe', totest_frames)"], "docstring": "Sanity-check that the sun is at a reasonable distance from any altaz", "start_line": 556, "end_line": 568, "is_async": false, "is_method": false}, {"name": "test_gcrs_altaz_moonish", "qualified_name": "test_gcrs_altaz_moonish", "args": ["testframe"], "decorators": ["pytest.mark.parametrize('testframe', totest_frames)"], "docstring": "Sanity-check that an object resembling the moon goes to the right place with\na GCRS->AltAz transformation", "start_line": 572, "end_line": 586, "is_async": false, "is_method": false}, {"name": "test_gcrs_altaz_bothroutes", "qualified_name": "test_gcrs_altaz_bothroutes", "args": ["testframe"], "decorators": ["pytest.mark.parametrize('testframe', totest_frames)"], "docstring": "Repeat of both the moonish and sunish tests above to make sure the two\nroutes through the coordinate graph are consistent with each other", "start_line": 592, "end_line": 610, "is_async": false, "is_method": false}, {"name": "test_cirs_altaz_moonish", "qualified_name": "test_cirs_altaz_moonish", "args": ["testframe"], "decorators": ["pytest.mark.parametrize('testframe', totest_frames)"], "docstring": "Sanity-check that an object resembling the moon goes to the right place with\na CIRS<->AltAz transformation", "start_line": 614, "end_line": 626, "is_async": false, "is_method": false}, {"name": "test_cirs_altaz_nodist", "qualified_name": "test_cirs_altaz_nodist", "args": ["testframe"], "decorators": ["pytest.mark.parametrize('testframe', totest_frames)"], "docstring": "Check that a UnitSphericalRepresentation coordinate round-trips for the\nCIRS<->AltAz transformation.", "start_line": 630, "end_line": 641, "is_async": false, "is_method": false}, {"name": "test_cirs_icrs_moonish", "qualified_name":