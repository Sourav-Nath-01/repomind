": ""}, {"module": "core", "names": ["Unit", "UnitsError"], "is_from": true, "alias": ""}, {"module": "function", "names": ["units"], "is_from": true, "alias": ""}, {"module": "core", "names": ["UnitBase"], "is_from": true, "alias": ""}, {"module": "imperial", "names": ["deg_F"], "is_from": true, "alias": ""}, {"module": "imperial", "names": ["deg_R"], "is_from": true, "alias": ""}, {"module": "astropy.cosmology", "names": ["default_cosmology"], "is_from": true, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "astropy.cosmology.units", "names": ["with_H0"], "is_from": true, "alias": ""}, {"module": "astropy.utils.exceptions", "names": ["AstropyDeprecationWarning"], "is_from": true, "alias": ""}], "functions": [{"name": "dimensionless_angles", "qualified_name": "dimensionless_angles", "args": [], "decorators": [], "docstring": "Allow angles to be equivalent to dimensionless (with 1 rad = 1 m/m = 1).\n\nIt is special compared to other equivalency pairs in that it\nallows this independent of the power to which the angle is raised,\nand independent of whether it is part of a more complicated unit.", "start_line": 76, "end_line": 83, "is_async": false, "is_method": false}, {"name": "logarithmic", "qualified_name": "logarithmic", "args": [], "decorators": [], "docstring": "Allow logarithmic units to be converted to dimensionless fractions.", "start_line": 86, "end_line": 91, "is_async": false, "is_method": false}, {"name": "parallax", "qualified_name": "parallax", "args": [], "decorators": [], "docstring": "Returns a list of equivalence pairs that handle the conversion\nbetween parallax angle and distance.", "start_line": 94, "end_line": 116, "is_async": false, "is_method": false}, {"name": "spectral", "qualified_name": "spectral", "args": [], "decorators": [], "docstring": "Returns a list of equivalence pairs that handle spectral\nwavelength, wave number, frequency, and energy equivalencies.\n\nAllows conversions between wavelength units, wave number units,\nfrequency units, and energy units as they relate to light.\n\nThere are two types of wave number:\n\n    * spectroscopic", "start_line": 119, "end_line": 154, "is_async": false, "is_method": false}, {"name": "spectral_density", "qualified_name": "spectral_density", "args": ["wav", "factor"], "decorators": [], "docstring": "Returns a list of equivalence pairs that handle spectral density\nwith regard to wavelength and frequency.\n\nParameters\n----------\nwav : `~astropy.units.Quantity`\n    `~astropy.units.Quantity` associated with values being converted\n    (e.g., wavelength or frequency).\n\nNotes\n-----\nThe ``factor`` argum", "start_line": 157, "end_line": 323, "is_async": false, "is_method": false}, {"name": "doppler_radio", "qualified_name": "doppler_radio", "args": ["rest"], "decorators": [], "docstring": "Return the equivalency pairs for the radio convention for velocity.\n\nThe radio convention for the relation between velocity and frequency is:\n\n:math:`V = c \\frac{f_0 - f}{f_0}  ;  f(V) = f_0 ( 1 - V/c )`\n\nParameters\n----------\nrest : `~astropy.units.Quantity`\n    Any quantity supported by the standa", "start_line": 326, "end_line": 392, "is_async": false, "is_method": false}, {"name": "doppler_optical", "qualified_name": "doppler_optical", "args": ["rest"], "decorators": [], "docstring": "Return the equivalency pairs for the optical convention for velocity.\n\nThe optical convention for the relation between velocity and frequency is:\n\n:math:`V = c \\frac{f_0 - f}{f  }  ;  f(V) = f_0 ( 1 + V/c )^{-1}`\n\nParameters\n----------\nrest : `~astropy.units.Quantity`\n    Any quantity supported by t", "start_line": 395, "end_line": 462, "is_async": false, "is_method": false}, {"name": "doppler_relativistic", "qualified_name": "doppler_relativistic", "args": ["rest"], "decorators": [], "docstring": "Return the equivalency pairs for the relativistic convention for velocity.\n\nThe full relativistic convention for the relation between velocity and frequency is:\n\n:math:`V = c \\frac{f_0^2 - f^2}{f_0^2 + f^2} ;  f(V) = f_0 \\frac{\\left(1 - (V/c)^2\\right)^{1/2}}{(1+V/c)}`\n\nParameters\n----------\nrest : `", "start_line": 465, "end_line": 539, "is_async": false, "is_method": false}, {"name": "doppler_redshift", "qualified_name": "doppler_redshift", "args": [], "decorators": [], "docstring": "Returns the equivalence between Doppler redshift (unitless) and radial velocity.\n\n.. note::\n\n    This equivalency is not compatible with cosmological\n    redshift in `astropy.cosmology.units`.", "start_line": 542, "end_line": 566, "is_async": false, "is_method": false}, {"name": "molar_mass_amu", "qualified_name": "molar_mass_amu", "args": [], "decorators": [], "docstring": "Returns the equivalence between amu and molar mass.", "start_line": 569, "end_line": 573, "is_async": false, "is_method": false}, {"name": "mass_energy", "qualified_name": "mass_energy", "args": [], "decorators": [], "docstring": "Returns a list of equivalence pairs that handle the conversion\nbetween mass and energy.", "start_line": 576, "end_line": 590, "is_async": false, "is_method": false}, {"name": "brightness_temperature", "qualified_name": "brightness_temperature", "args": ["frequency", "beam_area"], "decorators": [], "docstring": "Defines the conversion between Jy/sr and \"brightness temperature\",\n:math:`T_B`, in Kelvins.  The brightness temperature is a unit very\ncommonly used in radio astronomy.  See, e.g., \"Tools of Radio Astronomy\"\n(Wilson 2009) eqn 8.16 and eqn 8.19 (these pages are available on `google\nbooks\n<https://boo", "start_line": 593, "end_line": 696, "is_async": false, "is_method": false}, {"name": "beam_angular_area", "qualified_name": "beam_angular_area", "args": ["beam_area"], "decorators": [], "docstring": "Convert between the ``beam`` unit, which is commonly used to express the area\nof a radio telescope resolution element, and an area on the sky.\nThis equivalency also supports direct conversion between ``Jy/beam`` and\n``Jy/steradian`` units, since that is a common operation.\n\nParameters\n----------\nbea", "start_line": 699, "end_line": 720, "is_async": false, "is_method": false}, {"name": "thermodynamic_temperature", "qualified_name": "thermodynamic_temperature", "args": ["frequency", "T_cmb"], "decorators": [], "docstring": "Defines the conversion between Jy/sr and \"thermodynamic temperature\",\n:math:`T_{CMB}`, in Kelvins.  The thermodynamic temperature is a unit very\ncommonly used in cosmology. See eqn 8 in [1].\n\n:math:`K_{CMB} \\equiv I_\\nu / \\left(2 k \\nu^2 / c^2  f(\\nu) \\right)`\n\nwith :math:`f(\\nu) = \\frac{ x^2 e^x}{(", "start_line": 723, "end_line": 791, "is_async": false, "is_method": false}, {"name": "temperature", "qualified_name": "temperature", "args": [], "decorators": [], "docstring": "Convert between Kelvin, Celsius, Rankine and Fahrenheit here because\nUnit and CompositeUnit cannot do addition or subtraction properly.", "start_line": 794, "end_line": 814, "is_async": false, "is_method": false}, {"name": "temperature_energy", "qualified_name": "temperature_energy", "args": [], "decorators": [], "docstring": "Convert between Kelvin and keV(eV) to an equivalent amount.", "start_line": 817, "end_line": 824, "is_async": false, "is_method": false}, {"name": "assert_is_spectral_unit", "qualified_name": "assert_is_spectral_unit", "args": ["value"], "decorators": [], "docstring": "", "start_line": 827, "end_line": 834, "is_async": false, "is_method": false}, {"name": "pixel_scale", "qualified_name": "pixel_scale", "args": ["pixscale"], "decorators": [], "docstring": "Convert between pixel distances (in units of ``pix``) and other units,\ngiven a particular ``pixscale``.\n\nParameters\n----------\npixscale : `~astropy.units.Quantity`\n    The pixel scale either in units of <unit>/pixel or pixel/<unit>.", "start_line": 837, "end_line": 862, "is_async": false, "is_method": false}, {"name": "plate_scale", "qualified_name": "