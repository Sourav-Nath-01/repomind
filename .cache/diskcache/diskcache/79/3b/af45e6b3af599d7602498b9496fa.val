 [], "docstring": "", "start_line": 336, "end_line": 337, "is_async": false, "is_method": false}, {"name": "get_cols", "qualified_name": "get_cols", "args": ["self", "lines"], "decorators": [], "docstring": "Initialize the header Column objects from the table ``lines``.\n\nThis is a specialized get_cols for the RDB type:\nLine 0: RDB col names\nLine 1: RDB col definitions\nLine 2+: RDB data rows\n\nParameters\n----------\nlines : list\n    List of table lines\n\nReturns\n-------\nNone", "start_line": 339, "end_line": 377, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "lines"], "decorators": [], "docstring": "", "start_line": 379, "end_line": 387, "is_async": false, "is_method": false}], "classes": [{"name": "BasicHeader", "bases": ["core.BaseHeader"], "methods": [], "docstring": "Basic table Header Reader.\n\nSet a few defaults for common ascii table formats\n(start at line 0, comments begin with ``#`` and possibly white space)", "start_line": 18, "end_line": 28}, {"name": "BasicData", "bases": ["core.BaseData"], "methods": [], "docstring": "Basic table Data Reader.\n\nSet a few defaults for common ascii table formats\n(start at line 1, comments begin with ``#`` and possibly white space)", "start_line": 31, "end_line": 41}, {"name": "Basic", "bases": ["core.BaseReader"], "methods": [], "docstring": "Character-delimited table with a single header line at the top.\n\nLines beginning with a comment character (default='#') as the first\nnon-whitespace character are comments.\n\nExample table::\n\n  # Column definition is the first uncommented line\n  # Default delimiter is the space character.\n  apples ora", "start_line": 44, "end_line": 66}, {"name": "NoHeaderHeader", "bases": ["BasicHeader"], "methods": [], "docstring": "Reader for table header without a header.\n\nSet the start of header line number to `None`, which tells the basic\nreader there is no header line.", "start_line": 69, "end_line": 77}, {"name": "NoHeaderData", "bases": ["BasicData"], "methods": [], "docstring": "Reader for table data without a header.\n\nData starts at first uncommented line since there is no header line.", "start_line": 80, "end_line": 87}, {"name": "NoHeader", "bases": ["Basic"], "methods": [], "docstring": "Character-delimited table with no header line.\n\nWhen reading, columns are autonamed using header.auto_format which defaults\nto \"col%d\".  Otherwise this reader the same as the :class:`Basic` class\nfrom which it is derived.  Example::\n\n  # Table data\n  1 2 \"hello there\"\n  3 4 world", "start_line": 90, "end_line": 106}, {"name": "CommentedHeaderHeader", "bases": ["BasicHeader"], "methods": ["process_lines", "write"], "docstring": "Header class for which the column definition line starts with the\ncomment character.  See the :class:`CommentedHeader` class  for an example.", "start_line": 109, "end_line": 127}, {"name": "CommentedHeader", "bases": ["Basic"], "methods": ["read", "write_header"], "docstring": "Character-delimited table with column names in a comment line.\n\nWhen reading, ``header_start`` can be used to specify the\nline index of column names, and it can be a negative index (for example -1\nfor the last commented line).  The default delimiter is the <space>\ncharacter.\n\nThis matches the format", "start_line": 130, "end_line": 182}, {"name": "TabHeaderSplitter", "bases": ["core.DefaultSplitter"], "methods": ["process_line"], "docstring": "Split lines on tab and do not remove whitespace.", "start_line": 185, "end_line": 191}, {"name": "TabDataSplitter", "bases": ["TabHeaderSplitter"], "methods": [], "docstring": "Don't strip data value whitespace since that is significant in TSV tables.", "start_line": 194, "end_line": 200}, {"name": "TabHeader", "bases": ["BasicHeader"], "methods": [], "docstring": "Reader for header of tables with tab separated header.", "start_line": 203, "end_line": 208}, {"name": "TabData", "bases": ["BasicData"], "methods": [], "docstring": "Reader for data of tables with tab separated data.", "start_line": 211, "end_line": 216}, {"name": "Tab", "bases": ["Basic"], "methods": [], "docstring": "Tab-separated table.\n\nUnlike the :class:`Basic` reader, whitespace is not stripped from the\nbeginning and end of either lines or individual column values.\n\nExample::\n\n  col1 <tab> col2 <tab> col3\n  # Comment line\n  1 <tab> 2 <tab> 5", "start_line": 219, "end_line": 236}, {"name": "CsvSplitter", "bases": ["core.DefaultSplitter"], "methods": [], "docstring": "Split on comma for CSV (comma-separated-value) tables.", "start_line": 239, "end_line": 244}, {"name": "CsvHeader", "bases": ["BasicHeader"], "methods": [], "docstring": "Header that uses the :class:`astropy.io.ascii.basic.CsvSplitter`.", "start_line": 247, "end_line": 254}, {"name": "CsvData", "bases": ["BasicData"], "methods": [], "docstring": "Data that uses the :class:`astropy.io.ascii.basic.CsvSplitter`.", "start_line": 257, "end_line": 265}, {"name": "Csv", "bases": ["Basic"], "methods": ["inconsistent_handler"], "docstring": "CSV (comma-separated-values) table.\n\nThis file format may contain rows with fewer entries than the number of\ncolumns, a situation that occurs in output from some spreadsheet editors.\nThe missing entries are marked as masked in the output table.\n\nMasked values (indicated by an empty '' field value wh", "start_line": 268, "end_line": 326}, {"name": "RdbHeader", "bases": ["TabHeader"], "methods": ["get_type_map_key", "get_cols", "write"], "docstring": "Header for RDB tables.", "start_line": 329, "end_line": 387}, {"name": "RdbData", "bases": ["TabData"], "methods": [], "docstring": "Data reader for RDB data. Starts reading at line 2.", "start_line": 390, "end_line": 395}, {"name": "Rdb", "bases": ["Tab"], "methods": [], "docstring": "Tab-separated file with an extra line after the column definition line that\nspecifies either numeric (N) or string (S) data.\n\nSee: https://www.drdobbs.com/rdb-a-unix-command-line-database/199101326\n\nExample::\n\n  col1 <tab> col2 <tab> col3\n  N <tab> S <tab> N\n  1 <tab> 2 <tab> 5", "start_line": 398, "end_line": 418}], "calls": [], "module_docstring": "An extensible ASCII table reader and writer.\n\nbasic.py:\n  Basic table read / write functionality for simple character\n  delimited files with various options for column header definition.\n\n:Copyright: Smithsonian Astrophysical Observatory (2011)\n:Author: Tom Aldcroft (aldcroft@head.cfa.harvard.edu)", "parse_error": ""}, {"file_path": "astropy/io/ascii/docs.py", "file_hash": "b826a3586ac3280a64cf12627d1d1ac8a0797fc1bf6ad9fa40805ccabfa6293d", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/io/ascii/sextractor.py", "file_hash": "cb9468c4768fe9de4087775a6fb6145df573b1dc397148143a7f344af06b6b29", "imports": [{"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "", "names": ["core"], "is_from": true, "alias": ""}], "functions": [{"name": "get_cols", "qualified_name": "get_cols", "args": ["self", "lines"], "decorators": [], "docstring": "Initialize the header Column objects from the table ``lines`` for a SExtractor\nheader.  The SExtractor header is specialized so that we just copy the entire BaseHeader\nget_cols routine and modify as needed.\n\nParameters\n----------\nlines : list\n    List of table lines", "start_line": 21, "end_line": 108, "is_async": false, "is_method": false}, {"name": "read", "qualified_name": "read", "args": ["self", "table"], "decorators": [], "docstring": "Read input data (file-like object, filename, list of strings, or\nsingle string) into a Table and return the result.", "start_line": 153, "end_line": 162, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "table"], "decorators": [], "docstring": "", "start_line": 164, "end_line": 165, "is_async": false, "is_method": false}], "classes": [{"name": "SExtractorHeader", "bases": ["core.BaseHeader"], "methods": ["get_cols"], "docstring": "Read the header from a file produced by SExtractor.", "start_line": 16, "end_line": 108}, {"name": "SExtractorData", "bases": ["core.BaseData"], "methods": [], "docstring": "", "start_line": 111, "end_line": 114}, {"name": "SExtractor", "bases": ["core.BaseReader"], "methods": ["read", "write"], "docstring": "SExtractor format table.\n\nSExtractor is a package for faint-galaxy photometry (Bertin & Arnouts\n1996, A&A Supp. 317, 393.)\n\nSee: https://sextractor.readthedocs.io/en/latest/\n\nExample::\n\n  # 1 NUMBER\n  # 2 ALPHA_J2000\n  # 3 DELTA_J2000\n  # 4 FLUX_RADIUS\n  # 7 MAG_AUTO [mag]\n  # 8 X2_IMAGE Variance al", "start_line": 117, "end_line": 165}], "calls": [], "module_docstring": "sextractor.py:\n  Classes to read SExtractor table format.\n\nBuilt on daophot.py:\n:Copyright: Smithsonian Astrophysical Observatory (2011)\n:Author: Tom Aldcroft (aldcroft@head.cfa.harvard.edu)", "parse_error": ""}, {"file_path": "astropy/io/ascii/fastbasic.py", "file_hash": "c5f60c1c49a39a8f6c1b42b31393677045270afa960802b24a25d4740938e83f", "imports": [{"module": "copy", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "collections", "names": ["OrderedDict"], "is_from": true, "alias": ""}, {"module": "astropy.table", "names": ["Table"], "is_from": true, "alias": ""}, {"module": "astropy.utils.misc", "names": ["_set_locale"], "is_from": true, "alias": ""}, {"module": "", "names": ["core", "cparser"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "default_kwargs"], "decorators": [], "docstring": "", "start_line": 29, "end_line": 62, "is_async": false, "is_method": false}, {"name": "_read_header", "qualified_name": "_read_header", "args": ["self"], "decorators": [], "docstring": "", "start_line": 64, "end_line": 67, "is_async": false, "is_method": false}, {"name": "read", "qualified