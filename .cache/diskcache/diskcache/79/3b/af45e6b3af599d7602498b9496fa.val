g": "package : str, optional\n    The name of a specific package to test, e.g. 'io.fits' or\n    'utils'. Accepts comma separated string to specify multiple\n    packages. If nothing is specified all default tests are run.", "start_line": 352, "end_line": 370, "is_async": false, "is_method": false}, {"name": "test_path", "qualified_name": "test_path", "args": ["self", "test_path", "kwargs"], "decorators": ["keyword()"], "docstring": "test_path : str, optional\n    Specify location to test by path. May be a single file or\n    directory. Must be specified absolutely or relative to the\n    calling directory.", "start_line": 373, "end_line": 417, "is_async": false, "is_method": false}, {"name": "args", "qualified_name": "args", "args": ["self", "args", "kwargs"], "decorators": ["keyword()"], "docstring": "args : str, optional\n    Additional arguments to be passed to ``pytest.main`` in the ``args``\n    keyword argument.", "start_line": 420, "end_line": 429, "is_async": false, "is_method": false}, {"name": "plugins", "qualified_name": "plugins", "args": ["self", "plugins", "kwargs"], "decorators": ["keyword(default_value=[])"], "docstring": "plugins : list, optional\n    Plugins to be passed to ``pytest.main`` in the ``plugins`` keyword\n    argument.", "start_line": 432, "end_line": 440, "is_async": false, "is_method": false}, {"name": "verbose", "qualified_name": "verbose", "args": ["self", "verbose", "kwargs"], "decorators": ["keyword()"], "docstring": "verbose : bool, optional\n    Convenience option to turn on verbose output from pytest. Passing\n    True is the same as specifying ``-v`` in ``args``.", "start_line": 443, "end_line": 452, "is_async": false, "is_method": false}, {"name": "pastebin", "qualified_name": "pastebin", "args": ["self", "pastebin", "kwargs"], "decorators": ["keyword()"], "docstring": "pastebin : ('failed', 'all', None), optional\n    Convenience option for turning on pytest pastebin output. Set to\n    'failed' to upload info for failed tests, or 'all' to upload info\n    for all tests.", "start_line": 455, "end_line": 468, "is_async": false, "is_method": false}, {"name": "remote_data", "qualified_name": "remote_data", "args": ["self", "remote_data", "kwargs"], "decorators": ["keyword(default_value='none')"], "docstring": "remote_data : {'none', 'astropy', 'any'}, optional\n    Controls whether to run tests marked with @pytest.mark.remote_data. This can be\n    set to run no tests with remote data (``none``), only ones that use\n    data from http://data.astropy.org (``astropy``), or all tests that\n    use remote data (`", "start_line": 471, "end_line": 494, "is_async": false, "is_method": false}, {"name": "pep8", "qualified_name": "pep8", "args": ["self", "pep8", "kwargs"], "decorators": ["keyword()"], "docstring": "pep8 : bool, optional\n    Turn on PEP8 checking via the pytest-pep8 plugin and disable normal\n    tests. Same as specifying ``--pep8 -k pep8`` in ``args``.", "start_line": 497, "end_line": 514, "is_async": false, "is_method": false}, {"name": "pdb", "qualified_name": "pdb", "args": ["self", "pdb", "kwargs"], "decorators": ["keyword()"], "docstring": "pdb : bool, optional\n    Turn on PDB post-mortem analysis for failing tests. Same as\n    specifying ``--pdb`` in ``args``.", "start_line": 517, "end_line": 525, "is_async": false, "is_method": false}, {"name": "parallel", "qualified_name": "parallel", "args": ["self", "parallel", "kwargs"], "decorators": ["keyword(0)"], "docstring": "parallel : int or 'auto', optional\n    When provided, run the tests in parallel on the specified\n    number of CPUs.  If parallel is ``'auto'``, it will use the all\n    the cores on the machine.  Requires the ``pytest-xdist`` plugin.", "start_line": 528, "end_line": 545, "is_async": false, "is_method": false}, {"name": "docs_path", "qualified_name": "docs_path", "args": ["self", "docs_path", "kwargs"], "decorators": ["keyword()"], "docstring": "docs_path : str, optional\n    The path to the documentation .rst files.", "start_line": 548, "end_line": 569, "is_async": false, "is_method": false}, {"name": "skip_docs", "qualified_name": "skip_docs", "args": ["self", "skip_docs", "kwargs"], "decorators": ["keyword()"], "docstring": "skip_docs : `bool`, optional\n    When `True`, skips running the doctests in the .rst files.", "start_line": 572, "end_line": 578, "is_async": false, "is_method": false}, {"name": "repeat", "qualified_name": "repeat", "args": ["self", "repeat", "kwargs"], "decorators": ["keyword()"], "docstring": "repeat : `int`, optional\n    If set, specifies how many times each test should be run. This is\n    useful for diagnosing sporadic failures.", "start_line": 581, "end_line": 590, "is_async": false, "is_method": false}, {"name": "run_tests", "qualified_name": "run_tests", "args": ["self"], "decorators": [], "docstring": "", "start_line": 593, "end_line": 599, "is_async": false, "is_method": false}, {"name": "keyword", "qualified_name": "keyword", "args": [], "decorators": [], "docstring": "", "start_line": 40, "end_line": 41, "is_async": false, "is_method": false}, {"name": "test", "qualified_name": "test", "args": [], "decorators": ["wraps(runner.run_tests, ('__doc__',))"], "docstring": "", "start_line": 271, "end_line": 272, "is_async": false, "is_method": false}], "classes": [{"name": "keyword", "bases": [], "methods": ["__init__", "__call__"], "docstring": "A decorator to mark a method as keyword argument for the ``TestRunner``.\n\nParameters\n----------\ndefault_value : `object`\n    The default value for the keyword argument. (Default: `None`)\n\npriority : `int`\n    keyword argument methods are executed in order of descending priority.", "start_line": 22, "end_line": 49}, {"name": "TestRunnerBase", "bases": [], "methods": ["__init__", "__new__", "_generate_args", "_has_test_dependencies", "run_tests", "make_test_runner_in"], "docstring": "The base class for the TestRunner.\n\nA test runner can be constructed by creating a subclass of this class and\ndefining 'keyword' methods. These are methods that have the\n:class:`~astropy.tests.runner.keyword` decorator, these methods are used to\nconstruct allowed keyword arguments to the\n`~astropy.t", "start_line": 52, "end_line": 288}, {"name": "TestRunner", "bases": ["TestRunnerBase"], "methods": ["packages_path", "coverage", "package", "test_path", "args", "plugins", "verbose", "pastebin", "remote_data", "pep8", "pdb", "parallel", "docs_path", "skip_docs", "repeat", "run_tests"], "docstring": "A test runner for astropy tests.", "start_line": 291, "end_line": 599}], "calls": [], "module_docstring": "Implements the Astropy TestRunner which is a thin wrapper around pytest.", "parse_error": ""}, {"file_path": "astropy/wcs/wcs.py", "file_hash": "3a25d35499a5da1c1b98a4685d25f93b6498aef26403e3ac77583d55582f5901", "imports": [{"module": "builtins", "names": [], "is_from": false, "alias": ""}, {"module": "copy", "names": [], "is_from": false, "alias": ""}, {"module": "io", "names": [], "is_from": false, "alias": ""}, {"module": "itertools", "names": [], "is_from": false, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "textwrap", "names": [], "is_from": false, "alias": ""}, {"module": "uuid", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "packaging.version", "names": ["Version"], "is_from": true, "alias": ""}, {"module": "astropy", "names": ["log"], "is_from": true, "alias": ""}, {"module": "astropy", "names": ["units"], "is_from": true, "alias": ""}, {"module": "astropy.io", "names": ["fits"], "is_from": true, "alias": ""}, {"module": "astropy.utils.decorators", "names": ["deprecated_renamed_argument"], "is_from": true, "alias": ""}, {"module": "astropy.utils.exceptions", "names": ["AstropyDeprecationWarning", "AstropyUserWar