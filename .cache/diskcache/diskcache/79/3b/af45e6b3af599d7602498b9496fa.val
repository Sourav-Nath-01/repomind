", "htmldict", "numtable"], "decorators": [], "docstring": "Checks whether the given BeautifulSoup tag is the table\nthe user intends to process.", "start_line": 44, "end_line": 62, "is_async": false, "is_method": false}, {"name": "__new__", "qualified_name": "__new__", "args": ["cls"], "decorators": [], "docstring": "", "start_line": 25, "end_line": 26, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "val"], "decorators": [], "docstring": "", "start_line": 28, "end_line": 29, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "out"], "decorators": [], "docstring": "", "start_line": 37, "end_line": 38, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "data"], "decorators": [], "docstring": "", "start_line": 40, "end_line": 41, "is_async": false, "is_method": false}, {"name": "process_lines", "qualified_name": "process_lines", "args": ["self", "lines"], "decorators": [], "docstring": "Convert the given input into a list of SoupString rows\nfor further processing.", "start_line": 73, "end_line": 111, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "lines"], "decorators": [], "docstring": "Return HTML data from lines as a generator.", "start_line": 119, "end_line": 142, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "cols", "meta"], "decorators": [], "docstring": "Process the data in multidimensional columns.", "start_line": 160, "end_line": 180, "is_async": false, "is_method": false}, {"name": "start_line", "qualified_name": "start_line", "args": ["self", "lines"], "decorators": [], "docstring": "Return the line number at which header data begins.", "start_line": 186, "end_line": 197, "is_async": false, "is_method": false}, {"name": "_set_cols_from_names", "qualified_name": "_set_co