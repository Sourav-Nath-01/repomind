ck_iter", "is_binary", "sep", "endcard", "padding"], "decorators": ["classmethod"], "docstring": "The meat of `Header.fromfile`; in a separate method so that\n`Header.fromfile` itself is just responsible for wrapping file\nhandling.  Also used by `_BaseHDU.fromstring`.\n\n``block_iter`` should be a callable which, given a block size n\n(typically 2880 bytes as used by the FITS standard) returns an it", "start_line": 550, "end_line": 617, "is_async": false, "is_method": false}, {"name": "_find_end_card", "qualified_name": "_find_end_card", "args": ["cls", "block", "card_len"], "decorators": ["classmethod"], "docstring": "Utility method to search a header block for the END card and handle\ninvalid END cards.\n\nThis method can also returned a modified copy of the input header block\nin case an invalid end card needs to be sanitized.", "start_line": 620, "end_line": 666, "is_async": false, "is_method": false}, {"name": "tostring", "qualified_name": "tostring", "args": ["self", "sep", "endcard", "padding"], "decorators": [], "docstring": "Returns a string representation of the header.\n\nBy default this uses no separator between cards, adds the END card, and\npads the string with spaces to the next multiple of 2880 bytes.  That\nis, it returns the header exactly as it would appear in a FITS file.\n\nParameters\n----------\nsep : str, optiona", "start_line": 668, "end_line": 710, "is_async": false, "is_method": false}, {"name": "tofile", "qualified_name": "tofile", "args": ["self", "fileobj", "sep", "endcard", "padding", "overwrite"], "decorators": [], "docstring": "Writes the header to file or file-like object.\n\nBy default this writes the header exactly as it would be written to a\nFITS file, with the END card included and padding to the next multiple\nof 2880 bytes.  However, aspects of this may be controlled.\n\nParameters\n----------\nfileobj : path-like or file-", "start_line": 712, "end_line": 764, "is_async": false, "is_method": false}, {"name": "fromtextfile", "qualified_name": "fromtextfile", "args": ["cls", "fileobj", "endcard"], "decorators": ["classmethod"], "docstring": "Read a header from a simple text file or file-like object.\n\nEquivalent to::\n\n    >>> Header.fromfile(fileobj, sep='\\n', endcard=False,\n    ...                 padding=False)\n\nSee Also\n--------\nfromfile", "start_line": 767, "end_line": 780, "is_async": false, "is_method": false}, {"name": "totextfile", "qualified_name": "totextfile", "args": ["self", "fileobj", "endcard", "overwrite"], "decorators": [], "docstring": "Write the header as text to a file or a file-like object.\n\nEquivalent to::\n\n    >>> Header.tofile(fileobj, sep='\\n', endcard=False,\n    ...               padding=False, overwrite=overwrite)\n\nSee Also\n--------\ntofile", "start_line": 782, "end_line": 797, "is_async": false, "is_method": false}, {"name": "clear", "qualified_name": "clear", "args": ["self"], "decorators": [], "docstring": "Remove all cards from the header.", "start_line": 799, "end_line": 805, "is_async": false, "is_method": false}, {"name": "copy", "qualified_name": "copy", "args": ["self", "strip"], "decorators": [], "docstring": "Make a copy of the :class:`Header`.\n\n.. versionchanged:: 1.3\n    `copy.copy` and `copy.deepcopy` on a `Header` will call this\n    method.\n\nParameters\n----------\nstrip : bool, optional\n    If `True`, strip any headers that are specific to one of the\n    standard HDU types, so that this header can be ", "start_line": 807, "end_line": 830, "is_async": false, "is_method": false}, {"name": "__copy__", "qualified_name": "__copy__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 832, "end_line": 833, "is_async": false, "is_method": false}, {"name": "__deepcopy__", "qualified_name": "__deepcopy__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 835, "end_line": 836, "is_async": false, "is_method": false}, {"name": "fromkeys", "qualified_name": "fromkeys", "args": ["cls", "iterable", "value"], "decorators": ["classmethod"], "docstring": "Similar to :meth:`dict.fromkeys`--creates a new `Header` from an\niterable of keywords and an optional default value.\n\nThis method is not likely to be particularly useful for creating real\nworld FITS headers, but it is useful for testing.\n\nParameters\n----------\niterable\n    Any iterable that returns ", "start_line": 839, "end_line": 866, "is_async": false, "is_method": false}, {"name": "get", "qualified_name": "get", "args": ["self", "key", "default"], "decorators": [], "docstring": "Similar to :meth:`dict.get`--returns the value associated with keyword\nin the header, or a default value if the keyword is not found.\n\nParameters\n----------\nkey : str\n    A keyword that may or may not be in the header.\n\ndefault : optional\n    A default value to return if the keyword is not found in ", "start_line": 868, "end_line": 891, "is_async": false, "is_method": false}, {"name": "set", "qualified_name": "set", "args": ["self", "keyword", "value", "comment", "before", "after"], "decorators": [], "docstring": "Set the value and/or comment and/or position of a specified keyword.\n\nIf the keyword does not already exist in the header, a new keyword is\ncreated in the specified position, or appended to the end of the header\nif no position is specified.\n\nThis method is similar to :meth:`Header.update` prior to A", "start_line": 893, "end_line": 977, "is_async": false, "is_method": false}, {"name": "items", "qualified_name": "items", "args": ["self"], "decorators": [], "docstring": "Like :meth:`dict.items`.", "start_line": 979, "end_line": 982, "is_async": false, "is_method": false}, {"name": "keys", "qualified_name": "keys", "args": ["self"], "decorators": [], "docstring": "Like :meth:`dict.keys`--iterating directly over the `Header`\ninstance has the same behavior.", "start_line": 984, "end_line": 990, "is_async": false, "is_method": false}, {"name": "values", "qualified_name": "values", "args": ["self"], "decorators": [], "docstring": "Like :meth:`dict.values`.", "start_line": 992, "end_line": 995, "is_async": false, "is_method": false}, {"name": "pop", "qualified_name": "pop", "args": ["self"], "decorators": [], "docstring": "Works like :meth:`list.pop` if no arguments or an index argument are\nsupplied; otherwise works like :meth:`dict.pop`.", "start_line": 997, "end_line": 1018, "is_async": false, "is_method": false}, {"name": "popitem", "qualified_name": "popitem", "args": ["self"], "decorators": [], "docstring": "Similar to :meth:`dict.popitem`.", "start_line": 1020, "end_line": 1027, "is_async": false, "is_method": false}, {"name": "setdefault", "qualified_name": "setdefault", "args": ["self", "key", "default"], "decorators": [], "docstring": "Similar to :meth:`dict.setdefault`.", "start_line": 1029, "end_line": 1035, "is_async": false, "is_method": false}, {"name": "update", "qualified_name": "update", "args": ["self"], "decorators": [], "docstring": "Update the Header with new keyword values, updating the values of\nexisting keywords and appending new keywords otherwise; similar to\n`dict.update`.\n\n`update` accepts either a dict-like object or an iterable.  In the\nformer case the keys must be header keywords and the values may be\neither scalar val", "start_line": 1037, "end_line": 1149, "is_async": false, "is_method": false}, {"name": "append", "qualified_name": "append", "args": ["self", "card", "useblanks", "bottom", "end"], "decorators": [], "docstring": "Appends a new keyword+value card to the end of the Header, similar\nto `list.append`.\n\nBy default if the last cards in the Header have commentary keywords,\nthis will append the new keyword before the commentary (unless the new\nkeyword is also commentary).\n\nAlso differs from `list.append` in that it c", "start_line": 1151, "end_line": 1238, "is_async": false, "is_method": false}, {"name": "extend", "qualified_name": "extend", "args": ["self", "cards", "strip", "unique", "update", "update_first", "useblanks", "bottom", "end"], "decorators": [], "docstring": "Appends multiple keyword+value cards to the end of the header, similar\nto `list.extend`.\n\nParameters\n----------\ncards : iterable\n    An iterable of (keyword, value, [comment]) tuples; see\n    `Header.append`.\n\nstrip : bool, optional\n    Remove any keywords that have meaning only to specific types of", "start_line": 1240, "end_line": 1347, "is_async": false, "is_method": false}, {"name": "count", "qualified_name": "count", "args": ["self", "keyword"], "decorators": [], "docstring": "Returns the count of the given keyword in the header, similar to\n`list.count` if the Header object is treated as a list of keywords.\n\nParameters\n----------\nkeyword : str\n    The keyword to count instances of in the header", "start_line": 1349, "end_line": 1367, "is_async": false, "is_method": false}, {"name": "index", "qualified_name": "index", "args": ["self", "keyword", "start", "stop"], "decorators": [], "docstring": "Returns the index if the first instance of the given keyword in the\nheader, similar to `list.index` if the Header object is treated as a\nlist of keywords.\n\nParameters\n----------\nkeyword : str\n    The keyword to look up in the list of all keywords in the header\n\nstart : int, optional\n    The lower bo", "start_line": 1369, "end_line": 1404, "is_async": false, "is_method": false}, {"name": "insert", "qualified_name": "insert", "args": ["self", "key", "card", "useblanks", "after"], "decorators": [], "docstring": "Inserts a new keyword+value card into the Header at a given location,\nsimilar to `list.insert`.\n\nParameters\n----------\nkey : int, str, or tuple\n    The index into the list of header keywords before which the\n    new keyword should be inserted, or the name of a keyword before\n    which the new keywor", "start_line": 1406, "end_line": 1500, "is_async": false, "is_method": false}, {"name": "remove", "qualified_name": "remove", "args": ["self", "keyword", "ignore_missing", "remove_all"], "decorators": [], "docstring": "Removes the first instance of the given keyword from the header similar\nto `list.remove` if the Header object is treated as a list of keywords.\n\nParameters\n----------\nkeyword : str\n    The keyword of which to remove the first instance in the header.\n\nignore_missing : bool, optional\n    When True, ig", "start_line": 1502, "end_line": 1528, "is_async": false, "is_method": false}, {"name": "rename_keyword", "qualified_name": "rename_keyword", "args": ["self", "oldkeyword", "newkeyword", "force"], "decorators": [], "docstring": "Rename a card's keyword in the header.\n\nParameters\n----------\noldkeyword : str or int\n    Old keyword or card index\n\nnewkeyword : str\n    New keyword\n\nforce : bool, optional\n    When `True`, if the new keyword already exists in the header, force\n    the creation of a duplicate keyword. Otherwise a\n ", "start_line": 1530, "end_line": 1564, "is_async": false, "is_method": false}, {"name": "add_history", "qualified_name": "add_history", "args": ["self", "value", "before", "after"], "decorators": [], "docstring": "Add a ``HISTORY`` card.\n\nParameters\n----------\nvalue : str\n    History text to be added.\n\nbefore : str or int, optional\n    Same as in `Header.update`\n\nafter : str or int, optional\n    Same as in `Header.update`", "start_line": 1566, "end_line": 1581, "is_async": false, "is_method": false}, {"name": "add_comment", "qualified_name": "add_comment", "args": ["self", "value", "before", "after"], "decorators": [], "docstring": "Add a ``COMMENT`` card.\n\nParameters\n----------\nvalue : str\n    Text to be added.\n\nbefore : str or int, optional\n    Same as in `Header.update`\n\nafter : str or int, optional\n    Same as in `Header.update`", "start_line": 1583, "end_line": 1598, "is_async": false, "is_method": false}, {"name": "add_blank", "qualified_name": "add_blank", "args": ["self", "value", "before", "after"], "decorators": [], "docstring": "Add a blank card.\n\nParameters\n----------\nvalue : str, optional\n    Text to be added.\n\nbefore : str or int, optional\n    Same as in `Header.update`\n\nafter : str or int, optional\n    Same as in `Header.update`", "start_line": 1600, "end_line": 1615, "is_async": false, "is_method": false}, {"name": "strip", "qualified_name": "strip", "args": ["self"], "decorators": [], "docstring": "Strip cards specific to a certain kind of header.\n\nStrip cards like ``SIMPLE``, ``BITPIX``, etc. so the rest of\nthe header can be used to reconstruct another kind of header.", "start_line": 1617, "end_line": 1666, "is_async": false, "is_method": false}, {"name": "data_size", "qualified_name": "data_size", "args": ["self"], "decorators": ["property"], "docstring": "Return the size (in bytes) of the data portion following the `Header`.", "start_line": 1669, "end_line": 1673, "is_async": false, "is_method": false}, {"name": "data_size_padded", "qualified_name": "data_size_padded", "args": ["self"], "decorators": ["property"], "docstring": "Return the size (in bytes) of the data portion following the `Header`\nincluding padding.", "start_line": 1676, "end_line": 1682, "is_async": false, "is_method": false}, {"name": "_update", "qualified_name": "_update", "args": ["self", "card"], "decorators": [], "docstring": "The real update code.  If keyword already exists, its value and/or\ncomment will be updated.  Otherwise a new card will be appended.\n\nThis will not create a duplicate keyword except in the case of\ncommentary cards.  The only other way to force creation of a duplicate\nis to use the insert(), append(),", "start_line": 1684, "end_line": 1723, "is_async": false, "is_method": false}, {"name": "_cardindex", "qualified_name": "_cardindex", "args": ["self", "key"], "decorators": [], "docstring": "Returns an index into the ._cards list given a valid lookup key.", "start_line": 1725, "end_line": 1778, "is_async": false, "is_method": false}, {"name": "_keyword_from_index", "qualified_name": "_keyword_from_index", "args": ["self", "idx"], "decorators": [], "docstring": "Given an integer index, return the (keyword, repeat) tuple that index\nrefers to.  For most keywords the repeat will always be zero, but it\nmay be greater than zero for keywords that are duplicated (especially\ncommentary keywords).\n\nIn a sense this is the inverse of self.index, except that it also\nsu", "start_line": 1780, "end_line": 1796, "is_async": false, "is_method": false}, {"name": "_relativeinsert", "qualified_name": "_relativeinsert", "args": ["self", "card", "before", "after", "replace"], "decorators": [], "docstring": "Inserts a new card before or after an existing card; used to\nimplement support for the legacy before/after keyword arguments to\nHeader.update().\n\nIf replace=True, move an existing card with the same keyword.", "start_line": 1798, "end_line": 1855, "is_async": false, "is_method": false}, {"name": "_updateindices", "qualified_name": "_updateindices", "args": ["self", "idx", "increment"], "decorators": [], "docstring": "For all cards with index above idx, increment or decrement its index\nvalue in the keyword_indices dict.", "start_line": 1857, "end_line": 1872, "is_async": false, "is_method": false}, {"name": "_countblanks", "qualified_name": "_countblanks", "args": ["self"], "decorators": [], "docstring": "Returns the number of blank cards at the end of the Header.", "start_line": 1874, "end_line": 1879, "is_async": false, "is_method": false}, {"name": "_useblanks", "qualified_name": "_useblanks", "args": ["self", "count"], "decorators": [], "docstring": "", "start_line": 1881, "end_line": 1886, "is_async": false, "is_method": false}, {"name": "_haswildcard", "qualified_name": "_haswildcard", "args": ["self", "keyword"], "decorators": [], "docstring": "Return `True` if the input keyword contains a wildcard pattern.", "start_line": 1888, "end_line": 1892, "is_async": false, "is_method": false}, {"name": "_wildcardmatch", "qualified_name": "_wildcardmatch", "args": ["self", "pattern"], "decorators": [], "docstring": "Returns a list of indices of the cards matching the given wildcard\npattern.\n\n * '*' matches 0 or more characters\n * '?' matches a single character\n * '...' matches 0 or more of any non-whitespace character", "start_line": 1894, "end_line": 1906, "is_async": false, "is_method": false}, {"name": "_set_slice", "qualified_name": "_set_slice", "args": ["self", "key", "value", "target"], "decorators": [], "docstring": "Used to implement Header.__setitem__ and CardAccessor.__setitem__.", "start_line": 1908, "end_line": 1926, "is_async": false, "is_method": false}, {"name": "_splitcommentary", "qualified_name": "_splitcommentary", "args": ["self", "keyword", "value"], "decorators": [], "docstring": "Given a commentary keyword and value, returns a list of the one or more\ncards needed to represent the full value.  This is primarily used to\ncreate the multiple commentary cards needed to represent a long value\nthat won't fit into a single commentary card.", "start_line": 1928, "end_line": 1952, "is_async": false, "is_method": false}, {"name": "_add_commentary", "qualified_name": "_add_commentary", "args": ["self", "key", "value", "before", "after"], "decorators": [], "docstring": "Add a commentary card.\n\nIf ``before`` and ``after`` are `None`, add to the last occurrence\nof cards of the same name (except blank card).  If there is no\ncard (or blank card), append at the end.", "start_line": 1954, "end_line": 1965, "is_async": false, "is_method": false}, {"name": "__get__", "qualified_name": "__get__", "args": ["self", "obj", "owner"], "decorators": [], "docstring": "", "start_line": 1978, "end_line": 1991, "is_async": false, "is_method": false}, {"name": "__set__", "qualified_name": "__set__", "args": ["self", "obj", "val"], "decorators": [], "docstring": "", "start_line": 1993, "end_line": 1994, "is_async": false, "is_method": false}, {"name": "__delete__", "qualified_name": "__delete__", "args": ["self", "obj"], "decorators": [], "docstring": "", "start_line": 1996, "end_line": 1997, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "header"], "decorators": [], "docstring": "", "start_line": 2010, "end_line": 2011, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "key"], "decorators": [], "docstring": "", "start_line": 2013, "end_line": 2025, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "cards"], "decorators": [], "docstring": "", "start_line": 2041, "end_line": 2051, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "key"], "decorators": [], "docstring": "", "start_line": 2053, "end_line": 2063, "is_async": false, "is_method": false}, {"name": "__len__", "qualified_name": "__len__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2065, "end_line": 2066, "is_async": false, "is_method": false}, {"name": "__iter__", "qualified_name": "__iter__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2068, "end_line": 2069, "is_async": false, "is_method": false}, {"name": "index", "qualified_name": "index", "args": ["self", "keyword"], "decorators": [], "docstring": "", "start_line": 2071, "end_line": 2072, "is_async": false, "is_method": false}, {"name": "data_size", "qualified_name": "data_size", "args": ["self"], "decorators": ["property"], "docstring": "Return the size (in bytes) of the data portion following the `Header`.", "start_line": 2075, "end_line": 2079, "is_async": false, "is_method": false}, {"name": "data_size_padded", "qualified_name": "data_size_padded", "args": ["self"], "decorators": ["property"], "docstring": "Return the size (in bytes) of the data portion following the `Header`\nincluding padding.", "start_line": 2082, "end_line": 2088, "is_async": false, "is_method": false}, {"name": "fromfile", "qualified_name": "fromfile", "args": ["cls", "fileobj"], "decorators": ["classmethod"], "docstring": "The main method to parse a FITS header from a file. The parsing is\ndone with the parse_header function implemented in Cython.", "start_line": 2091, "end_line": 2106, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "header"], "decorators": [], "docstring": "", "start_line": 2121, "end_line": 2122, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2124, "end_line": 2125, "is_async": false, "is_method": false}, {"name": "__len__", "qualified_name": "__len__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2127, "end_line": 2128, "is_async": false, "is_method": false}, {"name": "__iter__", "qualified_name": "__iter__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2130, "end_line": 2131, "is_async": false, "is_method": false}, {"name": "__eq__", "qualified_name": "__eq__", "args": ["self", "other"], "decorators": [], "docstring": "", "start_line": 2133, "end_line": 2142, "is_async": false, "is_method": false}, {"name": "__ne__", "qualified_name": "__ne__", "args": ["self", "other"], "decorators": [], "docstring": "", "start_line": 2144, "end_line": 2145, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "item"], "decorators": [], "docstring": "", "start_line": 2147, "end_line": 2152, "is_async": false, "is_method": false}, {"name": "_setslice", "qualified_name": "_setslice", "args": ["self", "item", "value"], "decorators": [], "docstring": "Helper for implementing __setitem__ on _CardAccessor subclasses; slices\nshould always be handled in this same way.", "start_line": 2154, "end_line": 2169, "is_async": false, "is_method": false}, {"name": "__iter__", "qualified_name": "__iter__", "args": ["s