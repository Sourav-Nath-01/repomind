ses": ["io_registry.UnifiedReadWrite"], "methods": ["__init__", "__call__"], "docstring": "Transform object to a `~astropy.cosmology.Cosmology`.\n\nThis function provides the Cosmology interface to the Astropy unified I/O\nlayer. This allows easily parsing supported data formats using\nsyntax such as::\n\n  >>> from astropy.cosmology import Cosmology\n  >>> cosmo1 = Cosmology.from_format(cosmo_m", "start_line": 136, "end_line": 205}, {"name": "CosmologyToFormat", "bases": ["io_registry.UnifiedReadWrite"], "methods": ["__init__", "__call__"], "docstring": "Transform this Cosmology to another format.\n\nThis function provides the Cosmology interface to the astropy unified I/O\nlayer. This allows easily transforming to supported data formats\nusing syntax such as::\n\n  >>> from astropy.cosmology import Planck18\n  >>> Planck18.to_format(\"mapping\")\n  {'cosmolo", "start_line": 208, "end_line": 246}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/cosmology/__init__.py", "file_hash": "0ab925cc7eb7342b29bf06d120689b2ecbf9ff6e53ae70a5b58cbab4b8d11ac4", "imports": [{"module": "", "names": ["core", "flrw", "funcs", "parameter", "realizations", "units", "utils"], "is_from": true, "alias": ""}, {"module": "core", "names": ["*"], "is_from": true, "alias": ""}, {"module": "flrw", "names": ["*"], "is_from": true, "alias": ""}, {"module": "funcs", "names": ["*"], "is_from": true, "alias": ""}, {"module": "parameter", "names": ["*"], "is_from": true, "alias": ""}, {"module": "realizations", "names": ["available", "default_cosmology"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["*"], "is_from": true, "alias": ""}], "functions": [{"name": "__getattr__", "qualified_name": "__getattr__", "args": ["name"], "decorators": [], "docstring": "Get realizations using lazy import from\n`PEP 562 <https://www.python.org/dev/peps/pep-0562/>`_.\n\nRaises\n------\nAttributeError\n    If \"name\" is not in :mod:`astropy.cosmology.realizations`", "start_line": 31, "end_line": 43, "is_async": false, "is_method": false}, {"name": "__dir__", "qualified_name": "__dir__", "args": [], "decorators": [], "docstring": "Directory, including lazily-imported objects.", "start_line": 46, "end_line": 48, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "``astropy.cosmology`` contains classes and functions for cosmological\ndistance measures and other cosmology-related calculations.\n\nSee the `Astropy documentation\n<https://docs.astropy.org/en/latest/cosmology/index.html>`_ for more\ndetailed usage examples and references.", "parse_error": ""}, {"file_path": "astropy/cosmology/utils.py", "file_hash": "be3563a2f7012bf48ac62e33419fd4f2eade1ec892121d3683ca1713cfe78edb", "imports": [{"module": "functools", "names": [], "is_from": false, "alias": ""}, {"module": "numbers", "names": ["Number"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy.units", "names": ["Quantity"], "is_from": true, "alias": ""}, {"module": "", "names": ["units"], "is_from": true, "alias": ""}], "functions": [{"name": "vectorize_redshift_method", "qualified_name": "vectorize_redshift_method", "args": ["func", "nin"], "decorators": [], "docstring": "Vectorize a method of redshift(s).\n\nParameters\n----------\nfunc : callable or None\n    method to wrap. If `None` returns a :func:`functools.partial`\n    with ``nin`` loaded.\nnin : int\n    Number of positional redshift arguments.\n\nReturns\n-------\nwrapper : callable\n    :func:`functools.wraps` of ``fun", "start_line": 15, "end_line": 57, "is_async": false, "is_method": false}, {"name": "aszarr", "qualified_name": "aszarr", "args": ["z"], "decorators": [], "docstring": "Redshift as a `~numbers.Number` or `~numpy.ndarray` / |Quantity| / |Column|.\nAllows for any ndarray ducktype by checking for attribute \"shape\".", "start_line": 60, "end_line": 72, "is_async": false, "is_method": false}, {"name": "wrapper", "qualified_name": "wrapper", "args": ["self"], "decorators": ["functools.wraps(func)"], "docstring": ":func:`functools.wraps` of ``func`` where the first ``nin``\narguments are converted from |Quantity| to `numpy.ndarray` or scalar.", "start_line": 37, "end_line": 52, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/cosmology/parameters.py", "file_hash": "4524af84164587a5d7cf5f73ac6a3110df2df67358267d9d79650e922da881a4", "imports": [{"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "types", "names": ["MappingProxyType"], "is_from": true, "alias": ""}, {"module": "realizations", "names": ["available"], "is_from": true, "alias": ""}, {"module": "astropy.cosmology", "names": ["realizations"], "is_from": true, "alias": ""}], "functions": [{"name": "__getattr__", "qualified_name": "__getattr__", "args": ["name"], "decorators": [], "docstring": "Get parameters of cosmology representations with lazy import from\n`PEP 562 <https://www.python.org/dev/peps/pep-0562/>`_.", "start_line": 69, "end_line": 82, "is_async": false, "is_method": false}, {"name": "__dir__", "qualified_name": "__dir__", "args": [], "decorators": [], "docstring": "Directory, including lazily-imported objects.", "start_line": 85, "end_line": 87, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This module contains dictionaries with sets of parameters for a\ngiven cosmology.\n\nEach cosmology has the following parameters defined:\n\n    ==========  =====================================\n    Oc0         Omega cold dark matter at z=0\n    Ob0         Omega baryon at z=0\n    Om0         Omega matter at z=0\n    flat        Is this assumed flat?  If not, Ode0 must be specified\n    Ode0        Omega dark energy at z=0 if flat is False\n    H0          Hubble parameter at z=0 in km/s/Mpc\n    n           Density perturbation spectral index\n    Tcmb0       Current temperature of the CMB\n    Neff        Effective number of neutrino species\n    m_nu        Assumed mass of neutrino species, in eV.\n    sigma8      Density perturbation amplitude\n    tau         Ionisation optical depth\n    z_reion     Redshift of hydrogen reionisation\n    t0          Age of the universe in Gyr\n    reference   Reference for the parameters\n    ==========  =====================================\n\nThe list of cosmologies available are given by the tuple\n`available`. Current cosmologies available:\n\nPlanck 2018 (Planck18) parameters from Planck Collaboration 2020,\n A&A, 641, A6 (Paper VI), Table 2 (TT, TE, EE + lowE + lensing + BAO)\n\nPlanck 2015 (Planck15) parameters from Planck Collaboration 2016, A&A, 594, A13\n (Paper XIII), Table 4 (TT, TE, EE + lowP + lensing + ext)\n\nPlanck 2013 (Planck13) parameters from Planck Collaboration 2014, A&A, 571, A16\n (Paper XVI), Table 5 (Planck + WP + highL + BAO)\n\nWMAP 9 year (WMAP9) parameters from Hinshaw et al. 2013, ApJS, 208, 19,\ndoi: 10.1088/0067-0049/208/2/19. Table 4 (WMAP9 + eCMB + BAO + H0)\n\nWMAP 7 year (WMAP7) parameters from Komatsu et al. 2011, ApJS, 192, 18,\ndoi: 10.1088/0067-0049/192/2/18. Table 1 (WMAP + BAO + H0 ML).\n\nWMAP 5 year (WMAP5) parameters from Komatsu et al. 2009, ApJS, 180, 330,\ndoi: 10.1088/0067-0049/180/2/330. Table 1 (WMAP + BAO + SN ML).\n\nWMAP 3 year (WMAP3) parameters from Spergel et al. 2007, ApJS, 170, 377,\ndoi:  10.1086/513700. Table 6. (WMAP + SNGold) Obtained from\nhttps://lambda.gsfc.nasa.gov/product/map/dr2/params/lcdm_wmap_sngold.cfm\nTcmb0 and Neff are the standard values as also used for WMAP5, 7, 9.\nPending WMAP team approval and subject to change.\n\nWMAP 1 year (WMAP1) parameters from Spergel et al. 2003, ApJS, 148, 175,\ndoi:  10.1086/377226. Table 7 (WMAP + CBI + ACBAR + 2dFGRS + Lya)\nTcmb0 and Neff are the standard values as also used for WMAP5, 7, 9.\nPending WMAP team approval and subject to change.", "parse_error": ""}, {"file_path": "astropy/cosmology/realizations.py", "file_hash": "46ed7be7bab4a732719137d922f9c4c0e4b7c5f710d4309847042c9e7d71cf95", "imports": [{"module": "pathlib", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "typing", "names": ["Optional", "Union"], "is_from": true, "alias": ""}, {"module": "astropy.utils.data", "names": ["get_pkg_data_path"], "is_from": true, "alias": ""}, {"module": "astropy.utils.decorators", "names": ["deprecated"], "is_from": true, "alias": ""}, {"module": "astropy.utils.state", "names": ["ScienceState"], "is_from": true, "alias": ""}, {"module": "", "names": ["_io"], "is_from": true, "alias": ""}, {"module": "core", "names": ["Cosmology"], "is_from": true, "alias": ""}], "functions": [{"name": "__getattr__", "qualified_name": "__getattr__", "args": ["name"], "decorators": [], "docstring": "Make specific realizations from data files with lazy import from\n`PEP 562 <https://www.python.org/dev/peps/pep-0562/>`_.\n\nRaises\n------\nAttributeError\n    If \"name\" is not in :mod:`astropy.cosmology.realizations`", "start_line": 27, "end_line": 50, "is_async": false, "is_method": false}, {"name": "__dir__", "qualified_name": "__dir__", "args": [], "decorators": [], "docstring": "Directory, including lazily-imported objects.", "start_line": 53, "end_line": 55, "is_async": false, "is_method": false}, {"name": "get_cosmology_from_string", "qualified_name": "get_cosmology_from_string", "args": ["cls", "arg"], "decorators": ["deprecated('5.0', alternative='get')", "classmethod"], "docstring": "Return a cosmology instance from a string.", "start_line": 90, "end_line": 96, "is_async": false, "is_method": false}, {"name": "validate", "qualified_name": "validate", "args": ["cls", "value"], "decorators": ["classmethod"], "docstring": "Return a Cosmology given a value.\n\nParameters\n----------\nvalue : None, str, or `~astropy.cosmology.Cosmology`\n\nReturns\n-------\n`~astropy.cosmology.Cosmology` instance\n\nRaises\n------\nTypeError\n    If ``value`` is not a string or |Cosmology|.", "start_line": 99, "end_line": 132, "is_async": false, "is_method": false}, {"name": "_get_from_registry", "qualified_name": "_get_from_registry", "args": ["cls", "name"], "decorators": ["classmethod"], "docstring": "Get a registered Cosmology realization.\n\nParameters\n----------\nname : str\n    The built-in |Cosmology| realization to retrieve.\n\nReturns\n-------\n`astropy.cosmology.Cosmology`\n    The cosmology realization of `name`.\n\nRaises\n------\nValueError\n    If ``name`` is a str, but not for a built-in Cosmology", "start_line": 135, "end_line": 165, "is_async": false, "is_method": false}], "classes": [{"name": "default_cosmology", "bases": ["ScienceState"], "methods": ["get_cosmology_from_string", "validate", "_get_from_registry"], "docstring": "The default cosmology to use.\n\nTo change it::\n\n    >>> from astropy.cosmology import default_cosmology, WMAP7\n    >>> with default_cosmology.set(WMAP7):\n    ...     # WMAP7 cosmology in effect\n    ...     pass\n\nOr, you may use a string::\n\n    >>> with default_cosmology.set('WMAP7'):\n    ...     # WM", "start_line": 63, "end_line": 165}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/cosmology/units.py", "file_hash": "ad728ba9366053fa37a2269fadeae79ae3a43a50cf373143211eaba89a01860f", "imports": [{"module": "astropy.units", "names": [], "is_from": false, "alias": "u"}, {"module": "astropy.units.utils", "names": ["generate_unit_summary"], "is_from": true, "alias": ""}, {"module": "astropy.cosmology", "names": ["default_cosmology", "z_at_value"], "is_from": true, "alias": ""}, {"module": "astropy.cosmology", "names": ["default_cosmology", "z_at_value"], "is_from": true, "alias": ""}, {"module": "astropy.cosmology", "names": ["default_cosmology", "z_at_value"], "is_from": true, "alias": ""}, {"module": "astropy.cosmology", "names": ["default_cosmology"], "is_from": true, "alias": ""}, {"module": "realizations", "names": ["default_cosmology"], "is_from": true, "alias": ""}], "functions": [{"name": "dimensionless_redshift", "qualified_name": "dimensionless_redshift", "args": [], "decorators": [], "docstring": "Allow redshift to be 1-to-1 equivalent to dimensionless.\n\nIt is special compared to other equivalency pairs in that it\nallows this independent of the power to which the redshift is raised,\nand independent of whether it is part of a more complicated unit.\nIt is similar to u.dimensionless_angles() in ", "start_line": 59, "end_line": 67, "is_async": false, "is_method": false}, {"name": "redshift_distance", "qualified_name": "redshift_distance", "args": ["cosmology", "kind"], "decorators": [], "docstring": "Convert quantities between redshift and distance.\n\nCare should be taken to not misinterpret a relativistic, gravitational, etc\nredshift as a cosmological one.\n\nParameters\n----------\ncosmology : `~astropy.cosmology.Cosmology`, str, or None, optional\n    A cosmology realization or built-in cosmology's", "start_line": 70, "end_line": 146, "is_async": false, "is_method": false}, {"name": "redshift_hubble", "qualified_name": "redshift_hubble", "args": ["cosmology"], "decorators": [], "docstring": "Convert quantities between redshift and Hubble parameter and little-h.\n\nCare should be taken to not misinterpret a relativistic, gravitational, etc\nredshift as a cosmological one.\n\nParameters\n----------\ncosmology : `~astropy.cosmology.Cosmology`, str, or None, optional\n    A cosmology realization or", "start_line": 149, "end_line": 214, "is_async": false, "is_method": false}, {"name": "redshift_temperature", "qualified_name": "redshift_temperature", "args": ["cosmology"], "decorators": [], "docstring": "Convert quantities between redshift and CMB temperature.\n\nCare should be taken to not misinterpret a relativistic, gravitational, etc\nredshift as a cosmological one.\n\nParameters\n----------\ncosmology : `~astropy.cosmology.Cosmology`, str, or None, optional\n    A cosmology realization or built-in cosm", "start_line": 217, "end_line": 264, "is_async": false, "is_method": false}, {"name": "with_redshift", "qualified_name": "with_redshift", "args": ["cosmology"], "decorators": [], "docstring": "Convert quantities between measures of cosmological distance.\n\nNote: by default all equivalencies are on and must be explicitly turned off.\nCare should be taken to not misinterpret a relativistic, gravitational, etc\nredshift as a cosmological one.\n\nParameters\n----------\ncosmology : `~astropy.cosmolo", "start_line": 267, "end_line": 355, "is_async": false, "is_method": false}, {"name": "with_H0", "qualified_name": "with_H0", "args": ["H0"], "decorators": [], "docstring": "Convert between quantities with little-h and the equivalent physical units.\n\nParameters\n----------\nH0 : None or `~astropy.units.Quantity` ['frequency']\n    The value of the Hubble constant to assume. If a\n    `~astropy.units.Quantity`, will assume the quantity *is* ``H0``. If\n    `None` (default), u", "start_line": 361, "end_line": 385, "is_async": false, "is_method": false}, {"name": "z_to_distance", "qualified_name": "z_to_distance", "args": ["z"], "decorators": [], "docstring": "Redshift to distance.", "start_line": 134, "end_line": 136, "is_async": false, "is_method": false}, {"name": "distance_to_z", "qualified_name": "distance_to_z", "args": ["d"], "decorators": [], "docstring": "Distance to redshift.", "start_line": 138, "end_line": 140, "is_async": false, "is_method": false}, {"name": "z_to_hubble", "qualified_name": "z_to_hubble", "args": ["z"], "decorators": [], "docstring": "Redshift to Hubble parameter.", "start_line": 191, "end_line": 193, "is_async": false, "is_method": false}, {"name": "hubble_to_z", "qualified_name": "hubble_to_z", "args": ["H"], "decorators": [], "docstring": "Hubble parameter to redshift.", "start_line": 195, "end_line": 197, "is_async": false, "is_method": false}, {"name": "z_to_littleh", "qualified_name": "z_to_littleh", "args": ["z"], "decorators": [], "docstring": "Redshift to :math:`h`-unit Quantity.", "start_line": 199, "end_line": 201, "is_async": false, "is_method": false}, {"name": "littleh_to_z", "qualified_name": "littleh_to_z", "args": ["h"], "decorators": [], "docstring": ":math:`h`-unit Quantity to redshift.", "start_line": 203, "end_line": 205, "is_async": false, "is_method": false}, {"name": "z_to_Tcmb", "qualified_name": "z_to_Tcmb", "args": ["z"], "decorators": [], "docstring": "", "start_line": 254, "end_line": 255, "is_async": false, "is_method": false}, {"name": "Tcmb_to_z", "qualified_name": "Tcmb_to_z", "args": ["T"], "decorators": [], "docstring": "", "start_line": 257, "end_line": 258, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "Cosmological units and equivalencies.", "parse_error": ""}, {"file_path": "astropy/cosmology/core.py", "file_hash": "0b22e7d4d6666fc666f9e825eef4be940dbabe826a4a1efcdb4023f8e173c501", "imports": [{"module": "__future__", "names": ["annotations"], "is_from": true, "alias": ""}, {"module": "abc", "names": [], "is_from": false, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "typing", "names": ["TYPE_CHECKING", "Any", "TypeVar"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy.io.registry", "names": ["UnifiedReadWriteMethod"], "is_from": true, "alias": ""}, {"module": "astropy.utils.decorators", "names": ["classproperty"], "is_from": true, "alias": ""}, {"module": "astropy.utils.metadata", "names": ["MetaData"], "is_from": true, "alias": ""}, {"module": "connect", "names": ["CosmologyFromFormat", "CosmologyRead", "CosmologyToFormat", "CosmologyWrite"], "is_from": true, "alias": ""}, {"module": "parameter", "names": ["Parameter"], "is_from": true, "alias": ""}, {"module": "collections.abc", "names": ["Mapping"], "is_from": tr