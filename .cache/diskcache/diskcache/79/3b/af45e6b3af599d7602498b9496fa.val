treams, etc.", "start_line": 49, "end_line": 102}, {"name": "_mapfunc", "bases": [], "methods": ["__init__", "__call__"], "docstring": "A function wrapper to support ProgressBar.map().", "start_line": 468, "end_line": 478}, {"name": "ProgressBar", "bases": [], "methods": ["__init__", "_handle_resize", "__enter__", "__exit__", "__iter__", "__next__", "update", "_update_console", "_update_ipython_widget", "_silent_update", "map", "map_unordered"], "docstring": "A class to display a progress bar in the terminal.\n\nIt is designed to be used either with the ``with`` statement::\n\n    with ProgressBar(len(items)) as bar:\n        for item in enumerate(items):\n            bar.update()\n\nor as a generator::\n\n    for item in ProgressBar(items):\n        item.process()", "start_line": 481, "end_line": 849}, {"name": "Spinner", "bases": [], "methods": ["__init__", "_iterator", "__enter__", "__exit__", "__iter__", "__next__", "update", "_silent_iterator"], "docstring": "A class to display a spinner in the terminal.\n\nIt is designed to be used with the ``with`` statement::\n\n    with Spinner(\"Reticulating splines\", \"green\") as s:\n        for item in enumerate(items):\n            s.update()", "start_line": 852, "end_line": 983}, {"name": "ProgressBarOrSpinner", "bases": [], "methods": ["__init__", "__enter__", "__exit__", "update"], "docstring": "A class that displays either a `ProgressBar` or `Spinner`\ndepending on whether the total size of the operation is\nknown or not.\n\nIt is designed to be used with the ``with`` statement::\n\n    if file.has_length():\n        length = file.get_length()\n    else:\n        length = None\n    bytes_read = 0\n  ", "start_line": 986, "end_line": 1053}, {"name": "Getch", "bases": [], "methods": ["__init__", "__call__"], "docstring": "Get a single character from standard input without screen echo.\n\nReturns\n-------\nchar : str (one character)", "start_line": 1140, "end_line": 1158}, {"name": "_GetchUnix", "bases": [], "methods": ["__init__", "__call__"], "docstring": "", "start_line": 1161, "end_line": 1182}, {"name": "_GetchWindows", "bases": [], "methods": ["__init__", "__call__"], "docstring": "", "start_line": 1185, "end_line": 1192}, {"name": "_GetchMacCarbon", "bases": [], "methods": ["__init__", "__call__"], "docstring": "A function which returns the current ASCII key that is down;\nif no ASCII key is down, the null string is returned.  The\npage http://www.mactech.com/macintosh-c/chap02-1.html was\nvery helpful in figuring out how to do this.", "start_line": 1195, "end_line": 1224}], "calls": [], "module_docstring": "Utilities for console input and output.", "parse_error": ""}, {"file_path": "astropy/utils/shapes.py", "file_hash": "666af9b9636ee27f597d54dbdf0ee469459f09239187cc9b831643d35c438180", "imports": [{"module": "abc", "names": [], "is_from": false, "alias": ""}, {"module": "numbers", "names": [], "is_from": false, "alias": ""}, {"module": "itertools", "names": ["zip_longest"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}], "functions": [{"name": "check_broadcast", "qualified_name": "check_broadcast", "args": [], "decorators": [], "docstring": "Determines whether two or more Numpy arrays can be broadcast with each\nother based on their shape tuple alone.\n\nParameters\n----------\n*shapes : tuple\n    All shapes to include in the comparison.  If only one shape is given it\n    is passed through unmodified.  If no shapes are given returns an empty", "start_line": 331, "end_line": 376, "is_async": false, "is_method": false}, {"name": "unbroadcast", "qualified_name": "unbroadcast", "args": ["array"], "decorators": [], "docstring": "Given an array, return a new array that is the smallest subset of the\noriginal array that can be re-broadcasted back to the original array.\n\nSee https://stackoverflow.com/questions/40845769/un-broadcasting-numpy-arrays\nfor more details.", "start_line": 379, "end_line": 399, "is_async": false, "is_method": false}, {"name": "simplify_basic_index", "qualified_name": "simplify_basic_index", "args": ["basic_index"], "decorators": [], "docstring": "Given a Numpy basic index, return a tuple of integers and slice objects\nwith no default values (`None`) if possible.\n\nIf one of the dimensions has a slice and the step is negative and the stop\nvalue of the slice was originally `None`, the new stop value of the slice\nmay still be set to `None`.\n\nFor ", "start_line": 402, "end_line": 466, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "item"], "decorators": [], "docstring": "", "start_line": 48, "end_line": 49, "is_async": false, "is_method": false}, {"name": "copy", "qualified_name": "copy", "args": ["self"], "decorators": [], "docstring": "Return an instance containing copies of the internal data.\n\nParameters are as for :meth:`~numpy.ndarray.copy`.", "start_line": 51, "end_line": 56, "is_async": false, "is_method": false}, {"name": "reshape", "qualified_name": "reshape", "args": ["self"], "decorators": [], "docstring": "Returns an instance containing the same data with a new shape.\n\nParameters are as for :meth:`~numpy.ndarray.reshape`.  Note that it is\nnot always possible to change the shape of an array without copying the\ndata (see :func:`~numpy.reshape` documentation). If you want an error\nto be raise if the data", "start_line": 58, "end_line": 68, "is_async": false, "is_method": false}, {"name": "ravel", "qualified_name": "ravel", "args": ["self"], "decorators": [], "docstring": "Return an instance with the array collapsed into one dimension.\n\nParameters are as for :meth:`~numpy.ndarray.ravel`. Note that it is\nnot always possible to unravel an array without copying the data.\nIf you want an error to be raise if the data is copied, you should\nshould assign shape ``(-1,)`` to t", "start_line": 70, "end_line": 78, "is_async": false, "is_method": false}, {"name": "flatten", "qualifi