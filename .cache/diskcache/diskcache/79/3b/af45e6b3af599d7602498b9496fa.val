g": "Return a new copy of the table in the form of a structured np.ndarray or\nnp.ma.MaskedArray object (as appropriate).\n\nParameters\n----------\nkeep_byteorder : bool, optional\n    By default the returned array has all columns in native byte\n    order.  However, if this option is `True` this preserves the", "start_line": 627, "end_line": 681, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "data", "masked", "names", "dtype", "meta", "copy", "rows", "copy_indices", "units", "descriptions"], "decorators": [], "docstring": "", "start_line": 683, "end_line": 888, "is_async": false, "is_method": false}, {"name": "_set_column_attribute", "qualified_name": "_set_column_attribute", "args": ["self", "attr", "values"], "decorators": [], "docstring": "Set ``attr`` for columns to ``values``, which can be either a dict (keyed by column\nname) or a dict of name: value pairs.  This is used for handling the ``units`` and\n``descriptions`` kwargs to ``__init__``.", "start_line": 890, "end_line": 927, "is_async": false, "is_method": false}, {"name": "__getstate__", "qualified_name": "__getstate__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 929, "end_line": 934, "is_async": false, "is_method": false}, {"name": "__setstate__", "qualified_name": "__setstate__", "args": ["self", "state"], "decorators": [], "docstring": "", "start_line": 936, "end_line": 938, "is_async": false, "is_method": false}, {"name": "mask", "qualified_name": "mask", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 941, "end_line": 960, "is_async": false, "is_method": false}, {"name": "mask", "qualified_name": "mask", "args": ["self", "val"], "decorators": ["mask.setter"], "docstring": "", "start_line": 963, "end_line": 964, "is_async": false, "is_method": false}, {"name": "_mask", "qualified_name": "_mask", "args": ["self"], "decorators": ["property"], "docstring": "This is needed so that comparison of a masked Table and a\nMaskedArray works.  The requirement comes from numpy.ma.core\nso don't remove this property.", "start_line": 967, "end_line": 972, "is_async": false, "is_method": false}, {"name": "filled", "qualified_name": "filled", "args": ["self", "fill_value"], "decorators": [], "docstring": "Return copy of self, with masked values filled.\n\nIf input ``fill_value`` supplied then that value is used for all\nmasked entries in the table.  Otherwise the individual\n``fill_value`` defined for each table column is used.\n\nParameters\n----------\nfill_value : str\n    If supplied, this ``fill_value`` ", "start_line": 974, "end_line": 1002, "is_async": false, "is_method": false}, {"name": "indices", "qualified_name": "indices", "args": ["self"], "decorators": ["property"], "docstring": "Return the indices associated with columns of the table\nas a TableIndices object.", "start_line": 1005, "end_line": 1015, "is_async": false, "is_method": false}, {"name": "loc", "qualified_name": "loc", "args": ["self"], "decorators": ["property"], "docstring": "Return a TableLoc object that can be used for retrieving\nrows by index in a given data range. Note that both loc\nand iloc work only with single-column indices.", "start_line": 1018, "end_line": 1024, "is_async": false, "is_method": false}, {"name": "loc_indices", "qualified_name": "loc_indices", "args": ["self"], "decorators": ["property"], "docstring": "Return a TableLocIndices object that can be used for retrieving\nthe row indices corresponding to given table index key value or values.", "start_line": 1027, "end_line": 1032, "is_async": false, "is_method": false}, {"name": "iloc", "qualified_name": "iloc", "args": ["self"], "decorators": ["property"], "docstring": "Return a TableILoc object that can be used for retrieving\nindexed rows in the order they appear in the index.", "start_line": 1035, "end_line": 1040, "is_async": false, "is_method": false}, {"name": "add_index", "qualified_name": "add_index", "args": ["self", "colnames", "engine", "unique"], "decorators": [], "docstring": "Insert a new index among one or more columns.\nIf there are no indices, make this index the\nprimary table index.\n\nParameters\n----------\ncolnames : str or list\n    List of column names (or a single column name) to index\nengine : type or None\n    Indexing engine class to use, either `~astropy.table.Sor", "start_line": 1042, "end_line": 1078, "is_async": false, "is_method": false}, {"name": "remove_indices", "qualified_name": "remove_indices", "args": ["self", "colname"], "decorators": [], "docstring": "Remove all indices involving the given column.\nIf the primary index is removed, the new primary\nindex will be the most recently added remaining\nindex.\n\nParameters\n----------\ncolname : str\n    Name of column", "start_line": 1080, "end_line": 1100, "is_async": false, "is_method": false}, {"name": "index_mode", "qualified_name": "index_mode", "args": ["self", "mode"], "decorators": [], "docstring": "Return a context manager for an indexing mode.\n\nParameters\n----------\nmode : str\n    Either 'freeze', 'copy_on_getitem', or 'discard_on_copy'.\n    In 'discard_on_copy' mode,\n    indices are not copied whenever columns or tables are copied.\n    In 'freeze' mode, indices are not modified whenever colu", "start_line": 1102, "end_line": 1121, "is_async": false, "is_method": false}, {"name": "__array__", "qualified_name": "__array__", "args": ["self", "dtype"], "decorators": [], "docstring": "Support converting Table to np.array via np.array(table).\n\nCoercion to a different dtype via np.array(table, dtype) is not\nsupported and will raise a ValueError.", "start_line": 1123, "end_line": 1146, "is_async": false, "is_method": false}, {"name": "_check_names_dtype", "qualified_name": "_check_names_dtype", "args": ["self", "names", "dtype", "n_cols"], "decorators": [], "docstring": "Make sure that names and dtype are both iterable and have\nthe same length as data.", "start_line": 1148, "end_line": 1159, "is_async": false, "is_method": false}, {"name": "_init_from_list_of_dicts", "qualified_name": "_init_from_list_of_dicts", "args": ["self", "data", "names", "dtype", "n_cols", "copy"], "decorators": [], "docstring": "Initialize table from a list of dictionaries representing rows.", "start_line": 1161, "end_line": 1220, "is_async": false, "is_method": false}, {"name": "_init_from_list", "qualified_name": "_init_from_list", "args": ["self", "data", "names", "dtype", "n_cols", "copy"], "decorators": [], "docstring": "Initialize table from a list of column data.  A column can be a\nColumn object, np.ndarray, mixin, or any other iterable object.", "start_line": 1222, "end_line": 1239, "is_async": false, "is_method": false}, {"name": "_convert_data_to_col", "qualified_name": "_convert_data_to_col", "args": ["self", "data", "copy", "default_name", "dtype", "name"], "decorators": [], "docstring": "Convert any allowed sequence data ``col`` to a column object that can be used\ndirectly in the self.columns dict.  This could be a Column, MaskedColumn,\nor mixin column.\n\nThe final column name is determined by::\n\n    name or data.info.name or def_name\n\nIf ``data`` has no ``info`` then ``name = name o", "start_line": 1241, "end_line": 1398, "is_async": false, "is_method": false}, {"name": "_init_from_ndarray", "qualified_name": "_init_from_ndarray", "args": ["self", "data", "names", "dtype", "n_cols", "copy"], "decorators": [], "docstring": "Initialize table from an ndarray structured array.", "start_line": 1400, "end_line": 1412, "is_async": false, "is_method": false}, {"name": "_init_from_dict", "qualified_name": "_init_from_dict", "args": ["self", "data", "names", "dtype", "n_cols", "copy"], "decorators": [], "docstring": "Initialize table from a dictionary of columns.", "start_line": 1414, "end_line": 1417, "is_async": false, "is_method": false}, {"name": "_get_col_cls_for_table", "qualified_name": "_get_col_cls_for_table", "args": ["self", "col"], "decorators": [], "docstring": "Get the correct column class to use for upgrading any Column-like object.\n\nFor a masked table, ensure any Column-like object is a subclass\nof the table MaskedColumn.\n\nFor unmasked table, ensure any MaskedColumn-like object is a subclass\nof the table MaskedColumn.  If not a MaskedColumn, then ensure ", "start_line": 1419, "end_line": 1441, "is_async": false, "is_method": false}, {"name": "_convert_col_for_table", "qualified_name": "_convert_col_for_table", "args": ["self", "col"], "decorators": [], "docstring": "Make sure that all Column objects have correct base class for this type of\nTable.  For a base Table this most commonly means setting to\nMaskedColumn if the table is masked.  Table subclasses like QTable\noverride this method.", "start_line": 1443, "end_line": 1455, "is_async": false, "is_method": false}, {"name": "_init_from_cols", "qualified_name": "_init_from_cols", "args": ["self", "cols"], "decorators": [], "docstring": "Initialize table from a list of Column or mixin objects.", "start_line": 1457, "end_line": 1480, "is_async": false, "is_method": false}, {"name": "_new_from_slice", "qualified_name": "_new_from_slice", "args": ["self", "slice_"], "decorators": [], "docstring": "Create a new table as a referenced slice from self.", "start_line": 1482, "end_line": 1514, "is_async": false, "is_method": false}, {"name": "_make_table_from_cols", "qualified_name": "_make_table_from_cols", "args": ["table", "cols", "verify", "names"], "decorators": ["staticmethod"], "docstring": "Make ``table`` in-place so that it represents the given list of ``cols``.", "start_line": 1517, "end_line": 1539, "is_async": false, "is_method": false}, {"name": "_set_col_parent_table_and_mask", "qualified_name": "_set_col_parent_table_and_mask", "args": ["self", "col"], "decorators": [], "docstring": "Set ``col.parent_table = self`` and force ``col`` to have ``mask``\nattribute if the table is masked and ``col.mask`` does not exist.", "start_line": 1541, "end_line": 1553, "is_async": false, "is_method": false}, {"name": "itercols", "qualified_name": "itercols", "args": ["self"], "decorators": [], "docstring": "Iterate over the columns of this table.\n\nExamples\n--------\nTo iterate over the columns of a table::\n\n    >>> t = Table([[1], [2]])\n    >>> for col in t.itercols():\n    ...     print(col)\n    col0\n    ----\n       1\n    col1\n    ----\n       2\n\nUsing ``itercols()`` is similar to  ``for col in t.columns", "start_line": 1555, "end_line": 1577, "is_async": false, "is_method": false}, {"name": "_base_repr_", "qualified_name": "_base_repr_", "args": ["self", "html", "descr_vals", "max_width", "tableid", "show_dtype", "max_lines", "tableclass"], "decorators": [], "docstring": "", "start_line": 1579, "end_line": 1620, "is_async": false, "is_method": false}, {"name": "_repr_html_", "qualified_name": "_repr_html_", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1622, "end_line": 1629, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1631, "end_line": 1632, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1634, "end_line": 1635, "is_async": false, "is_method": false}, {"name": "__bytes__", "qualified_name": "__bytes__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1637, "end_line": 1638, "is_async": false, "is_method": false}, {"name": "has_mixin_columns", "qualified_name": "has_mixin_columns", "args": ["self"], "decorators": ["property"], "docstring": "True if table has any mixin columns (defined as columns that are not Column\nsubclasses).", "start_line": 1641, "end_line": 1646, "is_async": false, "is_method": false}, {"name": "has_masked_columns", "qualified_name": "has_masked_columns", "args": ["self"], "decorators": ["property"], "docstring": "True if table has any ``MaskedColumn`` columns.\n\nThis does not check for mixin columns that may have masked values, use the\n``has_masked_values`` property in that case.", "start_line": 1649, "end_line": 1656, "is_async": false, "is_method": false}, {"name": "has_masked_values", "qualified_name": "has_masked_values", "args": ["self"], "decorators": ["property"], "docstring": "True if column in the table has values which are masked.\n\nThis may be relatively slow for large tables as it requires checking the mask\nvalues of each column.", "start_line": 1659, "end_line": 1665, "is_async": false, "is_method": false}, {"name": "_is_mixin_for_table", "qualified_name": "_is_mixin_for_table", "args": ["self", "col"], "decorators": [], "docstring": "Determine if ``col`` should be added to the table directly as\na mixin column.", "start_line": 1667, "end_line": 1677, "is_async": false, "is_method": false}, {"name": "pprint", "qualified_name": "pprint", "args": ["self", "max_lines", "max_width", "show_name", "show_unit", "show_dtype", "align"], "decorators": ["format_doc(_pprint_docs)"], "docstring": "Print a formatted string representation of the table.\n\nIf no value of ``max_lines`` is supplied then the height of the\nscreen terminal is used to set ``max_lines``.  If the terminal\nheight cannot be determined then the default is taken from the\nconfiguration item ``astropy.conf.max_lines``.  If a ne", "start_line": 1680, "end_line": 1720, "is_async": false, "is_method": false}, {"name": "pprint_all", "qualified_name": "pprint_all", "args": ["self", "max_lines", "max_width", "show_name", "show_unit", "show_dtype", "align"], "decorators": ["format_doc(_pprint_docs)"], "docstring": "Print a formatted string representation of the entire table.\n\nThis method is the same as `astropy.table.Table.pprint` except that\nthe default ``max_lines`` and ``max_width`` are both -1 so that by\ndefault the entire table is printed instead of restricting to the size\nof the screen terminal.", "start_line": 1723, "end_line": 1742, "is_async": false, "is_method": false}, {"name": "_make_index_row_display_table", "qualified_name": "_make_index_row_display_table", "args": ["self", "index_row_name"], "decorators": [], "docstring": "", "start_line": 1744, "end_line": 1749, "is_async": false, "is_method": false}, {"name": "show_in_notebook", "qualified_name": "show_in_notebook", "args": ["self", "tableid", "css", "display_length", "table_class", "show_row_index"], "decorators": [], "docstring": "Render the table in HTML and show it in the IPython notebook.\n\nParameters\n----------\ntableid : str or None\n    An html ID tag for the table.  Default is ``table{id}-XXX``, where\n    id is the unique integer id of the table object, id(self), and XXX\n    is a random number to avoid conflicts when prin", "start_line": 1751, "end_line": 1825, "is_async": false, "is_method": false}, {"name": "show_in_browser", "qualified_name": "show_in_browser", "args": ["self", "max_lines", "jsviewer", "browser", "jskwargs", "tableid", "table_class", "css", "show_row_index"], "decorators": [], "docstring": "Render the table in HTML and show it in a web browser.\n\nParameters\n----------\nmax_lines : int\n    Maximum number of rows to export to the table (set low by default\n    to avoid memory issues, since the browser view requires duplicating\n    the table in memory).  A negative value of ``max_lines`` ind", "start_line": 1827, "end_line": 1917, "is_async": false, "is_method": false}, {"name": "pformat", "qualified_name": "pformat", "args": ["self", "max_lines", "max_width", "show_name", "show_unit", "show_dtype", "html", "tableid", "align", "tableclass"], "decorators": ["format_doc(_pformat_docs, id='{id}')"], "docstring": "Return a list of lines for the formatted string representation of\nthe table.\n\nIf no value of ``max_lines`` is supplied then the height of the\nscreen terminal is used to set ``max_lines``.  If the terminal\nheight cannot be determined then the default is taken from the\nconfiguration item ``astropy.con", "start_line": 1920, "end_line": 1962, "is_async": false, "is_method": false}, {"name": "pformat_all", "qualified_name": "pformat_all", "args": ["self", "max_lines", "max_width", "show_name", "show_unit", "show_dtype", "html", "tableid", "align", "tableclass"], "decorators": ["format_doc(_pformat_docs, id='{id}')"], "docstring": "Return a list of lines for the formatted string representation of\nthe entire table.\n\nIf no value of ``max_lines`` is supplied then the height of the\nscreen terminal is used to set ``max_lines``.  If the terminal\nheight cannot be determined then the default is taken from the\nconfiguration item ``astr", "start_line": 1965, "end_line": 2001, "is_async": false, "is_method": false}, {"name": "more", "qualified_name": "more", "args": ["self", "max_lines", "max_width", "show_name", "show_unit", "show_dtype"], "decorators": [], "docstring": "Interactively browse table with a paging interface.\n\nSupported keys::\n\n  f, <space> : forward one page\n  b : back one page\n  r : refresh same page\n  n : next row\n  p : previous row\n  < : go to beginning\n  > : go to end\n  q : quit browsing\n  h : print this help\n\nParameters\n----------\nmax_lines : int\n", "start_line": 2003, "end_line": 2051, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "item"], "decorators": [], "docstring": "", "start_line": 2053, "end_line": 2086, "is_async": false, "is_method": false}, {"name": "__setitem__", "qualified_name": "__setitem__", "args": ["self", "item", "value"], "decorators": [], "docstring": "", "start_line": 2088, "end_line": 2142, "is_async": false, "is_method": false}, {"name": "__delitem__", "qualified_name": "__delitem__", "args": ["self", "item"], "decorators": [], "docstring": "", "start_line": 2144, "end_line": 2160, "is_async": false, "is_method": false}, {"name": "_ipython_key_completions_", "qualified_name": "_ipython_key_compl