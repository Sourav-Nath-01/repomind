r.", "start_line": 262, "end_line": 280, "is_async": false, "is_method": false}, {"name": "encode", "qualified_name": "encode", "args": ["self", "buf"], "decorators": [], "docstring": "Compress the data in the buffer using the RICE_1 algorithm.\n\nParameters\n----------\nbuf : bytes or array_like\n    The buffer to compress.\n\nReturns\n-------\nbytes\n    The compressed bytes.", "start_line": 282, "end_line": 303, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 320, "end_line": 321, "is_async": false, "is_method": false}, {"name": "decode", "qualified_name": "decode", "args": ["self", "buf"], "decorators": [], "docstring": "Decompress buffer using the PLIO_1 algorithm.\n\nParameters\n----------\nbuf : bytes or array_like\n    The buffer to decompress.\n\nReturns\n-------\nbuf : np.ndarray\n    The decompressed buffer.", "start_line": 323, "end_line": 339, "is_async": false, "is_method": false}, {"name": "encode", "qualified_name": "encode", "args": ["self", "buf"], "decorators": [], "docstring": "Compress the data in the buffer using the PLIO_1 algorithm.\n\nParameters\n----------\nbuf : bytes or array_like\n    The buffer to compress.\n\nReturns\n-------\nbytes\n    The compressed bytes.", "start_line": 341, "end_line": 358, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 400, "end_line": 406, "is_async": false, "is_method": false}, {"name": "decode", "qualified_name": "decode", "args": ["self", "buf"], "decorators": [], "docstring": "Decompress buffer using the HCOMPRESS_1 algorithm.\n\nParameters\n----------\nbuf : bytes or array_like\n    The buffer to decompress.\n\nReturns\n-------\nbuf : np.ndarray\n    The decompressed buffer.", "start_line": 408, "end_line": 427, "is_async": false, "is_method": false}, {"name": "encode", "qualified_name": "encode", "args": ["self", "buf"], "decorators": [], "docstring": "Compress the data in the buffer using the HCOMPRESS_1 algorithm.\n\nParameters\n----------\nbuf : bytes or array_like\n    The buffer to compress.\n\nReturns\n-------\nbytes\n    The compressed bytes.", "start_line": 429, "end_line": 452, "is_async": false, "is_method": false}], "classes": [{"name": "NoCompress", "bases": ["Codec"], "methods": ["decode", "encode"], "docstring": "A dummy compression/decompression algorithm that stores the data as-is.\n\nWhile the data is not compressed/decompressed, it is converted to big\nendian during encoding as this is what is expected in FITS files.", "start_line": 52, "end_line": 92}, {"name": "Gzip1", "bases": ["Codec"], "methods": ["decode", "encode"], "docstring": "The FITS GZIP 1 compression and decompression algorithm.\n\nThe Gzip algorithm is used in the free GNU software compression utility of\nthe same name. It was created by J. L. Gailly and M. Adler, based on the\nDEFLATE algorithm (Deutsch 1996), which is a combination of LZ77 (Ziv &\nLempel 1977) and Huffm", "start_line": 95, "end_line": 145}, {"name": "Gzip2", "bases": ["Codec"], "methods": ["__init__", "decode", "encode"], "docstring": "The FITS GZIP2 compression and decompression algorithm.\n\nThe gzip2 algorithm is a variation on 'GZIP 1'. In this case the buffer in\nthe array of data values are shuffled so that they are arranged in order of\ndecreasing significance before being compressed.\n\nFor example, a five-element contiguous arr", "start_line": 148, "end_line": 226}, {"name": "Rice1", "bases": ["Codec"], "methods": ["__init__", "decode", "encode"], "docstring": "The FITS RICE1 compression and decompression algorithm.\n\nThe Rice algorithm [1]_ is simple and very fast It requires only enough\nmemory to hold a single block of 16 or 32 pixels at a time. It codes the\npixels in small blocks and so is able to adapt very quickly to changes in\nthe input image statisti", "start_line": 229, "end_line": 303}, {"name": "PLIO1", "bases": ["Codec"], "methods": ["__init__", "decode", "encode"], "docstring": "The FITS PLIO1 compression and decompression algorithm.\n\nThe IRAF PLIO (pixel list) algorithm was developed to store integer-valued\nimage masks in a compressed form. Such masks often have large regions of\nconstant value hence are highly compressible. The compression algorithm\nused is based on run-le", "start_line": 306, "end_line": 358}, {"name": "HCompress1", "bases": ["Codec"], "methods": ["__init__", "decode", "encode"], "docstring": "The FITS HCompress compression and decompression algorithm.\n\nHcompress is an the image compression package written by Richard L. White\nfor use at the Space Telescope Science Institute. Hcompress was used to\ncompress the STScI Digitized Sky Survey and has also been used to compress\nthe preview images", "start_line": 361, "end_line": 452}, {"name": "Codec", "bases": [], "methods": [], "docstring": "", "start_line": 27, "end_line": 28}], "calls": [], "module_docstring": "This module contains the FITS compression algorithms in numcodecs style Codecs.", "parse_error": ""}, {"file_path": "astropy/io/fits/scripts/fitsdiff.py", "file_hash": "98d9e63c3c1436c79de77208c0a3c6da474211bab63b3faa2aa740ee76e5a775", "imports": [{"module": "argparse", "names": [], "is_from": false, "alias": ""}, {"module": "glob", "names": [], "is_from": false, "alias": ""}, {"module": "logging", "names": [], "is_from": false, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "astropy", "names": ["__version__"], "is_from": true, "alias": ""}, {"module": "astropy.io", "names": ["fits"], "is_from": true, "alias": ""}, {"module": "astropy.io.fits.util", "names": ["fill"], "is_from": true, "alias": ""}], "functions": [{"name": "handle_options", "qualified_name": "handle_options", "args": ["argv"], "decorators": [], "docstring": "", "start_line": 96, "end_li