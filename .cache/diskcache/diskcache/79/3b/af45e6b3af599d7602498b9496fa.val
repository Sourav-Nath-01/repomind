c": false, "is_method": false}, {"name": "_fix_scamp", "qualified_name": "_fix_scamp", "args": ["self"], "decorators": [], "docstring": "Remove SCAMP's PVi_m distortion parameters if SIP distortion parameters\nare also present. Some projects (e.g., Palomar Transient Factory)\nconvert SCAMP's distortion parameters (which abuse the PVi_m cards) to\nSIP. However, wcslib gets confused by the presence of both SCAMP and\nSIP distortion paramet", "start_line": 708, "end_line": 768, "is_async": false, "is_method": false}, {"name": "fix", "qualified_name": "fix", "args": ["self", "translate_units", "naxis"], "decorators": [], "docstring": "Perform the fix operations from wcslib, and warn about any\nchanges it has made.\n\nParameters\n----------\ntranslate_units : str, optional\n    Specify which potentially unsafe translations of\n    non-standard unit strings to perform.  By default,\n    performs none.\n\n    Although ``\"S\"`` is commonly used", "start_line": 770, "end_line": 822, "is_async": false, "is_method": false}, {"name": "calc_footprint", "qualified_name": "calc_footprint", "args": ["self", "header", "undistort", "axes", "center"], "decorators": [], "docstring": "Calculates the footprint of the image on the sky.\n\nA footprint is defined as the positions of the corners of the\nimage on the sky after all available distortions have been\napplied.\n\nParameters\n----------\nheader : `~astropy.io.fits.Header` object, optional\n    Used to get ``NAXIS1`` and ``NAXIS2``\n  ", "start_line": 824, "end_line": 896, "is_async": false, "is_method": false}, {"name": "_read_det2im_kw", "qualified_name": "_read_det2im_kw", "args": ["self", "header", "fobj", "err"], "decorators": [], "docstring": "Create a `distortion paper`_ type lookup table for detector to\nimage plane correction.", "start_line": 898, "end_line": 966, "is_async": false, "is_method": false}, {"name": "_read_d2im_old_format", "qualified_name": "_read_d2im_old_format", "args": ["self", "header", "fobj", "axiscorr"], "decorators": [], "docstring": "", "start_line": 968, "end_line": 1003, "is_async": false, "is_method": false}, {"name": "_write_det2im", "qualified_name": "_write_det2im", "args": ["self", "hdulist"], "decorators": [], "docstring": "Writes a `distortion paper`_ type lookup table to the given\n`~astropy.io.fits.HDUList`.", "start_line": 1005, "end_line": 1058, "is_async": false, "is_method": false}, {"name": "_read_distortion_kw", "qualified_name": "_read_distortion_kw", "args": ["self", "header", "fobj", "dist", "err"], "decorators": [], "docstring": "Reads `distortion paper`_ table-lookup keywords and data, and\nreturns a 2-tuple of `~astropy.wcs.DistortionLookupTable`\nobjects.\n\nIf no `distortion paper`_ keywords are found, ``(None, None)``\nis returned.", "start_line": 1060, "end_line": 1134, "is_async": false, "is_method": false}, {"name": "_write_distortion_kw", "qualified_name": "_write_distortion_kw", "args": ["self", "hdulist", "dist"], "decorators": [], "docstring": "Write out `distortion paper`_ keywords to the given\n`~astropy.io.fits.HDUList`.", "start_line": 1136, "end_line": 1192, "is_async": false, "is_method": false}, {"name": "_fix_pre2012_scamp_tpv", "qualified_name": "_fix_pre2012_scamp_tpv", "args": ["self", "header", "wcskey"], "decorators": [], "docstring": "Replace -TAN with TPV (for pre-2012 SCAMP headers that use -TAN\nin CTYPE). Ignore SIP if present. This follows recommendations in\nSection 7 in\nhttp://web.ipac.caltech.edu/staff/shupe/reprints/SIP_to_PV_SPIE2012.pdf.\n\nThis is to deal with pre-2012 headers that may contain TPV with a\nCTYPE that ends i", "start_line": 1194, "end_line": 1248, "is_async": false, "is_method": false}, {"name": "_remove_sip_kw", "qualified_name": "_remove_sip_kw", "args": ["header", "del_order"], "decorators": ["staticmethod"], "docstring": "Remove SIP information from a header.", "start_line": 1251, "end_line": 1265, "is_async": false, "is_method": false}, {"name": "_read_sip_kw", "qualified_name": "_