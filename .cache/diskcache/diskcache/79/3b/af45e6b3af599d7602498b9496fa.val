s": [], "methods": ["__new__", "__getnewargs__", "field_names", "__len__", "__getitem__", "values", "keys", "items", "__iter__", "_recursively_apply", "_recursively_get_dtype", "si", "cgs", "_get_physical_type_id", "physical_type", "decompose", "is_equivalent", "_get_converter", "to", "to_string", "_repr_latex_", "__mul__", "__rmul__", "__truediv__", "__rlshift__", "__str__", "__repr__", "__eq__", "__ne__"], "docstring": "Container for units for a structured Quantity.\n\nParameters\n----------\nunits : unit-like, tuple of unit-like, or `~astropy.units.StructuredUnit`\n    Tuples can be nested.  If a `~astropy.units.StructuredUnit` is passed\n    in, it will be returned unchanged unless different names are requested.\nnames ", "start_line": 68, "end_line": 510}, {"name": "Structure", "bases": ["np.void"], "methods": ["__eq__", "__ne__"], "docstring": "Single element structure for physical type IDs, etc.\n\nBehaves like a `~numpy.void` and thus mostly like a tuple which can also\nbe indexed with field names, but overrides ``__eq__`` and ``__ne__`` to\ncompare only the contents, not the field names.  Furthermore, this way no\n`FutureWarning` about compa", "start_line": 513, "end_line": 538}], "calls": [], "module_docstring": "This module defines structured units and quantities.", "parse_error": ""}, {"file_path": "astropy/units/imperial.py", "file_hash": "ba003f54bef2e96adbef3ee3688f0d4e6f2d56716b0c707958f325accb668e3c", "imports": [{"module": "", "names": ["si"], "is_from": true, "alias": ""}, {"module": "core", "names": ["UnitBase", "def_unit"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["generate_unit_summary"], "is_from": true, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "core", "names": ["add_enabled_units"], "is_from": true, "alias": ""}], "functions": [{"name": "enable", "qualified_name": "enable", "args": [], "decorators": [], "docstring": "Enable Imperial units so they appear in results of\n`~astropy.units.UnitBase.find_equivalent_units` and\n`~astropy.units.UnitBase.compose`.\n\nThis may be used with the ``with`` statement to enable Imperial\nunits only temporarily.", "start_line": 170, "end_line": 185, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "Colloquially used Imperial units.\n\nThese units are available in the `astropy.units.imperial` namespace, but not in the\ntop-level `astropy.units` namespace, e.g.::\n\n    >>> import astropy.units as u\n    >>> mph = u.imperial.mile / u.hour\n    >>> mph\n    Unit(\"mi / h\")\n\nTo include them in `~astropy.units.UnitBase.compose` and the results of\n`~astropy.units.UnitBase.find_equivalent_units`, do::\n\n    >>> import astropy.units as u\n    >>> u.imperial.enable()  # doctest: +SKIP", "parse_error": ""}, {"file_path": "astropy/units/__init__.py", "file_hash": "c52e19a3adb5762e8b32809390b0864a512a33b535fb5176ce8baa29108a6e78", "imports": [{"module": "core", "names": ["set_enabled_units"], "is_from": true, "alias": ""}, {"module": "core", "names": ["*"], "is_from": true, "alias": ""}, {"module": "quantity", "names": ["*"], "is_from": true, "alias": ""}, {"module": "", "names": ["astrophys", "cgs", "misc", "photometric", "si"], "is_from": true, "alias": ""}, {"module": "function", "names": ["units"], "is_from": true, "alias": ""}, {"module": "si", "names": ["*"], "is_from": true, "alias": ""}, {"module": "astrophys", "names": ["*"], "is_from": true, "alias": ""}, {"module": "photometric", "names": ["*"], "is_from": true, "alias": ""}, {"module": "cgs", "names": ["*"], "is_from": true, "alias": ""}, {"module": "physical", "names": ["*"], "is_from": true, "alias": ""}, {"module": "function.units", "names": ["*"], "is_from": true, "alias": ""}, {"module": "misc", "names": ["*"], "is_from": true, "alias": ""}, {"module": "equivalencies", "names": ["*"], "is_from": true, "alias": ""}, {"module": "function.core", "names": ["*"], "is_from": true, "alias": ""}, {"module": "function.logarithmic", "names": ["*"], "is_from": true, "alias": ""}, {"module": "decorators", "names": ["*"], "is_from": true, "alias": ""}, {"module": "structured", "names": ["*"], "is_from": true, "alias": ""}, {"module": "astropy.units.astrophys", "names": ["littleh"], "is_from": true, "alias": ""}, {"module": "astropy.units.equivalencies", "names": ["with_H0"], "is_from": true, "alias": ""}], "functions": [{"name": "__getattr__", "qualified_name": "__getattr__", "args": ["attr"], "decorators": [], "docstring": "", "start_line": 57, "end_line": 67, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This subpackage contains classes and functions for defining and converting\nbetween different physical units.\n\nThis code is adapted from the `pynbody\n<https://github.com/pynbody/pynbody>`_ units module written by Andrew\nPontzen, who has granted the Astropy project permission to use the\ncode under a BSD license.", "parse_error": ""}, {"file_path": "astropy/units/required_by_vounit.py", "file_hash": "03c34c33968e0e4b24a5fe9489965344c35ae5d333392896b36e3b830c4aa071", "imports": [{"module": "", "names": ["astrophys"], "is_from": true, "alias": ""}, {"module": "core", "names": ["_add_prefixes"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["generate_prefixonly_unit_summary"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["generate_unit_summary"], "is_from": true, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "core", "names": ["add_enabled_units"], "is_from": true, "alias": ""}], "functions": [{"name": "_initialize_module", "qualified_name": "_initialize_module", "args": [], "decorators": [], "docstring": "", "start_line": 16, "end_line": 23, "is_async": false, "is_method": false}, {"name": "_enable", "qualified_name": "_enable", "args": [], "decorators": [], "docstring": "Enable the VOUnit-required extra units so they appear in results of\n`~astropy.units.UnitBase.find_equivalent_units` and\n`~astropy.units.UnitBase.compose`, and are recognized in the ``Unit('...')``\nidiom.", "start_line": 44, "end_line": 57, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This package defines SI prefixed units that are required by the VOUnit standard\nbut that are rarely used in practice and liable to lead to confusion (such as\n``msolMass`` for milli-solar mass). They are in a separate module from\n`astropy.units.deprecated` because they need to be enabled by default for\n`astropy.units` to parse compliant VOUnit strings. As a result, e.g.,\n``Unit('msolMass')`` will just work, but to access the unit directly, use\n``astropy.units.required_by_vounit.msolMass`` instead of the more typical idiom\npossible for the non-prefixed unit, ``astropy.units.solMass``.", "parse_error": ""}, {"file_path": "astropy/units/deprecated.py", "file_hash": "24a9a4ad0c2fa1bf7e1fa36f0c9d296ce00a63dbb6005ac4a6c07556378eec29", "imports": [{"module": "", "names": ["astrophys", "cgs"], "is_from": true, "alias": ""}, {"module": "core", "names": ["_add_prefixes", "def_unit"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["generate_prefixonly_unit_summary"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["generate_unit_summary"], "is_from": true, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "core", "names": ["add_enabled_units"], "is_from": true, "alias": ""}], "functions": [{"name": "_initialize_module", "qualified_name": "_initialize_module", "args": [], "decorators": [], "docstring": "", "start_line": 23, "end_line": 34, "is_async": false, "is_method": false}, {"name": "enable", "qualified_name": "enable", "args": [], "decorators": [], "docstring": "Enable deprecated units so they appear in results of\n`~astropy.units.UnitBase.find_equivalent_units` and\n`~astropy.units.UnitBase.compose`.\n\nThis may be used with the ``with`` statement to enable deprecated\nunits only temporarily.", "start_line": 55, "end_line": 70, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This package defines deprecated units.\n\nThese units are not available in the top-level `astropy.units`\nnamespace. To use these units, you must import the `astropy.units.deprecated`\nmodule::\n\n    >>> from astropy.units import deprecated\n    >>> q = 10. * deprecated.emu  # doctest: +SKIP\n\nTo include them in `~astropy.units.UnitBase.compose` and the results of\n`~astropy.units.UnitBase.find_equivalent_units`, do::\n\n    >>> from astropy.units import deprecated\n    >>> deprecated.enable()  # doctest: +SKIP", "parse_error": ""}, {"file_path": "astropy/units/decorators.py", "file_hash": "81bf37dee8e7e354cbe60af963701de156fc9de91cf666702add65283fbca93e", "imports": [{"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "typing", "names": [], "is_from": false, "alias": "T"}, {"module": "collections.abc", "names": ["Sequence"], "is_from": true, "alias": ""}, {"module": "functools", "names": ["wraps"], "is_from": true, "alias": ""}, {"module": "numbers", "names": ["Number"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "core", "names": ["Unit", "UnitBase", "UnitsError", "add_enabled_equivalencies", "dimensionless_unscaled"], "is_from": true, "alias": ""}, {"module": "physical", "names": ["PhysicalType", "get_physical_type"], "is_from": true, "alias": ""}, {"module": "quantity", "names": ["Quantity"], "is_from": true, "alias": ""}], "functions": [{"name": "_get_allowed_units", "qualified_name": "_get_allowed_units", "args": ["targets"], "decorators": [], "docstring": "From a list of target units (either as strings or unit objects) and physical\ntypes, return a list of Unit objects.", "start_line": 26, "end_line": 43, "is_async": false, "is_method": false}, {"name": "_validate_arg_value", "qualified_name": "_validate_arg_value", "args": ["param_name", "func_name", "arg", "targets", "equivalencies", "strict_dimensionless"], "decorators": [], "docstring": "Validates the object passed in to the wrapped function, ``arg``, with target\nunit or physical type, ``target``.", "start_line": 46, "end_line": 97, "is_async": false, "is_method": false}, {"name": "_parse_annotation", "qualified_name": "_parse_annotation", "args": ["target"], "decorators": [], "docstring": "", "start_line": 100, "end_line": 135, "is_async": false, "is_method": false}, {"name": "as_decorator", "qualified_name": "as_decorator", "args": ["cls", "func"], "decorators": ["classmethod"], "docstring": "A decorator for validating the units of arguments to functions.\n\nUnit specifications can be provided as keyword arguments to the\ndecorator, or by using function annotation syntax. Arguments to the\ndecorator take precedence over any function annotations present.\n\nA `~astropy.units.UnitsError` will be", "start_line": 140, "end_line": 214, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "func", "strict_dimensionless"], "decorators": [], "docstring": "", "start_line": 216, "end_line": 219, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "wrapped_function"], "decorators": [], "docstring": "", "start_line": 221, "end_line": 341, "is_async": false, "is_method": false}, {"name": "wrapper", "qualified_name": "wrapper", "args": [], "decorators": ["wraps(wrapped_function)"], "docstring": "", "start_line": 227, "end_line": 339, "is_async": false, "is_method": false}], "classes": [{"name": "QuantityInput", "bases": [], "methods": ["as_decorator", "__init__", "__call__"], "docstring": "", "start_line": 138, "end_line": 341}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/units/utils.py", "file_hash": "449feb1859d7760eb7800946ae9dbb91d658d735d50cb60a531851d775e0a28b", "imports"