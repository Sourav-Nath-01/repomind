docstring": "Flush internal buffers.", "start_line": 77, "end_line": 100, "is_async": false, "is_method": false}, {"name": "start", "qualified_name": "start", "args": ["self", "tag", "attrib"], "decorators": [], "docstring": "Opens a new element.  Attributes can be given as keyword\narguments, or as a string/string dictionary.  The method\nreturns an opaque identifier that can be passed to the\n:meth:`close` method, to close all open elements up to and\nincluding this one.\n\nParameters\n----------\ntag : str\n    The element nam", "start_line": 102, "end_line": 144, "is_async": false, "is_method": false}, {"name": "xml_cleaning_method", "qualified_name": "xml_cleaning_method", "args": ["self", "method"], "decorators": ["contextlib.contextmanager"], "docstring": "Context manager to control how XML data tags are cleaned (escaped) to\nremove potentially unsafe characters or constructs.\n\nThe default (``method='escape_xml'``) applies brute-force escaping of\ncertain key XML characters like ``<``, ``>``, and ``&`` to ensure that\nthe output is not valid XML.\n\nIn ord", "start_line": 147, "end_line": 208, "is_async": false, "is_method": false}, {"name": "tag", "qualified_name": "tag", "args": ["self", "tag", "attrib"], "decorators": ["contextlib.contextmanager"], "docstring": "A convenience method for creating wrapper elements using the\n``with`` statement.\n\nExamples\n--------\n>>> with writer.tag('foo'):  # doctest: +SKIP\n...     writer.element('bar')\n... # </foo> is implicitly closed here\n...\n\nParameters are the same as to `start`.", "start_line": 211, "end_line": 227, "is_async": false, "is_method": false}, {"name": "comment", "qualified_name": "comment", "args": ["self", "comment"], "decorators": [], "docstring": "Adds a comment to the output stream.\n\nParameters\n----------\ncomment : str\n    Comment text, as a Unicode string.", "start_line": 229, "end_line": 240, "is_async": false, "is_method": false}, {"name": "data", "qualified_name": "data", "args": ["self", "text"], "decorators": [], "docstring": "Adds character data to the output stream.\n\nParameters\n----------\ntext : str\n    Character data, as a Unicode string.", "start_line": 242, "end_line": 251, "is_async": false, "is_method": false}, {"name": "end", "qualified_name": "end", "args": ["self", "tag", "indent", "wrap"], "decorators": [], "docstring": "Closes the current element (opened by the most recent call to\n`start`).\n\nParameters\n----------\ntag : str\n    Element name.  If given, the tag must match the start tag.\n    If omitted, the current element is closed.", "start_line": 253, "end_line": 281, "is_async": false, "is_method": false}, {"name": "close", "qualified_name": "close", "args": ["self", "id"], "decorators": [], "docstring": "Closes open elements, up to (and including) the element identified\nby the given identifier.\n\nParameters\n----------\nid : int\n    Element identifier, as returned by the `start` method.", "start_line": 283, "end_line": 294, "is_async": false, "is_method": false}, {"name": "element", "qualified_name": "element", "args": ["self", "tag", "text", "wrap", "attrib"], "decorators": [], "docstring": "Adds an entire element.  This is the same as calling `start`,\n`data`, and `end` in sequence. The ``text`` argument\ncan be omitted.", "start_line": 296, "end_line": 305, "is_async": false, "is_method": false}, {"name": "flush", "qualified_name": "flush", "args": ["self"], "decorators": [], "docstring": "", "start_line": 307, "end_line": 308, "is_async": false, "is_method": false}, {"name": "get_indentation", "qualified_name": "get_indentation", "args": ["self"], "decorators": [], "docstring": "Returns the number of indentation levels the file is currently\nin.", "start_line": 310, "end_line": 315, "is_async": false, "is_method": false}, {"name": "get_indentation_spaces", "qualified_name": "get_indentation_spaces", "args": ["self", "offset"], "decorators": [], "docstring": "Returns a string of spaces that matches the current\nindentation level.", "start_line": 317, "end_line": 322, "is_async": false, "is_method": false}, {"name": "object_attrs", "qualified_name": "object_attrs", "args": ["obj", "attrs"], "decorators": ["staticmethod"], "docstring": "Converts an object with a bunch of attributes on an object\ninto a dictionary for use by the `XMLWriter`.\n\nParameters\n----------\nobj : object\n    Any Python object\n\nattrs : sequence of str\n    Attribute names to pull from the object\n\nReturns\n-------\nattrs : dict\n    Maps attribute names to the values", "start_line": 325, "end_line": 349, "is_async": false, "is_method": false}, {"name": "xml_escape_cdata", "qualified_name": "xml_escape_cdata", "args": ["s"], "decorators": [], "docstring": "Escapes &, < and > in an XML CDATA string.", "start_line": 15, "end_line": 22, "is_async": false, "is_method": false}, {"name": "xml_escape", "qualified_name": "xml_escape", "args": ["s"], "decorators": [], "docstring": "Escapes &, ', \", < and > in an XML attribute value.", "start_line": 24, "end_line": 33, "is_async": false, "is_method": false}], "classes": [{"name": "XMLWriter", "bases": [], "methods": ["__init__", "_flush", "start", "xml_cleaning_method", "tag", "comment", "data", "end", "close", "element", "flush", "get_indentation", "get_indentation_spaces", "object_attrs"], "docstring": "A class to write well-formed and nicely indented XML.\n\nUse like this::\n\n    w = XMLWriter(fh)\n    with w.tag('html'):\n        with w.tag('body'):\n            w.data('This is the content')\n\nWhich produces::\n\n    <html>\n     <body>\n      This is the content\n     </body>\n    </html>", "start_line": 40, "end_line": 349}], "calls": [], "module_docstring": "Contains a class that makes it simple to stream out well-formed and\nnicely-indented XML.", "parse_error": ""}, {"file_path": "astropy/utils/xml/check.py", "file_hash": "dda6338ae27c841d06145a53e5a0f08896dcbd683b4521bce44204f2ccc34f61", "imports": [{"module": "re", "names": [], "is_from": f