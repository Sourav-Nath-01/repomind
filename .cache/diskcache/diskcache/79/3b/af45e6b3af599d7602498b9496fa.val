", "qualified_name": "lombscargle_chi2", "args": ["t", "y", "dy", "frequency", "normalization", "fit_mean", "center_data", "nterms"], "decorators": [], "docstring": "Lomb-Scargle Periodogram.\n\nThis implements a chi-squared-based periodogram, which is relatively slow\nbut useful for validating the faster algorithms in the package.\n\nParameters\n----------\nt, y, dy : array-like\n    times, values, and errors of the data points. These should be\n    broadcastable to the", "start_line": 6, "end_line": 93, "is_async": false, "is_method": false}, {"name": "compute_power", "qualified_name": "compute_power", "args": ["f"], "decorators": [], "docstring": "", "start_line": 75, "end_line": 79, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/timeseries/periodograms/lombscargle/implementations/__init__.py", "file_hash": "d1f0a7a26a491f320e5709fd8aa9809706e7c68bec151f5303a39aaa3d419b4c", "imports": [{"module": "chi2_impl", "names": ["lombscargle_chi2"], "is_from": true, "alias": ""}, {"module": "fast_impl", "names": ["lombscargle_fast"], "is_from": true, "alias": ""}, {"module": "fastchi2_impl", "names": ["lombscargle_fastchi2"], "is_from": true, "alias": ""}, {"module": "main", "names": ["available_methods", "lombscargle"], "is_from": true, "alias": ""}, {"module": "scipy_impl", "names": ["lombscargle_scipy"], "is_from": true, "alias": ""}, {"module": "slow_impl", "names": ["lombscargle_slow"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "Various implementations of the Lomb-Scargle Periodogram.", "parse_error": ""}, {"file_path": "astropy/timeseries/periodograms/lombscargle/implementations/scipy_impl.py", "file_hash": "62352c8af1d5d54a04dc03507d7dc72d90eee5a064e01df7706a80ab5d48d226", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "scipy", "names": ["signal"], "is_from": true, "alias": ""}], "functions": [{"name": "lombscargle_scipy", "qualified_name": "lombscargle_scipy", "args": ["t", "y", "frequency", "normalization", "center_data"], "decorators": [], "docstring": "Lomb-Scargle Periodogram.\n\nThis is a wrapper of ``scipy.signal.lombscargle`` for computation of the\nLomb-Scargle periodogram. This is a relatively fast version of the naive\nO[N^2] algorithm, but cannot handle heteroskedastic errors.\n\nParameters\n----------\nt, y : array-like\n    times, values, and err", "start_line": 4, "end_line": 70, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/timeseries/periodograms/lombscargle/implementations/utils.py", "file_hash": "9f425c6b61f8751ca8e035d9d464da1e33711f0d3a49db02f7042d7f9024afe6", "imports": [{"module": "math", "names": ["factorial"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}], "functions": [{"name": "bitceil", "qualified_name": "bitceil", "args": ["N"], "decorators": [], "docstring": "Find the bit (i.e. power of 2) immediately greater than or equal to N\nNote: this works for numbers up to 2 ** 64.\nRoughly equivalent to int(2 ** np.ceil(np.log2(N))).", "start_line": 6, "end_line": 12, "is_async": false, "is_method": false}, {"name": "extirpolate", "qualified_name": "extirpolate", "args": ["x", "y", "N", "M"], "decorators": [], "docstring": "Extirpolate the values (x, y) onto an integer grid range(N),\nusing lagrange polynomial weights on the M nearest points.\n\nParameters\n----------\nx : array-like\n    array of abscissas\ny : array-like\n    array of ordinates\nN : int\n    number of integer bins to use. For best performance, N should be larg", "start_line": 15, "end_line": 79, "is_async": false, "is_method": false}, {"name": "trig_sum", "qualified_name": "trig_sum", "args": ["t", "h", "df", "N", "f0", "freq_factor", "oversampling", "use_fft", "Mfft"], "decorators": [], "docstring": "Compute (approximate) trigonometric sums for a number of frequencies.\n\nThis routine computes weighted sine and cosine sums::\n\n    S_j = sum_i { h_i * sin(2 pi * f_j * t_i) }\n    C_j = sum_i { h_i * cos(2 pi * f_j * t_i) }\n\nWhere f_j = freq_factor * (f0 + j * df) for the values j in 1 ... N.\nThe sums", "start_line": 82, "end_line": 159, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/timeseries/periodograms/lombscargle/implementations/mle.py", "file_hash": "3e5c1f5d5f3d5011df879d0cf3b0d1cf26cc68ca4a32aaeba4d84f8b9897d8f8", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}], "functions": [{"name": "design_matrix", "qualified_name": "design_matrix", "args": ["t", "frequency", "dy", "bias", "nterms"], "decorators": [], "docstring": "Compute the Lomb-Scargle design matrix at the given frequency.\n\nThis is the matrix X such that the periodic model at the given frequency\ncan be expressed :math:`\\hat{y} = X \\theta`.\n\nParameters\n----------\nt : array-like, shape=(n_times,)\n    times at which to compute the design matrix\nfrequency : fl", "start_line": 4, "end_line": 52, "is_async": false, "is_method": false}, {"name": "periodic_fit", "qualified_name": "periodic_fit", "args": ["t", "y", "dy", "frequency", "t_fit", "center_data", "fit_mean", "nterms"], "decorators": [], "docstring": "Compute the Lomb-Scargle model fit at a given frequency.\n\nParameters\n----------\nt, y, dy : float or array-like\n    The times, observations, and uncertainties to fit\nfrequency : float\n    The frequency at which to compute the model\nt_fit : float or array-like\n    The times at which the fit should be ", "start_line": 55, "end_line": 105, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/timeseries/periodograms/lombscargle/implementations/fastchi2_impl.py", "file_hash": "b3ec34fdf9076c6c4fb