", "start_line": 247, "end_line": 254, "is_async": false, "is_method": false}, {"name": "test_csv_ecsv_colnames_mismatch", "qualified_name": "test_csv_ecsv_colnames_mismatch", "args": [], "decorators": [], "docstring": "Test that mismatch in column names from normal CSV header vs.\nECSV YAML header raises the expected exception.", "start_line": 257, "end_line": 267, "is_async": false, "is_method": false}, {"name": "test_regression_5604", "qualified_name": "test_regression_5604", "args": [], "decorators": [], "docstring": "See https://github.com/astropy/astropy/issues/5604 for more.", "start_line": 270, "end_line": 282, "is_async": false, "is_method": false}, {"name": "assert_objects_equal", "qualified_name": "assert_objects_equal", "args": ["obj1", "obj2", "attrs", "compare_class"], "decorators": [], "docstring": "", "start_line": 285, "end_line": 319, "is_async": false, "is_method": false}, {"name": "test_ecsv_mixins_ascii_read_class", "qualified_name": "test_ecsv_mixins_ascii_read_class", "args": [], "decorators": [], "docstring": "Ensure that ascii.read(ecsv_file) returns the correct class\n(QTable if any Quantity subclasses, Table otherwise).", "start_line": 322, "end_line": 345, "is_async": false, "is_method": false}, {"name": "test_ecsv_mixins_qtable_to_table", "qualified_name": "test_ecsv_mixins_qtable_to_table", "args": [], "decorators": [], "docstring": "Test writing as QTable and reading as Table.  Ensure correct classes\ncome out.", "start_line": 348, "end_line": 375, "is_async": false, "is_method": false}, {"name": "test_ecsv_mixins_as_one", "qualified_name": "test_ecsv_mixins_as_one", "args": ["table_cls"], "decorators": ["pytest.mark.parametrize('table_cls', (Table, QTable))"], "docstring": "Test write/read all cols at once and validate intermediate column names", "start_line": 379, "end_line": 405, "is_async": false, "is_method": false}, {"name": "make_multidim", "qualified_name": "make_multidim", "args": ["col", "ndim"], "decorators": [], "docstring": "Take a col with length=2 and make it N-d by repeating elements.\n\nFor the special case of ndim==1 just return the original.\n\nThe output has shape [3] * ndim. By using 3 we can be sure that repeating\nthe two input elements gives an output that is sufficiently unique for\nthe multidim tests.", "start_line": 408, "end_line": 422, "is_async": false, "is_method": false}, {"name": "test_ecsv_mixins_per_column", "qualified_name": "test_ecsv_mixins_per_column", "args": ["table_cls", "name_col", "ndim"], "decorators": ["pytest.mark.parametrize('name_col', list(mixin_cols.items()))", "pytest.mark.parametrize('table_cls', (Table, QTable))", "pytest.mark.parametrize('ndim', (1, 2, 3))"], "docstring": "Test write/read one col at a time and do detailed validation.\nThis tests every input column type as 1-d, 2-d and 3-d.", "start_line": 428, "end_line": 461, "is_async": false, "is_method": false}, {"name": "test_round_trip_masked_table_default", "qualified_name": "test_round_trip_masked_table_default", "args": ["tmp_path"], "decorators": [], "docstring": "Test (mostly) round-trip of MaskedColumn through ECSV using default serialization\nthat uses an empty string \"\" to mark NULL values.  Note:\n\n>>> simple_table(masked=True)\n<Table masked=True length=3>\n  a      b     c\nint64 float64 str1\n----- ------- ----\n   --     1.0    c\n    2     2.0   --\n    3   ", "start_line": 464, "end_line": 494, "is_async": false, "is_method": false}, {"name": "test_round_trip_masked_table_serialize_mask", "qualified_name": "test_round_trip_masked_table_serialize_mask", "args": ["tmp_path"], "decorators": [], "docstring": "Same as prev but set the serialize_method to 'data_mask' so mask is written out", "start_line": 497, "end_line": 522, "is_async": false, "is_method": false}, {"name": "test_ecsv_round_trip_user_defined_unit", "qualified_name": "test_ecsv_round_trip_user_defined_unit", "args": ["table_cls", "tmp_path"], "decorators": ["pytest.mark.parametrize('table_cls', (Table, QTable))"], "docstring": "Ensure that we can read-back enabled user-defined units.", "start_line": 526, "end_line": 562, "is_async": false, "is_method": false}, {"name": "test_read_masked_bool", "qualified_name": "test_read_masked_bool", "args": [], "decorators": [], "docstring": "", "start_line": 565, "end_line": 583, "is_async": false, "is_method": false}, {"name": "test_roundtrip_multidim_masked_array", "qualified_name": "test_roundtrip_multidim_masked_array", "args": ["serialize_method", "dtype", "delimiter"], "decorators": ["pytest.mark.parametrize('serialize_method', ['null_value', 'data_mask'])", "pytest.mark.parametrize('dtype', [np.int64, np.float64, bool, str])", "pytest.mark.parametrize('delimiter', [',', ' '])"], "docstring": "", "start_line": 589, "end_line": 610, "is_async": false, "is_method": false}, {"name": "test_multidim_unknown_subtype", "qualified_name": "test_multidim_unknown_subtype", "args": ["subtype"], "decorators": ["pytest.mark.parametrize('subtype', ['some-user-type', 'complex'])"], "docstring": "Test an ECSV file with a string type but unknown subtype", "start_line": 614, "end_line": 634, "is_async": false, "is_method": false}, {"name": "test_multidim_bad_shape", "qualified_name": "test_multidim_bad_shape", "args": [], "decorators": [], "docstring": "Test a malformed ECSV file", "start_line": 637, "end_line": 653, "is_async": false, "is_method": false}, {"name": "test_write_not_json_serializable", "qualified_name": "test_write_not_json_serializable", "args": [], "decorators": [], "docstring": "", "start_line": 656, "end_line": 665, "is_async": false, "is_method": false}, {"name": "test_read_not_json_serializable", "qualified_name": "test_read_not_json_serializable", "args": [], "decorators": [], "docstring": "Test a malformed ECSV file", "start_line": 668, "end_line": 681, "is_async": false, "is_method": false}, {"name": "test_read_bad_datatype", "qualified_name": "test_read_bad_datatype", "args": [], "decorators": [], "docstring": "Test a m