 "qualified_name": "_repr_odict", "args": ["dumper", "data"], "decorators": [], "docstring": "Represent OrderedDict in yaml dump.\n\nSource: https://gist.github.com/weaver/317164\nLicense: Unspecified\n\n>>> data = OrderedDict([('foo', 'bar'), ('mumble', 'quux'), ('baz', 'gorp')])\n>>> yaml.dump(data, default_flow_style=False)  # doctest: +SKIP\n'!!omap\\n- foo: bar\\n- mumble: quux\\n- baz: gorp\\n'\n>", "start_line": 139, "end_line": 152, "is_async": false, "is_method": false}, {"name": "_repr_column_dict", "qualified_name": "_repr_column_dict", "args": ["dumper", "data"], "decorators": [], "docstring": "Represent ColumnDict in yaml dump.\n\nThis is the same as an ordinary mapping except that the keys\nare written in a fixed order that makes sense for astropy table\ncolumns.", "start_line": 155, "end_line": 163, "is_async": false, "is_method": false}, {"name": "_get_variable_length_array_shape", "qualified_name": "_get_variable_length_array_shape", "args": ["col"], "decorators": [], "docstring": "Check if object-type ``col`` is really a variable length list.\n\nThat is true if the object consists purely of list of nested lists, where\nthe shape of every item can be represented as (m, n, ..., *) where the (m,\nn, ...) are constant and only the lists in the last axis have variable\nshape. If so the", "start_line": 166, "end_line": 216, "is_async": false, "is_method": false}, {"name": "_get_datatype_from_dtype", "qualified_name": "_get_datatype_from_dtype", "args": ["dtype"], "decorators": [], "docstring": "Return string version of ``dtype`` for writing to ECSV ``datatype``.", "start_line": 219, "end_line": 226, "is_async": false, "is_method": false}, {"name": "_get_col_attributes", "qualified_name": "_get_col_attributes", "args": ["col"], "decorators": [], "docstring": "Extract information from a column (apart from the values) that is required\nto fully serialize the column.\n\nParameters\n----------\ncol : column-like\n    Input Table column\n\nReturns\n-------\nattrs : dict\n    Dict of ECSV attributes for ``col``", "start_line": 229, "end_line": 286, "is_async": false, "is_method": false}, {"name": "get_yaml_from_table", "qualified_name": "get_yaml_from_table", "args": ["table"], "decorators": [], "docstring": "Return lines with a YAML representation of header content from the ``table``.\n\nParameters\n----------\ntable : `~astropy.table.Table` object\n    Table for which header content is output\n\nReturns\n-------\nlines : list\n    List of text lines with YAML header content", "start_line": 289, "end_line": 307, "is_async": false, "is_method": false}, {"name": "get_yaml_from_header", "qualified_name": "get_yaml_from_header", "args": ["header"], "decorators": [], "docstring": "Return lines with a YAML representation of header content from a Table.\n\nThe ``header`` dict must contain these keys:\n\n- 'cols' : list of table column objects (required)\n- 'meta' : table 'meta' attribute (optional)\n\nOther keys included in ``header`` will be serialized in the output YAML\nrepresentati", "start_line": 310, "end_line": 390, "is_async": false, "is_method": false}, {"name": "get_header_from_yaml", "qualified_name": "get_header_from_yaml", "args": ["lines"], "decorators": [], "docstring": "Get a header dict from input ``lines`` which should be valid YAML.  This\ninput will typically be created by get_yaml_from_header.  The output is a\ndictionary which describes all the table and column meta.\n\nThe get_cols() method in the io/ascii/ecsv.py file should be used as a\nguide to using the info", "start_line": 397, "end_line": 435, "is_async": false, "is_method": false}, {"name": "sort", "qualified_name": "sort", "args": ["self"], "decorators": [], "docstring": "", "start_line": 18, "end_line": 35, "is_async": false, "is_method": false}, {"name": "items", "qualified_name": "items", "args": ["self"], "decorators": [], "docstring": "Return items as a ColumnOrderList, which sorts in the preferred\nway for column attributes.", "start_line": 45, "end_line": 50, "is_async": false, "is_method": false}, {"name": "represent_mapping", "qualified_name": "represent_mapping", "args": ["self", "tag", "mapping", "flow_style"], "decorators": [], "docstring": "This is a combination of the Python 2 and 3 versions of this method\nin the PyYAML library to allow the required key ordering via the\nColumnOrderList object.  The Python 3 version insists on turning the\nitems() mapping into a list object and sorting, which results in\nalphabetical order for the column", "start_line": 339, "end_line": 378, "is_async": false, "is_method": false}], "classes": [{"name": "ColumnOrderList", "bases": ["list"], "methods": ["sort"], "docstring": "List of tuples that sorts in a specific order that makes sense for\nastropy table column attributes.", "start_line": 12, "end_line": 35}, {"name": "ColumnDict", "bases": ["dict"], "methods": ["items"], "docstring": "Specialized dict subclass to represent attributes of a Column\nand return items() in a preferred order.  This is only for use\nin generating a YAML map representation that has a fixed order.", "start_line": 38, "end_line": 50}, {"name": "YamlParseError", "bases": ["Exception"], "methods": [], "docstring": "", "start_line": 393, "end_line": 394}, {"name": "ConvertError", "bases": ["ValueError"], "methods": [], "docstring": "Local conversion error used below.", "start_line": 192, "end_line": 193}, {"name": "TableDumper", "bases": ["AstropyDumper"], "methods": ["represent_mapping"], "docstring": "Custom Dumper that represents OrderedDict as an !!omap object.", "start_line": 334, "end_line": 378}, {"name": "TableLoader", "bases": ["AstropyLoader"], "methods": [], "docstring": "Custom Loader that constructs OrderedDict from an !!omap object.\nThis does nothing but provide a namespace for adding the\ncustom odict constructor.", "start_line": 420, "end_line": 425}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/table/__init__.py", "file_hash": "70ee8a