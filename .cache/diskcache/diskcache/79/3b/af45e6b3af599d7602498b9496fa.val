ame": "process_lines", "args": ["self", "lines"], "decorators": [], "docstring": "Process lines for subsequent use.  In the default case do nothing.\nThis routine is not generally intended for removing comment lines or\nstripping whitespace.  These are done (if needed) in the header and\ndata line processing.\n\nOverride this method if something more has to be done to convert raw\ninpu", "start_line": 363, "end_line": 374, "is_async": false, "is_method": false}, {"name": "process_line", "qualified_name": "process_line", "args": ["self", "line"], "decorators": [], "docstring": "Remove whitespace at the beginning or end of line.  This is especially useful for\nwhitespace-delimited files to prevent spurious columns at the beginning or end.", "start_line": 400, "end_line": 404, "is_async": false, "is_method": false}, {"name": "process_val", "qualified_name": "process_val", "args": ["self", "val"], "decorators": [], "docstring": "Remove whitespace at the beginning or end of value.", "start_line": 406, "end_line": 408, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "lines"], "decorators": [], "docstring": "", "start_line": 410, "end_line": 418, "is_async": false, "is_method": false}, {"name": "join", "qualified_name": "join", "args": ["self", "vals"], "decorators": [], "docstring": "", "start_line": 420, "end_line": 425, "is_async": false, "is_method": false}, {"name": "process_line", "qualified_name": "process_line", "args": ["self", "line"], "decorators": [], "docstring": "Remove whitespace at the beginning or end of line.  This is especially useful for\nwhitespace-delimited files to prevent spurious columns at the beginning or end.\nIf splitting on whitespace then replace unquoted tabs with space first.", "start_line": 457, "end_line": 464, "is_async": false, "is_method": false}, {"name": "process_val", "qualified_name": "process_val", "args": ["self", "val"], "decorators": [], "docstring": "Remove whitespace