qualified_name": "test_temp_cache", "args": ["tmp_path"], "decorators": [], "docstring": "", "start_line": 300, "end_line": 330, "is_async": false, "is_method": false}, {"name": "test_download_with_sources_and_bogus_original", "qualified_name": "test_download_with_sources_and_bogus_original", "args": ["valid_urls", "invalid_urls", "temp_cache", "parallel"], "decorators": ["pytest.mark.parametrize('parallel', [False, True])"], "docstring": "", "start_line": 334, "end_line": 375, "is_async": false, "is_method": false}, {"name": "test_download_file_threaded_many", "qualified_name": "test_download_file_threaded_many", "args": ["temp_cache", "valid_urls"], "decorators": ["pytest.mark.skipif(sys.platform.startswith('win') and CI, reason='flaky cache error on Windows CI')"], "docstring": "Hammer download_file with multiple threaded requests.\n\nThe goal is to stress-test the locking system. Normal parallel downloading\nalso does this but coverage tools lose track of which paths are explored.", "start_line": 381, "end_line": 394, "is_async": false, "is_method": false}, {"name": "test_threaded_segfault", "qualified_name": "test_threaded_segfault", "args": ["valid_urls"], "decorators": ["pytest.mark.skipif(sys.platform.startswith('win') and CI, reason='flaky cache error on Windows CI')"], "docstring": "Demonstrate urllib's segfault.", "start_line": 400, "end_line": 411, "is_async": false, "is_method": false}, {"name": "test_download_file_threaded_many_partial_success", "qualified_name": "test_download_file_threaded_many_partial_success", "args": ["temp_cache", "valid_urls", "invalid_urls"], "decorators": ["pytest.mark.skipif(sys.platform.startswith('win') and CI, reason='flaky cache error on Windows CI')"], "docstring": "Hammer download_file with multiple threaded requests.\n\nBecause some of these requests fail, the locking context manager is\nexercised with exceptions as well as success returns. I do not expect many\nsurprises from the threaded version, but the process version gave trouble\nhere.", "start_line": 417, "end_line": 449, "is_async": false, "is_method": false}, {"name": "test_clear_download_cache", "qualified_name": "test_clear_download_cache", "args": ["valid_urls"], "decorators": [], "docstring": "", "start_line": 452, "end_line": 478, "is_async": false, "is_method": false}, {"name": "test_clear_download_multiple_references_doesnt_corrupt_storage", "qualified_name": "test_clear_download_multiple_references_doesnt_corrupt_storage", "args": ["temp_cache", "tmp_path"], "decorators": [], "docstring": "Check that files with the same hash don't confuse the storage.", "start_line": 481, "end_line": 516, "is_async": false, "is_method": false}, {"name": "test_download_file_local_cache_survives", "qualified_name": "test_download_file_local_cache_survives", "args": ["tmp_path", "temp_cache", "use_cache"], "decorators": ["pytest.mark.parametrize('use_cache', [False, True])"], "docstring": "Confirm that downloading a local file does not delete it.\n\nWhen implemented with urlretrieve (rather than urlopen) local files are\nnot copied to create temporaries, so importing them to the cache deleted\nthe original from wherever it was in the filesystem. I lost some built-in\nastropy data.", "start_line": 520, "end_line": 537, "is_async": false, "is_method": false}, {"name": "test_sources_normal", "qualified_name": "test_sources_normal", "args": ["temp_cache", "valid_urls", "invalid_urls"], "decorators": [], "docstring": "", "start_line": 540, "end_line": 546, "is_async": false, "is_method": false}, {"name": "test_sources_fallback", "qualified_name": "test_sources_fallback", "args": ["temp_cache", "valid_urls", "invalid_urls"], "decorators": [], "docstring": "", "start_line": 549, "end_line": 555, "is_async": false, "is_method": false}, {"name": "test_sources_ignore_primary", "qualified_name": "test_sources_ignore_primary", "args": ["temp_cache", "valid_urls", "invalid_urls"], "decorators": [], "docstring": "", "start_line": 558, "end_line": 564, "is_async": false, "is_method": false}, {"name": "test_sources_multiple", "qualified_name": "test_sources_multiple", "args": ["temp_cache", "valid_urls", "invalid_urls"], "decorators": [], "docstring": "", "start_line": 567, "end_line": 575, "is_async": false, "is_method": false}, {"name": "test_sources_multiple_missing", "qualified_name": "test_sources_multiple_missing", "args": ["temp_cache", "valid_urls", "invalid_urls"], "decorators": [], "docstring": "", "start_line": 578, "end_line": 586, "is_async": false, "is_method": false}, {"name": "test_update_url", "qualified_name": "test_update_url", "args": ["tmp_path", "temp_cache"], "decorators": [], "docstring": "", "start_line": 589, "end_line": 613, "is_async": false, "is_method": false}, {"name": "test_download_noprogress", "qualified_name": "test_download_noprogress", "args": [], "decorators": ["pytest.mark.remote_data(source='astropy')"], "docstring": "", "start_line": 617, "end_line": 619, "is_async": false, "is_method": false}, {"name": "test_download_cache", "qualified_name": "test_download_cache", "args": [], "decorators": ["pytest.mark.remote_data(source='astropy')"], "docstring": "", "start_line": 623, "end_line": 639, "is_async": false, "is_method": false}, {"name": "test_download_certificate_verification_failed", "qualified_name": "test_download_certificate_verification_failed", "args": [], "decorators": ["pytest.mark.remote_data(source='astropy')"], "docstring": "Tests for https://github.com/astropy/astropy/pull/10434", "start_line": 643, "end_line": 660, "is_async": false, "is_method": false}, {"name": "test_download_cache_after_clear", "qualified_name": "test_download_cache_after_clear", "args": ["tmp_path", "temp_cache", "valid_urls"], "decorators": [], "docstring": "", "start_line": 663, "end_line": 677, "is_async": false, "is_method": false}, {"name": "test_download_parallel_from_internet_works", "qualified_name": "test_download_parallel_from_internet_works", "args": ["temp_cache"], "decora