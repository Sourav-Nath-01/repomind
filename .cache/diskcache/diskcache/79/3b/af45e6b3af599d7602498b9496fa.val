plementation\nto 20 microseconds.", "start_line": 11, "end_line": 73}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/time/tests/__init__.py", "file_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/time/tests/test_precision.py", "file_hash": "081151758ef7a9c6bb036c1f5f3f82250c6b6ee16694b0c05c0784312e5d738c", "imports": [{"module": "contextlib", "names": [], "is_from": false, "alias": ""}, {"module": "decimal", "names": [], "is_from": false, "alias": ""}, {"module": "functools", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "datetime", "names": ["datetime", "timedelta"], "is_from": true, "alias": ""}, {"module": "decimal", "names": ["Decimal"], "is_from": true, "alias": ""}, {"module": "erfa", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "pytest", "names": [], "is_from": false, "alias": ""}, {"module": "erfa", "names": ["ErfaError", "ErfaWarning"], "is_from": true, "alias": ""}, {"module": "hypothesis", "names": ["assume", "example", "given", "target"], "is_from": true, "alias": ""}, {"module": "hypothesis.extra.numpy", "names": ["array_shapes", "arrays"], "is_from": true, "alias": ""}, {"module": "hypothesis.strategies", "names": ["composite", "datetimes", "floats", "integers", "one_of", "sampled_from", "timedeltas", "tuples"], "is_from": true, "alias": ""}, {"module": "astropy.units", "names": [], "is_from": false, "alias": "u"}, {"module": "astropy.tests.helper", "names": ["assert_quantity_allclose"], "is_from": true, "alias": ""}, {"module": "astropy.time", "names": ["STANDARD_TIME_SCALES", "Time", "TimeDelta"], "is_from": true, "alias": ""}, {"module": "astropy.time.utils", "names": ["day_frac", "two_sum"], "is_from": true, "alias": ""}, {"module": "astropy.utils", "names": ["iers"], "is_from": true, "alias": ""}], "functions": [{"name": "setup_module", "qualified_name": "setup_module", "args": [], "decorators": [], "docstring": "", "start_line": 43, "end_line": 46, "is_async": false, "is_method": false}, {"name": "iers_b", "qualified_name": "iers_b", "args": [], "decorators": ["pytest.fixture(scope='module')"], "docstring": "This is an expensive operation, so we share it between tests using a\nmodule-scoped fixture instead of using the context manager form.  This\nis particularly important for Hypothesis, which invokes the decorated\ntest function many times (100 by default; see conftest.py for details).", "start_line": 50, "end_line": 57, "is_async": false, "is_method": false}, {"name": "quiet_erfa", "qualified_name": "quiet_erfa", "args": [], "decorators": ["contextlib.contextmanager"], "docstring": "", "start_line": 61, "end_line": 64, "is_async": false, "is_method": false}, {"name": "assert_almost_equal", "qualified_name": "assert_almost_equal", "args": ["a", "b"], "decorators": [], "docstring": "Assert numbers are almost equal.\n\nThis version also lets hypothesis know how far apart the inputs are, so\nthat it can work towards a failure and present the worst failure ever seen\nas well as the simplest, which often just barely exceeds the threshold.", "start_line": 67, "end_line": 98, "is_async": false, "is_method": false}, {"name": "reasonable_ordinary_jd", "qualified_name": "reasonable_ordinary_jd", "args": [], "decorators": [], "docstring": "", "start_line": 117, "end_line": 118, "is_async": false, "is_method": false}, {"name": "leap_second_tricky", "qualified_name": "leap_second_tricky", "args": ["draw"], "decorators": ["composite"], "docstring": "", "start_line": 122, "end_line": 130, "is_async": false, "is_method": false}, {"name": "reasonable_jd", "qualified_name": "reasonable_jd", "args": [], "decorators": [], "docstring": "Pick a reasonable JD.\n\nThese should be not too far in the past or future (so that date conversion\nroutines don't have to deal with anything too exotic), but they should\ninclude leap second days as a special case, and they should include several\nparticularly simple cases (today, the beginning of the ", "start_line": 133, "end_line": 144, "is_async": false, "is_method": false}, {"name": "unreasonable_ordinary_jd", "qualified_name": "unreasonable_ordinary_jd", "args": [], "decorators": [], "docstring": "JD pair that might be unordered or far away", "start_line": 147, "end_line": 149, "is_async": false, "is_method": false}, {"name": "ordered_jd", "qualified_name": "ordered_jd", "args": [], "decorators": [], "docstring": "JD pair that is ordered but not necessarily near now", "start_line": 152, "end_line": 154, "is_async": false, "is_method": false}, {"name": "unreasonable_jd", "qualified_name": "unreasonable_jd", "args": [], "decorators": [], "docstring": "", "start_line": 157, "end_line": 158, "is_async": false, "is_method": false}, {"name": "jd_arrays", "qualified_name": "jd_arrays", "args": ["draw", "jd_values"], "decorators": ["composite"], "docstring": "", "start_line": 162, "end_line": 167, "is_async": false, "is_method": false}, {"name": "unreasonable_delta", "qualified_name": "unreasonable_delta", "args": [], "decorators": [], "docstring": "", "start_line": 170, "end_line": 171, "is_async": false, "is_method": false}, {"name": "reasonable_delta", "qualified_name": "reasonable_delta", "args": [], "decorators": [], "docstring": "", "start_line": 174, "end_line": 175, "is_async": false, "is_method": false}, {"name": "test_abs_jd2_always_less_than_half", "qualified_name": "test_abs_jd2_always_less_than_half", "args": [], "decorators": [], "docstring": "Make jd2 approach +/-0.5, and check that it doesn't go over.", "start_line": 179, "end_line": 188, "is_async": false, "is_method": false}, {"name": "test_abs_jd2_always_less_than_half_on_construction", "qualified_name": "test_abs_jd2_always_less_than_half_on_construction", "args": ["jds"], "decorators": ["given(jd_arrays(unreasonable_jd()))"], "docstring": "", "start_line": 192, "end_line": 198, "is_async": false, "is_method": false}, {"name": "test_round_to_even", "qualified_name": "test_round_to_even", "args": ["jd1", "jd2"], "decorators": ["given(integers(-10 ** 8, 10 ** 8), sampled_from([-0.5, 0.5]))"], "docstring": "", "start_line": 202, "end_line": 204, "is_async": false, "is_method": false}, {"name": "test_addition", "qualified_name": "test_addition", "args": [], "decorators": [], "docstring": "Check that an addition at the limit of precision (2^-52) is seen", "start_line": 207, "end_line": 217, "is_async": false, "is_method": false}, {"name": "test_mult_div", "qualified_name": "test_mult_div", "args": [], "decorators": [], "docstring": "Test precision with multiply and divide", "start_line": 220, "end_line": 227, "is_async": false, "is_method": false}, {"name": "test_init_variations", "qualified_name": "test_init_variations", "args": [], "decorators": [], "docstring": "Check that 3 ways of specifying a time + small offset are equivalent", "start_line": 230, "end_line": 239, "is_async": false, "is_method": false}, {"name": "test_precision_exceeds_64bit", "qualified_name": "test_precision_exceeds_64bit", "args": [], "decorators": [], "docstring": "Check that Time object really holds more precision than float64 by looking\nat the (naively) summed 64-bit result and asserting equality at the\nbit level.", "start_line": 242, "end_line": 250, "is_async": false, "is_method": false}, {"name": "test_through_scale_change", "qualified_name": "test_through_scale_change", "args": [], "decorators": [], "docstring": "Check that precision holds through scale change (cxcsec is TT)", "start_line": 253, "end_line": 260, "is_async": false, "is_method": false}, {"name": "test_iso_init", "qualified_name": "test_iso_init", "args": [], "decorators": [], "docstring": "Check when initializing from ISO date", "start_line": 263, "end_line": 268, "is_async": false, "is_method": false}, {"name": "test_jd1_is_mult_of_one", "qualified_name": "test_jd1_is_mult_of_one", "args": [], "decorators": [], "docstring": "Check that jd1 is a multiple of 1.", "start_line": 271, "end_line": 278, "is_async": false, "is_method": false}, {"name": "test_precision_neg", "qualified_name": "test_precision_neg", "args": [], "decorators": [], "docstring": "Check precision when jd1 is negative.  This used to fail because ERFA\nroutines use a test like jd1 > jd2 to decide which component to update.\nIt was updated to abs(jd1) > abs(jd2) in erfa 1.6 (sofa 20190722).", "start_line": 281, "end_line": 290, "is_async": false, "is_method": false}, {"name": "test_precision_epoch", "qualified_name": "test_precision_epoch", "args": [], "decorators": [], "docstring": "Check that input via epoch also has full precision, i.e., against\nregression on https://github.com/astropy/astropy/pull/366", "start_line": 293, "end_line": 301, "is_async": false, "is_method": false}, {"name": "test_leap_seconds_rounded_correctly", "qualified_name": "test_leap_seconds_rounded_correctly", "args": [], "decorators": [], "docstring": "Regression tests against #2083, where a leap second was rounded\nincorrectly by the underlying ERFA routine.", "start_line": 304, "end_line": 315, "is_async": false, "is_method": false}, {"name": "test_two_sum", "qualified_name": "test_two_sum", "args": ["i", "f"], "decorators": ["given(integers(-2 ** 52 + 2, 2 ** 52 - 2), floats(-1, 1))", "example(i=65536, f=3.637978807091714e-12)"], "docstring": "", "start_line": 321, "end_line": 326, "is_async": false, "is_method": false}, {"name": "test_two_sum_symmetric", "qualified_name": "test_two_sum_symmetric", "args": ["f1", "f2"], "decorators": ["given(floats(min_value=np.finfo(float).min / 2, max_value=np.finfo(float).max / 2), floats(min_value=np.finfo(float).min / 2, max_value=np.finfo(float).max / 2))"], "docstring": "", "start_line": 337, "end_line": 338, "is_async": false, "is_method": false}, {"name": "test_two_sum_size", "qualified_name": "test_two_sum_size", "args": ["f1", "f2"], "decorators": ["given(floats(allow_nan=False, allow_infinity=False), floats(allow_nan=False, allow_infinity=False))", "example(f1=8.988465674311579e+307, f2=8.98846567431158e+307)", "example(f1=8.988465674311579e+307, f2=-8.98846567431158e+307)", "example(f1=-8.988465674311579e+307, f2=-8.98846567431158e+307)", "example(f1=-7.303128360378417e+307, f2=1.7976931348623157e+308)"], "docstring": "", "start_line": 349, "end_line": 355, "is_async": false, "is_method": false}, {"name": "test_day_frac_harmless", "qualified_name": "test_day_frac_harmless", "args": ["i", "f"], "decorators": ["given(integers(-2 ** 52 + 2, 2 ** 52 - 2), floats(-1, 1))", "example(i=65536, f=3.637978807091714e-12)"], "docstring": "", "start_line": 360, "end_line": 365, "is_async": false, "is_method": false}, {"name": "test_day_frac_exact", "qualified_name": "test_day_frac_exact", "args": ["i", "f"], "decorators": ["given(integers(-2 ** 52 + 2, 2 ** 52 - 2), floats(-0.5, 0.5))", "example(i=65536, f=3.637978807091714e-12)", "example(i=1, f=0.49999999999999994)"], "docstring": "", "start_line": 371, "end_line": 375, "is_async": false, "is_method": false}, {"name": "test_day_frac_idempotent", "qualified_name": "test_day_frac_idempotent", "args": ["i", "f"], "decorators": ["given(integers(-2 ** 52 + 2, 2 ** 52 - 2), floats(-1, 1))", "example(i=65536, f=3.637978807091714e-12)"], "docstring": "", "start_line": 380, "end_line": 382, "is_async": false, "is_method": false}, {"name": "test_mjd_initialization_precise", "qualified_name": "test_mjd_initialization_precise", "args": ["i", "f"], "decorators": ["given(integers(-2 ** 52 + 2, 2 ** 52 - int(erfa.DJM0) - 3), floats(-1, 1))", "example(i=65536, f=3.637978807091714e-12)"], "docstring": "", "start_line": 387, "end_line": 391, "is_async": false, "is_method": false}, {"name": "test_day_frac_always_less_than_half", "qualified_name": "test_day_frac_always_less_than_half", "args": ["jds"], "decorators": ["given(jd_arrays(unreasonable_jd()))"], "docstring": "", "start_line": 395, "end_line": 400, "is_async": false, "is_method": false}, {"name": "test_day_frac_round_to_even", "qualified_name": "test_day_frac_round_to_even", "args": ["jd1", "jd2"], "decorators": ["given(integers(-10 ** 8, 10 ** 8), sampled_from([-0.5, 0.5]))"], "docstring": "", "start_line": 404, "end_line": 406, "is_async": false, "is_method": false}, {"name": "test_resolution_never_decreases", "qualified_name": "test_resolution_never_decreases", "args": ["scale", "jds"], "decorators": ["given(scale=sampled_from([sc for sc in STANDARD_TIME_SCALES if sc != 'utc']), jds=unreasonable_jd())", "example(scale='tai', jds=(0.0, 0.0))", "example(scale='tai', jds=(0.0, -31738.500000000346))"], "docstring": "", "start_line": 415, "end_line": 419, "is_async": false, "is_method": false}, {"name": "test_resolution_never_decreases_utc", "qualified_name": "test_resolution_never_decreases_utc", "args": ["jds"], "decorators": ["given(reasonable_jd())", "example(jds=(2442777.5, 0.9999999999999999))"], "docstring": "UTC is very unhappy with unreasonable times,\n\nUnlike for the other timescales, in which addition is done\ndirectly, here the time is transformed to TAI before addition, and\nthen back to UTC.  Hence, some rounding errors can occur and only\na change of 2*dt_tiny is guaranteed to give a different time.", "start_line": 424, "end_line": 436, "is_async": false, "is_method": false}, {"name": "test_conversion_preserves_jd1_jd2_invariant", "qualified_name": "test_conversion_preserves_jd1_jd2_invariant", "args": ["iers_b", "scale1", "scale2", "jds"], "decorators": ["given(scale1=sampled_from(STANDARD_TIME_SCALES), scale2=sampled_from(STANDARD_TIME_SCALES), jds=unreasonable_jd())", "example(scale1='tcg', scale2='ut1', jds=(2445149.5, 0.47187700984387526))", "example(scale1='tai', scale2='tcb', jds=(2441316.5, 0.0))", "example(scale1='tai', scale2='tcb', jds=(0.0, 0.0))"],