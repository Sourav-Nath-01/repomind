ion.\n\nIn this case of `Identity`, ``self.inverse is self``.", "start_line": 170, "end_line": 176, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "mapping", "input_units_equivalencies", "input_units_allow_dimensionless", "name", "meta"], "decorators": [], "docstring": "", "start_line": 241, "end_line": 264, "is_async": false, "is_method": false}, {"name": "_rebuild_units", "qualified_name": "_rebuild_units", "args": ["self"], "decorators": [], "docstring": "", "start_line": 266, "end_line": 270, "is_async": false, "is_method": false}, {"name": "n_inputs", "qualified_name": "n_inputs", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 273, "end_line": 274, "is_async": false, "is_method": false}, {"name": "n_outputs", "qualified_name": "n_outputs", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 277, "end_line": 278, "is_async": false, "is_method": false}, {"name": "inputs", "qualified_name": "inputs", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 281, "end_line": 282, "is_async": false, "is_method": false}, {"name": "inputs", "qualified_name": "inputs", "args": ["self", "value"], "decorators": ["inputs.setter"], "docstring": "", "start_line": 285, "end_line": 287, "is_async": false, "is_method": false}, {"name": "outputs", "qualified_name": "outputs", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 290, "end_line": 291, "is_async": false, "is_method": false}, {"name": "outputs", "qualified_name": "outputs", "args": ["self", "value"], "decorators": ["outputs.setter"], "docstring": "", "start_line": 294, "end_line": 296, "is_async": false, "is_method": false}, {"name": "input_units", "qualified_name": "input_units", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 299, "end_line": 300, "is_async": false, "is_method": false}, {"name": "mapping", "qualified_name": "map