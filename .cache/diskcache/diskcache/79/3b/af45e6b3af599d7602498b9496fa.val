: "_refresh_table_as_needed", "args": ["self", "mjd"], "decorators": [], "docstring": "Potentially update the IERS table in place depending on the requested\ntime values in ``mdj`` and the time span of the table.  The base behavior\nis not to update the table.  ``IERS_Auto`` overrides this method.", "start_line": 503, "end_line": 509, "is_async": false, "is_method": false}, {"name": "ut1_utc_source", "qualified_name": "ut1_utc_source", "args": ["self", "i"], "decorators": [], "docstring": "Source for UT1-UTC.  To be overridden by subclass.", "start_line": 511, "end_line": 513, "is_async": false, "is_method": false}, {"name": "dcip_source", "qualified_name": "dcip_source", "args": ["self", "i"], "decorators": [], "docstring": "Source for CIP correction.  To be overridden by subclass.", "start_line": 515, "end_line": 517, "is_async": false, "is_method": false}, {"name": "pm_source", "qualified_name": "pm_source", "args": ["self", "i"], "decorators": [], "docstring": "Source for polar motion.  To be overridden by subclass.", "start_line": 519, "end_line": 521, "is_async": false, "is_method": false}, {"name": "time_now", "qualified_name": "time_now", "args": ["self"], "decorators": ["property"], "docstring": "Property to provide the current time, but also allow for explicitly setting\nthe _time_now attribute for testing purposes.", "start_line": 524, "end_line": 532, "is_async": false, "is_method": false}, {"name": "_convert_col_for_table", "qualified_name": "_convert_col_for_table", "args": ["self", "col"], "decorators": [], "docstring": "", "start_line": 534, "end_line": 542, "is_async": false, "is_method": false}, {"name": "_combine_a_b_columns", "qualified_name": "_combine_a_b_columns", "args": ["cls", "iers_a"], "decorators": ["classmethod"], "docstring": "Return a new table with appropriate combination of IERS_A and B columns.", "start_line": 561, "end_line": 604, "is_async": false, "is_method": false}, {"name": "_substitute_iers_b", "qualified_name": "_substitute_iers_b", "args": ["cls", "table"], "decorators": ["classmethod"], "docstring": "", "start_line": 607, "end_line": 609, "is_async": false, "is_method": false}, {"name": "read", "qualified_name": "read", "args": ["cls", "file", "readme"], "decorators": ["classmethod"], "docstring": "Read IERS-A table from a finals2000a.* file provided by USNO.\n\nParameters\n----------\nfile : str\n    full path to ascii file holding IERS-A data.\n    Defaults to ``iers.IERS_A_FILE``.\nreadme : str\n    full path to ascii file holding CDS-style readme.\n    Defaults to package version, ``iers.IERS_A_REA", "start_line": 612, "end_line": 640, "is_async": false, "is_method": false}, {"name": "ut1_utc_source", "qualified_name": "ut1_utc_source", "args": ["self", "i"], "decorators": [], "docstring": "Set UT1-UTC source flag for entries in IERS table.", "start_line": 642, "end_line": 648, "is_async": false, "is_method": false}, {"name": "dcip_source", "qualified_name": "dcip_source", "args": ["self", "i"], "decorators": [], "docstring": "Set CIP correction source flag for entries in IERS table.", "start_line": 650, "end_line": 656, "is_async": false, "is_method": false}, {"name": "pm_source", "qualified_name": "pm_source", "args": ["self", "i"], "decorators": [], "docstring": "Set polar motion source flag for entries in IERS table.", "start_line": 658, "end_line": 664, "is_async": false, "is_method": false}, {"name": "read", "qualified_name": "read", "args": ["cls", "file", "readme", "data_start"], "decorators": ["classmethod"], "docstring": "Read IERS-B table from a eopc04.* file provided by IERS.\n\nParameters\n----------\nfile : str\n    full path to ascii file holding IERS-B data.\n    Defaults to package version, ``iers.IERS_B_FILE``.\nreadme : str\n    full path to ascii file holding CDS-style readme.\n    Defaults to package version, ``ier", "start_line": 684, "end_line": 729, "is_async": false, "is_method": false}, {"name": "ut1_utc_source", "qualified_name": "ut1_utc_source", "args": ["self", "i"], "decorators": [], "docstring": "Set UT1-UTC source flag for entries in IERS table.", "start_line": 731, "end_line": 733, "is_async": false, "is_method": false}, {"name": "dcip_source", "qualified_name": "dcip_source", "args": ["self", "i"], "decorators": [], "docstring": "Set CIP correction source flag for entries in IERS table.", "start_line": 735, "end_line": 737, "is_async": false, "is_method": false}, {"name": "pm_source", "qualified_name": "pm_source", "args": ["self", "i"], "decorators": [], "docstring": "Set PM source flag for entries in IERS table.", "start_line": 739, "end_line": 741, "is_async": false, "is_method": false}, {"name": "open", "qualified_name": "open", "args": ["cls"], "decorators": ["classmethod"], "docstring": "If the configuration setting ``astropy.utils.iers.conf.auto_download``\nis set to True (default), then open a recent version of the IERS-A\ntable with predictions for UT1-UTC and polar motion out to\napproximately one year from now.  If the available version of this file\nis older than ``astropy.utils.i", "start_line": 753, "end_line": 810, "is_async": false, "is_method": false}, {"name": "_check_interpolate_indices", "qualified_name": "_check_interpolate_indices", "args": ["self", "indices_orig", "indices_clipped", "max_input_mjd"], "decorators": [], "docstring": "Check that the indices from interpolation match those after clipping to the\nvalid table range.  The IERS_Auto class is exempted as long as it has\nsufficiently recent available data so the clipped interpolation is\nalways within the confidence bounds of current Earth rotation\nknowledge.", "start_line": 812, "end_line": 827, "is_async": false, "is_method": false}, {"name": "_refresh_table_as_needed", "qualified_name": "_refresh_table_as_needed", "args": ["self", "mjd"], "decorators": [], "docstring": "Potentially update the IERS table in place depending on the requested\ntime values in ``mjd`` and the time span of the table.\n\nFor IERS_Auto the behavior is that the table is refreshed from the IERS\nserver if both the following apply:\n\n- Any of the requested IERS values are predictive.  The IERS-A ta", "start_line": 829, "end_line": 913, "is_async": false, "is_method": false}, {"name": "_substitute_iers_b", "qualified_name": "_substitute_iers_b", "args": ["cls", "table"], "decorators": ["classmethod"], "docstring": "Substitute IERS B values with those from a real IERS B table.\n\nIERS-A has IERS-B values included, but for reasons unknown these\ndo not match the latest IERS-B values (see comments in #4436).\nHere, we use the bundled astropy IERS-B table to overwrite the values\nin the downloaded IERS-A table.", "start_line": 916, "end_line": 945, "is_async": false, "is_method": false}, {"name": "validate", "qualified_name": "validate", "args": ["cls", "value"], "decorators": ["classmethod"], "docstring": "", "start_line": 985, "end_line": 990, "is_async": false, "is_method": false}, {"name": "open", "qualified_name": "open", "args": ["cls", "file", "cache"], "decorators": ["classmethod"], "docstring": "Open a leap-second list.\n\nParameters\n----------\nfile : path-like or None\n    Full local or network path to the file holding leap-second data,\n    for passing on to the various ``from_`` class methods.\n    If 'erfa', return the data used by the ERFA library.\n    If `None`, use default locations from ", "start_line": 1031, "end_line": 1074, "is_async": false, "is_method": false}, {"name": "_today", "qualified_name": "_today", "args": [], "decorators": ["staticmethod"], "docstring": "", "start_line": 1077, "end_line": 1081, "is_async": false, "is_method": false}, {"name": "auto_open", "qualified_name": "auto_open", "args": ["cls", "files"], "decorators": ["classmethod"], "docstring": "Attempt to get an up-to-date leap-second list.\n\nThe routine will try the files in sequence until it finds one\nwhose expiration date is \"good enough\" (see below).  If none\nare good enough, it returns the one with the most recent expiration\ndate, warning if that file is expired.\n\nFor remote files that", "start_line": 1084, "end_line": 1165, "is_async": false, "is_method": false}, {"name": "expires", "qualified_name": "expires", "args": ["self"], "decorators": ["property"], "docstring": "The limit of validity of the table.", "start_line": 1168, "end_line": 1170, "is_async": false, "is_method": false}, {"name": "_read_leap_seconds", "qualified_name": "_read_leap_seconds", "args": ["cls", "file"], "decorators": ["classmethod"], "docstring": "Read a file, identifying expiration by matching 'File expires'.", "start_line": 1173, "end_line": 1193, "is_async": false, "is_method": false}, {"name": "from_iers_leap_seconds", "qualified_name": "from_iers_leap_seconds", "args": ["cls", "file"], "decorators": ["classmethod"], "docstring": "Create a table from a file like the IERS ``Leap_Second.dat``.\n\nParameters\n----------\nfile : path-like, optional\n    Full local or network path to the file holding leap-second data\n    in a format consistent with that used by IERS.  By default, uses\n    ``iers.IERS_LEAP_SECOND_FILE``.\n\nNotes\n-----\nTh", "start_line": 1196, "end_line": 1213, "is_async": false, "is_method": false}, {"name": "from_leap_seconds_list", "qualified_name": "from_leap_seconds_list", "args": ["cls", "file"], "decorators": ["classmethod"], "docstring": "Create a table from a file like the IETF ``leap-seconds.list``.\n\nParameters\n----------\nfile : path-like, optional\n    Full local or network path to the file holding leap-second data\n    in a format consistent with that used by IETF.  Up to date versions\n    can be retrieved from ``iers.IETF_LEAP_SEC", "start_line": 1216, "end_line": 1249, "is_async": false, "is_method": false}, {"name": "from_erfa", "qualified_name": "from_erfa", "args": ["cls", "built_in"], "decorators": ["classmethod"], "docstring": "Create table from the leap-second list in ERFA.\n\nParameters\n----------\nbuilt_in : bool\n    If `False` (default), retrieve the list currently used by ERFA,\n    which may have been updated.  If `True`, retrieve the list shipped\n    with erfa.", "start_line": 1252, "end_line": 1274, "is_async": false, "is_method": false}, {"name": "update_erfa_leap_seconds", "qualified_name": "update_erfa_leap_seconds", "args": ["self", "initialize_erfa"], "decorators": [], "docstring": "Add any leap seconds not already present to the ERFA table.\n\nThis method matches leap seconds with those present in the ERFA table,\nand extends the latter as necessary.\n\nParameters\n----------\ninitialize_erfa : bool, or 'only', or 'empty'\n    Initialize the ERFA leap second table to its built-in valu", "start_line": 1276, "end_line": 1319, "is_async": false, "is_method": false}], "classes": [{"name": "IERSWarning", "bases": ["AstropyWarning"], "methods": [], "docstring": "Generic warning class for IERS.", "start_line": 119, "end_line": 122}, {"name": "IERSDegradedAccuracyWarning", "bases": ["AstropyWarning"], "methods": [], "docstring": "IERS time conversion has degraded accuracy normally due to setting\n``conf.auto_download = False`` and ``conf.iers_degraded_accuracy = 'warn'``.", "start_line": 125, "end_line": 129}, {"name": "IERSStaleWarning", "bases": ["IERSWarning"], "methods": [], "docstring": "Downloaded IERS table may be stale.", "start_line": 132, "end_line": 135}, {"name": "Conf", "bases": ["_config.ConfigNamespace"], "methods": [], "docstring": "Configuration parameters for `astropy.utils.iers`.", "start_line": 165, "end_line": 206}, {"name": "IERSRangeError", "bases": ["IndexError"], "methods": [], "docstring": "Any error for when dates are outside of the valid range for IERS.", "start_line": 212, "end_line": 215}, {"name": "IERS", "bases": ["QTable"], "methods": ["open", "close", "mjd_utc", "ut1_utc", "dcip_xy", "pm_xy", "_check_interpolate_indices", "_interpolate", "_refresh_table_as_needed", "ut1_utc_source", "dcip_source", "pm_source", "time_now", "_convert_col_for_table"], "docstring": "Generic IERS table class, defining interpolation functions.\n\nSub-classed from `astropy.table.QTable`.  The table should hold columns\n'MJD', 'UT1_UTC', 'dX_2000A'/'dY_2000A', and 'PM_x'/'PM_y'.", "start_line": 218, "end_line": 542}, {"name": "IERS_A", "bases": ["IERS"], "methods": ["_combine_a_b_columns", "_substitute_iers_b", "read", "ut1_utc_source", "dcip_source", "pm_source"], "docstring": "IERS Table class targeted to IERS A, provided by USNO.\n\nThese include rapid turnaround and predicted times.\nSee https://datacenter.iers.org/eop.php\n\nNotes\n-----\nThe IERS A file is not part of astropy.  It can be downloaded from\n``iers.IERS_A_URL`` or ``iers.IERS_A_URL_MIRROR``. See ``iers.__doc__``\n", "start_line": 545, "end_line": 664}, {"name": "IERS_B", "bases": ["IERS"], "methods": ["read", "ut1_utc_source", "dcip_source", "pm_source"], "docstring": "IERS Table class targeted to IERS B, provided by IERS itself.\n\nThese are final values; see https://www.iers.org/IERS/EN/Home/home_node.html\n\nNotes\n-----\nIf the package IERS B file (```iers.IERS_B_FILE``) is out of date, a new\nversion can be downloaded from ``iers.IERS_B_URL``.\n\nSee `~astropy.utils.i", "start_line": 667, "end_line": 741}, {"name": "IERS_Auto", "bases": ["IERS_A"], "methods": ["open", "_check_interpolate_indices", "_refresh_table_as_needed", "_substitute_iers_b"], "docstring": "Provide most-recent IERS data and automatically handle downloading\nof updated values as necessary.", "start_line": 744, "end_line": 945}, {"name": "earth_orientation_table", "bases": ["ScienceState"], "methods": ["validate"], "docstring": "Default IERS table for Earth rotation and reference systems service.\n\nThese tables are used to calculate the offsets between ``UT1`` and ``UTC``\nand for conversion to Earth-based coordinate systems.\n\nThe state itself is an IERS table, as an instance of one of the\n`~astropy.utils.iers.IERS` classes. ", "start_line": 948, "end_line": 990}, {"name": "LeapSeconds", "bases": ["QTable"], "methods": ["open", "_today", "auto_open", "expires", "_read_leap_seconds", "from_iers_leap_seconds", "from_leap_seconds_list", "from_erfa", "update_erfa_leap_seconds"], "docstring": "Leap seconds class, holding TAI-UTC differences.\n\nThe table should hold columns 'year', 'month', 'tai_utc'.\n\nMethods are provided to initialize the table from IERS ``Leap_Second.dat``,\nIETF/ntp ``leap-seconds.list``, or built-in ERFA/SOFA, and to update the\nlist used by ERFA.\n\nNotes\n-----\nAstropy ha", "start_line": 993, "end_line": 1319}], "calls": [], "module_docstring": "The astropy.utils.iers package provides access to the tables provided by\nthe International Earth Rotation and Reference Systems Service, in\nparticular allowing interpolation of published UT1-UTC values for given\ntimes.  These are used in `astropy.time` to provide UT1 values.  The polar\nmotions are also used for determining earth orientation for\ncelestial-to-terrestrial coordinate transformations\n(in `astropy.coordinates`).", "parse_error": ""}, {"file_path": "astropy/utils/iers/__init__.py", "file_hash": "bdff4af521e02da06a941aa86c05511745f96983a5ed2ddaa66ea373d22d602a", "imports": [{"module": "iers", "names": ["*"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/utils/masked/__init__.py", "file_hash": "eb4fe420aaa96a8044e0230a138cc02708dca80b61fe8f77ba1ff11e100274db", "imports": [{"module": "core", "names": ["*"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "Built-in mask mixin class.\n\nThe design uses `Masked` as a factory class which automatically\ngenerates new subclasses for any data class that is itself a\nsubclass of a predefined masked class, with `MaskedNDArray`\nproviding such a predefined class for `~numpy.ndarray`.", "parse_error": ""}, {"file_path": "astropy/utils/masked/function_helpers.py", "file_hash": "845dafd84713eae8d2d1ebceea7d0cd6e5