d": false}, {"name": "test_header_fromkeys_with_value", "qualified_name": "test_header_fromkeys_with_value", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1153, "end_line": 1160, "is_async": false, "is_method": false}, {"name": "test_header_fromkeys_with_value_and_comment", "qualified_name": "test_header_fromkeys_with_value_and_comment", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1162, "end_line": 1166, "is_async": false, "is_method": false}, {"name": "test_header_fromkeys_with_duplicates", "qualified_name": "test_header_fromkeys_with_duplicates", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1168, "end_line": 1178, "is_async": false, "is_method": false}, {"name": "test_header_items", "qualified_name": "test_header_items", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1180, "end_line": 1182, "is_async": false, "is_method": false}, {"name": "test_header_iterkeys", "qualified_name": "test_header_iterkeys", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1184, "end_line": 1187, "is_async": false, "is_method": false}, {"name": "test_header_itervalues", "qualified_name": "test_header_itervalues", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1189, "end_line": 1192, "is_async": false, "is_method": false}, {"name": "test_header_keys", "qualified_name": "test_header_keys", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1194, "end_line": 1204, "is_async": false, "is_method": false}, {"name": "test_header_list_like_pop", "qualified_name": "test_header_list_like_pop", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1206, "end_line": 1224, "is_async": false, "is_method": false}, {"name": "test_header_dict_like_pop", "qualified_name": "test_header_dict_like_pop", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1226, "end_line": 1249, "is_async": false, "is_method": false}, {"name": "test_popitem", "qualified_name": "test_popitem", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1251, "end_line": 1262, "is_async": false, "is_method": false}, {"name": "test_setdefault", "qualified_name": "test_setdefault", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1264, "end_line": 1274, "is_async": false, "is_method": false}, {"name": "test_update_from_dict", "qualified_name": "test_update_from_dict", "args": ["self"], "decorators": [], "docstring": "Test adding new cards and updating existing cards from a dict using\nHeader.update()", "start_line": 1276, "end_line": 1297, "is_async": false, "is_method": false}, {"name": "test_update_from_iterable", "qualified_name": "test_update_from_iterable", "args": ["self"], "decorators": [], "docstring": "Test adding new cards and updating existing cards from an iterable of\ncards and card tuples.", "start_line": 1299, "end_line": 1311, "is_async": false, "is_method": false}, {"name": "test_header_extend", "qualified_name": "test_header_extend", "args": ["self"], "decorators": [], "docstring": "Test extending a header both with and without stripping cards from the\nextension header.", "start_line": 1313, "end_line": 1338, "is_async": false, "is_method": false}, {"name": "test_header_extend_unique", "qualified_name": "test_header_extend_unique", "args": ["self"], "decorators": [], "docstring": "Test extending the header with and without unique=True.", "start_line": 1340, "end_line": 1359, "is_async": false, "is_method": false}, {"name": "test_header_extend_unique_commentary", "qualified_name": "test_header_extend_unique_commentary", "args": ["self"], "decorators": [], "docstring": "Test extending header with and without unique=True and commentary\ncards in the header being added. Issue astropy/astropy#3967", "start_line": 1361, "end_line": 1375, "is_async": false, "is_method": false}, {"name": "test_header_extend_update", "qualified_name": "test_header_extend_update", "args": ["self"], "decorators": [], "docstring": "Test extending the header with and without update=True.", "start_line": 1377, "end_line": 1406, "is_async": false, "is_method": false}, {"name": "test_header_extend_update_commentary", "qualified_name": "test_header_extend_update_commentary", "args": ["self"], "decorators": [], "docstring": "Test extending header with and without unique=True and commentary\ncards in the header being added.\n\nThough not quite the same as astropy/astropy#3967, update=True hits\nthe same if statement as that issue.", "start_line": 1408, "end_line": 1425, "is_async": false, "is_method": false}, {"name": "test_header_extend_exact", "qualified_name": "test_header_extend_exact", "args": ["self"], "decorators": [], "docstring": "Test that extending an empty header with the contents of an existing\nheader can exactly duplicate that header, given strip=False and\nend=True.", "start_line": 1427, "end_line": 1437, "is_async": false, "is_method": false}, {"name": "test_header_count", "qualified_name": "test_header_count", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1439, "end_line": 1447, "is_async": false, "is_method": false}, {"name": "test_header_append_use_blanks", "qualified_name": "test_header_append_use_blanks", "args": ["self"], "decorators": [], "docstring": "Tests that blank cards can be appended, and that future appends will\nuse blank cards when available (unless useblanks=False)", "start_line": 1449, "end_line": 1474, "is_async": false, "is_method": false}, {"name": "test_header_append_keyword_only", "qualified_name": "test_header_append_keyword_only", "args": ["self"], "decorators": [], "docstring": "Test appending a new card with just the keyword, and no value or\ncomment given.", "start_line": 1476, "end_line": 1497, "is_async": false, "is_method": false}, {"name": "test_header_insert_use_blanks", "qualified_name": "test_header_insert_use_blanks", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1499, "end_line": 1517, "is_async": false, "is_method": false}, {"name": "test_header_insert_before_keyword", "qualified_name": "test_header_insert_before_keyword", "args": ["self"], "decorators": [], "docstring": "Test that a keyword name or tuple can be used to insert new keywords.\n\nAlso tests the ``after`` keyword argument.\n\nRegression test for https://github.com/spacetelescope/PyFITS/issues/12", "start_line": 1519, "end_line": 1553, "is_async": false, "is_method": false}, {"name": "test_remove", "qualified_name": "test_remove", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1555, "end_line": 1580, "is_async": false, "is_method": false}, {"name": "test_header_comments", "qualified_name": "test_header_comments", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1582, "end_line": 1584, "is_async": false, "is_method": false}, {"name": "test_comment_slices_and_filters", "qualified_name": "test_comment_slices_and_filters", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1586, "end_line": 1593, "is_async": false, "is_method": false}, {"name": "test_comment_slice_filter_assign", "qualified_name": "test_comment_slice_filter_assign", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1595, "end_line": 1607, "is_async": false, "is_method": false}, {"name": "test_commentary_slicing", "qualified_name": "test_commentary_slicing", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1609, "end_line": 1638, "is_async": false, "is_method": false}, {"name": "test_update_commentary", "qualified_name": "test_update_commentary", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1640, "end_line": 1660, "is_async": false, "is_method": false}, {"name": "test_commentary_comparison", "qualified_name": "test_commentary_comparison", "args": ["self"], "decorators": [], "docstring": "Regression test for an issue found in *writing* the regression test for\nhttps://github.com/astropy/astropy/issues/2363, where comparison of\nthe list of values for a commentary keyword did not always compare\ncorrectly with other iterables.", "start_line": 1662, "end_line": 1676, "is_async": false, "is_method": false}, {"name": "test_long_commentary_card", "qualified_name": "test_long_commentary_card", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1678, "end_line": 1713, "is_async": false, "is_method": false}, {"name": "test_totxtfile", "qualified_name": "test_totxtfile", "args": ["self", "home_is_temp"], "decorators": [], "docstring": "", "start_line": 1715, "end_line": 1753, "is_async": false, "is_method": false}, {"name": "test_tofile", "qualified_name": "test_tofile", "args": ["self", "home_is_temp"], "decorators": [], "docstring": "Repeat test_totxtfile, but with tofile()", "start_line": 1755, "end_line": 1796, "is_async": false, "is_method": false}, {"name": "test_fromfile", "qualified_name": "test_fromfile", "args": ["self"], "decorators": [], "docstring": "Regression test for https://github.com/astropy/astropy/issues/8711", "start_line": 1798, "end_line": 1802, "is_async": false, "is_method": false}, {"name": "test_header_fromtextfile", "qualified_name": "test_header_fromtextfile", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/122\n\nManually write a text file containing some header cards ending with\nnewlines and ensure that fromtextfile can read them back in.", "start_line": 1804, "end_line": 1820, "is_async": false, "is_method": false}, {"name": "test_header_fromtextfile_with_end_card", "qualified_name": "test_header_fromtextfile_with_end_card", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/154\n\nMake sure that when a Header is read from a text file that the END card\nis ignored.", "start_line": 1822, "end_line": 1842, "is_async": false, "is_method": false}, {"name": "test_append_end_card", "qualified_name": "test_append_end_card", "args": ["self"], "decorators": [], "docstring": "Regression test 2 for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/154\n\nManually adding an END card to a header should simply result in a\nValueError (as was the case in PyFITS 3.0 and earlier).", "start_line": 1844, "end_line": 1861, "is_async": false, "is_method": false}, {"name": "test_invalid_end_cards", "qualified_name": "test_invalid_end_cards", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/217\n\nThis tests the case where the END card looks like a normal card like\n'END = ' and other similar oddities.  As long as a card starts with END\nand looks like it was intended to be the END card we allow it, but with\na warning.", "start_line": 1863, "end_line": 1935, "is_async": false, "is_method": false}, {"name": "test_invalid_characters", "qualified_name": "test_invalid_characters", "args": ["self"], "decorators": [], "docstring": "Test header with invalid characters", "start_line": 1937, "end_line": 1963, "is_async": false, "is_method": false}, {"name": "test_unnecessary_move", "qualified_name": "test_unnecessary_move", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/125\n\nEnsures that a header is not modified when setting the position of a\nkeyword that's already in its correct position.", "start_line": 1965, "end_line": 2003, "is_async": false, "is_method": false}, {"name": "test_invalid_float_cards", "qualified_name": "test_invalid_float_cards", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/137", "start_line": 2005, "end_line": 2055, "is_async": false, "is_method": false}, {"name": "test_invalid_float_cards2", "qualified_name": "test_invalid_float_cards2", "args": ["self", "capsys"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/140", "start_line": 2057, "end_line": 2084, "is_async": false, "is_method": false}, {"name": "test_leading_zeros", "qualified_name": "test_leading_zeros", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/137, part 2\n\nTicket https://aeon.stsci.edu/ssb/trac/pyfits/ticket/137 also showed that in\nfloat values like 0.001 the leading zero was unnecessarily being\nstripped off when rewriting the header.  Though leading zeros should be\nremoved", "start_line": 2086, "end_line": 2106, "is_async": false, "is_method": false}, {"name": "test_assign_boolean", "qualified_name": "test_assign_boolean", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/123\n\nTests assigning Python and Numpy boolean values to keyword values.", "start_line": 2108, "end_line": 2139, "is_async": false, "is_method": false}, {"name": "test_header_method_keyword_normalization", "qualified_name": "test_header_method_keyword_normalization", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/149\n\nBasically ensures that all public Header methods are case-insensitive\nw.r.t. keywords.\n\nProvides a reasonably comprehensive test of several methods at once.", "start_line": 2141, "end_line": 2196, "is_async": false, "is_method": false}, {"name": "test_end_in_comment", "qualified_name": "test_end_in_comment", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/142\n\nTests a case where the comment of a card ends with END, and is followed\nby several blank cards.", "start_line": 2198, "end_line": 2235, "is_async": false, "is_method": false}, {"name": "test_assign_unicode", "qualified_name": "test_assign_unicode", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/134\n\nAssigning a unicode literal as a header value should not fail silently.\nIf the value can be converted to ASCII then it should just work.\nOtherwise it should fail with an appropriate value error.\n\nAlso tests unicode for keywords a", "start_line": 2237, "end_line": 2272, "is_async": false, "is_method": false}, {"name": "test_assign_non_ascii", "qualified_name": "test_assign_non_ascii", "args": ["self"], "decorators": [], "docstring": "First regression test for\nhttps://github.com/spacetelescope/PyFITS/issues/37\n\nAlthough test_assign_unicode ensures that `str` objects containing\nnon-ASCII characters cannot be assigned to headers.\n\nIt should not be possible to assign bytes to a header at all.", "start_line": 2274, "end_line": 2287, "is_async": false, "is_method": false}, {"name": "test_header_strip_whitespace", "qualified_name": "test_header_strip_whitespace", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/146, and\nfor the solution that is optional stripping of whitespace from the end\nof a header value.\n\nBy default extra whitespace is stripped off, but if\n`fits.conf.strip_header_whitespace` = False it should not be\nstripped.", "start_line": 2289, "end_line": 2318, "is_async": false, "is_method": false}, {"name": "test_keep_duplicate_history_in_orig_header", "qualified_name": "test_keep_duplicate_history_in_orig_header", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/156\n\nWhen creating a new HDU from an existing Header read from an existing\nFITS file, if the original header contains duplicate HISTORY values\nthose duplicates should be preserved just as in the original header.\n\nThis bug occurred due", "start_line": 2320, "end_line": 2353, "is_async": false, "is_method": false}, {"name": "test_invalid_keyword_cards", "qualified_name": "test_invalid_keyword_cards", "args": ["self"], "decorators": [], "docstring": "Test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/109\n\nAllow opening files with headers containing invalid keywords.", "start_line": 2355, "end_line": 2395, "is_async": false, "is_method": false}, {"name": "test_fix_hierarch_with_invalid_value", "qualified_name": "test_fix_hierarch_with_invalid_value", "args": ["self", "capsys"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/172\n\nEnsures that when fixing a hierarch card it remains a hierarch card.", "start_line": 2397, "end_line": 2409, "is_async": false, "is_method": false}, {"name": "test_assign_inf_nan", "qualified_name": "test_assign_inf_nan", "args": ["self"], "decorators": [], "docstring": "Regression test for https://github.com/spacetelescope/PyFITS/issues/11\n\nFor the time being it should not be possible to assign the floating\npoint values inf or nan to a header value, since this is not defined by\nthe FITS standard.", "start_line": 2411, "end_line": 2425, "is_async": false, "is_method": false}, {"name": "test_update_bool", "qualified_name": "test_update_bool", "args": ["self"], "decorators": [], "docstring": "Regression test for an issue where a value of True in a header\ncannot be updated to a value of 1, and likewise for False/0.", "start_line": 2427, "end_line": 2453, "is_async": false, "is_method": false}, {"name": "test_update_numeric", "qualified_name": "test_update_numeric", "args": ["self"], "decorators": [], "docstring": "Regression test for https://github.com/spacetelescope/PyFITS/issues/49\n\nEnsure that numeric values can be upcast/downcast between int, float,\nand complex by assigning values that compare equal to the existing\nvalue but are a different type.", "start_line": 2455, "end_line": 2528, "is_async": false, "is_method": false}, {"name": "test_newlines_in_commentary", "qualified_name": "test_newlines_in_commentary", "args": ["self"], "decorators": [], "docstring": "Regression test for https://github.com/spacetelescope/PyFITS/issues/51\n\nTest data extracted from a header in an actual FITS file found in the\nwild.  Names have been changed to protect the innocent.", "start_line": 2530, "end_line": 2567, "is_async": false, "is_method": false}, {"name": "test_long_commentary_card_appended_to_header", "qualified_name": "test_long_commentary_card_appended_to_header", "args": ["self"], "decorators": [], "docstring": "If a HISTORY or COMMENT card with a too-long value is appended to a\nheader with Header.append (as opposed to assigning to hdr['HISTORY']\nit fails verification.\n\nRegression test for https://github.com/astropy/astropy/issues/11486", "start_line": 2569, "end_line": 2591, "is_async": false, "is_method": false}, {"name": "test_header_fromstring_bytes", "qualified_name": "test_header_fromstring_bytes", "args": ["self"], "decorators": [], "docstring": "Test reading a Header from a `bytes` string.\n\nSee https://github.com/astropy/astropy/issues/8706", "start_line": 2593, "end_line": 2606, "is_async": false, "is_method": false}, {"name": "test_set_keyword_with_space", "qualified_name": "test_set_keyword_with_space", "args": ["self"], "decorators": [], "docstring": "Regression test for https://github.com/astropy/astropy/issues/10479", "start_line": 2608, "end_line": 2617, "is_async": false, "is_method": false}, {"name": "test_strip", "qualified_name": "test_strip", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2619, "end_line": 2628, "is_async": false, "is_method": false}, {"name": "test_update_invalid_card", "qualified_name": "test_update_invalid_card", "args": ["self"], "decorators": [], "docstring": "Regression test for https://github.com/astropy/astropy/issues/5408\n\nTests updating the value of a card that is malformatted (with an\ninvalid value literal).\n\nThis tests two ways of reproducing the problem, one working with a\nCard object directly, and one when reading/writing a header containing\nsuch", "start_line": 2630, "end_line": 2660, "is_async": false, "is_method": false}, {"name": "test_index_numpy_int", "qualified_name": "test_index_numpy_int", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2662, "end_line": 2679, "is_async": false, "is_method": false}, {"name": "test_header_data_size", "qualified_name": "test_header_data_size", "args": ["self"], "decorators": [], "docstring": "Tests data size calculation (w/o padding) given a Header.", "start_line": 2681, "end_line": 2694, "is_async": false, "is_method": false}, {"name": "setup_method", "qualified_name": "setup_method", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2709, "end_line": 2719, "is_async": false, "is_method": false}, {"name": "test_initialize_rvkc", "qualified_name": "test_initialize_rvkc", "args": ["self"], "decorators": [], "docstring": "Test different methods for initializing a card that should be\nrecognized as a RVKC", "start_line": 2721, "end_line": 2772, "is_async": false, "is_method": false}, {"name": "test_parse_field_specifier", "qualified_name": "test_parse_field_specifier", "args": ["self"], "decorators": [], "docstring": "Tests that the field_specifier can accessed from a card read from a\nstring before any other attributes are accessed.", "start_line": 2774, "end_line": 2784, "is_async": false, "is_method": false}, {"name": "test_update_field_specifier", "qualified_name": "test_update_field_specifier", "args": ["self"], "decorators": [], "docstring": "Test setting the field_specifier attribute and updating the card image\nto reflect the new value.", "start_line": 2786, "end_line": 2799, "is_async": false, "is_method": false}, {"name": "test_field_specifier_case_senstivity", "qualified_name": "test_field_specifier_case_senstivity", "args": ["self"], "decorators": [], "docstring": "The keyword portion of an RVKC should still be case-insensitive, but\nthe field-specifier portion should be case-sensitive.", "start_line": 2801, "end_line": 2814, "is_async": false, "is_method": false}, {"name": "test_get_rvkc_by_index", "qualified_name": "test_get_rvkc_by_index", "args": ["self"], "decorators": [], "docstring": "Returning a RVKC from a header via index lookup should return the\nfloat value of the card.", "start_line": 2816, "end_line": 2825, "is_async": false, "is_method": false}, {"name": "test_get_rvkc_by_keyword", "qualified_name": "test_get_rvkc_by_keyword", "args": ["self"], "decorators": [], "docstring": "Returning a RVKC just via the keyword name should return the full value\nstring of the first card with that keyword.\n\nThis test was changed to reflect the requirement in ticket\nhttps://aeon.stsci.edu/ssb/trac/pyfits/ticket/184--previously it required\n_test_header['DP1'] to return the parsed float val", "start_line": 2827, "end_line": 2837, "is_async": false, "is_method": false}, {"name": "test_get_rvkc_by_keyword_and_field_specifier", "qualified_name": "test_get_rvkc_by_keyword_and_field_specifier", "args": ["self"], "decorators": [], "docstring": "Returning a RVKC via the full keyword/field-specifier combination\nshould return the floating point value associated with the RVKC.", "start_line": 2839, "end_line": 2847, "is_async": false, "is_method": false}, {"name": "test_access_nonexistent_rvkc", "qualified_name": "test_access_nonexistent_rvkc", "args": ["self"], "decorators": [], "docstring": "Accessing a nonexistent RVKC should raise an IndexError for\nindex-based lookup, or a KeyError for keyword lookup (like a normal\ncard).", "start_line": 2849, "end_line": 2859, "is_async": false, "is_method": false}, {"name": "test_update_rvkc", "qualified_name": "test_update_rvkc", "args": ["self"], "decorators": [], "docstring": "A RVKC can be updated either via index or keyword access.", "start_line": 2861, "end_line": 2869, "is_async": false, "is_method": false}, {"name": "test_update_rvkc_2", "qualified_name": "test_update_rvkc_2", "args": ["self"], "decorators": [], "docstring": "Regression test for an issue that appeared after SVN r2412.", "start_line": 2871, "end_line": 2878, "is_async": false, "is_method": false}, {"name": "test_raw_keyword_value", "qualified_name": "test_raw_keyword_value", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2880, "end_line": 2891, "is_async": false, "is_method": false}, {"name": "test_rvkc_insert_after", "qualified_name": "test_rvkc_insert_after", "args": ["self"], "decorators": [], "docstring": "It should be possible to insert a new RVKC after an existing one\nspecified by the full keyword/field-specifier combination.", "start_line": 2893, "end_line": 2900, "is_async": false, "is_method": false}, {"name": "test_rvkc_delete", "qualified_name": "test_rvkc_delete", "args": ["self"], "decorators": [], "docstring": "Deleting a RVKC should work as with a normal card by using the full\nkeyword/field-spcifier combination.", "start_line": 2902, "end_line": 2921, "is_async": false, "is_method": false}, {"name": "test_pattern_matching_keys", "qualified_name": "test_pattern_matching_keys", "args": ["self"], "decorators": [], "docstring": "Test the keyword filter strings with RVKCs.", "start_line": 2923, "end_line": 2954, "is_async": false, "is_method": false}, {"name": "test_pattern_matching_key_deletion", "qualified_name": "test_pattern_matching_key_deletion", "args": ["self"], "decorators": [], "docstring": "Deletion by filter strings should work.", "start_line": 2956, "end_line": 2964, "is_async": false, "is_method": false}, {"name": "test_successive_pattern_matching", "qualified_name": "test_successive_pattern_matching", "args": ["self"], "decorators": [], "docstring": "A card list returned via a filter string should be further filterable.", "start_line": 2966, "end_line": 2987, "is_async": false, "is_method": false}, {"name": "test_rvkc_in_cardlist_keys", "qualified_name": "test_rvkc_in_cardlist_keys", "args": ["self"], "decorators": [], "docstring": "The CardList.keys() method should return full keyword/field-spec values\nfor RVKCs.", "start_line": 2989, "end_line": 2996, "is_async": false, "is_method": false}, {"name": "test_rvkc_in_cardlist_values", "qualified_name": "test_rvkc_in_cardlist_values", "args": ["self"], "decorators": [], "docstring": "The CardList.values() method should return the values of all RVKCs as\nfloating point values.", "start_line": 2998, "end_line": 3005, "is_async": false, "is_method": false}, {"name": "test_rvkc_value_attribute", "qualified_name": "test_rvkc_value_attribute", "args": ["self"], "decorators": [], "docstring": "Individual card values should be accessible by the .value attribute\n(which should return a float).", "start_line": 3007, "end_line": 3015, "is_async": false, "is_method": false}, {"name": "test_overly_permissive_parsing", "qualified_name": "test_overly_permissive_parsing", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/183\n\nEnsures that cards with standard commentary keywords are never treated\nas RVKCs.  Also ensures that cards not strictly matching the RVKC\npattern are not treated as such.", "start_line": 3017, "end_line": 3050, "is_async": false, "is_method": false}, {"name": "test_overly_aggressive_rvkc_lookup", "qualified_name": "test_overly_aggressive_rvkc_lookup", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/184\n\nEnsures that looking up a RVKC by keyword only (without the\nfield-specifier) in a header returns the full string value of that card\nwithout parsing it as a RVKC.  Also ensures that a full field-specifier\nis required to match a RV", "start_line": 3052, "end_line": 3075, "is_async": false, "is_method": false}, {"name": "test_fitsheader_script", "qualified_name": "test_fitsheader_script", "args": ["self"], "decorators": [], "docstring": "Tests the basic functionality of the `fitsheader` script.", "start_line": 3077, "end_line": 3115, "is_async": false, "is_method": false}, {"name": "test_fitsheader_compressed_from_primary_image_ext", "qualified_name": 