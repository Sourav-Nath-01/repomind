error"], "docstring": "Mixin to provide slicing on objects using the `NDData`\ninterface.\n\nThe ``data``, ``mask``, ``uncertainty`` and ``wcs`` will be sliced, if\nset and sliceable. The ``unit`` and ``meta`` will be untouched. The return\nwill be a reference and not a copy, if possible.\n\nExamples\n--------\nUsing this Mixin wi", "start_line": 13, "end_line": 136}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/nddata/mixins/ndio.py", "file_hash": "2da7ae81613ab2d812961ec7baf83f4c34c468502b85ccd64625b657b836854b", "imports": [{"module": "astropy.io", "names": ["registry"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "instance", "cls"], "decorators": [], "docstring": "", "start_line": 54, "end_line": 55, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 58, "end_line": 59, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "instance", "cls"], "decorators": [], "docstring": "", "start_line": 98, "end_line": 99, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 102, "end_line": 103, "is_async": false, "is_method": false}], "classes": [{"name": "NDDataRead", "bases": ["registry.UnifiedReadWrite"], "methods": ["__init__", "__call__"], "docstring": "Read and parse gridded N-dimensional data and return as an NDData-derived\nobject.\n\nThis function provides the NDDataBase interface to the astropy unified I/O\nlayer.  This allows easily reading a file in the supported data formats,\nfor example::\n\n  >>> from astropy.nddata import CCDData\n  >>> dat = C", "start_line": 11, "end_line": 59}, {"name": "NDDataWrite", "bases": ["registry.UnifiedReadWrite"], "methods": ["__init__", "__call__"], "docstring": "Write this CCDData object out in the specified format.\n\nThis function provides the NDData interface to the astropy unified I/O\nlayer.  This allows easily writing a file in many supported data formats\nusing syntax such as::\n\n  >>> from astropy.nddata import CCDData\n  >>> dat = CCDData(np.zeros((12, 1", "start_line": 62, "end_line": 103}, {"name": "NDIOMixin", "bases": [], "methods": [], "docstring": "Mixin class to connect NDData to the astropy input/output registry.\n\nThis mixin adds two methods to its subclasses, ``read`` and ``write``.", "start_line": 106, "end_line": 114}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/nddata/mixins/ndarithmetic.py", "file_hash": "b75dddf7259836f4293dd9fcde7e3bbcd11a30219a444d2a79d09452c6877efa", "imports": [{"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "copy", "names": ["deepcopy"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy.nddata.nduncertainty", "names": ["NDUncertainty"], "is_from": true, "alias": ""}, {"module": "astropy.units", "names": ["dimensionless_unscaled"], "is_from": true, "alias": ""}, {"module": "astropy.utils", "names": ["format_doc", "sharedmethod"], "is_from": true, "alias": ""}, {"module": "astropy.utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}, {"module": "astropy.utils.masked", "names": ["Masked"], "is_from": true, "alias": ""}], "functions": [{"name": "_arithmetic", "qualified_name": "_arithmetic", "args": ["self", "operation", "operand", "propagate_uncertainties", "handle_mask", "handle_meta", "uncertainty_correlation", "compare_wcs", "operation_ignores_mask", "axis"], "decorators": [], "docstring": "Base method which calculates the result of the arithmetic operation.\n\nThis method determines the result of the arithmetic operation on the\n``data`` including their units and then forwards to other methods\nto calculate the other properties for the result (like uncertainty).\n\nParameters\n----------\nope", "start_line": 166, "end_line": 352, "is_async": false, "is_method": false}, {"name": "_arithmetic_data", "qualified_name": "_arithmetic_data", "args": ["self", "operation", "operand"], "decorators": [], "docstring": "Calculate the resulting data.\n\nParameters\n----------\noperation : callable\n    see `NDArithmeticMixin._arithmetic` parameter description.\n\noperand : `NDData`-like instance\n    The second operand wrapped in an instance of the same class as\n    self.\n\nkwds :\n    Additional parameters.\n\nReturns\n-------\n", "start_line": 354, "end_line": 397, "is_async": false, "is_method": false}, {"name": "_arithmetic_uncertainty", "qualified_name": "_arithmetic_uncertainty", "args": ["self", "operation", "operand", "result", "correlation"], "decorators": [], "docstring": "Calculate the resulting uncertainty.\n\nParameters\n----------\noperation : callable\n    see :meth:`NDArithmeticMixin._arithmetic` parameter description.\n\noperand : `NDData`-like instance\n    The second operand wrapped in an instance of the same class as\n    self.\n\nresult : `~astropy.units.Quantity` or ", "start_line": 399, "end_line": 483, "is_async": false, "is_method": false}, {"name": "_arithmetic_mask", "qualified_name": "_arithmetic_mask", "args": ["self", "operation", "operand", "handle_mask", "axis"], "decorators": [], "docstring": "Calculate the resulting mask.\n\nThis is implemented as the piecewise ``or`` operation if both have a\nmask.\n\nParameters\n----------\noperation : callable\n    see :meth:`NDArithmeticMixin._arithmetic` parameter description.\n    By default, the ``operation`` will be ignored.\n\noperand : `NDData`-like insta", "start_line": 485, "end_line": 527, "is_async": false, "is_method": false}, {"name": "_arithmetic_wcs", "qualified_name": "_arithmetic_wcs", "args": ["self", "operation", "operand", "compare_wcs"], "decorators": [], "docstring": "Calculate the resulting wcs.\n\nThere is actually no calculation involved but it is a good place to\ncompare wcs information of both operands. This is currently not working\nproperly with `~astropy.wcs.WCS` (which is the suggested class for\nstoring as wcs property) but it will not break it neither.\n\nPar", "start_line": 529, "end_line": 573, "is_async": false, "is_method": false}, {"name": "_arithmetic_meta", "qualified_name": "_arithmetic_meta", "args": ["self", "operation", "operand", "handle_meta"], "decorators": [], "docstring": "Calculate the resulting meta.\n\nParameters\n----------\noperation : callable\n    see :meth:`NDArithmeticMixin._arithmetic` parameter description.\n    By default, the ``operation`` will be ignored.\n\noperand : `NDData`-like instance\n    The second operand wrapped in an instance of the same class as\n    s", "start_line": 575, "end_line": 601, "is_async": false, "is_method": false}, {"name": "add", "qualified_name": "add", "args": ["self", "operand", "operand2"], "decorators": ["sharedmethod", "format_doc(_arit_doc, name='addition', op='+')"], "docstring": "", "start_line": 605, "end_line": 606, "is_async": false, "is_method": false}, {"name": "subtract", "qualified_name": "subtract", "args": ["self", "operand", "operand2"], "decorators": ["sharedmethod", "format_doc(_arit_doc, name='subtraction', op='-')"], "docstring": "", "start_line": 610, "end_line": 613, "is_async": false, "is_method": false}, {"name": "multiply", "qualified_name": "multiply", "args": ["self", "operand", "operand2"], "decorators": ["sharedmethod", "format_doc(_arit_doc, name='multiplication', op='*')"], "docstring": "", "start_line": 617, "end_line": 620, "is_async": false, "is_method": false}, {"name": "divide", "qualified_name": "divide", "args": ["self", "operand", "operand2"], "decorators": ["sharedmethod", "format_doc(_arit_doc, name='division', op='/')"], "docstring": "", "start_line": 624, "end_line": 627, "is_async": false, "is_method": false}, {"name": "sum", "qualified_nam