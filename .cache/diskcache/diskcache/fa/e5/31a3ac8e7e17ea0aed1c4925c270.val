ts", "args": ["self"], "decorators": ["property"], "docstring": "Output units. ", "start_line": 293, "end_line": 295, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "lon", "lat", "lon_pole"], "decorators": [], "docstring": "", "start_line": 297, "end_line": 298, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["self", "alpha_C", "delta_C", "lon", "lat", "lon_pole"], "decorators": [], "docstring": "Parameters\n----------\nalpha_C, delta_C : float (deg) or `~astropy.units.Quantity`\n    Angles in the Celestial coordinate frame.\nlon, lat, lon_pole : float (deg) or `~astropy.units.Quantity`\n    Parameter values when the model was initialized.\n\nReturns\n-------\nphi_N, theta_N : float (deg) or `~astrop", "start_line": 300, "end_line": 325, "is_async": false, "is_method": false}, {"name": "inverse", "qualified_name": "inverse", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 328, "end_line": 329, "is_async": false, "is_method": false}, {"name": "inverse", "qualified_name": "inverse", "args": ["self"], "decorators": ["property"], "docstring": "Inverse rotation.", "start_line": 355, "end_line": 358, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["cls", "x", "y", "angle"], "decorators": ["classmethod"], "docstring": "Rotate (x, y) about ``angle``.\n\nParameters\n----------\nx, y : ndarray-like\n    Input quantities\nangle : float (deg) or `~astropy.units.Quantity`\n    Angle of rotations.", "start_line": 361, "end_line": 393, "is_async": false, "is_method": false}, {"name": "_compute_matrix", "qualified_name": "_compute_matrix", "args": ["angle"], "decorators": ["staticmethod"], "docstring": "", "start_line": 396, "end_line": 399, "is_async": false, "is_method": false}], "classes": [{"name": "_EulerRotation", "bases": [], "methods": ["_create_matrix", "spherical2cartesian", "cartesian2spherical", "rotation_matrix_from_angle", "evaluate", "input_units", "return_units"], "docstring": "Base class which does the actual computation.", "start_line": 37, "end_line": 111}, {"name": "EulerAngleRotation", "bases": ["_EulerRotation", "Model"], "methods": ["__init__", "inverse", "evaluate"], "docstring": "Implements Euler angle intrinsic rotations.\n\nRotates one coordinate system into another (fixed) coordinate system.\nAll coordinate systems are right-handed. The sign of the angles is\ndetermined by the right-hand rule..\n\nParameters\n----------\nphi, theta, psi : float or `~astropy.units.Quantity`\n    \"p", "start_line": 114, "end_line": 164}, {"name": "_SkyRotation", "bases": ["_EulerRotation", "Model"], "methods": ["__init__", "_evaluate"], "docstring": "Base class for RotateNative2Celestial and RotateCelestial2Native.", "start_line": 167, "end_line": 191}, {"name": "RotateNative2Celestial", "bases": ["_SkyRotation"], "methods": ["input_units", "return_units", "__init__", "evaluate", "inverse"], "docstring": "Transform from Native to Celestial Spherical Coordinates.\n\nParameters\n----------\nlon : float or or `~astropy.units.Quantity`\n    Celestial longitude of the fiducial point.\nlat : float or or `~astropy.units.Quantity`\n    Celestial latitude of the fiducial point.\nlon_pole : float or or `~astropy.units", "start_line": 194, "end_line": 260}, {"name": "RotateCelestial2Native", "bases": ["_SkyRotation"], "methods": ["input_units", "return_units", "__init__", "evaluate", "inverse"], "docstring": "Transform from Celestial to Native Spherical Coordinates.\n\nParameters\n----------\nlon : float or or `~astropy.units.Quantity`\n    Celestial longitude of the fiducial point.\nlat : float or or `~astropy.units.Quantity`\n    Celestial latitude of the fiducial point.\nlon_pole : float or or `~astropy.units", "start_line": 263, "end_line": 329}, {"name": "Rotation2D", "bases": ["Model"], "methods": ["inverse", "evaluate", "_compute_matrix"], "docstring": "Perform a 2D rotation given an angle.\n\nPositive angles represent a counter-clockwise rotation and vice-versa.\n\nParameters\n----------\nangle : float or `~astropy.units.Quantity`\n    Angle of rotation (if float it should be in deg).", "start_line": 332, "end_line": 399}], "calls": [], "module_docstring": "Implements rotations, including spherical rotations as defined in WCS Paper II\n[1]_\n\n`RotateNative2Celestial` and `RotateCelestial2Native` follow the convention in\nWCS Paper II to rotate to/from a native sphere and the celestial sphere.\n\nThe implementation uses `EulerAngleRotation`. The model parameters are\nthree angles: the longitude (``lon``) and latitude (``lat``) of the fiducial point\nin the celestial system (``CRVAL`` keywords in FITS), and the longitude of the celestial\npole in the native system (``lon_pole``). The Euler angles are ``lon+90``, ``90-lat``\nand ``-(lon_pole-90)``.\n\n\nReferences\n----------\n.. [1] Calabretta, M.R., Greisen, E.W., 2002, A&A, 395, 1077 (Paper II)", "parse_error": ""}, {"file_path": "astropy/modeling/tabular.py", "file_hash": "00b7e4aa1e91a0180bf2b2538d2c2ac6c46e3bdbdfefaddef203c2bfc93f8bd3", "imports": [{"module": "abc", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "core", "names": ["Model"], "is_from": true, "alias": ""}, {"module": "", "names": ["units"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["minversion"], "is_from": true, "alias": ""}, {"module": "scipy", "names": [], "is_from": false, "alias": ""}, {"module": "scipy.interpolate", "names": ["interpn"], "is_from": true, "alias": ""}], "functions": [{"name": "tabular_model", "qualified_name": "tabular_model", "args": ["dim", "name"], "decorators": [], "docstring": "Make a ``Tabular`` model where ``n_inputs`` is\nbased on the dimension of the lookup_table.\n\nThis model has to be further initialized and when evaluated\nreturns the interpolated values.\n\nParameters\n----------\ndim : int\n    Dimensions of the lookup table.\nname : str\n    Name for the class.\n\nExamples\n-", "start_line": 235, "end_line": 291, "is_async": false, "is_method": false}, {"name": "lookup_table", "qualified_name": "lookup_table", "args": ["self"], "decorators": ["property", "abc.abstractmethod"], "docstring": "", "start_line": 91, "end_line": 92, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "points", "lookup_table", "method", "bounds_error", "fill_value"], "decorators": [], "docstring": "", "start_line": 98, "end_line": 141, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 143, "end_line": 146, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 148, "end_line": 166, "is_async": false, "is_method": false}, {"name": "input_units", "qualified_name": "input_units", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 169, "end_line": 174, "is_async": false, "is_method": false}, {"name": "return_units", "qualified_name": "return_units", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 177, "end_line": 181, "is_async": false, "is_method": false}, {"name": "bounding_box", "qualified_name": "bounding_box", "args": ["self"], "decorators": ["property"], "docstring": "Tuple defining the default ``bounding_box`` limits,\n``(points_low, points_high)``.\n\nExamples\n--------\n>>> from astropy.modeling.models import Tabular1D, Tabular2D\n>>> t1 = Tabular1D(points=[1, 2, 3], lookup_table=[10, 20, 30])\n>>> t1.bounding_box\n(1, 3)\n>>> t2 = Tabular2D(points=[[1, 2, 3], [2, 3, 4", "start_line": 184, "end_line": 204, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["self"], "decorators": [], "docstring": "Return the interpolated values at the input coordinates.\n\nParameters\n----------\ninputs : list of scalars or ndarrays\n    Input coordinates. The number of inputs must be equal\n    to the dimensions of the lookup table.", "start_line": 206, "end_line": 232, "is_async": false, "is_method": false}], "classes": [{"name": "_Tabular", "bases": ["Model"], "methods": ["lookup_table", "__init__", "__repr__", "__str__", "input_units", "return_units", "bounding_box", "evaluate"], "docstring": "Returns an interpolated lookup table value.\n\nParameters\n----------\npoints : tuple of ndarray of float, with shapes (m1, ), ..., (mn, ), optional\n    The points defining the regular grid in n dimensions.\nlookup_table : array-like, shape (m1, ..., mn, ...)\n    The data on a regular grid in n dimension", "start_line": 42, "end_line": 232}], "calls": [], "module_docstring": "Tabular models.\n\nTabular models of any dimension can be created using `tabular_model`.\nFor convenience `Tabular1D` and `Tabular2D` are provided.\n\nExamples\n--------\n>>> table = np.array([[ 3.,  0.,  0.],\n...                  [ 0.,  2.,  0.],\n...                  [ 0.,  0.,  0.]])\n>>> points = ([1, 2, 3], [1, 2, 3])\n>>> t2 = Tabular2D(points, lookup_table=table, bounds_error=False,\n...                fill_value=None, method='nearest')", "parse_error": ""}, {"file_path": "astropy/modeling/optimizers.py", "file_hash": "82fe5a1cfc7144462f126d80c6745462501540bc79fb6c997e9ed96d5d8e6e7b", "imports": [{"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "abc", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}, {"module": "scipy.optimize", "names": ["fmin_slsqp"], "is_from": true, "alias": ""}, {"module": "scipy.optimize", "names": ["fmin"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "opt_method"], "decorators": [], "docstring": "", "start_line": 45, "end_line": 49, "is_async": false, "is_method": false}, {"name": "maxiter", "qualified_name": "maxiter", "args": ["self"], "decorators": ["property"], "docstring": "Maximum number of iterations", "start_line": 52, "end_line": 54, "is_async": false, "is_method": false}, {"name": "maxiter", "qualified_name": "maxiter", "args": ["self", "val"], "decorators": ["maxiter.setter"], "docstring": "Set maxiter", "start_line": 57, "end_line": 59, "is_async": false, "is_method": false}, {"name": "eps", "qualified_name": "eps", "args": ["self"], "decorators": ["property"], "docstring": "Step for the forward difference approximation of the Jacobian", "start_line": 62, "end_line": 64, "is_async": false, "is_method": false}, {"name": "eps", "qualified_name": "eps", "args": ["self", "val"], "decorators": ["eps.setter"], "docstring": "Set eps value", "start_line": 67, "end_line": 69, "is_async": false, "is_method": false}, {"name": "acc", "qualified_name": "acc", "args": ["self"], "decorators": ["property"], "docstring": "Requested accuracy", "start_line": 72, "end_line": 74, "is_async": false, "is_method": false}, {"name": "acc", "qualified_name": "acc", "args": ["self", "val"], "decorators": ["acc.setter"], "docstring": "Set accuracy", "start_line": 77, "end_line": 79, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 81, "end_line": 83, "is_async": false, "is_method": false}, {"name": "opt_method", "qualified_name": "opt_method", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 86, "end_line": 87, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self"], "decorators": ["abc.abstractmethod"], "docstring": "", "start_line": 90, "end_line": 91, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 108, "end_line": 116, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "objfunc", "initval", "fargs"], "decorators": [], "docstring": "Run the solver.\n\nParameters\n----------\nobjfunc : callable\n    objection function\ninitval : iterable\n    initial guess for the parameter values\nfargs : tuple\n    other arguments to be passed to the statistic function\nkwargs : dict\n    other keyword arguments to be passed to the solver", "start_line": 118, "end_line": 172, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 190, "end_line": 198, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "objfunc", "initval", "fargs"], "decorators": [], "docstring": "Run the solver.\n\nParameters\n----------\nobjfunc : callable\n    objection function\ninitval : iterable\n    initial guess for the parameter values\nfargs : tuple\n    other arguments to be passed to the statistic function\nkwargs : dict\n    other keyword arguments to be passed to the solver", "start_line": 200, "end_line": 242, "is_async": false, "is_method": false}], "classes": [{"name": "Optimization", "bases": [], "methods": ["__init__", "maxiter", "maxiter", "eps", "eps", "acc", "acc", "__repr__", "opt_method", "__call__"], "docstring": "Base class for optimizers.\n\nParameters\n----------\nopt_method : callable\n    Implements optimization method\n\nNotes\n-----\nThe base Optimizer does not support any constraints by default; individual\noptimizers should explicitly set this list to the specific constraints\nit supports.", "start_line": 26, "end_line": 91}, {"name": "SLSQP", "bases": ["Optimization"], "methods": ["__init__", "__call__"], "docstring": "Sequential Least Squares Programming optimization algorithm.\n\nThe algorithm is described in [1]_. It supports tied and fixed\nparameters, as well as bounded constraints. Uses\n`scipy.optimize.fmin_slsqp`.\n\nReferences\n----------\n.. [1] http://www.netlib.org/toms/733", "start_line": 94, "end_line": 172}, {"name": "Simplex", "bases": ["Optimization"], "methods": ["__init__", "__call__"], "docstring": "Neald-Mead (downhill simplex) algorithm.\n\nThis algorithm [1]_ only uses function values, not derivatives.\nUses `scipy.optimize.fmin`.\n\nReferences\n----------\n.. [1] Nelder, J.A. and Mead, R. (1965), \"A simplex method for function\n   minimization\", The Computer Journal, 7, pp. 308-313", "start_line": 175, "end_line": 242}], "calls": [], "module_docstring": "Optimization algorithms used in `~astropy.modeling.fitting`.", "parse_error": ""}, {"file_path": "astropy/modeling/core.py", "file_hash": "21dc2fce6c0e2c76e36ee1062d4fbd59041ddb97877d3a8d303a9dbe75302e06", "imports": [{"module": "abc", "names": [], "is_from": false, "alias": ""}, {"module": "copy", "names": [], "is_from": false, "alias": ""}, {"module": "copyreg", "names": [], "is_from": false, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "functools", "names": [], "is_from": false, "alias": ""}, {"module": "operator", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "types", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "collections", "names": ["defaultdict", "OrderedDict"], "is_from": true, "alias": ""}, {"module": "contextlib", "names": ["suppress"], "is_from": true, "alias": ""}, {"module": "inspect", "names": ["signature"], "is_from": true, "alias": ""}, {"module": "itertools", "names": ["chain", "islice"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "utils", "names": ["inde