cstring": "", "start_line": 1033, "end_line": 1043, "is_async": false, "is_method": false}, {"name": "test_update_from_dict", "qualified_name": "test_update_from_dict", "args": ["self"], "decorators": [], "docstring": "Test adding new cards and updating existing cards from a dict using\nHeader.update()", "start_line": 1045, "end_line": 1066, "is_async": false, "is_method": false}, {"name": "test_update_from_iterable", "qualified_name": "test_update_from_iterable", "args": ["self"], "decorators": [], "docstring": "Test adding new cards and updating existing cards from an iterable of\ncards and card tuples.", "start_line": 1068, "end_line": 1080, "is_async": false, "is_method": false}, {"name": "test_header_extend", "qualified_name": "test_header_extend", "args": ["self"], "decorators": [], "docstring": "Test extending a header both with and without stripping cards from the\nextension header.", "start_line": 1082, "end_line": 1107, "is_async": false, "is_method": false}, {"name": "test_header_extend_unique", "qualified_name": "test_header_extend_unique", "args": ["self"], "decorators": [], "docstring": "Test extending the header with and without unique=True.", "start_line": 1109, "end_line": 1128, "is_async": false, "is_method": false}, {"name": "test_header_extend_unique_commentary", "qualified_name": "test_header_extend_unique_commentary", "args": ["self"], "decorators": [], "docstring": "Test extending header with and without unique=True and commentary\ncards in the header being added. Issue astropy/astropy#3967", "start_line": 1130, "end_line": 1144, "is_async": false, "is_method": false}, {"name": "test_header_extend_update", "qualified_name": "test_header_extend_update", "args": ["self"], "decorators": [], "docstring": "Test extending the header with and without update=True.", "start_line": 1146, "end_line": 1175, "is_async": false, "is_method": false}, {"name": "test_header_extend_update_commentary", "qualified_name": "test_header_extend_update_commentary", "args": ["self"], "decorators": [], "docstring": "Test extending header with and without unique=True and commentary\ncards in the header being added.\n\nThough not quite the same as astropy/astropy#3967, update=True hits\nthe same if statement as that issue.", "start_line": 1177, "end_line": 1194, "is_async": false, "is_method": false}, {"name": "test_header_extend_exact", "qualified_name": "test_header_extend_exact", "args": ["self"], "decorators": [], "docstring": "Test that extending an empty header with the contents of an existing\nheader can exactly duplicate that header, given strip=False and\nend=True.", "start_line": 1196, "end_line": 1206, "is_async": false, "is_method": false}, {"name": "test_header_count", "qualified_name": "test_header_count", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1208, "end_line": 1216, "is_async": false, "is_method": false}, {"name": "test_header_append_use_blanks", "qualified_name": "test_header_append_use_blanks", "args": ["self"], "decorators": [], "docstring": "Tests that blank cards can be appended, and that future appends will\nuse blank cards when available (unless useblanks=False)", "start_line": 1218, "end_line": 1243, "is_async": false, "is_method": false}, {"name": "test_header_append_keyword_only", "qualified_name": "test_header_append_keyword_only", "args": ["self"], "decorators": [], "docstring": "Test appending a new card with just the keyword, and no value or\ncomment given.", "start_line": 1245, "end_line": 1266, "is_async": false, "is_method": false}, {"name": "test_header_insert_use_blanks", "qualified_name": "test_header_insert_use_blanks", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1268, "end_line": 1286, "is_async": false, "is_method": false}, {"name": "test_header_insert_before_keyword", "qualified_name": "test_header_insert_before_keyword", "args": ["self"], "decorators": [], "docstring": "Test that a keyword name or tuple can be used to insert new keywords.\n\nAlso tests the ``after`` keyword argument.\n\nRegression test for https://github.com/spacetelescope/PyFITS/issues/12", "start_line": 1288, "end_line": 1323, "is_async": false, "is_method": false}, {"name": "test_remove", "qualified_name": "test_remove", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1325, "end_line": 1350, "is_async": false, "is_method": false}, {"name": "test_header_comments", "qualified_name": "test_header_comments", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1352, "end_line": 1356, "is_async": false, "is_method": false}, {"name": "test_comment_slices_and_filters", "qualified_name": "test_comment_slices_and_filters", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1358, "end_line": 1366, "is_async": false, "is_method": false}, {"name": "test_comment_slice_filter_assign", "qualified_name": "test_comment_slice_filter_assign", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1368, "end_line": 1381, "is_async": false, "is_method": false}, {"name": "test_commentary_slicing", "qualified_name": "test_commentary_slicing", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1383, "end_line": 1412, "is_async": false, "is_method": false}, {"name": "test_update_commentary", "qualified_name": "test_update_commentary", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1414, "end_line": 1434, "is_async": false, "is_method": false}, {"name": "test_commentary_comparison", "qualified_name": "test_commentary_comparison", "args": ["self"], "decorators": [], "docstring": "Regression test for an issue found in *writing* the regression test for\nhttps://github.com/astropy/astropy/issues/2363, where comparison of\nthe list of values for a commentary keyword did not always compare\ncorrectly with other iterables.", "start_line": 1436, "end_line": 1450, "is_async": false, "is_method": false}, {"name": "test_long_commentary_card", "qualified_name": "test_long_commentary_card", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1452, "end_line": 1487, "is_async": false, "is_method": false}, {"name": "test_totxtfile", "qualified_name": "test_totxtfile", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1489, "end_line": 1516, "is_async": false, "is_method": false}, {"name": "test_header_fromtextfile", "qualified_name": "test_header_fromtextfile", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/122\n\nManually write a text file containing some header cards ending with\nnewlines and ensure that fromtextfile can read them back in.", "start_line": 1518, "end_line": 1534, "is_async": false, "is_method": false}, {"name": "test_header_fromtextfile_with_end_card", "qualified_name": "test_header_fromtextfile_with_end_card", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/154\n\nMake sure that when a Header is read from a text file that the END card\nis ignored.", "start_line": 1536, "end_line": 1556, "is_async": false, "is_method": false}, {"name": "test_append_end_card", "qualified_name": "test_append_end_card", "args": ["self"], "decorators": [], "docstring": "Regression test 2 for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/154\n\nManually adding an END card to a header should simply result in a\nValueError (as was the case in PyFITS 3.0 and earlier).", "start_line": 1558, "end_line": 1575, "is_async": false, "is_method": false}, {"name": "test_invalid_end_cards", "qualified_name": "test_invalid_end_cards", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/217\n\nThis tests the case where the END card looks like a normal card like\n'END = ' and other similar oddities.  As long as a card starts with END\nand looks like it was intended to be the END card we allow it, but with\na warning.", "start_line": 1577, "end_line": 1648, "is_async": false, "is_method": false}, {"name": "test_invalid_characters", "qualified_name": "test_invalid_characters", "args": ["self"], "decorators": [], "docstring": "Test header with invalid characters", "start_line": 1650, "end_line": 1675, "is_async": false, "is_method": false}, {"name": "test_unnecessary_move", "qualified_name": "test_unnecessary_move", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/125\n\nEnsures that a header is not modified when setting the position of a\nkeyword that's already in its correct position.", "start_line": 1677, "end_line": 1715, "is_async": false, "is_method": false}, {"name": "test_invalid_float_cards", "qualified_name": "test_invalid_float_cards", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/137", "start_line": 1717, "end_line": 1761, "is_async": false, "is_method": false}, {"name": "test_invalid_float_cards2", "qualified_name": "test_invalid_float_cards2", "args": ["self", "capsys"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/140", "start_line": 1763, "end_line": 1789, "is_async": false, "is_method": false}, {"name": "test_leading_zeros", "qualified_name": "test_leading_zeros", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/137, part 2\n\nTicket https://aeon.stsci.edu/ssb/trac/pyfits/ticket/137 also showed that in\nfloat values like 0.001 the leading zero was unnecessarily being\nstripped off when rewriting the header.  Though leading zeros should be\nremoved", "start_line": 1791, "end_line": 1811, "is_async": false, "is_method": false}, {"name": "test_assign_boolean", "qualified_name": "test_assign_boolean", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/123\n\nTests assigning Python and Numpy boolean values to keyword values.", "start_line": 1813, "end_line": 1844, "is_async": false, "is_method": false}, {"name": "test_header_method_keyword_normalization", "qualified_name": "test_header_method_keyword_normalization", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/149\n\nBasically ensures that all public Header methods are case-insensitive\nw.r.t. keywords.\n\nProvides a reasonably comprehensive test of several methods at once.", "start_line": 1846, "end_line": 1901, "is_async": false, "is_method": false}, {"name": "test_end_in_comment", "qualified_name": "test_end_in_comment", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/142\n\nTests a case where the comment of a card ends with END, and is followed\nby several blank cards.", "start_line": 1903, "end_line": 1941, "is_async": false, "is_method": false}, {"name": "test_assign_unicode", "qualified_name": "test_assign_unicode", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/134\n\nAssigning a unicode literal as a header value should not fail silently.\nIf the value can be converted to ASCII then it should just work.\nOtherwise it should fail with an appropriate value error.\n\nAlso tests unicode for keywords a", "start_line": 1943, "end_line": 1978, "is_async": false, "is_method": false}, {"name": "test_assign_non_ascii", "qualified_name": "test_assign_non_ascii", "args": ["self"], "decorators": [], "docstring": "First regression test for\nhttps://github.com/spacetelescope/PyFITS/issues/37\n\nAlthough test_assign_unicode ensures that `str` objects containing\nnon-ASCII characters cannot be assigned to headers.\n\nIt should not be possible to assign bytes to a header at all.", "start_line": 1980, "end_line": 1994, "is_async": false, "is_method": false}, {"name": "test_header_strip_whitespace", "qualified_name": "test_header_strip_whitespace", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/146, and\nfor the solution that is optional stripping of whitespace from the end\nof a header value.\n\nBy default extra whitespace is stripped off, but if\n`fits.conf.strip_header_whitespace` = False it should not be\nstripped.", "start_line": 1996, "end_line": 2025, "is_async": false, "is_method": false}, {"name": "test_keep_duplicate_history_in_orig_header", "qualified_name": "test_keep_duplicate_history_in_orig_header", "args": ["self"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/156\n\nWhen creating a new HDU from an existing Header read from an existing\nFITS file, if the origianl header contains duplicate HISTORY values\nthose duplicates should be preserved just as in the original header.\n\nThis bug occurred due", "start_line": 2027, "end_line": 2058, "is_async": false, "is_method": false}, {"name": "test_invalid_keyword_cards", "qualified_name": "test_invalid_keyword_cards", "args": ["self"], "decorators": [], "docstring": "Test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/109\n\nAllow opening files with headers containing invalid keywords.", "start_line": 2060, "end_line": 2100, "is_async": false, "is_method": false}, {"name": "test_fix_hierarch_with_invalid_value", "qualified_name": "test_fix_hierarch_with_invalid_value", "args": ["self", "capsys"], "decorators": [], "docstring": "Regression test for https://aeon.stsci.edu/ssb/trac/pyfits/ticket/172\n\nEnsures that when fixing a hierarch card it remains a hierarch card.", "start_line": 2102, "end_line": 2111, "is_async": false, "is_method": false}, {"name": "test_assign_inf_nan", "qualified_name": "test_assign_inf_nan", "args": ["self"], "decorators": [], "docstring": "Regression test for https://github.com/spacetelescope/PyFITS/issues/11\n\nFor the time being it should not be possible to assign the floating\npoint values inf or nan to a header value, since this is not defined by\nthe FITS standard.", "start_line": 2113, "end_line": 2126, "is_async": false, "is_method": false}, {"name": "test_update_bool", "qualified_name": "test_update_bool", "args": ["self"], "decorators": [], "docstring": "Regression test for an issue where a value of True in a header\ncannot be updated to a value of 1, and likewise for False/0.", "start_line": 2128, "end_line": 2154, "is_async": false, "is_method": false}, {"name": "test_update_numeric", "qualified_name": "test_update_numeric", "args": ["self"], "decorators": [], "docstring": "Regression test for https://github.com/spacetelescope/PyFITS/issues/49\n\nEnsure that numeric values can be upcast/downcast between int, float,\nand complex by assigning values that compare equal to the existing\nvalue but are a different type.", "start_line": 2156, "end_line": 2229, "is_async": false, "is_method": false}, {"name": "test_newlines_in_commentary", "qualified_name": "test_newlines_in_commentary", "args": ["self"], "decorators": [], "docstring": "Regression test for https://github.com/spacetelescope/PyFITS/issues/51\n\nTest data extracted from a header in an actual FITS file found in the\nwild.  Names have been changed to protect the innocent.", "start_line": 2231, "end_line": 2268, "is_async": false, "is_method": false}, {"name": "setup", "qualified_name": "setup", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2281, "end_line": 2291, "is_async": false, "is_method": false}, {"name": "test_initialize_rvkc", "qualified_name": "test_initialize_rvkc", "args": ["self"], "decorators": [], "docstring": "Test different methods for initializing a card that should be\nrecognized as a RVKC", "start_line": 2293, "end_line": 2344, "is_async": false, "is_method": false}, {"name": "test_parse_field_specifier", "qualified_name": "test_parse_field_specifier", "args": ["self"], "decorators": [], "docstring": "Tests that the field_specifier can accessed from a card read from a\nstring before any other attributes are accessed.", "start_line": 2346, "end_line": 2356, "is_async": false, "is_method": false}, {"name": "test_update_field_specifier", "qualified_name": "test_update_field_specifier", "args": ["self"], "decorators": [], "docstring": "Test setting the field_specifier attribute and updating the card image\nto reflect the new value.", "start_line": 2358, "end_line": 2371, "is_async": false, "is_method": false}, {"name": "test_field_specifier_case_senstivity", "qualified_name": "test_field_specifier_case_senstivity", "args": ["self"], "decorators": [], "docstring": "The keyword portion of an RVKC should still be case-insensitive, but\nthe field-specifier portion should be case-sensitive.", "start_line": 2373, "end_line": 2386, "is_async": false, "is_method": false}, {"name": "test_get_rvkc_by_index", "qualified_name": "test_get_rvkc_by_index", "args": ["self"], "decorators": [], "docstring": "Returning a RVKC from a header via index lookup should return the\nfloat value of the card.", "start_line": 2388, "end_line": 2397, "is_async": false, "is_method": false}, {"name": "test_get_rvkc_by_keyword", "qualified_name": "test_get_rvkc_by_keyword", "args": ["self"], "decorators": [], "docstring": "Returning a RVKC just via the keyword name should return the full value\nstring of the first card with that keyword.\n\nThis test was changed to reflect the requirement in ticket\nhttps://aeon.stsci.edu/ssb/trac/pyfits/ticket/184--previously it required\n_test_header['DP1'] to return the parsed float val", "start_line": 2399, "end_line": 2409, "is_async": false, "is_method": false}, {"name": "test_get_rvkc_by_keyword_and_field_specifier", "qualified_name": "test_get_rvkc_by_keyword_and_field_specifier", "args": ["self"], "decorators": [], "docstring": "Returning a RVKC via the full keyword/field-specifier combination\nshould return the floating point value associated with the 