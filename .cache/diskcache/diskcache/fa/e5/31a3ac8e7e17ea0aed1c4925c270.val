defined here.\n\nThe fixtures can not be defined in the modules that use them, because\nthose modules are imported twice: once with `from __future__ import\nunicode_literals` and once without.  py.test complains when the same\nfixtures are defined more than once.\n\n`conftest.py` is a \"special\" module name for py.test that is always\nimported, but is not looked in for tests, and it is the recommended\nplace to put fixtures that are shared between modules.  These fixtures\ncan not be defined in a module by a different name and still be shared\nbetween modules.", "parse_error": ""}, {"file_path": "astropy/table/tests/test_item_access.py", "file_hash": "fca2a1c0ce557eb20e64d1e3610e61d2c70c2ef7cc570f7d0cbba5867ceb8cd0", "imports": [{"module": "pytest", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}], "functions": [{"name": "test_by_name", "qualified_name": "test_by_name", "args": ["self", "table_data"], "decorators": [], "docstring": "Access TableColumns by name and show that item access returns\na Column that refers to underlying table data", "start_line": 20, "end_line": 36, "is_async": false, "is_method": false}, {"name": "test_by_position", "qualified_name": "test_by_position", "args": ["self", "table_data"], "decorators": [], "docstring": "Access TableColumns by position and show that item access returns\na Column that refers to underlying table data", "start_line": 38, "end_line": 56, "is_async": false, "is_method": false}, {"name": "test_mult_columns", "qualified_name": "test_mult_columns", "args": ["self", "table_data"], "decorators": [], "docstring": "Access TableColumns with \"fancy indexing\" and showed that returned\nTableColumns object still references original data", "start_line": 58, "end_line": 72, "is_async": false, "is_method": false}, {"name": "test_column_slice", "qualified_name": "test_column_slice", "args": ["self", "table_data"], "decorators": [], "docstring": "Access TableColumns w