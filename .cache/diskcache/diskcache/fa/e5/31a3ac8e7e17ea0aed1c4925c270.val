at32') into one of the two character Numpy format codes\nthat have been traditionally used by Astropy.\n\nIn particular, use of 'a' to refer to character data is long since\ndeprecated in Numpy, but Astropy rema", "start_line": 2318, "end_line": 2340, "is_async": false, "is_method": false}, {"name": "_convert_format", "qualified_name": "_convert_format", "args": ["format", "reverse"], "decorators": [], "docstring": "Convert FITS format spec to record format spec.  Do the opposite if\nreverse=True.", "start_line": 2343, "end_line": 2352, "is_async": false, "is_method": false}, {"name": "_convert_ascii_format", "qualified_name": "_convert_ascii_format", "args": ["format", "reverse"], "decorators": [], "docstring": "Convert ASCII table format spec to record format spec.", "start_line": 2355, "end_line": 2404, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "hdu", "field"], "decorators": [], "docstring": "", "start_line": 139, "end_line": 141, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "key"], "decorators": [], "docstring": "", "start_line": 143, "end_line": 148, "is_async": false, "is_method": false}, {"name": "__eq__", "qualified_name": "__eq__", "args": ["self", "other"], "decorators": [], "docstring": "", "start_line": 157, "end_line": 170, "is_async": false, "is_method": false}, {"name": "__hash__", "qualified_name": "__hash__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 172, "end_line": 173, "is_async": false, "is_method": false}, {"name": "dtype", "qualified_name": "dtype", "args": ["self"], "decorators": ["lazyproperty"], "docstring": "The Numpy dtype object created from the format's associated recformat.", "start_line": 176, "end_line": 181, "is_async": false, "is_method": false}, {"name": "from_column_format", "qualified_name": "from_column_format", "args": ["cls", "format"], "decorators": ["classmethod"], "