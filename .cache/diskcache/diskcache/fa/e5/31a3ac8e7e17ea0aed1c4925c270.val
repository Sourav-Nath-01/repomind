ied_name": "__array_prepare__", "args": ["self", "array", "context"], "decorators": [], "docstring": "This ensures that a masked array is returned if self is masked.", "start_line": 242, "end_line": 249, "is_async": false, "is_method": false}, {"name": "convert_unit_to", "qualified_name": "convert_unit_to", "args": ["self", "unit", "equivalencies"], "decorators": [], "docstring": "Returns a new `NDData` object whose values have been converted\nto a new unit.\n\nParameters\n----------\nunit : `astropy.units.UnitBase` instance or str\n    The unit to convert to.\n\nequivalencies : list of equivalence pairs, optional\n   A list of equivalence pairs to try if the units are not\n   directly", "start_line": 251, "end_line": 296, "is_async": false, "is_method": false}], "classes": [{"name": "NDDataArray", "bases": ["NDArithmeticMixin", "NDSlicingMixin", "NDIOMixin", "NDData"], "methods": ["__init__", "uncertainty", "uncertainty", "unit", "unit", "mask", "mask", "shape", "size", "dtype", "ndim", "flags", "flags", "__array__", "__array_prepare__", "convert_unit_to"], "docstring": "An ``NDData`` object with arithmetic. This class is functionally equivalent\nto ``NDData`` in astropy  versions prior to 1.0.\n\nThe key distinction from raw numpy arrays is the presence of\nadditional metadata such as uncertainties, a mask, units, flags,\nand/or a coordinate system.\n\nParameters\n--------", "start_line": 22, "end_line": 296}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/nddata/__init__.py", "file_hash": "045b64842f3bb755954f51b9fdf1e64827c72e9ed6fd940fbbe84078cb092254", "imports": [{"module": "nddata", "names": ["*"], "is_from": true, "alias": ""}, {"module": "nddata_base", "names": ["*"], "is_from": true, "alias": ""}, {"module": "nddata_withmixins", "names": ["*"], "is_from": true, "alias": ""}, {"module": "nduncertainty", "names": ["*"], "is_from": true, "alias": ""}, {"module": "flag_collection", "names": ["*"], "is_from": true, "alias": ""}, {"module": "decorators", "names": ["*"], "is_from": true, "alias": ""}, {"module": "mixins.ndarithmetic", "names": ["*"], "is_from": true, "alias": ""}, {"module": "mixins.ndslicing", "names": ["*"], "is_from": true, "alias": ""}, {"module": "mixins.ndio", "names": ["*"], "is_from": true, "alias": ""}, {"module": "compat", "names": ["*"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["*"], "is_from": true, "alias": ""}, {"module": "ccddata", "names": ["*"], "is_from": true, "alias": ""}, {"module": "", "names": ["config"], "is_from": true, "alias": ""}], "functions": [], "classes": [{"name": "Conf", "bases": ["_config.ConfigNamespace"], "methods": [], "docstring": "Configuration parameters for `astropy.nddata`.", "start_line": 30, "end_line": 47}], "calls": [], "module_docstring": "The `astropy.nddata` subpackage provides the `~astropy.nddata.NDData`\nclass and related tools to manage n-dimensional array-based data (e.g.\nCCD images, IFU Data, grid-based simulation data, ...). This is more than\njust `numpy.ndarray` objects, because it provides metadata that cannot\nbe easily provided by a single array.", "parse_error": ""}, {"file_path": "astropy/nddata/nduncertainty.py", "file_hash": "b7733432be3aa6d7f548514e6a43889f3a7cba7f64c40a88390f60dcbc105a7b", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "abc", "names": ["ABCMeta", "abstractmethod"], "is_from": true, "alias": ""}, {"module": "copy", "names": ["deepcopy"], "is_from": true, "alias": ""}, {"module": "weakref", "names": [], "is_from": false, "alias": ""}, {"module": "", "names": ["log"], "is_from": true, "alias": ""}, {"module": "units", "names": ["Unit", "Quantity"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "array", "copy", "unit"], "decorators": [], "docstring": "", "start_line": 62, "end_line": 97, "is_async": false, "is_method": false}, {"name": "uncertainty_type", "qualified_name": "uncertainty_type", "args": ["self"], "decorators": ["property", "abstractmethod"], "docstring": "`str` : Short description of the type of uncertainty.\n\nDefined as abstract property so subclasses *have* to override this.", "start_line": 101, "end_line": 106, "is_async": false, "is_method": false}, {"name": "supports_correlated", "qualified_name": "supports_correlated", "args": ["self"], "decorators": ["property"], "docstring": "`bool` : Supports uncertainty propagation with correlated                  uncertainties?\n\n.. versionadded:: 1.2", "start_line": 109, "end_line": 115, "is_async": false, "is_method": false}, {"name": "array", "qualified_name": "array", "args": ["self"], "decorators": ["property"], "docstring": "`numpy.ndarray` : the uncertainty's value.\n        ", "start_line": 118, "end_line": 121, "is_async": false, "is_method": false}, {"name": "array", "qualified_name": "array", "args": ["self", "value"], "decorators": ["array.setter"], "docstring": "", "start_line": 124, "end_line": 127, "is_async": false, "is_method": false}, {"name": "unit", "qualified_name": "unit", "args": ["self"], "decorators": ["property"], "docstring": "`~astropy.units.Unit` : The unit of the uncertainty, if any.\n\nEven though it is not enforced the unit should be convertible to the\n``parent_nddata`` unit. Otherwise uncertainty propagation might give\nwrong results.\n\nIf the unit is not set the unit of the parent will be returned.", "start_line": 130, "end_line": 145, "is_async": false, "is_method": false}, {"name": "parent_nddata", "qualified_name": "parent_nddata", "args": ["self"], "decorators": ["property"], "docstring": "`NDData` : reference to `NDData` instance with this uncertainty.\n\nIn case the reference is not set uncertainty propagation will not be\npossible since propagation might need the uncertain data besides the\nuncertainty.", "start_line": 148, "end_line": 169, "is_async": false, "is_method": false}, {"name": "parent_nddata", "qualified_name": "parent_nddata", "args": ["self", "value"], "decorators": ["parent_nddata.setter"], "docstring": "", "start_line": 172, "end_line": 178, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 180, "end_line": 187, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "item"], "decorators": [], "docstring": "Normal slicing on the array, keep the unit and return a reference.\n        ", "start_line": 189, "end_line": 192, "is_async": false, "is_method": false}, {"name": "propagate", "qualified_name": "propagate", "args": ["self", "operation", "other_nddata", "result_data", "correlation"], "decorators": [], "docstring": "Calculate the resulting uncertainty given an operation on the data.\n\n.. versionadded:: 1.2\n\nParameters\n----------\noperation : callable\n    The operation that is performed on the `NDData`. Supported are\n    `numpy.add`, `numpy.subtract`, `numpy.multiply` and\n    `numpy.true_divide` (or `numpy.divide`", "start_line": 194, "end_line": 263, "is_async": false, "is_method": false}, {"name": "_convert_uncertainty", "qualified_name": "_convert_uncertainty", "args": ["self", "other_uncert"], "decorators": [], "docstring": "Checks if the uncertainties are compatible for propagation.\n\nChecks if the other uncertainty is `NDUncertainty`-like and if so\nverify that the uncertainty_type is equal. If the latter is not the\ncase try returning ``self.__class__(other_uncert)``.\n\nParameters\n----------\nother_uncert : `NDUncertainty", "start_line": 265, "end_line": 295, "is_async": false, "is_method": false}, {"name": "_propagate_add", "qualified_name": "_propagate_add", "args": ["self", "other_uncert", "result_data", "correlation"], "decorators": ["abstractmethod"], "docstring": "", "start_line": 298, "end_line": 299, "is_async": false, "is_method": false}, {"name": "_propagate_subtract", "qualified_name": "_propagate_subtract", "args": ["self", "other_uncert", "result_data", "correlation"], "decorators": ["abstractmethod"], "docstring": "", "start_line": 302, "end_line": 303, "is_async": false, "is_method": false}, {"name": "_propagate_multiply", "qualified_name": "_propagate_multiply", "args": ["self", "other_uncert", "result_data", "correlation"], "decorators": ["abstractmethod"], "docstring": "", "start_line": 306, "end_line": 307, "is_async": false, "is_method": false}, {"name": "_propagate_divide", "qualified_name": "_propagate_divide", "args": ["self", "other_uncert", "result_data", "correlation"], "decorators": ["abstractmethod"], "docstring": "", "start_line": 310, "end_line": 311, "is_async": false, "is_method": false}, {"name": "supports_correlated", "qualified_name": "supports_correlated", "args": ["self"], "decorators": ["property"], "docstring": "`False` : Uncertainty propagation is *not* possible for this class.\n        ", "start_line": 327, "end_line": 330, "is_async": false, "is_method": false}, {"name": "uncertainty_type", "qualified_name": "uncertainty_type", "args": ["self"], "decorators": ["property"], "docstring": "``\"unknown\"`` : `UnknownUncertainty` implements any unknown                            uncertainty type.\n        ", "start_line": 333, "end_line": 337, "is_async": false, "is_method": false}, {"name": "_convert_uncertainty", "qualified_name": "_convert_uncertainty", "args": ["self", "other_uncert"], "decorators": [], "docstring": "Raise an Exception because unknown uncertainty types cannot\nimplement propagation.", "start_line": 339, "end_line": 344, "is_async": false, "is_method": false}, {"name": "_propagate_add", "qualified_name": "_propagate_add", "args": ["self", "other_uncert", "result_data", "correlation"], "decorators": [], "docstring": "Not possible for unknown uncertainty types.\n        ", "start_line": 346, "end_line": 349, "is_async": false, "is_method": false}, {"name": "_propagate_subtract", "qualified_name": "_propagate_subtract", "args": ["self", "other_uncert", "result_data", "correlation"], "decorators": [], "docstring": "", "start_line": 351, "end_line": 352, "is_async": false, "is_method": false}, {"name": "_propagate_multiply", "qualified_name": "_propagate_multiply", "args": ["self", "other_uncert", "result_data", "correlation"], "decorators": [], "docstring": "", "start_line": 354, "end_line": 355, "is_async": false, "is_method": false}, {"name": "_propagate_divide", "qualified_name": "_propagate_divide", "args": ["self", "other_uncert", "result_data", "correlation"], "decorators": [], "docstring": "", "start_line": 357, "end_line": 358, "is_async": false, "is_method": false}, {"name": "supports_correlated", "qualified_name": "supports_correlated", "args": ["self"], "decorators": ["property"], "docstring": "`True` : `StdDevUncertainty` allows to propagate correlated                     uncertainties.\n\n``correlation`` must be given, this class does not implement computing\nit by itself.", "start_line": 406, "end_line": 413, "is_async": false, "is_method": false}, {"name": "uncertainty_type", "qualified_name": "uncertainty_type", "args": ["self"], "decorators": ["property"], "docstring": "``\"std\"`` : `StdDevUncertainty` implements standard deviation.\n        ", "start_line": 416, "end_line": 419, "is_async": false, "is_method": false}, {"name": "_convert_uncertainty", "qualified_name": "_convert_uncertainty", "args": ["self", "other_uncert"], "decorators": [], "docstring": "", "start_line": 421, "end_line": 425, "is_async": false, "is_method": false}, {"name": "_propagate_add", "qualified_name": "_propagate_add", "args": ["self", "other_uncert", "result_data", "correlation"], "decorators": [], "docstring": "", "start_line": 427, "end_line": 486, "is_async": false, "is_method": false}, {"name": "_propagate_subtract", "qualified_name": "_propagate_subtract", "args": ["self", "other_uncert", "result_data", "correlation"], "decorators": [], "docstring": "", "start_line": 488, "end_line": 522, "is_async": false, "is_method": false}, {"name": "_propagate_multiply", "qualified_name": "_propagate_multiply", "args": ["self", "other_uncert", "result_data", "correlation"], "decorators": [], "docstring": "", "start_line": 524, "end_line": 584, "is_async": false, "is_method": false}, {"name": "_propagate_divide", "qualified_name": "_propagate_divide", "args": ["self", "other_uncert", "result_data", "correlation"], "decorators": [], "docstring": "", "start_line": 586, "end_line": 654, "is_async": false, "is_method": false}], "classes": [{"name": "IncompatibleUncertaintiesException", "bases": ["Exception"], "methods": [], "docstring": "This exception should be used to indicate cases in which uncertainties\nwith two different classes can not be propagated.", "start_line": 18, "end_line": 21}, {"name": "MissingDataAssociationException", "bases": ["Exception"], "methods": [], "docstring": "This exception should be used to indicate that an uncertainty instance\nhas not been associated with a parent `~astropy.nddata.NDData` object.", "start_line": 24, "end_line": 27}, {"name": "NDUncertainty", "bases": [], "methods": ["__init__", "uncertainty_type", "supports_correlated", "array", "array", "unit", "parent_nddata", "parent_nddata", "__repr__", "__getitem__", "propagate", "_convert_uncertainty", "_propagate_add", "_propagate_subtract", "_propagate_multiply", "_propagate_divide"], "docstring": "This is the metaclass for uncertainty classes used with `NDData`.\n\nParameters\n----------\narray : any type, optional\n    The array or value (the parameter name is due to historical reasons) of\n    the uncertainty. `numpy.ndarray`, `~astropy.units.Quantity` or\n    `NDUncertainty` subclasses are recomm", "start_line": 30, "end_line": 311}, {"name": "UnknownUncertainty", "bases": ["NDUncertainty"], "methods": ["supports_correlated", "uncertainty_type", "_convert_uncertainty", "_propagate_add", "_propagate_subtract", "_propagate_multiply", "_propagate_divide"], "docstring": "This class implements any unknown uncertainty type.\n\nThe main purpose of having an unknown uncertainty class is to prevent\nuncertainty propagation.\n\nParameters\n----------\nargs, kwargs :\n    see `NDUncertainty`", "start_line": 314, "end_line": 358}, {"name": "StdDevUncertainty", "bases": ["NDUncertainty"], "methods": ["supports_correlated", "uncertainty_type", "_convert_uncertainty", "_propagate_add", "_propagate_subtract", "_propagate_multiply", "_propagate_divide"], "docstring": "Standard deviation uncertainty assuming first order gaussian error\npropagation.\n\nThis class implements uncertainty propagation for ``addition``,\n``subtraction``, ``multiplication`` and ``division`` with other instances\nof `StdDevUncertainty`. The class can handle if the uncertainty has a\nunit that d", "start_line": 361, "end_line": 654}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/nddata/decorators.py", "file_hash": "fb0c2f215cb928a11ea34cc823a7593256d34509ed0f4c610f4cca5f3d90b669", "imports": [{"module": "copy", "names": ["deepcopy"], "is_from": true, "alias": ""}, {"module": "inspect", "names": ["signature"], "is_from": true, "alias": ""}, {"module": "itertools", "names": ["islice"], "is_from": true, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "utils", "names": ["wraps"], "is_from": true, "alias": ""}, {"module": "utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}, {"module": "nddata", "names": ["NDData"], "is_from": true, "alias": ""}], "functions": [{"name": "support_nddata", "qualified_name": "support_nddata", "args": ["_func", "accepts", "repack", "returns", "keeps"], "decorators": [], "docstring": "Decorator to wrap functions that could accept an NDData instance with\nits properties passed as function arguments.\n\nParameters\n----------\n_func : callable, None, optional\n    The function to decorate or ``None`` if used as factory. The first\n    positional argument should be ``data`` and take a nump", "start_line": 22, "end_line": 277, "is_async": false, "is_method": false}, {"name": "support_nddata_decorator", "qualified_name": "support_nddata_decorator", "args": ["func"], "decorators": [], "docstring": "", "start_line": 145, "end_line": 269, "is_async": false, "is_method": false}, {"name": "wrapper", "qualified_name": "wrapper", "args": ["data"], "decorators": ["wraps(func)"], "docstring": "", "start_line": 175, "end_line": 268, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/nddata/nddata.py", "file_hash": "c055a75e98e0a7124e60b85bc9dfce1598f4e344a582bd4dd42b4cca744b6d49", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "copy", "names": ["deepcopy"], "is_from": true, "alias": ""}, {"module": "nddata_base", "names": ["NDDataBase"], "is_from": true, "alias": ""}, {"module": "nduncertainty", "names": ["NDUncertainty", "UnknownUncertainty"], "is_from": true, "alias": ""}, {"module": "", "names": ["log"], "is_from": true, "alias": ""}, {"module": "units", "names": ["Unit", "Quantity"], "is_from": true, "alias": ""}, {"module": "utils.metadata", "names": ["MetaData"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "data", "uncertainty", "mask", "wcs", "meta", "unit", "copy"], "decorators": [], "docstring": "", "start_line": 115, "end_line": 228, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 230, "end_line": 231, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 233, "end_line": 236, "is_async": false, "is_method": false}, {"name": "data", "qualified_name": "data", "args": ["self"], "decorators": ["property"], "docstring": "`~numpy.ndarray`-like : The stored dataset.", "start_line": 239, "end_line": 243, "is_async": false, "is_method": false}, {"name": "mask", "qualified_name": "mask", "args": ["self"], "decorators": ["property"], "docstring": "any type : Mask for the dataset, if any.\n\nMasks should follow the ``numpy`` convention that valid data points are\nmarked by ``False`` and invalid ones with ``True``.", "start_line": 246, "end_line": 253, "is_async": false, "is_method": false}, {"name": "mask", "qualified_name": "mask", "args": ["self", "value"], "decorators": ["mask.setter"], "docstring": "", "start_line": 256, "end_line": 257, "is_async": false, "is_method": false}, {"name": "unit", "qualified_name": "unit", "args": ["self"], "decorators": ["property"], "docstring": "`~astropy.units.Unit` : Unit for the dataset, if any.", "start_line": 260, "end_line": 264, "is_async": false, "is_method": false}, {"name": "wcs", "qualified_name": "wcs", "args": ["self"], "decorators": ["property"], "docstring": "any type : A world coordinate system (WCS) for the dataset, if any.", "start_line": 267, "end_line": 271, "is_async": false, "is_method": false}, {"name": "uncertainty", "qualified_name": "uncertainty", "args": ["self"], "decorators": ["property"], "docstring": "any type : Uncertainty in the dataset, if any.\n\nShould have an attribute ``uncertainty_type`` that defines what kind of\nuncertainty is stored, such as ``'std'`` for standard deviation or\n``'var'`` for variance. A metaclass defining such an interface is\n`~astropy.nddata.NDUncertainty` but isn't manda", "start_line": 274, "end_line": 283, "is_async": false, "is_method": false}, {"name": "uncertainty", "qualified_name": "uncertainty", "args": ["self", "value"], "decorators": ["uncertainty.setter"], "docstring": "", "start_line": 286, "end_line": 308, "is_async": false, "is_method": false}], "classes": [{"name": "NDData", "bases": ["NDDataBase"], "methods": ["__init__", "__str__", "__repr__", "data", "mask", "mask", "unit", "wcs", "uncertainty", "uncertainty"], "docstring": "A container for `numpy.ndarray`-based datasets, using the\n`~astropy.nddata.NDDataBase` interface.\n\nThe key distinction from raw `numpy.ndarray` is the presence of\nadditional metadata such as uncertainty, mask, unit, a coordinate system\nand/or a dictionary containing further meta information. This cl", "start_line": 19, "end_line": 308}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/nddata/utils.py", "file_hash": "5a08fc56dbac243bc68d3740f377ee68361a543de89919cc836c7e958cca3e51", "imports": [{"module": "copy", "names": ["deepcopy"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "decorators", "names": ["support_nddata"], "is_from": true, "alias": ""}, {"module": "", "names": ["units"], "is_from": true, "alias": ""}, {"module": "coordinates", "names": ["SkyCoord"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["lazyproperty"], "is_from": true, "alias": ""}, {"module": "wcs.utils", "names": ["skycoord_to_pixel", "proj_plane_pixel_scales"], "is_from": true, "alias": ""}, {"module": "skimage.measure", "names": ["block_reduce"], "is_from": true, "alias": ""}, {"module": "matplotlib.pyplot", "names": [], "is_from": false, "alias": "plt"}, {"module": "matplotlib.patches", "names": [], "is_from": false, "alias": "mpatches"}], "functions": [{"name": "_round", "qualified_name": "_round", "args": ["a"], "decorators": [], "docstring": "Always round up.\n\n``np.round`` cannot be used here, because it rounds .5 to the nearest\neven number.", "start_line": 31, "end_line": 37, "is_async": false, "is_method": false}, {"name": "_offset", "qualified_name": "_offset", "args": ["a"], "decorators": [], "docstring": "Offset by 0.5 for an even array.\n\nFor an array with an odd number of elements, the center is\nsymmetric, e.g. for 3 elements, it's center +/-1 elements, but for\nfour elements it's center -2 / +1\nThis function introduces that offset.", "start_line": 40, "end_line": 51, "is_async": false, "is_method": false}, {"name": "overlap_slices", "qualified_name": "overlap_slices", "args": ["large_array_shape", "small_array_shape", "position", "mode"], "decorators": [], "docstring": "Get slices for the overlapping part of a small and a large array.\n\nGiven a certain position of the center of the small array, with\nrespect to the large array, tuples of slices are returned which can be\nused to extract, add or subtract the small array at the given\nposition. This function takes care o", "start_line": 54, "end_line": 154, "is_async": false, "is_method": false}, {"name": "extract_array", "qualified_name": "extract_array", "args": ["array_large", "shape", "position", "mode", "fill_value", "return_position"], "decorators": [], "docstring": "Extract a smaller array of the given shape and position from a\nlarger array.\n\nParameters\n----------\narray_large : `~numpy.ndarray`\n    The array from which to extract the small array.\nshape : tuple or int\n    The shape of the extracted array (for 1D arrays, this can be an\n    `int`).  See the ``mode", "start_line": 157, "end_line": 246, "is_async": false, "is_method": false}, {"name": "add_array", "qualified_name": "add_array", "args": ["array_large", "array_small", "position"], "decorators": [], "docstring": "Add a smaller array at a given position in a larger array.\n\nParameters\n----------\narray_large : `~numpy.ndarray`\n    Large array.\narray_small : `~numpy.ndarray`\n    Small array to add.\nposition : tuple\n    Position of the small array's center, with respect to the large array.\n    Coordinates should ", "start_line": 249, "end_line": 297, "is_async": false, "is_method": false}, {"name": "subpixel_indices", "qualified_name": "subpixel_indices", "args": ["position", "subsampling"], "decorators": [], "docstring": "Convert decimal points to indices, given a subsampling factor.\n\nThis discards the integer part of the position and uses only the decimal\nplace, and converts this to a subpixel position depending on the\nsubsampling specified. The center of a pixel corresponds to an integer\nposition.\n\nParameters\n-----", "start_line": 300, "end_line": 340, "is_async": false, "is_method": false}, {"name": "block_reduce", "qualified_name": "block_reduce", "args": ["data", "block_size", "func"], "decorators": ["support_nddata"], "docstring": "Downsample a data array by applying a function to local blocks.\n\nIf ``data`` is not perfectly divisible by ``block_size`` along a\ngiven axis then the data will be trimmed (from the end) along that\naxis.\n\nParameters\n----------\ndata : array_like\n    The data to be resampled.\n\nblock_size : int or array", "start_line": 344, "end_line": 411, "is_async": false, "is_method": false}, {"name": "block_replicate", "qualified_name": "block_replicate", "args": ["data", "block_size", "conserve_sum"], "decorators": ["support_nddata"], "docstring": "Upsample a data array by block replication.\n\nParameters\n----------\ndata : array_like\n    The data to be block replicated.\n\nblock_size : int or array_like (int)\n    The integer block size along each axis.  If ``block_size`` is a\n    scalar and ``data`` has more than one dimension, then\n    ``block_si", "start_line": 415, "end_line": 472, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "data", "position", "size", "wcs", "mode", "fill_value", "copy"], "decorators": [], "docstring": "", "start_line": 654, "end_line": 736, "is_async": false, "is_method": false}, {"name": "to_original_position", "qualified_name": "to_original_position", "args": ["self", "cutout_position"], "decorators": [], "docstring": "Convert an ``(x, y)`` position in the cutout array to the original\n``(x, y)`` position in the original large array.\n\nParameters\n----------\ncutout_position : tuple\n    The ``(x, y)`` pixel position in the cutout array.\n\nReturns\n-------\noriginal_position : tuple\n    The corresponding ``(x, y)`` pixel ", "start_line": 738, "end_line": 755, "is_async": false, "is_method": false}, {"name": "to_cutout_position", "qualified_name": "to_cutout_position", "args": ["self", "original_position"], "decorators": [], "docstring": "Convert an ``(x, y)`` position in the original large array to\nthe ``(x, y)`` position in the cutout array.\n\nParameters\n----------\noriginal_position : tuple\n    The ``(x, y)`` pixel position in the original large array.\n\nReturns\n-------\ncutout_position : tuple\n    The corresponding ``(x, y)`` pixel p", "start_line": 757, "end_line": 774, "is_async": false, "is_method": false}, {"name": "plot_on_original", "qualified_name": "plot_on_original", "args": ["self", "ax", "fill"], "decorators": [], "docstring": "Plot the cutout region on a matplotlib Axes instance.\n\nParameters\n----------\nax : `matplotlib.axes.Axes` instance, optional\n    If `None`, then the current `matplotlib.axes.Axes` instance\n    is used.\n\nfill : bool, optional\n    Set whether to fill the cutout patch.  The default is\n    `False`.\n\nkwar", "start_line": 776, "end_line": 814, "is_async": false, "is_method": false}, {"name": "_calc_center", "qualified_name": "_calc_center", "args": ["slices"], "decorators": ["staticmethod"], "docstring": "Calculate the center position.  The center position will be\nfractional for even-sized arrays.  For ``mode='partial'``, the\ncentral position is calculated for the valid (non-filled) cutout\nvalues.", "start_line": 817, "end_line": 825, "is_async": false, "is_method": false}, {"name": "_calc_bbox", "qualified_name": "_calc_bbox", "args": ["slices"], "decorators": ["staticmethod"], "docstring": "Calculate a minimal bounding box in the form ``((ymin, ymax),\n(xmin, xmax))``.  Note these are pixel locations, not slice\nindices.  For ``mode='partial'``, the bounding box indices are\nfor the valid (non-filled) cutout values.", "start_line": 828, "end_line": 837, "is_async": false, "is_method": false}, {"name": "origin_original", "qualified_name": "origin_original", "args": ["self"], "decorators": ["lazyproperty"], "docstring": "The ``(x, y)`` index of the origin pixel of the cutout with\nrespect to the original array.  For ``mode='partial'``, the\norigin pixel is calculated for the valid (non-filled) cutout\nvalues.", "start_line": 840, "end_line": 847, "is_async": false, "is_method": false}, {"name": "origin_cutout", "qualified_name": "origin_cutout", "args": ["self"], "decorators": ["lazyproperty"], "docstring": "The ``(x, y)`` index of the origin pixel of the cutout with\nrespect to the cutout array.  For ``mode='partial'``, the origin\npixel is calculated for the valid (non-filled) cutout values.", "start_line": 850, "end_line": 856, "is_async": false, "is_method": false}, {"name": "position_original", "qualified_name": "position_original", "args": ["self"], "decorators": ["lazyproperty"], "docstring": "The ``(x, y)`` position index (rounded to the nearest pixel) in\nthe original array.", "start_line": 859, "end_line": 865, "is_async": false, "is_method": false}, {"name": "position_cutout", "qualified_name": "position_cutout", "args": ["self"], "decorators": ["lazyproperty"], "docstring": "The ``(x, y)`` position index (rounded to the nearest pixel) in\nthe cutout array.", "start_line": 868, "end_line": 874, "is_async": false, "is_method": false}, {"name": "center_original", "qualified_name": "center_original", "args": ["self"], "decorators": ["lazyproperty"], "docstring": "The central ``(x, y)`` position of the cutout array with respect\nto the original array.  For ``mode='partial'``, the central\nposition is calculated for the valid (non-filled) cutout values.", "start_line": 877, "end_line": 883, "is_async": false, "is_method": false}, {"name": "center_cutout", "qualified_name": "center_cutout", "args": ["self"], "decorators": ["lazyproperty"], "docstring": "The central ``(x, y)`` position of 