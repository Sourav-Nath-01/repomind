e, "is_method": false}, {"name": "check_output", "qualified_name": "check_output", "args": ["output", "unit", "inputs", "function"], "decorators": [], "docstring": "Check that function output can be stored in the output array given.\n\nParameters\n----------\noutput : array or `~astropy.units.Quantity` or tuple\n    Array that should hold the function output (or tuple of such arrays).\nunit : `~astropy.units.Unit` or None, or tuple\n    Unit that the output will have,", "start_line": 567, "end_line": 638, "is_async": false, "is_method": false}, {"name": "helper_heaviside", "qualified_name": "helper_heaviside", "args": ["f", "unit1", "unit2"], "decorators": [], "docstring": "", "start_line": 281, "end_line": 288, "is_async": false, "is_method": false}, {"name": "helper_divmod", "qualified_name": "helper_divmod", "args": ["f", "unit1", "unit2"], "decorators": [], "docstring": "", "start_line": 393, "end_line": 395, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/units/cds.py", "file_hash": "ab0750b6b603468d21f9302ee9d542964a9b329a68985b6d9c9889cdf04fd830", "imports": [{"module": "utils", "names": ["generate_unit_summary"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "", "names": ["core"], "is_from": true, "alias": ""}, {"module": "", "names": ["units"], "is_from": true, "alias": ""}, {"module": "constants", "names": ["si"], "is_from": true, "alias": ""}, {"module": "core", "names": ["set_enabled_units"], "is_from": true, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "_initialize_module", "qualified_name": "_initialize_module", "args": [], "decorators": [], "docstring": "", "start_line": 30, "end_line": 157, "is_async": false, "is_method": false}, {"name": "enable", "qualified_name": "enable", "args": [], "decorators": [], "docstring": "Enable CDS units so they appear in results of\n`~astropy.units.UnitBase.find_equivalent_units` and\n`~astropy.units.UnitBase.compose`.  This will disable\nall of the \"default\" `astropy.units` units, since there\nare some namespace clashes between the two.\n\nThis may be used with the ``with`` statement to", "start_line": 173, "end_line": 188, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This package defines units used in the CDS format, both the units\ndefined in `Centre de Donn\u00e9es astronomiques de Strasbourg\n<http://cds.u-strasbg.fr/>`_ `Standards for Astronomical Catalogues 2.0\n<http://cds.u-strasbg.fr/doc/catstd-3.2.htx>`_ format and the `complete\nset of supported units <http://vizier.u-strasbg.fr/cgi-bin/Unit>`_.\nThis format is used by VOTable up to version 1.2.\n\nThese units are not available in the top-level `astropy.units`\nnamespace.  To use these units, you must import the `astropy.units.cds`\nmodule::\n\n    >>> from astropy.units import cds\n    >>> q = 10. * cds.lyr  # doctest: +SKIP\n\nTo include them in `~astropy.units.UnitBase.compose` and the results of\n`~astropy.units.UnitBase.find_equivalent_units`, do::\n\n    >>> from astropy.units import cds\n    >>> cds.enable()  # doctest: +SKIP", "parse_error": ""}, {"file_path": "astropy/units/imperial.py", "file_hash": "6788ec87c476eae976198a64ffa49cc009095c8f147dcf3d97c2ee5e020db45d", "imports": [{"module": "core", "names": ["UnitBase", "def_unit"], "is_from": true, "alias": ""}, {"module": "", "names": ["si"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["generate_unit_summary"], "is_from": true, "alias": ""}, {"module": "core", "names": ["add_enabled_units"], "is_from": true, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "enable", "qualified_name": "enable", "args": [], "decorators": [], "docstring": "Enable Imperial units so they appear in results of\n`~astropy.units.UnitBase.find_equivalent_units` and\n`~astropy.units.UnitBase.compose`.\n\nThis may be used with the ``with`` statement to enable Imperial\nunits only temporarily.", "start_line": 154, "end_line": 167, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This package defines colloquially used Imperial units.  They are\navailable in the `astropy.units.imperial` namespace, but not in the\ntop-level `astropy.units` namespace, e.g.::\n\n    >>> import astropy.units as u\n    >>> mph = u.imperial.mile / u.hour\n    >>> mph\n    Unit(\"mi / h\")\n\nTo include them in `~astropy.units.UnitBase.compose` and the results of\n`~astropy.units.UnitBase.find_equivalent_units`, do::\n\n    >>> import astropy.units as u\n    >>> u.imperial.enable()  # doctest: +SKIP", "parse_error": ""}, {"file_path": "astropy/units/__init__.py", "file_hash": "b9c21d05b91041941137420d546ad8e7662543c8e876163c164a1fbfe7a3b85a", "imports": [{"module": "core", "names": ["*"], "is_from": true, "alias": ""}, {"module": "quantity", "names": ["*"], "is_from": true, "alias": ""}, {"module": "decorators", "names": ["*"], "is_from": true, "alias": ""}, {"module": "", "names": ["si"], "is_from": true, "alias": ""}, {"module": "", "names": ["cgs"], "is_from": true, "alias": ""}, {"module": "", "names": ["astrophys"], "is_from": true, "alias": ""}, {"module": "function", "names": ["units"], "is_from": true, "alias": ""}, {"module": "si", "names": ["*"], "is_from": true, "alias": ""}, {"module": "astrophys", "names": ["*"], "is_from": true, "alias": ""}, {"module": "cgs", "names": ["*"], "is_from": true, "alias": ""}, {"module": "physical", "names": ["*"], "is_from": true, "alias": ""}, {"module": "function.units", "names": ["*"], "is_from": true, "alias": ""}, {"module": "equivalencies", "names": ["*"], "is_from": true, "alias": ""}, {"module": "function.core", "names": ["*"], "is_from": true, "alias": ""}, {"module": "function.logarithmic", "names": ["*"], "is_from": true, "alias": ""}, {"module": "function", "names": ["magnitude_zero_points"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "This subpackage contains classes and functions for defining and converting\nbetween different physical units.\n\nThis code is adapted from the `pynbody\n<https://github.com/pynbody/pynbody>`_ units module written by Andrew\nPontzen, who has granted the Astropy project permission to use the\ncode under a BSD license.", "parse_error": ""}, {"file_path": "astropy/units/required_by_vounit.py", "file_hash": "010acb8739268afb39b57f68a20f26d00f041fc45ee6f0591da35fd4805716f5", "imports": [{"module": "utils", "names": ["generate_unit_summary", "generate_prefixonly_unit_summary"], "is_from": true, "alias": ""}, {"module": "", "names": ["cgs"], "is_from": true, "alias": ""}, {"module": "", "names": ["astrophys"], "is_from": true, "alias": ""}, {"module": "core", "names": ["def_unit", "_add_prefixes"], "is_from": true, "alias": ""}, {"module": "core", "names": ["add_enabled_units"], "is_from": true, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "_initialize_module", "qualified_name": "_initialize_module", "args": [], "decorators": [], "docstring": "", "start_line": 17, "end_line": 25, "is_async": false, "is_method": false}, {"name": "_enable", "qualified_name": "_enable", "args": [], "decorators": [], "docstring": "Enable the VOUnit-required extra units so they appear in results of\n`~astropy.units.UnitBase.find_equivalent_units` and\n`~astropy.units.UnitBase.compose`, and are recognized in the ``Unit('...')``\nidiom.", "start_line": 43, "end_line": 54, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This package defines SI prefixed units that are required by the VOUnit standard\nbut that are rarely used in practice and liable to lead to confusion (such as\n``msolMass`` for milli-solar mass). They are in a separate module from\n`astropy.units.deprecated` because they need to be enabled by default for\n`astropy.units` to parse compliant VOUnit strings. As a result, e.g.,\n``Unit('msolMass')`` will just work, but to access the unit directly, use\n``astropy.units.required_by_vounit.msolMass`` instead of the more typical idiom\npossible for the non-prefixed unit, ``astropy.units.solMass``.", "parse_error": ""}, {"file_path": "astropy/units/deprecated.py", "file_hash": "803f838d8eb7c8a0c705c85801a5d3a7910d261cd3ec6b0c93f820d7a20e9f56", "imports": [{"module": "utils", "names": ["generate_unit_summary", "generate_prefixonly_unit_summary"], "is_from": true, "alias": ""}, {"module": "", "names": ["cgs"], "is_from": true, "alias": ""}, {"module": "", "names": ["astrophys"], "is_from": true, "alias": ""}, {"module": "core", "names": ["def_unit", "_add_prefixes"], "is_from": true, "alias": ""}, {"module": "core", "names": ["add_enabled_units"], "is_from": true, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "_initialize_module", "qualified_name": "_initialize_module", "args": [], "decorators": [], "docstring": "", "start_line": 24, "end_line": 37, "is_async": false, "is_method": false}, {"name": "enable", "qualified_name": "enable", "args": [], "decorators": [], "docstring": "Enable deprecated units so they appear in results of\n`~astropy.units.UnitBase.find_equivalent_units` and\n`~astropy.units.UnitBase.compose`.\n\nThis may be used with the ``with`` statement to enable deprecated\nunits only temporarily.", "start_line": 55, "end_line": 68, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This package defines deprecated units.\n\nThese units are not available in the top-level `astropy.units`\nnamespace. To use these units, you must import the `astropy.units.deprecated`\nmodule::\n\n    >>> from astropy.units import deprecated\n    >>> q = 10. * deprecated.emu  # doctest: +SKIP\n\nTo include them in `~astropy.units.UnitBase.compose` and the results of\n`~astropy.units.UnitBase.find_equivalent_units`, do::\n\n    >>> from astropy.units import deprecated\n    >>> deprecated.enable()  # doctest: +SKIP", "parse_error": ""}, {"file_path": "astropy/units/decorators.py", "file_hash": "f70d081b536f685fd13fe69b0eeffefdd97407ca466efe657d93fd71eeab769c", "imports": [{"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "utils.decorators", "names": ["wraps"], "is_from": true, "alias": ""}, {"module": "utils.misc", "names": ["isiterable"], "is_from": true, "alias": ""}, {"module": "core", "names": ["Unit", "UnitsError", "add_enabled_equivalencies"], "is_from": true, "alias": ""}, {"module": "physical", "names": ["_unit_physical_mapping"], "is_from": true, "alias": ""}], "functions": [{"name": "_get_allowed_units", "qualified_name": "_get_allowed_units", "args": ["targets"], "decorators": [], "docstring": "From a list of target units (either as strings or unit objects) and physical\ntypes, return a list of Unit objects.", "start_line": 14, "end_line": 40, "is_async": false, "is_method": false}, {"name": "_validate_arg_value", "qualified_name": "_validate_arg_value", "args": ["param_name", "func_name", "arg", "targets", "equivalencies"], "decorators": [], "docstring": "Validates the object passed in to the wrapped function, ``arg``, with target\nunit or physical type, ``target``.", "start_line": 43, "end_line": 79, "is_async": false, "is_method": false}, {"name": "as_decorator", "qualified_name": "as_decorator", "args": ["cls", "func"], "decorators": ["classmethod"], "docstring": "A decorator for validating the units of arguments to functions.\n\nUnit specifications can be provided as keyword arguments to the decorator,\nor by using function annotation syntax. Arguments to the decorator\ntake precedence over any function annotations present.\n\nA `~astropy.units.UnitsError` will be", "start_line": 85, "end_line": 149, "is_async": false, "is_method": false}, {"name": "