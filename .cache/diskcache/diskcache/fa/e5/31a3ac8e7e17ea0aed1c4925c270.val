nates\ny : array\n    input coordinates\nz : array (optional)\n    input coordinates\nweights : array (optional)\n    weights\nkwargs : dict\n    optional keyword ar", "start_line": 782, "end_line": 829, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 846, "end_line": 848, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "model", "x", "y", "z", "weights"], "decorators": ["fitter_unit_support"], "docstring": "Fit data to this model.\n\nParameters\n----------\nmodel : `~astropy.modeling.FittableModel`\n    model to fit to x, y, z\nx : array\n    input coordinates\ny : array\n    input coordinates\nz : array (optional)\n    input coordinates\nweights : array (optional)\n    weights\nkwargs : dict\n    optional keyword ar", "start_line": 851, "end_line": 894, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "models", "jointparameters", "initvals"], "decorators": [], "docstring": "", "start_line": 914, "end_line": 924, "is_async": false, "is_method": false}, {"name": "_model_to_fit_params", "qualified_name": "_model_to_fit_params", "args": ["self"], "decorators": [], "docstring": "", "start_line": 926, "end_line": 937, "is_async": false, "is_method": false}, {"name": "objective_function", "qualified_name": "objective_function", "args": ["self", "fps"], "decorators": [], "docstring": "Function to minimize.\n\nParameters\n----------\nfps : list\n    the fitted parameters - result of an one iteration of the\n    fitting algorithm\nargs : dict\n    tuple of measured and input coordinates\n    args is always passed as a tuple from optimize.leastsq", "start_line": 939, "end_line": 986, "is_async": false, "is_method": false}, {"name": "_verify_input", "qualified_name": "_verify_input", "args": ["self"], "decorators": [], "docstring": "", "start_line": 988, "end_line": 998, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self"], "decorators": [], "docstring": "Fit data to these models keeping some of the parameters common to the\ntwo models.", "start_line": 1000, "end_line": 1043, "is_async": false, "is_method": false}], "classes": [{"name": "ModelsError", "bases": ["Exception"], "methods": [], "docstring": "Base class for model exceptions", "start_line": 61, "end_line": 62}, {"name": "ModelLinearityError", "bases": ["ModelsError"], "methods": [], "docstring": "Raised when a non-linear model is passed to a linear fitter.", "start_line": 65, "end_line": 66}, {"name": "UnsupportedConstraintError", "bases": ["ModelsError", "ValueError"], "methods": [], "docstring": "Raised when a fitter does not support a type of constraint.", "start_line": 69, "end_line": 72}, {"name": "_FitterMeta", "bases": ["abc.ABCMeta"], "methods": ["__new__"], "docstring": "Currently just provides a registry for all Fitter classes.", "start_line": 75, "end_line": 88}, {"name": "Fitter", "bases": [], "methods": ["__init__", "objective_function", "__call__"], "docstring": "Base class for all fitters.\n\nParameters\n----------\noptimizer : callable\n    A callable implementing an optimization algorithm\nstatistic : callable\n    Statistic function", "start_line": 183, "end_line": 247}, {"name": "LinearLSQFitter", "bases": [], "methods": ["__init__", "_deriv_with_constraints", "_map_domain_window", "__call__"], "docstring": "A class performing a linear least square fitting.\n\nUses `numpy.linalg.lstsq` to do the fitting.\nGiven a model and data, fits the model to the data and changes the\nmodel's parameters. Keeps a dictionary of auxiliary fitting information.", "start_line": 253, "end_line": 479}, {"name": "FittingWithOutlierRemoval", "bases": [], "methods": ["__init__", "__str__", "__repr__", "__call__"], "docstring": "This class combines an outlier removal technique with a fitting procedure.\nBasically, given a number of iterations ``niter``, outliers are removed\nand fitting is performed for each iteration.\n\nParameters\n----------\nfitter : An Astropy fitter\n    An instance of any Astropy fitter, i.e., LinearLSQFitt", "start_line": 482, "end_line": 571}, {"name": "LevMarLSQFitter", "bases": [], "methods": ["__init__", "objective_function", "__call__", "_wrap_deriv"], "docstring": "Levenberg-Marquardt algorithm and least squares statistic.\n\nAttributes\n----------\nfit_info : dict\n    The `scipy.optimize.leastsq` result for the most recent fit (see\n    notes).\n\nNotes\n-----\nThe ``fit_info`` dictionary contains the values returned by\n`scipy.optimize.leastsq` for the most recent fit", "start_line": 574, "end_line": 760}, {"name": "SLSQPLSQFitter", "bases": ["Fitter"], "methods": ["__init__", "__call__"], "docstring": "SLSQP optimization algorithm and least squares statistic.\n\n\nRaises\n------\nModelLinearityError\n    A linear model is passed to a nonlinear fitter", "start_line": 763, "end_line": 829}, {"name": "SimplexLSQFitter", "bases": ["Fitter"], "methods": ["__init__", "__call__"], "docstring": "Simplex algorithm and least squares statistic.\n\nRaises\n------\nModelLinearityError\n    A linear model is passed to a nonlinear fitter", "start_line": 832, "end_line": 894}, {"name": "JointFitter", "bases": [], "methods": ["__init__", "_model_to_fit_params", "objective_function", "_verify_input", "__call__"], "docstring": "Fit models which share a parameter.\n\nFor example, fit two gaussians to two data sets but keep\nthe FWHM the same.\n\nParameters\n----------\nmodels : list\n    a list of model instances\njointparameters : list\n    a list of joint parameters\ninitvals : list\n    a list of initial values", "start_line": 897, "end_line": 1043}], "calls": [], "module_docstring": "This module implements classes (called Fitters) which combine optimization\nalgorithms (typically from `scipy.optimize`) with statistic functions to perform\nfitting. Fitters are implemented as callable classes. In addition to the data\nto fit, the ``__call__`` method takes an instance of\n`~astropy.modeling.core.FittableModel` as input, and returns a copy of the\nmodel with its parameters determined by the optimizer.\n\nOptimization algorithms, called \"optimizers\" are implemented in\n`~astropy.modeling.optimizers` and statistic functions are in\n`~astropy.modeling.statistic`. The goal is to provide an easy to extend\nframework and allow users to easily create new fitters by combining statistics\nwith optimizers.\n\nThere are two exceptions to the above scheme.\n`~astropy.modeling.fitting.LinearLSQFitter` uses Numpy's `~numpy.linalg.lstsq`\nfunction.  `~astropy.modeling.fitting.LevMarLSQFitter` uses\n`~scipy.optimize.leastsq` which combines optimization and statistic in one\nimplementation.", "parse_error": ""}, {"file_path": "astropy/modeling/rotations.py", "file_hash": "f37129005be7b5868442fbbaf6843a376a59279b3a9968038c2029966e90a9b0", "imports": [{"module": "math", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "core", "names": ["Model"], "is_from": true, "alias": ""}, {"module": "parameters", "names": ["Parameter"], "is_from": true, "alias": ""}, {"module": "coordinates.matrix_utilities", "names": ["rotation_matrix", "matrix_product"], "is_from": true, "alias": ""}, {"module": "", "names": ["units"], "is_from": true, "alias": ""}, {"module": "utils.decorators", "names": ["deprecated"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["_to_radian", "_to_orig_unit"], "is_from": true, "alias": ""}], "functions": [{"name": "_create_matrix", "qualified_name": "_create_matrix", "args": ["self", "phi", "theta", "psi", "axes_order"], "decorators": [], "docstring": "", "start_line": 44, "end_line": 52, "is_async": false, "is_method": false}, {"name": "spherical2cartesian", "qualified_name": "spherical2cartesian", "args": ["alpha", "delta"], "dec