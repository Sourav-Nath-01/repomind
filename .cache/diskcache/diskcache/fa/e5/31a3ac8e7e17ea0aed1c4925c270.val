6, "end_line": 461}, {"name": "UnitConversionError", "bases": ["UnitsError", "ValueError"], "methods": [], "docstring": "Used specifically for errors related to converting between units or\ninterpreting units in terms of other units.", "start_line": 464, "end_line": 468}, {"name": "UnitTypeError", "bases": ["UnitsError", "TypeError"], "methods": [], "docstring": "Used specifically for errors in setting to units not allowed by a class.\n\nE.g., would be raised if the unit of an `~astropy.coordinates.Angle`\ninstances were set to a non-angular unit.", "start_line": 471, "end_line": 477}, {"name": "UnitsWarning", "bases": ["AstropyWarning"], "methods": [], "docstring": "The base class for unit-specific warnings.", "start_line": 480, "end_line": 483}, {"name": "UnitBase", "bases": [], "methods": ["__deepcopy__", "_repr_latex_", "__bytes__", "__str__", "__repr__", "_get_physical_type_id", "names", "name", "aliases", "scale", "bases", "powers", "to_string", "__format__", "_normalize_equivalencies", "__pow__", "__div__", "__rdiv__", "__mul__", "__rmul__", "__hash__", "__eq__", "__ne__", "__le__", "__ge__", "__lt__", "__gt__", "__neg__", "is_equivalent", "_is_equivalent", "_apply_equivalencies", "_get_converter", "_to", "to", "in_units", "decompose", "_compose", "compose", "to_system", "si", "cgs", "physical_type", "_get_units_with_same_physical_type", "find_equivalent_units", "is_unity"], "docstring": "Abstract base class for units.\n\nMost of the arithmetic operations on units are defined in this\nbase class.\n\nShould not be instantiated by users directly.", "start_line": 486, "end_line": 1424}, {"name": "NamedUnit", "bases": ["UnitBase"], "methods": ["__init__", "_generate_doc", "get_format_name", "names", "name", "aliases", "short_names", "long_names", "_inject"], "docstring": "The base class of units that have a name.\n\nParameters\n----------\nst : str, list of str, 2-tuple\n    The name of the unit.  If a list of strings, the first element\n    is the canonical (short) name, and the rest of the elements\n    are aliases.  If a tuple of lists, the first element is a list\n    of", "start_line": 1427, "end_line": 1590}, {"name": "IrreducibleUnit", "bases": ["NamedUnit"], "methods": ["__reduce__", "represents", "decompose"], "docstring": "Irreducible units are the units that all other units are defined\nin terms of.\n\nExamples are meters, seconds, kilograms, amperes, etc.  There is\nonly once instance of such a unit per type.", "start_line": 1613, "end_line": 1660}, {"name": "UnrecognizedUnit", "bases": ["IrreducibleUnit"], "methods": ["__repr__", "__bytes__", "__str__", "to_string", "_unrecognized_operator", "__eq__", "__ne__", "is_equivalent", "_get_converter", "get_format_name", "is_unity"], "docstring": "A unit that did not parse correctly.  This allows for\nroundtripping it as a string, but no unit operations actually work\non it.\n\nParameters\n----------\nst : str\n    The name of the unit.", "start_line": 1663, "end_line": 1721}, {"name": "_UnitMetaClass", "bases": ["InheritDocstrings"], "methods": ["__call__"], "docstring": "This metaclass exists because the Unit constructor should\nsometimes return instances that already exist.  This \"overrides\"\nthe constructor before the new instance is actually created, so we\ncan return an existing one.", "start_line": 1724, "end_line": 1813}, {"name": "Unit", "bases": ["NamedUnit"], "methods": ["__init__", "represents", "decompose", "is_unity", "__hash__", "_from_physical_type_id"], "docstring": "The main unit class.\n\nThere are a number of different ways to construct a Unit, but\nalways returns a `UnitBase` instance.  If the arguments refer to\nan already-existing unit, that existing unit instance is returned,\nrather than a new one.\n\n- From a string::\n\n    Unit(s, format=None, parse_strict='si", "start_line": 1816, "end_line": 1934}, {"name": "PrefixUnit", "bases": ["Unit"], "methods": [], "docstring": "A unit that is simply a SI-prefixed version of another unit.\n\nFor example, ``mm`` is a `PrefixUnit` of ``.001 * m``.\n\nThe constructor is the same as for `Unit`.", "start_line": 1937, "end_line": 1944}, {"name": "CompositeUnit", "bases": ["UnitBase"], "methods": ["__init__", "__repr__", "__hash__", "scale", "bases", "powers", "_expand_and_gather", "__copy__", "decompose", "is_unity"], "docstring": "Create a composite unit using expressions of previously defined\nunits.\n\nDirect use of this class is not recommended. Instead use the\nfactory function `Unit` and arithmetic operators to compose\nunits.\n\nParameters\n----------\nscale : number\n    A scaling factor for the unit.\n\nbases : sequence of `UnitB", "start_line": 1947, "end_line": 2099}, {"name": "EquivalentUnitsList", "bases": ["list"], "methods": ["__repr__"], "docstring": "A class to handle pretty-printing the result of\n`find_equivalent_units`.", "start_line": 1352, "end_line": 1382}], "calls": [], "module_docstring": "Core units classes and functions", "parse_error": ""}, {"file_path": "astropy/units/quantity.py", "file_hash": "94af50b46e38f56648d82781f4b7083c08bbfd3f365a6eabcb8234bf49ded563", "imports": [{"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "numbers", "names": [], "is_from": false, "alias": ""}, {"module": "fractions", "names": ["Fraction"], "is_from": true, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "core", "names": ["Unit", "dimensionless_unscaled", "get_current_unit_registry", "UnitBase", "UnitsError", "UnitTypeError"], "is_from": true, "alias": ""}, {"module": "format.latex", "names": ["Latex"], "is_from": true, "alias": ""}, {"module": "utils.compat", "names": ["NUMPY_LT_1_13", "NUMPY_LT_1_14"], "is_from": true, "alias": ""}, {"module": "utils.compat.misc", "names": ["override__dir__"], "is_from": true, "alias": ""}, {"module": "utils.exceptions", "names": ["AstropyDeprecationWarning"], "is_from": true, "alias":