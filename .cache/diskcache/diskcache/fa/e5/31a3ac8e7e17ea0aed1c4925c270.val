ied_names", "qualified_name": "test_no_header_supplied_names", "args": ["parallel", "read_basic", "read_no_header"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "If header_start=None and names is passed as a parameter, header\ndata should not be read and names should be used instead.", "start_line": 177, "end_line": 185, "is_async": false, "is_method": false}, {"name": "test_comment", "qualified_name": "test_comment", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure that line comments are ignored by the C reader.", "start_line": 189, "end_line": 195, "is_async": false, "is_method": false}, {"name": "test_empty_lines", "qualified_name": "test_empty_lines", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure that empty lines are ignored by the C reader.", "start_line": 199, "end_line": 205, "is_async": false, "is_method": false}, {"name": "test_lstrip_whitespace", "qualified_name": "test_lstrip_whitespace", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Test to make sure the reader ignores whitespace at the beginning of fields.", "start_line": 209, "end_line": 221, "is_async": false, "is_method": false}, {"name": "test_rstrip_whitespace", "qualified_name": "test_rstrip_whitespace", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Test to make sure the reader ignores whitespace at the end of fields.", "start_line": 225, "end_line": 232, "is_async": false, "is_method": false}, {"name": "test_conversion", "qualified_name": "test_conversion", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "The reader should try to convert each column to ints. If this fails, the\nreader should try to convert to floats. Failing this, it should fall back\nto strings.", "start_line": 236, "end_line": 253, "is_async": false, "is_method": false}, {"name": "test_delimiter", "qualified_name": "test_delimiter", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure that different delimiters work as expected.", "start_line": 257, "end_line": 270, "is_async": false, "is_method": false}, {"name": "test_include_names", "qualified_name": "test_include_names", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "If include_names is not None, the parser should read only those columns in include_names.", "start_line": 274, "end_line": 280, "is_async": false, "is_method": false}, {"name": "test_exclude_names", "qualified_name": "test_exclude_names", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "If exclude_names is not None, the parser should exclude the columns in exclude_names.", "start_line": 284, "end_line": 290, "is_async": false, "is_method": false}, {"name": "test_include_exclude_names", "qualified_name": "test_include_exclude_names", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure that include_names is applied before exclude_names if both are specified.", "start_line": 294, "end_line": 306, "is_async": false, "is_method": false}, {"name": "test_quoted_fields", "qualified_name": "test_quoted_fields", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "The character quotechar (default '\"') should denote the start of a field which can\ncontain the field delimiter and newlines.", "start_line": 310, "end_line": 327, "is_async": false, "is_method": false}, {"name": "test_invalid_parameters", "qualified_name": "test_invalid_parameters", "args": ["key", "val"], "decorators": ["pytest.mark.parametrize('key,val', [('delimiter', ',,'), ('comment', '##'), ('data_start', None), ('data_start', -1), ('quotechar', '##'), ('header_start', -1), ('converters', dict(((i + 1, ascii.convert_numpy(np.uint)) for i in range(3)))), ('Inputter', ascii.ContinuationLinesInputter), ('header_Splitter', ascii.DefaultSplitter), ('data_Splitter', ascii.DefaultSplitter)])"], "docstring": "Make sure the C reader raises an error if passed parameters it can't handle.", "start_line": 341, "end_line": 349, "is_async": false, "is_method": false}, {"name": "test_invalid_parameters_other", "qualified_name": "test_invalid_parameters_other", "args": [], "decorators": [], "docstring": "", "start_line": 352, "end_line": 359, "is_async": false, "is_method": false}, {"name": "test_too_many_cols1", "qualified_name": "test_too_many_cols1", "args": [], "decorators": [], "docstring": "If a row contains too many columns, the C reader should raise an error.", "start_line": 362, "end_line": 376, "is_async": false, "is_method": false}, {"name": "test_too_many_cols2", "qualified_name": "test_too_many_cols2", "args": [], "decorators": [], "docstring": "", "start_line": 379, "end_line": 388, "is_async": false, "is_method": false}, {"name": "test_too_many_cols3", "qualified_name": "test_too_many_cols3", "args": [], "decorators": [], "docstring": "", "start_line": 391, "end_line": 400, "is_async": false, "is_method": false}, {"name": "test_not_enough_cols", "qualified_name": "test_not_enough_cols", "args": ["parallel", "read_csv"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "If a row does not have enough columns, the FastCsv reader should add empty\nfields while the FastBasic reader should raise an error.", "start_line": 404, "end_line": 420, "is_async": false, "is_method": false}, {"name": "test_data_end", "qualified_name": "test_data_end", "args": ["parallel", "read_basic", "read_rdb"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "The parameter data_end should specify where data reading ends.", "start_line": 424, "end_line": 463, "is_async": false, "is_method": false}, {"name": "test_inf_nan", "qualified_name": "test_inf_nan", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Test that inf and nan-like values are correctly parsed on all platforms.\n\nRegression test for https://github.com/astropy/astropy/pull/3525", "start_line": 467, "end_line": 493, "is_async": false, "is_method": false}, {"name": "test_fill_values", "qualified_name": "test_fill_values", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure that the parameter fill_values works as intended. If fill_values\nis not specified, the default behavior should be to convert '' to 0.", "start_line": 497, "end_line": 541, "is_async": false, "is_method": false}, {"name": "test_fill_include_exclude_names", "qualified_name": "test_fill_include_exclude_names", "args": ["parallel", "read_csv"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "fill_include_names and fill_exclude_names should filter missing/empty value handling\nin the same way that include_names and exclude_names filter output columns.", "start_line": 545, "end_line": 569, "is_async": false, "is_method": false}, {"name": "test_many_rows", "qualified_name": "test_many_rows", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure memory reallocation works okay when the number of rows\nis large (so that each column string is longer than INITIAL_COL_SIZE).", "start_line": 573, "end_line": 585, "is_async": false, "is_method": false}, {"name": "test_many_columns", "qualified_name": "test_many_columns", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure memory reallocation works okay when the number of columns\nis large (so that each header string is longer than INITIAL_HEADER_SIZE).", "start_line": 589, "end_line": 599, "is_async": false, "is_method": false}, {"name": "test_fast_reader", "qualified_name": "test_fast_reader", "args": [], "decorators": [], "docstring": "Make sure that ascii.read() works as expected by default and with\nfast_reader specified.", "start_line": 602, "end_line": 631, "is_async": false, "is_method": false}, {"name": "test_read_tab", "qualified_name": "test_read_tab", "args": ["parallel", "read_tab"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "The fast reader for tab-separated values should not strip whitespace, unlike\nthe basic reader.", "start_line": 635, "end_line": 648, "is_async": false, "is_method": false}, {"name": "test_default_data_start", "qualified_name": "test_default_data_start", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "If data_start is not explicitly passed to read(), data processing should\nbeginning right after the header.", "start_line": 652, "end_line": 660, "is_async": false, "is_method": false}, {"name": "test_commented_header", "qualified_name": "test_commented_header", "args": ["parallel", "read_commented_header"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "The FastCommentedHeader reader should mimic the behavior of the\nCommentedHeader by overriding the default header behavior of FastBasic.", "start_line": 664, "end_line": 690, "is_async": false, "is_method": false}, {"name": "test_rdb", "qualified_name": "test_rdb", "args": ["parallel", "read_rdb"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure the FastRdb reader works as expected.", "start_line": 694, "end_line": 724, "is_async": false, "is_method": false}, {"name": "test_data_start", "qualified_name": "test_data_start", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure that data parsing begins at data_start (ignoring empty and\ncommented lines but not taking quoted values into account).", "start_line": 728, "end_line": 776, "is_async": false, "is_method": false}, {"name": "test_quoted_empty_values", "qualified_name": "test_quoted_empty_values", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Quoted empty values spanning multiple lines should be treated correctly.", "start_line": 780, "end_line": 788, "is_async": false, "is_method": false}, {"name": "test_csv_comment_default", "qualified_name": "test_csv_comment_default", "args": ["parallel", "read_csv"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Unless the comment parameter is specified, the CSV reader should\nnot treat any lines as comments.", "start_line": 792, "end_line": 800, "is_async": false, "is_method": false}, {"name": "test_whitespace_before_comment", "qualified_name": "test_whitespace_before_comment", "args": ["parallel", "read_tab"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Readers that don't strip whitespace from data (Tab, RDB)\nshould still treat lines with leading whitespace and then\nthe comment char as comment lines.", "start_line": 804, "end_line": 813, "is_async": false, "is_method": false}, {"name": "test_strip_line_trailing_whitespace", "qualified_name": "test_strip_line_trailing_whitespace", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Readers that strip whitespace from lines should ignore\ntrailing whitespace after the last data value of each\nrow.", "start_line": 817, "end_line": 831, "is_async": false, "is_method": false}, {"name": "test_no_data", "qualified_name": "test_no_data", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "As long as column names are supplied, the C reader\nshould return an empty table in the absence of data.", "start_line": 835, "end_line": 845, "is_async": false, "is_method": false}, {"name": "test_line_endings", "qualified_name": "test_line_endings", "args": ["parallel", "read_basic", "read_commented_header", "read_rdb"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure the fast reader accepts CR and CR+LF\nas newlines.", "start_line": 849, "end_line": 875, "is_async": false, "is_method": false}, {"name": "test_store_comments", "qualified_name": "test_store_comments", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure that the output Table produced by the fast\nreader stores any comment lines in its meta attribute.", "start_line": 879, "end_line": 894, "is_async": false, "is_method": false}, {"name": "test_empty_quotes", "qualified_name": "test_empty_quotes", "args": ["parallel", "read_basic"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure the C reader doesn't segfault when the\ninput data contains empty quotes. [#3407]", "start_line": 898, "end_line": 905, "is_async": false, "is_method": false}, {"name": "test_fast_tab_with_names", "qualified_name": "test_fast_tab_with_names", "args": ["parallel", "read_tab"], "decorators": ["pytest.mark.parametrize('parallel', [True, False])"], "docstring": "Make sure the C reader doesn't segfault when the header for the\nfirst column is missing [#3545]", "start_line": 909, "end_line": 919, "is_async": false, "is_method": false}, {"name": "test_read_big_table", "qualified_name": "test_read_big_table", "args": ["tmpdir"], "decorators": ["pytest.mark.skipif(not os.getenv('TEST_READ_HUGE_FILE'), reason='Environment variable TEST_READ_HUGE_FILE must be defined to run this test')"], "docstring": "Test reading of a huge file.\n\nThis test generates a huge CSV file (~2.3Gb) before reading it (see\nhttps://github.com/astropy/astropy/pull/5319). The test is run only if the\nenvironment variable ``TEST_READ_HUGE_FILE`` is defined. Note that running\nthe test requires quite a lot of memory (~18Gb when ", "start_line": 925, "end_line": 953, "is_async": false, "is_method": false}, {"name": "test_data_out_of_range", "qualified_name": "test_data_out_of_range", "args": ["parallel", "reader"], "decorators": ["pytest.mark.parametrize('reader', [0, 1, 2])", "pytest.mark.parametrize('parallel', [False, pytest.param(True, marks=pytest.mark.xfail(os.name == 'nt', reason='Multiprocessing is currently unsupported on Windows'))])"], "docstring": "Numbers with exponents beyond float64 range (|~4.94e-324 to 1.7977e+308|)\nshall be returned as 0 and +-inf respectively by the C parser, just like\nthe Python parser.\nTest fast converter only to nominal accuracy.", "start_line": 961, "end_line": 1008, "is_async": false, "is_method": false}, {"name": "test_int_out_of_range", "qualified_name": "test_int_out_of_range", "args": ["parallel"], "decorators": ["pytest.mark.parametrize('parallel', [pytest.param(True, marks=pytest.mark.xfail(os.name == 'nt', reason='Multiprocessing is currently unsupported on Windows')), False])"], "docstring": "Integer numbers outside int range shall be returned as string columns\nconsistent with the standard (Python) parser (no 'upcasting' to float).", "start_line": 1015, "end_line": 1048, "is_async": false, "is_method": false}, {"name": "test_fortran_reader", "qualified_name": "test_fortran_reader", "args": ["parallel"], "decorators": ["pytest.mark.parametrize('parallel', [pytest.param(True, marks=pytest.mark.xfail(os.name == 'nt', reason='Multiprocessing is currently unsupported on Windows')), False])"], "docstring":