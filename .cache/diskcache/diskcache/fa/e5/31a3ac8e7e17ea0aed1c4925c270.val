: false, "alias": ""}, {"module": "doctest", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "dottedQuadToNum", "qualified_name": "dottedQuadToNum", "args": ["ip"], "decorators": [], "docstring": "Convert decimal dotted quad string to long integer\n\n>>> int(dottedQuadToNum('1 '))\n1\n>>> int(dottedQuadToNum(' 1.2'))\n16777218\n>>> int(dottedQuadToNum(' 1.2.3 '))\n16908291\n>>> int(dottedQuadToNum('1.2.3.4'))\n16909060\n>>> dottedQuadToNum('255.255.255.255')\n4294967295\n>>> dottedQuadToNum('255.255.255.", "start_line": 274, "end_line": 301, "is_async": false, "is_method": false}, {"name": "numToDottedQuad", "qualified_name": "numToDottedQuad", "args": ["num"], "decorators": [], "docstring": "Convert int or long int to dotted quad string\n\n>>> numToDottedQuad(long(-1))\nTraceback (most recent call last):\nValueError: Not a good numeric IP: -1\n>>> numToDottedQuad(long(1))\n'0.0.0.1'\n>>> numToDottedQuad(long(16777218))\n'1.0.0.2'\n>>> numToDottedQuad(long(16908291))\n'1.2.0.3'\n>>> numToDottedQuad", "start_line": 304, "end_line": 353, "is_async": false, "is_method": false}, {"name": "_is_num_param", "qualified_name": "_is_num_param", "args": ["names", "values", "to_float"], "decorators": [], "docstring": "Return numbers from inputs or raise VdtParamError.\n\nLets ``None`` pass through.\nPass in keyword argument ``to_float=True`` to\nuse float for the conversion rather than int.\n\n>>> _is_num_param(('', ''), (0, 1.0))\n[0, 1]\n>>> _is_num_param(('', ''), (0, 1.0), to_float=True)\n[0.0, 1.0]\n>>> _is_num_param(", "start_line": 746, "end_line": 774, "is_async": false, "is_method": false}, {"name": "is_integer", "qualified_name": "is_integer", "args": ["value", "min", "max"], "decorators": [], "docstring": "A check that tests that a given value is an integer (int, or long)\nand optionally, between bounds. A negative value is accepted, while\na float will fail.\n\nIf the value is a string, then the conversion is done - if possible.\nOtherwise a VdtError is raised.\n\n>>> vtor.check('integer', '-1')\n-1\n>>> vtor", "start_line": 783, "end_line": 836, "is_async": false, "is_method": false}, {"name": "is_float", "qualified_name": "is_float", "args": ["value", "min", "max"], "decorators": [], "docstring": "A check that tests that a given value is a float\n(an integer will be accepted), and optionally - that it is between bounds.\n\nIf the value is a string, then the conversion is done - if possible.\nOtherwise a VdtError is raised.\n\nThis can accept negative values.\n\n>>> vtor.check('float', '2')\n2.0\n\nFrom ", "start_line": 839, "end_line": 888, "is_async": false, "is_method": false}, {"name": "is_boolean", "qualified_name": "is_boolean", "args": ["value"], "decorators": [], "docstring": "Check if the value represents a boolean.\n\n>>> vtor.check('boolean', 0)\n0\n>>> vtor.check('boolean', False)\n0\n>>> vtor.check('boolean', '0')\n0\n>>> vtor.check('boolean', 'off')\n0\n>>> vtor.check('boolean', 'false')\n0\n>>> vtor.check('boolean', 'no')\n0\n>>> vtor.check('boolean', 'nO')\n0\n>>> vtor.check('boo", "start_line": 897, "end_line": 954, "is_async": false, "is_method": false}, {"name": "is_ip_addr", "qualified_name": "is_ip_addr", "args": ["value"], "decorators": [], "docstring": "Check that the supplied value is an Internet Protocol address, v.4,\nrepresented by a dotted-quad string, i.e. '1.2.3.4'.\n\n>>> vtor.check('ip_addr', '1 ')\n'1'\n>>> vtor.check('ip_addr', ' 1.2')\n'1.2'\n>>> vtor.check('ip_addr', ' 1.2.3 ')\n'1.2.3'\n>>> vtor.check('ip_addr', '1.2.3.4')\n'1.2.3.4'\n>>> vtor.c", "start_line": 957, "end_line": 991, "is_async": false, "is_method": false}, {"name": "is_list", "qualified_name": "is_list", "args": ["value", "min", "max"], "decorators": [], "docstring": "Check that the value is a list of values.\n\nYou can optionally specify the minimum and maximum number of members.\n\nIt does no check on list members.\n\n>>> vtor.check('list', ())\n[]\n>>> vtor.check('list', [])\n[]\n>>> vtor.check('list', (1, 2))\n[1, 2]\n>>> vtor.check('list', [1, 2])\n[1, 2]\n>>> vtor.check(", "start_line": 994, "end_line": 1036, "is_async": false, "is_method": false}, {"name": "is_tuple", "qualified_name": "is_tuple", "args": ["value", "min", "max"], "decorators": [], "docstring": "Check that the value is a tuple of values.\n\nYou can optionally specify the minimum and maximum number of members.\n\nIt does no check on members.\n\n>>> vtor.check('tuple', ())\n()\n>>> vtor.check('tuple', [])\n()\n>>> vtor.check('tuple', (1, 2))\n(1, 2)\n>>> vtor.check('tuple', [1, 2])\n(1, 2)\n>>> vtor.check(", "start_line": 1039, "end_line": 1070, "is_async": false, "is_method": false}, {"name": "is_string", "qualified_name": "is_string", "args": ["value", "min", "max"], "decorators": [], "docstring": "Check that the supplied value is a string.\n\nYou can optionally specify the minimum and maximum number of members.\n\n>>> vtor.check('string', '0')\n'0'\n>>> vtor.check('string', 0)\nTraceback (most recent call last):\nVdtTypeError: the value \"0\" is of the wrong type.\n>>> vtor.check('string(2)', '12')\n'12'", "start_line": 1073, "end_line": 1106, "is_async": false, "is_method": false}, {"name": "is_int_list", "qualified_name": "is_int_list", "args": ["value", "min", "max"], "decorators": [], "docstring": "Check that the value is a list of integers.\n\nYou can optionally specify the minimum and maximum number of members.\n\nEach list member is checked that it is an integer.\n\n>>> vtor.check('int_list', ())\n[]\n>>> vtor.check('int_list', [])\n[]\n>>> vtor.check('int_list', (1, 2))\n[1, 2]\n>>> vtor.check('int_li", "start_line": 1109, "end_line": 1129, "is_async": false, "is_method": false}, {"name": "is_bool_list", "qualified_name": "is_bool_list", "args": ["value", "min", "max"], "decorators": [], "docstring": "Check that the value is a list of booleans.\n\nYou can optionally specify the minimum and maximum number of members.\n\nEach list member is checked that it is a boolean.\n\n>>> vtor.check('bool_list', ())\n[]\n>>> vtor.check('bool_list', [])\n[]\n>>> check_res = vtor.check('bool_list', (True, False))\n>>> chec", "start_line": 1132, "end_line": 1154, "is_async": false, "is_method": false}, {"name": "is_float_list", "qualified_name": "is_float_list", "args": ["value", "min", "max"], "decorators": [], "docstring": "Check that the value is a list of floats.\n\nYou can optionally specify the minimum and maximum number of members.\n\nEach list member is checked that it is a float.\n\n>>> vtor.check('float_list', ())\n[]\n>>> vtor.check('float_list', [])\n[]\n>>> vtor.check('float_list', (1, 2.0))\n[1.0, 2.0]\n>>> vtor.check(", "start_line": 1157, "end_line": 1177, "is_async": false, "is_method": false}, {"name": "is_string_list", "qualified_name": "is_string_list", "args": ["value", "min", "max"], "decorators": [], "docstring": "Check that the value is a list of strings.\n\nYou can optionally specify the minimum and maximum number of members.\n\nEach list member is checked that it is a string.\n\n>>> vtor.check('string_list', ())\n[]\n>>> vtor.check('string_list', [])\n[]\n>>> vtor.check('string_list', ('a', 'b'))\n['a', 'b']\n>>> vtor", "start_line": 1180, "end_line": 1203, "is_async": false, "is_method": false}, {"name": "is_ip_addr_list", "qualified_name": "is_ip_addr_list", "args": ["value", "min", "max"], "decorators": [], "docstring": "Check that the value is a list of IP addresses.\n\nYou can optionally specify the minimum and maximum number of members.\n\nEach list member is checked that it is an IP address.\n\n>>> vtor.check('ip_addr_list', ())\n[]\n>>> vtor.check('ip_addr_list', [])\n[]\n>>> vtor.check('ip_addr_list', ('1.2.3.4', '5.6.7", "start_line": 1206, "end_line": 1224, "is_async": false, "is_method": false}, {"name": "force_list", "qualified_name": "force_list", "args": ["value", "min", "max"], "decorators": [], "docstring": "Check that a value is a list, coercing strings into\na list with one member. Useful where users forget the\ntrailing comma that turns a single value into a list.\n\nYou can optionally specify the minimum and maximum number of members.\nA minumum of greater than one will fail if the user only supplies a\ns", "start_line": 1227, "end_line": 1246, "is_async": false, "is_method": false}, {"name": "is_mixed_list", "qualified_name": "is_mixed_list", "args": ["value"], "decorators": [], "docstring": "Check that the value is a list.\nAllow specifying the type of each member.\nWork on lists of specific lengths.\n\nYou specify each member as a positional argument specifying type\n\nEach type should be one of the following strings :\n  'integer', 'float', 'ip_addr', 'string', 'boolean'\n\nSo you can specify ", "start_line": 1259, "end_line": 1313, "is_async": false, "is_method": false}, {"name": "is_option", "qualified_name": "is_option", "args": ["value"], "decorators": [], "docstring": "This check matches the value to any of a set of options.\n\n>>> vtor.check('option(\"yoda\", \"jedi\")', 'yoda')\n'yoda'\n>>> vtor.check('option(\"yoda\", \"jedi\")', 'jed')\nTraceback (most recent call last):\nVdtValueError: the value \"jed\" is unacceptable.\n>>> vtor.check('option(\"yoda\", \"jedi\")', 0)\nTraceback (", "start_line": 1316, "end_line": 1333, "is_async": false, "is_method": false}, {"name": "_test", "qualified_name": "_test", "args": ["value"], "decorators": [], "docstring": "A function that exists for test purposes.\n\n>>> checks = [\n...     '3, 6, min=1, max=3, test=list(a, b, c)',\n...     '3',\n...     '3, 6',\n...     '3,',\n...     'min=1, test=\"a b c\"',\n...     'min=5, test=\"a, b, c\"',\n...     'min=1, max=3, test=\"a, b, c\"',\n...     'min=-100, test=-99',\n...     'min=1,", "start_line": 1336, "end_line": 1417, "is_async": false, "is_method": false}, {"name": "_test2", "qualified_name": "_test2", "args": [], "decorators": [], "docstring": ">>>\n>>> v = Validator()\n>>> v.get_default_value('string(default=\"#ff00dd\")')\n'#ff00dd'\n>>> v.get_default_value('integer(default=3) # comment')\n3", "start_line": 1420, "end_line": 1428, "is_async": false, "is_method": false}, {"name": "_test3", "qualified_name": "_test3", "args": [], "decorators": [], "docstring": ">>> vtor.check('string(default=\"\")', '', missing=True)\n''\n>>> vtor.check('string(default=\"\\n\")', '', missing=True)\n'\\n'\n>>> print(vtor.check('string(default=\"\\n\")', '', missing=True))\n<BLANKLINE>\n<BLANKLINE>\n>>> vtor.check('string()', '\\n')\n'\\n'\n>>> vtor.check('string(default=\"\\n\\n\\n\")', '', missing", "start_line": 1430, "end_line": 1456, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "value"], "decorators": [], "docstring": ">>> raise VdtUnknownCheckError('yoda')\nTraceback (most recent call last):\nVdtUnknownCheckError: the check \"yoda\" is unknown.", "start_line": 377, "end_line": 383, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "name", "value"], "decorators": [], "docstring": ">>> raise VdtParamError('yoda', 'jedi')\nTraceback (most recent call last):\nVdtParamError: passed an incorrect value \"jedi\" for parameter \"yoda\".", "start_line": 389, "end_line": 395, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "value"], "decorators": [], "docstring": ">>> raise VdtTypeError('jedi')\nTraceback (most recent call last):\nVdtTypeError: the value \"jedi\" is of the wrong type.", "start_line": 401, "end_line": 407, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "value"], "decorators": [], "docstring": ">>> raise VdtValueError('jedi')\nTraceback (most recent call last):\nVdtValueError: the value \"jedi\" is unacceptable.", "start_line": 413, "end_line": 419, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "value"], "decorators": [], "docstring": ">>> raise VdtValueTooSmallError('0')\nTraceback (most recent call last):\nVdtValueTooSmallError: the value \"0\" is too small.", "start_line": 425, "end_line": 431, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "value"], "decorators": [], "docstring": ">>> raise VdtValueTooBigError('1')\nTraceback (most recent call last):\nVdtValueTooBigError: the value \"1\" is too big.", "start_line": 437, "end_line": 443, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "value"], "decorators": [], "docstring": ">>> raise VdtValueTooShortError('jed')\nTraceback (most recent call last):\nVdtValueTooShortError: the value \"jed\" is too short.", "start_line": 449, "end_line": 457, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "value"], "decorators": [], "docstring": ">>> raise VdtValueTooLongError('jedie')\nTraceback (most recent call last):\nVdtValueTooLongError: the value \"jedie\" is too long.", "start_line": 463, "end_line": 469, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "functions"], "decorators": [], "docstring": ">>> vtri = Validator()", "start_line": 563, "end_line": 590, "is_async": false, "is_method": false}, {"name": "check", "qualified_name": "check", "args": ["self", "check", "value", "missing"], "decorators": [], "docstring": "Usage: check(check, value)\n\nArguments:\n    check: string representing check to apply (including arguments)\n    value: object to be checked\nReturns value, converted to correct type if necessary\n\nIf the check fails, raises a ``ValidateError`` subclass.\n\n>>> vtor.check('yoda', '')\nTraceback (most recen", "start_line": 593, "end_line": 625, "is_async": false, "is_method": false}, {"name": "_handle_none", "qualified_name": "_handle_none", "args": ["self", "value"], "decorators": [], "docstring": "", "start_line": 628, "end_line": 634, "is_async": false, "is_method": false}, {"name": "_parse_with_caching", "qualified_name": "_parse_with_caching", "args": ["self", "check"], "decorators": [], "docstring": "", "start_line": 637, "end_line": 648, "is_async": false, "is_method": false}, {"name": "_check_value", "qualified_name": "_check_value", "args": ["self", "value", "fun_name", "fun_args", "fun_kwargs"], "decorators": [], "docstring": "", "start_line": 651, "end_line": 657, "is_async": false, "is_method": false}, {"name": "_parse_check", "qualified_name": "_parse_check", "args": ["self", "check"], "decorators": [], "docstring": "", "start_line": 660, "end_line": 697, "is_async": false, "is_method": false}, {"name": "_unquote", "qualified_name": "_unquote", "args": ["self", "val"], "decorators": [], "docstring": "Unquote a value if necessary.", "start_line": 700, "end_line": 704, "is_async": false, "is_method": false}, {"name": "_list_handle", "qualified_name": "_list_handle", "args": ["self", "listmatch"], "decorators": [], "docstring": "Take apart a ``keyword=list('val, 'val')`` type string.", "start_line": 707, "end_line": 714, "is_async": false, "is_method": false}, {"name": "_pass", "qualified_name": "_pass", "args": ["self", "value"], "decorators": [], "docstring": "Dummy check that always passes\n\n>>> vtor.check('', 0)\n0\n>>> vtor.check('', '0')\n'0'", "start_line": 717, "end_line": 726, "is_async": false, "is_method": false}, {"name": "get_default_value", "qualified_name": "get_default_value", "args": ["self", "check"], "decorators": [], "docstring": "Given a check, return the default value for the check\n(converted to the right type).\n\nIf the check doesn't specify a default value then a\n``KeyError`` will be raised.", "start_line": 729, "end_line": 743, "is_async": false, "is_method": false}, {"name": "bool", "qualified_name": "bool", "args": ["val"], "decorators": [], "docstring": "Simple boolean equivalent function. ", "start_line": 266, "end_line": 271, "is_async": false, "is_method": false}], "classes": [{"name": "ValidateError", "bases": ["Exception"], "methods": [], "docstring": "This error indicates that the check failed.\nIt can be the base class for more specific errors.\n\nAny check function that fails ought to raise this error.\n(or a subclass)\n\n>>> raise ValidateError\nTraceback (most recent call last):\nValidateError", "start_line": 356, "end_line": 367}, {"name": "VdtMissingValue", "bases": ["ValidateError"], "methods": [], "docstring": "No value was supplied to a check that needed one.", "start_line": 370, "end_line": 371}, {"name": "VdtUnknownCheckError", "bases": ["ValidateError"], "methods": ["__init__"], "docstring": "An unknown check function was requested", "start_line": 374, "end_line": 383}, {"name": "VdtParamError", "bases": ["SyntaxError"], "methods": ["__init__"], "docstring": "An incorrect parameter was passed", "start_line": 386, "end_line": 395}, {"name": "VdtTypeError", "bases": ["ValidateError"], "methods": ["__init__"], "docstring": "The value supplied was of the wrong type", "start_line": 398, "end_line": 407}, {"name": "VdtValueError", "bases": ["ValidateError"], "methods": ["__init__"], "docstring": "The value supplied was of the correct type, but was not an allowed value.", "start_line": 410, "end_line": 419}, {"name": "VdtValueTooSmallError", "bases": ["VdtValueError"], "methods": ["__init__"], "docstring": "The value supplied was of the correct type, but was too small.", "start_line": 422, "end_line": 431}, {"name": "VdtValueTooBigError", "bases": ["VdtValueError"], "methods": ["__init__"], "docstring": "The value supplied was of the correct type, but was too big.", "start_line": 434, "end_line": 443}, {"name": "VdtValueTooShortError", "bases": ["VdtValueError"], "methods": ["__init__"], "docstring": "The value supplied was of the correct type, but was too short.", "start_line": 446, "end_line": 457}, {"name": "VdtValueTooLongError", "bases": ["VdtValueError"], "methods": ["__init__"], "docstring": "The value supplied was of the correct type, but was too long.", "start_line": 460, "end_line": 469}, {"name": "Validator", "bases": ["object"], "methods": ["__init__", "check", "_handle_none", "_parse_with_caching", "_check_value", "_parse_check", "_unquote", "_list_handle", "_pass", "get_default_value"], "docstring": "Validator is an object that allows you to register a set of 'checks'.\nThese checks take input and test that it conforms to the check.\n\nThis can also involve converting the value from a string into\nthe correct datatype.\n\nThe ``check`` method takes an input string which configures which\ncheck is to be", "start_line": 472, "end_line": 743}], "calls": [], "module_docstring": "The Validator object is used to check that supplied values\nconform to a specification.\n\nThe value can be supplied as a string - e.g. from a config file.\nIn this case the check will also *convert* the value to\nthe required type. This allows you to add validation\nas a transparent layer to access data stored as strings.\nThe validation checks that the data is correct *and*\nconverts it to the expected type.\n\nSome standard checks are provided for basic data types.\nAdditional checks are easy to write. They can be\nprovided when the ``Validator`` is instantiated or\nadded afterwards.\n\nThe standard functions work with the following basic data types :\n\n* integers\n* floats\n* booleans\n* strings\n* ip_addr\n\nplus lists of these datatypes\n\nAdding additional checks is done through coding simple functions.\n\nThe full set of standard checks are :\n\n* 'integer': matches integer values (including negative)\n             Takes optional 'min' and 'max' arguments : ::\n\n               integer()\n               integer(3, 9)  # any value from 3 to 9\n               integer(min=0) # any positive value\n               integer(max=9)\n\n* 'float': matches float values\n           Has the same parameters as the integer check.\n\n* 'boolean': matches boolean values - ``True`` or ``False``\n             Acceptable string values for True are :\n               true, on, yes, 1\n             Acceptable string values for False are :\n               false, off, no, 0\n\n             Any other value raises an error.\n\n* 'ip_addr': matches an Internet Protocol address, v.4, represented\n             by a dotted-quad string, i.e. '1.2.3.4'.\n\n* 'string': matches any string.\n            Takes optional keyword args 'min' and 'max'\n            to specify min and max lengths of the string.\n\n* 'list': matches any list.\n          Takes optional keyword args 'min', and 'max' to specify min and\n          max sizes of the list. (Always returns a list.)\n\n* 'tuple': matches any tuple.\n          Takes optional keyword args 'min', and 'max' to specify min and\n          max sizes of the tuple. (Always returns a tuple.)\n\n* 'int_list': Matches a list of integers.\n              Takes the same arguments as list.\n\n* 'float_list': Matches a list of floats.\n                Takes the same arguments as list.\n\n* 'bool_list': Matches a list of boolean values.\n               Takes the same arguments as list.\n\n* 'ip_addr_list': Matches a list of IP addresses.\n                 Takes the same arguments as list.\n\n* 'string_list': Matches a list of strings.\n                 Takes the same arguments as list.\n\n* 'mixed_list': Matches a list with different types in\n                specific positions. List size must match\n                the number of arguments.\n\n                Each position can be one of :\n                'integer', 'float', 'ip_addr', 'string', 'boolean'\n\n                So to specify a list with two strings followed\n                by two integers, you write the check as : ::\n\n                  mixed_list('string', 'string', 'integer', 'integer')\n\n* 'pass': This check matches everything ! It never fails\n          and the value is unchanged.\n\n          It is also the default if no check is specified.\n\n* 'option': This check matches any from a list of options.\n            You specify this check with : ::\n\n              option('option 1', 'option 2', 'option 3')\n\nYou can supply a default value (returned if no value is supplied)\nusing the default keyword argument.\n\nYou specify a list argument for default using a list constructor syntax in\nthe check : ::\n\n    checkname(arg1, arg2, default=list('val 1', 'val 2', 'val 3'))\n\nA badly formatted set of arguments will raise a ``VdtParamError``.", "parse_error": ""}, {"file_path": "astropy/extern/configobj/__init__.py", "file_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/extern/configobj/configobj.py", "file_hash": "1bd374b063b8b240a449761811b14603f1d6a2457c8fd50403e300275cc56d1c", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "collections", "names": [], "is_from": false, "alias": ""}, {"module": "codecs", "names": ["BOM_UTF8", "BOM_UTF16", "BOM_UTF16_BE", "BOM_UTF16_LE"], "is_from": true, "alias": ""}, {"module": "ast", "names": [], "is_from": false, "alias": ""}, {"module": "compiler", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "validate", "names": ["VdtMissingValue"], "is_from": true, "alias": ""}], "functions": [{"name": "match_utf8", "qualified_name": "match_utf8", "args": ["encoding"], "decorators": [], "docstring": "", "start_line": 67, "end_line": 68, "is_async": false, "is_method": false}, {"name": "getObj", "qualified_name": "getObj", "args": ["s"], "decorators": [], "docstring": "", "start_line": 127, "end_line": 133, "is_async": false, "is_method": false}, {"name": "unrepr", "qualified_name": "unrepr", "args": ["s"], "decorators": [], "docstring": "", "start_line": 198, "end_line": 204, "is_async": false, "is_method": false}, {"name": "__newobj__", "qualified_name": "__newobj__", "args": ["cls"], "decorators": [], "docstring": "", "start_line": 453, "end_line": 455, "is_async": false, "is_method": false}, {"name": "flatten_errors", "qualified_name": "flatten_errors", "args": ["cfg", "res", "levels", "results"], "decorators": [], "docstring": "An example function that will turn a nested dictionary of results\n(as returned by ``ConfigObj.validate``) into a flat list.\n\n``cfg`` is the ConfigObj instance being checked, ``res`` is the results\ndictionary returned by ``validate``.\n\n(This is a recursive function, so you shouldn't use the ``levels`", "start_line": 2391, "end_line": 2448, "is_async": false, "is_method": false}, {"name": "get_extra_values", "qualified_name": "get_extra_values", "args": ["conf", "_prepend"], "decorators": [], "docstring": "Find all the values and sections not in the configspec from a validated\nConfigObj.\n\n``get_extra_values`` returns a list of tuples where each tuple represents\neither an extra section, or an extra value.\n\nThe tuples contain two values, a tuple representing the section the value\nis in and the name of t", "start_line": 2451, "end_line": 2474, "is_async": false, "is_method": false}, {"name": "build", "qualified_name": "build", "args": ["self", "o"], "decorators": [], "docstring": "", "start_line": 142, "end_line": 145, "is_async": false, "is_method": false}, {"name": "build_List", "qualified_name": "build_List", "args": ["self", "o"], "decorators": [], "docstring": "", "start_line": 147, "end_line": 148, "is_async": false, "is_method": false}, {"name": "build_Const", "qualified_name": "build_Const", "args": ["self", "o"], "decorators": [], "docstring": "", "start_line": 150, "end_line": 151, "is_async": false, "is_method": false}, {"name": "build_Dict", "qualified_name": "build_Dict", "args": ["self", "o"], "decorators": [], "docstring": "", "start_line": 153, "end_line": 158, "is_async": false, "is_method": false}, {"name": "build_Tuple", "qualified_name": "build_Tuple", "args": ["self", "o"], "decorators": [], "docstring": "", "start_line": 160, "end_line": 161, "is_async": false, "is_method": false}, {"name": "build_Name", "qualified_name": "build_Name", "args": ["self", "o"], "decorators": [], "docstring": "", "start_line": 163, "end_line": 172, "is_async": false, "is_method": false}, {"name": "build_Add", "qualified_name": "build_Add", "args": ["self", "o"], "decorators": [], "docstring": "", "start_line": 174, "end_line": 182, "is_async": false, "is_method": false}, {"name": "build_Getattr", "qualified_name": "build_Getattr", "args": ["self", "o"], "decorators": [], "docstring": "", "start_line": 184, "end_line": 186, "is_async": false, "is_method": false}, {"name": "build_UnarySub", "qualified_name": "build_UnarySub", "args": ["self", "o"], "decorators": [], "docstring": "", "start_line": 188, "end_line": 189, "is_async": false, "is_method": false}, {"name": "build_UnaryAdd", "qualified_name": "build_UnaryAdd", "args": ["self", "o"], "decorators": [], "docstring": "", "start_line": 191, "end_line": 192, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "message", "line_number", "line"], "decorators": [], "docstring": "", "start_line": 212, "end_line": 215, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 237, "end_line": 238, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "option"], "decorators": [], "docstring": "", "start_line": 260, "end_line": 263, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "option"], "decorators": [], "docstring": "", "start_line": 275, "end_line": 277, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "section"], "decorators": [], "docstring": "", "start_line": 297, "end_line": 299, "is_async": false, "is_method": false}, {"name": "interpolate", "qualified_name": "interpolate", "args": ["self", "key", "value"], "decorators": [], "docstring": "", "start_line": 302, "end_line": 352, "is_async": false, "is_method": false}, {"name": "_fetch", "qualified_name": "_fetch", "args": ["self", "key"], "decorators": [], "docstring": "Helper function to fetch values from owning section.\n\nReturns a 2-tuple: the value, and the section where it was found.", "start_line": 355, "end_line": 386, "is_async": false, "is_method": false}, {"name": "_parse_match", "qualified_name": "_parse_match", "args": ["self", "match"], "decorators": [], "docstring": "Implementation-dependent helper function.\n\nWill be passed a match object corresponding to the interpolation\nkey we just found (e.g., \"%(foo)s\" or \"$foo\"). Should look up that\nkey in the appropriate config file section (using the ``_fetch()``\nhelper function) and return a 3-tuple: (key, value, sectio", "start_line": 389, "end_line": 405, "is_async": false, "is_method": false}, {"name": "_parse_match", "qualified_name": "_parse_match", "args": ["self", "match"], "decorators": [], "docstring": "", "start_line": 414, "end_line": 417, "is_async": false, "is_method": false}, {"name": "_parse_match", "qualified_name": "_parse_match", "args": ["self", "match"], "decorators": [], "docstring": "", "start_line": 433, "end_line": 444, "is_async": false, "is_method": false}, {"name": "__setstate__", "qualified_name": "__setstate__", "args": ["self", "state"], "decorators": [], "docstring": "", "start_line": 476, "end_line": 478, "is_async": false, "is_method": false}, {"name": "__reduce__", "qualified_name": "__reduce__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 480, "end_line": 482, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "parent", "depth", "main", "indict", "name"], "decorators": [], "docstring": "* parent is the section above\n* depth is the depth level of this section\n* main is the main ConfigObj\n* indict is a dictionary to initialise the section with", "start_line": 485, "end_line": 508, "is_async": false, "is_method": false}, {"name": "_initialise", "qualified_name": "_initialise", "args": ["self"], "decorators": [], "docstring": "", "start_line": 511, "end_line": 525, "is_async": false, "is_method": false}, {"name": "_interpolate", "qualified_name": "_interpolate", "args": ["self", "key", "value"], "decorators": [], "docstring": "", "start_line": 528, "end_line": 548, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "key"], "decorators": [], "docstring": "Fetch the item and do string interpolation.", "start_line": 551, "end_line": 565, "is_async": false, "is_method": false}, {"name": "__setitem__", "qualified_name": "__setitem__", "args": ["self", "key", "value", "unrepr"], "decorators": [], "docstring": "Correctly set a value.\n\nMaking dictionary values Section instances.\n(We have to special case 'Section' instances - which are also dicts)\n\nKeys must be strings.\nValues need only be strings (or lists of strings) if\n``main.stringify`` is set.\n\n``unrepr`` must be set when setting a value to a dictionary", "start_line": 568, "end_line": 624, "is_async": false, "is_method": false}, {"name": "__delitem__", "qualified_name": "__delitem__", "args": ["self", "key"], "decorators": [], "docstring": "Remove items from the sequence when deleting.", "start_line": 627, "end_line": 635, "is_async": false, "is_method": false}, {"name": "get", "qualified_name": "get", "args": ["self", "key", "default"], "decorators": [], "docstring": "A version of ``get`` that doesn't bypass string interpolation.", "start_line": 638, "end_line": 643, "is_async": false, "is_method": false}, {"name": "update", "qualified_name": "update", "args": ["self", "indict"], "decorators": [], "docstring": "A version of update that uses our ``__setitem__``.", "start_line": 646, "end_line": 651, "is_async": false, "is_method": false}, {"name": "pop", "qualified_name": "pop", "args": ["self", "key", "default"], "decorators": [], "docstring": "'D.pop(k[,d]) -> v, remove specified key and return the corresponding value.\nIf key is not found, d is returned if given, otherwise KeyError is raised'", "start_line": 654, "end_line": 667, "is_async": false, "is_method": false}, {"name": "popitem", "qualified_name": "popitem", "args": ["self"], "decorators": [], "docstring": "Pops the first (key,val)", "start_line": 670, "end_line": 678, "is_async": false, "is_method": false}, {"name": "clear", "qualified_name": "clear", "args": ["self"], "decorators": [], "docstring": "A version of clear that also affects scalars/sections\nAlso clears comments and configspec.\n\nLeaves other attributes alone :\n    depth/main/parent are not affected", "start_line": 681, "end_line": 696, "is_async": false, "is_method": false}, {"name": "setdefault", "qualified_name": "setdefault", "args": ["self", "key", "default"], "decorators": [], "docstring": "A version of setdefault that sets sequence if appropriate.", "start_line": 699, "end_line": 705, "is_async": false, "is_method": false}, {"name": "items", "qualified_name": "items", "args": ["self"], "decorators": [], "docstring": "D.items() -> list of D's (key, value) pairs, as 2-tuples", "start_line": 708, "end_line": 710, "is_async": false, "is_method": false}, {"name": "keys", "qualified_name": "keys", "args": ["self"], "decorators": [], "docstring": "D.keys() -> list of D's keys", "start_line": 713, "end_line": 715, "is_async": false, "is_method": false}, {"name": "values", "qualified_name": "values", "args": ["self"], "decorators": [], "docstring": "D.values() -> list of D's values", "start_line": 718, "end_line": 720, "is_async": false, "is_method": false}, {"name": "iteritems", "qualified_name": "iteritems", "args": ["self"], "decorators": [], "docstring": "D.iteritems() -> an iterator over the (key, value) items of D", "start_line": 723, "end_line": 725, "is_async": false, "is_method": false}, {"name": "iterkeys", "qualified_name": "iterkeys", "args": ["self"], "decorators": [], "docstring": "D.iterkeys() -> an iterator over the keys of D", "start_line": 728, "end_line": 730, "is_async": false, "is_method": false}, {"name": "itervalues", "qualified_name": "itervalues", "args": ["self"], "decorators": [], "docstring": "D.itervalues() -> an iterator over the values of D", "start_line": 735, "end_line": 737, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "x.__repr__() <==> repr(x)", "start_line": 740, "end_line": 748, "is_async": false, "is_method": false}, {"name": "dict", "qualified_name": "dict", "args": ["self"], "decorators": [], "docstring": "Return a deepcopy of self as a dictionary.\n\nAll members that are ``Section`` instances are recursively turned to\nordinary dictionaries - by calling their ``dict`` method.\n\n>>> n = a.dict()\n>>> n == a\n1\n>>> n is a\n0", "start_line": 756, "end_line": 781, "is_async": false, "is_method": false}, {"name": "merge", "qualified_name": "merge", "args": ["self", "indict"], "decorators": [], "docstring": "A recursive update - useful for merging config files.\n\n>>> a = '''[section1]\n...     option1 = True\n...     [[subsection]]\n...     more_options = False\n...     # end of file'''.splitlines()\n>>> b = '''# File is user.ini\n...     [section1]\n...     option1 = False\n...     # end of file'''.splitlines()", "start_line": 784, "end_line": 808, "is_async": false, "is_method": false}, {"name": "rename", "qualified_name": "rename", "args": ["self", "oldkey", "newkey"], "decorators": [], "docstring": "Change a keyname to another, without changing position in sequence.\n\nImplemented so that transformations can be made on keys,\nas well as on values. (used by encode and decode)\n\nAlso renames comments.", "start_line": 811, "end_line": 838, "is_async": false, "is_method": false}, {"name": "walk", "qualified_name": "walk", "args": ["self", "function", "raise_errors", "call_on_sections"], "decorators": [], "docstring": "Walk every member and call a function on the keyword and value.\n\nReturn a dictionary of the return values\n\nIf the function raises an exception, raise the errror\nunless ``raise_errors=False``, in which case set the return value to\n``False``.\n\nAny unrecognised keyword arguments you pass to walk, will ", "start_line": 841, "end_line": 923, "is_async": false, "is_method": false}, {"name": "as_bool", "qualified_name": "as_bool", "args": ["self", "key"], "decorators": [], "docstring": "Accepts a key as input. The corresponding value must be a string or\nthe objects (``True`` or 1) or (``False`` or 0). We allow 0 and 1 to\nretain compatibility with Python 2.2.\n\nIf the string is one of  ``True``, ``On``, ``Yes``, or ``1`` it returns\n``True``.\n\nIf the string is one of  ``False``, ``Off", "start_line": 926, "end_line": 967, "is_async": false, "is_method": false}, {"name": "as_int", "qualified_name": "as_int", "args": ["self", "key"], "decorators": [], "docstring": "A convenience method which coerces the specified value to an integer.\n\nIf the value is an invalid literal for ``int``, a ``ValueError`` will\nbe raised.\n\n>>> a = ConfigObj()\n>>> a['a'] = 'fish'\n>>> a.as_int('a')\nTraceback (most recent call last):\nValueError: invalid literal for int() with base 10: 'f", "start_line": 970, "end_line": 990, "is_async": false, "is_method": false}, {"name": "as_float", "qualified_name": "as_float", "args": ["self", "key"], "decorators": [], "docstring": "A convenience method which coerces the specified value to a float.\n\nIf the value is an invalid literal for ``float``, a ``ValueError`` will\nbe raised.\n\n>>> a = ConfigObj()\n>>> a['a'] = 'fish'\n>>> a.as_float('a')  #doctest: +IGNORE_EXCEPTION_DETAIL\nTraceback (most recent call last):\nValueError: inval", "start_line": 993, "end_line": 1012, "is_async": false, "is_method": false}, {"name": "as_list", "qualified_name": "as_list", "args": ["self", "key"], "decorators": [], "docstring": "A convenience method which fetches the specified value, guaranteeing\nthat it is a list.\n\n>>> a = ConfigObj()\n>>> a['a'] = 1\n>>> a.as_list('a')\n[1]\n>>> a['a'] = (1,)\n>>> a.as_list('a')\n[1]\n>>> a['a'] = [1]\n>>> a.as_list('a')\n[1]", "start_line": 1015, "end_line": 1034, "is_async": false, "is_method": false}, {"name": "restore_default", "qualified_name": "restore_default", "args": ["self", "key"], "decorators": [], "docstring": "Restore (and return) default value for the specified key.\n\nThis method will only work for a ConfigObj that was created\nwith a configspec and has been validated.\n\nIf there is no default value for this key, ``KeyError`` is raised.", "start_line": 1037, "end_line": 1050, "is_async": false, "is_method": false}, {"name": "restore_defaults", "qualified_name": "restore_defaults", "args": ["self"], "decorators": [], "docstring": "Recursively restore default values to all members\nthat have them.\n\nThis method will only work for a ConfigObj that was created\nwith a configspec and has been validated.\n\nIt doesn't delete or modify entries without default values.", "start_line": 1053, "end_line": 1067, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "infile", "options", "configspec", "encoding", "interpolation", "raise_errors", "list_values", "create_empty", "file_error", "stringify", "indent_type", "default_encoding", "unrepr", "write_empty_values", "_inspec"], "decorators": [], "docstring": "Parse a config file or create a config file object.\n\n``ConfigObj(infile=None, configspec=None, encoding=None,\n            interpolation=True, raise_errors=False, list_values=True,\n            create_empty=False, file_error=False, stringify=True,\n            indent_type=None, default_encoding=None, u", "start_line": 1173, "end_line": 1228, "is_async": false, "is_method": false}, {"name": "_load", "qualified_name": "_load", "args": ["self", "infile", "configspec"], "decorators": [], "docstring": "", "start_line": 1231, "end_line": 1324, "is_async": false, "is_method": false}, {"name": "_initialise", "qualified_name": "_initialise", "args": ["self", "options"], "decorators": [], "docstring": "", "start_line": 1327, "end_line": 1356, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1359, "end_line": 1367, "is_async": false, "is_method": false}, {"name": "_handle_bom", "qualified_name": "_handle_bom", "args": ["self", "infile"], "decorators": [], "docstring": "Handle any BOM, and decode if necessary.\n\nIf an encoding is specified, that *must* be used - but the BOM should\nstill be removed (and the BOM attribute set).\n\n(If the encoding is wrongly specified, then a BOM for an alternative\nencoding won't be discovered or removed.)\n\nIf an encoding is not specifi", "start_line": 1370, "end_line": 1479, "is_async": false, "is_method": false}, {"name": "_a_to_u", "qualified_name": "_a_to_u", "args": ["self", "aString"], "decorators": [], "docstring": "Decode ASCII strings to unicode if a self.encoding is specified.", "start_line": 1482, "end_line": 1487, "is_async": false, "is_method": false}, {"name": "_decode", "qualified_name": "_decode", "args": ["self", "infile", "encoding"], "decorators": [], "docstring": "Decode infile to unicode. Using the specified encoding.\n\nif is a string, it also needs converting to a list.", "start_line": 1490, "end_line": 1512, "is_async": false, "is_method": false}, {"name": "_decode_element", "qualified_name": "_decode_element", "args": ["self", "line"], "decor