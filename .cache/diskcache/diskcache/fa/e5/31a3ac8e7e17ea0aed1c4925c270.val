": "", "start_line": 149, "end_line": 170, "is_async": false, "is_method": false}, {"name": "run_tests", "qualified_name": "run_tests", "args": ["self"], "decorators": [], "docstring": "", "start_line": 184, "end_line": 241, "is_async": false, "is_method": false}, {"name": "make_test_runner_in", "qualified_name": "make_test_runner_in", "args": ["cls", "path"], "decorators": ["classmethod"], "docstring": "Constructs a `TestRunner` to run in the given path, and returns a\n``test()`` function which takes the same arguments as\n`TestRunner.run_tests`.\n\nThe returned ``test()`` function will be defined in the module this\nwas called from.  This is used to implement the ``astropy.test()``\nfunction (or the equ", "start_line": 244, "end_line": 274, "is_async": false, "is_method": false}, {"name": "coverage", "qualified_name": "coverage", "args": ["self", "coverage", "kwargs"], "decorators": ["keyword(priority=1000)"], "docstring": "", "start_line": 284, "end_line": 292, "is_async": false, "is_method": false}, {"name": "package", "qualified_name": "package", "args": ["self", "package", "kwargs"], "decorators": ["keyword(priority=1)"], "docstring": "package : str, optional\n    The name of a specific package to test, e.g. 'io.fits' or 'utils'.\n    If nothing is specified all default Astropy tests are run.", "start_line": 297, "end_line": 315, "is_async": false, "is_method": false}, {"name": "test_path", "qualified_name": "test_path", "args": ["self", "test_path", "kwargs"], "decorators": ["keyword()"], "docstring": "test_path : str, optional\n    Specify location to test by path. May be a single file or\n    directory. Must be specified absolutely or relative to the\n    calling directory.", "start_line": 318, "end_line": 355, "is_async": false, "is_method": false}, {"name": "args", "qualified_name": "args", "args": ["self", "args", "kwargs"], "decorators": ["keyword()"], "docstring": "args : str, optional\n    Additional arguments to be passed to ``pytest.main`` in the ``args``\n    keyword argument.", "start_line": 358, "end_line": 367, "is_async": false, "is_method": false}, {"name": "plugins", "qualified_name": "plugins", "args": ["self", "plugins", "kwargs"], "decorators": ["keyword()"], "docstring": "plugins : list, optional\n    Plugins to be passed to ``pytest.main`` in the ``plugins`` keyword\n    argument.", "start_line": 370, "end_line": 376, "is_async": false, "is_method": false}, {"name": "verbose", "qualified_name": "verbose", "args": ["self", "verbose", "kwargs"], "decorators": ["keyword()"], "docstring": "verbose : bool, optional\n    Convenience option to turn on verbose output from py.test. Passing\n    True is the same as specifying ``-v`` in ``args``.", "start_line": 379, "end_line": 388, "is_async": false, "is_method": false}, {"name": "pastebin", "qualified_name": "pastebin", "args": ["self", "pastebin", "kwargs"], "decorators": ["keyword()"], "docstring": "pastebin : ('failed', 'all', None), optional\n    Convenience option for turning on py.test pastebin output. Set to\n    'failed' to upload info for failed tests, or 'all' to upload info\n    for all tests.", "start_line": 391, "end_line": 404, "is_async": false, "is_method": false}, {"name": "remote_data", "qualified_name": "remote_data", "args": ["self", "remote_data", "kwargs"], "decorators": ["keyword(default_value='none')"], "docstring": "remote_data : {'none', 'astropy', 'any'}, optional\n    Controls whether to run tests marked with @pytest.mark.remote_data. This can be\n    set to run no tests with remote data (``none``), only ones that use\n    data from http://data.astropy.org (``astropy``), or all tests that\n    use remote data (`", "start_line": 407, "end_line": 429, "is_async": false, "is_method": false}, {"name": "pep8", "qualified_name": "pep8", "args": ["self", "pep8", "kwargs"], "decorators": ["keyword()"], "docstring": "pep8 : bool, optional\n    Turn on PEP8 checking via the pytest-pep8 plugin and disable normal\n    tests. Same as specifying ``--pep8 -k pep8`` in ``args``.", "start_line": 432, "end_line": 447, "is_async": false, "is_method": false}, {"name": "pdb", "qualified_name": "pdb", "args": ["self", "pdb", "kwargs"], "decorators": ["keyword()"], "docstring": "pdb : bool, optional\n    Turn on PDB post-mortem analysis for failing tests. Same as\n    specifying ``--pdb`` in ``args``.", "start_line": 450, "end_line": 458, "is_async": false, "is_method": false}, {"name": "open_files", "qualified_name": "open_files", "args": ["self", "open_files", "kwargs"], "decorators": ["keyword()"], "docstring": "open_files : bool, optional\n    Fail when any tests leave files open.  Off by default, because\n    this adds extra run time to the test suite.  Requires the\n    ``psutil`` package.", "start_line": 461, "end_line": 485, "is_async": false, "is_method": false}, {"name": "parallel", "qualified_name": "parallel", "args": ["self", "parallel", "kwargs"], "decorators": ["keyword(0)"], "docstring": "parallel : int, optional\n    When provided, run the tests in parallel on the specified\n    number of CPUs.  If parallel is negative, it will use the all\n    the cores on the machine.  Requires the ``pytest-xdist`` plugin.", "start_line": 488, "end_line": 504, "is_async": false, "is_method": false}, {"name": "docs_path", "qualified_name": "docs_path", "args": ["self", "docs_path", "kwargs"], "decorators": ["keyword()"], "docstring": "docs_path : str, optional\n    The path to the documentation .rst files.", "start_line": 507, "end_line": 524, "is_async": false, "is_method": false}, {"name": "skip_docs", "qualified_name": "skip_docs", "args": ["self", "skip_docs", "kwargs"], "decorators": ["keyword()"], "docstring": "skip_docs : `bool`, optional\n    When `True`, skips running the doctests in the .rst files.", "start_line": 527, "end_line": 533, "is_async": false, "is_method": false}, {"name": "repeat", "qualified_name": "repeat", "args": ["self", "repeat", "kwargs"], "decorators": ["keyword()"], "docstring": "repeat : `int`, optional\n    If set, specifies how many times each test should be run. This is\n    useful for diagnosing sporadic failures.", "start_line": 536, "end_line": 545, "is_async": false, "is_method": false}, {"name": "run_tests", "qualified_name": "run_tests", "args": ["self"], "decorators": [], "docstring": "", "start_line": 548, "end_line": 555, "is_async": false, "is_method": false}, {"name": "keyword", "qualified_name": "keyword", "args": [], "decorators": [], "docstring": "", "start_line": 53, "end_line": 54, "is_async": false, "is_method": false}, {"name": "test", "qualified_name": "test", "args": [], "decorators": ["wraps(runner.run_tests, ('__doc__',), exclude_args=('self',))"], "docstring": "", "start_line": 258, "end_line": 259, "is_async": false, "is_method": false}], "classes": [{"name": "keyword", "bases": [], "methods": ["__init__", "__call__"], "docstring": "A decorator to mark a method as keyword argument for the ``TestRunner``.\n\nParameters\n----------\ndefault_value : `object`\n    The default value for the keyword argument. (Default: `None`)\n\npriority : `int`\n    keyword argument methods are executed in order of descending priority.", "start_line": 35, "end_line": 62}, {"name": "TestRunnerBase", "bases": [], "methods": ["__init__", "__new__", "_generate_args", "run_tests", "make_test_runner_in"], "docstring": "The base class for the TestRunner.\n\nA test runner can be constructed by creating a subclass of this class and\ndefining 'keyword' methods. These are methods that have the\n`~astropy.tests.runner.keyword` decorator, these methods are used to\nconstruct allowed keyword arguments to the\n`~astropy.tests.ru", "start_line": 65, "end_line": 274}, {"name": "TestRunner", "bases": ["TestRunnerBase"], "methods": ["coverage", "package", "test_path", "args", "plugins", "verbose", "pastebin", "remote_data", "pep8", "pdb", "open_files", "parallel", "docs_path", "skip_docs", "repeat", "run_tests"], "docstring": "A test runner for astropy 