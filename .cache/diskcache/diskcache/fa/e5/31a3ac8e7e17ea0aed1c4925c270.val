ng": "Maximum along a given axis.\n\nThis is similar to :meth:`~numpy.ndarray.max`, but adapted to ensure\nthat the full precision given by the two doubles ``jd1`` and ``jd2``\nis used, and that corresponding attributes are copied.\n\nNote that the ``out`` argument is present only for compatibility with\n``np.ma", "start_line": 1052, "end_line": 1066, "is_async": false, "is_method": false}, {"name": "ptp", "qualified_name": "ptp", "args": ["self", "axis", "out", "keepdims"], "decorators": [], "docstring": "Peak to peak (maximum - minimum) along a given axis.\n\nThis is similar to :meth:`~numpy.ndarray.ptp`, but adapted to ensure\nthat the full precision given by the two doubles ``jd1`` and ``jd2``\nis used.\n\nNote that the ``out`` argument is present only for compatibility with\n`~numpy.ptp`; since `Time` i", "start_line": 1068, "end_line": 1083, "is_async": false, "is_method": false}, {"name": "sort", "qualified_name": "sort", "args": ["self", "axis"], "decorators": [], "docstring": "Return a copy sorted along the specified axis.\n\nThis is similar to :meth:`~numpy.ndarray.sort`, but internally uses\nindexing with :func:`~numpy.lexsort` to ensure that the full precision\ngiven by the two doubles ``jd1`` and ``jd2`` is kept, and that\ncorresponding attributes are properly sorted and c", "start_line": 1085, "end_line": 1100, "is_async": false, "is_method": false}, {"name": "cache", "qualified_name": "cache", "args": ["self"], "decorators": ["lazyproperty"], "docstring": "Return the cache associated with this instance.", "start_line": 1103, "end_line": 1107, "is_async": false, "is_method": false}, {"name": "__getattr__", "qualified_name": "__getattr__", "args": ["self", "attr"], "decorators": [], "docstring": "Get dynamic attributes to output format or do timescale conversion.", "start_line": 1109, "end_line": 1147, "is_async": false, "is_method": false}, {"name": "__dir__", "qualified_name": "__dir__", "args": ["self"], "decorators": ["override__dir__"], "docstring"