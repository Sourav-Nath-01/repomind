oline_human", "qualified_name": "test_read_twoline_human", "args": [], "decorators": [], "docstring": "Read text table designed for humans and test having position line\nbefore the header line", "start_line": 388, "end_line": 406, "is_async": false, "is_method": false}, {"name": "test_read_twoline_fail", "qualified_name": "test_read_twoline_fail", "args": [], "decorators": [], "docstring": "Test failure if too many different character are on position line.\n\nThe position line shall consist of only one character in addition to\nthe delimiter.", "start_line": 409, "end_line": 424, "is_async": false, "is_method": false}, {"name": "test_read_twoline_wrong_marker", "qualified_name": "test_read_twoline_wrong_marker", "args": [], "decorators": [], "docstring": "Test failure when position line uses characters prone to ambiguity\n\nCharacters in position line must be part an allowed set because\nnormal letters or numbers will lead to ambiguous tables.", "start_line": 427, "end_line": 442, "is_async": false, "is_method": false}, {"name": "test_write_twoline_normal", "qualified_name": "test_write_twoline_normal", "args": [], "decorators": [], "docstring": "Write a table as a normal fixed width table.", "start_line": 445, "end_line": 454, "is_async": false, "is_method": false}, {"name": "test_write_twoline_no_pad", "qualified_name": "test_write_twoline_no_pad", "args": [], "decorators": [], "docstring": "Write a table as a fixed width table with no padding.", "start_line": 457, "end_line": 467, "is_async": false, "is_method": false}, {"name": "test_write_twoline_no_bookend", "qualified_name": "test_write_twoline_no_bookend", "args": [], "decorators": [], "docstring": "Write a table as a fixed width table with no bookend.", "start_line": 470, "end_line": 480, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/io/ascii/tests/test_ipac_definitions.py", "file_hash": "2b9d05b459d10b68d4662bc1851c37