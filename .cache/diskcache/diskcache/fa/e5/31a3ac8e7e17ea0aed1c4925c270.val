ame": "flush", "qualified_name": "flush", "args": ["self"], "decorators": [], "docstring": "", "start_line": 845, "end_line": 846, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 881, "end_line": 889, "is_async": false, "is_method": false}, {"name": "get_option_dict", "qualified_name": "get_option_dict", "args": ["self", "command_name"], "decorators": [], "docstring": "", "start_line": 490, "end_line": 499, "is_async": false, "is_method": false}], "classes": [{"name": "_Bootstrapper", "bases": ["object"], "methods": ["__init__", "main", "parse_config", "parse_command_line", "run", "config", "get_local_directory_dist", "get_local_file_dist", "get_index_dist", "_directory_import", "_do_download", "_do_upgrade", "_check_submodule", "_check_submodule_using_git", "_check_submodule_no_git", "_update_submodule"], "docstring": "Bootstrapper implementation.  See ``use_astropy_helpers`` for parameter\ndocumentation.", "start_line": 165, "end_line": 746}, {"name": "_CommandNotFound", "bases": ["OSError"], "methods": [], "docstring": "An exception raised when a command run with run_cmd is not found on the\nsystem.", "start_line": 748, "end_line": 752}, {"name": "_DummyFile", "bases": ["object"], "methods": ["write", "flush"], "docstring": "A noop writeable object.", "start_line": 836, "end_line": 846}, {"name": "_AHBootstrapSystemExit", "bases": ["SystemExit"], "methods": ["__init__"], "docstring": "", "start_line": 880, "end_line": 889}, {"name": "_Distribution", "bases": ["Distribution"], "methods": ["get_option_dict"], "docstring": "", "start_line": 489, "end_line": 499}], "calls": [], "module_docstring": "This bootstrap module contains code for ensuring that the astropy_helpers\npackage will be importable by the time the setup.py script runs.  It also\nincludes some workarounds to ensure that a recent-enough version of setuptools\nis being used for the installation.\n\nThis module should be the first thing imported in the setup.py of distributions\nthat make use of the utilities in astropy_helpers.  If the distribution ships\nwith its own copy of astropy_helpers, this module will first attempt to import\nfrom the shipped copy.  However, it will also check PyPI to see if there are\nany bug-fix releases on top of the current version that may be useful to get\npast platform-specific bugs that have been fixed.  When running setup.py, use\nthe ``--offline`` command-line option to disable the auto-upgrade checks.\n\nWhen this module is imported or otherwise executed it automatically calls a\nmain function that attempts to read the project's setup.cfg file, which it\nchecks for a configuration section called ``[ah_bootstrap]`` the presences of\nthat section, and options therein, determine the next step taken:  If it\ncontains an option called ``auto_use`` with a value of ``True``, it will\nautomatically call the main function of this module called\n`use_astropy_helpers` (see that function's docstring for full details).\nOtherwise no further action is taken (however,\n``ah_bootstrap.use_astropy_helpers`` may be called manually from within the\nsetup.py script).\n\nAdditional options in the ``[ah_boostrap]`` section of setup.cfg have the same\nnames as the arguments to `use_astropy_helpers`, and can be used to configure\nthe bootstrap script when ``auto_use = True``.\n\nSee https://github.com/astropy/astropy-helpers for more details, and for the\nlatest version of this module.", "parse_error": ""}, {"file_path": "conftest.py", "file_hash": "2c630f38c06b25a303ca9298b0a3734ceedca96283a08633dc5ba741c8a7eae5", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "ez_setup.py", "file_hash": "156a401bf6ed7df5fefd164e17e55083757da06016c37ea375d28243929e680a", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "shutil", "names": [], "is_from": fa