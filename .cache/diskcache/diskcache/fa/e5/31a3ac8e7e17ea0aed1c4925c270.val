ualified_name": "format", "args": ["self"], "decorators": ["property"], "docstring": "[*required*] The serialization format of the table.  Must be\none of:\n\n  'tabledata' (TABLEDATA_), 'binary' (BINARY_), 'binary2' (BINARY2_)\n  'fits' (FITS_).\n\nNote that the 'fits' format, since it requires an external\nfile, can not be written out.  Any file read in with 'fits'\nformat will be read out", "start_line": 2109, "end_line": 2123, "is_async": false, "is_method": false}, {"name": "format", "qualified_name": "format", "args": ["self", "format"], "decorators": ["format.setter"], "docstring": "", "start_line": 2126, "end_line": 2139, "is_async": false, "is_method": false}, {"name": "nrows", "qualified_name": "nrows", "args": ["self"], "decorators": ["property"], "docstring": "[*immutable*] The number of rows in the table, as specified in\nthe XML file.", "start_line": 2142, "end_line": 2147, "is_async": false, "is_method": false}, {"name": "fields", "qualified_name": "fields", "args": ["self"], "decorators": ["property"], "docstring": "A list of :class:`Field` objects describing the types of each\nof the data columns.", "start_line": 2150, "end_line": 2155, "is_async": false, "is_method": false}, {"name": "params", "qualified_name": "params", "args": ["self"], "decorators": ["property"], "docstring": "A list of parameters (constant-valued columns) for the\ntable.  Must contain only :class:`Param` objects.", "start_line": 2158, "end_line": 2163, "is_async": false, "is_method": false}, {"name": "groups", "qualified_name": "groups", "args": ["self"], "decorators": ["property"], "docstring": "A list of :class:`Group` objects describing how the columns\nand parameters are grouped.  Currently this information is\nonly kept around for round-tripping and informational\npurposes.", "start_line": 2166, "end_line": 2173, "is_async": false, "is_method": false}, {"name": "links", "qualified_name": "links", "args": ["self"], "decorators": ["property"], "docstring": "A list of :class: