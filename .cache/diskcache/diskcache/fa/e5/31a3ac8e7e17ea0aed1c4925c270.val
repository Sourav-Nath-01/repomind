ators": [], "docstring": "Decorator to time a function or method.\n\nParameters\n----------\nnum_tries : int, optional\n    Number of calls to make. Timer will take the\n    average run time.\n\nverbose : bool, optional\n    Extra log information.\n\nReturns\n-------\ntt : float\n    Average run time in seconds.\n\nresult\n    Output(s) from", "start_line": 23, "end_line": 78, "is_async": false, "is_method": false}, {"name": "real_decorator", "qualified_name": "real_decorator", "args": ["function"], "decorators": [], "docstring": "", "start_line": 65, "end_line": 77, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "func"], "decorators": [], "docstring": "", "start_line": 150, "end_line": 158, "is_async": false, "is_method": false}, {"name": "results", "qualified_name": "results", "args": ["self"], "decorators": ["property"], "docstring": "Function outputs from `time_func`.\n\nA dictionary mapping input arguments (fixed arguments\nare not included) to their respective output values.", "start_line": 161, "end_line": 168, "is_async": false, "is_method": false}, {"name": "_timed_pfunc", "qualified_name": "_timed_pfunc", "args": ["self", "arg"], "decorators": ["timefunc(num_tries=1, verbose=False)"], "docstring": "Run partial func once for single arg and time it.", "start_line": 171, "end_line": 173, "is_async": false, "is_method": false}, {"name": "_cache_time", "qualified_name": "_cache_time", "args": ["self", "arg"], "decorators": [], "docstring": "Cache timing results without repetition.", "start_line": 175, "end_line": 185, "is_async": false, "is_method": false}, {"name": "time_func", "qualified_name": "time_func", "args": ["self", "arglist"], "decorators": [], "docstring": "Time the partial function for a list of single args\nand store run time in a cache. This forms a baseline for\nthe prediction.\n\nThis also stores function outputs in `results`.\n\nParameters\n----------\narglist : list of numbers\n    List of input arguments to time.", "start_line": 187, "end_line": 205, "is_async": false, "is_method": false}, {"name": "do_fit", "qualified_name": "do_fit", "args": ["self", "model", "fitter", "power", "min_datapoints"], "decorators": [], "docstring": "Fit a function to the lists of arguments and\ntheir respective run time in the cache.\n\nBy default, this does a linear least-square fitting\nto a straight line on run time w.r.t. argument values\nraised to the given power, and returns the optimal\nintercept and slope.\n\nParameters\n----------\nmodel : `astr", "start_line": 208, "end_line": 274, "is_async": false, "is_method": false}, {"name": "predict_time", "qualified_name": "predict_time", "args": ["self", "arg"], "decorators": [], "docstring": "Predict run time for given argument.\nIf prediction is already cached, cached value is returned.\n\nParameters\n----------\narg : number\n    Input argument to predict run time for.\n\nReturns\n-------\nt_est : float\n    Estimated run time for given argument.\n\nRaises\n------\nRuntimeError\n    No fitted data for", "start_line": 276, "end_line": 303, "is_async": false, "is_method": false}, {"name": "plot", "qualified_name": "plot", "args": ["self", "xscale", "yscale", "xlabeltext", "save_as"], "decorators": [], "docstring": "Plot prediction.\n\n.. note:: Uses `matplotlib <http://matplotlib.org/>`_.\n\nParameters\n----------\nxscale, yscale : {'linear', 'log', 'symlog'}\n    Scaling for `matplotlib.axes.Axes`.\n\nxlabeltext : str, optional\n    Text for X-label.\n\nsave_as : str, optional\n    Save plot as given filename.\n\nRaises\n---", "start_line": 305, "end_line": 372, "is_async": false, "is_method": false}, {"name": "wrapper", "qualified_name": "wrapper", "args": [], "decorators": ["wraps(function)"], "docstring": "", "start_line": 67, "end_line": 76, "is_async": false, "is_method": false}], "classes": [{"name": "RunTimePredictor", "bases": [], "methods": ["__init__", "results", "_timed_pfunc", "_cache_time", "time_func", "do_fit", "predict_time", "plot"], "docstring": "Class to predict run time.\n\n.. note:: Only predict for single varying numeric input parameter.\n\nParameters\n----------\nfunc : function\n    Function to time.\n\nargs : tuple\n    Fixed positional argument(s) for the function.\n\nkwargs : dict\n    Fixed keyword argument(s) for the function.\n\nExamples\n------", "start_line": 81, "end_line": 372}], "calls": [], "module_docstring": "General purpose timer related functions.", "parse_error": ""}, {"file_path": "astropy/utils/introspection.py", "file_hash": "299561406172ebdaa27e5487ca3ada4b24337a0b3fa538f5e69afa96afc76fc2", "imports": [{"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "types", "names": [], "is_from": false, "alias": ""}, {"module": "importlib", "names": [], "is_from": false, "alias": ""}, {"module": "pkg_resources", "names": ["parse_version"], "is_from": true, "alias": ""}, {"module": "distutils.version", "names": ["LooseVersion"], "is_from": true, "alias": ""}], "functions": [{"name": "resolve_name", "qualified_name": "resolve_name", "args": ["name"], "decorators": [], "docstring": "Resolve a name like ``module.object`` to an object and return it.\n\nThis ends up working like ``from module import object`` but is easier\nto deal with than the `__import__` builtin and supports digging into\nsubmodules.\n\nParameters\n----------\n\nname : `str`\n    A dotted path to a Python object--that is", "start_line": 18, "end_line": 87, "is_async": false, "is_method": false}, {"name": "minversion", "qualified_name": "minversion", "args": ["module", "version", "inclusive", "version_path"], "decorators": [], "docstring": "Returns `True` if the specified Python module satisfies a minimum version\nrequirement, and `False` if not.\n\nBy default this uses `pkg_resources.parse_version` to do the version\ncomparison if available.  Otherwise it falls back on\n`distutils.version.LooseVersion`.\n\nParameters\n----------\n\nmodule : mod", "start_line": 90, "end_line": 161, "is_async": false, "is_method": false}, {"name": "find_current_module", "qualified_name": "find_current_module", "args": ["depth", "finddiff"], "decorators": [], "docstring": "Determines the module/package from which this function is called.\n\nThis function has two modes, determined by the ``finddiff`` option. it\nwill either simply go the requested number of frames up the call\nstack (if ``finddiff`` is False), or it will go up the call stack until\nit reaches a module that ", "start_line": 164, "end_line": 271, "is_async": false, "is_method": false}, {"name": "find_mod_objs", "qualified_name": "find_mod_objs", "args": ["modname", "onlylocals"], "decorators": [], "docstring": "Returns all the public attributes of a module referenced by name.\n\n.. note::\n    The returned list *not* include subpackages or modules of\n    ``modname``, nor does it include private attributes (those that\n    begin with '_' or are not in `__all__`).\n\nParameters\n----------\nmodname : str\n    The nam", "start_line": 274, "end_line": 337, "is_async": false, "is_method": false}, {"name": "isinstancemethod", "qualified_name": "isinstancemethod", "args": ["cls", "obj"], "decorators": [], "docstring": "Returns `True` if the given object is an instance method of the class\nit is defined on (as opposed to a `staticmethod` or a `classmethod`).\n\nThis requires both the class the object is a member of as well as the\nobject itself in order to make this determination.\n\nParameters\n----------\ncls : `type`\n  ", "start_line": 342, "end_line": 383, "is_async": false, "is_method": false}, {"name": "_isinstancemethod", "qualified_name": "_isinstancemethod", "args": ["cls", "obj"], "decorators": [], "docstring": "", "start_line": 386, "end_line": 401, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "Functions related to Python runtime introspection.", "parse_e