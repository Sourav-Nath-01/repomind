 will be caught and displayed.\n\n``*args`` is a ", "start_line": 271, "end_line": 306}, {"name": "ignore_warnings", "bases": ["catch_warnings"], "methods": ["__init__", "__call__", "__enter__"], "docstring": "This can be used either as a context manager or function decorator to\nignore all warnings that occur within a function or block of code.\n\nAn optional category option can be supplied to only ignore warnings of a\ncertain category or categories (if a list is provided).", "start_line": 309, "end_line": 344}], "calls": [], "module_docstring": "This module provides the tools used to internally run the astropy test suite\nfrom the installed astropy.  It makes use of the `pytest` testing framework.", "parse_error": ""}, {"file_path": "astropy/tests/setup_package.py", "file_hash": "2a115ddce0861b7f2083906e13be2b5e3ad38bc42614db852ff9aada7443ce45", "imports": [], "functions": [{"name": "get_package_data", "qualified_name": "get_package_data", "args": [], "decorators": [], "docstring": "", "start_line": 4, "end_line": 7, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/tests/command.py", "file_hash": "3514095323b3408a50df99f844f2b1a0a82a8ad14728f0e62e08263a1fbaf3a3", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "glob", "names": [], "is_from": false, "alias": ""}, {"module": "shutil", "names": [], "is_from": false, "alias": ""}, {"module": "subprocess", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "tempfile", "names": [], "is_from": false, "alias": ""}, {"module": "setuptools", "names": ["Command"], "is_from": true, "alias": ""}, {"module": "coverage", "names": [], "is_from": false, "alias": ""}, {"module": "signal", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["cls", "name", "bases", "dct"], "dec