theta"], "decorators": ["classmethod"], "docstring": "", "start_line": 1822, "end_line": 1823, "is_async": false, "is_method": false}, {"name": "inverse", "qualified_name": "inverse", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 1854, "end_line": 1855, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["cls", "x", "y", "H", "X"], "decorators": ["classmethod"], "docstring": "", "start_line": 1858, "end_line": 1859, "is_async": false, "is_method": false}, {"name": "inverse", "qualified_name": "inverse", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 1885, "end_line": 1886, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["cls", "phi", "theta", "H", "X"], "decorators": ["classmethod"], "docstring": "", "start_line": 1889, "end_line": 1890, "is_async": false, "is_method": false}, {"name": "inverse", "qualified_name": "inverse", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 1905, "end_line": 1906, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["cls", "x", "y"], "decorators": ["classmethod"], "docstring": "", "start_line": 1909, "end_line": 1910, "is_async": false, "is_method": false}, {"name": "inverse", "qualified_name": "inverse", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 1925, "end_line": 1926, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["cls", "phi", "theta"], "decorators": ["classmethod"], "docstring": "", "start_line": 1929, "end_line": 1930, "is_async": false, "is_method": false}, {"name": "matrix", "qualified_name": "matrix", "args": ["self", "value"], "decorators": ["matrix.validator"], "docstring": "Validates that the input matrix is a 2x2 2D array.", "start_line": 1962, "end_line": 1967, "is_async": false, "is_method": false}, {"name": "translation", "qualified_name": "translation", "args": ["self", "value"], "decorators": ["translation.validator"], "docstring": "Validates that the translation vector is a 2D vector.  This allows\neither a \"row\" vector or a \"column\" vector where in the latter case the\nresultant Numpy array has ``ndim=2`` but the shape is ``(1, 2)``.", "start_line": 1970, "end_line": 1981, "is_async": false, "is_method": false}, {"name": "inverse", "qualified_name": "inverse", "args": ["self"], "decorators": ["property"], "docstring": "Inverse transformation.\n\nRaises `~astropy.modeling.InputParameterError` if the transformation cannot be inverted.", "start_line": 1984, "end_line": 2003, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["cls", "x", "y", "matrix", "translation"], "decorators": ["classmethod"], "docstring": "Apply the transformation to a set of 2D Cartesian coordinates given as\ntwo lists--one for the x coordinates and one for a y coordinates--or a\nsingle coordinate pair.\n\nParameters\n----------\nx, y : array, float\n      x and y coordinates", "start_line": 2006, "end_line": 2031, "is_async": false, "is_method": false}, {"name": "_create_augmented_matrix", "qualified_name": "_create_augmented_matrix", "args": ["matrix", "translation"], "decorators": ["staticmethod"], "docstring": "", "start_line": 2034, "end_line": 2052, "is_async": false, "is_method": false}, {"name": "input_units", "qualified_name": "input_units", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 2055, "end_line": 2065, "is_async": false, "is_method": false}], "classes": [{"name": "Projection", "bases": ["Model"], "methods": ["inverse"], "docstring": "Base class for all sky projections.", "start_line": 102, "end_line": 116}, {"name": "Pix2SkyProjection", "bases": ["Projection"], "methods": ["input_units", "return_units"], "docstring": "Base class for all Pix2Sky projections.", "start_line": 119, "end_line": 134}, {"name": "Sky2PixProjection", "bases": ["Projection"], "methods": ["input_units", "return_units"], "docstring": "Base class for all Sky2Pix projections.", "start_line": 137, "end_line": 152}, {"name": "Zenithal", "bases": ["Projection"], "methods": [], "docstring": "Base class for all Zenithal projections.\n\nZenithal (or azimuthal) projections map the sphere directly onto a\nplane.  All zenithal projections are specified by defining the\nradius as a function of native latitude, :math:`R_\\theta`.\n\nThe pixel-to-sky transformation is defined as:\n\n.. math::\n    \\phi &", "start_line": 155, "end_line": 175}, {"name": "Pix2Sky_ZenithalPerspective", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": ["__init__", "mu", "inverse", "evaluate"], "docstring": "Zenithal perspective projection - pixel to sky.\n\nCorresponds to the ``AZP`` projection in FITS WCS.\n\n.. math::\n    \\phi &= \\arg(-y \\cos \\gamma, x) \\\\\n    \\theta &= \\left\\{\\genfrac{}{}{0pt}{}{\\psi - \\omega}{\\psi + \\omega + 180^{\\circ}}\\right.\n\nwhere:\n\n.. math::\n    \\psi &= \\arg(\\rho, 1) \\\\\n    \\omega", "start_line": 178, "end_line": 226}, {"name": "Sky2Pix_ZenithalPerspective", "bases": ["Sky2PixProjection", "Zenithal"], "methods": ["mu", "inverse", "evaluate"], "docstring": "Zenithal perspective projection - sky to pixel.\n\nCorresponds to the ``AZP`` projection in FITS WCS.\n\n.. math::\n    x &= R \\sin \\phi \\\\\n    y &= -R \\sec \\gamma \\cos \\theta\n\nwhere:\n\n.. math::\n    R = \\frac{180^{\\circ}}{\\pi} \\frac{(\\mu + 1) \\cos \\theta}{(\\mu + \\sin \\theta) + \\cos \\theta \\cos \\phi \\tan ", "start_line": 232, "end_line": 273}, {"name": "Pix2Sky_SlantZenithalPerspective", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": ["_validate_mu", "inverse", "evaluate"], "docstring": "Slant zenithal perspective projection - pixel to sky.\n\nCorresponds to the ``SZP`` projection in FITS WCS.\n\nParameters\n--------------\nmu : float\n    Distance from point of projection to center of sphere\n    in spherical radii, \u03bc.  Default is 0.\n\nphi0 : float\n    The longitude \u03c6\u2080 of the reference poin", "start_line": 279, "end_line": 318}, {"name": "Sky2Pix_SlantZenithalPerspective", "bases": ["Sky2PixProjection", "Zenithal"], "methods": ["_validate_mu", "inverse", "evaluate"], "docstring": "Zenithal perspective projection - sky to pixel.\n\nCorresponds to the ``SZP`` projection in FITS WCS.\n\nParameters\n----------\nmu : float\n    distance from point of projection to center of sphere\n    in spherical radii, \u03bc.  Default is 0.\n\nphi0 : float\n    The longitude \u03c6\u2080 of the reference point, in degr", "start_line": 324, "end_line": 362}, {"name": "Pix2Sky_Gnomonic", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": ["inverse", "evaluate"], "docstring": "Gnomonic projection - pixel to sky.\n\nCorresponds to the ``TAN`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    \\theta = \\tan^{-1}\\left(\\frac{180^{\\circ}}{\\pi R_\\theta}\\right)", "start_line": 368, "end_line": 386}, {"name": "Sky2Pix_Gnomonic", "bases": ["Sky2PixProjection", "Zenithal"], "methods": ["inverse", "evaluate"], "docstring": "Gnomonic Projection - sky to pixel.\n\nCorresponds to the ``TAN`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    R_\\theta = \\frac{180^{\\circ}}{\\pi}\\cot \\theta", "start_line": 392, "end_line": 410}, {"name": "Pix2Sky_Stereographic", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": ["inverse", "evaluate"], "docstring": "Stereographic Projection - pixel to sky.\n\nCorresponds to the ``STG`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    \\theta = 90^{\\circ} - 2 \\tan^{-1}\\left(\\frac{\\pi R_\\theta}{360^{\\circ}}\\right)", "start_line": 416, "end_line": 434}, {"name": "Sky2Pix_Stereographic", "bases": ["Sky2PixProjection", "Zenithal"], "methods": ["inverse", "evaluate"], "docstring": "Stereographic Projection - sky to pixel.\n\nCorresponds to the ``STG`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    R_\\theta = \\frac{180^{\\circ}}{\\pi}\\frac{2 \\cos \\theta}{1 + \\sin \\theta}", "start_line": 440, "end_line": 458}, {"name": "Pix2Sky_SlantOrthographic", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": ["inverse", "evaluate"], "docstring": "Slant orthographic projection - pixel to sky.\n\nCorresponds to the ``SIN`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\nThe following transformation applies when :math:`\\xi` and\n:math:`\\eta` are both zero.\n\n.. math::\n    \\theta = \\cos^{-1}\\left(\\frac{\\pi}{180^", "start_line": 464, "end_line": 503}, {"name": "Sky2Pix_SlantOrthographic", "bases": ["Sky2PixProjection", "Zenithal"], "methods": ["inverse", "evaluate"], "docstring": "Slant orthographic projection - sky to pixel.\n\nCorresponds to the ``SIN`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\nThe following transformation applies when :math:`\\xi` and\n:math:`\\eta` are both zero.\n\n.. math::\n    R_\\theta = \\frac{180^{\\circ}}{\\pi}\\cos ", "start_line": 509, "end_line": 539}, {"name": "Pix2Sky_ZenithalEquidistant", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": ["inverse", "evaluate"], "docstring": "Zenithal equidistant projection - pixel to sky.\n\nCorresponds to the ``ARC`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    \\theta = 90^\\circ - R_\\theta", "start_line": 545, "end_line": 562}, {"name": "Sky2Pix_ZenithalEquidistant", "bases": ["Sky2PixProjection", "Zenithal"], "methods": ["inverse", "evaluate"], "docstring": "Zenithal equidistant projection - sky to pixel.\n\nCorresponds to the ``ARC`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    R_\\theta = 90^\\circ - \\theta", "start_line": 568, "end_line": 585}, {"name": "Pix2Sky_ZenithalEqualArea", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": ["inverse", "evaluate"], "docstring": "Zenithal equidistant projection - pixel to sky.\n\nCorresponds to the ``ZEA`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    \\theta = 90^\\circ - 2 \\sin^{-1} \\left(\\frac{\\pi R_\\theta}{360^\\circ}\\right)", "start_line": 591, "end_line": 608}, {"name": "Sky2Pix_ZenithalEqualArea", "bases": ["Sky2PixProjection", "Zenithal"], "methods": ["inverse", "evaluate"], "docstring": "Zenithal equidistant projection - sky to pixel.\n\nCorresponds to the ``ZEA`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    R_\\theta &= \\frac{180^\\circ}{\\pi} \\sqrt{2(1 - \\sin\\theta)} \\\\\n             &= \\frac{360^\\circ}{\\pi} \\sin\\left(\\frac{90^\\circ", "start_line": 614, "end_line": 632}, {"name": "Pix2Sky_Airy", "bases": ["Pix2SkyProjection", "Zenithal"], "methods": ["inverse", "evaluate"], "docstring": "Airy projection - pixel to sky.\n\nCorresponds to the ``AIR`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\nParameters\n----------\ntheta_b : float\n    The latitude :math:`\\theta_b` at which to minimize the error,\n    in degrees.  Default is 90\u00b0.", "start_line": 638, "end_line": 660}, {"name": "Sky2Pix_Airy", "bases": ["Sky2PixProjection", "Zenithal"], "methods": ["inverse", "evaluate"], "docstring": "Airy - sky to pixel.\n\nCorresponds to the ``AIR`` projection in FITS WCS.\n\nSee `Zenithal` for a definition of the full transformation.\n\n.. math::\n    R_\\theta = -2 \\frac{180^\\circ}{\\pi}\\left(\\frac{\\ln(\\cos \\xi)}{\\tan \\xi} + \\frac{\\ln(\\cos \\xi_b)}{\\tan^2 \\xi_b} \\tan \\xi \\right)\n\nwhere:\n\n.. math::\n    ", "start_line": 666, "end_line": 697}, {"name": "Cylindrical", "bases": ["Projection"], "methods": [], "docstring": "Base class for Cylindrical projections.\n\nCylindrical projections are so-named because the surface of\nprojection is a cylinder.", "start_line": 703, "end_line": 709}, {"name": "Pix2Sky_CylindricalPerspective", "bases": ["Pix2SkyProjection", "Cylindrical"], "methods": ["mu", "lam", "inverse", "evaluate"], "docstring": "Cylindrical perspective - pixel to sky.\n\nCorresponds to the ``CYP`` projection in FITS WCS.\n\n.. math::\n    \\phi &= \\frac{x}{\\lambda} \\\\\n    \\theta &= \\arg(1, \\eta) + \\sin{-1}\\left(\\frac{\\eta \\mu}{\\sqrt{\\eta^2 + 1}}\\right)\n\nwhere:\n\n.. math::\n    \\eta = \\frac{\\pi}{180^{\\circ}}\\frac{y}{\\mu + \\lambda}\n\n", "start_line": 712, "end_line": 758}, {"name": "Sky2Pix_CylindricalPerspective", "bases": ["Sky2PixProjection", "Cylindrical"], "methods": ["mu", "lam", "inverse", "evaluate"], "docstring": "Cylindrical Perspective - sky to pixel.\n\nCorresponds to the ``CYP`` projection in FITS WCS.\n\n.. math::\n    x &= \\lambda \\phi \\\\\n    y &= \\frac{180^{\\circ}}{\\pi}\\left(\\frac{\\mu + \\lambda}{\\mu + \\cos \\theta}\\right)\\sin \\theta\n\nParameters\n----------\nmu : float\n    Distance from center of sphere in the ", "start_line": 764, "end_line": 805}, {"name": "Pix2Sky_CylindricalEqualArea", "bases": ["Pix2SkyProjection", "Cylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Cylindrical equal area projection - pixel to sky.\n\nCorresponds to the ``CEA`` projection in FITS WCS.\n\n.. math::\n    \\phi &= x \\\\\n    \\theta &= \\sin^{-1}\\left(\\frac{\\pi}{180^{\\circ}}\\lambda y\\right)\n\nParameters\n----------\nlam : float\n    Radius of the cylinder in spherical radii, \u03bb.  Default is 0.", "start_line": 811, "end_line": 835}, {"name": "Sky2Pix_CylindricalEqualArea", "bases": ["Sky2PixProjection", "Cylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Cylindrical equal area projection - sky to pixel.\n\nCorresponds to the ``CEA`` projection in FITS WCS.\n\n.. math::\n    x &= \\phi \\\\\n    y &= \\frac{180^{\\circ}}{\\pi}\\frac{\\sin \\theta}{\\lambda}\n\nParameters\n----------\nlam : float\n    Radius of the cylinder in spherical radii, \u03bb.  Default is 0.", "start_line": 841, "end_line": 865}, {"name": "Pix2Sky_PlateCarree", "bases": ["Pix2SkyProjection", "Cylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Plate carr\u00e9e projection - pixel to sky.\n\nCorresponds to the ``CAR`` projection in FITS WCS.\n\n.. math::\n    \\phi &= x \\\\\n    \\theta &= y", "start_line": 871, "end_line": 892}, {"name": "Sky2Pix_PlateCarree", "bases": ["Sky2PixProjection", "Cylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Plate carr\u00e9e projection - sky to pixel.\n\nCorresponds to the ``CAR`` projection in FITS WCS.\n\n.. math::\n    x &= \\phi \\\\\n    y &= \\theta", "start_line": 898, "end_line": 919}, {"name": "Pix2Sky_Mercator", "bases": ["Pix2SkyProjection", "Cylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Mercator - pixel to sky.\n\nCorresponds to the ``MER`` projection in FITS WCS.\n\n.. math::\n    \\phi &= x \\\\\n    \\theta &= 2 \\tan^{-1}\\left(e^{y \\pi / 180^{\\circ}}\\right)-90^{\\circ}", "start_line": 925, "end_line": 942}, {"name": "Sky2Pix_Mercator", "bases": ["Sky2PixProjection", "Cylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Mercator - sky to pixel.\n\nCorresponds to the ``MER`` projection in FITS WCS.\n\n.. math::\n    x &= \\phi \\\\\n    y &= \\frac{180^{\\circ}}{\\pi}\\ln \\tan \\left(\\frac{90^{\\circ} + \\theta}{2}\\right)", "start_line": 948, "end_line": 965}, {"name": "PseudoCylindrical", "bases": ["Projection"], "methods": [], "docstring": "Base class for pseudocylindrical projections.\n\nPseudocylindrical projections are like cylindrical projections\nexcept the parallels of latitude are projected at diminishing\nlengths toward the polar regions in order to reduce lateral\ndistortion there.  Consequently, the meridians are curved.", "start_line": 971, "end_line": 980}, {"name": "Pix2Sky_SansonFlamsteed", "bases": ["Pix2SkyProjection", "PseudoCylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Sanson-Flamsteed projection - pixel to sky.\n\nCorresponds to the ``SFL`` projection in FITS WCS.\n\n.. math::\n    \\phi &= \\frac{x}{\\cos y} \\\\\n    \\theta &= y", "start_line": 983, "end_line": 1000}, {"name": "Sky2Pix_SansonFlamsteed", "bases": ["Sky2PixProjection", "PseudoCylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Sanson-Flamsteed projection - sky to pixel.\n\nCorresponds to the ``SFL`` projection in FITS WCS.\n\n.. math::\n    x &= \\phi \\cos \\theta \\\\\n    y &= \\theta", "start_line": 1006, "end_line": 1023}, {"name": "Pix2Sky_Parabolic", "bases": ["Pix2SkyProjection", "PseudoCylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Parabolic projection - pixel to sky.\n\nCorresponds to the ``PAR`` projection in FITS WCS.\n\n.. math::\n    \\phi &= \\frac{180^\\circ}{\\pi} \\frac{x}{1 - 4(y / 180^\\circ)^2} \\\\\n    \\theta &= 3 \\sin^{-1}\\left(\\frac{y}{180^\\circ}\\right)", "start_line": 1029, "end_line": 1048}, {"name": "Sky2Pix_Parabolic", "bases": ["Sky2PixProjection", "PseudoCylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Parabolic projection - sky to pixel.\n\nCorresponds to the ``PAR`` projection in FITS WCS.\n\n.. math::\n    x &= \\phi \\left(2\\cos\\frac{2\\theta}{3} - 1\\right) \\\\\n    y &= 180^\\circ \\sin \\frac{\\theta}{3}", "start_line": 1054, "end_line": 1073}, {"name": "Pix2Sky_Molleweide", "bases": ["Pix2SkyProjection", "PseudoCylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Molleweide's projection - pixel to sky.\n\nCorresponds to the ``MOL`` projection in FITS WCS.\n\n.. math::\n    \\phi &= \\frac{\\pi x}{2 \\sqrt{2 - \\left(\\frac{\\pi}{180^\\circ}y\\right)^2}} \\\\\n    \\theta &= \\sin^{-1}\\left(\\frac{1}{90^\\circ}\\sin^{-1}\\left(\\frac{\\pi}{180^\\circ}\\frac{y}{\\sqrt{2}}\\right) + \\frac{", "start_line": 1079, "end_line": 1098}, {"name": "Sky2Pix_Molleweide", "bases": ["Sky2PixProjection", "PseudoCylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Molleweide's projection - sky to pixel.\n\nCorresponds to the ``MOL`` projection in FITS WCS.\n\n.. math::\n    x &= \\frac{2 \\sqrt{2}}{\\pi} \\phi \\cos \\gamma \\\\\n    y &= \\sqrt{2} \\frac{180^\\circ}{\\pi} \\sin \\gamma\n\nwhere :math:`\\gamma` is defined as the solution of the\ntranscendental equation:\n\n.. math::\n\n", "start_line": 1104, "end_line": 1130}, {"name": "Pix2Sky_HammerAitoff", "bases": ["Pix2SkyProjection", "PseudoCylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Hammer-Aitoff projection - pixel to sky.\n\nCorresponds to the ``AIT`` projection in FITS WCS.\n\n.. math::\n    \\phi &= 2 \\arg \\left(2Z^2 - 1, \\frac{\\pi}{180^\\circ} \\frac{Z}{2}x\\right) \\\\\n    \\theta &= \\sin^{-1}\\left(\\frac{\\pi}{180^\\circ}yZ\\right)", "start_line": 1136, "end_line": 1155}, {"name": "Sky2Pix_HammerAitoff", "bases": ["Sky2PixProjection", "PseudoCylindrical"], "methods": ["inverse", "evaluate"], "docstring": "Hammer-Aitoff projection - sky to pixel.\n\nCorresponds to the ``AIT`` projection in FITS WCS.\n\n.. math::\n    x &= 2 \\gamma \\cos \\theta \\sin \\frac{\\phi}{2} \\\\\n    y &= \\gamma \\sin \\theta\n\nwhere:\n\n.. math::\n    \\gamma = \\frac{180^\\circ}{\\pi} \\sqrt{\\frac{2}{1 + \\cos \\theta \\cos(\\phi / 2)}}", "start_line": 1161, "end_line": 1185}, {"name": "Conic", "bases": ["Projection"], "methods": [], "docstring": "Base class for conic projections.\n\nIn conic projections, the sphere is thought to be projected onto\nthe surface of a cone which is then opened out.\n\nIn a general sense, the pixel-to-sky transformation is defined as:\n\n.. math::\n\n    \\phi &= \\arg\\left(\\frac{Y_0 - y}{R_\\theta}, \\frac{x}{R_\\theta}\\right", "start_line": 1191, "end_line": 1218}, {"name": "Pix2Sky_ConicPerspective", "bases": ["Pix2SkyProjection", "Conic"], "methods": ["inverse", "evaluate"], "docstring": "Colles' conic perspective projection - pixel to sky.\n\nCorresponds to the ``COP`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formul\u00e6 are:\n\n.. math::\n    C &= \\sin \\theta_a \\\\\n    R_\\theta &= \\frac{180^\\circ}{\\pi} \\cos \\eta [ \\cot \\theta_a - \\tan(\\th", "start_line": 1221, "end_line": 1254}, {"name": "Sky2Pix_ConicPerspective", "bases": ["Sky2PixProjection", "Conic"], "methods": ["inverse", "evaluate"], "docstring": "Colles' conic perspective projection - sky to pixel.\n\nCorresponds to the ``COP`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formul\u00e6 are:\n\n.. math::\n    C &= \\sin \\theta_a \\\\\n    R_\\theta &= \\frac{180^\\circ}{\\pi} \\cos \\eta [ \\cot \\theta_a - \\tan(\\th", "start_line": 1260, "end_line": 1294}, {"name": "Pix2Sky_ConicEqualArea", "bases": ["Pix2SkyProjection", "Conic"], "methods": ["inverse", "evaluate"], "docstring": "Alber's conic equal area projection - pixel to sky.\n\nCorresponds to the ``COE`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formul\u00e6 are:\n\n.. math::\n    C &= \\gamma / 2 \\\\\n    R_\\theta &= \\frac{180^\\circ}{\\pi} \\frac{2}{\\gamma} \\sqrt{1 + \\sin \\theta_1", "start_line": 1300, "end_line": 1338}, {"name": "Sky2Pix_ConicEqualArea", "bases": ["Sky2PixProjection", "Conic"], "methods": ["inverse", "evaluate"], "docstring": "Alber's conic equal area projection - sky to pixel.\n\nCorresponds to the ``COE`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formul\u00e6 are:\n\n.. math::\n    C &= \\gamma / 2 \\\\\n    R_\\theta &= \\frac{180^\\circ}{\\pi} \\frac{2}{\\gamma} \\sqrt{1 + \\sin \\theta_1", "start_line": 1344, "end_line": 1383}, {"name": "Pix2Sky_ConicEquidistant", "bases": ["Pix2SkyProjection", "Conic"], "methods": ["inverse", "evaluate"], "docstring": "Conic equidistant projection - pixel to sky.\n\nCorresponds to the ``COD`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formul\u00e6 are:\n\n.. math::\n\n    C &= \\frac{180^\\circ}{\\pi} \\frac{\\sin\\theta_a\\sin\\eta}{\\eta} \\\\\n    R_\\theta &= \\theta_a - \\theta + \\et", "start_line": 1389, "end_line": 1423}, {"name": "Sky2Pix_ConicEquidistant", "bases": ["Sky2PixProjection", "Conic"], "methods": ["inverse", "evaluate"], "docstring": "Conic equidistant projection - sky to pixel.\n\nCorresponds to the ``COD`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formul\u00e6 are:\n\n.. math::\n\n    C &= \\frac{180^\\circ}{\\pi} \\frac{\\sin\\theta_a\\sin\\eta}{\\eta} \\\\\n    R_\\theta &= \\theta_a - \\theta + \\et", "start_line": 1429, "end_line": 1464}, {"name": "Pix2Sky_ConicOrthomorphic", "bases": ["Pix2SkyProjection", "Conic"], "methods": ["inverse", "evaluate"], "docstring": "Conic orthomorphic projection - pixel to sky.\n\nCorresponds to the ``COO`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formul\u00e6 are:\n\n.. math::\n\n    C &= \\frac{\\ln \\left( \\frac{\\cos\\theta_2}{\\cos\\theta_1} \\right)}\n              {\\ln \\left[ \\frac{\\tan\\", "start_line": 1470, "end_line": 1513}, {"name": "Sky2Pix_ConicOrthomorphic", "bases": ["Sky2PixProjection", "Conic"], "methods": ["inverse", "evaluate"], "docstring": "Conic orthomorphic projection - sky to pixel.\n\nCorresponds to the ``COO`` projection in FITS WCS.\n\nSee `Conic` for a description of the entire equation.\n\nThe projection formul\u00e6 are:\n\n.. math::\n\n    C &= \\frac{\\ln \\left( \\frac{\\cos\\theta_2}{\\cos\\theta_1} \\right)}\n              {\\ln \\left[ \\frac{\\tan\\", "start_line": 1519, "end_line": 1563}, {"name": "PseudoConic", "bases": ["Projection"], "methods": [], "docstring": "Base class for pseudoconic projections.\n\nPseudoconics are a subclass of conics with concentric parallels.", "start_line": 1569, "end_line": 1573}, {"name": "Pix2Sky_BonneEqualArea", "bases": ["Pix2SkyProjection", "PseudoConic"], "methods": ["inverse", "evaluate"], "docstring": "Bonne's equal area pseudoconic projection - pixel to sky.\n\nCorresponds to the ``BON`` projection in FITS WCS.\n\n.. math::\n\n    \\phi &= \\frac{\\pi}{180^\\circ} A_\\phi R_\\theta / \\cos \\theta \\\\\n    \\theta &= Y_0 - R_\\theta\n\nwhere:\n\n.. math::\n\n    R_\\theta &= \\mathrm{sign} \\theta_1 \\sqrt{x^2 + (Y_0 - y)^2", "start_line": 1576, "end_line": 1608}, {"name": "Sky2Pix_BonneEqualArea", "bases": ["Sky2PixProjection", "PseudoConic"], "methods": ["inverse", "evaluate"], "docstring": "Bonne's equal area pseudoconic projection - sky to pixel.\n\nCorresponds to the ``BON`` projection in FITS WCS.\n\n.. math::\n    x &= R_\\theta \\sin A_\\phi \\\\\n    y &= -R_\\theta \\cos A_\\phi + Y_0\n\nwhere:\n\n.. math::\n    A_\\phi &= \\frac{180^\\circ}{\\pi R_\\theta} \\phi \\cos \\theta \\\\\n    R_\\theta &= Y_0 - \\th", "start_line": 1614, "end_line": 1646}, {"name": "Pix2Sky_Polyconic", "bases": ["Pix2SkyProjection", "PseudoConic"], "methods": ["inverse", "evaluate"], "docstring": "Polyconic projection - pixel to sky.\n\nCorresponds to the ``PCO`` projection in FITS WCS.", "start_line": 1652, "end_line": 1666}, {"name": "Sky2Pix_Polyconic", "bases": ["Sky2PixProjection", "PseudoConic"], "methods": ["inverse", "evaluate"], "docstring": "Polyconic projection - sky to pixel.\n\nCorresponds to the ``PCO`` projection in FITS WCS.", "start_line": 1672, "end_line": 1686}, {"name": "QuadCube", "bases": ["Projection"], "methods": [], "docstring": "Base class for quad cube projections.\n\nQuadrilateralized spherical cube (quad-cube) projections belong to\nthe class of polyhedral projections in which the sphere is\nprojected onto the surface of an enclosing polyhedron.\n\nThe six faces of the quad-cube projections are numbered and laid\nout as::\n\n    ", "start_line": 1692, "end_line": 1706}, {"name": "Pix2Sky_TangentialSphericalCube", "bases": ["Pix2SkyProjection", "QuadCube"], "methods": ["inverse", "evaluate"], "docstring": "Tangential spherical cube projection - pixel to sky.\n\nCorresponds to the ``TSC`` projection in FITS WCS.", "start_line": 1709, "end_line": 1723}, {"name": "Sky2Pix_TangentialSphericalCube", "bases": ["Sky2PixProjection", "QuadCube"], "methods": ["inverse", "evaluate"], "docstring": "Tangential spherical cube projection - sky to pixel.\n\nCorresponds to the ``PCO`` projection in FITS WCS.", "start_line": 1729, "end_line": 1743}, {"name": "Pix2Sky_COBEQuadSphericalCube", "bases": ["Pix2SkyProjection", "QuadCube"], "methods": ["inverse", "evaluate"], "docstring": "COBE quadrilateralized spherical cube projection - pixel to sky.\n\nCorresponds to the ``CSC`` projection in FITS WCS.", "start_line": 1749, "end_line": 1763}, {"name": "Sky2Pix_COBEQuadSphericalCube", "bases": ["Sky2PixProjection", "QuadCube"], "methods": ["inverse", "evaluate"], "docstring": "COBE quadrilateralized spherical cube projection - sky to pixel.\n\nCorresponds to the ``CSC`` projection in FITS WCS.", "start_line": 1769, "end_line": 1783}, {"name": "Pix2Sky_QuadSphericalCube", "bases": ["Pix2SkyProjection", "QuadCube"], "methods": ["inverse", "evaluate"], "docstring": "Quadrilateralized spherical cube projection - pixel to sky.\n\nCorresponds to the ``QSC`` projection in FITS WCS.", "start_line": 1789, "end_line": 1803}, {"name": "Sky2Pix_QuadSphericalCube", "bases": ["Sky2PixProjection", "QuadCube"], "methods": ["inverse", "evaluate"], "docstring": "Quadrilateralized spherical cube projection - sky to pixel.\n\nCorresponds to the ``QSC`` projection in FITS WCS.", "start_line": 1809, "end_line": 1823}, {"name": "HEALPix", "bases": ["Projection"], "methods": [], "docstring": "Base class for HEALPix projections.\n    ", "start_line": 1829, "end_line": 1831}, {"name": "Pix2Sky_HEALPix", "bases": ["Pix2SkyProjection", "HEALPix"], "methods": ["inverse", "evaluate"], "docstring": "HEALPix - pixel to sky.\n\nCorresponds to the ``HPX`` projection in FITS WCS.\n\nParameters\n----------\nH : float\n    The number of facets in longitude direction.\n\nX : float\n    The number of facets in latitude direction.", "start_line": 1834, "end_line": 1859}, {"name": "Sky2Pix_HEALPix", "bases": ["Sky2PixProjection", "HEALPix"], "methods": ["inverse", "evaluate"], "docstring": "HEALPix projection - sky to pixel.\n\nCorresponds to the ``HPX`` projection in FITS WCS.\n\nParameters\n----------\nH : float\n    The number of facets in longitude direction.\n\nX : float\n    The number of facets in latitude direction.", "start_line": 1865, "end_line": 1890}, {"name": "Pix2Sky_HEALPixPolar", "bases": ["Pix2SkyProjection", "HEALPix"], "methods": ["inverse", "evaluate"], "docstring": "HEALPix polar, aka \"butterfly\" projection - pixel to sky.\n\nCorresponds to the ``XPH`` projection in FITS WCS.", "start_line": 1896, "end_line": 1910}, {"name": "Sky2Pix_HEALPixPolar", "bases": ["Sky2PixProjection", "HEALPix"], "methods": ["inverse", "evaluate"], "docstring": "HEALPix polar, aka \"butterfly\" projection - pixel to sky.\n\nCorresponds to the ``XPH`` projection in FITS WCS.", "start_line": 1916, "end_line": 1930}, {"name": "AffineTransformation2D", "bases": ["Model"], "methods": ["matrix", "translation", "inverse", "evaluate", "_create_augmented_matrix", "input_units"], "docstring": "Perform an affine transformation in 2 dimensions.\n\nParameters\n----------\nmatrix : array\n    A 2x2 matrix specifying the linear transformation to apply to the\n    inputs\n\ntranslation : array\n    A 2D vector (given as either a 2x1 or 1x2 array) specifying a\n    translation to apply to the inputs", "start_line": 1936, "end_line": 2065}], "calls": [], "module_docstring": "Implements projections--particularly sky projections defined in WCS Paper II\n[1]_.\n\nAll angles are set and and displayed in degrees but internally computations are\nperformed in radians. All functions expect inputs and outputs degrees.\n\nReferences\n----------\n.. [1] Calabretta, M.R., Greisen, E.W., 2002, A&A, 395, 1077 (Paper II)", "parse_error": ""}, {"file_path": "astropy/modeling/setup_package.py", "file_hash": "49c587feb89d4da20c2e7735d206b168f98e4ab9949e42065655230b4af6f2af", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "os.path", "names": ["join"], "is_from": true, "alias": ""}, {"module": "distutils.core", "names": ["Extension"], "is_from": true, "alias": ""}, {"module": "distutils", "names": ["log"], "is_from": true, "alias": ""}, {"module": "astropy_helpers", "names": ["setup_helpers", "utils"], "is_from": true, "alias": ""}, {"module": "astropy_helpers.version_helpers", "names": ["get_pkg_version_module"], "is_from": true, "alias": ""}, {"module": "jinja2", "names": ["Environment", "FileSystemLoader"], "is_from": true, "alias": ""}, {"module": "jinja2", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "pre_build_py_hook", "qualified_name": "pre_build_py_hook", "args": ["cmd_obj"], "decorators": [], "docstring": "", "start_line": 58, "end_line": 59, "is_async": false, "is_method": false}, {"name": "pre_build_ext_hook", "qualified_name": "pre_build_ext_hook", "args": ["cmd_obj"], "decorators": [], "docstring": "", "start_line": 62, "end_line": 63, "is_async": false, "is_method": false}, {"name": "pre_sdist_hook", "qualified_name": "pre_sdist_hook", "args": ["cmd_obj"], "decorators": [], "docstring": "", "start_line": 66, "end_line": 67, "is_async": false, "is_method": false}, {"name": "preprocess_source", "qualified_name": "preprocess_source", "args": [], "decorators": [], "docstring": "", "start_line": 70, "end_line": 118, "is_async": false, "is_method": false}, {"name": "get_package_data", "qualified_name": "get_package_data", "args": [], "decorators": [], "docst