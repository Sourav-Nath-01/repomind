module": "", "names": ["units"], "is_from": true, "alias": ""}], "functions": [{"name": "setup", "qualified_name": "setup", "args": ["self"], "decorators": [], "docstring": "", "start_line": 23, "end_line": 30, "is_async": false, "is_method": false}, {"name": "test_sub", "qualified_name": "test_sub", "args": ["self"], "decorators": [], "docstring": "", "start_line": 32, "end_line": 50, "is_async": false, "is_method": false}, {"name": "test_add", "qualified_name": "test_add", "args": ["self"], "decorators": [], "docstring": "", "start_line": 52, "end_line": 69, "is_async": false, "is_method": false}, {"name": "test_add_vector", "qualified_name": "test_add_vector", "args": ["self"], "decorators": [], "docstring": "Check time arithmetic as well as properly keeping track of whether\na time is a scalar or a vector", "start_line": 71, "end_line": 114, "is_async": false, "is_method": false}, {"name": "test_sub_vector", "qualified_name": "test_sub_vector", "args": ["self"], "decorators": [], "docstring": "Check time arithmetic as well as properly keeping track of whether\na time is a scalar or a vector", "start_line": 116, "end_line": 142, "is_async": false, "is_method": false}, {"name": "test_copy_timedelta", "qualified_name": "test_copy_timedelta", "args": ["self", "values"], "decorators": ["pytest.mark.parametrize('values', [(2455197.5, 2455198.5), ([2455197.5], [2455198.5])])"], "docstring": "Test copying the values of a TimeDelta object by passing it into the\nTime initializer.", "start_line": 146, "end_line": 167, "is_async": false, "is_method": false}, {"name": "test_neg_abs", "qualified_name": "test_neg_abs", "args": ["self"], "decorators": [], "docstring": "", "start_line": 169, "end_line": 176, "is_async": false, "is_method": false}, {"name": "test_mul_div", "qualified_name": "test_mul_div", "args": ["self"], "decorators": [], "docstring": "", "start_line": 178, "end_line": 191, "is_async": false, "is_method": false}, {"name": "test_keep_properties", "qualified_name": "test_keep_properties", "args": ["self"], "decorators": [], "docstring": "", "start_line": 193, "end_line": 235, "is_async": false, "is_method": false}, {"name": "test_set_format", "qualified_name": "test_set_format", "args": ["self"], "decorators": [], "docstring": "Test basics of setting format attribute.", "start_line": 237, "end_line": 247, "is_async": false, "is_method": false}, {"name": "setup", "qualified_name": "setup", "args": ["self"], "decorators": [], "docstring": "", "start_line": 254, "end_line": 261, "is_async": false, "is_method": false}, {"name": "test_delta_scales_definition", "qualified_name": "test_delta_scales_definition", "args": ["self"], "decorators": [], "docstring": "", "start_line": 263, "end_line": 268, "is_async": false, "is_method": false}, {"name": "test_scales_for_time_minus_time", "qualified_name": "test_scales_for_time_minus_time", "args": ["self", "scale1", "scale2"], "decorators": ["pytest.mark.parametrize(('scale1', 'scale2'), list(itertools.product(TIME_SCALES, TIME_SCALES)))"], "docstring": "T(X) - T2(Y)  -- does T(X) - T2(Y).X and return dT(X)\nand T(X) +/- dT(Y)  -- does (in essence) (T(X).Y +/- dT(Y)).X\n\nI.e., time differences of two times should have the scale of the\nfirst time.  The one exception is UTC, which returns TAI.\n\nThere are no timescales for which this does not work.", "start_line": 272, "end_line": 298, "is_async": false, "is_method": false}, {"name": "test_scales_for_delta_minus_delta", "qualified_name": "test_scales_for_delta_minus_delta", "args": ["self"], "decorators": [], "docstring": "dT(X) +/- dT2(Y) -- Add/substract JDs for dT(X) and dT(Y).X\n\nI.e. this will succeed if dT(Y) can be converted to scale X.\nReturns delta time in scale X", "start_line": 300, "end_line": 360, "is_async": false, "is_method": false}, {"name": "test_scales_for_delta_scale_is_none", "qualified_name": "test_scales_for_delta_scale_is_none", "args": ["self", "scale", "op"], "decorators": ["pytest.mark.parametrize(('scale', 'op'), list(itertools.product(TIME_SCALES, (operator.add, operator.sub))))"], "docstring": "T(X) +/- dT(None) or T(X) +/- Quantity(time-like)\n\nThis is always allowed and just adds JDs, i.e., the scale of\nthe TimeDelta or time-like Quantity will be taken to be X.\nThe one exception is again for X=UTC, where TAI is assumed instead,\nso that a day is always defined as 86400 seconds.", "start_line": 365, "end_line": 398, "is_async": false, "is_method": false}, {"name": "test_delta_day_is_86400_seconds", "qualified_name": "test_delta_day_is_86400_seconds", "args": ["self", "scale"], "decorators": ["pytest.mark.parametrize('scale', TIME_SCALES)"], "docstring": "TimeDelta or Quantity holding 1 day always means 24*60*60 seconds\n\nThis holds true for all timescales but UTC, for which leap-second\ndays are longer or shorter by one second.", "start_line": 401, "end_line": 422, "is_async": false, "is_method": false}], "classes": [{"name": "TestTimeDelta", "bases": [], "methods": ["setup", "test_sub", "test_add", "test_add_vector", "test_sub_vector", "test_copy_timedelta", "test_neg_abs", "test_mul_div", "test_keep_properties", "test_set_format"], "docstring": "Test TimeDelta class", "start_line": 20, "end_line": 247}, {"name": "TestTimeDeltaScales", "bases": [], "methods": ["setup", "test_delta_scales_definition", "test_scales_for_time_minus_time", "test_scales_for_delta_minus_delta", "test_scales_for_delta_scale_is_none", "test_delta_day_is_86400_seconds"], "docstring": "Test scale conversion for Time Delta.\nGo through @taldcroft's list of expected behaviour from #1932", "start_line": 250, "end_line": 422}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/time/tests/test_pickle.py", "file_hash": "73cacdb1f7dce0b9e3cb1d2015f7f59ac56712d81e2fc24761751e315df11e5b", "imports": [{"module": "pickle", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "", "names": ["Time"], 