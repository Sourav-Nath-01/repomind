ethod": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "key"], "decorators": [], "docstring": "", "start_line": 63, "end_line": 78, "is_async": false, "is_method": false}, {"name": "__setitem__", "qualified_name": "__setitem__", "args": ["self", "key", "value"], "decorators": [], "docstring": "", "start_line": 80, "end_line": 95, "is_async": false, "is_method": false}, {"name": "__len__", "qualified_name": "__len__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 97, "end_line": 98, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "Display a single row.", "start_line": 100, "end_line": 108, "is_async": false, "is_method": false}, {"name": "field", "qualified_name": "field", "args": ["self", "field"], "decorators": [], "docstring": "Get the field data of the record.", "start_line": 110, "end_line": 115, "is_async": false, "is_method": false}, {"name": "setfield", "qualified_name": "setfield", "args": ["self", "field", "value"], "decorators": [], "docstring": "Set the field data of the record.", "start_line": 117, "end_line": 122, "is_async": false, "is_method": false}, {"name": "_bases", "qualified_name": "_bases", "args": ["self"], "decorators": ["lazyproperty"], "docstring": "", "start_line": 125, "end_line": 131, "is_async": false, "is_method": false}, {"name": "_get_index", "qualified_name": "_get_index", "args": ["self", "indx"], "decorators": [], "docstring": "", "start_line": 133, "end_line": 141, "is_async": false, "is_method": false}, {"name": "__new__", "qualified_name": "__new__", "args": ["subtype", "input"], "decorators": [], "docstring": "Construct a FITS record array from a recarray.", "start_line": 157, "end_line": 174, "is_async": false, "is_method": false}, {"name": "__setstate__", "qualified_name": "__setstate__", "args": ["self", "state"], "decorators": [], "docstring": "", "start_line": 176, "end_line":