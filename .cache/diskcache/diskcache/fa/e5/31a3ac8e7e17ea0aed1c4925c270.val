 "decorators": [], "docstring": "Remove ndarray subclasses since for jd1/jd2 we want a pure ndarray\nor a Python or numpy scalar.", "start_line": 164, "end_line": 169, "is_async": false, "is_method": false}], "classes": [{"name": "TimeFormatMeta", "bases": ["type"], "methods": ["__new__"], "docstring": "Metaclass that adds `TimeFormat` and `TimeDeltaFormat` to the\n`TIME_FORMATS` and `TIME_DELTA_FORMATS` registries, respectively.", "start_line": 71, "end_line": 91}, {"name": "TimeFormat", "bases": [], "methods": ["__init__", "__len__", "scale", "scale", "_check_val_type", "_check_scale", "set_jds", "to_value", "value"], "docstring": "Base class for time representations.\n\nParameters\n----------\nval1 : numpy ndarray, list, number, str, or bytes\n    Values to initialize the time or times.  Bytes are decoded as ascii.\nval2 : numpy ndarray, list, or number; optional\n    Value(s) to initialize the time or times.  Only used for numerica", "start_line": 94, "end_line": 218}, {"name": "TimeJD", "bases": ["TimeFormat"], "methods": ["set_jds", "value"], "docstring": "Julian Date time format.\nThis represents the number of days since the beginning of\nthe Julian Period.\nFor example, 2451544.5 in JD is midnight on January 1, 2000.", "start_line": 221, "end_line": 236}, {"name": "TimeMJD", "bases": ["TimeFormat"], "methods": ["set_jds", "value"], "docstring": "Modified Julian Date time format.\nThis represents the number of days since midnight on November 17, 1858.\nFor example, 51544.0 in MJD is midnight on January 1, 2000.", "start_line": 239, "end_line": 259}, {"name": "TimeDecimalYear", "bases": ["TimeFormat"], "methods": ["set_jds", "value"], "docstring": "Time as a decimal year, with integer values corresponding to midnight\nof the first day of each year.  For example 2000.5 corresponds to the\nISO time '2000-07-02 00:00:00'.", "start_line": 262, "end_line": 324}, {"name": "TimeFromEpoch", "bases": ["TimeFormat"], "methods": ["__init__", "set_jds", "to_value"], "docstring": "Base class for times that represent the interval from a particular\nepoch as a floating point multiple of a unit time interval (e.g. seconds\nor days).", "start_line": 327, "end_line": 400}, {"name": "TimeUnix", "bases": ["TimeFromEpoch"], "methods": [], "docstring": "Unix time: seconds from 1970-01-01 00:00:00 UTC.\nFor example, 946684800.0 in Unix time is midnight on January 1, 2000.\n\nNOTE: this quantity is not exactly unix time and differs from the strict\nPOSIX definition by up to 1 second on days with a leap second.  POSIX\nunix time actually jumps backward by ", "start_line": 403, "end_line": 419}, {"name": "TimeCxcSec", "bases": ["TimeFromEpoch"], "methods": [], "docstring": "Chandra X-ray Center seconds from 1998-01-01 00:00:00 TT.\nFor example, 63072064.184 is midnight on January 1, 2000.", "start_line": 422, "end_line": 432}, {"name": "TimeGPS", "bases": ["TimeFromEpoch"], "methods": [], "docstring": "GPS time: seconds from 1980-01-06 00:00:00 UTC\nFor example, 630720013.0 is midnight on January 1, 2000.\n\nNotes\n=====\nThis implementation is strictly a representation of the number of seconds\n(including leap seconds) since midnight UTC on 1980-01-06.  GPS can also be\nconsidered as a time scale which ", "start_line": 435, "end_line": 454}, {"name": "TimePlotDate", "bases": ["TimeFromEpoch"], "methods": [], "docstring": "Matplotlib `~matplotlib.pyplot.plot_date` input:\n1 + number of days from 0001-01-01 00:00:00 UTC\n\nThis can be used directly in the matplotlib `~matplotlib.pyplot.plot_date`\nfunction::\n\n  >>> import matplotlib.pyplot as plt\n  >>> jyear = np.linspace(2000, 2001, 20)\n  >>> t = Time(jyear, format='jyear", "start_line": 457, "end_line": 481}, {"name": "TimeUnique", "bases": ["TimeFormat"], "methods": [], "docstring": "Base class for time formats that can uniquely create a time object\nwithout requiring an explicit format specifier.  This class does\nnothing but provide inheritance to identify a class as unique.", "start_line": 484, "end_line": 489}, {"name": "TimeAstropyTime", "bases": ["TimeUnique"], "methods": ["__new__"], "docstring": "Instantiate date from an Astropy Time object (or list thereof).\n\nThis is purely for instantiating from a Time object.  The output\nformat is the same as the first time instance.", "start_line": 492, "end_line": 527}, {"name": "TimeDatetime", "bases": ["TimeUnique"], "methods": ["_check_val_type", "set_jds", "to_value"], "docstring": "Represent date as Python standard library `~datetime.datetime` object\n\nExample::\n\n  >>> from astropy.time import Time\n  >>> from datetime import datetime\n  >>> t = Time(datetime(2000, 1, 2, 12, 0, 0), scale='utc')\n  >>> t.iso\n  '2000-01-02 12:00:00.000'\n  >>> t.tt.datetime\n  datetime.datetime(2000, ", "start_line": 530, "end_line": 623}, {"name": "TimezoneInfo", "bases": ["datetime.tzinfo"], "methods": ["__init__", "utcoffset", "tzname", "dst"], "docstring": "Subclass of the `~datetime.tzinfo` object, used in the\nto_datetime method to specify timezones.\n\nIt may be safer in most cases to use a timezone database package like\npytz rather than defining your own timezones - this class is mainly\na workaround for users without pytz.", "start_line": 626, "end_line": 674}, {"name": "TimeString", "bases": ["TimeUnique"], "methods": ["_check_val_type", "parse_string", "set_jds", "str_kwargs", "format_string", "value", "_select_subfmts"], "docstring": "Base class for string-like time representations.\n\nThis class assumes that anything following the last decimal point to the\nright is a fraction of a second.\n\nThis is a reference implementation can be made much faster with effort.", "start_line": 677, "end_line": 823}, {"name": "TimeISO", "bases": ["TimeString"], "methods": ["parse_string"], "docstring": "ISO 8601 compliant date-time format \"YYYY-MM-DD HH:MM:SS.sss...\".\nFor example, 2000-01-01 00:00:00.000 is midnight on January 1, 2000.\n\nThe allowed subformats are:\n\n- 'date_hms': date + hours, mins, secs (and optional fractional secs)\n- 'date_hm': date + hours, mins\n- 'date': date", "start_line": 826, "end_line": 857}, {"name": "TimeISOT", "bases": ["TimeISO"], "methods": [], "docstring": "ISO 8601 compliant date-time format \"YYYY-MM-DDTHH:MM:SS.sss...\".\nThis is the same as TimeISO except for a \"T\" instead of space between\nthe date and time.\nFor example, 2000-01-01T00:00:00.000 is midnight on January 1, 2000.\n\nThe allowed subformats are:\n\n- 'date_hms': date + hours, mins, secs (and op", "start_line": 860, "end_line": 883}, {"name": "TimeYearDayTime", "bases": ["TimeISO"], "methods": [], "docstring": "Year, day-of-year and time as \"YYYY:DOY:HH:MM:SS.sss...\".\nThe day-of-year (DOY) goes from 001 to 365 (366 in leap years).\nFor example, 2000:001:00:00:00.000 is midnight on January 1, 2000.\n\nThe allowed subformats are:\n\n- 'date_hms': date + hours, mins, secs (and optional fractional secs)\n- 'date_hm'", "start_line": 886, "end_line": 908}, {"name": "TimeFITS", "bases": ["TimeString"], "methods": ["parse_string", "format_string", "value"], "docstring": "FITS format: \"[\u00b1Y]YYYY-MM-DD[THH:MM:SS[.sss]][(SCALE[(REALIZATION)])]\".\n\nISOT with two extensions:\n- Can give signed five-digit year (mostly for negative years);\n- A possible time scale (and realization) appended in parentheses.\n\nNote: FITS supports some deprecated names for timescales; these are\ntr", "start_line": 911, "end_line": 1013}, {"name": "TimeEpochDate", "bases": ["TimeFormat"], "methods": ["set_jds", "value"], "docstring": "Base class for support floating point Besselian and Julian epoch dates", "start_line": 1016, "end_line": 1030}, {"name": "TimeBesselianEpoch", "bases": ["TimeEpochDate"], "methods": ["_check_val_type"], "docstring": "Besselian Epoch year as floating point value(s) like 1950.0", "start_line": 1033, "end_line": 1046}, {"name": "TimeJulianEpoch", "bases": ["TimeEpochDate"], "methods": [], "docstring": "Julian Epoch year as floating point value(s) like 2000.0", "start_line": 1049, "end_line": 1054}, {"name": "TimeEpochDateString", "bases": ["TimeString"], "methods": ["set_jds", "value"], "docstring": "Base class to support string Besselian and Julian epoch dates\nsuch as 'B1950.0' or 'J2000.0' respectively.", "start_line": 1057, "end_line": 1094}, {"name": "TimeBesselianEpochString", "bases": ["TimeEpochDateString"], "methods": [], "docstring": "Besselian Epoch year as string value(s) like 'B1950.0'", "start_line": 1097, "end_line": 1102}, {"name": "TimeJulianEpochString", "bases": ["TimeEpochDateString"], "methods": [], "docstring": "Julian Epoch year as string value(s) like 'J2000.0'", "start_line": 1105, "end_line": 1110}, {"name": "TimeDeltaFormatMeta", "bases": ["TimeFormatMeta"], "methods": [], "docstring": "", "start_line": 1113, "end_line": 1114}, {"name": "TimeDeltaFormat", "bases": ["TimeFormat"], "methods": ["_check_scale", "set_jds", "value"], "docstring": "Base class for time delta representations", "start_line": 1117, "end_line": 1137}, {"name": "TimeDeltaSec", "bases": ["TimeDeltaFormat"], "methods": [], "docstring": "Time delta in SI seconds", "start_line": 1140, "end_line": 1143}, {"name": "TimeDeltaJD", "bases": ["TimeDeltaFormat"], "methods": [], "docstring": "Time delta in Julian days (86400 SI seconds)", "start_line": 1146, "end_line": 1149}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/time/core.py", "file_hash": "a87316960cf9c62a6f54f814c9400ee117d9b7d9adcd95ab8501699dc3e95037", "imports": [{"module": "copy", "names": [], "is_from": false, "alias": ""}, {"module": "operator", "names": [], "is_from": false, "alias": ""}, {"module": "datetime", "names": ["datetime"], "is_from": true, "alias": ""}, {"module": "collections", "names": ["defaultdict"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "", "names": ["units", "constants"], "is_from": true, "alias": ""}, {"module": "", "names": ["_erfa"], "is_from": tr