f quantities does not have unit", "start_line": 524, "end_line": 533, "is_async": false, "is_method": false}, {"name": "test_skycoord_representation", "qualified_name": "test_skycoord_representation", "args": [], "decorators": [], "docstring": "Test that skycoord representation works, both in the way that the\nvalues are output and in changing the frame representation.", "start_line": 536, "end_line": 567, "is_async": false, "is_method": false}, {"name": "test_ndarray_mixin", "qualified_name": "test_ndarray_mixin", "args": [], "decorators": [], "docstring": "Test directly adding a plain structured array into a table instead of the\nview as an NdarrayMixin.  Once added as an NdarrayMixin then all the previous\ntests apply.", "start_line": 570, "end_line": 627, "is_async": false, "is_method": false}, {"name": "test_possible_string_format_functions", "qualified_name": "test_possible_string_format_functions", "args": [], "decorators": [], "docstring": "The QuantityInfo info class for Quantity implements a\npossible_string_format_functions() method that overrides the\nstandard pprint._possible_string_format_functions() function.\nTest this.", "start_line": 630, "end_line": 657, "is_async": false, "is_method": false}, {"name": "test_rename_mixin_columns", "qualified_name": "test_rename_mixin_columns", "args": ["mixin_cols"], "decorators": [], "docstring": "Rename a mixin column.", "start_line": 660, "end_line": 674, "is_async": false, "is_method": false}, {"name": "pickle_roundtrip", "qualified_name": "pickle_roundtrip", "args": ["c"], "decorators": [], "docstring": "", "start_line": 335, "end_line": 336, "is_async": false, "is_method": false}, {"name": "init_from_class", "qualified_name": "init_from_class", "args": ["c"], "decorators": [], "docstring": "", "start_line": 338, "end_line": 339, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/table/scripts/__init__.py", "file_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/table/scripts/showtable.py", "file_hash": "1c43909c8e64e3e580cd93fb86e01dc25122c2132b3298a50e094a45cd591803", "imports": [{"module": "argparse", "names": [], "is_from": false, "alias": ""}, {"module": "textwrap", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "astropy", "names": ["log"], "is_from": true, "alias": ""}, {"module": "astropy.table", "names": ["Table"], "is_from": true, "alias": ""}, {"module": "astropy.utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}], "functions": [{"name": "showtable", "qualified_name": "showtable", "args": ["filename", "args"], "decorators": [], "docstring": "Read a table and print to the standard output.\n\nParameters\n----------\nfilename : str\n    The path to a FITS file.", "start_line": 53, "end_line": 88, "is_async": false, "is_method": false}, {"name": "main", "qualified_name": "main", "args": ["args"], "decorators": [], "docstring": "The main function called by the `showtable` script.", "start_line": 91, "end_line": 158, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "``showtable`` is a command-line script based on ``astropy.io`` and\n``astropy.table`` for printing ASCII, FITS, HDF5 or VOTable files(s) to the\nstandard output.\n\nExample usage of ``showtable``:\n\n1. FITS::\n\n    $ showtable astropy/io/fits/tests/data/table.fits\n\n     target V_mag\n    ------- -----\n    NGC1001  11.1\n    NGC1002  12.3\n    NGC1003  15.2\n\n2. ASCII::\n\n    $ showtable astropy/io/ascii/tests/t/simple_csv.csv\n\n     a   b   c\n    --- --- ---\n      1   2   3\n      4   5   6\n\n3. XML::\n\n    $ showtable astropy/io/votable/tests/data/names.xml --max-width 70\n\n               col1             col2     col3  ... col15 col16 col17\n               ---              deg      deg   ...  mag   mag   ---\n    ------------------------- -------- ------- ... ----- ----- -----\n    SSTGLMC G000.0000+00.1611   0.0000  0.1611 ...    --    --    AA\n\n\n\n4. Print all the FITS tables in the current directory::\n\n    $ showtable *.fits", "parse_error": ""}, {"file_path": "astropy/visualization/tests/test_units.py", "file_hash": "b402127848afbd6c3cee827c4ea01c431f81492bf61098763d392ff71b7b25c7", "imports": [{"module": "io", "names": [], "is_from": false, "alias": ""}, {"module": "pytest", "names": [], "is_from": false, "alias": ""}, {"module": "", "names": ["units"], "is_from": true, "alias": ""}, {"module": "units", "names": ["quantity_support"], "is_from": true, "alias": ""}, {"module": "matplotlib.pyplot", "names": [], "is_from": false, "alias": "plt"}], "functions": [{"name": "test_units", "qualified_name": "test_units", "args": [], "decorators": ["pytest.mark.skipif('not HAS_PLT')"], "docstring": "", "start_line": 21, "end_line": 37, "is_async": false, "is_method": false}, {"name": "test_incompatible_units", "qualified_name": "test_incompatible_units", "args": [], "decorators": ["pytest.mark.skipif('not HAS_PLT')"], "docstring": "", "start_line": 41, "end_line": 49, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/visualization/tests/test_norm.py", "file_hash": "218d88373f72a064535ca2a7eba7c8fab50bfe20a4cb098591c066b431beef48", "imports": [{"module": "pytest", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "numpy", "names": ["ma"], "is_from": true, "alias": ""}, {"module": "numpy.testing", "names": ["assert_allclose"], "is_from": true, "alias": ""}, {"module": "mpl_normalize", "names": ["ImageNormalize", "simple_norm"], "is_from": true, "alias": ""}, {"module": "interval", "names": ["ManualInterval"], "is_from":