], "docstring": "Returns a *read-only* copy of the row values in the form of np.void or\nnp.ma.mvoid objects.  This corresponds to the object types returned for\nrow indexing of a pure numpy structured array or masked array. This\nmethod is slow and its use is discouraged when possible.\n\nReturns\n-------\nvoid_row : np.v", "start_line": 88, "end_line": 122, "is_async": false, "is_method": false}, {"name": "meta", "qualified_name": "meta", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 125, "end_line": 126, "is_async": false, "is_method": false}, {"name": "columns", "qualified_name": "columns", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 129, "end_line": 130, "is_async": false, "is_method": false}, {"name": "colnames", "qualified_name": "colnames", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 133, "end_line": 134, "is_async": false, "is_method": false}, {"name": "dtype", "qualified_name": "dtype", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 137, "end_line": 138, "is_async": false, "is_method": false}, {"name": "_base_repr_", "qualified_name": "_base_repr_", "args": ["self", "html"], "decorators": [], "docstring": "Display row as a single-line table but with appropriate header line.", "start_line": 140, "end_line": 152, "is_async": false, "is_method": false}, {"name": "_repr_html_", "qualified_name": "_repr_html_", "args": ["self"], "decorators": [], "docstring": "", "start_line": 154, "end_line": 155, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 157, "end_line": 158, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 160, "end_line": 162, "is_async": false, "is_method": false}, {"name": "__bytes__", "qualified_name": "__bytes__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 164, "end_line": 165, "is_async": false, "is_method": false}], "classes": [{"name": "Row", "bases": [], "methods": ["__init__", "__getitem__", "__setitem__", "__eq__", "__ne__", "__array__", "__len__", "__iter__", "table", "index", "as_void", "meta", "columns", "colnames", "dtype", "_base_repr_", "_repr_html_", "__repr__", "__str__", "__bytes__"], "docstring": "A class to represent one row of a Table object.\n\nA Row object is returned when a Table object is indexed with an integer\nor when iterating over a table::\n\n  >>> from astropy.table import Table\n  >>> table = Table([(1, 2), (3, 4)], names=('a', 'b'),\n  ...               dtype=('int32', 'int32'))\n  >>>", "start_line": 9, "end_line": 165}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/table/column.py", "file_hash": "efa80ae46066eceb953d36400171f7d9836721c9ffa2688a9c7a0ab132de8c18", "imports": [{"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "weakref", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "copy", "names": ["deepcopy"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "numpy", "names": ["ma"], "is_from": true, "alias": ""}, {"module": "units", "names": ["Unit", "Quantity"], "is_from": true, "alias": ""}, {"module": "utils.console", "names": ["color_print"], "is_from": true, "alias": ""}, {"module": "utils.metadata", "names": ["MetaData"], "is_from": true, "alias": ""}, {"module": "utils.data_info", "names": ["BaseColumnInfo", "dtype_info_name"], "is_from": true, "alias": ""}, {"module": "utils.misc", "names": ["dtype_bytes_or_chars"], "is_from": true, "alias": ""}, {"module": "", "names": ["groups"], "is_from": true, "alias": ""}, {"module": "", "names": ["pprint"], "is_from": true, "alias": ""}, {"module": "np_utils", "names": ["fix_column_name"], "is_from": true, "alias": ""}, {"module": "_column_mixins", "names": ["_ColumnGetitemShim", "_MaskedColumnGetitemShim"], "is_from": true, "alias": ""}, {"module": "numpy.ma.core", "names": ["MaskedArrayFutureWarning"], "is_from": true, "alias": ""}, {"module": "", "names": ["conf"], "is_from": true, "alias": ""}, {"module": "utils.xml.writer", "names": ["xml_escape"], "is_from": true, "alias": ""}], "functions": [{"name": "_auto_names", "qualified_name": "_auto_names", "args": ["n_cols"], "decorators": [], "docstring": "", "start_line": 54, "end_line": 56, "is_async": false, "is_method": false}, {"name": "col_copy", "qualified_name": "col_copy", "args": ["col", "copy_indices"], "decorators": [], "docstring": "Mixin-safe version of Column.copy() (with copy_data=True).\n\nParameters\n----------\ncol : Column or mixin column\n    Input column\ncopy_indices : bool\n    Copy the column ``indices`` attribute\n\nReturns\n-------\ncol : Copy of input column", "start_line": 68, "end_line": 107, "is_async": false, "is_method": false}, {"name": "__new__", "qualified_name": "__new__", "args": ["cls", "shape"], "decorators": [], "docstring": "", "start_line": 126, "end_line": 128, "is_async": false, "is_method": false}, {"name": "__setitem__", "qualified_name": "__setitem__", "args": ["self", "item", "val"], "decorators": [], "docstring": "", "start_line": 130, "end_line": 134, "is_async": false, "is_method": false}, {"name": "new_like", "qualified_name": "new_like", "args": ["self", "cols", "length", "metadata_conflicts", "name"], "decorators": [], "docstring": "Return a new Column instance which is consistent with the\ninput ``cols`` and has ``length`` rows.\n\nThis is intended for creating an empty column object whose elements can\nbe set in-place for table operations like join or vstack.\n\nParameters\n----------\ncols : list\n    List of input columns\nlength : i", "start_line": 147, "end_line": 175, "is_async": false, "is_method": false}, {"name": "__new__", "qualified_name": "__new__", "args": ["cls", "data", "name", "dtype", "shape", "length", "description", "unit", "format", "meta", "copy", "copy_indices"], "decorators": [], "docstring": "", "start_line": 182, "end_line": 235, "is_async": false, "is_method": false}, {"name": "data", "qualified_name": "data", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 238, "end_line": 239, "is_async": false, "is_method": false}, {"name": "parent_table", "qualified_name": "parent_table", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 242, "end_line": 249, "is_async": false, "is_method": false}, {"name": "parent_table", "qualified_name": "parent_table", "args": ["self", "table"], "decorators": ["parent_table.setter"], "docstring": "", "start_line": 252, "end_line": 256, "is_async": false, "is_method": false}, {"name": "copy", "qualified_name": "copy", "args": ["self", "order", "data", "copy_data"], "decorators": [], "docstring": "Return a copy of the current instance.\n\nIf ``data`` is supplied then a view (reference) of ``data`` is used,\nand ``copy_data`` is ignored.\n\nParameters\n----------\norder : {'C', 'F', 'A', 'K'}, optional\n    Controls the memory layout of the copy. 'C' means C-order,\n    'F' means F-order, 'A' means 'F'", "start_line": 260, "end_line": 302, "is_async": false, "is_method": false}, {"name": "__setstate__", "qualified_name": "__setstate__", "args": ["self", "state"], "decorators": [], "docstring": "Restore the internal state of the Column/MaskedColumn for pickling\npurposes.  This requires that the last element of ``state`` is a\n5-tuple that has Column-specific state values.", "start_line": 304, "end_line": 328, "is_async": false, "is_method": false}, {"name": "__reduce__", "qualified_name": "__reduce__", "args": ["self"], "decorators": [], "docstring": "Return a 3-tuple for pickling a Column.  Use the super-class\nfunctionality but then add in a 5-tuple of Column-specific values\nthat get used in __setstate__.", "start_line": 330, "end_line": 344, "is_async": false, "is_method": false}, {"name": "__array_finalize__", "qualified_name": "__array_finalize__", "args": ["self", "obj"], "decorators": [], "docstring": "", "start_line": 346, "end_line": 360, "is_async": false, "is_method": false}, {"name": "__array_wrap__", "qualified_name": "__array_wrap__", "args": ["self", "out_arr", "context"], "decorators": [], "docstring": "__array_wrap__ is called at the end of every ufunc.\n\nNormally, we want a Column object back and do not have to do anything\nspecial. But there are two exceptions:\n\n1) If the output shape is different (e.g. for reduction ufuncs\n   like sum() or mean()), a Column still linking to a parent_table\n   make", "start_line": 362, "end_line": 388, "is_async": false, "is_method": false}, {"name": "name", "qualified_name": "name", "args": ["self"], "decorators": ["property"], "docstring": "The name of this column.", "start_line": 391, "end_line": 395, "is_async": false, "is_method": false}, {"name": "name", "qualified_name": "name", "args": ["self", "val"], "decorators": ["name.setter"], "docstring": "", "start_line": 398, "end_line": 405, "is_async": false, "is_method": false}, {"name": "format", "qualified_name": "format", "args": ["self"], "decorators": ["property"], "docstring": "Format string for displaying values in this column.", "start_line": 408, "end_line": 413, "is_async": false, "is_method": false}, {"name": "format", "qualified_name": "format", "args": ["self", "format_string"], "decorators": ["format.setter"], "docstring": "", "start_line": 416, "end_line": 431, "is_async": false, "is_method": false}, {"name": "descr", "qualified_name": "descr", "args": ["self"], "decorators": ["property"], "docstring": "Array-interface compliant full description of the column.\n\nThis returns a 3-tuple (name, type, shape) that can always be\nused in a structured array dtype definition.", "start_line": 434, "end_line": 440, "is_async": false, "is_method": false}, {"name": "iter_str_vals", "qualified_name": "iter_str_vals", "args": ["self"], "decorators": [], "docstring": "Return an iterator that yields the string-formatted values of this\ncolumn.\n\nReturns\n-------\nstr_vals : iterator\n    Column values formatted as strings", "start_line": 442, "end_line": 457, "is_async": false, "is_method": false}, {"name": "attrs_equal", "qualified_name": "attrs_equal", "args": ["self", "col"], "decorators": [], "docstring": "Compare the column attributes of ``col`` to this object.\n\nThe comparison attributes are: ``name``, ``unit``, ``dtype``,\n``format``, ``description``, and ``meta``.\n\nParameters\n----------\ncol : Column\n    Comparison column\n\nReturns\n-------\nequal : boolean\n    True if all attributes are equal", "start_line": 459, "end_line": 482, "is_async": false, "is_method": false}, {"name": "_formatter", "qualified_name": "_formatter", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 485, "end_line": 486, "is_async": false, "is_method": false}, {"name": "pformat", "qualified_name": "pformat", "args": ["self", "max_lines", "show_name", "show_unit", "show_dtype", "html"], "decorators": [], "docstring": "Return a list of formatted string representation of column values.\n\nIf no value of ``max_lines`` is supplied then the height of the\nscreen terminal is used to set ``max_lines``.  If the terminal\nheight cannot be determined then the default will be\ndetermined using the ``astropy.conf.max_lines`` conf", "start_line": 488, "end_line": 526, "is_async": false, "is_method": false}, {"name": "pprint", "qualified_name": "pprint", "args": ["self", "max_lines", "show_name", "show_unit", "show_dtype"], "decorators": [], "docstring": "Print a formatted string representation of column values.\n\nIf no value of ``max_lines`` is supplied then the height of the\nscreen terminal is used to set ``max_lines``.  If the terminal\nheight cannot be determined then the default will be\ndetermined using the ``astropy.conf.max_lines`` configuration", "start_line": 528, "end_line": 561, "is_async": false, "is_method": false}, {"name": "more", "qualified_name": "more", "args": ["self", "max_lines", "show_name", "show_unit"], "decorators": [], "docstring": "Interactively browse column with a paging interface.\n\nSupported keys::\n\n  f, <space> : forward one page\n  b : back one page\n  r : refresh same page\n  n : next row\n  p : previous row\n  < : go to beginning\n  > : go to end\n  q : quit browsing\n  h : print this help\n\nParameters\n----------\nmax_lines : int", "start_line": 563, "end_line": 592, "is_async": false, "is_method": false}, {"name": "unit", "qualified_name": "unit", "args": ["self"], "decorators": ["property"], "docstring": "The unit associated with this column.  May be a string or a\n`astropy.units.UnitBase` instance.\n\nSetting the ``unit`` property does not change the values of the\ndata.  To perform a unit conversion, use ``convert_unit_to``.", "start_line": 595, "end_line": 603, "is_async": false, "is_method": false}, {"name": "unit", "qualified_name": "unit", "args": ["self", "unit"], "decorators": ["unit.setter"], "docstring": "", "start_line": 606, "end_line": 610, "is_async": false, "is_method": false}, {"name": "unit", "qualified_name": "unit", "args": ["self"], "decorators": ["unit.deleter"], "docstring": "", "start_line": 613, "end_line": 614, "is_async": false, "is_method": false}, {"name": "convert_unit_to", "qualified_name": "convert_unit_to", "args": ["self", "new_unit", "equivalencies"], "decorators": [], "docstring": "Converts the values of the column in-place from the current\nunit to the given unit.\n\nTo change the unit associated with this column without\nactually changing the data values, simply set the ``unit``\nproperty.\n\nParameters\n----------\nnew_unit : str or `astropy.units.UnitBase` instance\n    The unit to ", "start_line": 616, "end_line": 643, "is_async": false, "is_method": false}, {"name": "groups", "