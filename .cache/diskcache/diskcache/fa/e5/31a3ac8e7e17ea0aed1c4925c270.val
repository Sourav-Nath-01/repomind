": false, "is_method": false}, {"name": "find_all_wcs", "qualified_name": "find_all_wcs", "args": ["header", "relax", "keysel", "fix", "translate_units", "_do_set"], "decorators": [], "docstring": "Find all the WCS transformations in the given header.\n\nParameters\n----------\nheader : str or astropy.io.fits header object.\n\nrelax : bool or int, optional\n    Degree of permissiveness:\n\n    - `True` (default): Admit all recognized informal extensions of the\n      WCS standard.\n\n    - `False`: Recogn", "start_line": 3088, "end_line": 3176, "is_async": false, "is_method": false}, {"name": "validate", "qualified_name": "validate", "args": ["source"], "decorators": [], "docstring": "Prints a WCS validation report for the given FITS file.\n\nParameters\n----------\nsource : str path, readable file-like object or `astropy.io.fits.HDUList` object\n    The FITS file to validate.\n\nReturns\n-------\nresults : WcsValidateResults instance\n    The result is returned as nested lists.  The first", "start_line": 3179, "end_line": 3288, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 190, "end_line": 204, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "header", "fobj", "key", "minerr", "relax", "naxis", "keysel", "colsel", "fix", "translate_units", "_do_set"], "decorators": [], "docstring": "", "start_line": 358, "end_line": 509, "is_async": false, "is_method": false}, {"name": "__copy__", "qualified_name": "__copy__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 511, "end_line": 518, "is_async": false, "is_method": false}, {"name": "__deepcopy__", "qualified_name": "__deepcopy__", "args": ["self", "memo"], "decorators": [], "docstring": "", "start_line": 520, "end_line": 533, "is_async": false, "is_method": false}, {"name": "copy", "qualified_name": "copy", "args": ["self"], "decorators": [], "docstring": "Return a shallow copy of the object.\n\nConvenience method so user doesn't have to import the\n:mod:`copy` stdlib module.\n\n.. warning::\n    Use `deepcopy` instead of `copy` unless you know why you need a\n    shallow copy.", "start_line": 535, "end_line": 546, "is_async": false, "is_method": false}, {"name": "deepcopy", "qualified_name": "deepcopy", "args": ["self"], "decorators": [], "docstring": "Return a deep copy of the object.\n\nConvenience method so user doesn't have to import the\n:mod:`copy` stdlib module.", "start_line": 548, "end_line": 555, "is_async": false, "is_method": false}, {"name": "sub", "qualified_name": "sub", "args": ["self", "axes"], "decorators": [], "docstring": "", "start_line": 557, "end_line": 561, "is_async": false, "is_method": false}, {"name": "_fix_scamp", "qualified_name": "_fix_scamp", "args": ["self"], "decorators": [], "docstring": "Remove SCAMP's PVi_m distortion parameters if SIP distortion parameters\nare also present. Some projects (e.g., Palomar Transient Factory)\nconvert SCAMP's distortion parameters (which abuse the PVi_m cards) to\nSIP. However, wcslib gets confused by the presence of both SCAMP and\nSIP distortion paramet", "start_line": 565, "end_line": 606, "is_async": false, "is_method": false}, {"name": "fix", "qualified_name": "fix", "args": ["self", "translate_units", "naxis"], "decorators": [], "docstring": "Perform the fix operations from wcslib, and warn about any\nchanges it has made.\n\nParameters\n----------\ntranslate_units : str, optional\n    Specify which potentially unsafe translations of\n    non-standard unit strings to perform.  By default,\n    performs none.\n\n    Although ``\"S\"`` is commonly used", "start_line": 608, "end_line": 654, "is_async": false, "is_method": false}, {"name": "calc_footprint", "qualified_name": "calc_footprint", "args": ["self", "header", "undistort", "axes", "center"], "decorators": [], "docstring": "Calculates the footprint of the image on the sky.\n\nA footprint is defined as the positions of the corners of the\nimage on the sky after all available distortions have been\napplied.\n\nParameters\n----------\nheader : `~astropy.io.fits.Header` object, optional\n    Used to get ``NAXIS1`` and ``NAXIS2``\n  ", "start_line": 656, "end_line": 723, "is_async": false, "is_method": false}, {"name": "_read_det2im_kw", "qualified_name": "_read_det2im_kw", "args": ["self", "header", "fobj", "err"], "decorators": [], "docstring": "Create a `distortion paper`_ type lookup table for detector to\nimage plane correction.", "start_line": 725, "end_line": 789, "is_async": false, "is_method": false}, {"name": "_read_d2im_old_format", "qualified_name": "_read_d2im_old_format", "args": ["self", "header", "fobj", "axiscorr"], "decorators": [], "docstring": "", "start_line": 791, "end_line": 824, "is_async": false, "is_method": false}, {"name": "_write_det2im", "qualified_name": "_write_det2im", "args": ["self", "hdulist"], "decorators": [], "docstring": "Writes a `distortion paper`_ type lookup table to the given\n`astropy.io.fits.HDUList`.", "start_line": 826, "end_line": 870, "is_async": false, "is_method": false}, {"name": "_read_distortion_kw", "qualified_name": "_read_distortion_kw", "args": ["self", "header", "fobj", "dist", "err"], "decorators": [], "docstring": "Reads `distortion paper`_ table-lookup keywords and data, and\nreturns a 2-tuple of `~astropy.wcs.DistortionLookupTable`\nobjects.\n\nIf no `distortion paper`_ keywords are found, ``(None, None)``\nis returned.", "start_line": 872, "end_line": 944, "is_async": false, "is_method": false}, {"name": "_write_distortion_kw", "qualified_name": "_write_distortion_kw", "args": ["self", "hdulist", "dist"], "decorators": [], "docstring": "Write out `distortion paper`_ keywords to the given\n`fits.HDUList`.", "start_line": 946, "end_line": 990, "is_async": false, "is_method": false}, {"name": "_remove_sip_kw", "qualified_name": "_remove_sip_kw", "args": ["self", "header"], "decorators": [], "docstring": "Remove SIP information from a header.", "start_line": 992, "end_line": 1000, "is_async": false, "is_method": false}, {"name": "_read_sip_kw", "qualified_name": "_read_sip_kw", "args": ["self", "header", "wcskey"], "decorators": [], "docstring": "Reads `SIP`_ header keywords and returns a `~astropy.wcs.Sip`\nobject.\n\nIf no `SIP`_ header keywords are found, ``None`` is returned.", "start_line": 1002, "end_line": 1119, "is_async": false, "is_method": false}, {"name": "_write_sip_kw", "qualified_name": "_write_sip_kw", "args": ["self"], "decorators": [], "docstring": "Write out SIP keywords.  Returns a dictionary of key-value\npairs.", "start_line": 1121, "end_line": 1147, "is_async": false, "is_method": false}, {"name": "_denormalize_sky", "qualified_name": "_denormalize_sky", "args": ["self", "sky"], "decorators": [], "docstring": "", "start_line": 1149, "end_line": 1177, "is_async": false, "is_method": false}, {"name": "_normalize_sky", "qualified_name": "_normalize_sky", "args": ["self", "sky"], "decorators": [], "docstring": "", "start_line": 1179, "end_line": 1206, "is_async": false, "is_method": false}, {"name": "_array_converter", "qualified_name": "_array_converter", "args": ["self", "func", "sky"], "decorators": [], "docstring": "A helper function to support reading either a pair of arrays\nor a single Nx2 array.", "start_line": 1208, "end_line": 1276, "is_async": false, "is_method": false}, {"name": "all_pix2world", "qualified_name": "all_pix2world", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1278, "end_line": 1280, "is_async": false, "is_method": false}, {"name": "wcs_pix2world", "qualified_name": "wcs_pix2world", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1349, "end_line": 1354, "is_async": false, "is_method": false}, {"name": "_all_world2pix", "qualified_name": "_all_world2pix", "args": ["self", "world", "origin", "tolerance", "maxiter", "adaptive", "detect_divergence", "quiet"], "decorators": [], "docstring": "", "start_line": 1418, "end_line": 1814, "is_async": false, "is_method": false}, {"name": "all_world2pix", "qualified_name": "all_world2pix", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1816, "end_line": 1828, "is_async": false, "is_method": false}, {"name": "wcs_world2pix", "qualified_name": "wcs_world2pix", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2156, "end_line": 2161, "is_async": false, "is_method": false}, {"name": "pix2foc", "qualified_name": "pix2foc", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2219, "end_line": 2220, "is_async": false, "is_method": false}, {"name": "p4_pix2foc", "qualified_name": "p4_pix2foc", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2249, "end_line": 2250, "is_async": false, "is_method": false}, {"name": "det2im", "qualified_name": "det2im", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2278, "end_line": 2279, "is_async": false, "is_method": false}, {"name": "sip_pix2foc", "qualified_name": "sip_pix2foc", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2307, "end_line": 2315, "is_async": false, "is_method": false}, {"name": "sip_foc2pix", "qualified_name": "sip_foc2pix", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2348, "end_line": 2356, "is_async": false, "is_method": false}, {"name": "to_fits", "qualified_name": "to_fits", "args": ["self", "relax", "key"], "decorators": [], "docstring": "Generate an `astropy.io.fits.HDUList` object with all of the\ninformation stored in this object.  This should be logically identical\nto the input FITS file, but it will be normalized in a number of ways.\n\nSee `to_header` for some warnings about the output produced.\n\nParameters\n----------\n\nrelax : boo", "start_line": 2385, "end_line": 2426, "is_async": false, "is_method": false}, {"name": "to_header", "qualified_name": "to_header", "args": ["self", "relax", "key"], "decorators": [], "docstring": "Generate an `astropy.io.fits.Header` object with the basic WCS\nand SIP information stored in this object.  This should be\nlogically identical to the input FITS file, but it will be\nnormalized in a number of ways.\n\n.. warning::\n\n  This function does not write out FITS WCS `distortion\n  paper`_ inform", "start_line": 2428, "end_line": 2563, "is_async": false, "is_method": false}, {"name": "_fix_ctype", "qualified_name": "_fix_ctype", "args": ["self", "header", "add_sip", "log_message"], "decorators": [], "docstring": "Parameters\n----------\nheader : `~astropy.io.fits.Header`\n    FITS header.\nadd_sip : bool\n    Flag indicating whether \"-SIP\" should be added or removed from CTYPE keywords.\n\n    Remove \"-SIP\" from CTYPE when writing out a header with relax=False.\n    This needs to be done outside ``to_header`` becaus", "start_line": 2565, "end_line": 2614, "is_async": false, "is_method": false}, {"name": "to_header_string", "qualified_name": "to_header_string", "args": ["self", "relax"], "decorators": [], "docstring": "Identical to `to_header`, but returns a string containing the\nheader cards.", "start_line": 2616, "end_line": 2621, "is_async": false, "is_method": false}, {"name": "footprint_to_file", "qualified_name": "footprint_to_file", "args": ["self", "filename", "color", "width", "coordsys"], "decorators": [], "docstring": "Writes out a `ds9`_ style regions file. It can be loaded\ndirectly by `ds9`_.\n\nParameters\n----------\nfilename : str, optional\n    Output file name - default is ``'footprint.reg'``\n\ncolor : str, optional\n    Color to use when plotting the line.\n\nwidth : int, optional\n    Width of the region line.\n\ncoo", "start_line": 2623, "end_line": 2665, "is_async": false, "is_method": false}, {"name": "_naxis1", "qualified_name": "_naxis1", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 2668, "end_line": 2669, "is_async": false, "is_method": false}, {"name": "_naxis1", "qualified_name": "_naxis1", "args": ["self", "value"], "decorators": ["_naxis1.setter"], "docstring": "", "start_line": 2672, "end_line": 2673, "is_async": false, "is_method": false}, {"name": "_naxis2", "qualified_name": "_naxis2", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 2676, "end_line": 2677, "is_async": false, "is_method": false}, {"name": "_naxis2", "qualified_name": "_naxis2", "args": ["self", "value"], "decorators": ["_naxis2.setter"], "docstring": "", "start_line": 2680, "end_line": 2681, "is_async": false, "is_method": false}, {"name": "_get_naxis", "qualified_name": "_get_naxis", "args": ["self", "header"], "decorators": [], "docstring": "", "start_line": 2683, "end_line": 2696, "is_async": false, "is_method": false}, {"name": "printwcs", "qualified_name": "printwcs", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2698, "end_line": 2699, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "Return a short description. Simply porting the behavior from\nthe `printwcs()` method.", "start_line": 2701, "end_line": 2733, "is_async": false, "is_method": false}, {"name": "get_axis_types", "qualified_name": "get_axis_types", "args": ["self"], "decorators": [], "docstring": "Similar to `self.wcsprm.axis_types <astropy.wcs.Wcsprm.axis_types>`\nbut provides the information in a more Python-friendly format.\n\nReturns\n-------\nresult : list of dicts\n\n    Returns a list of dictionaries, one for each axis, each\n    containing attributes about the type of that axis.\n\n    Each dic", "start_line": 2735, "end_line": 2830, "is_async": false, "is_method": false}, {"name": "__reduce__", "qualified_name": "__reduce__", "args": ["self"], "decorators": [], "docstring": "Support pickling of WCS objects.  This is done by serializing\nto an in-memory FITS file and dumping that as a string.", "start_line": 2832, "end_line": 2844, "is_async": false, "is_method": false}, {"name": "dropaxis", "qualified_name": "dropaxis", "args": ["self", "dropax"], "decorators": [], "docstring": "Remove an axis from the WCS.\n\nParameters\n----------\nwcs : `~astropy.wcs.WCS`\n    The WCS with naxis to be chopped to naxis-1\ndropax : int\n    The index of the WCS to drop, counting from 0 (i.e., python convention,\n    not FITS convention)\n\nReturns\n-------\nA new `~astropy.wcs.WCS` instance with one a", "start_line": 2846, "end_line": 2868, "is_async": false, "is_method": false}, {"name": "swapaxes", "qualified_name": "swapaxes", "args": ["self", "ax0", "ax1"], "decorators": [], "docstring": "Swap axes in a WCS.\n\nParameters\n----------\nwcs : `~astropy.wcs.WCS`\n    The WCS to have its axes swapped\nax0 : int\nax1 : int\n    The indices of the WCS to be swapped, counting from 0 (i.e., python\n    convention, not FITS convention)\n\nReturns\n-------\nA new `~astropy.wcs.WCS` instance with the same n", "start_line": 2870, "end_line": 2891, "is_async": false, "is_method": false}, {"name": "reorient_celestial_first", "qualified_name": "reorient_celestial_first", "args": ["self"], "decorators": [], "docstring": "Reorient the WCS such that the celestial axes are first, followed by\nthe spectral axis, followed by any others.\nAssumes at least celestial axes are present.", "start_line": 2893, "end_line": 2899, "is_async": false, "is_method": false}, {"name": "slice", "qualified_name": "slice", "args": ["self", "view", "numpy_order"], "decorators": [], "docstring": "Slice a WCS instance using a Numpy slice. The order of the slice should\nbe reversed (as for the data) compared to the natural WCS order.\n\nParameters\n----------\nview : tuple\n    A tuple containing the same number of slices as the WCS system.\n    The ``step`` method, the third argument to a slice, is ", "start_line": 2901, "end_line": 2978, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "item"], "decorators": [], "docstring": "", "start_line": 2980, "end_line": 2985, "is_async": false, "is_method": false}, {"name": "__iter__", "qualified_name": "__iter__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2987, "end_line": 2991, "is_async": false, "is_method": false}, {"name": "axis_type_names", "qualified_name": "axis_type_names", "args": ["self"], "decorators": ["property"], "docstring": "World names for each coordinate axis\n\nReturns\n-------\nA list of names along each axis", "start_line": 2994, "end_line": 3008, "is_async": false, "is_method": false}, {"name": "celestial", "qualified_name": "celestial", "args": ["self"], "decorators": ["property"], "docstring": "A copy of the current WCS with only the celestial axes included", "start_line": 3011, "end_line": 3015, "is_async": false, "is_method": false}, {"name": "is_celestial", "qualified_name": "is_celestial", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 3018, "end_line": 3019, "is_async": false, "is_method": false}, {"name": "has_celestial", "qualified_name": "has_celestial", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 3022, "end_line": 3026, "is_async": false, "is_method": false}, {"name": "pixel_scale_matrix", "qualified_name": "pixel_scale_matrix", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 3029, "end_line": 3048, "is_async": false, "is_method": false}, {"name": "_as_mpl_axes", "qualified_name": "_as_mpl_axes", "args": ["self"], "decorators": [], "docstring": "Compatibility hook for Matplotlib and WCSAxes.\n\nWith this method, one can do:\n\n    from astropy.wcs import WCS\n    import matplotlib.pyplot as plt\n\n    wcs = WCS('filename.fits')\n\n    fig = plt.figure()\n    ax = fig.add_axes([0.15, 0.1, 0.8, 0.8], projection=wcs)\n    ...\n\nand this will generate a pl", "start_line": 3050, "end_line": 3069, "is_async": false, "is_method": false}, {"name": "write_d2i", "qualified_name": "write_d2i", "args": ["num", "det2im"], "decorators": [], "docstring": "", "start_line": 838, "end_line": 868, "is_async": false, "is_method": false}, {"name": "write_dist", "qualified_name": "write_dist", "args": ["num", "cpdis"], "decorators": [], "docstring": "", "start_line": 961, "end_line": 987, "is_async": false, "is_method": false}, {"name": "write_array", "qualified_name": "write_array", "args": ["name", "a"], "decorators": [], "docstring": "", "start_line": 1131, "end_line": 1140, "is_async": false, "is_method": false}, {"name": "_return_list_of_arrays", "qualified_name": "_return_list_of_arrays", "args": ["axes", "origin"], "decorators": [], "docstring": "", "start_line": 1214, "end_line": 1231, "is_async": false, "is_method": false}, {"name": "_return_single_array", "qualified_name": "_return_single_array", "args": ["xy", "origin"], "decorators": [], "docstring": "", "start_line": 1233, "end_line": 1243, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "key"], "decorators": [], "docstring": "", "start_line": 3198, "end_line": 3199, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 3201, "end_line": 3217, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "hdu_index", "hdu_name"], "decorators": [], "docstring": "", "start_line": 3220, "end_line": 3223, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 3225, "end_line": 3235, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 3238, "end_line": 3244, "is_async": false, "is_method": false}], "classes": [{"name": "NoConvergence", "bases": ["Exception"], "methods": ["__init__"], "docstring": "An error class used to report non-convergence and/or divergence\nof numerical methods. It is used to report errors in the\niterative solution used by\nthe :py:meth:`~astropy.wcs.WCS.all_world2pix`.\n\nAttributes\n----------\n\nbest_solution : `numpy.ndarray`\n    Best solution achieved by the numerical metho", "start_line": 155, "end_line": 204}, {"name": "FITSFixedWarning", "bases": ["AstropyWarning"], "methods": [], "docstring": "The warning raised when the contents of the FITS header have been\nmodified to be standards compliant.", "start_line": 207, "end_line": 212}, {"name": "WCS", "bases": ["WCSBase"], "methods": ["__init__", "__copy__", "__deepcopy__", "copy", "deepcopy", "sub", "_fix_scamp", "fix", "calc_footprint", "_read_det2im_kw", "_read_d2im_old_format", "_write_det2im", "_read_distortion_kw", "_write_distortion_kw", "_remove_sip_kw", "_read_sip_kw", "_write_sip_kw", "_denormalize_sky", "_normalize_sky", "_array_converter", "all_pix2world", "wcs_pix2world", "_all_world2pix", "all_world2pix", "wcs_world2pix", "pix2foc", "p4_pix2foc", "det2im", "sip_pix2foc", "sip_foc2pix", "to_fits", "to_header", "_fix_ctype", "to_header_string", "footprint_to_file", "_naxis1", "_naxis1", "_naxis2", "_naxis2", "_get_naxis", "printwcs", "__repr__", "get_axis_types", "__reduce__", "dropaxis", "swapaxes", "reorient_celestial_first", "slice", "__getitem__", "__iter__", "axis_type_names", "celestial", "is_celestial", "has_celestial", "pixel_scale_matrix", "_as_mpl_axes"], "docstring": "WCS objects perform standard WCS transformations, and correct for\n`SIP`_ and `distortion paper`_ table-lookup transformations, based\non the WCS keywords and supplementary data read from a FITS file.\n\nParameters\n----------\nheader : astropy.io.fits header object, Primary HDU, Image HDU, string, dict-l", "start_line": 215, "end_line": 3069}, {"name": "_WcsValidateWcsResult", "bases": ["list"], "methods": ["__init__", "__repr__"], "docstring": "", "start_line": 3197, "end_line": 3217}, {"name": "_WcsValidateHduResult", "bases": ["list"], "methods": ["__init__", "__repr__"], "docstring": "", "start_line": 3219, "end_line": 3235}, {"name": "_WcsValidateResults", "bases": ["list"], "methods": ["__repr__"], "docstring": "", "start_line": 3237, "end_line": 3244}], "calls": [], "module_docstring": "Under the hood, there are 3 separate classes that perform different\nparts of the transformation:\n\n   - `~astropy.wcs.Wcsprm`: Is a direct wrapper of the core WCS\n     functionality in `wcslib`_.  (This includes TPV and TPD\n     polynomial distortion, but not SIP distortion).\n\n   - `~astropy.wcs.Sip`: Handles polynomial distortion as defined in the\n     `SIP`_ convention.\n\n   - `~astropy.wcs.DistortionLookupTable`: Handles `distortion paper`_\n     lookup tables.\n\nAdditionally, the class `WCS` aggregates all of these transformations\ntogether in a pipeline:\n\n   - Detector to image plane correction (by a pair of\n     `~astropy.wcs.DistortionLookupTable` objects).\n\n   - `SIP`_ distortion correction (by an underlying `~astropy.wcs.Sip`\n     object)\n\n   - `distortion paper`_ table-lookup correction (by a pair of\n     `~astropy.wcs.DistortionLookupTable` objects).\n\n   - `wcslib`_ WCS transformation (by a `~astropy.wcs.Wcsprm` object)", "parse_error": ""}, {"file_path": "astropy/wcs/_docutil.py", "file_hash": "c3d6fdb8592c828c9798928a53c34479ce97a51704c97b552887dc1e33304725", "imports": [], "functions": [{"name": "_fix", "qualified_name": "_fix", "args": ["content", "indent"], "decorators": [], "docstring": "", "start_line": 11, "end_line": 14, "is_async": false, "is_method": false}, {"name": "TWO_OR_MORE_ARGS", "qualified_name": "TWO_OR_MORE_ARGS", "args": ["naxis", "indent"], "decorators": [], "docstring": "", "start_line": 17, "end_line": 32, "is_async": false, "is_method": false}, {"name": "RETURNS", "qualified_name": "RETURNS", "args": ["out_type", "indent"], "decorators": [], "docstring": "", "start_line": 35, "end_line": 39, "is_async": false, "is_method": false}, {"name": "ORIGIN", "qualified_name": "ORIGIN", "args": ["indent"], "decorators": [], "docstring": "", "start_line": 42, "end_line": 49, "is_async": false, "is_method": false}, {"name": "RA_DEC_ORDER", "qualified_name": "RA_DEC_ORDER", "args": ["indent"], "decorators": [], "docstring": "", "start_line": 52, "end_line": 60, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "astropy.wcs-specific utilities for generating boilerplate in docstrings.", "parse_error": ""}, {"file_path": "astropy/wcs/wcslint.py", "file_hash": "c4a29d4947b97acd96582a8330344b80e0c2b14c8d44072f50a506f7f9b2c8dd", "imports": [{"module": "", "names": ["wcs"], "is_from": true, "alias": ""}, {"module": "argparse", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "main", "qualified_name": "main", "args": ["args"], "decorators": [], "docstring": "", "start_line": 7, "end_line": 18, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "Script support for validating the WCS keywords in a FITS file.", "parse_error": ""}, {"file_path": "astropy/wcs/__init__.py", "file_hash": "ed0831132c31d356d8a553e0e77a8845908e345ce33a94bcd684a87dc3e72ab8", "imports": [{"module": "wcs", "names": ["*"], "is_from": true, "alias": ""}, {"module": "", "names": ["utils"], "is_from": true, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "get_include", "qualified_name": "get_include", "args": [], "decorators": [], "docstring": "Get the path to astropy.wcs's C header files.", "start_line": 36, "end_line": 41, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": ".. _wcslib: http://www.atnf.csiro.au/people/mcalabre/WCS/wcslib/index.html\n.. _distortion paper: http://www.atnf.csiro.au/people/mcalabre/WCS/dcs_20040422.pdf\n.. _SIP: http://irsa.ipac.caltech.edu/data/SPITZER/docs/files/spitzer/shupeADASS.pdf\n.. _FITS WCS standard: https://fits.gsfc.nasa.gov/fits_wcs.html\n\n`astropy.wcs` contains utilities for managing World Coordinate System\n(WCS) transformations in FITS files.  These transformations map the\npixel locations in an image to their real-world units, such as their\nposition on the sky sphere.\n\nIt performs three separate classes of WCS transformations:\n\n- Core WCS, as defined in the `FITS WCS standard`_, based on Mark\n  Calabretta's `wcslib`_.  See `~astropy.wcs.Wcsprm`.\n- Simple Imaging Polynomial (`SIP`_) convention.  See\n  `~astropy.wcs.Sip`.\n- table lookup distortions as defined in WCS `distortion paper`_.  See\n  `~astropy.wcs.DistortionLookupTable`.\n\nEach of these transformations can be used independently or together in\na standard pipeline.", "parse_error": ""}, {"file_path": "astropy/wcs/docstrings.py", "file_hash": "b8e6f496bdc83e1cb70f3f25768e7f79529c88fb3b68d172ed4930a098838ea8", "imports": [{"module": "", "names": ["_docutil"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/wcs/utils.py", "file_hash": "faea432f172953f216c5cd889ea0aa5ae943460adea4d4360d0df48935492bc1", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "", "names": ["units"], "is_from": true, "alias": ""}, {"module": "wcs", "names": ["WCS", "WCSSUB_CELESTIAL"], "is_from": true, "alias": ""}, {"module": "coordinates", "names": ["FK4", "FK4NoETerms", "FK5", "ICRS", "Galactic"], "is_from": true, "alias": ""}, {"module": "time", "names": ["Time"], "is_from": true, "alias": ""}, {"module": "coordinates", "names": ["BaseRADecFrame", "FK4", "FK4NoETerms", "FK5", "ICRS", "Galactic"], "is_from": true, "alias": ""}, {"module": "coordinates", "names": ["SkyCoord", "UnitSphericalRepresentation"], "is_from": true, "alias": ""}], "functions": [{"name": "add_stokes_axis_to_wcs", "qualified_name": "add_stokes_axis_to_wcs", "args": ["wcs", "add_before_ind"], "decorators": [], "docstring": "Add a new Stokes axis that is uncorrelated with any other axes.\n\nParameters\n----------\nwcs : `~astropy.wcs.WCS`\n    The WCS to add to\nadd_before_ind : int\n    Index of the WCS to insert the new Stokes axis in front of.\n    To add at the end, do add_before_ind = wcs.wcs.naxis\n    The beginning is at ", "start_line": 19, "end_line": 42, "is_async": false, "is_method": false}, {"name": "_wcs_to_celestial_frame_builtin", "qualified_name": "_wcs_to_celestial_frame_builtin", "args": ["wcs"], "decorators": [], "docstring": "", "start_line": 45, "end_line": 98, "is_async": false, "is_method": false}, {"name": "_celestial_frame_to_wcs_builtin", "qualified_name": "_celestial_frame_to_wcs_builtin", "args": ["frame", "projection"], "decorators": [], "docstring": "", "start_line": 101, "end_line": 134, "is_async": false, "is_method": false}, {"name": "wcs_to_celestial_frame", "qualified_name": "wcs_to_celestial_frame", "args": ["wcs"], "decorators": [], "docstring": "For a given WCS, return the coordinate frame that matches the celestial\ncomponent of the WCS.\n\nParameters\n----------\nwcs : :class:`~astropy.wcs.WCS` instance\n    The WCS to find the frame for\n\nReturns\n-------\nframe : :class:`~astropy.coordinates.baseframe.BaseCoordinateFrame` subclass instance\n    A", "start_line": 171, "end_line": 206, "is_async": false, "is_method": false}, {"name": "celestial_frame_to_wcs", "qualified_name": "celestial_frame_to_wcs", "args": ["frame", "projection"], "decorators": [], "docstring": "For a given coordinate frame, return the corresponding WCS object.\n\nNote that the returned WCS object has only the elements corresponding to\ncoordinate frames set (e.g. ctype, equinox, radesys).\n\nParameters\n----------\nframe : :class:`~astropy.coordinates.baseframe.BaseCoordinateFrame` subclass insta", "start_line": 209, "end_line": 277, "is_async": false, "is_method": false}, {"name": "proj_plane_pixel_scales", "qualified_name": "proj_plane_pixel_scales", "args": ["wcs"], "decorators": [], "docstring": "For a WCS returns pixel scales along each axis of the image pixel at\nthe ``CRPIX`` location once it is projected onto the\n\"plane of intermediate world coordinates\" as defined in\n`Greisen & Calabretta 2002, A&A, 395, 1061 <http://adsabs.harvard.edu/abs/2002A%26A...395.1061G>`_.\n\n.. note::\n    This fu", "start_line": 280, "end_line": 321, "is_async": false, "is_method": false}, {"name": "proj_plane_pixel_area", "qualified_name": "proj_plane_pixel_area", "args": ["wcs"], "decorators": [], "docstring": "For a **celestial** WCS (see `astropy.wcs.WCS.celestial`) returns pixel\narea of the image pixel at the ``CRPIX`` location once it is projected\nonto the \"plane of intermediate world coordinates\" as defined in\n`Greisen & Calabretta 2002, A&A, 395, 1061 <http://adsabs.harvard.edu/abs/2002A%26A...395.10", "start_line": 324, "end_line": 382, "is_async": false, "is_method": false}, {"name": "is_proj_plane_distorted", "qualified_name": "is_proj_plane_distorted", "args": ["wcs", "maxerr"], "decorators": [], "docstring": "For a WCS returns `False` if square image (detector) pixels stay square\nwhen projected onto the \"plane of intermediate world coordinates\"\nas defined in\n`Greisen & Calabretta 2002, A&A, 395, 1061 <http://adsabs.harvard.edu/abs/2002A%26A...395.1061G>`_.\nIt will return `True` if transformation from ima", "start_line": 385, "end_line": 432, "is_async": false, "is_method": false}, {"name": "_is_cd_orthogonal", "qualified_name": "_is_cd_orthogonal", "args": ["cd", "maxerr"], "decorators": [], "docstring": "", "start_line": 435, "end_line": 449, "is_async": false, "is_method": false}, {"name": "non_celestial_pixel_scales", "qualified_name": "non_celestial_pixel_scales", "args": ["inwcs"], "decorators": [], "docstring": "Calculate the pixel scale along each axis of a non-celestial WCS,\nfor example one with mixed spectral and spatial axes.\n\nParameters\n-------