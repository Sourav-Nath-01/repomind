ion of pixels is\n    eliminated from both ends.\nn_samples : int, optional\n    Maximum number of values to use. If this is specified, and there\n    a", "start_line": 159, "end_line": 178}, {"name": "ZScaleInterval", "bases": ["BaseInterval"], "methods": ["__init__", "get_limits"], "docstring": "Interval based on IRAF's zscale.\n\nhttp://iraf.net/forum/viewtopic.php?showtopic=134139\n\nOriginal implementation:\nhttps://trac.stsci.edu/ssb/stsci_python/browser/stsci_python/trunk/numdisplay/lib/stsci/numdisplay/zscale.py?rev=19347\n\nLicensed under a 3-clause BSD style license (see AURA_LICENSE.rst).", "start_line": 181, "end_line": 284}], "calls": [], "module_docstring": "Classes that deal with computing intervals from arrays of values based on\nvarious criteria.", "parse_error": ""}, {"file_path": "astropy/visualization/lupton_rgb.py", "file_hash": "05ff8868d3e60549bd538d29de9611d6a96f21e19fd3752a48ba91336424eda9", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "", "names": ["ZScaleInterval"], "is_from": true, "alias": ""}, {"module": "matplotlib.image", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "compute_intensity", "qualified_name": "compute_intensity", "args": ["image_r", "image_g", "image_b"], "decorators": [], "docstring": "Return a naive total intensity from the red, blue, and green intensities.\n\nParameters\n----------\nimage_r : `~numpy.ndarray`\n    Intensity of image to be mapped to red; or total intensity if ``image_g``\n    and ``image_b`` are None.\nimage_g : `~numpy.ndarray`, optional\n    Intensity of image to be ma", "start_line": 17, "end_line": 46, "is_async": false, "is_method": false}, {"name": "make_lupton_rgb", "qualified_name": "make_lupton_rgb", "args": ["image_r", "image_g", "image_b", "minimum", "stretch", "Q", "filename"], "decorators": [], "docstring": "Return a Red/Green/Blue color image from up to 3 images using an asinh stretch.\nThe input images can be int or float, and in any range or bit-depth.\n\nFor a more detailed look at the use of this method, see the document\n:ref:`astropy-visualization-rgb`.\n\nParameters\n----------\n\nimage_r : `~numpy.ndarr", "start_line": 329, "end_line": 369, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "minimum", "image"], "decorators": [], "docstring": "", "start_line": 61, "end_line": 72, "is_async": false, "is_method": false}, {"name": "make_rgb_image", "qualified_name": "make_rgb_image", "args": ["self", "image_r", "image_g", "image_b"], "decorators": [], "docstring": "Convert 3 arrays, image_r, image_g, and image_b into an 8-bit RGB image.\n\nParameters\n----------\nimage_r : `~numpy.ndarray`\n    Image to map to red.\nimage_g : `~numpy.ndarray`\n    Image to map to green.\nimage_b : `~numpy.ndarray`\n    Image to map to blue.\n\nReturns\n-------\nRGBimage : `~numpy.ndarray`\n", "start_line": 74, "end_line": 100, "is_async": false, "is_method": false}, {"name": "intensity", "qualified_name": "intensity", "args": ["self", "image_r", "image_g", "image_b"], "decorators": [], "docstring": "Return the total intensity from the red, blue, and green intensities.\nThis is a naive computation, and may be overridden by subclasses.\n\nParameters\n----------\nimage_r : `~numpy.ndarray`\n    Intensity of image to be mapped to red; or total intensity if\n    ``image_g`` and ``image_b`` are None.\nimage_", "start_line": 102, "end_line": 123, "is_async": false, "is_method": false}, {"name": "map_intensity_to_uint8", "qualified_name": "map_intensity_to_uint8", "args": ["self", "I"], "decorators": [], "docstring": "Return an array which, when multiplied by an image, returns that image\nmapped to the range of a uint8, [0, 255] (but not converted to uint8).\n\nThe intensity is assumed to have had minimum subtracted (as that can be\ndone per-band).\n\nParameters\n----------\nI : `~numpy.ndarray`\n    Intensity to be mappe", "start_line": 125, "end_line": 144, "is_async": false, "is_method": false}, {"name": "_convert_images_to_uint8", "qualified_name": "_convert_images_to_uint8", "args": ["self", "image_r", "image_g", "image_b"], "decorators": [], "docstring": "Use the mapping to convert images image_r, image_g, and image_b to a triplet of uint8 images", "start_line": 146, "end_line": 175, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "minimum", "maximum", "image"], "decorators": [], "docstring": "", "start_line": 193, "end_line": 211, "is_async": false, "is_method": false}, {"name": "map_intensity_to_uint8", "qualified_name": "map_intensity_to_uint8", "args": ["self", "I"], "decorators": [], "docstring": "", "start_line": 213, "end_line": 216, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "minimum", "stretch", "Q"], "decorators": [], "docstring": "", "start_line": 240, "end_line": 254, "is_async": false, "is_method": false}, {"name": "map_intensity_to_uint8", "qualified_name": "map_intensity_to_uint8", "args": ["self", "I"], "decorators": [], "docstring": "", "start_line": 256, "end_line": 258, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "image1", "image2", "image3", "Q", "pedestal"], "decorators": [], "docstring": "        ", "start_line": 287, "end_line": 326, "is_async": false, "is_method": false}], "classes": [{"name": "Mapping", "bases": [], "methods": ["__init__", "make_rgb_image", "intensity", "map_intensity_to_uint8", "_convert_images_to_uint8"], "docstring": "Baseclass to map red, blue, green intensities into uint8 values.\n\nParameters\n----------\nminimum : float or sequence(3)\n    Intensity that should be mapped to black (a scalar or array for R, G, B).\nimage : `~numpy.ndarray`, optional\n    An image used to calculate some parameters of some mappings.", "start_line": 49, "end_line": 175}, {"name": "LinearMapping", "bases": ["Mapping"], "methods": ["__init__", "map_intensity_to_uint8"], "docstring": "A linear map map of red, blue, green intensities into uint8 values.\n\nA linear stretch from [minimum, maximum].\nIf one or both are omitted use image min and/or max to set them.\n\nParameters\n----------\nminimum : float\n    Intensity that should be mapped to black (a scalar or array for R, G, B).\nmaximum", "start_line": 178, "end_line": 216}, {"name": "AsinhMapping", "bases": ["Mapping"], "methods": ["__init__", "map_intensity_to_uint8"], "docstring": "A mapping for an asinh stretch (preserving colours independent of brightness)\n\nx = asinh(Q (I - minimum)/stretch)/Q\n\nThis reduces to a linear stretch if Q == 0\n\nSee http://adsabs.harvard.edu/abs/2004PASP..116..133L\n\nParameters\n----------\n\nminimum : float\n    Intensity that should be mapped to black ", "start_line": 219, "end_line": 258}, {"name": "AsinhZScaleMapping", "bases": ["AsinhMapping"], "methods": ["__init__"], "docstring": "A mapping for an asinh stretch, estimating the linear stretch by zscale.\n\nx = asinh(Q (I - z1)/(z2 - z1))/Q\n\nParameters\n----------\nimage1 : `~numpy.ndarray` or a list of arrays\n    The image to analyse, or a list of 3 images to be converted to\n    an intensity image.\nimage2 : `~numpy.ndarray`, optio", "start_line": 261, "end_line": 326}], "calls": [], "module_docstring": "Combine 3 images to produce a properly-scaled RGB image following Lupton et al. (2004).\n\nThe three images must be aligned and have the same pixel scale and size.\n\nFor details, see : http://adsabs.harvard.edu/abs/2004PASP..116..133L", "parse_error": ""}, {"file_path": "astropy/visualization/units.py", "file_hash": "e38116d304a67be1a02ed55b378ff72f2907a4a020be24947efd0525f5f8170a", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "", "names": ["units"], "is_from": true, "alias": ""}, {"module": "matplotlib", "names": ["units"], "is_from": true, "alias": ""}, {"mod