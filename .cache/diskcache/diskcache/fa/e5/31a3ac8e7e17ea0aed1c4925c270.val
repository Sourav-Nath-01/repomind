t_line": 759, "end_line": 865, "is_async": false, "is_method": false}, {"name": "_hstack", "qualified_name": "_hstack", "args": ["arrays", "join_type", "uniq_col_name", "table_names", "col_name_map"], "decorators": [], "docstring": "Stack tables horizontally (by columns)\n\nA ``join_type`` of 'exact' (default) means that the arrays must all\nhave exactly the same number of rows.  If ``join_type`` is 'inner' then\nthe intersection of rows will be the output.  A value of 'outer' means\nthe output will have the union of all rows, with ", "start_line": 868, "end_line": 963, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "High-level table operations:\n\n- join()\n- setdiff()\n- hstack()\n- vstack()", "parse_error": ""}, {"file_path": "astropy/table/meta.py", "file_hash": "e1bf51dd09c6d4d854b2d8ecb7f222e84d36584651750d4e9bfebe37698cf5bb", "imports": [{"module": "textwrap", "names": [], "is_from": false, "alias": ""}, {"module": "copy", "names": [], "is_from": false, "alias": ""}, {"module": "collections", "names": ["OrderedDict"], "is_from": true, "alias": ""}, {"module": "yaml", "names": [], "is_from": false, "alias": ""}, {"module": "yaml", "names": [], "is_from": false, "alias": ""}, {"module": "io.misc.yaml", "names": ["AstropyDumper"], "is_from": true, "alias": ""}, {"module": "io.misc.yaml", "names": ["AstropyLoader"], "is_from": true, "alias": ""}, {"module": "yaml", "names": [], "is_from": false, "alias": ""}, {"module": "yaml", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "_construct_odict", "qualified_name": "_construct_odict", "args": ["load", "node"], "decorators": [], "docstring": "Construct OrderedDict from !!omap in yaml safe load.\n\nSource: https://gist.github.com/weaver/317164\nLicense: Unspecified\n\nThis is the same as SafeConstructor.construct_yaml_omap(),\nexcept the data type is changed to OrderedDict() and setitem is\nused instead of append in the loop\n\nExamples\n--------\n:", "start_line": 50, "end_line": 101, "is_async": false, "is_method": false}, {"name": "_repr_pairs", "qualified_name": "_repr_pairs", "args": ["dump", "tag", "sequence", "flow_style"], "decorators": [], "docstring": "This is the same code as BaseRepresenter.represent_sequence(),\nbut the value passed to dump.represent_data() in the loop is a\ndictionary instead of a tuple.\n\nSource: https://gist.github.com/weaver/317164\nLicense: Unspecified", "start_line": 104, "end_line": 130, "is_async": false, "is_method": false}, {"name": "_repr_odict", "qualified_name": "_repr_odict", "args": ["dumper", "data"], "decorators": [], "docstring": "Represent OrderedDict in yaml dump.\n\nSource: https://gist.github.com/weaver/317164\nLicense: Unspecified\n\n>>> data = OrderedDict([('foo', 'bar'), ('mumble', 'quux'), ('baz', 'gorp')])\n>>> yaml.dump(data, default_flow_style=False)  # doctest: +SKIP\n'!!omap\\n- foo: bar\\n- mumble: quux\\n- baz: gorp\\n'\n>", "start_line": 133, "end_line": 146, "is_async": false, "is_method": false}, {"name": "_repr_column_dict", "qualified_name": "_repr_column_dict", "args": ["dumper", "data"], "decorators": [], "docstring": "Represent ColumnDict in yaml dump.\n\nThis is the same as an ordinary mapping except that the keys\nare written in a fixed order that makes sense for astropy table\ncolumns.", "start_line": 149, "end_line": 157, "is_async": false, "is_method": false}, {"name": "_get_col_attributes", "qualified_name": "_get_col_attributes", "args": ["col"], "decorators": [], "docstring": "Extract information from a column (apart from the values) that is required\nto fully serialize the column.", "start_line": 160, "end_line": 184, "is_async": false, "is_method": false}, {"name": "get_yaml_from_table", "qualified_name": "get_yaml_from_table", "args": ["table"], "decorators": [], "docstring": "Return lines with a YAML representation of header content from the ``table``.\n\nParameters\n----------\ntable : `~astropy.table.Table` object\n    Table for which header content is output\n\nReturns\n-------\nlines : list\n    List of text lines with YAML header content", "start_line": 187, "end_line": 206, "is_async": false, "is_method": false}, {"name": "get_yaml_from_header", "qualified_name": "get_yaml_from_header", "args": ["header"], "decorators": [], "docstring": "Return lines with a YAML representation of header content from a Table.\n\nThe ``header`` dict must contain these keys:\n\n- 'cols' : list of table column objects (required)\n- 'meta' : table 'meta' attribute (optional)\n\nOther keys included in ``header`` will be serialized in the output YAML\nrepresentati", "start_line": 209, "end_line": 291, "is_async": false, "is_method": false}, {"name": "get_header_from_yaml", "qualified_name": "get_header_from_yaml", "args": ["lines"], "decorators": [], "docstring": "Get a header dict from input ``lines`` which should be valid YAML.  This\ninput will typically be created by get_yaml_from_header.  The output is a\ndictionary which describes all the table and column meta.\n\nThe get_cols() method in the io/ascii/ecsv.py file should be used as a\nguide to using the info", "start_line": 298, "end_line": 343, "is_async": false, "is_method": false}, {"name": "sort", "qualified_name": "sort", "args": ["self"], "decorators": [], "docstring": "", "start_line": 15, "end_line": 32, "is_async": false, "is_method": false}, {"name": "items", "qualified_name": "items", "args": ["self"], "decorators": [], "docstring": "Return items as a ColumnOrderList, which sorts in the preferred\nway for column attributes.", "start_line": 42, "end_line": 47, "is_async": false, "is_method": false}, {"name": "represent_mapping", "qualified_name": "represent_mapping", "args": ["self", "tag", "mapping", "flow_style"], "decorators": [], "docstring": "This is a combination of the Python 2 and 3 versions of this method\nin the PyYAML library to allow the required key ordering via the\nColumnOrderList object.  The Python 3 version insists on turning the\nitems() mapping into a list object and sorting, which results in\nalphabetical order for the column", "start_line": 244, "end_line": 281, "is_async": false, "is_method": false}], "classes": [{"name": "ColumnOrderList", "bases": ["list"], "methods": ["sort"], "docstring": "List of tuples that sorts in a specific order that makes sense for\nastropy table column attributes.", "start_line": 9, "end_line": 32}, {"name": "ColumnDict", "bases": ["dict"], "methods": ["items"], "docstring": "Specialized dict subclass to represent attributes of a Column\nand return items() in a preferred order.  This is only for use\nin generating a YAML map representation that has a fixed order.", "start_line": 35, "end_line": 47}, {"name": "YamlParseError", "bases": ["Exception"], "methods": [], "docstring": "", "start_line": 294, "end_line": 295}, {"name": "TableDumper", "bases": ["AstropyDumper"], "methods": ["represent_mapping"], "docstring": "Custom Dumper that represents OrderedDict as an !!omap object.", "start_line": 239, "end_line": 281}, {"name": "TableLoader", "bases": ["AstropyLoader"], "methods": [], "docstring": "Custom Loader that constructs OrderedDict from an !!omap object.\nThis does nothing but provide a namespace for adding the\ncustom odict constructor.", "start_line": 328, "end_line": 333}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/table/__init__.py", "file_hash": "e9780196543c25162f060aa9f0bafc5f94208a991f5aab9bc9d66ee63468ee17", "imports": [{"module": "", "names": ["config"], "is_from": true, "alias": ""}, {"module": "column", "names": ["Column", "MaskedColumn", "StringTruncateWarning", "ColumnInfo"], "is_from": true, "alias": ""}, {"module": "groups", "names": ["TableGroups", "ColumnGroups"], "is_from": true, "alias": ""}, {"module": "table", "names": ["Table", "QTable", "TableColumns", "Row", "TableFormatter", "NdarrayMixin", "TableReplaceWarning"], "is_from": true, "alias": ""}, {"module": "operations", "names": ["join", "se