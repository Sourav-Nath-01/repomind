ators": [], "docstring": "", "start_line": 93, "end_line": 98, "is_async": false, "is_method": false}, {"name": "test_write_html_noformat", "qualified_name": "test_write_html_noformat", "args": ["tmpdir"], "decorators": [], "docstring": "", "start_line": 101, "end_line": 106, "is_async": false, "is_method": false}, {"name": "test_read_rdb", "qualified_name": "test_read_rdb", "args": [], "decorators": [], "docstring": "", "start_line": 109, "end_line": 110, "is_async": false, "is_method": false}, {"name": "test_read_rdb_noformat", "qualified_name": "test_read_rdb_noformat", "args": [], "decorators": [], "docstring": "", "start_line": 113, "end_line": 114, "is_async": false, "is_method": false}, {"name": "test_write_rdb", "qualified_name": "test_write_rdb", "args": ["tmpdir"], "decorators": [], "docstring": "", "start_line": 117, "end_line": 122, "is_async": false, "is_method": false}, {"name": "test_write_rdb_noformat", "qualified_name": "test_write_rdb_noformat", "args": ["tmpdir"], "decorators": [], "docstring": "", "start_line": 125, "end_line": 130, "is_async": false, "is_method": false}, {"name": "test_read_csv", "qualified_name": "test_read_csv", "args": [], "decorators": [], "docstring": "If properly registered, filename should be sufficient to specify format\n\n#3189", "start_line": 133, "end_line": 138, "is_async": false, "is_method": false}, {"name": "test_write_csv", "qualified_name": "test_write_csv", "args": ["tmpdir"], "decorators": [], "docstring": "If properly registered, filename should be sufficient to specify format\n\n#3189", "start_line": 141, "end_line": 150, "is_async": false, "is_method": false}, {"name": "test_auto_identify_ecsv", "qualified_name": "test_auto_identify_ecsv", "args": ["tmpdir"], "decorators": ["pytest.mark.skipif('not HAS_YAML')"], "docstring": "", "start_line": 153, "end_line": 158, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/io/misc/asdf/__init__.py", "file_hash": "415ab866c2c63f471837194e1b7a71fdd13af70a96a709faa532601de76255c1", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "The **asdf** subpackage contains code that is used to serialize astropy types\nso that they can be represented and stored using the Advanced Scientific Data\nFormat (ASDF). This subpackage defines classes, referred to as **tags**, that\nimplement the logic for serialization and deserialization.\n\nASDF makes use of abstract data type definitons called **schemas**. The tags\nprovided here are simply specific implementations of particular schemas.\nCurrently astropy only implements tags for a subset of schemas that are defined\nexternally by the ASDF Standard. However, it is likely that astropy will\neventually define schemas of its own.\n\nAstropy currently has no ability to read or write ASDF files itself. In order\nto process ASDF files it is necessary to make use of the standalone **asdf**\npackage. Users should never need to refer to tag implementations directly.\nTheir presence should be entirely transparent when processing ASDF files.\n\nIf both **asdf** and **astropy** are installed, no futher configuration is\nrequired in order to process ASDF files. The **asdf** package has been designed\nto automatically detect the presence of the tags defined by **astropy**.\n\nDocumentation on the ASDF Standard can be found `here\n<https://asdf-standard.readthedocs.io>`__. Documentation on the ASDF Python\nmodule can be found `here <https://asdf.readthedocs.io>`__.", "parse_error": ""}, {"file_path": "astropy/io/misc/asdf/extension.py", "file_hash": "0b9862e617e5bc42e3ab1d54e857b7431e104da13a5e9b7c0843069fc2ee7ecf", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "asdf.extension", "names": ["AsdfExtension", "BuiltinExtension"], "is_from": true, "alias": ""}, {"module": "asdf.resolver", "names": ["Resolver", "DEFAULT_URL_MAPPING"], "is_from": true, "alias": ""