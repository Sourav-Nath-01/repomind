l size of the operation is\nknown or not.\n\nIt is designed to be used with the ``with`` statement::\n\n    if file.has_length():\n        length = file.get_length()\n    else:\n        length = None\n    bytes_read = 0\n  ", "start_line": 869, "end_line": 941}, {"name": "Getch", "bases": [], "methods": ["__init__", "__call__"], "docstring": "Get a single character from standard input without screen echo.\n\nReturns\n-------\nchar : str (one character)", "start_line": 1028, "end_line": 1046}, {"name": "_GetchUnix", "bases": [], "methods": ["__init__", "__call__"], "docstring": "", "start_line": 1049, "end_line": 1069}, {"name": "_GetchWindows", "bases": [], "methods": ["__init__", "__call__"], "docstring": "", "start_line": 1072, "end_line": 1078}, {"name": "_GetchMacCarbon", "bases": [], "methods": ["__init__", "__call__"], "docstring": "A function which returns the current ASCII key that is down;\nif no ASCII key is down, the null string is returned.  The\npage http://www.mactech.com/macintosh-c/chap02-1.html was\nvery helpful in figuring out how to do this.", "start_line": 1081, "end_line": 1108}], "calls": [], "module_docstring": "Utilities for console input and output.", "parse_error": ""}, {"file_path": "astropy/utils/__init__.py", "file_hash": "29f20420bd6ec82d1c540d728960eafde8f6f93b804c1dba358a234916ba7ec2", "imports": [{"module": "codegen", "names": ["*"], "is_from": true, "alias": ""}, {"module": "decorators", "names": ["*"], "is_from": true, "alias": ""}, {"module": "introspection", "names": ["*"], "is_from": true, "alias": ""}, {"module": "misc", "names": ["*"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "This subpackage contains developer-oriented utilities used by Astropy.\n\nPublic functions and classes in this subpackage are safe to be used by other\npackages, but this subpackage is for utilities that are primarily of use for\ndevelopers or to implement python hacks. This subpackage also includes the\n`astropy.utils.compat` package, which houses utilities that provide\ncompatibility and bugfixes across all versions of Python that Astropy supports.", "parse_error": ""}, {"file_path": "astropy/utils/metadata.py", "file_hash": "3e42210fef752e6c90b95d2593d68bc60cee14ceafff115073fc3afa4ce738d4", "imports": [{"module": "utils", "names": ["wraps"], "is_from": true, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "collections", "names": [], "is_from": false, "alias": ""}, {"module": "collections", "names": ["OrderedDict"], "is_from": true, "alias": ""}, {"module": "copy", "names": ["deepcopy"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "utils.exceptions", "names": ["AstropyWarning"], "is_from": true, "alias": ""}, {"module": "utils.misc", "names": ["dtype_bytes_or_chars"], "is_from": true, "alias": ""}], "functions": [{"name": "common_dtype", "qualified_name": "common_dtype", "args": ["arrs"], "decorators": [], "docstring": "Use numpy to find the common dtype for a list of ndarrays.\n\nOnly allow arrays within the following fundamental numpy data types:\n``np.bool_``, ``np.object_``, ``np.number``, ``np.character``, ``np.void``\n\nParameters\n----------\narrs : list of ndarray objects\n    Arrays for which to find the common dt", "start_line": 35, "end_line": 76, "is_async": false, "is_method": false}, {"name": "_both_isinstance", "qualified_name": "_both_isinstance", "args": ["left", "right", "cls"], "decorators": [], "docstring": "", "start_line": 204, "end_line": 205, "is_async": false, "is_method": false}, {"name": "_not_equal", "qualified_name": "_not_equal", "args": ["left", "right"], "decorators": [], "docstring": "", "start_line": 208, "end_line": 212, "is_async": false, "is_method": false}, {"name": "enable_merge_strategies", "qualified_name": "enable_merge_strategies", "args": [], "decorators": [], "docstring": "Context manager to temporarily enable one or more custom metadata merge\nstrategies.\n\nExamples\n--------\nHere we define a custom merge strategy that takes an int or float on\nthe left and right sides and returns a list with the two values.\n\n  >>> from astropy.utils.metadata import MergeStrategy\n  >>> c", "start_line": 232, "end_line": 288, "is_async": false, "is_method": false}, {"name": "_warn_str_func", "qualified_name": "_warn_str_func", "args": ["key", "left", "right"], "decorators": [], "docstring": "", "start_line": 291, "end_line": 295, "is_async": false, "is_method": false}, {"name": "_error_str_func", "qualified_name": "_error_str_func", "args": ["key", "left", "right"], "decorators": [], "docstring": "", "start_line": 298, "end_line": 302, "is_async": false, "is_method": false}, {"name": "merge", "qualified_name": "merge", "args": ["left", "right", "merge_func", "metadata_conflicts", "warn_str_func", "error_str_func"], "decorators": [], "docstring": "Merge the ``left`` and ``right`` metadata objects.\n\nThis is a simplistic and limited implementation at this point.", "start_line": 305, "end_line": 370, "is_async": false, "is_method": false}, {"name": "dtype", "qualified_name": "dtype", "args": ["arr"], "decorators": [], "docstring": "", "start_line": 52, "end_line": 53, "is_async": false, "is_method": false}, {"name": "__new__", "qualified_name": "__new__", "args": ["mcls", "name", "bases", "members"], "decorators": [], "docstring": "", "start_line": 85, "end_line": 110, "is_async": false, "is_method": false}, {"name": "merge", "qualified_name": "merge", "args": ["cls", "left", "right"], "decorators": ["classmethod"], "docstring": "", "start_line": 180, "end_line": 181, "is_async": false, "is_method": false}, {"name": "merge", "qualified_name": "merge", "args": ["cls", "left", "right"], "decorators": ["classmethod"], "docstring": "", "start_line": 198, "end_line": 201, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decor