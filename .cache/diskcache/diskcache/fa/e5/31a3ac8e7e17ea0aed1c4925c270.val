, "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 222, "end_line": 223, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "table", "output"], "decorators": [], "docstring": "Override the default writing behavior in `FastBasic` so\nthat columns names are not included in output.", "start_line": 225, "end_line": 230, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 243, "end_line": 248, "is_async": false, "is_method": false}, {"name": "make_table", "qualified_name": "make_table", "args": ["self", "data", "comments"], "decorators": [], "docstring": "Actually make the output table give the data and comments.  This is\nslightly different from the base FastBasic method in the way comments\nare handled.", "start_line": 250, "end_line": 262, "is_async": false, "is_method": false}, {"name": "_read_header", "qualified_name": "_read_header", "args": ["self"], "decorators": [], "docstring": "", "start_line": 264, "end_line": 281, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "table", "output"], "decorators": [], "docstring": "Override the default writing behavior in `FastBasic` so\nthat column names are commented.", "start_line": 283, "end_line": 288, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 301, "end_line": 304, "is_async": false, "is_method": false}, {"name": "_read_header", "qualified_name": "_read_header", "args": ["self"], "decorators": [], "docstring": "", "start_line": 306, "end_line": 352, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "table", "output"], "decorators": [], "docstring": "Override the default writing behavior in `FastBasic` to\noutput a line with column types after the column name line.", "start_line": 354, "end_line": 359, "is_async": false, "is_method": false}], "classes": [{"name": "FastBasic", "bases": [], "methods": ["__init__", "_read_header", "read", "make_table", "check_header", "write", "_write"], "docstring": "This class is intended to handle the same format addressed by the\nordinary :class:`Basic` writer, but it acts as a wrapper for underlying C\ncode and is therefore much faster. Unlike the other ASCII readers and\nwriters, this class is not very extensible and is restricted\nby optimization requirements.", "start_line": 13, "end_line": 171}, {"name": "FastCsv", "bases": ["FastBasic"], "methods": ["__init__", "write"], "docstring": "A faster version of the ordinary :class:`Csv` writer that uses the\noptimized C parsing engine. Note that this reader will append empty\nfield values to the end of any row with not enough columns, while\n:class:`FastBasic` simply raises an error.", "start_line": 174, "end_line": 194}, {"name": "FastTab", "bases": ["FastBasic"], "methods": ["__init__"], "docstring": "A faster version of the ordinary :class:`Tab` reader that uses\nthe optimized C parsing engine.", "start_line": 197, "end_line": 209}, {"name": "FastNoHeader", "bases": ["FastBasic"], "methods": ["__init__", "write"], "docstring": "This class uses the fast C engine to read tables with no header line. If\nthe names parameter is unspecified, the columns will be autonamed with\n\"col{}\".", "start_line": 212, "end_line": 230}, {"name": "FastCommentedHeader", "bases": ["FastBasic"], "methods": ["__init__", "make_table", "_read_header", "write"], "docstring": "A faster version of the :class:`CommentedHeader` reader, which looks for\ncolumn names in a commented line. ``header_start`` denotes the index of\nthe header line among all commented lines and is 0 by default.", "start_line": 233, "end_line": 288}, {"name": "FastRdb", "bases": ["FastBasic"], "methods": ["__init__", "_read_header", "write"], "docstring": "A faster version of the :class:`Rdb` reader. This format is similar to\ntab-delimited, but it also contains a header line after the column\nname line denoting the type of each column (N for numeric, S for string).", "start_line": 291, "end_line": 359}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/io/ascii/ecsv.py", "file_hash": "bd2145e62e64021e7c5778baaa9b1f09036b80cd9881884c0df45cce7b19f712", "imports": [{"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "collections", "names": ["OrderedDict"], "is_from": true, "alias": ""}, {"module": "contextlib", "names": [], "is_from": false, "alias": ""}, {"module": "", "names": ["core", "basic"], "is_from": true, "alias": ""}, {"module": "table", "names": ["meta", "serialize"], "is_from": true, "alias": ""}, {"module": "utils.data_info", "names": ["serialize_context_as"], "is_from": true, "alias": ""}], "functions": [{"name": "process_lines", "qualified_name": "process_lines", "args": ["self", "lines"], "decorators": [], "docstring": "Return only non-blank lines that start with the comment regexp.  For these\nlines strip out the matching characters and leading/trailing whitespace.", "start_line": 26, "end_line": 41, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "lines"], "decorators": [], "docstring": "Write header information in the ECSV ASCII format.  This format\nstarts with a delimiter separated list of the column names in order\nto make this format readable by humans and simple csv-type readers.\nIt then encodes the full table meta and column attributes and meta\nas YAML and pretty-prints this in", "start_line": 43, "end_line": 76, "is_async": false, "is_method": false}, {"name": "write_comments", "qualified_name": "write_comments", "args": ["self", "lines", "meta"], "decorators": [], "docstring": "Override the default write_comments to do nothing since this is handled\nin the custom write method.", "start_line": 78, "end_line": 83, "is_async": false, "is_method": false}, {"name": "update_meta", "qualified_name": "update_meta", "args": ["self", "lines", "meta"], "decorators": [], "docstring": "Override the default update_meta to do nothing.  This process is done\nin get_cols() for this reader.", "start_line": 85, "end_line": 90, "is_async": false, "is_method": false}, {"name": "get_cols", "qualified_name": "get_cols", "args": ["self", "lines"], "decorators": [], "docstring": "Initialize the header Column objects from the table ``lines``.\n\nParameters\n----------\nlines : list\n    List of table lines", "start_line": 92, "end_line": 170, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "cols", "meta"], "decorators": [], "docstring": "", "start_line": 182, "end_line": 193, "is_async": false, "is_method": false}, {"name": "update_table_data", "qualified_name": "update_table_data", "args": ["self", "table"], "decorators": [], "docstring": "Update table columns in place if mixin columns are present.\n\nThis is a hook to allow updating the table columns after name\nfiltering but before setting up to write the data.  This is currently\nonly used by ECSV and is otherwise just a pass-through.\n\nParameters\n----------\ntable : `astropy.table.Table", "start_line": 232, "end_line": 252, "is_async": false, "is_method": false}], "classes": [{"name": "EcsvHeader", "bases": ["basic.BasicHeader"], "methods": ["process_lines", "write", "write_comments", "update_meta", "get_cols"], "docstring": "Header class for which the column definition line starts with the\ncomment character.  See the :class:`CommentedHeader` class  for an example.", "start_line": 22, "end_line": 170}, {"name": "EcsvOutputter", "bases": ["core.TableOutputter"], "methods": ["__call__"], "docstring": "After reading the input lines and processing, convert the Reader columns\nand metadata to an astropy.table.Table object.  This overrides the default\nconverters to be an empty list because there is no \"guessing\" of the\nconversion function.", "start_line": 173, "end_line": 193}, {"name": "Ecsv", "bases": ["basic.Basic"], "methods": ["update_table_data"], "docstring": "Read a file which conforms to the ECSV (Enhanced Character Separated\nValues) format.  This format allows for specification of key table\nand column meta-data, in particular the data type and unit.  For details\nsee: https://github.com/astropy/astropy-APEs/blob/master/APE6.rst.\n\nExamples\n--------\n\n>>> ", "start_line": 196, "end_line": 252}], "calls": [], "module_docstring": "Define the Enhanced Character-Separated-Values (ECSV) which allows for reading and\nwriting all the meta data associated with an astropy Table object.", "parse_error": ""}, {"file_path": "astropy/io/ascii/setup_package.py", "file_hash": "4ff19f16e0a76c0f82e192ca545ee10be27e22f72f83d3059633060fb75d1c16", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "distutils.extension", "names": ["Extension"], "is_from": true, "alias": ""}], "functions": [{"name": "get_extensions", "qualified_name": "get_extensions", "args": [], "decorators": [], "docstring": "", "start_line": 9, "end_line": 16, "is_async": false, "is_method": false}, {"name": "get_package_data", "qualified_name": "get_package_data", "args": [], "decorators": [], "docstring": "", "start_line": 19, "end_line": 89, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/io/ascii/daophot.py", "file_hash": "d9b27d0bea3259f0c8363a8c0fb0a56ea48f50244c972e5361e639169fe17137", "imports": [{"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "itertools", "names": [], "is_from": false, "alias": "itt"}, {"module": "collections", "names": ["defaultdict", "OrderedDict"], "is_from": true, "alias": ""}, {"module": "", "n