ash": "c6a37290e0b33fe71b7d7d023e61a7a4fd246424fb832b21570f14a15dea2d8d", "imports": [{"module": "contextlib", "names": [], "is_from": false, "alias": ""}, {"module": "textwrap", "names": [], "is_from": false, "alias": ""}, {"module": "bleach", "names": [], "is_from": false, "alias": ""}, {"module": "", "names": ["_iterparser"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "file"], "decorators": [], "docstring": "Parameters\n----------\nfile : writable file-like object.", "start_line": 64, "end_line": 79, "is_async": false, "is_method": false}, {"name": "_flush", "qualified_name": "_flush", "args": ["self", "indent", "wrap"], "decorators": [], "docstring": "Flush internal buffers.", "start_line": 81, "end_line": 105, "is_async": false, "is_method": false}, {"name": "start", "qualified_name": "start", "args": ["self", "tag", "attrib"], "decorators": [], "docstring": "Opens a new element.  Attributes can be given as keyword\narguments, or as a string/string dictionary.  The method\nreturns an opaque identifier that can be passed to the\n:meth:`close` method, to close all open elements up to and\nincluding this one.\n\nParameters\n----------\ntag : str\n    The element nam", "start_line": 107, "end_line": 149, "is_async": false, "is_method": false}, {"name": "xml_cleaning_method", "qualified_name": "xml_cleaning_method", "args": ["self", "method"], "decorators": ["contextlib.contextmanager"], "docstring": "Context manager to control how XML data tags are cleaned (escaped) to\nremove potentially unsafe characters or constructs.\n\nThe default (``method='escape_xml'``) applies brute-force escaping of\ncertain key XML characters like ``<``, ``>``, and ``&`` to ensure that\nthe output is not valid XML.\n\nIn ord", "start_line": 152, "end_line": 205, "is_async": false, "is_method": false}, {"name": "tag", "qualified_name": "tag", "args": ["self", "tag", "attrib"], "decorators": ["contextlib.contextmanager"], "docstring": "A convenience method for creating wrapper elements using the\n``with`` statement.\n\nExamples\n--------\n\n>>> with writer.tag('foo'):  # doctest: +SKIP\n...     writer.element('bar')\n... # </foo> is implicitly closed here\n...\n\nParameters are the same as to `start`.", "start_line": 208, "end_line": 225, "is_async": false, "is_method": false}, {"name": "comment", "qualified_name": "comment", "args": ["self", "comment"], "decorators": [], "docstring": "Adds a comment to the output stream.\n\nParameters\n----------\ncomment : str\n    Comment text, as a Unicode string.", "start_line": 227, "end_line": 238, "is_async": false, "is_method": false}, {"name": "data", "qualified_name": "data", "args": ["self", "text"], "decorators": [], "docstring": "Adds character data to the output stream.\n\nParameters\n----------\ntext : str\n    Character data, as a Unicode string.", "start_line": 240, "end_line": 249, "is_async": false, "is_method": false}, {"name": "end", "qualified_name": "end", "args": ["self", "tag", "indent", "wrap"], "decorators": [], "docstring": "Closes the current element (opened by the most recent call to\n`start`).\n\nParameters\n----------\ntag : str\n    Element name.  If given, the tag must match the start tag.\n    If omitted, the current element is closed.", "start_line": 251, "end_line": 280, "is_async": false, "is_method": false}, {"name": "close", "qualified_name": "close", "args": ["self", "id"], "decorators": [], "docstring": "Closes open elements, up to (and including) the element identified\nby the given identifier.\n\nParameters\n----------\nid : int\n    Element identifier, as returned by the `start` method.", "start_line": 282, "end_line": 293, "is_async": false, "is_method": false}, {"name": "element", "qualified_name": "element", "args": ["self", "tag", "text", "wrap", "attrib"], "decorators": [], "docstring": "Adds an entire element.  This is the same as calling `start`,\n`data`, and `end` in sequence. The ``text`` argument\ncan be omitted.", "start_line": 295, "end_line": 304, "is_async": false, "is_method": false}, {"name": "flush", "qualified_name": "flush", "args": ["self"], "decorators": [], "docstring": "", "start_line": 306, "end_line": 307, "is_async": false, "is_method": false}, {"name": "get_indentation", "qualified_name": "get_indentation", "args": ["self"], "decorators": [], "docstring": "Returns the number of indentation levels the file is currently\nin.", "start_line": 309, "end_line": 314, "is_async": false, "is_method": false}, {"name": "get_indentation_spaces", "qualified_name": "get_indentation_spaces", "args": ["self", "offset"], "decorators": [], "docstring": "Returns a string of spaces that matches the current\nindentation level.", "start_line": 316, "end_line": 321, "is_async": false, "is_method": false}, {"name": "object_attrs", "qualified_name": "object_attrs", "args": ["obj", "attrs"], "decorators": ["staticmethod"], "docstring": "Converts an object with a bunch of attributes on an object\ninto a dictionary for use by the `XMLWriter`.\n\nParameters\n----------\nobj : object\n    Any Python object\n\nattrs : sequence of str\n    Attribute names to pull from the object\n\nReturns\n-------\nattrs : dict\n    Maps attribute names to the values", "start_line": 324, "end_line": 348, "is_async": false, "is_method": false}, {"name": "xml_escape_cdata", "qualified_name": "xml_escape_cdata", "args": ["s"], "decorators": [], "docstring": "Escapes &, < and > in an XML CDATA string.", "start_line": 20, "end_line": 27, "is_async": false, "is_method": false}, {"name": "xml_escape", "qualified_name": "xml_escape", "args": ["s"], "decorators": [], "docstring": "Escapes &, ', \", < and > in an XML attribute value.", "start_line": 29, "end_line": 38, "is_async": false, "is_method": false}], "classes": [{"name": "XMLWriter", "bases": [], "methods": ["__init__", "_flush", "start", "xml_cleaning_method", "tag", "comment", "data", "end", "close", "element", "flush", "get_indentation", "get_indentation_spaces", "object_attrs"], "docstring": "A class to write well-formed and nicely indented XML.\n\nUse like this::\n\n    w = XMLWriter(fh)\n    with w.tag('html'):\n        with w.tag('body'):\n            w.data('This is the content')\n\nWhich produces::\n\n    <html>\n     <body>\n      This is the content\n     </body>\n    </html>", "start_line": 44, "end_line": 348}], "calls": [], "module_docstring": "Contains a class that makes it simple to stream out well-formed and\nnicely-indented XML.", "parse_error": ""}, {"file_path": "astropy/utils/xml/check.py", "file_hash": "013446fdd07bdef6b2d568e41ca62c74cd1e662309d985c43f2d0722358a2591", "imports": [{"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "urllib.parse", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "check_id", "qualified_name": "check_id", "args": ["ID"], "decorators": [], "docstring": "Returns `True` if *ID* is a valid XML ID.", "start_line": 12, "end_line": 16, "is_async": false, "is_method": false}, {"name": "fix_id", "qualified_name": "fix_id", "args": ["ID"], "decorators": [], "docstring": "Given an arbitrary string, create one that can be used as an xml\nid.  This is rather simplistic at the moment, since it just\nreplaces non-valid characters with underscores.", "start_line": 19, "end_line": 34, "is_async": false, "is_method": false}, {"name": "check_token", "qualified_name": "check_token", "args": ["token"], "decorators": [], "docstring": "Returns `True` if *token* is a valid XML token, as defined by XML\nSchema Part 2.", "start_line": 40, "end_line": 48, "is_async": false, "is_method": false}, {"name": "check_mime_content_type", "qualified_name": "check_mime_content_type", "args": ["content_type"], "decorators": [], "docstring": "Returns `True` if *content_type* is a valid MIME content type\n(syntactically at least), as defined by RFC 2045.", "start_line": 51, "end_line": 60, "is_async": false, "is_method": false}, {"name": "ch