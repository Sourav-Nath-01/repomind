rameters\n----------\nfile : str or None\n    full local or network path to the ascii file holding IERS data,\n    for passing on to the ``read`` class methods (further optional\n    arguments that are available for some IERS subclasses ", "start_line": 123, "end_line": 163, "is_async": false, "is_method": false}, {"name": "close", "qualified_name": "close", "args": ["cls"], "decorators": ["classmethod"], "docstring": "Remove the IERS table from the class.\n\nThis allows the table to be re-read from disk during one's session\n(e.g., if one finds it is out of date and has updated the file).", "start_line": 166, "end_line": 172, "is_async": false, "is_method": false}, {"name": "mjd_utc", "qualified_name": "mjd_utc", "args": ["self", "jd1", "jd2"], "decorators": [], "docstring": "Turn a time to MJD, returning integer and fractional parts.\n\nParameters\n----------\njd1 : float, array, or Time\n    first part of two-part JD, or Time object\njd2 : float or array, optional\n    second part of two-part JD.\n    Default is 0., ignored if jd1 is `~astropy.time.Time`.\nReturns\n-------\nmjd :", "start_line": 174, "end_line": 197, "is_async": false, "is_method": false}, {"name": "ut1_utc", "qualified_name": "ut1_utc", "args": ["self", "jd1", "jd2", "return_status"], "decorators": [], "docstring": "Interpolate UT1-UTC corrections in IERS Table for given dates.\n\nParameters\n----------\njd1 : float, float array, or Time object\n    first part of two-part JD, or Time object\njd2 : float or float array, optional\n    second part of two-part JD.\n    Default is 0., ignored if jd1 is `~astropy.time.Time`.", "start_line": 199, "end_line": 227, "is_async": false, "is_method": false}, {"name": "dcip_xy", "qualified_name": "dcip_xy", "args": ["self", "jd1", "jd2", "return_status"], "decorators": [], "docstring": "Interpolate CIP corrections in IERS Table for given dates.\n\nParameters\n----------\njd1 : float, float array, or Time object\n    first part of two-part JD, or Time object\njd2 : float or float array, optional\n    second part of two-part JD (default 0., ignored if jd1 is Time)\nreturn_status : bool\n    W", "start_line": 229, "end_line": 258, "is_async": false, "is_method": false}, {"name": "pm_xy", "qualified_name": "pm_xy", "args": ["self", "jd1", "jd2", "return_status"], "decorators": [], "docstring": "Interpolate polar motions from IERS Table for given dates.\n\nParameters\n----------\njd1 : float, float array, or Time object\n    first part of two-part JD, or Time object\njd2 : float or float array, optional\n    second part of two-part JD.\n    Default is 0., ignored if jd1 is `~astropy.time.Time`.\nret", "start_line": 260, "end_line": 290, "is_async": false, "is_method": false}, {"name": "_check_interpolate_indices", "qualified_name": "_check_interpolate_indices", "args": ["self", "indices_orig", "indices_clipped", "max_input_mjd"], "decorators": [], "docstring": "Check that the indices from interpolation match those after clipping\nto the valid table range.  This method gets overridden in the IERS_Auto\nclass because it has different requirements.", "start_line": 292, "end_line": 300, "is_async": false, "is_method": false}, {"name": "_interpolate", "qualified_name": "_interpolate", "args": ["self", "jd1", "jd2", "columns", "source"], "decorators": [], "docstring": "", "start_line": 302, "end_line": 357, "is_async": false, "is_method": false}, {"name": "_refresh_table_as_needed", "qualified_name": "_refresh_table_as_needed", "args": ["self", "mjd"], "decorators": [], "docstring": "Potentially update the IERS table in place depending on the requested\ntime values in ``mdj`` and the time span of the table.  The base behavior\nis not to update the table.  ``IERS_Auto`` overrides this method.", "start_line": 359, "end_line": 365, "is_async": false, "is_method": false}, {"name": "ut1_utc_source", "qualified_name": "ut1_utc_source", "args": ["self", "i"], "decorators": [], "docstring": "Source for UT1-UTC.  To be overridden by subclass.", "start_line": 367, "end_line": 369, "is_async": false, "is_method": false}, {"name": "dcip_source", "qualified_name": "dcip_source", "args": ["self", "i"], "decorators": [], "docstring": "Source for CIP correction.  To be overridden by subclass.", "start_line": 371, "end_line": 373, "is_async": false, "is_method": false}, {"name": "pm_source", "qualified_name": "pm_source", "args": ["self", "i"], "decorators": [], "docstring": "Source for polar motion.  To be overridden by subclass.", "start_line": 375, "end_line": 377, "is_async": false, "is_method": false}, {"name": "time_now", "qualified_name": "time_now", "args": ["self"], "decorators": ["property"], "docstring": "Property to provide the current time, but also allow for explicitly setting\nthe _time_now attribute for testing purposes.", "start_line": 380, "end_line": 389, "is_async": false, "is_method": false}, {"name": "_combine_a_b_columns", "qualified_name": "_combine_a_b_columns", "args": ["cls", "iers_a"], "decorators": ["classmethod"], "docstring": "Return a new table with appropriate combination of IERS_A and B columns.", "start_line": 408, "end_line": 468, "is_async": false, "is_method": false}, {"name": "_substitute_iers_b", "qualified_name": "_substitute_iers_b", "args": ["cls", "table"], "decorators": ["classmethod"], "docstring": "", "start_line": 471, "end_line": 473, "is_async": false, "is_method": false}, {"name": "read", "qualified_name": "read", "args": ["cls", "file", "readme"], "decorators": ["classmethod"], "docstring": "Read IERS-A table from a finals2000a.* file provided by USNO.\n\nParameters\n----------\nfile : str\n    full path to ascii file holding IERS-A data.\n    Defaults to ``iers.IERS_A_FILE``.\nreadme : str\n    full path to ascii file holding CDS-style readme.\n    Defaults to package version, ``iers.IERS_A_REA", "start_line": 476, "end_line": 507, "is_async": false, "is_method": false}, {"name": "ut1_utc_source", "qualified_name": "ut1_utc_source", "args": ["self", "i"], "decorators": [], "docstring": "Set UT1-UTC source flag for entries in IERS table", "start_line": 509, "end_line": 515, "is_async": false, "is_method": false}, {"name": "dcip_source", "qualified_name": "dcip_source", "args": ["self", "i"], "decorators": [], "docstring": "Set CIP correction source flag for entries in IERS table", "start_line": 517, "end_line": 523, "is_async": false, "is_method": false}, {"name": "pm_source", "qualified_name": "pm_source", "args": ["self", "i"], "decorators": [], "docstring": "Set polar motion source flag for entries in IERS table", "start_line": 525, "end_line": 531, "is_async": false, "is_method": false}, {"name": "read", "qualified_name": "read", "args": ["cls", "file", "readme", "data_start"], "decorators": ["classmethod"], "docstring": "Read IERS-B table from a eopc04_iau2000.* file provided by IERS.\n\nParameters\n----------\nfile : str\n    full path to ascii file holding IERS-B data.\n    Defaults to package version, ``iers.IERS_B_FILE``.\nreadme : str\n    full path to ascii file holding CDS-style readme.\n    Defaults to package versio", "start_line": 548, "end_line": 575, "is_async": false, "is_method": false}, {"name": "ut1_utc_source", "qualified_name": "ut1_utc_source", "args": ["self", "i"], "decorators": [], "docstring": "Set UT1-UTC source flag for entries in IERS table", "start_line": 577, "end_line": 579, "is_async": false, "is_method": false}, {"name": "dcip_source", "qualified_name": "dcip_source", "args": ["self", "i"], "decorators": [], "docstring": "Set CIP correction source flag for entries in IERS table", "start_line": 581, "end_line": 583, "is_async": false, "is_method": false}, {"name": "pm_source", "qualified_name": "pm_source", "args": ["self", "i"], "decorators": [], "docstring": "Set PM source flag for entries in IERS table", "start_line": 585, "end_line": 587, "is_async": false, "is_method": false}, {"name": "open", "qualified_name": "open", "args": ["cls"], "decorators": ["classmethod"], "docstring": "If the configuration setting ``astropy.utils.iers.conf.auto_download``\nis set to True (default), then open a recent version of the IERS-A\ntable with predictions for UT1-UTC and polar motion out to\napproximately one year from now.  If the available version of this file\nis older than ``astropy.utils.i", "start_line": 598, "end_line": 645, "is_async": false, "is_method": false}, {"name": "_check_interpolate_indices", "qualified_name": "_check_interpolate_indices", "args": ["self", "indices_orig", "indices_clipped", "max_input_mjd"], "decorators": [], "docstring": "Check that the indices from interpolation match those after clipping to the\nvalid table range.  The IERS_Auto class is exempted as long as it has\nsufficiently recent available data so the clipped interpolation is\nalways within the confidence bounds of current Earth rotation\nknowledge.", "start_line": 647, "end_line": 661, "is_async": false, "is_method": false}, {"name": "_refresh_table_as_needed", "qualified_name": "_refresh_table_as_needed", "args": ["self", "mjd"], "decorators": [], "docstring": "Potentially update the IERS table in place depending on the requested\ntime values in ``mjd`` and the time span of the table.\n\nFor IERS_Auto the behavior is that the table is refreshed from the IERS\nserver if both the following apply:\n\n- Any of the requested IERS values are predictive.  The IERS-A ta", "start_line": 663, "end_line": 736, "is_async": false, "is_method": false}, {"name": "_substitute_iers_b", "qualified_name": "_substitute_iers_b", "args": ["cls", "table"], "decorators": ["classmethod"], "docstring": "Substitute IERS B values with those from a real IERS B table.\n\nIERS-A has IERS-B values included, but for reasons unknown these\ndo not match the latest IERS-B values (see comments in #4436).\nHere, we use the bundled astropy IERS-B table to overwrite the values\nin the downloaded IERS-A table.", "start_line": 739, "end_line": 765, "is_async": false, "is_method": false}], "classes": [{"name": "IERSStaleWarning", "bases": ["AstropyWarning"], "methods": [], "docstring": "", "start_line": 81, "end_line": 82}, {"name": "Conf", "bases": ["_config.ConfigNamespace"], "methods": [], "docstring": "Configuration parameters for `astropy.utils.iers`.", "start_line": 85, "end_line": 101}, {"name": "IERSRangeError", "bases": ["IndexError"], "methods": [], "docstring": "Any error for when dates are outside of the valid range for IERS", "start_line": 107, "end_line": 110}, {"name": "IERS", "bases": ["QTable"], "methods": ["open", "close", "mjd_utc", "ut1_utc", "dcip_xy", "pm_xy", "_check_interpolate_indices", "_interpolate", "_refresh_table_as_needed", "ut1_utc_source", "dcip_source", "pm_source", "time_now"], "docstring": "Generic IERS table class, defining interpolation functions.\n\nSub-classed from `astropy.table.QTable`.  The table should hold columns\n'MJD', 'UT1_UTC', 'dX_2000A'/'dY_2000A', and 'PM_x'/'PM_y'.", "start_line": 113, "end_line": 389}, {"name": "IERS_A", "bases": ["IERS"], "methods": ["_combine_a_b_columns", "_substitute_iers_b", "read", "ut1_utc_source", "dcip_source", "pm_source"], "docstring": "IERS Table class targeted to IERS A, provided by USNO.\n\nThese include rapid turnaround and predicted times.\nSee http://maia.usno.navy.mil/\n\nNotes\n-----\nThe IERS A file is not part of astropy.  It can be downloaded from\n``iers.IERS_A_URL``.  See ``iers.__doc__`` for instructions on how to use\nit in `", "start_line": 392, "end_line": 531}, {"name": "IERS_B", "bases": ["IERS"], "methods": ["read", "ut1_utc_source", "dcip_source", "pm_source"], "docstring": "IERS Table class targeted to IERS B, provided by IERS itself.\n\nThese are final values; see http://www.iers.org/\n\nNotes\n-----\nIf the package IERS B file (```iers.IERS_B_FILE``) is out of date, a new\nversion can be downloaded from ``iers.IERS_B_URL``.", "start_line": 534, "end_line": 587}, {"name": "IERS_Auto", "bases": ["IERS_A"], "methods": ["open", "_check_interpolate_indices", "_refresh_table_as_needed", "_substitute_iers_b"], "docstring": "Provide most-recent IERS data and automatically handle downloading\nof updated values as necessary.", "start_line": 590, "end_line": 765}], "calls": [], "module_docstring": "The astropy.utils.iers package provides access to the tables provided by\nthe International Earth Rotation and Reference Systems Service, in\nparticular allowing interpolation of published UT1-UTC values for given\ntimes.  These are used in `astropy.time` to provide UT1 values.  The polar\nmotions are also used for determining earth orientation for\ncelestial-to-terrestrial coordinate transformations\n(in `astropy.coordinates`).", "parse_error": ""}, {"file_path": "astropy/utils/iers/__init__.py", "file_hash": "6c92009ce72a60330bb8291233e1436b7674ef48cb992f6f54ae36520f736e58", "imports": [{"module": "iers", "names": ["*"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/utils/compat/numpycompat.py", "file_hash": "71a9a67a1b8ae7882b5b95434d684565d10c0d698ee5a41e41c9816c97985cb6", "imports": [{"module": "utils", "names": ["minversion"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "This is a collection of monkey patches and workarounds for bugs in\nearlier versions of Numpy.", "parse_error": ""}, {"file_path": "astropy/utils/compat/__init__.py", "file_hash": "043c1552ba82ab3619ce313dbc1f9aa24e089fa8ac2ec49b81631fe08c148402", "imports": [{"module": "misc", "names": ["*"], "is_from": true, "alias": ""}, {"module": "numpycompat", "names": ["*"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "This subpackage contains utility modules for compatibility with older/newer\nversions of python, as well as including some bugfixes for the stdlib that are\nimportant for Astropy.\n\nNote that all public functions in the `astropy.utils.compat.misc` module are\nimported here for easier access.", "parse_error": ""}, {"file_path": "astropy/utils/compat/funcsigs.py", "file_hash": "0f46911008cacafedce12ab4e3ec2db28be80dcd8412a6074992a413828fad13", "imports": [{"module": "inspect", "names": ["signature", "Parameter", "Signature", "BoundArguments"], "is_from": true, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "exceptions", "names": ["AstropyDeprecationWarning"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/utils/compat/misc.py", "file_hash": "2fce7b711e53d84bb081dc8b2db17854706e7b4afff5e73a663431ab29713e2e", "imports": [{"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "functools", "names": [], "is_from": false, "alias": ""}, {"module": "contextlib", "names": ["suppress"], "is_from": true, "alias": ""}, {"module": "importlib", "names": ["invalidate_caches"], "is_from": true, "alias": ""}], "functions": [{"name": "possible_filename", "qualified_name": "possible_filename", "args": ["filename"], "decorators": [], "docstring": "Determine if the ``filename`` argument is an allowable type for a filename.\n\nIn Python 3.3 use of non-unicode filenames on system calls such as\n`os.stat` and others that accept a filename argument was deprecated (and\nmay be removed outright in the future).\n\nTherefore this returns `True` in all cases", "start_line": 19, "end_line": 36, "is_async": false, "is_method": false}, {"name": "override__dir__", "qualified_name": "override__dir__", "args": ["f"], "decorators": [], "docstring": "When overriding a __dir__ method on an object, you often want to\ninclude the \"standard\" members on the object as well.  This\ndecorator takes care of that automatically, and all the wrapped\nfunction needs to do is return a list of the \"special\" members\nthat wouldn't be found by the normal Python mean", "start_line": 39, "end_line": 62, "is_async": false, "is_method": false}, {"name": "namedtuple_asdict", "qualified_name": "namedtuple_asdict", "args": ["namedtuple"], "decorators": [], "docstring": "The same as ``namedtuple._adict()``.\n\nParameters\n----------\nnamedtuple : collections.namedtuple\nThe named tuple to get the dict of", "start_line": 65, "end_line": 74, "is_async": false, "is_method": false}, {"name": "override__dir__wrapper", "qualified_name": "override__dir__wrapper", "args": ["self"], "decorators": ["functools.wraps(f)"], "docstring": "", "start_line": 57, "end_line": 60, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "Simple utility functions and bug fixes for compatibility with all supported\nversions of Python.  This module should generally not be used directly, as\neverything in `__all__` will be imported into `astropy.utils.compat` and can\nbe accessed from there.", "parse_error": ""}, {"file_path": "astropy/utils/xml/tests/__init__.py", "file_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/utils/xml/tests/test_iterparse.py", "file_hash": "29149f397014797e1f6fb8f3ea56ed05297a6ceec410bd77f2afd2baf552bc09", "imports": [{"module": "utils.xml.iterparser", "names": ["_fast_iterparse"], "is_from": true, "alias": ""}, {"module": "io", "names": [], "is_from": false, "alias": ""}, {"module": "zlib", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "test_iterparser_over_read_simple", "qualified_name": "test_iterparser_over_read_simple", "args": [], "decorators": [], "docstring": "", "start_line": 111, "end_line": 132, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "fd"], "decorators": [], "docstring": "", "start_line": 82, "end_line": 84, "is_async": false, "is_method": false}, {"name": "read", "qualified_name": "read", "args