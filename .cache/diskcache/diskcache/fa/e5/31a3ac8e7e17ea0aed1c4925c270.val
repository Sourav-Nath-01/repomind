value"], "decorators": [], "docstring": "", "start_line": 152, "end_line": 189, "is_async": false, "is_method": false}, {"name": "__delitem__", "qualified_name": "__delitem__", "args": ["self", "key"], "decorators": [], "docstring": "", "start_line": 191, "end_line": 247, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 249, "end_line": 250, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 252, "end_line": 253, "is_async": false, "is_method": false}, {"name": "__eq__", "qualified_name": "__eq__", "args": ["self", "other"], "decorators": [], "docstring": "Two Headers are equal only if they have the exact same string\nrepresentation.", "start_line": 255, "end_line": 261, "is_async": false, "is_method": false}, {"name": "__add__", "qualified_name": "__add__", "args": ["self", "other"], "decorators": [], "docstring": "", "start_line": 263, "end_line": 266, "is_async": false, "is_method": false}, {"name": "__iadd__", "qualified_name": "__iadd__", "args": ["self", "other"], "decorators": [], "docstring": "", "start_line": 268, "end_line": 270, "is_async": false, "is_method": false}, {"name": "cards", "qualified_name": "cards", "args": ["self"], "decorators": ["property"], "docstring": "The underlying physical cards that make up this Header; it can be\nlooked at, but it should not be modified directly.", "start_line": 273, "end_line": 279, "is_async": false, "is_method": false}, {"name": "comments", "qualified_name": "comments", "args": ["self"], "decorators": ["property"], "docstring": "View the comments associated with each keyword, if any.\n\nFor example, to see the comment on the NAXIS keyword:\n\n    >>> header.comments['NAXIS']\n    number of data axes\n\nComments can also be updated through this interface:\n\n    >>> header.comments['NAXIS'] = 'Number of data axes'", "start_line": 282, "end_line": 297, "is_async": false, "is_method": false}, {"name": "_modified", "qualified_name": "_modified", "args": ["self"], "decorators": ["property"], "docstring": "Whether or not the header has been modified; this is a property so that\nit can also check each card for modifications--cards may have been\nmodified directly without the header containing it otherwise knowing.", "start_line": 300, "end_line": 313, "is_async": false, "is_method": false}, {"name": "_modified", "qualified_name": "_modified", "args": ["self", "val"], "decorators": ["_modified.setter"], "docstring": "", "start_line": 316, "end_line": 317, "is_async": false, "is_method": false}, {"name": "fromstring", "qualified_name": "fromstring", "args": ["cls", "data", "sep"], "decorators": ["classmethod"], "docstring": "Creates an HDU header from a byte string containing the entire header\ndata.\n\nParameters\n----------\ndata : str\n   String containing the entire header.\n\nsep : str, optional\n    The string separating cards from each other, such as a newline.  By\n    default there is no card separator (as is the case in", "start_line": 320, "end_line": 387, "is_async": false, "is_method": false}, {"name": "fromfile", "qualified_name": "fromfile", "args": ["cls", "fileobj", "sep", "endcard", "padding"], "decorators": ["classmethod"], "docstring": "Similar to :meth:`Header.fromstring`, but reads the header string from\na given file-like object or filename.\n\nParameters\n----------\nfileobj : str, file-like\n    A filename or an open file-like object from which a FITS header is\n    to be read.  For open file handles the file pointer must be at the\n ", "start_line": 390, "end_line": 447, "is_async": false, "is_method": false}, {"name": "_from_blocks", "qualified_name": "_from_blocks", "args": ["cls", "block_iter", "is_binary", "sep", "endcard", "padding"], "decorators": ["classmethod"], "docstring": "The meat of `Header.fromfile`; in a separate method so that\n`Header.fromfile` itself is just responsible for wrapping file\nhandling.  Also used by `_BaseHDU.fromstring`.\n\n``block_iter`` should be a callable which, given a block size n\n(typically 2880 bytes as used by the FITS standard) returns an it", "start_line": 450, "end_line": 545, "is_async": false, "is_method": false}, {"name": "_find_end_card", "qualified_name": "_find_end_card", "args": ["cls", "block", "card_len"], "decorators": ["classmethod"], "docstring": "Utility method to search a header block for the END card and handle\ninvalid END cards.\n\nThis method can also returned a modified copy of the input header block\nin case an invalid end card needs to be sanitized.", "start_line": 548, "end_line": 590, "is_async": false, "is_method": false}, {"name": "tostring", "qualified_name": "tostring", "args": ["self", "sep", "endcard", "padding"], "decorators": [], "docstring": "Returns a string representation of the header.\n\nBy default this uses no separator between cards, adds the END card, and\npads the string with spaces to the next multiple of 2880 bytes.  That\nis, it returns the header exactly as it would appear in a FITS file.\n\nParameters\n----------\nsep : str, optiona", "start_line": 592, "end_line": 635, "is_async": false, "is_method": false}, {"name": "tofile", "qualified_name": "tofile", "args": ["self", "fileobj", "sep", "endcard", "padding", "overwrite"], "decorators": ["deprecated_renamed_argument('clobber', 'overwrite', '2.0')"], "docstring": "Writes the header to file or file-like object.\n\nBy default this writes the header exactly as it would be written to a\nFITS file, with the END card included and padding to the next multiple\nof 2880 bytes.  However, aspects of this may be controlled.\n\nParameters\n----------\nfileobj : str, file, optiona", "start_line": 638, "end_line": 700, "is_async": false, "is_method": false}, {"name": "fromtextfile", "qualified_name": "fromtextfile", "args": ["cls", "fileobj", "endcard"], "decorators": ["classmethod"], "docstring": "Read a header from a simple text file or file-like object.\n\nEquivalent to::\n\n    >>> Header.fromfile(fileobj, sep='\\n', endcard=False,\n    ...                 padding=False)\n\nSee Also\n--------\nfromfile", "start_line": 703, "end_line": 717, "is_async": false, "is_method": false}, {"name": "totextfile", "qualified_name": "totextfile", "args": ["self", "fileobj", "endcard", "overwrite"], "decorators": ["deprecated_renamed_argument('clobber', 'overwrite', '2.0')"], "docstring": "Write the header as text to a file or a file-like object.\n\nEquivalent to::\n\n    >>> Header.tofile(fileobj, sep='\\n', endcard=False,\n    ...               padding=False, overwrite=overwrite)\n\n.. versionchanged:: 1.3\n   ``overwrite`` replaces the deprecated ``clobber`` argument.\n\nSee Also\n--------\ntof", "start_line": 720, "end_line": 738, "is_async": false, "is_method": false}, {"name": "clear", "qualified_name": "clear", "args": ["self"], "decorators": [], "docstring": "Remove all cards from the header.", "start_line": 740, "end_line": 747, "is_async": false, "is_method": false}, {"name": "copy", "qualified_name": "copy", "args": ["self", "strip"], "decorators": [], "docstring": "Make a copy of the :class:`Header`.\n\n.. versionchanged:: 1.3\n    `copy.copy` and `copy.deepcopy` on a `Header` will call this\n    method.\n\nParameters\n----------\nstrip : bool, optional\n   If `True`, strip any headers that are specific to one of the\n   standard HDU types, so that this header can be us", "start_line": 749, "end_line": 773, "is_async": false, "is_method": false}, {"name": "__copy__", "qualified_name": "__copy__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 775, "end_line": 776, "is_async": false, "is_method": false}, {"name": "__deepcopy__", "qualified_name": "__deepcopy__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 778, "end_line": 779, "is_async": false, "is_method": false}, {"name": "fromkeys", "qualified_name": "fromkeys", "args": ["cls", "iterable", "value"], "decorators": ["classmethod"], "docstring": "Similar to :meth:`dict.fromkeys`--creates a new `Header` from an\niterable of keywords and an optional default value.\n\nThis method is not likely to be particularly useful for creating real\nworld FITS headers, but it is useful for testing.\n\nParameters\n----------\niterable\n    Any iterable that returns ", "start_line": 782, "end_line": 810, "is_async": false, "is_method": false}, {"name": "get", "qualified_name": "get", "args": ["self", "key", "default"], "decorators": [], "docstring": "Similar to :meth:`dict.get`--returns the value associated with keyword\nin the header, or a default value if the keyword is not found.\n\nParameters\n----------\nkey : str\n    A keyword that may or may not be in the header.\n\ndefault : optional\n    A default value to return if the keyword is not found in ", "start_line": 812, "end_line": 836, "is_async": false, "is_method": false}, {"name": "set", "qualified_name": "set", "args": ["self", "keyword", "value", "comment", "before", "after"], "decorators": [], "docstring": "Set the value and/or comment and/or position of a specified keyword.\n\nIf the keyword does not already exist in the header, a new keyword is\ncreated in the specified position, or appended to the end of the header\nif no position is specified.\n\nThis method is similar to :meth:`Header.update` prior to A", "start_line": 838, "end_line": 924, "is_async": false, "is_method": false}, {"name": "items", "qualified_name": "items", "args": ["self"], "decorators": [], "docstring": "Like :meth:`dict.items`.", "start_line": 926, "end_line": 930, "is_async": false, "is_method": false}, {"name": "keys", "qualified_name": "keys", "args": ["self"], "decorators": [], "docstring": "Like :meth:`dict.keys`--iterating directly over the `Header`\ninstance has the same behavior.", "start_line": 932, "end_line": 938, "is_async": false, "is_method": false}, {"name": "values", "qualified_name": "values", "args": ["self"], "decorators": [], "docstring": "Like :meth:`dict.values`.", "start_line": 940, "end_line": 944, "is_async": false, "is_method": false}, {"name": "pop", "qualified_name": "pop", "args": ["self"], "decorators": [], "docstring": "Works like :meth:`list.pop` if no arguments or an index argument are\nsupplied; otherwise works like :meth:`dict.pop`.", "start_line": 946, "end_line": 969, "is_async": false, "is_method": false}, {"name": "popitem", "qualified_name": "popitem", "args": ["self"], "decorators": [], "docstring": "Similar to :meth:`dict.popitem`.", "start_line": 971, "end_line": 979, "is_async": false, "is_method": false}, {"name": "setdefault", "qualified_name": "setdefault", "args": ["self", "key", "default"], "decorators": [], "docstring": "Similar to :meth:`dict.setdefault`.", "start_line": 981, "end_line": 988, "is_async": false, "is_method": false}, {"name": "update", "qualified_name": "update", "args": ["self"], "decorators": [], "docstring": "Update the Header with new keyword values, updating the values of\nexisting keywords and appending new keywords otherwise; similar to\n`dict.update`.\n\n`update` accepts either a dict-like object or an iterable.  In the\nformer case the keys must be header keywords and the values may be\neither scalar val", "start_line": 990, "end_line": 1098, "is_async": false, "is_method": false}, {"name": "append", "qualified_name": "append", "args": ["self", "card", "useblanks", "bottom", "end"], "decorators": [], "docstring": "Appends a new keyword+value card to the end of the Header, similar\nto `list.append`.\n\nBy default if the last cards in the Header have commentary keywords,\nthis will append the new keyword before the commentary (unless the new\nkeyword is also commentary).\n\nAlso differs from `list.append` in that it c", "start_line": 1100, "end_line": 1188, "is_async": false, "is_method": false}, {"name": "extend", "qualified_name": "extend", "args": ["self", "cards", "strip", "unique", "update", "update_first", "useblanks", "bottom", "end"], "decorators": [], "docstring": "Appends multiple keyword+value cards to the end of the header, similar\nto `list.extend`.\n\nParameters\n----------\ncards : iterable\n    An iterable of (keyword, value, [comment]) tuples; see\n    `Header.append`.\n\nstrip : bool, optional\n    Remove any keywords that have meaning only to specific types of", "start_line": 1190, "end_line": 1288, "is_async": false, "is_method": false}, {"name": "count", "qualified_name": "count", "args": ["self", "keyword"], "decorators": [], "docstring": "Returns the count of the given keyword in the header, similar to\n`list.count` if the Header object is treated as a list of keywords.\n\nParameters\n----------\nkeyword : str\n    The keyword to count instances of in the header", "start_line": 1290, "end_line": 1309, "is_async": false, "is_method": false}, {"name": "index", "qualified_name": "index", "args": ["self", "keyword", "start", "stop"], "decorators": [], "docstring": "Returns the index if the first instance of the given keyword in the\nheader, similar to `list.index` if the Header object is treated as a\nlist of keywords.\n\nParameters\n----------\nkeyword : str\n    The keyword to look up in the list of all keywords in the header\n\nstart : int, optional\n    The lower bo", "start_line": 1311, "end_line": 1348, "is_async": false, "is_method": false}, {"name": "insert", "qualified_name": "insert", "args": ["self", "key", "card", "useblanks", "after"], "decorators": [], "docstring": "Inserts a new keyword+value card into the Header at a given location,\nsimilar to `list.insert`.\n\nParameters\n----------\nkey : int, str, or tuple\n    The index into the list of header keywords before which the\n    new keyword should be inserted, or the name of a keyword before\n    which the new keywor", "start_line": 1350, "end_line": 1442, "is_async": false, "is_method": false}, {"name": "remove", "qualified_name": "remove", "args": ["self", "keyword", "ignore_missing", "remove_all"], "decorators": [], "docstring": "Removes the first instance of the given keyword from the header similar\nto `list.remove` if the Header object is treated as a list of keywords.\n\nParameters\n----------\nkeyword : str\n    The keyword of which to remove the first instance in the header.\n\nignore_missing : bool, optional\n    When True, ig", "start_line": 1444, "end_line": 1470, "is_async": false, "is_method": false}, {"name": "rename_keyword", "qualified_name": "rename_keyword", "args": ["self", "oldkeyword", "newkeyword", "force"], "decorators": [], "docstring": "Rename a card's keyword in the header.\n\nParameters\n----------\noldkeyword : str or int\n    Old keyword or card index\n\nnewkeyword : str\n    New keyword\n\nforce : bool, optional\n    When `True`, if the new keyword already exists in the header, force\n    the creation of a duplicate keyword. Otherwise a\n ", "start_line": 1472, "end_line": 1509, "is_async": false, "is_method": false}, {"name": "add_history", "qualified_name": "add_history", "args": ["self", "value", "before", "after"], "decorators": [], "docstring": "Add a ``HISTORY`` card.\n\nParameters\n----------\nvalue : str\n    History text to be added.\n\nbefore : str or int, optional\n    Same as in `Header.update`\n\nafter : str or int, optional\n    Same as in `Header.update`", "start_line": 1511, "end_line": 1527, "is_async": false, "is_method": false}, {"name": "add_comment", "qualified_name": "add_comment", "args": ["self", "value", "before", "after"], "decorators": [], "docstring": "Add a ``COMMENT`` card.\n\nParameters\n----------\nvalue : str\n    Text to be added.\n\nbefore : str or int, optional\n    Same as in `Header.update`\n\nafter : str or int, optional\n    Same as in `Header.update`", "start_line": 1529, "end_line": 1545, "is_async": false, "is_method": false}, {"name": "add_blank", "qualified_name": "add_blank", "args": ["self", "value", "before", "after"], "decorators": [], "docstring": "Add a blank card.\n\nParameters\n----------\nvalue : str, optional\n    Text to be added.\n\nbefore : str or int, optional\n    Same as in `Header.update`\n\nafter : str or int, optional\n    Same as in `Header.update`", "start_line": 1547, "end_line": 1563, "is_async": false, "is_method": false}, {"name": "_update", "qualified_name": "_update", "args": ["self", "card"], "decorators": [], "docstring": "The real update code.  If keyword already exists, its value and/or\ncomment will be updated.  Otherwise a new card will be appended.\n\nThis will not create a duplicate keyword except in the case of\ncommentary cards.  The only other way to force creation of a duplicate\nis to use the insert(), append(),", "start_line": 1565, "end_line": 1606, "is_async": false, "is_method": false}, {"name": "_cardindex", "qualified_name": "_cardindex", "args": ["self", "key"], "decorators": [], "docstring": "Returns an index into the ._cards list given a valid lookup key.", "start_line": 1608, "end_line": 1657, "is_async": false, "is_method": false}, {"name": "_keyword_from_index", "qualified_name": "_keyword_from_index", "args": ["self", "idx"], "decorators": [], "docstring": "Given an integer index, return the (keyword, repeat) tuple that index\nrefers to.  For most keywords the repeat will always be zero, but it\nmay be greater than zero for keywords that are duplicated (especially\ncommentary keywords).\n\nIn a sense this is the inverse of self.index, except that it also\nsu", "start_line": 1659, "end_line": 1676, "is_async": false, "is_method": false}, {"name": "_relativeinsert", "qualified_name": "_relativeinsert", "args": ["self", "card", "before", "after", "replace"], "decorators": [], "docstring": "Inserts a new card before or after an existing card; used to\nimplement support for the legacy before/after keyword arguments to\nHeader.update().\n\nIf replace=True, move an existing card with the same keyword.", "start_line": 1678, "end_line": 1735, "is_async": false, "is_method": false}, {"name": "_updateindices", "qualified_name": "_updateindices", "args": ["self", "idx", "increment"], "decorators": [], "docstring": "For all cards with index above idx, increment or decrement its index\nvalue in the keyword_indices dict.", "start_line": 1737, "end_line": 1752, "is_async": false, "is_method": false}, {"name": "_countblanks", "qualified_name": "_countblanks", "args": ["self"], "decorators": [], "docstring": "Returns the number of blank cards at the end of the Header.", "start_line": 1754, "end_line": 1760, "is_async": false, "is_method": false}, {"name": "_useblanks", "qualified_name": "_useblanks", "args": ["self", "count"], "decorators": [], "docstring": "", "start_line": 1762, "end_line": 1767, "is_async": false, "is_method": false}, {"name": "_haswildcard", "qualified_name": "_haswildcard", "args": ["self", "keyword"], "decorators": [], "docstring": "Return `True` if the input keyword contains a wildcard pattern.", "start_line": 1769, "end_line": 1773, "is_async": false, "is_method": false}, {"name": "_wildcardmatch", "qualified_name": "_wildcardmatch", "args": ["self", "pattern"], "decorators": [], "docstring": "Returns a list of indices of the cards matching the given wildcard\npattern.\n\n * '*' matches 0 or more characters\n * '?' matches a single character\n * '...' matches 0 or more of any non-whitespace character", "start_line": 1775, "end_line": 1790, "is_async": false, "is_method": false}, {"name": "_set_slice", "qualified_name": "_set_slice", "args": ["self", "key", "value", "target"], "decorators": [], "docstring": "Used to implement Header.__setitem__ and CardAccessor.__setitem__.", "start_line": 1792, "end_line": 1811, "is_async": false, "is_method": false}, {"name": "_splitcommentary", "qualified_name": "_splitcommentary", "args": ["self", "keyword", "value"], "decorators": [], "docstring": "Given a commentary keyword and value, returns a list of the one or more\ncards needed to represent the full value.  This is primarily used to\ncreate the multiple commentary cards needed to represent a long value\nthat won't fit into a single commentary card.", "start_line": 1813, "end_line": 1838, "is_async": false, "is_method": false}, {"name": "_strip", "qualified_name": "_strip", "args": ["self"], "decorators": [], "docstring": "Strip cards specific to a certain kind of header.\n\nStrip cards like ``SIMPLE``, ``BITPIX``, etc. so the rest of\nthe header can be used to reconstruct another kind of header.", "start_line": 1840, "end_line": 1886, "is_async": false, "is_method": false}, {"name": "_add_commentary", "qualified_name": "_add_commentary", "args": ["self", "key", "value", "before", "after"], "decorators": [], "docstring": "Add a commentary card.\n\nIf ``before`` and ``after`` are `None`, add to the last occurrence\nof cards of the same name (except blank card).  If there is no\ncard (or blank card), append at the end.", "start_line": 1888, "end_line": 1901, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "header"], "decorators": [], "docstring": "", "start_line": 1920, "end_line": 1921, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1923, "end_line": 1924, "is_async": false, "is_method": false}, {"name": "__len__", "qualified_name": "__len__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1926, "end_line": 1927, "is_async": false, "is_method": false}, {"name": "__iter__", "qualified_name": "__iter__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1929, "end_line": 1930, "is_async": false, "is_method": false}, {"name": "__eq__", "qualified_name": "__eq__", "args": ["self", "other"], "decorators": [], "docstring": "", "start_line": 1932, "end_line": 1945, "is_async": false, "is_method": false}, {"name": "__ne__", "qualified_name": "__ne__", "args": ["self", "other"], "d