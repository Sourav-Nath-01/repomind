, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "utils.misc", "names": ["isiterable"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 26, "end_line": 37, "is_async": false, "is_method": false}, {"name": "__setitem__", "qualified_name": "__setitem__", "args": ["self", "item", "value"], "decorators": [], "docstring": "", "start_line": 39, "end_line": 48, "is_async": false, "is_method": false}], "classes": [{"name": "FlagCollection", "bases": ["OrderedDict"], "methods": ["__init__", "__setitem__"], "docstring": "The purpose of this class is to provide a dictionary for\ncontaining arrays of flags for the `NDData` class. Flags should be\nstored in Numpy arrays that have the same dimensions as the parent\ndata, so the `FlagCollection` class adds shape checking to an\nordered dictionary class.\n\nThe `FlagCollection`", "start_line": 13, "end_line": 48}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/nddata/nddata_base.py", "file_hash": "7e6f0186b4d61278a1a70ab055b5827f5ef23896c7e376434efce07293ab5acd", "imports": [{"module": "abc", "names": ["ABCMeta", "abstractmethod"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": ["abstractmethod"], "docstring": "", "start_line": 21, "end_line": 22, "is_async": false, "is_method": false}, {"name": "data", "qualified_name": "data", "args": ["self"], "decorators": ["property", "abstractmethod"], "docstring": "The stored dataset.\n        ", "start_line": 26, "end_line": 29, "is_async": false, "is_method": false}, {"name": "mask", "qualified_name": "mask", "args": ["self"], "decorators": ["property", "abstractmethod"], "docstring": "Mask for the dataset.\n\nMasks should follow the ``numpy`` convention that **valid** data points\nare marked by ``False`` and **invalid** ones with 