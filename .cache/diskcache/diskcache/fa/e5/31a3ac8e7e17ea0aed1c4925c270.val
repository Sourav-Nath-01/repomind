le": "", "names": ["coordinates"], "is_from": true, "alias": ""}], "functions": [{"name": "test_parameter_quantity", "qualified_name": "test_parameter_quantity", "args": [], "decorators": [], "docstring": "Basic tests for initializing general models (that do not require units)\nwith parameters that have units attached.", "start_line": 27, "end_line": 38, "is_async": false, "is_method": false}, {"name": "test_parameter_set_quantity", "qualified_name": "test_parameter_set_quantity", "args": [], "decorators": [], "docstring": "Make sure that parameters that start off as quantities can be set to any\nother quantity, regardless of whether the units of the new quantity are\ncompatible with the original ones.\n\nWe basically leave it up to the evaluate method to raise errors if there\nare issues with incompatible units, and we don", "start_line": 41, "end_line": 71, "is_async": false, "is_method": false}, {"name": "test_parameter_lose_units", "qualified_name": "test_parameter_lose_units", "args": [], "decorators": [], "docstring": "Check that parameters that have been set to a quantity that are then set to\na value with no units raise an exception. We do this because setting a\nparameter to a value with no units is ambiguous if units were set before:\nif a paramter is 1 * u.Jy and the parameter is then set to 4, does this mean\n2 ", "start_line": 74, "end_line": 89, "is_async": false, "is_method": false}, {"name": "test_parameter_add_units", "qualified_name": "test_parameter_add_units", "args": [], "decorators": [], "docstring": "On the other hand, if starting from a parameter with no units, we should be\nable to add units since this is unambiguous.", "start_line": 92, "end_line": 101, "is_async": false, "is_method": false}, {"name": "test_parameter_change_unit", "qualified_name": "test_parameter_change_unit", "args": [], "decorators": [], "docstring": "Test that changing the unit on a parameter does not work. This is an\nambiguous operation because it's not clear if it means that the value should\nbe converted or if the unit should be changed without conversion.", "start_line": 104, "end_line": 123, "is_async": false, "is_method": false}, {"name": "test_parameter_set_value", "qualified_name": "test_parameter_set_value", "args": [], "decorators": [], "docstring": "Test that changing the value on a parameter works as expected.", "start_line": 126, "end_line": 149, "is_async": false, "is_method": false}, {"name": "test_parameter_quantity_property", "qualified_name": "test_parameter_quantity_property", "args": [], "decorators": [], "docstring": "Test that the quantity property of Parameters behaves as expected", "start_line": 152, "end_line": 178, "is_async": false, "is_method": false}, {"name": "test_parameter_default_units_match", "qualified_name": "test_parameter_default_units_match", "args": [], "decorators": [], "docstring": "", "start_line": 181, "end_line": 188, "is_async": false, "is_method": false}, {"name": "test_parameter_defaults", "qualified_name": "test_parameter_defaults", "args": ["unit", "default"], "decorators": ["pytest.mark.parametrize(('unit', 'default'), ((u.m, 1.0), (None, 1 * u.m)))"], "docstring": "Test that default quantities are correctly taken into account", "start_line": 192, "end_line": 239, "is_async": false, "is_method": false}, {"name": "test_parameter_quantity_arithmetic", "qualified_name": "test_parameter_quantity_arithmetic", "args": [], "decorators": [], "docstring": "Test that arithmetic operations with properties that have units return the\nappropriate Quantities.", "start_line": 242, "end_line": 278, "is_async": false, "is_method": false}, {"name": "test_parameter_quantity_comparison", "qualified_name": "test_parameter_quantity_comparison", "args": [], "decorators": [], "docstring": "Basic test of comparison operations on properties with units.", "start_line": 281, "end_line": 331, "is_async": false, "is_method": false}, {"name": "test_parameters_compound_models", "qualified_name": "test_parameter