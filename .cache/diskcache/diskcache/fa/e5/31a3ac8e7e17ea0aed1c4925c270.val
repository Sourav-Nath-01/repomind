lumn, the relevant indices are also copied over to the slice.\n\nIdeally, rather than shimming in a new ``__class__`` we would be able\nto just flip a flag that is check", "start_line": 693, "end_line": 723, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "lst"], "decorators": [], "docstring": "", "start_line": 737, "end_line": 738, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "item"], "decorators": [], "docstring": "Retrieve an item from the list of indices.\n\nParameters\n----------\nitem : int, str, tuple, or list\n    Position in list or name(s) of indexed column(s)", "start_line": 740, "end_line": 764, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "table"], "decorators": [], "docstring": "", "start_line": 778, "end_line": 782, "is_async": false, "is_method": false}, {"name": "_get_rows", "qualified_name": "_get_rows", "args": ["self", "item"], "decorators": [], "docstring": "Retrieve Table rows indexes by value slice.", "start_line": 784, "end_line": 814, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "item"], "decorators": [], "docstring": "Retrieve Table rows by value slice.\n\nParameters\n----------\nitem : column element, list, ndarray, slice or tuple\n    Can be a value of the table primary index, a list/ndarray\n    of such values, or a value slice (both endpoints are included).\n    If a tuple is provided, the first element must be\n    ", "start_line": 816, "end_line": 835, "is_async": false, "is_method": false}, {"name": "__setitem__", "qualified_name": "__setitem__", "args": ["self", "key", "value"], "decorators": [], "docstring": "Assign Table row's by value slice.\n\nParameters\n----------\nkey : column element, list, ndarray, slice or tuple\n      Can be a value of the table primary index, a list/ndarray\n      of such values, or a value slice (both endpoints are included).\n      If a tuple is provided, the first element must be\n", "start_line": 837, "end_line": 863, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "item"], "decorators": [], "docstring": "Retrieve Table row's indices by value slice.\n\nParameters\n----------\nitem : column element, list, ndarray, slice or tuple\n       Can be a value of the table primary index, a list/ndarray\n       of such values, or a value slice (both endpoints are included).\n       If a tuple is provided, the first el", "start_line": 868, "end_line": 886, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "table"], "decorators": [], "docstring": "", "start_line": 900, "end_line": 901, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "item"], "decorators": [], "docstring": "", "start_line": 903, "end_line": 915, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "item"], "decorators": [], "docstring": "", "start_line": 710, "end_line": 715, "is_async": false, "is_method": false}], "classes": [{"name": "QueryError", "bases": ["ValueError"], "methods": [], "docstring": "Indicates that a given index cannot handle the supplied query.", "start_line": 41, "end_line": 45}, {"name": "Index", "bases": [], "methods": ["__new__", "__init__", "__len__", "replace_col", "reload", "col_position", "insert_row", "get_row_specifier", "remove_rows", "remove_row", "find", "same_prefix", "same_prefix_range", "range", "replace", "replace_rows", "sort", "sorted_data", "__getitem__", "__str__", "__repr__", "__deepcopy__"], "docstring": "The Index class makes it possible to maintain indices\non columns of a Table, so that column values can be queried\nquickly and efficiently. Column values are stored in lexicographic\nsorted order, which allows for binary searching in O(log n).\n\nParameters\n----------\ncolumns : list or None\n    List of ", "start_line": 48, "end_line": 407}, {"name": "SlicedIndex", "bases": [], "methods": ["__init__", "length", "stop", "__getitem__", "sliced_coords", "orig_coords", "find", "where", "range", "same_prefix", "sorted_data", "replace", "copy", "insert_row", "get_row_specifier", "remove_rows", "replace_rows", "sort", "__repr__", "__str__", "replace_col", "reload", "col_position", "get_slice", "columns", "data"], "docstring": "This class provides a wrapper around an actual Index object\nto make index slicing function correctly. Since numpy expects\narray slices to provide an actual data view, a SlicedIndex should\nretrieve data directly from the original index and then adapt\nit to the sliced coordinate system as appropriate.", "start_line": 410, "end_line": 606}, {"name": "_IndexModeContext", "bases": [], "methods": ["__init__", "__enter__", "__exit__", "_get_copy_on_getitem_shim"], "docstring": "A context manager that allows for special indexing modes, which\nare intended to improve performance. Currently the allowed modes\nare \"freeze\", in which indices are not modified upon column modification,\n\"copy_on_getitem\", in which indices are copied upon column slicing,\nand \"discard_on_copy\", in whi", "start_line": 631, "end_line": 723}, {"name": "TableIndices", "bases": ["list"], "methods": ["__init__", "__getitem__"], "docstring": "A special list of table indices allowing\nfor retrieval by column name(s).\n\nParameters\n----------\nlst : list\n    List of indices", "start_line": 726, "end_line": 764}, {"name": "TableLoc", "bases": [], "methods": ["__init__", "_get_rows", "__getitem__", "__setitem__"], "docstring": "A pseudo-list of Table rows allowing for retrieval\nof rows by indexed column values.\n\nParameters\n----------\ntable : Table\n    Indexed table to use", "start_line": 767, "end_line": 863}, {"name": "TableLocIndices", "bases": ["TableLoc"], "methods": ["__getitem__"], "docstring": "", "start_line": 866, "end_line": 886}, {"name": "TableILoc", "bases": ["TableLoc"], "methods": ["__init__", "__getitem__"], "docstring": "A variant of TableLoc allowing for row retrieval by\nindexed order rather than data values.\n\nParameters\n----------\ntable : Table\n    Indexed table to use", "start_line": 889, "end_line": 915}], "calls": [], "module_docstring": "The Index class can use several implementations as its\nengine. Any implementation should implement the following:\n\n__init__(data, row_index) : initialize index based on key/row list pairs\nadd(key, row) -> None : add (key, row) to existing data\nremove(key, data=None) -> boolean : remove data from self[key], or all of\n                                    self[key] if data is None\nshift_left(row) -> None : decrement row numbers after row\nshift_right(row) -> None : increase row numbers >= row\nfind(key) -> list : list of rows corresponding to key\nrange(lower, upper, bounds) -> list : rows in self[k] where k is between\n                               lower and upper (<= or < based on bounds)\nsort() -> None : make row order align with key order\nsorted_data() -> list of rows in sorted order (by key)\nreplace_rows(row_map) -> None : replace row numbers based on slice\nitems() -> list of tuples of the form (key, data)\n\nNotes\n-----\n    When a Table is initialized from another Table, indices are\n    (deep) copied and their columns are set to the columns of the new Table.\n\n    Column creation:\n    Column(c) -> deep copy of indices\n    c[[1, 2]] -> deep copy and reordering of indices\n    c[1:2] -> reference\n    array.view(Column) -> no indices", "parse_error": ""}, {"file_path": "astropy/table/np_utils.py", "file_hash": "14cec9473b334dbbe97477d84e9f8d006f90c143452e8b763377da53654d734e", "imports": [{"module": "itertools", "names": ["chain"], "is_from": true, "alias": ""}, {"module": "collections", "names": [], "is_from": false, "alias": ""}, {"module": "collections", "names": ["OrderedDict", "Counter"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "numpy.ma", "names": [], "is_from": false, "alias": "ma"}, {"module": "", "names": ["_np_utils"], "is_from": true, "alias": ""}], "functions": [{"name": "get_col_name_map", "qualified_name": "get_col_name_map", "args": ["arrays", "common_names", "uniq_col_name", "table_names"], "decorators": [], "docstring": "Find the column names mapping when merging the list of structured ndarrays\n``arrays``.  It is assumed that col names in ``common_names`` are to be\nmerged into a single column while the rest will be uniquely represented\nin the output.  The args ``uniq_col_name`` and ``table_names`` specify\nhow to ren", "start_line": 24, "end_line": 77, "is_async": false, "is_method": false}, {"name": "get_descrs", "qualified_name": "get_descrs", "args": ["arrays", "col_name_map"], "decorators": [], "docstring": "Find the dtypes descrs resulting from merging the list of arrays' dtypes,\nusing the column name mapping ``col_name_map``.\n\nReturn a list of descrs for the output.", "start_line": 80, "end_line": 114, "is_async": false, "is_method": false}, {"name": "common_dtype", "qualified_name": "common_dtype", "args": ["cols"], "decorators": [], "docstring": "Use numpy to find the common dtype for a list of structured ndarray columns.\n\nOnly allow columns within the following fundamental numpy data types:\nnp.bool_, np.object_, np.number, np.character, np.void", "start_line": 117, "end_line": 144, "is_async": false, "is_method": false}, {"name": "_check_for_sequence_of_structured_arrays", "qualified_name": "_check_for_sequence_of_structured_arrays", "args": ["arrays"], "decorators": [], "docstring": "", "start_line": 147, "end_line": 156, "is_async": false, "is_method": false}, {"name": "fix_column_name", "qualified_name": "fix_column_name", "args": ["val"], "decorators": [], "docstring": "Fixes column names so that they are compatible with Numpy on\nPython 2.  Raises a ValueError exception if the column name\ncontains Unicode characters, which can not reasonably be used as a\ncolumn name.", "start_line": 159, "end_line": 172, "is_async": false, "is_method": false}, {"name": "recarray_fromrecords", "qualified_name": "recarray_fromrecords", "args": ["rec_list"], "decorators": [], "docstring": "Partial replacement for `~numpy.core.records.fromrecords` which includes\na workaround for the bug with unicode arrays described at:\nhttps://github.com/astropy/astropy/issues/3052\n\nThis should not serve as a full replacement for the original function;\nthis only does enough to fulfill the needs of the", "start_line": 175, "end_line": 195, "is_async": false, "is_method": false}], "classes": [{"name": "TableMergeError", "bases": ["ValueError"], "methods": [], "docstring": "", "start_line": 20, "end_line": 21}], "calls": [], "module_docstring": "High-level operations for numpy structured arrays.\n\nSome code and inspiration taken from numpy.lib.recfunctions.join_by().\nRedistribution license restrictions apply.", "parse_error": ""}, {"file_path": "astropy/table/groups.py", "file_hash": "d5f7121487277db9d629f31edd6260a989e50d50faf3944a9dcf871017da5284", "imports": [{"module": "platform", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "index", "names": ["get_index"], "is_from": true, "alias": ""}, {"module": "utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}, {"module": "table", "names": ["Table"], "is_from": true, "alias": ""}, {"module": "table", "names": ["Table"], "is_from": true, "alias": ""}, {"module": "column", "names": ["MaskedColumn"], "is_from": true, "alias": ""}], "functions": [{"name": "table_group_by", "qualified_name": "table_group_by", "args": ["table", "keys"], "decora