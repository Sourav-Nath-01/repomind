: false}, {"name": "warnings_logging_enabled", "qualified_name": "warnings_logging_enabled", "args": ["self"], "decorators": [], "docstring": "", "start_line": 204, "end_line": 205, "is_async": false, "is_method": false}, {"name": "enable_warnings_logging", "qualified_name": "enable_warnings_logging", "args": ["self"], "decorators": [], "docstring": "Enable logging of warnings.warn() calls\n\nOnce called, any subsequent calls to ``warnings.warn()`` are\nredirected to this logger and emitted with level ``WARN``. Note that\nthis replaces the output from ``warnings.warn``.\n\nThis can be disabled with ``disable_warnings_logging``.", "start_line": 207, "end_line": 220, "is_async": false, "is_method": false}, {"name": "disable_warnings_logging", "qualified_name": "disable_warnings_logging", "args": ["self"], "decorators": [], "docstring": "Disable logging of warnings.warn() calls\n\nOnce called, any subsequent calls to ``warnings.warn()`` are no longer\nredirected to this logger.\n\nThis can be re-enabled with ``enable_warnings_logging``.", "start_line": 222, "end_line": 238, "is_async": false, "is_method": false}, {"name": "_excepthook", "qualified_name": "_excepthook", "args": ["self", "etype", "value", "traceback"], "decorators": [], "docstring": "", "start_line": 242, "end_line": 262, "is_async": false, "is_method": false}, {"name": "exception_logging_enabled", "qualified_name": "exception_logging_enabled", "args": ["self"], "decorators": [], "docstring": "Determine if the exception-logging mechanism is enabled.\n\nReturns\n-------\nexclog : bool\n    True if exception logging is on, False if not.", "start_line": 264, "end_line": 281, "is_async": false, "is_method": false}, {"name": "enable_exception_logging", "qualified_name": "enable_exception_logging", "args": ["self"], "decorators": [], "docstring": "Enable logging of exceptions\n\nOnce called, any uncaught exceptions will be emitted with level\n``ERROR`` by this logger, before being raised.\n\nThis can be disabled with ``disable_exception_logging``.", "start_line": 283, "end_line": 322, "is_async": false, "is_method": false}, {"name": "disable_exception_logging", "qualified_name": "disable_exception_logging", "args": ["self"], "decorators": [], "docstring": "Disable logging of exceptions\n\nOnce called, any uncaught exceptions will no longer be emitted by this\nlogger.\n\nThis can be re-enabled with ``enable_exception_logging``.", "start_line": 324, "end_line": 351, "is_async": false, "is_method": false}, {"name": "enable_color", "qualified_name": "enable_color", "args": ["self"], "decorators": [], "docstring": "Enable colorized output", "start_line": 353, "end_line": 357, "is_async": false, "is_method": false}, {"name": "disable_color", "qualified_name": "disable_color", "args": ["self"], "decorators": [], "docstring": "Disable colorized output", "start_line": 359, "end_line": 363, "is_async": false, "is_method": false}, {"name": "log_to_file", "qualified_name": "log_to_file", "args": ["self", "filename", "filter_level", "filter_origin"], "decorators": ["contextmanager"], "docstring": "Context manager to temporarily log messages to a file.\n\nParameters\n----------\nfilename : str\n    The file to log messages to.\nfilter_level : str\n    If set, any log messages less important than ``filter_level`` will\n    not be output to the file. Note that this is in addition to the\n    top-level fi", "start_line": 366, "end_line": 412, "is_async": false, "is_method": false}, {"name": "log_to_list", "qualified_name": "log_to_list", "args": ["self", "filter_level", "filter_origin"], "decorators": ["contextmanager"], "docstring": "Context manager to temporarily log messages to a list.\n\nParameters\n----------\nfilename : str\n    The file to log messages to.\nfilter_level : str\n    If set, any log messages less important than ``filter_level`` will\n    not be output to the file. Note that this is in addition to the\n    top-level fi", "start_line": 415, "end_line": 455, "is_async": false, "is_method": false}, {"name": "_set_defaults", "qualified_name": "_set_defaults", "args": ["self"], "decorators": [], "docstring": "Reset logger to its initial state", "start_line": 457, "end_line": 513, "is_async": false, "is_method": false}, {"name": "emit", "qualified_name": "emit", "args": ["self", "record"], "decorators": [], "docstring": "The formatter for stderr", "start_line": 523, "end_line": 547, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "origin"], "decorators": [], "docstring": "", "start_line": 553, "end_line": 554, "is_async": false, "is_method": false}, {"name": "filter", "qualified_name": "filter", "args": ["self", "record"], "decorators": [], "docstring": "", "start_line": 556, "end_line": 557, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "filter_level", "filter_origin"], "decorators": [], "docstring": "", "start_line": 563, "end_line": 565, "is_async": false, "is_method": false}, {"name": "emit", "qualified_name": "emit", "args": ["self", "record"], "decorators": [], "docstring": "", "start_line": 567, "end_line": 568, "is_async": false, "is_method": false}, {"name": "ipy_exc_handler", "qualified_name": "ipy_exc_handler", "args": ["ipyshell", "etype", "evalue", "tb", "tb_offset"], "decorators": [], "docstring": "", "start_line": 309, "end_line": 314, "is_async": false, "is_method": false}], "classes": [{"name": "LoggingError", "bases": ["Exception"], "methods": [], "docstring": "This exception is for various errors that occur in the astropy logger,\ntypically when activating or deactivating logger-related features.", "start_line": 31, "end_line": 35}, {"name": "_AstLogIPYExc", "bases": ["Exception"], "methods": [], "docstring": "An exception that is used only as a placeholder to indicate to the\nIPython exception-catching mechanism that the astropy\nexception-capturing is activated. It should not actually be used as\nan exception anywhere.", "start_line": 38, "end_line": 44}, {"name": "Conf", "bases": ["_config.ConfigNamespace"], "methods": [], "docstring": "Configuration parameters for `astropy.logger`.", "start_line": 47, "end_line": 80}, {"name": "AstropyLogger", "bases": ["Logger"], "methods": ["makeRecord", "_showwarning", "warnings_logging_enabled", "enable_warnings_logging", "disable_warnings_logging", "_excepthook", "exception_logging_enabled", "enable_exception_logging", "disable_exception_logging", "enable_color", "disable_color", "log_to_file", "log_to_list", "_set_defaults"], "docstring": "This class is used to set up the Astropy logging.\n\nThe main functionality added by this class over the built-in\nlogging.Logger class is the ability to keep track of the origin of the\nmessages, the ability to enable logging of warnings.warn calls and\nexceptions, and the addition of colorized output a", "start_line": 139, "end_line": 513}, {"name": "StreamHandler", "bases": ["logging.StreamHandler"], "methods": ["emit"], "docstring": "A specialized StreamHandler that logs INFO and DEBUG messages to\nstdout, and all other messages to stderr.  Also provides coloring\nof the output, if enabled in the parent logger.", "start_line": 516, "end_line": 547}, {"name": "FilterOrigin", "bases": [], "methods": ["__init__", "filter"], "docstring": "A filter for the record origin", "start_line": 550, "end_line": 557}, {"name": "ListHandler", "bases": ["logging.Handler"], "methods": ["__init__", "emit"], "docstring": "A handler that can be used to capture the records in a list", "start_line": 560, "end_line": 568}], "calls": [], "module_docstring": "This module defines a logging class based on the built-in logging module", "parse_error": ""}, {"file_path": "docs/wcs/examples/programmatic.py", "file_hash": "5caa8a62e3f3333c666adac05d0abd668d7da339185cc6bfff37abbad0fac9e0", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy", "names": ["wcs"], "is_from": true, "alias": ""}, {"module": "astropy.io", "names": ["fits"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "docs/wcs/examples/from_file.py", "file_hash": "ea613b38b76cd957ab95f3cf0577c910ebc954ce650cced8c77b68b81de175d5", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy", "names": ["wcs"], "is_from": true, "alias": ""}, {"module": "astropy.io", "names": ["fits"], "is_from": true, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "load_wcs_from_file", "qualified_name": "load_wcs_from_file", "args": ["filename"], "decorators": [], "docstring": "", "start_line": 9, "end_line": 38, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "examples/template/example-template.py", "file_hash": "b58a788365928d3a739f9df60cedc17eb8a48fe9e634dd89dd796c14cc3c09d0", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "matplotlib.pyplot", "names": [], "is_from": false, "alias": "plt"}, {"module": "astropy.visualization", "names": ["astropy_mpl_style"], "is_from": true, "alias": ""}], "functions": [{"name": "dummy", "qualified_name": "dummy", "args": [], "decorators": [], "docstring": "Dummy function to make sure docstrings don't get rendered as text", "start_line": 81, "end_line": 83, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "========================\nTitle of Example\n========================\n\nThis example <verb> <active tense> <does something>.\n\nThe example uses <packages> to <do something> and <other package> to <do other\nthing>. Include links to referenced packages like this: `astropy.io.fits` to\nshow the astropy.io.fits or like this `~astropy.io.fits`to show just 'fits'\n\n-------------------\n\n*By: <names>*\n\n*License: BSD*\n\n-------------------", "parse_error": ""}, {"file_path": "examples/coordinates/plot_sgr-coordinate-frame.py", "file_hash": "d9f332bf55abee762b182ceac1bb11e3c82cea9c833521d0be52d43c888650ca", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "matplotlib.pyplot", "names": [], "is_from": false, "alias": "plt"}, {"module": "astropy.visualization", "names": ["astropy_mpl_style"], "is_from": true, "alias": ""}, {"module": "astropy.coordinates", "names": ["frame_transform_graph"], "is_from": true, "alias": ""}, {"module": "astropy.coordinates.matrix_utilities", "names": ["rotation_matrix", "matrix_product", "matrix_transpose"], "is_from": true, "alias": ""}, {"module": "astropy.coordinates", "names": [], "is_from": false, "alias": "coord"}, {"module": "astropy.units", "names": [], "is_from": false, "alias": "u"}], "functions": [{"name": "galactic_to_sgr", "qualified_name": "galactic_to_sgr", "args": [], "decorators": ["frame_transform_graph.transform(coord.StaticMatrixTransform, coord.Galactic, Sagittarius)"], "docstring": "Compute the transformation matrix from Galactic spherical to\nheliocentric Sgr coordinates.", "start_line": 156, "end_line": 160, "is_async": false, "is_method": false}, {"name": "sgr_to_galactic", "qualified_name": "sgr_to_galactic", "args": [], "decorators": ["frame_transform_graph.transform(coord.StaticMatrixTransform, Sagittarius, coord.Galactic)"], "docstring": "Compute the transformation matrix from heliocentric Sgr coordinates to\nspherical Galactic.", "start_line": 172, "end_line": 176, "is_async": false, "is_method": false}], "classes": [{"name": "Sagittarius", "bases": ["coord.BaseCoordinateFrame"], "methods": [], "docstring": "A Heliocentric spherical coordinate system defined by the orbit\nof the Sagittarius dwarf galaxy, as described in\n    http://adsabs.harvard.edu/abs/2003ApJ...599.1082M\nand further explained in\n    http://www.stsci.edu/~dlaw/Sgr/.\n\nParameters\n----------\nrepresentation : `BaseRepresentation` or None\n  ", "start_line": 66, "end_line": 117}], "calls": [], "module_docstring": "==========================================================\nCreate a new coordinate class (for the Sagittarius stream)\n==========================================================\n\nThis document describes in detail how to subclass and define a custom spherical\ncoordinate frame, as discussed in :ref:`astropy-coordinates-design` and the\ndocstring for `~astropy.coordinates.BaseCoordinateFrame`. In this example, we\nwill define a coordinate system defined by the plane of orbit of the Sagittarius\nDwarf Galaxy (hereafter Sgr; as defined in Majewski et al. 2003).  The Sgr\ncoordinate system is often referred to in terms of two angular coordinates,\n:math:`\\Lambda,B`.\n\nTo do this, wee need to define a subclass of\n`~astropy.coordinates.BaseCoordinateFrame` that knows the names and units of the\ncoordinate system angles in each of the supported representations.  In this case\nwe support `~astropy.coordinates.SphericalRepresentation` with \"Lambda\" and\n\"Beta\". Then we have to define the transformation from this coordinate system to\nsome other built-in system. Here we will use Galactic coordinates, represented\nby the `~astropy.coordinates.Galactic` class.\n\nSee Also\n--------\n\n* Majewski et al. 2003, \"A Two Micron All Sky Survey View of the Sagittarius\n  Dwarf Galaxy. I. Morphology of the Sagittarius Core and Tidal Arms\",\n  https://arxiv.org/abs/astro-ph/0304198\n* Law & Majewski 2010, \"The Sagittarius Dwarf Galaxy: A Model for Evolution in a\n  Triaxial Milky Way Halo\", https://arxiv.org/abs/1003.1132\n* David Law's Sgr info page http://www.stsci.edu/~dlaw/Sgr/\n\n-------------------\n\n*By: Adrian Price-Whelan, Erik Tollerud*\n\n*License: BSD*\n\n-------------------", "parse_error": ""}, {"file_path": "examples/coordinates/plot_obs-planning.py", "file_hash": "acf72c7d45b714149a27d722fc07da683b5f9d96dc19f47977057d7d25427204", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "matplotlib.pyplot", "names": [], "is_from": false, "alias": "plt"}, {"module": "astropy.visualization", "names": ["astropy_mpl_style"], "is_from": true, "alias": ""}, {"module": "astropy.units", "names": [], "is_from": false, "alias": "u"}, {"module": "astropy.time", "names": ["Time"], "is_from": true, "alias": ""}, {"module": "astropy.coordinates", "names": ["SkyCoord", "EarthLocation", "AltAz"], "is_from": true, "alias": ""}, {"module": "astropy.coordinates", "names": ["get_sun"], "is_from": true, "alias": ""}, {"module": "astropy.coordinates", "names": ["get_moon"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "===================================================================\nDetermining and plotting the altitude/azimuth of a celestial object\n===================================================================\n\nThis example demonstrates coordinate transformations and the creation of\nvisibility curves to assist with observing run planning.\n\nIn this example, we make a `~astropy.coordinates.SkyCoord` instance for M33.\nThe altitude-azimuth coordinates are then found using\n`astropy.coordinates.EarthLocation` and `astropy.time.Time` objects.\n\nThis example is meant to demonstrate the capabilities of the\n`astropy.coordinates` package. For more convenient and/or complex observation\nplanning, consider the `astroplan <https://astroplan.readthedocs.org/>`_\npackage.\n\n-------------------\n\n*By: Erik Tollerud, Kelle Cruz*\n\n*License: BSD*\n\n-------------------", "parse_error": ""}, {"file_path": "examples/coordinates/rv-to-gsr.py", "file_hash": "5e10cacac7b3876e1564e6a3008f5448ab228d0e8c1cfa21e89a276700ff877f", "imports": [{"module": "astropy.units", "names": [], "is_from": false, "alias": "u"}, {"module": "astropy.coordinates", "names": [], "is_from": false, "alias": "coord"}], "functions": [{"name": "rv_to_gsr", "qualified_name": "rv_to_gsr", "args": ["c", "v_sun"], "decorators": [], "docstring": "Transform a barycentric radial velocity to the Galactic Standard of Rest\n(GSR).\n\nThe input radial velocity must be passed in as a\n\nParameters\n----------\nc : `~astropy.coordinates.BaseCoordinateFrame` subclass instance\n    The radial velocity, associated with a sky coordinates, to be\n    transformed.", "start_line": 70, "end_line": 101, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "================================================================\nConvert a radial velocity to the Galactic Standard of Rest (GSR)\n================================================================\n\nRadial or line-of-sight velocities of sources are often reported in a\nHeliocentric or Solar-system barycentric reference frame. A common\ntransformation incorporates the projection of the Sun's motion along the\nline-of-sight to the target, hence transforming it to a Galactic rest frame\ninstead (sometimes referred to as the Galactic Standard of Rest, GSR). This\ntransformation depends on the assumptions about the orientation of the Galactic\nframe relative to the bary- or Heliocentric frame. It also depends on the\nassumed solar velocity vector. Here we'll demonstrate how to perform this\ntransformation using a sky position and barycentric radial-velocity.\n\n-------------------\n\n*By: Adrian Price-Whelan*\n\n*License: BSD*\n\n-------------------", "parse_error": ""}, {"file_path": "examples/coordinates/plot_galactocentric-frame.py", "file_hash": "4cc48754070010c8109d4cd80648a363617a4e1103a29743e3e6c6cb23ad12f6", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "matplotlib.pyplot", "names": [], "is_from": false, "alias": "plt"}, {"module": "astropy.visualization", "names": ["astropy_mpl_style"], "is_from": true, "alias": ""}, {"module": "astropy.coordinates", "names": [], "is_from": false, "alias": "coord"}, {"module": "astropy.units", "names": [], "is_from": false, "alias": "u"}], "functions": [], "classes": [], "calls": [], "module_docstring": "========================================================================\nTransforming positions and velocities to and from a Galactocentric frame\n========================================================================\n\nThis document shows a few examples of how to use and customize the\n`~astropy.coordinates.Galactocentric` frame to transform Heliocentric sky\npositions, distance, proper motions, and radial velocities to a Galactocentric,\nCartesian frame, and the same in reverse.\n\nThe main configurable parameters of the `~astropy.coordinates.Galactocentric`\nframe control the position and velocity of the solar system barycenter within\nthe Galaxy. These are specified by setting the ICRS coordinates of the\nGalactic center, the distance to the Galactic center (the sun-galactic center\nline is always assumed to be the x-axis of the Galactocentric frame), and the\nCartesian 3-velocity of the sun in the Galactocentric frame. We'll first\ndemonstrate how to customize these values, then show how to set the solar motion\ninstead by inputting the proper motion of Sgr A*.\n\nNote that, for brevity, we may refer to the solar system barycenter as just \"the\nsun\" in the examples below.\n\n-------------------\n\n*By: Adrian Price-Whelan*\n\n*License: BSD*\n\n-------------------", "parse_error": ""}, {"file_path": "examples/io/skip_create-large-fits.py", "file_hash": "ee95409a1acf713ff32ea85cf3b7ee4c223479577cb7383eca499271b8a2b63f", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": ""}, {"module": "astropy.io", "names": ["fits"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "==========================================\nCreate a very large FITS file from scratch\n==========================================\n\nThis example demonstrates how to create a large file (larger than will fit in\nmemory) from scratch using `astropy.io.fits`.\n\n-------------------\n\n*By: Erik Bray*\n\n*License: BSD*\n\n-------------------", "parse_error": ""}, {"file_path": "examples/io/fits-tables.py", "file_hash": "ea7456f9855eb9c4935d4065e10d34eb3a42f04ad2ed54e266c5ab12450c8714", "imports": [{"module": "astropy.utils.data", "names": ["get_pkg_data_filename"], "is_from": true, "alias": ""}, {"module": "astropy.table", "names": ["Table"], "is_from": true, "alias": ""}, {"module": "astropy.io", "names": ["fits"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "=====================================================================\nAccessing data stored as a table in a multi-extension FITS (MEF) file\n=====================================================================\n\nFITS files can often contain large amount of multi-dimensional data and\ntables. This example opens a FITS file with information\nfrom Chandra's HETG-S instrument.\n\nThe example uses `astropy.utils.data` to download multi-extension FITS (MEF)\nfile, `astropy.io.fits` to investigate the header, and\n`astropy.table.Table` to explore the data.\n\n-------------------\n\n*By: Lia Corrales, Adrian Price-Whelan, and Kelle Cruz*\n\n*License: BSD*\n\n-------------------", "parse_error": ""}, {"file_path": "examples/io/split-jpeg-to-fits.py", "file_hash": "34d826133a5a8acd7d52504aaf8b66c5d8e2b62438758251e4314e6c10f1995d", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "PIL", "names": ["Image"], "is_from": true, "alias": ""}, {"module": "astropy.io", "names": ["fits"], "is_from": true, "alias": ""}, {"module": "matplotlib.pyplot", "names": [], "is_from": false, "alias": "plt"}, {"module": "astropy.visualization", "names": ["astropy_mpl_style"], "is_from": true, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "=====================================================\nConvert a 3-color image (JPG) to separate FITS images\n=====================================================\n\nThis example opens an RGB JPEG image and writes out each channel as a separate\nFITS (image) file.\n\nThis example uses `pillow <http://python-pillow.org>`_ to read the image,\n`matplotlib.pyplot` to display the image, and `astropy.io.fits` to save FITS files.\n\n-------------------\n\n*By: Erik Bray, Adrian Price-Whelan*\n\n*License: BSD*\n\n-------------------", "parse_error": ""}, {"file_path": "examples/io/modify-fits-header.py", "file_hash": "6d5e36720c0cc9f7e44ed1440757538afabbe214ccafe1d09047e6ffebb75a3b", "imports": [{"module": "astropy.io", "names": ["fits"], "is_from": true, "alias": ""}, {"module": "astropy.utils.data", "names": ["get_pkg_data_filename"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "==================\nEdit a FITS header\n==================\n\nThis example describes how to edit a value in a FITS header\nusing `astropy.io.fits`.\n\n-------------------\n\n*By: Adrian Price-Whelan*\n\n*License: BSD*\n\n-------------------", "parse_error": ""}, {"file_path": "examples/io/plot_fits-image.py", "file_hash": "fd7e56aed30b48c9be3e1c7d95eb537af8983306b2119be09b348a916e3068c3", "imports": [{"module": "matplotlib.pyplot", "names": [], "is_from": false, "alias": "plt"}, {"module": "astropy.visualization", "names": ["astropy_mpl_style"], "is_from": true, "alias": ""}, {"module": "astropy.utils.data", "names": ["get_pkg_data_filename"], "is_from": true, "alias": ""}, {"module": "astropy.io", "names": ["fits"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "=======================================\nRead and plot an image from a FITS file\n=======================================\n\nThis example opens an image stored in a FITS file and displays it to the screen.\n\nThis example uses `astropy.utils.data` to download the file, `astropy.io.fits` to open\nthe file, and `matplotlib.pyplot` to display the image.\n\n-------------------\n\n*By: Lia R. Corrales, Adrian Price-Whelan, Kelle Cruz*\n\n*License: BSD*\n\n-------------------", "parse_error": ""}, {"file_path": "examples/io/create-mef.py", "file_hash": "f02043221ece54730f468542cac47fbe467917e71c50da1c69c6667d82c7b190", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "astropy.io", "names": ["fits"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "=====================================================\nCreate a multi-extension FITS (MEF) file from scratch\n=====================================================\n\nThis example demonstrates how to create a multi-extension FITS (MEF)\nfile from scratch using `astropy.io.fits`.\n\n-------------------\n\n*By: Erik Bray*\n\n*License: BSD*\n\n-------------------", "parse_error": ""}, {"file_path": "astropy/constants/codata2010.py", "file_hash": "a98708e9b40932300529e6ff8b9ce0bbf6df894ddc9c3d9ffdeacbe62a3c7152", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "constant", "names": ["Constant", "EMConstant"], "is_from": true, "alias": ""}], "functions": [{"name": "__new__", "qualified_name": "__new__", "args": ["cls", "abbrev", "name", "value", "unit", "uncertainty", "reference", "system"], "decorators": [], "docstring": "", "start_line": 19, "end_line": 22, "is_async": false, "is_method": false}], "classes": [{"name": "CODATA2010", "bases": ["Constant"], "methods": ["__new__"], "docstring": "", "start_line": 14, "end_line": 22}, {"name": "EMCODATA2010", "bases": ["CODATA2010", "EMConstant"], "methods": [], "docstring": "", "start_line": 25, "end_line": 26}], "calls": [], "module_docstring": "Astronomical and physics constants in SI units.  See :mod:`astropy.constants`\nfor a complete listing of constants defined in Astropy.", "parse_error": ""}, {"file_path": "astropy/constants/__init__.py", "file_hash": "b22c43e1b33837f3c3f3b3522ab36b14f4f694e39e4cd23951d87d945c906515", "imports": [{"module": "itertools", "names": [], "is_from": false, "alias": ""}, {"module": "constant", "names": ["Constant", "EMConstant"], "is_from": true, "alias": ""}, {"module": "", "names": ["si"], "is_from": true, "alias": ""}, {"module": "", "names": ["cgs"], "is_from": true, "alias": ""}, {"module": "", "names": ["codata2014", "iau2015"], "is_from": true, "alias": ""}, {"module": "", "names": ["units"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "Contains astronomical and physical constants for use in Astropy or other\nplaces.\n\nA typical use case might be::\n\n    >>> from astropy.constants import c, m_e\n    >>> # ... define the mass of something you want the rest energy of as m ...\n    >>> m = m_e\n    >>> E = m * c**2\n    >>> E.to('MeV')  # doctest: +FLOAT_CMP\n    <Quantity 0.510998927603161 MeV>", "parse_error": ""}, {"file_path": "astropy/constants/astropyconst13.py", "file_hash": "4006c34a2f21f2c415cc03417e5385f892330b8534d5d428888630557a5e6a38", "imports": [{"module": "itertools", "names": [], "is_from": false, "alias": ""}, {"module": "constant", "names": ["Constant"], "is_from": true, "alias": ""}, {"module": "", "names": ["codata2010", "iau2012"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "Astronomical and physics constants for Astropy v1.3 and earlier.\nSee :mod:`astropy.constants` for a complete listing of constants\ndefined in Astropy.", "parse_error": ""}, {"file_path": "astropy/constants/constant.py", "file_hash": "fbeda3e7dfbc977ade53fd2fb43d3f9bcbb3543e01aa09bbcd2288fca59c2292", "imports": [{"module": "functools", "names": [], "is_from": false, "alias": ""}, {"module": "types", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "units.core", "names": ["Unit", "UnitsError"], "is_from": true, "alias": ""}, {"module": "units.quantity", "names": ["Quantity"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["lazyproperty"], "is_from": true, "alias": ""}, {"module": "utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}, {"module": "utils.misc", "names": ["InheritDocstrings"], "is_from": true, "alias": ""}], "functions": [{"name": "__new__", "qualified_name": "__new__", "args": ["mcls", "name", "bases", "d"], "decorators": [], "docstring": "", "start_line": 33, "end_line": 73, "is_async": false, "is_method": false}, {"name": "__new__", "qualified_name": "__new__", "args": ["cls", "abbrev", "name", "value", "unit", "uncertainty", "reference", "system"], "decorators": [], "docstring": "", "start_line": 85, "end_line": 118, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 120, "end_line": 124, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 126, "end_line": 133, "is_async": false, "is_method": false}, {"name": "__quantity_subclass__", "qualified_name": "__quantity_subclass__", "args": ["self", "unit"], "decorators": [], "docstring": "", "start_line": 135, "end_line": 136, "is_async": false, "is_method": false}, {"name": "copy", "qualified_name": "copy", "args": ["self"], "decorators": [], "docstring": "Return a copy of this `Constant` instance.  Since they are by\ndefinition immutable, this merely returns another reference to\n``self``.", "start_line": 138, "end_line": 144, "is_async": false, "is_method": false}, {"name": "abbrev", "qualified_name": "abbrev", "args": ["self"], "decorators": ["property"], "docstring": "A typical ASCII text abbreviation of the constant, also generally\nthe same as the Python variable used for this constant.", "start_line": 148, "end_line": 153, "is_async": false, "is_method": false}, {"name": "name", "qualified_name": "name", "args": ["self"], "decorators": ["property"], "docstring": "The full name of the constant.", "start_line": 156, "end_line": 159, "is_async": false, "is_method": false}, {"name": "_unit", "qualified_name": "_unit", "args": ["self"], "decorators": ["lazyproperty"], "docstring": "The unit(s) in which this constant is defined.", "start_line": 162, "end_line": 165, "is_async": false, "is_method": false}, {"name": "uncertainty", "qualified_name": "uncertainty", "args": ["self"], "decorators": ["property"], "docstring": "The known uncertainty in this constant's value.", "start_line": 168, "end_line": 171, "is_async": false, "is_method": false}, {"name": "reference", "qualified_name": "reference", "args": ["self"], "decorators": ["property"], "docstring": "The source used for the value of this constant.", "start_line": 174, "end_line": 177, "is_async": false, "is_method": false}, {"name": "system", "qualified_name": "system", "args": ["self"], "decorators": ["property"], "docstring": "The system of units in which this constant is defined (typically\n`None` so long as the constant's units can be directly converted\nbetween systems).", "start_line": 180, "end_line": 186, "is_async": false, "is_method": false}, {"name": "_instance_or_super", "qualified_name": "_instance_or_super", "args": ["self", "key"], "decorators": [], "docstring": "", "start_line": 188, "end_line": 194, "is_async": false, "is_method": false}, {"name": "si", "qualified_name": "si", "args": ["self"], "decorators": ["property"], "docstring": "If the Constant is defined in the SI system return that instance of\nthe constant, else convert to a Quantity in the appropriate SI units.", "start_line": 197, "end_line": 202, "is_async": false, "is_method": false}, {"name": "cgs", "qualified_name": "cgs", "args": ["self"], "decorators": ["property"], "docstring": "If the Constant is defined in the CGS system return that instance of\nthe constant, else convert to a Quantity in the appropriate CGS units.", "start_line": 205, "end_line": 210, "is_async": false, "is_method": false}, {"name": "__array_finalize__", "qualified_name": "__array_finalize__", "args": ["self", "obj"], "decorators": [], "docstring": "", "start_line": 212, "end_line": 217, "is_async": false, "is_method": false}, {"name": "cgs", "qualified_name": "cgs", "args": ["self"], "decorators": ["property"], "docstring": "Overridden for EMConstant to raise a `TypeError`\nemphasizing that there are multiple EM extensions to CGS.", "start_line": 224, "end_line": 233, "is_async": false, "is_method": false}, {"name": "wrap", "qualified_name": "wrap", "args": ["meth"], "decorators": [], "docstring": "", "start_line": 34, "end_line": 59, "is_async": false, "is_method": false}, {"name": "wrapper", "qualified_name": "wrapper", "args": ["self"], "decorators": ["functools.wraps(meth)"], "docstring": "", "start_line": 36, "end_line": 57, "is_async": false, "is_method": false}], "classes": [{"name": "ConstantMeta", "bases": ["InheritDocstrings"], "methods": ["__new__"], "docstring": "Metaclass for the :class:`Constant`. The primary purpose of this is to\nwrap the double-underscore methods of :class:`Quantity` which is the\nsuperclass of :class:`Constant`.\n\nIn particular this wraps the operator overloads such as `__add__` to\nprevent their use with constants such as ``e`` from being", "start_line": 17, "end_line": 73}, {"name": "Constant", "bases": ["Quantity"], "methods": ["__new__", "__repr__", "__str__", "__quantity_subclass__", "copy", "abbrev", "name", "_unit", "uncertainty", "reference", "system", "_instance_or_super", "si", "cgs", "__array_finalize__"], "docstring": "A physical or astronomical constant.\n\nThese objects are quantities that are meant to represent physical\nconstants.", "start_line": 