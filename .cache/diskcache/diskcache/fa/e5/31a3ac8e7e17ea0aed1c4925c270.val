ors": [], "docstring": "", "start_line": 257, "end_line": 327, "is_async": false, "is_method": false}, {"name": "format_epilog", "qualified_name": "format_epilog", "args": ["self", "epilog"], "decorators": [], "docstring": "", "start_line": 64, "end_line": 65, "is_async": false, "is_method": false}, {"name": "store_list", "qualified_name": "store_list", "args": ["option", "opt", "value", "parser"], "decorators": [], "docstring": "", "start_line": 70, "end_line": 88, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "name", "level"], "decorators": [], "docstring": "", "start_line": 208, "end_line": 210, "is_async": false, "is_method": false}, {"name": "filter", "qualified_name": "filter", "args": ["self", "rec"], "decorators": [], "docstring": "", "start_line": 212, "end_line": 213, "is_async": false, "is_method": false}], "classes": [{"name": "HelpFormatter", "bases": ["optparse.TitledHelpFormatter"], "methods": ["format_epilog"], "docstring": "", "start_line": 63, "end_line": 65}, {"name": "LevelFilter", "bases": ["logging.Filter"], "methods": ["__init__", "filter"], "docstring": "Log only messages matching the specified level.", "start_line": 205, "end_line": 213}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/io/fits/scripts/__init__.py", "file_hash": "391f7442fd8d316ddf767e0a720f5ce4d929a4faef171b2af2f08f83e8305b47", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "This subpackage contains implementations of command-line scripts that are\nincluded with Astropy.\n\nThe actual scripts that are installed in bin/ are simple wrappers for these\nmodules that will run in any Python version.", "parse_error": ""}, {"file_path": "astropy/io/fits/scripts/fitsinfo.py", "file_hash": "2a982a68d7d1406ebb4ca714a5f5f88947b093e32666199bc02d0ca75be7d281", "imports": [{"module": "argparse", "names": [], "is_from": false, "alias": ""}, {"module": "astropy.io.fits", "names": [], "is_from": false, "alias": "fits"}, {"module": "astropy", "names": ["log"], "is_from": true, "alias": ""}], "functions": [{"name": "fitsinfo", "qualified_name": "fitsinfo", "args": ["filename"], "decorators": [], "docstring": "Print a summary of the HDUs in a FITS file.\n\nParameters\n----------\nfilename : str\n    The path to a FITS file.", "start_line": 31, "end_line": 45, "is_async": false, "is_method": false}, {"name": "main", "qualified_name": "main", "args": ["args"], "decorators": [], "docstring": "The main function called by the `fitsinfo` script.", "start_line": 48, "end_line": 60, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "``fitsinfo`` is a command-line script based on astropy.io.fits for\nprinting a summary of the HDUs in one or more FITS files(s) to the\nstandard output.\n\nExample usage of ``fitsinfo``:\n\n1. Print a summary of the HDUs in a FITS file::\n\n    $ fitsinfo filename.fits\n\n    Filename: filename.fits\n    No.    Name         Type      Cards   Dimensions   Format\n    0    PRIMARY     PrimaryHDU     138   ()\n    1    SCI         ImageHDU        61   (800, 800)   int16\n    2    SCI         ImageHDU        61   (800, 800)   int16\n    3    SCI         ImageHDU        61   (800, 800)   int16\n    4    SCI         ImageHDU        61   (800, 800)   int16\n\n2. Print a summary of HDUs of all the FITS files in the current directory::\n\n    $ fitsinfo *.fits", "parse_error": ""}, {"file_path": "astropy/io/fits/scripts/fitscheck.py", "file_hash": "7e5d474b36ec63d34f2df7ed7e77d71286fedfa9a723a283d41b8105a8ca713f", "imports": [{"module": "logging", "names": [], "is_from": false, "alias": ""}, {"module": "optparse", "names": [], "is_from": false, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "textwrap", "names": [], "is_from": false, "alias": ""}, {"module": "tests.helper", "names": ["catch_warnings"], "is_from": true, "alias": ""}, {"module": "", "names": ["fits"], "is_from": true, "alias": ""}], "functions": [{"name": "handle_options", "qualified_name": "handle_options", "args": ["args"], "decorators": [], "docstring": "", "start_line": 56, "end_line": 109, "is_async": false, "is_method": false}, {"name": "setup_logging", "qualified_name": "setup_logging", "args": [], "decorators": [], "docstring": "", "start_line": 112, "end_line": 120, "is_async": false, "is_method": false}, {"name": "verify_checksums", "qualified_name": "verify_checksums", "args": ["filename"], "decorators": [], "docstring": "Prints a message if any HDU in `filename` has a bad checksum or datasum.", "start_line": 123, "end_line": 150, "is_async": false, "is_method": false}, {"name": "verify_compliance", "qualified_name": "verify_compliance", "args": ["filename"], "decorators": [], "docstring": "Check for FITS standard compliance.", "start_line": 153, "end_line": 163, "is_async": false, "is_method": false}, {"name": "update", "qualified_name": "update", "args": ["filename"], "decorators": [], "docstring": "Sets the ``CHECKSUM`` and ``DATASUM`` keywords for each HDU of `filename`.\n\nAlso updates fixes standards violations if possible and requested.", "start_line": 166, "end_line": 176, "is_async": false, "is_method": false}, {"name": "process_file", "qualified_name": "process_file", "args": ["filename"], "decorators": [], "docstring": "Handle a single .fits file,  returning the count of checksum and compliance\nerrors.", "start_line": 179, "end_line": 196, "is_async": false, "is_method": false}, {"name": "main", "qualified_name": "main", "args": ["args"], "decorators": [], "docstring": "Processes command line parameters into options and files,  then checks\nor update FITS DATASUM and CHECKSUM keywords for the specified files.", "start_line": 199, "end_line": 212, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "``fitscheck`` is a command line script based on astropy.io.fits for verifying\nand updating the CHECKSUM and DATASUM keywords of .fits files.  ``fitscheck``\ncan also detect and often fix other FITS standards violations.  ``fitscheck``\nfacilitates re-writing the non-standard checksums originally generated by\nastropy.io.fits with standard checksums which will interoperate with CFITSIO.\n\n``fitscheck`` will refuse to write new checksums if the checksum keywords are\nmissing or their values are bad.  Use ``--force`` to write new checksums\nregardless of whether or not they currently exist or pass.  Use\n``--ignore-missing`` to tolerate missing checksum keywords without comment.\n\nExample uses of fitscheck:\n\n1. Add checksums::\n\n    $ fitscheck --write *.fits\n\n2. Write new checksums, even if existing checksums are bad or missing::\n\n    $ fitscheck --write --force *.fits\n\n3. Verify standard checksums and FITS compliance without changing the files::\n\n    $ fitscheck --compliance *.fits\n\n4. Only check and fix compliance problems,  ignoring checksums::\n\n    $ fitscheck --checksum none --compliance --write *.fits\n\n5. Verify standard interoperable checksums::\n\n    $ fitscheck *.fits\n\n6. Delete checksum keywords::\n\n    $ fitscheck --checksum remove --write *.fits", "parse_error": ""}, {"file_path": "astropy/io/fits/scripts/fitsheader.py", "file_hash": "0483fc3144978bb0c128368212a642fead91345185a69ed20e5fdb90cb8e5dfe", "imports": [{"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "", "names": ["fits"], "is_from": true, "alias": ""}, {"module": "", "names": ["log"], "is_from": true, "alias": ""}, {"module": "argparse", "names": [], "is_from": false, "alias": ""}, {"module": "", "names": ["table"], "is_from": true, "alias": ""}, {"module": "", "names": ["table"], "is_from": true, "alias": ""}], "functions": [{"name": "print_headers_traditional", "qualified_name": "print_headers_traditional", "args": ["args"], "decorators": [], "docstring": "Prints FITS header(s) using the traditional 80-char format.\n\nParameters\n----------\nargs : argparse.Namespace\n    Arguments passed from the command-line as defined below.", "start_line": 226, "end_line": 243, "is_async": false, "is_method": false}, {"name": "print_headers_as_table", "qualified_name": "print_headers_as_table", "args": ["args"], "decorators": [], "docstring": "Prints FITS header(s) in a machine-readable table format.\n\nParameters\n----------\nargs : argparse.Namespace\n    Arguments passed from the command-line as defined below.", "start_line": 246, "end_line": 275, "is_async": false, "is_method": false}, {"name": "main", "qualified_name": "main", "args": ["args"], "decorators": [], "docstring": "This is the main function called by the `fitsheader` script.", "start_line": 278, "end_line": 327, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "filename"], "decorators": [], "docstring": "", "start_line": 75, "end_line": 77, "is_async": false, "is_method": false}, {"name": "parse", "qualified_name": "parse", "args": ["self", "extensions", "keywords", "compressed"], "decorators": [], "docstring": "Returns the FITS file header(s) in a readable format.\n\nParameters\n----------\nextensions : list of int or str, optional\n    Format only specific HDU(s), identified by number or name.\n    The name can be composed of the \"EXTNAME\" or \"EXTNAME,EXTVER\"\n    keywords.\n\nkeywords : list of str, optional\n    ", "start_line": 79, "end_line": 124, "is_async": false, "is_method": false}, {"name": "_parse_internal", "qualified_name": "_parse_internal", "args": ["self", "hdukeys", "keywords", "compressed"], "decorators": [], "docstring": "The meat of the formatting; in a separate method to allow overriding.\n        ", "start_line": 126, "end_line": 141, "is_async": false, "is_method": false}, {"name": "_get_cards", "qualified_name": "_get_cards", "args": ["self", "hdukey", "keywords", "compressed"], "decorators": [], "docstring": "Returns a list of `astropy.io.fits.card.Card` objects.\n\nThis function will return the desired header cards, taking into\naccount the user's preference to see the compressed or uncompressed\nversion.\n\nParameters\n----------\nhdukey : int or str\n    Key of a single HDU in the HDUList.\n\nkeywords : list of ", "start_line": 143, "end_line": 197, "is_async": false, "is_method": false}, {"name": "_parse_internal", "qualified_name": "_parse_internal", "args": ["self", "hdukeys", "keywords", "compressed"], "decorators": [], "docstring": "Method called by the parse method in the parent class.", "start_line": 207, "end_line": 223, "is_async": false, "is_method": false}], "classes": [{"name": "ExtensionNotFoundException", "bases": ["Exception"], "methods": [], "docstring": "Raised if an HDU extension requested by the user does not exist.", "start_line": 52, "end_line": 54}, {"name": "HeaderFormatter", "bases": [], "methods": ["__init__", "parse", "_parse_internal", "_get_cards"], "docstring": "Class to format the header(s) of a FITS file for display by the\n`fitsheader` tool; essentially a wrapper around a `HDUList` object.\n\nExample usage:\nfmt = HeaderFormatter('/path/to/file.fits')\nprint(fmt.parse(extensions=[0, 3], keywords=['NAXIS', 'BITPIX']))\n\nParameters\n----------\nfilename : str\n    ", "start_line": 57, "end_line": 197}, {"name": "TableHeaderFormatter", "bases": ["HeaderFormatter"], "methods": ["_parse_internal"], "docstring": "Class to convert the header(s) of a FITS file into a Table object.\nThe table returned by the `parse` method will contain four columns:\nfilename, hdu, keyword, and value.\n\nSubclassed from HeaderFormatter, which contains the meat of the formatting.", "start_line": 200, "end_line": 223}], "calls": [], "module_docstring": "``fitsheader`` is a command line script based on astropy.io.fits for printing\nthe header(s) of one or more FITS file(s) to the standard output in a human-\nreadable format.\n\nExample uses of fitsheader:\n\n1. Print the header of all the HDUs of a .fits file::\n\n    $ fitsheader filename.fits\n\n2. Print the header of the third and fifth HDU extension::\n\n    $ fitsheader --extension 3 --extension 5 filename.fits\n\n3. Print the header of a named extension, e.g. select the HDU containing\n   keywords EXTNAME='SCI' and EXTVER='2'::\n\n    $ fitsheader --extension \"SCI,2\" filename.fits\n\n4. Print only specific keywords::\n\n    $ fitsheader --keyword BITPIX --keyword NAXIS filename.fits\n\n5. Print keywords NAXIS, NAXIS1, NAXIS2, etc using a wildcard::\n\n    $ fitsheader --keyword NAXIS* filename.fits\n\n6. Dump the header keywords of all the files in the current directory into a\n   machine-readable csv file::\n\n    $ fitsheader --table ascii.csv *.fits > keywords.csv\n\nNote that compressed images (HDUs of type\n:class:`~astropy.io.fits.CompImageHDU`) really have two headers: a real\nBINTABLE header to describe the compressed data, and a fake IMAGE header\nrepresenting the image that was compressed. Astropy returns the latter by\ndefault. You must supply the ``--compressed`` option if you require the real\nheader that describes the compression.\n\nWith Astropy installed, please run ``fitsheader --help`` to see the full usage\ndocumentation.", "parse_error": ""}, {"file_path": "astropy/utils/xml/validate.py", "file_hash": "5da8386945a24efd81a0e2ae5b91f861365eb4b977bf3ea17142e1fb1314a793", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "subprocess", "names": [], "is_from": false, "alias": ""}, {"module": "misc", "names": ["signal_number_to_name"], "is_from": true, "alias": ""}], "functions": [{"name": "validate_schema", "qualified_name": "validate_schema", "args": ["filename", "schema_file"], "decorators": [], "docstring": "Validates an XML file against a schema or DTD.\n\nParameters\n----------\nfilename : str\n    The path to the XML file to validate\n\nschema_file : str\n    The path to the XML schema or DTD\n\nReturns\n-------\nreturncode, stdout, stderr : int, str, str\n    Returns the returncode from xmllint and the stdout an", "start_line": 15, "end_line": 56, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "Functions to do XML schema and DTD validation.  At the moment, this\nmakes a subprocess call to xmllint.  This could use a Python-based\nlibrary at some point in the future, if something appropriate could be\nfound.", "parse_error": ""}, {"file_path": "astropy/utils/xml/iterparser.py", "file_hash": "d7f37b1ba8312265baaa1e217fc0287c7da270f87ce3790f0561045c0ecc1c56", "imports": [{"module": "contextlib", "names": [], "is_from": false, "alias": ""}, {"module": "io", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "", "names": ["data"], "is_from": true, "alias": ""}, {"module": "xml.parsers", "names": ["expat"], "is_from": true, "alias": ""}, {"module": "", "names": ["_iterparser"], "is_from": true, "alias": ""}], "functions": [{"name": "_convert_to_fd_or_read_function", "qualified_name": "_convert_to_fd_or_read_function", "args": ["fd"], "decorators": ["contextlib.contextmanager"], "docstring": "Returns a function suitable for streaming input, or a file object.\n\nThis function is only useful if passing off to C code where:\n\n   - If it's a real file object, we want to use it as a real\n     C file object to avoid the Python overhead.\n\n   - If it's not a real file object, it's much handier to j", "start_line": 19, "end_line": 70, "is_async": false, "is_method": false}, {"name": "_fast_iterparse", "qualified_name": "_fast_iterparse", "args": ["fd", "buffersize"], "decorators": [], "docstring": "", "start_line": 73, "end_line": 110, "is_async": false, "is_method": false}, {"name": "get_xml_iterator", "qualified_name": "get_xml_iterator", "args": ["source", "_debug_python_based_parser"], "decorators": ["contextlib.contextmanager"], "docstring": "Returns an iterator over the elements of an XML file.\n\nThe iterator doesn't ever build a tree, so it is much more memory\nand time efficient than the alternative in ``cElementTree``.\n\nParameters\n----------\nfd : readable file-like object or read function\n\nReturns\n-------\nparts : iterator\n\n    The iter", "start_line": 124, "end_line": 162, "is_async": false, "is_method": false}, {"name": "get_xml_encoding", "qualified_name": "get_xml_encoding", "args": ["source"], "decorators": [], "docstring": "Determine the encoding of an XML file by reading its header.\n\nParameters\n----------\nsource : readable file-like object, read function or str path\n\nReturns\n-------\nencoding : str", "start_line": 165, "end_line": 183, "is_async": false, "is_method": false}, {"name": "xml_readlines", "qualified_name": "xml_readlines", "args": ["source"], "decorators": [], "docstring": "Get the lines from a given XML file.  Correctly determines the\nencoding and always returns unicode.\n\nParameters\n----------\nsource : readable file-like object, read function or str path\n\nReturns\n-------\nlines : list of unicode", "start_line": 186, "end_line": 205, "is_async": false, "is_method": false}, {"name": "start", "qualified_name": "start", "args": ["name", "attr"], "decorators": [], "docstring": "", "start_line": 84, "end_line": 87, "is_async": false, "is_method": false}, {"name": "end", "qualified_name": "end", "args": ["name"], "decorators": [], "docstring": "", "start_line": 89, "end_line": 91, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This module includes a fast iterator-based XML parser.", "parse_error": ""}, {"file_path": "astropy/utils/xml/__init__.py", "file_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/utils/xml/setup_package.py", "file_hash": "1b70e35f9d7e769a14f33ed3c57d3e