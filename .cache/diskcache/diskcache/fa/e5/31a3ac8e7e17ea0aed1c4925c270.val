e}, {"name": "x_min", "qualified_name": "x_min", "args": ["self", "value"], "decorators": ["x_min.setter"], "docstring": "", "start_line": 118, "end_line": 123, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "data", "radii", "mode"], "decorators": [], "docstring": "", "start_line": 125, "end_line": 126, "is_async": false, "is_method": false}, {"name": "_pairwise_diffs", "qualified_name": "_pairwise_diffs", "args": ["self", "data"], "decorators": [], "docstring": "", "start_line": 128, "end_line": 137, "is_async": false, "is_method": false}, {"name": "poisson", "qualified_name": "poisson", "args": ["self", "radii"], "decorators": [], "docstring": "Evaluates the Ripley K function for the homongeneous Poisson process,\nalso known as Complete State of Randomness (CSR).\n\nParameters\n----------\nradii : 1D array\n    Set of distances in which Ripley's K function will be evaluated.\n\nReturns\n-------\noutput : 1D array\n    Ripley's K function evaluated at", "start_line": 139, "end_line": 155, "is_async": false, "is_method": false}, {"name": "Lfunction", "qualified_name": "Lfunction", "args": ["self", "data", "radii", "mode"], "decorators": [], "docstring": "Evaluates the L function at ``radii``. For parameter description\nsee ``evaluate`` method.", "start_line": 157, "end_line": 163, "is_async": false, "is_method": false}, {"name": "Hfunction", "qualified_name": "Hfunction", "args": ["self", "data", "radii", "mode"], "decorators": [], "docstring": "Evaluates the H function at ``radii``. For parameter description\nsee ``evaluate`` method.", "start_line": 165, "end_line": 171, "is_async": false, "is_method": false}, {"name": "evaluate", "qualified_name": "evaluate", "args": ["self", "data", "radii", "mode"], "decorators": [], "docstring": "Evaluates the Ripley K estimator for a given set of values ``radii``.\n\nParameters\n----------\ndata : 2D array\n    Set of observed points in as a n by 2 array which will be used to\n    estimate Ripley's K function.\nradii : 1D array\n    Set of distances in which Ripley's K estimator will be evaluated.\n", "start_line": 173, "end_line": 329, "is_async": false, "is_method": false}], "classes": [{"name": "RipleysKEstimator", "bases": [], "methods": ["__init__", "area", "area", "y_max", "y_max", "x_max", "x_max", "y_min", "y_min", "x_min", "x_min", "__call__", "_pairwise_diffs", "poisson", "Lfunction", "Hfunction", "evaluate"], "docstring": "Estimators for Ripley's K function for two-dimensional spatial data.\nSee [1]_, [2]_, [3]_, [4]_, [5]_ for detailed mathematical and\npractical aspects of those estimators.\n\nParameters\n----------\narea : float\n    Area of study from which the points where observed.\nx_max, y_max : float, float, optional", "start_line": 11, "end_line": 329}], "calls": [], "module_docstring": "This module implements functions and classes for spatial statistics.", "parse_error": ""}, {"file_path": "astropy/stats/biweight.py", "file_hash": "225e38e7a4c0605b81d127f43f389a0447b09816acc9bce09a64bc11b17cc043", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "funcs", "names": ["median_absolute_deviation"], "is_from": true, "alias": ""}, {"module": "utils.decorators", "names": ["deprecated_renamed_argument"], "is_from": true, "alias": ""}], "functions": [{"name": "biweight_location", "qualified_name": "biweight_location", "args": ["data", "c", "M", "axis"], "decorators": ["deprecated_renamed_argument('a', 'data', '2.0')"], "docstring": "Compute the biweight location.\n\nThe biweight location is a robust statistic for determining the\ncentral location of a distribution.  It is given by:\n\n.. math::\n\n    \\zeta_{biloc}= M + \\frac{\\Sigma_{|u_i|<1} \\ (x_i - M) (1 - u_i^2)^2}\n        {\\Sigma_{|u_i|<1} \\ (1 - u_i^2)^2}\n\nwhere :math:`x` is the", "start_line": 19, "end_line": 114, "is_async": false, "is_method": false}, {"name": "biweight_scale", "qualified_name": "biweight_scale", "args": ["data", "c", "M", "axis", "modify_sample_size"], "decorators": [], "docstring": "Compute the biweight scale.\n\nThe biweight scale is a robust statistic for determining the\nstandard deviation of a distribution.  It is the square root of the\n`biweight midvariance\n<https://en.wikipedia.org/wiki/Robust_measures_of_scale#The_biweight_midvariance>`_.\nIt is given by:\n\n.. math::\n\n    \\ze", "start_line": 117, "end_line": 221, "is_async": false, "is_method": false}, {"name": "biweight_midvariance", "qualified_name": "biweight_midvariance", "args": ["data", "c", "M", "axis", "modify_sample_size"], "decorators": ["deprecated_renamed_argument('a', 'data', '2.0')"], "docstring": "Compute the biweight midvariance.\n\nThe biweight midvariance is a robust statistic for determining the\nvariance of a distribution.  Its square root is a robust estimator\nof scale (i.e. standard deviation).  It is given by:\n\n.. math::\n\n    \\zeta_{bivar} = n \\ \\frac{\\Sigma_{|u_i| < 1} \\\n        (x_i - ", "start_line": 225, "end_line": 362, "is_async": false, "is_method": false}, {"name": "biweight_midcovariance", "qualified_name": "biweight_midcovariance", "args": ["data", "c", "M", "modify_sample_size"], "decorators": ["deprecated_renamed_argument('a', 'data', '2.0')"], "docstring": "Compute the biweight midcovariance between pairs of multiple\nvariables.\n\nThe biweight midcovariance is a robust and resistant estimator of\nthe covariance between two variables.\n\nThis function computes the biweight midcovariance between all pairs\nof the input variables (rows) in the input data.  The ", "start_line": 366, "end_line": 554, "is_async": false, "is_method": false}, {"name": "biweight_midcorrelation", "qualified_name": "biweight_midcorrelation", "args": ["x", "y", "c", "M", "modify_sample_size"], "decorators": [], "docstring": "Compute the biweight midcorrelation between two variables.\n\nThe `biweight midcorrelation\n<https://en.wikipedia.org/wiki/Biweight_midcorrelation>`_ is a\nmeasure of similarity between samples.  It is given by:\n\n.. math::\n\n    r_{bicorr} = \\frac{\\zeta_{xy}}{\\sqrt{\\zeta_{xx} \\ \\zeta_{yy}}}\n\nwhere :math:", "start_line": 557, "end_line": 642, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This module contains functions for computing robust statistics using\nTukey's biweight function.", "parse_error": ""}, {"file_path": "astropy/extern/__init__.py", "file_hash": "14473cc5932ce00bc8510847843aba766fcc9912ce59d803f0eabe6692b4a0e9", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "This packages contains python packages that are bundled with Astropy but are\nexternal to Astropy, and hence are developed in a separate source tree.  Note\nthat this package is distinct from the /cextern directory of the source code\ndistribution, as that directory only contains C extension code.\n\nSee the README.rst in this directory of the Astropy source repository for more\ndetails.", "parse_error": ""}, {"file_path": "astropy/extern/setup_package.py", "file_hash": "a0ebf94694e1b9041eb99b9eb9cb66cfd954947d06cd53e9b3c1509358a0a6aa", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "get_package_data", "qualified_name": "get_package_data", "args": [], "decorators": [], "docstring": "", "start_line": 6, "end_line": 8, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/extern/six.py", "file_hash": "f88a53718225b85da742cac0b2115fc65cf2a2ccea081d86b5448319c49002a4", "imports": [{"module": "imp", "names": [], "is_from": false, "alias": ""}, {"module": "distutils.version", "names": ["StrictVersion"], "is_from": true, "alias": ""}], "functions": [{"name": "_find_module", "qualified_name": "_find_module", "args": ["name", "path"], "decorators": [], "docstring": "Alternative to `imp.find_module` that can also search in subpackage