, "start_line": 3334, "end_line": 3339, "is_async": false, "is_method": false}, {"name": "parse", "qualified_name": "parse", "args": ["self", "iterator", "config"], "decorators": [], "docstring": "", "start_line": 3341, "end_line": 3402, "is_async": false, "is_method": false}, {"name": "to_xml", "qualified_name": "to_xml", "args": ["self", "fd", "compressed", "tabledata_format", "_debug_python_based_parser", "_astropy_version"], "decorators": [], "docstring": "Write to an XML file.\n\nParameters\n----------\nfd : str path or writable file-like object\n    Where to write the file.\n\ncompressed : bool, optional\n    When `True`, write to a gzip-compressed file.  (Default:\n    `False`)\n\ntabledata_format : str, optional\n    Override the format of the table(s) data t", "start_line": 3404, "end_line": 3474, "is_async": false, "is_method": false}, {"name": "iter_tables", "qualified_name": "iter_tables", "args": ["self"], "decorators": [], "docstring": "Iterates over all tables in the VOTable file in a \"flat\" way,\nignoring the nesting of resources etc.", "start_line": 3476, "end_line": 3483, "is_async": false, "is_method": false}, {"name": "get_first_table", "qualified_name": "get_first_table", "args": ["self"], "decorators": [], "docstring": "Often, you know there is only one table in the file, and\nthat's all you need.  This method returns that first table.", "start_line": 3485, "end_line": 3493, "is_async": false, "is_method": false}, {"name": "get_table_by_index", "qualified_name": "get_table_by_index", "args": ["self", "idx"], "decorators": [], "docstring": "Get a table by its ordinal position in the file.", "start_line": 3509, "end_line": 3517, "is_async": false, "is_method": false}, {"name": "iter_fields_and_params", "qualified_name": "iter_fields_and_params", "args": ["self"], "decorators": [], "docstring": "Recursively iterate over all FIELD_ and PARAM_ elements in the\nVOTABLE_ file.", "start_line": 3519, "end_line": 3526, "is_async": false, "is_method": false}, {"name": "iter_values", "qualified_name": "iter_values", "args": ["self"], "decorators": [], "docstring": "Recursively iterate over all VALUES_ elements in the VOTABLE_\nfile.", "start_line": 3548, "end_line": 3554, "is_async": false, "is_method": false}, {"name": "iter_groups", "qualified_name": "iter_groups", "args": ["self"], "decorators": [], "docstring": "Recursively iterate over all GROUP_ elements in the VOTABLE_\nfile.", "start_line": 3563, "end_line": 3570, "is_async": false, "is_method": false}, {"name": "iter_coosys", "qualified_name": "iter_coosys", "args": ["self"], "decorators": [], "docstring": "Recursively iterate over all COOSYS_ elements in the VOTABLE_\nfile.", "start_line": 3586, "end_line": 3595, "is_async": false, "is_method": false}, {"name": "iter_info", "qualified_name": "iter_info", "args": ["self"], "decorators": [], "docstring": "Recursively iterate over all INFO_ elements in the VOTABLE_\nfile.", "start_line": 3601, "end_line": 3610, "is_async": false, "is_method": false}, {"name": "set_all_tables_format", "qualified_name": "set_all_tables_format", "args": ["self", "format"], "decorators": [], "docstring": "Set the output storage format of all tables in the file.", "start_line": 3616, "end_line": 3621, "is_async": false, "is_method": false}, {"name": "from_table", "qualified_name": "from_table", "args": ["cls", "table", "table_id"], "decorators": ["classmethod"], "docstring": "Create a `VOTableFile` instance from a given\n`astropy.table.Table` instance.\n\nParameters\n----------\ntable_id : str, optional\n    Set the given ID attribute on the returned Table instance.", "start_line": 3624, "end_line": 3641, "is_async": false, "is_method": false}, {"name": "yes_no", "qualified_name": "yes_no", "args": ["value"], "decorators": [], "docstring": "", "start_line": 1060, "end_line": 1063, "is_async": false, "is_method": false}, {"name": "careful_read", "qualified_name": "careful_read", "args": ["length"], "decorators": [], "docstring": "", "start_line": 2592, "end_line": 2596, "is_async": false, "is_method": false}], "classes": [{"name": "_IDProperty", "bases": [], "methods": ["ID", "ID", "ID"], "docstring": "", "start_line": 281, "end_line": 297}, {"name": "_NameProperty", "bases": [], "methods": ["name", "name", "name"], "docstring": "", "start_line": 300, "end_line": 313}, {"name": "_XtypeProperty", "bases": [], "methods": ["xtype", "xtype", "xtype"], "docstring": "", "start_line": 316, "end_line": 333}, {"name": "_UtypeProperty", "bases": [], "methods": ["utype", "utype", "utype"], "docstring": "", "start_line": 336, "end_line": 357}, {"name": "_UcdProperty", "bases": [], "methods": ["ucd", "ucd", "ucd"], "docstring": "", "start_line": 360, "end_line": 383}, {"name": "_DescriptionProperty", "bases": [], "methods": ["description", "description", "description"], "docstring": "", "start_line": 386, "end_line": 401}, {"name": "Element", "bases": [], "methods": ["_add_unknown_tag", "_ignore_add", "_add_definitions", "parse", "to_xml"], "docstring": "A base class for all classes that represent XML elements in the\nVOTABLE file.", "start_line": 406, "end_line": 459}, {"name": "SimpleElement", "bases": ["Element"], "methods": ["__init__", "__repr__", "parse", "to_xml"], "docstring": "A base class for simple elements, such as FIELD, PARAM and INFO\nthat don't require any special parsing or outputting machinery.", "start_line": 462, "end_line": 487}, {"name": "SimpleElementWithContent", "bases": ["SimpleElement"], "methods": ["__init__", "parse", "to_xml", "content", "content", "content"], "docstring": "A base class for simple elements, such as FIELD, PARAM and INFO\nthat don't require any special parsing or outputting machinery.", "start_line": 490, "end_line": 528}, {"name": "Link", "bases": ["SimpleElement", "_IDProperty"], "methods": ["__init__", "content_role", "content_role", "content_role", "content_type", "content_type", "content_type", "href", "href", "href", "to_table_column", "from_table_column"], "docstring": "LINK_ elements: used to reference external documents and servers through a URI.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.", "start_line": 531, "end_line": 635}, {"name": "Info", "bases": ["SimpleElementWithContent", "_IDProperty", "_XtypeProperty", "_UtypeProperty"], "methods": ["__init__", "name", "name", "value", "value", "content", "content", "content", "ref", "ref", "ref", "unit", "unit", "unit", "to_xml"], "docstring": "INFO_ elements: arbitrary key-value pairs for extensions to the standard.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.", "start_line": 638, "end_line": 806}, {"name": "Values", "bases": ["Element", "_IDProperty"], "methods": ["__init__", "__repr__", "null", "null", "null", "type", "type", "ref", "ref", "ref", "min", "min", "min", "min_inclusive", "min_inclusive", "min_inclusive", "max", "max", "max", "max_inclusive", "max_inclusive", "max_inclusive", "options", "parse", "is_defaults", "to_xml", "to_table_column", "from_table_column"], "docstring": "VALUES_ element: used within FIELD_ and PARAM_ elements to define the domain of values.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.", "start_line": 809, "end_line": 1126}, {"name": "Field", "bases": ["SimpleElement", "_IDProperty", "_NameProperty", "_XtypeProperty", "_UtypeProperty", "_UcdProperty"], "methods": ["__init__", "uniqify_names", "_setup", "datatype", "datatype", "precision", "precision", "precision", "width", "width", "width", "ref", "ref", "ref", "unit", "unit", "unit", "arraysize", "arraysize", "arraysize", "type", "type", "type", "values", "values", "values", "links", "parse", "to_xml", "to_table_column", "from_table_column"], "docstring": "FIELD_ element: describes the datatype of a particular column of data.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.\n\nIf *ID* is provided, it is used for the column name in the\nresulting recarray of the table.  If no *ID* is provided, *name*\nis used instead", "start_line": 1129, "end_line": 1566}, {"name": "Param", "bases": ["Field"], "methods": ["__init__", "value", "value", "_setup", "to_xml"], "docstring": "PARAM_ element: constant-valued columns in the data.\n\n:class:`Param` objects are a subclass of :class:`Field`, and have\nall of its methods and members.  Additionally, it defines :attr:`value`.", "start_line": 1569, "end_line": 1619}, {"name": "CooSys", "bases": ["SimpleElement"], "methods": ["__init__", "ID", "ID", "system", "system", "system", "equinox", "equinox", "equinox", "epoch", "epoch", "epoch"], "docstring": "COOSYS_ element: defines a coordinate system.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.", "start_line": 1622, "end_line": 1723}, {"name": "FieldRef", "bases": ["SimpleElement", "_UtypeProperty", "_UcdProperty"], "methods": ["__init__", "ref", "ref", "ref", "get_ref"], "docstring": "FIELDref_ element: used inside of GROUP_ elements to refer to remote FIELD_ elements.", "start_line": 1726, "end_line": 1789}, {"name": "ParamRef", "bases": ["SimpleElement", "_UtypeProperty", "_UcdProperty"], "methods": ["__init__", "ref", "ref", "ref", "get_ref"], "docstring": "PARAMref_ element: used inside of GROUP_ elements to refer to remote PARAM_ elements.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.\n\nIt contains the following publicly-accessible members:\n\n  *ref*: An XML ID referring to a <PARAM> element.", "start_line": 1792, "end_line": 1855}, {"name": "Group", "bases": ["Element", "_IDProperty", "_NameProperty", "_UtypeProperty", "_UcdProperty", "_DescriptionProperty"], "methods": ["__init__", "__repr__", "ref", "ref", "ref", "entries", "_add_fieldref", "_add_paramref", "_add_param", "_add_group", "parse", "to_xml", "iter_fields_and_params", "iter_groups"], "docstring": "GROUP_ element: groups FIELD_ and PARAM_ elements.\n\nThis information is currently ignored by the vo package---that is\nthe columns in the recarray are always flat---but the grouping\ninformation is stored so that it can be written out again to the\nXML file.\n\nThe keyword arguments correspond to setting", "start_line": 1858, "end_line": 1998}, {"name": "Table", "bases": ["Element", "_IDProperty", "_NameProperty", "_UcdProperty", "_DescriptionProperty"], "methods": ["__init__", "__repr__", "__bytes__", "__str__", "ref", "ref", "ref", "format", "format", "nrows", "fields", "params", "groups", "links", "infos", "is_empty", "create_arrays", "_resize_strategy", "_add_field", "_add_param", "_add_group", "_add_link", "_add_info", "parse", "_parse_tabledata", "_get_binary_data_stream", "_parse_binary", "_parse_fits", "to_xml", "_write_tabledata", "_write_binary", "to_table", "from_table", "iter_fields_and_params", "iter_groups", "iter_info"], "docstring": "TABLE_ element: optionally contains data.\n\nIt contains the following publicly-accessible and mutable\nattribute:\n\n    *array*: A Numpy masked array of the data itself, where each\n    row is a row of votable data, and columns are named and typed\n    based on the <FIELD> elements of the table.  The mas", "start_line": 2001, "end_line": 2962}, {"name": "Resource", "bases": ["Element", "_IDProperty", "_NameProperty", "_UtypeProperty", "_DescriptionProperty"], "methods": ["__init__", "__repr__", "type", "type", "extra_attributes", "coordinate_systems", "infos", "groups", "params", "links", "tables", "resources", "_add_table", "_add_info", "_add_group", "_add_param", "_add_coosys", "_add_resource", "_add_link", "parse", "to_xml", "iter_tables", "iter_fields_and_params", "iter_coosys", "iter_info"], "docstring": "RESOURCE_ element: Groups TABLE_ and RESOURCE_ elements.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.", "start_line": 2965, "end_line": 3216}, {"name": "VOTableFile", "bases": ["Element", "_IDProperty", "_DescriptionProperty"], "methods": ["__init__", "__repr__", "version", "version", "coordinate_systems", "params", "infos", "resources", "groups", "_add_param", "_add_resource", "_add_coosys", "_add_info", "_add_group", "parse", "to_xml", "iter_tables", "get_first_table", "get_table_by_index", "iter_fields_and_params", "iter_values", "iter_groups", "iter_coosys", "iter_info", "set_all_tables_format", "from_table"], "docstring": "VOTABLE_ element: represents an entire file.\n\nThe keyword arguments correspond to setting members of the same\nname, documented below.\n\n*version* is settable at construction time only, since conformance\ntests for building the rest of the structure depend on it.", "start_line": 3219, "end_line": 3641}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/io/votable/util.py", "file_hash": "f65abf26743becc6a06b4b9efe3f59b28eac5891db861d6569e1fb886df587ff", "imports": [{"module": "codecs", "names": [], "is_from": false, "alias": ""}, {"module": "contextlib", "names": [], "is_from": false, "alias": ""}, {"module": "io", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "gzip", "names": [], "is_from": false, "alias": ""}, {"module": "distutils", "names": ["version"], "is_from": true, "alias": ""}], "functions": [{"name": "convert_to_writable_filelike", "qualified_name": "convert_to_writable_filelike", "args": ["fd", "compressed"], "decorators": ["contextlib.contextmanager"], "docstring": "Returns a writable file-like object suitable for streaming output.\n\nParameters\n----------\nfd : file path string or writable file-like object\n    May be:\n\n        - a file path, in which case it is opened, and the file\n          object is returned.\n\n        - an object with a :meth:``write`` method, ", "start_line": 25, "end_line": 85, "is_async": false, "is_method": false}, {"name": "coerce_range_list_param", "qualified_name": "coerce_range_list_param", "args": ["p", "frames", "numeric"], "decorators": [], "docstring": "Coerces and/or verifies the object *p* into a valid range-list-format parameter.\n\nAs defined in `Section 8.7.2 of Simple\nSpectral Access Protocol\n<http://www.ivoa.net/Documents/REC/DAL/SSA-20080201.html>`_.\n\nParameters\n----------\np : str or sequence\n    May be a string as passed verbatim to the serv", "start_line": 99, "end_line": 200, "is_async": false, "is_method": false}, {"name": "version_compare", "qualified_name": "version_compare", "args": ["a", "b"], "decorators": [], "docstring": "Compare two VOTable version identifiers.", "start_line": 203, "end_line": 214, "is_async": false, "is_method": false}, {"name": "str_or_none", "qualified_name": "str_or_none", "args": ["x"], "decorators": [], "docstring": "", "start_line": 141, "end_line": 146, "is_async": false, "is_method": false}, {"name": "numeric_or_range", "qualified_name": "numeric_or_range", "args": ["x"], "decorators": [], "docstring": "", "start_line": 148, "end_line": 152, "is_async": false, "is_method": false}, {"name": "is_frame_of_reference", "qualified_name": "is_frame_of_reference", "args": ["x"], "decorators": [], "docstring": "", "start_line": 154, "end_line": 155, "is_async": false, "is_method": false}, {"name": "version_to_tuple", "qualified_name": "version_to_tuple", "args": ["v"], "decorators": [], "docstring": "", "start_line": 207, "end_line": 210, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "Various utilities and cookbook-like things.", "parse_error": ""}, {"file_path": "astropy/io/votable/exceptions.py", "file_hash": "aa7c71db116f415401efb81ceb95eb0b2186c674b8bb2f213eaf99a5f4a6b249", "imports": [{"module": "io", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "textwrap", "names": ["dedent"], "is_from": true, "alias": ""}, {"module": "warnings", "names": ["warn"], "is_from": true, "alias": ""}, {"module": "utils.exceptions", "names": ["AstropyWarning"], "is_from": true, "alias": ""}], "functions": [{"name": "_format_message", "qualified_name": "_format_message", "args": ["message", "name", "config", "pos"], "decorators": [], "docstring": "", "start_line": 56, "end_line": 62, "is_async": false, "is_method": false}, {"name": "_suppressed_warning", "qualified_name": "_suppressed_warning", "args": ["warning", "config", "stacklevel"], "decorators": [], "docstring": "", "start_line": 65, "end_line": 74, "is_async": false, "is_method": false}, {"name": "warn_or_raise", "qualified_name": "warn_or_raise", "args": ["warning_class", "exception_class", "args", "config", "pos", "stacklevel"], "decorators": [], "docstring": "Warn or raise an exception, depending on the pedantic setting.", "start_line": 77, "end_line": 89, "is_async": false, "is_method": false}, {"name": "vo_raise", "qualified_name": "vo_raise", "args": ["exception_class", "args", "config", "pos"], "decorators": [], "docstring": "Raise an exception, with proper position information if available.", "start_line": 92, "end_line": 98, "is_async": false, "is_method": false}, {"name": "vo_reraise", "qualified_name": "vo_reraise", "args": ["exc", "config", "pos", "additional"], "decorators": [], "docstring": "Raise an exception, with proper position information if available.\n\nRestores the original traceback of the exception, and should only\nbe called within an \"except:\" block of code.", "start_line": 101, "end_line": 116, "is_async": false, "is_method": false}, {"name": "vo_warn", "qualified_name": "vo_warn", "args": ["warning_class", "args", "config", "pos", "stacklevel"], "decorators": [], "docstring": "Warn, with proper position information if available.", "start_line": 119, "end_line": 126, "is_async": false, "is_method": false}, {"name": "warn_unknown_attrs", "qualified_name": "warn_unknown_attrs", "args": ["element", "attrs", "config", "pos", "good_attr", "stacklevel"], "decorators": [], "docstring": "", "start_line": 129, "end_line": 132, "is_async": false, "is_method": false}, {"name": "parse_vowarning", "qualified_name": "parse_vowarning", "args": ["line"], "decorators": [], "docstring": "Parses the vo warning string back into its parts.", "start_line": 140, "end_line": 180, "is_async": false, "is_method": false}, {"name": "_get_warning_and_exception_classes", "qualified_name": "_get_warning_and_exception_classes", "args": ["prefix"], "decorators": [], "docstring": "", "start_line": 1409, "end_line": 1415, "is_async": false, "is_method": false}, {"name": "_build_doc_string", "qualified_name": "_build_doc_string", "args": [], "decorators": [], "docstring": "", "start_line": 1418, "end_line": 1445, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "args", "config", "pos"], "decorators": [], "docstring": "", "start_line": 193, "end_line": 202, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 204, "end_line": 205, "is_async": false, "is_method": false}, {"name": "get_short_name", "qualified_name": "get_short_name", "args": ["cls"], "decorators": ["classmethod"], "docstring": "", "start_line": 208, "end_line": 211, "is_async": false, "is_method": false}, {"name": "generate_set", "qualified_name": "generate_set", "args": ["prefix"], "decorators": [], "docstring": "", "start_line": 1419, "end_line": 1439, "is_async": false, "is_method": false}], "classes": [{"name": "VOWarning", "bases": ["AstropyWarning"], "methods": ["__init__", "__str__", "get_short_name"], "docstring": "The base class of all VO warnings and exceptions.\n\nHandles the formatting of the message with a warning or exception\ncode, filename, line and column number.", "start_line": 183, "end_line": 211}, {"name": "VOTableChangeWarning", "bases": ["VOWarning", "SyntaxWarning"], "methods": [], "docstring": "A change has been made to the input XML file.", "start_line": 214, "end_line": 217}, {"name": "VOTableSpecWarning", "bases": ["VOWarning", "SyntaxWarning"], "methods": [], "docstring": "The input XML file violates the spec, but there is an obvious workaround.", "start_line": 220, "end_line": 223}, {"name": "UnimplementedWarning", "bases": ["VOWarning", "SyntaxWarning"], "methods": [], "docstring": "A feature of the VOTABLE_ spec is not implemented.", "start_line": 226, "end_line": 229}, {"name": "IOWarning", "bases": ["VOWarning", "RuntimeWarning"], "methods": [], "docstring": "A network or IO error occurred, but was recovered using the cache.", "start_line": 232, "end_line": 235}, {"name": "VOTableSpecError", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The input XML file violates the spec and there is no good workaround.", "start_line": 238, "end_line": 241}, {"name": "W01", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The VOTable spec states:\n\n    If a cell contains an array or complex number, it should be\n    encoded as multiple numbers separated by whitespace.\n\nMany VOTable files in the wild use commas as a separator instead,\nand ``vo.table`` supports this convention when not in\n:ref:`pedantic-mode`.\n\n``vo.tabl", "start_line": 244, "end_line": 264}, {"name": "W02", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "XML ids must match the following regular expression::\n\n    ^[A-Za-z_][A-Za-z0-9_\\.\\-]*$\n\nThe VOTable 1.1 says the following:\n\n    According to the XML standard, the attribute ``ID`` is a\n    string beginning with a letter or underscore (``_``), followed\n    by a sequence of letters, digits, or any o", "start_line": 267, "end_line": 293}, {"name": "W03", "bases": ["VOTableChangeWarning"], "methods": [], "docstring": "The VOTable 1.1 spec says the following about ``name`` vs. ``ID``\non ``FIELD`` and ``VALUE`` elements:\n\n    ``ID`` and ``name`` attributes have a different role in\n    VOTable: the ``ID`` is meant as a *unique identifier* of an\n    element seen as a VOTable component, while the ``name`` is\n    meant", "start_line": 296, "end_line": 346}, {"name": "W04", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The ``content-type`` attribute must use MIME content-type syntax as\ndefined in `RFC 2046 <https://tools.ietf.org/html/rfc2046>`__.\n\nThe current check for validity is somewhat over-permissive.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:link", "start_line": 349, "end_line": 363}, {"name": "W05", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The attribute must be a valid URI as defined in `RFC 2396\n<http://www.ietf.org/rfc/rfc2396.txt>`_.", "start_line": 366, "end_line": 373}, {"name": "W06", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "This warning is emitted when a ``ucd`` attribute does not match\nthe syntax of a `unified content descriptor\n<http://vizier.u-strasbg.fr/doc/UCD.htx>`__.\n\nIf the VOTable version is 1.2 or later, the UCD will also be\nchecked to ensure it conforms to the controlled vocabulary defined\nby UCD1+.\n\n**Refer", "start_line": 376, "end_line": 393}, {"name": "W07", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "As astro year field is a Besselian or Julian year matching the\nregular expression::\n\n    ^[JB]?[0-9]+([.][0-9]*)?$\n\nDefined in this XML Schema snippet::\n\n    <xs:simpleType  name=\"astroYear\">\n      <xs:restriction base=\"xs:token\">\n        <xs:pattern  value=\"[JB]?[0-9]+([.][0-9]*)?\"/>\n      </xs:res", "start_line": 396, "end_line": 413}, {"name": "W08", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "To avoid local-dependent number parsing differences, ``vo.table``\nmay require a string or unicode string where a numeric type may\nmake more sense.", "start_line": 416, "end_line": 425}, {"name": "W09", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The VOTable specification uses the attribute name ``ID`` (with\nuppercase letters) to specify unique identifiers.  Some\nVOTable-producing tools use the more standard lowercase ``id``\ninstead.  ``vo.table`` accepts ``id`` and emits this warning when\nnot in ``pedantic`` mode.\n\n**References**: `1.1\n<htt", "start_line": 428, "end_line": 442}, {"name": "W10", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The parser has encountered an element that does not exist in the\nspecification, or appears in an invalid context.  Check the file\nagainst the VOTable schema (with a tool such as `xmllint\n<http://xmlsoft.org/xmllint.html>`__.  If the file validates\nagainst the schema, and you still receive this warni", "start_line": 445, "end_line": 461}, {"name": "W11", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Earlier versions of the VOTable specification used a ``gref``\nattribute on the ``LINK`` element to specify a `GLU reference\n<http://aladin.u-strasbg.fr/glu/>`__.  New files should\nspecify a ``glu:`` protocol using the ``href`` attribute.\n\nSince ``vo.table`` does not currently support GLU references,", "start_line": 464, "end_line": 481}, {"name": "W12", "bases": ["VOTableChangeWarning"], "methods": [], "docstring": "In order to name the columns of the Numpy record array, each\n``FIELD`` element must have either an ``ID`` or ``name`` attribute\nto derive a name from.  Strictly speaking, according to the\nVOTable schema, the ``name`` attribute is required.  However, if\n``name`` is not present by ``ID`` is, and *peda", "start_line": 484, "end_line": 501}, {"name": "W13", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Some VOTable files in the wild use non-standard datatype names.  These\nare mapped to standard ones using the following mapping::\n\n   string        -> char\n   unicodeString -> unicodeChar\n   int16         -> short\n   int32         -> int\n   int64         -> long\n   float32       -> float\n   float64  ", "start_line": 504, "end_line": 529}, {"name": "W15", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The ``name`` attribute is required on every ``FIELD`` element.\nHowever, many VOTable files in the wild omit it and provide only\nan ``ID`` instead.  In this case, when *pedantic mode* is off,\n``vo.table`` will copy the ``name`` attribute to a new ``ID``\nattribute.\n\n**References**: `1.1\n<http://www.iv", "start_line": 535, "end_line": 550}, {"name": "W17", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "A ``DESCRIPTION`` element can only appear once within its parent\nelement.\n\nAccording to the schema, it may only occur once (`1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#ToC54>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#ToC58>`_", "start_line": 555, "end_line": 571}, {"name": "W18", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The number of rows explicitly specified in the ``nrows`` attribute\ndoes not match the actual number of rows (``TR`` elements) present\nin the ``TABLE``.  This may indicate truncation of the file, or an\ninternal error in the tool that produced it.  If *pedantic mode*\nis off, parsing will proceed, with", "start_line": 574, "end_line": 589}, {"name": "W19", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The column fields as defined using ``FIELD`` elements do not match\nthose in the headers of the embedded FITS file.  If *pedantic\nmode* is off, the embedded FITS file will take precedence.", "start_line": 592, "end_line": 601}, {"name": "W20", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "If no version number is explicitly given in the VOTable file, the\nparser assumes it is written to the VOTable 1.1 specification.", "start_line": 604, "end_line": 611}, {"name": "W21", "bases": ["UnimplementedWarning"], "methods": [], "docstring": "Unknown issues may arise using ``vo.table`` with VOTable files\nfrom a version other than 1.1, 1.2 or 1.3.", "start_line": 614, "end_line": 623}, {"name": "W22", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Version 1.0 of the VOTable specification used the ``DEFINITIONS``\nelement to define coordinate systems.  Version 1.1 now uses\n``COOSYS`` elements throughout the document.\n\n**References:** `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:definitions>`__,\n`1.2\n<ht", "start_line": 626, "end_line": 638}, {"name": "W23", "bases": ["IOWarning"], "methods": [], "docstring": "Raised when the VO service database can not be updated (possibly\ndue to a network outage).  This is only a warning, since an older\nand possible out-of-date VO service database was available\nlocally.", "start_line": 641, "end_line": 650}, {"name": "W24", "bases": ["VOWarning", "FutureWarning"], "methods": [], "docstring": "The VO catalog database retrieved from the www is designed for a\nnewer version of vo.table.  This may cause problems or limited\nfeatures performing service queries.  Consider upgrading vo.table\nto the latest version.", "start_line": 653, "end_line": 661}, {"name": "W25", "bases": ["IOWarning"], "methods": [], "docstring": "A VO service query failed due to a network error or malformed\narguments.  Another alternative service may be attempted.  If all\nservices fail, an exception will be raised.", "start_line": 664, "end_line": 672}, {"name": "W26", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The given element was not supported inside of the given element\nuntil the specified VOTable version, however the version declared\nin the file is for an earlier version.  These attributes may not\nbe written out to the file.", "start_line": 675, "end_line": 684}, {"name": "W27", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The ``COOSYS`` element was deprecated in VOTABLE version 1.2 in\nfavor of a reference to the Space-Time Coordinate (STC) data\nmodel (see `utype\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#sec:utype>`__\nand the IVOA note `referencing STC in VOTable\n<http://ivoa.net/Documents/l", "start_line": 687, "end_line": 697}, {"name": "W28", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The given attribute was not supported on the given element until the\nspecified VOTable version, however the version declared in the file is\nfor an earlier version.  These attributes may not be written out to\nthe file.", "start_line": 700, "end_line": 709}, {"name": "W29", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Some VOTable files specify their version number in the form \"v1.0\",\nwhen the only supported forms in the spec are \"1.0\".\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#ToC54>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2", "start_line": 712, "end_line": 724}, {"name": "W30", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Some VOTable files write missing floating-point values in non-standard\nways, such as \"null\" and \"-\".  In non-pedantic mode, any non-standard\nfloating-point literals are treated as missing values.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:", "start_line": 727, "end_line": 740}, {"name": "W31", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Since NaN's can not be represented in integer fields directly, a null\nvalue must be specified in the FIELD descriptor to support reading\nNaN's from the tabledata.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:datatypes>`__,\n`1.2\n<http://www.i", "start_line": 743, "end_line": 755}, {"name": "W32", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Each field in a table must have a unique ID.  If two or more fields\nhave the same ID, some will be renamed to ensure that all IDs are\nunique.\n\nFrom the VOTable 1.2 spec:\n\n    The ``ID`` and ``ref`` attributes are defined as XML types\n    ``ID`` and ``IDREF`` respectively. This means that the\n    con", "start_line": 758, "end_line": 780}, {"name": "W33", "bases": ["VOTableChangeWarning"], "methods": [], "docstring": "Each field in a table must have a unique name.  If two or more\nfields have the same name, some will be renamed to ensure that all\nnames are unique.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:name>`__,\n`1.2\n<http://www.ivoa.net/Documents/VO", "start_line": 783, "end_line": 796}, {"name": "W34", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The attribute requires the value to be a valid XML token, as\ndefined by `XML 1.0\n<http://www.w3.org/TR/2000/WD-xml-2e-20000814#NT-Nmtoken>`__.", "start_line": 799, "end_line": 807}, {"name": "W35", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The ``name`` and ``value`` attributes are required on all ``INFO``\nelements.\n\n**References:** `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#ToC54>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#ToC32>`__", "start_line": 810, "end_line": 822}, {"name": "W36", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "If the field specifies a ``null`` value, that value must conform\nto the given ``datatype``.\n\n**References:** `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:values>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#sec:values>`__", "start_line": 825, "end_line": 837}, {"name": "W37", "bases": ["UnimplementedWarning"], "methods": [], "docstring": "The 3 datatypes defined in the VOTable specification and supported by\nvo.table are ``TABLEDATA``, ``BINARY`` and ``FITS``.\n\n**References:** `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:data>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTabl", "start_line": 840, "end_line": 852}, {"name": "W38", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The only encoding for local binary data supported by the VOTable\nspecification is base64.", "start_line": 855, "end_line": 862}, {"name": "W39", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Bit values do not support masking.  This warning is raised upon\nsetting masked data in a bit column.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:datatypes>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#sec:da", "start_line": 865, "end_line": 876}, {"name": "W40", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "This is a terrible hack to support Simple Image Access Protocol\nresults from `archive.noao.edu <http://archive.noao.edu>`__.  It\ncreates a field for the coordinate projection type of type \"double\",\nwhich actually contains character data.  We have to hack the field\nto store character data, or we can'", "start_line": 879, "end_line": 889}, {"name": "W41", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "An XML namespace was specified on the ``VOTABLE`` element, but the\nnamespace does not match what is expected for a ``VOTABLE`` file.\n\nThe ``VOTABLE`` namespace is::\n\n  http://www.ivoa.net/xml/VOTable/vX.X\n\nwhere \"X.X\" is the version number.\n\nSome files in the wild set the namespace to the location o", "start_line": 892, "end_line": 911}, {"name": "W42", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The root element should specify a namespace.\n\nThe ``VOTABLE`` namespace is::\n\n    http://www.ivoa.net/xml/VOTable/vX.X\n\nwhere \"X.X\" is the version number.", "start_line": 914, "end_line": 925}, {"name": "W43", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Referenced elements should be defined before referees.  From the\nVOTable 1.2 spec:\n\n   In VOTable1.2, it is further recommended to place the ID\n   attribute prior to referencing it whenever possible.", "start_line": 928, "end_line": 938}, {"name": "W44", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "``VALUES`` elements that reference another element should not have\ntheir own content.\n\nFrom the VOTable 1.2 spec:\n\n    The ``ref`` attribute of a ``VALUES`` element can be used to\n    avoid a repetition of the domain definition, by referring to a\n    previously defined ``VALUES`` element having the ", "start_line": 941, "end_line": 957}, {"name": "W45", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The ``content-role`` attribute on the ``LINK`` element must be one of\nthe following::\n\n    query, hints, doc, location\n\nAnd in VOTable 1.3, additionally::\n\n    type\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#ToC54>`__,\n`1.2\n<http://www.ivoa.ne", "start_line": 960, "end_line": 980}, {"name": "W46", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The given char or unicode string is too long for the specified\nfield length.", "start_line": 983, "end_line": 990}, {"name": "W47", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "If no arraysize is specified on a char field, the default of '1'\nis implied, but this is rarely what is intended.", "start_line": 993, "end_line": 999}, {"name": "W48", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The attribute is not defined in the specification.", "start_line": 1002, "end_line": 1008}, {"name": "W49", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Prior to VOTable 1.3, the empty cell was illegal for integer\nfields.\n\nIf a \"null\" value was specified for the cell, it will be used\nfor the value, otherwise, 0 will be used.", "start_line": 1011, "end_line": 1020}, {"name": "W50", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "Invalid unit string as defined in the `Standards for Astronomical\nCatalogues, Version 2.0\n<http://cdsarc.u-strasbg.fr/doc/catstd-3.2.htx>`_.\n\nConsider passing an explicit ``unit_format`` parameter if the units\nin this file conform to another specification.", "start_line": 1023, "end_line": 1034}, {"name": "W51", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The integer value is out of range for the size of the field.", "start_line": 1037, "end_line": 1043}, {"name": "W52", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The BINARY2 format was introduced in VOTable 1.3.  It should\nnot be present in files marked as an earlier version.", "start_line": 1046, "end_line": 1054}, {"name": "W53", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The VOTABLE element must contain at least one RESOURCE element.", "start_line": 1057, "end_line": 1063}, {"name": "E01", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The size specifier for a ``char`` or ``unicode`` field must be\nonly a number followed, optionally, by an asterisk.\nMulti-dimensional size specifiers are not supported for these\ndatatypes.\n\nStrings, which are defined as a set of characters, can be\nrepresented in VOTable as a fixed- or variable-length", "start_line": 1066, "end_line": 1086}, {"name": "E02", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The number of array elements in the data does not match that specified\nin the FIELD specifier.", "start_line": 1089, "end_line": 1098}, {"name": "E03", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "Complex numbers should be two values separated by whitespace.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:datatypes>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#sec:datatypes>`__", "start_line": 1101, "end_line": 1112}, {"name": "E04", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "A ``bit`` array should be a string of '0's and '1's.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:datatypes>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#sec:datatypes>`__", "start_line": 1115, "end_line": 1126}, {"name": "E05", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "A ``boolean`` value should be one of the following strings (case\ninsensitive) in the ``TABLEDATA`` format::\n\n    'TRUE', 'FALSE', '1', '0', 'T', 'F', '\\0', ' ', '?'\n\nand in ``BINARY`` format::\n\n    'T', 'F', '1', '0', '\\0', ' ', '?'\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/200408", "start_line": 1129, "end_line": 1147}, {"name": "E06", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The supported datatypes are::\n\n    double, float, bit, boolean, unsignedByte, short, int, long,\n    floatComplex, doubleComplex, char, unicodeChar\n\nThe following non-standard aliases are also supported, but in\nthese case :ref:`W13 <W13>` will be raised::\n\n    string        -> char\n    unicodeString ", "start_line": 1150, "end_line": 1180}, {"name": "E08", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The ``type`` attribute on the ``VALUES`` element must be either\n``legal`` or ``actual``.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:values>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#sec:values>`__", "start_line": 1185, "end_line": 1197}, {"name": "E09", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The ``MIN``, ``MAX`` and ``OPTION`` elements must always have a\n``value`` attribute.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:values>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#sec:values>`__", "start_line": 1200, "end_line": 1212}, {"name": "E10", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "From VOTable 1.1 and later, ``FIELD`` and ``PARAM`` elements must have\na ``datatype`` field.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#elem:FIELD>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#elem:FIELD>`__", "start_line": 1215, "end_line": 1227}, {"name": "E11", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The precision attribute is meant to express the number of significant\ndigits, either as a number of decimal places (e.g. ``precision=\"F2\"`` or\nequivalently ``precision=\"2\"`` to express 2 significant figures\nafter the decimal point), or as a number of significant figures\n(e.g. ``precision=\"E5\"`` indi", "start_line": 1230, "end_line": 1249}, {"name": "E12", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The width attribute is meant to indicate to the application the\nnumber of characters to be used for input or output of the\nquantity.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#sec:form>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/", "start_line": 1252, "end_line": 1265}, {"name": "E13", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "From the VOTable 1.2 spec:\n\n    A table cell can contain an array of a given primitive type,\n    with a fixed or variable number of elements; the array may\n    even be multidimensional. For instance, the position of a\n    point in a 3D space can be defined by the following::\n\n        <FIELD ID=\"poin", "start_line": 1268, "end_line": 1307}, {"name": "E14", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "All ``PARAM`` elements must have a ``value`` attribute.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#elem:FIELD>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#elem:FIELD>`__", "start_line": 1310, "end_line": 1320}, {"name": "E15", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "All ``COOSYS`` elements must have an ``ID`` attribute.\n\nNote that the VOTable 1.1 specification says this attribute is\noptional, but its corresponding schema indicates it is required.\n\nIn VOTable 1.2, the ``COOSYS`` element is deprecated.", "start_line": 1323, "end_line": 1333}, {"name": "E16", "bases": ["VOTableSpecWarning"], "methods": [], "docstring": "The ``system`` attribute on the ``COOSYS`` element must be one of the\nfollowing::\n\n  'eq_FK4', 'eq_FK5', 'ICRS', 'ecl_FK4', 'ecl_FK5', 'galactic',\n  'supergalactic', 'xy', 'barycentric', 'geo_app'\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#ele", "start_line": 1336, "end_line": 1349}, {"name": "E17", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "``extnum`` attribute must be a positive integer.\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#ToC54>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#ToC58>`__", "start_line": 1352, "end_line": 1362}, {"name": "E18", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The ``type`` attribute of the ``RESOURCE`` element must be one of\n\"results\" or \"meta\".\n\n**References**: `1.1\n<http://www.ivoa.net/Documents/VOTable/20040811/REC-VOTable-1.1-20040811.html#ToC54>`__,\n`1.2\n<http://www.ivoa.net/Documents/VOTable/20091130/REC-VOTable-1.2.html#ToC58>`__", "start_line": 1365, "end_line": 1377}, {"name": "E19", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "Raised either when the file doesn't appear to be XML, or the root\nelement is not VOTABLE.", "start_line": 1380, "end_line": 1386}, {"name": "E20", "bases": ["VOTableSpecError"], "methods": [], "docstring": "The table had only *x* fields defined, but the data itself has more\ncolumns than that.", "start_line": 1389, "end_line": 1396}, {"name": "E21", "bases": ["VOWarning", "ValueError"], "methods": [], "docstring": "The table had *x* fields defined, but the data itself has only *y*\ncolumns.", "start_line": 1399, "end_line": 1406}], "calls": [], "module_docstring": ".. _warnings:\n\nWarnings\n--------\n\n.. note::\n    Most of the following warnings indicate violations of the VOTable\n    specification.  They should be reported to the authors of the\n    tools that produced the VOTable file.\n\n    To control the warnings emitted, use the standard Python\n    :mod:`warnings` module.  Most of these are of the type\n    `VOTableSpecWarning`.\n\n{warnings}\n\n.. _exceptions:\n\nExceptions\n----------\n\n.. note::\n\n    This is a list of many of the fatal exceptions emitted by vo.table\n    when the file does not conform to spec.  Other exceptions may be\n    raised due to unforeseen cases or bugs in vo.table itself.\n\n{exceptions}", "parse_error": ""}, {"file_path": "astropy/io/votable/table.py", "file_hash": "2aa2ddb8a0dcd004bfc927cbb058757e7b2be915185a1e7f403171c1a9b8ae3d", "imports": [{"module": "io", "names": [], "is_from": false, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "textwrap", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "", "names": ["exceptions"], "is_from": true, "alias": ""}, {"module": "", "names": ["tree"], "is_from": true, "alias": ""}, {"module": "utils.xml", "names": ["iterparser"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["data"], "is_from": true, "alias": ""}, {"module": "", "names": ["conf"], "is_from": true, "alias": ""}, {"module": "table", "names": ["Table"], "is_from": true, "alias": ""}, {"module": "utils.console", "names": ["print_code_line", "color_print"], "is_from": true, "alias": ""}, {"module": "", "names": ["converters", "xmlutil"], "is_from": true, "alias": ""}, {"module": "utils.xml", "names": ["validate"], "is_from": true, "alias": ""}], "functions": [{"name": "parse", "qualified_name": "parse", "args": ["source", "columns", "invalid", "pedantic", "chunk_size", "table_number", "table_id", "filename", "unit_format", "datatype_mapping", "_debug_python_based_parser"], "decorators": [], "docstring": "Parses a VOTABLE_ xml file (or file-like object), and returns a\n`~astropy.io.votable.tree.VOTableFile` object.\n\nParameters\n----------\nsource : str or readable file-like object\n    Path or file object containing a VOTABLE_ xml file.\n\ncolumns : sequence of str, optional\n    List of field names to incl", "start_line": 28, "end_line": 139, "is_async": false, "is_method": false}, {"name": "parse_single_table", "qualified_name": "parse_single_table", "args": ["source"], "decorators": [], "docstring": "Parses a VOTABLE_ xml file (or file-like object), reading and\nreturning only the first `~astropy.io.votable.tree.Table`\ninstance.\n\nSee `parse` for a description of the keyword arguments.\n\nReturns\n-------\nvotable : `~astropy.io.votable.tree.Table` object", "start_line": 142, "end_line": 159, "is_async": false, "is_method": false}, {"name": "writeto", "qualified_name": "writeto", "args": ["table", "file", "tabledata_format"], "decorators": [], "docstring": "Writes a `~astropy.io.votable.tree.VOTableFile` to a VOTABLE_ xml file.\n\nParameters\n----------\ntable : `~astropy.io.votable.tree.VOTableFile` or `~astropy.table.Table` instance.\n\nfile : str or writable file-like object\n    Path or file object to write to\n\ntabledata_format : str, optional\n    Overrid", "start_line": 162, "end_line": 188, "is_async": false, "is_method": false}, {"name": "validate", "qualified_name": "validate", "args": ["source", "output", "xmllint", "filename"], "decorators": [], "docstring": "Prints a validation report for the given file.\n\nParameters\n----------\nsource : str or readable file-like object\n    Path to a VOTABLE_ xml file or pathlib.path\n    object having Path to a VOTABLE_ xml file.\n\noutput : writable file-like object, optional\n    Where to output the report.  Defaults to ``", "start_line": 191, "end_line": 315, "is_async": false, "is_method": false}, {"name": "from_table", "qualified_name": "from_table", "args": ["table", "table_id"], "decorators": [], "docstring": "Given an `~astropy.table.Table` object, return a\n`~astropy.io.votable.tree.VOTableFile` file structure containing\njust that single table.\n\nParameters\n----------\ntable : `~astropy.table.Table` instance\n\ntable_id : str, optional\n    If not `None`, set the given id on the returned\n    `~astropy.io.vota", "start_line": 318, "end_line": 336, "is_async": false, "is_method": false}, {"name": "is_votable", "qualified_name": "is_votable", "args": ["source"], "decorators": [], "docstring": "Reads the header of a file to determine if it is a VOTable file.\n\nParameters\n----------\nsource : str or readable file-like object\n    Path or file object containing a VOTABLE_ xml file.\n\nReturns\n-------\nis_votable : bool\n    Returns `True` if the given file is a VOTable file.", "start_line": 339, "end_line": 367, "is_async": false, "is_method": false}, {"name": "reset_vo_warnings", "qualified_name": "reset_vo_warnings", "args": [], "decorators": [], "docstring": "Resets all of the vo warning state so that warnings that\nhave already been emitted will be emitted again. This is\nused, for example, by `validate` which must emit all\nwarnings each time it is called.", "start_line": 370, "end_line": 388, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This file contains a contains the high-level functions to read a\nVOTable file.", "parse_error": ""}, {"file_path": "astropy/io/ascii/cds.py", "file_hash": "8ffeb67a34cb15d1f308dc3a261ef9fed8adaa9b1b846022e84c13d6a75c61cb", "imports": [{"module": "fnmatch", "names": [], "is_from": false, "alias": ""}, {"module": "itertools", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "contextlib", "names": ["suppress"], "is_from": true, "alias": ""}, {"module": "", "names": ["core"], "is_from": true, "alias": ""}, {"module": "", "names": ["fixedwidth"], "is_from": true, "alias": ""}], "functions": [{"name": "get_type_map_key", "qualified_name": "get_type_map_key", "args": ["self", "col"], "decorators": [], "docstring": "", "start_line": 34, "end_line": 39, "is_async": false, "is_method": false}, {"name": "get_cols", "qualified_name": "get_cols", "args": ["self", "lines"], "decorators": [], "docstring": "Initialize the header Column objects from the table ``lines`` for a CDS\nheader.\n\nParameters\n----------\nlines : list\n    List of table lines", "start_line": 41, "end_line": 152, "is_async": false, "is_method": false}, {"name": "process_lines", "qualified_name": "process_lines", "args": ["self", "lines"], "decorators": [], "docstring": "Skip over CDS header by finding the last section delimiter", "start_line": 160, "end_line": 172, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "readme"], "decorators": [], "docstring": "", "start_line": 285, "end_line": 287, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "table"], "decorators": [], "docstring": "Not available for the Cds class (raises NotImplementedError)", "start_line": 289, "end_line": 291, "is_async": false, "is_method": false}, {"name": "read", "qualified_name": "read", "args": ["self", "table"], "decorators": [], "docstring": "", "start_line": 293, "end_line": 319, "is_async": false, "is_method": false}], "classes": [{"name": "CdsHeader", "bases": ["core.BaseHeader"], "methods": ["get_type_map_key", "get_cols"], "docstring": "", "start_line": 25, "end_line": 152}, {"name": "CdsData", "bases": ["core.BaseData"], "methods": ["process_lines"], "docstring": "CDS table data reader\n    ", "start_line": 155, "end_line": 172}, {"name": "Cds", "bases": ["core.BaseReader"], "methods": ["__init__", "write", "read"], "docstring": "Read a CDS format table.  See http://vizier.u-strasbg.fr/doc/catstd.htx.\nExample::\n\n  Table: Table name here\n  = ==============================================================================\n  Catalog reference paper\n      Bibliography info here\n  ===================================================", "start_line": 175, "end_line": 319}], "calls": [], "module_docstring": "An extensible ASCII table reader and writer.\n\ncds.py:\n  Classes to read CDS / Vizier table format\n\n:Copyright: Smithsonian Astrophysical Observatory (2011)\n:Author: Tom Aldcroft (aldcroft@head.cfa.harvard.edu)", "parse_error": ""}, {"file_path": "astropy/io/ascii/fixedwidth.py", "file_hash": "bdccb92c05c65777d9a610c8a73bbc88a176bc4c7343db8577a0bdfa0bad0339", "imports": [{"module": "", "names": ["core"], "is_from": true, "alias": ""}, {"module": "core", "names": ["InconsistentTableError", "DefaultSplitter"], "is_from": true, "alias": ""}, {"module": "", "names": ["basic"], "is_from": true, "alias": ""}], "functions": [{"name": "__call__", "qualified_name": "__call__", "args": ["self", "lines"], "decorators": [], "docstring": "", "start_line": 38, "end_line": 44, "is_async": false, "is_method": false}, {"name": "join", "qualified_name": "join", "args": ["self", "vals", "widths"], "decorators": [], "docstring": "", "start_line": 46, "end_line": 57, "is_async": false, "is_method": false}, {"name": "get_line", "qualified_name": "get_line", "args": ["self", "lines", "index"], "decorators": [], "docstring": "", "start_line": 75, "end_line": 81, "is_async": false, "is_method": false}, {"name": "get_cols", "qualified_name": "get_cols", "args": ["self", "lines"], "decorators": [], "docstring": "Initialize the header Column objects from the table ``lines``.\n\nBased on the previously set Header attributes find or create the column names.\nSets ``self.cols`` with the list of Columns.\n\nParameters\n----------\nlines : list\n    List of table lines", "start_line": 83, "end_line": 156, "is_async": false, "is_method": false}, {"name": "get_fixedwidth_params", "qualified_name": "get_fixedwidth_params", "args": ["self", "line"], "decorators": [], "docstring": "Split ``line`` on the delimiter and determine column values and\ncolumn start and end positions.  This might include null columns with\nzero length (e.g. for ``header row = \"| col1 || col2 | col3 |\"`` or\n``header2_row = \"----- ------- -----\"``).  The null columns are\nstripped out.  Returns the values ", "start_line": 158, "end_line": 218, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "lines"], "decorators": [], "docstring": "", "start_line": 220, "end_line": 223, "is_async": false, "is_method": false}, {"name": "write", "qualified_name": "write", "args": ["self", "lines"], "decorators": [], "docstring": "", "start_line": 233, "end_line": 261, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "col_starts", "col_ends", "delimiter_pad", "bookend"], "decorators": [], "docstring": "", "start_line": 296, "end_line": 301, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "col_starts", "col_ends", "delimiter_pad", "bookend"], "decorators": [], "docstring": "", "start_line": 345, "end_line": 347, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "position_line", "position_char", "delimiter_pad", "bookend"], "decorators": [], "docstring": "", "start_line": 400, "end_line": 404, "is_async": false, "is_method": false}], "classes": [{"name": "FixedWidthSplitter", "bases": ["core.BaseSplitter"], "methods": ["__call__", "join"], "docstring": "Split line based on fixed start and end positions for each ``col`` in\n``self.cols``.\n\nThis class requires that the Header class will have defined ``col.start``\nand ``col.end`` for each column.  The reference to the ``header.cols`` gets\nput in the splitter object by the base Reader.read() function ju", "start_line": 18, "end_line": 57}, {"name": "FixedWidthHeaderSplitter", "bases": ["DefaultSplitter"], "methods": [], "docstring": "Splitter class that splits on ``|``.", "start_line": 60, "end_line": 62}, {"name": "FixedWidthHeader", "bases": ["basic.BasicHeader"], "methods": ["get_line", "get_cols", "get_fixedwidth_params", "write"], "docstring": "Fixed width table header reader.", "start_line": 65, "end_line": 223}, {"name": "FixedWidthData", "bases": ["basic.BasicData"], "methods": ["write"], "docstring": "Base table data reader.", "start_line": 226, "end_line": 261}, {"name": "FixedWidth", "bases": ["basic.Basic"], "methods": ["__init__"], "docstring": "Read or write a fixed width table with a single header line that defines column\nnames and positions.  Examples::\n\n  # Bar delimiter in header and data\n\n  |  Col1 |   Col2      |  Col3 |\n  |  1.2  | hello there |     3 |\n  |  2.4  | many words  |     7 |\n\n  # Bar delimiter in header only\n\n  Col1 |   ", "start_line": 264, "end_line": 301}, {"name": "FixedWidthNoHeaderHeader", "bases": ["FixedWidthHeader"], "methods": [], "docstring": "Header reader for fixed with tables with no header line", "start_line": 304, "end_line": 306}, {"name": "FixedWidthNoHeaderData", "bases": ["FixedWidthData"], "methods": [], "docstring": "Data reader for fixed width tables with no header line", "start_line": 309, "end_line": 311}, {"name": "FixedWidthNoHeader", "bases": ["FixedWidth"], "methods": ["__init__"], "docstring": "Read or write a fixed width table which has no header line.  Column\nnames are either input (``names`` keyword) or auto-generated.  Column\npositions are determined either by input (``col_starts`` and ``col_stops``\nkeywords) or by splitting the first data line.  In the latter case a\n``delimiter`` is r", "start_line": 314, "end_line": 347}, {"name": "FixedWidthTwoLineHeader", "bases": ["FixedWidthHeader"], "methods": [], "docstring": "Header reader for fixed width tables splitting on whitespace.\n\nFor fixed width tables with several header lines, there is typically\na white-space delimited format line, so splitting on white space is\nneeded.", "start_line": 350, "end_line": 357}, {"name": "FixedWidthTwoLineDataSplitter", "bases": ["FixedWidthSplitter"], "methods": [], "docstring": "Splitter for fixed width tables splitting on ``' '``.", "start_line": 360, "end_line": 362}, {"name": "FixedWidthTwoLineData", "bases": ["FixedWidthData"], "methods": [], "docstring": "Data reader for fixed with tables with two header lines.", "start_line": 365, "end_line": 367}, {"name": "FixedWidthTwoLine", "bases": ["FixedWidth"], "methods": ["__init__"], "docstring": "Read or write a fixed width table which has two header lines.  The first\nheader line defines the column names and the second implicitly defines the\ncolumn positions.  Examples::\n\n  # Typical case with column extent defined by ---- under column names.\n\n   col1    col2         <== header_start = 0\n  -", "start_line": 370, "end_line": 404}], "calls": [], "module_docstring": "An extensible ASCII table reader and writer.\n\nfixedwidth.py:\n  Read or write a table with fixed width columns.\n\n:Copyright: Smithsonian Astrophysical Observatory (2011)\n:Author: Tom Aldcroft (aldcroft@head.cfa.harvard.edu)", "parse_error": ""}, {"file_path": "astropy/io/ascii/connect.py", "file_hash": "1a8b94f4ec762baa15860b9b784229a3162c629c1a4bf3b0d7381f04a3426a26", "imp