ke object.", "start_line": 1336, "end_line": 1353, "is_async": false, "is_method": false}, {"name": "where_not_allclose", "qualified_name": "where_not_allclose", "args": ["a", "b", "rtol", "atol"], "decorators": [], "docstring": "A version of numpy.allclose that returns the indices where the two arrays\ndiffer, instead of just a boolean value.", "start_line": 1356, "end_line": 1372, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "a", "b"], "decorators": [], "docstring": "The ``_BaseDiff`` class does not implement a ``_diff`` method and\nshould not be instantiated directly. Instead instantiate the\nappropriate subclass of ``_BaseDiff`` for the objects being compared\n(for example, use `HeaderDiff` to compare two `Header` objects.", "start_line": 66, "end_line": 81, "is_async": false, "is_method": false}, {"name": "__bool__", "qualified_name": "__bool__", "args": ["self"], "decorators": [], "docstring": "A ``_BaseDiff`` object acts as `True` in a boolean context if the two\nobjects compared are identical.  Otherwise it acts as `False`.", "start_line": 83, "end_line": 89, "is_async": false, "is_method": false}, {"name": "fromdiff", "qualified_name": "fromdiff", "args": ["cls", "other", "a", "b"], "decorators": ["classmethod"], "docstring": "Returns a new Diff object of a specific subclass from an existing diff\nobject, passing on the values for any arguments they share in common\n(such as ignore_keywords).\n\nFor example::\n\n    >>> from astropy.io import fits\n    >>> hdul1, hdul2 = fits.HDUList(), fits.HDUList()\n    >>> headera, headerb = ", "start_line": 92, "end_line": 116, "is_async": false, "is_method": false}, {"name": "identical", "qualified_name": "identical", "args": ["self"], "decorators": ["property"], "docstring": "`True` if all the ``.diff_*`` attributes on this diff instance are\nempty, implying that no differences were found.\n\nAny subclass of ``_BaseDiff`` must have at least one ``.diff_*``\nattribute, which contains a non-empty value if and only if some\ndifference was found between the two objects being comp", "start_line": 119, "end_line": 130, "is_async": false, "is_method": false}, {"name": "report", "qualified_name": "report", "args": ["self", "fileobj", "indent", "overwrite"], "decorators": ["deprecated_renamed_argument('clobber', 'overwrite', '2.0')"], "docstring": "Generates a text report on the differences (if any) between two\nobjects, and either returns it as a string or writes it to a file-like\nobject.\n\nParameters\n----------\nfileobj : file-like object, string, or None (optional)\n    If `None`, this method returns the report as a string. Otherwise it\n    ret", "start_line": 133, "end_line": 187, "is_async": false, "is_method": false}, {"name": "_writeln", "qualified_name": "_writeln", "args": ["self", "text"], "decorators": [], "docstring": "", "start_line": 189, "end_line": 190, "is_async": false, "is_method": false}, {"name": "_diff", "qualified_name": "_diff", "args": ["self"], "decorators": [], "docstring": "", "start_line": 192, "end_line": 193, "is_async": false, "is_method": false}, {"name": "_report", "qualified_name": "_report", "args": ["self"], "decorators": [], "docstring": "", "start_line": 195, "end_line": 196, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "a", "b", "ignore_keywords", "ignore_comments", "ignore_fields", "numdiffs", "rtol", "atol", "ignore_blanks", "ignore_blank_cards", "tolerance"], "decorators": [], "docstring": "Parameters\n----------\na : str or `HDUList`\n    The filename of a FITS file on disk, or an `HDUList` object.\n\nb : str or `HDUList`\n    The filename of a FITS file on disk, or an `HDUList` object to\n    compare to the first file.\n\nignore_keywords : sequence, optional\n    Header keywords to ignore when", "start_line": 213, "end_line": 325, "is_async": false, "is_method": false}, {"name": "_diff", "qualified_name": "_diff", "args": ["self"], "decorators": [], "docstring": "", "start_line": 327, "end_line": 339, "is_async": false, "is_method": false}, {"name": "_report", "qualified_name": "_report", "args": ["self"], "decorators": [], "docstring": "", "start_line": 341, "end_line": 399, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "a", "b", "ignore_keywords", "ignore_comments", "ignore_fields", "numdiffs", "rtol", "atol", "ignore_blanks", "ignore_blank_cards", "tolerance"], "decorators": [], "docstring": "See `FITSDiff` for explanations of the initialization parameters.", "start_line": 431, "end_line": 463, "is_async": false, "is_method": false}, {"name": "_diff", "qualified_name": "_diff", "args": ["self"], "decorators": [], "docstring": "", "start_line": 465, "end_line": 497, "is_async": false, "is_method": false}, {"name": "_report", "qualified_name": "_report", "args": ["self"], "decorators": [], "docstring": "", "start_line": 499, "end_line": 524, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "a", "b", "ignore_keywords", "ignore_comments", "rtol", "atol", "ignore_blanks", "ignore_blank_cards", "tolerance"], "decorators": [], "docstring": "See `FITSDiff` for explanations of the initialization parameters.", "start_line": 570, "end_line": 643, "is_async": false, "is_method": false}, {"name": "_diff", "qualified_name": "_diff", "args": ["self"], "decorators": [], "docstring": "", "start_line": 648, "end_line": 750, "is_async": false, "is_method": false}, {"name": "_report", "qualified_name": "_report", "args": ["self"], "decorators": [], "docstring": "", "start_line": 752, "end_line": 787, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "a", "b", "numdiffs", "rtol", "atol", "tolerance"], "decorators": [], "docstring": "See `FITSDiff` for explanations of the initialization parameters.", "start_line": 827, "end_line": 853, "is_async": false, "is_method": false}, {"name": "_diff", "qualified_name": "_diff", "args": ["self"], "decorators": [], "docstring": "", "start_line": 855, "end_line": 889, "is_async": false, "is_method": false}, {"name": "_report", "qualified_name": "_report", "args": ["self"], "decorators": [], "docstring": "", "start_line": 891, "end_line": 918, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "a", "b", "numdiffs"], "decorators": [], "docstring": "See `FITSDiff` for explanations of the initialization parameters.", "start_line": 943, "end_line": 951, "is_async": false, "is_method": false}, {"name": "_diff", "qualified_name": "_diff", "args": ["self"], "decorators": [], "docstring": "", "start_line": 953, "end_line": 960, "is_async": false, "is_method": false}, {"name": "_report", "qualified_name": "_report", "args": ["self"], "decorators": [], "docstring": "", "start_line": 962, "end_line": 983, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "a", "b", "ignore_fields", "numdiffs", "rtol", "atol", "tolerance"], "decorators": [], "docstring": "See `FITSDiff` for explanations of the initialization parameters.", "start_line": 1034, "end_line": 1075, "is_async": false, "is_method": false}, {"name": "_diff", "qualified_name": "_diff", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1077, "end_line": 1215, "is_async": false, "is_method": false}, {"name": "_report", "qualified_name": "_report", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1217, "end_line": 1269, "is_async": false, "is_method": false}, {"name": "get_header_values_comments", "qualified_name": "get_header_values_comments", "args": ["cards"], "decorators": [], "docstring": "", "start_line": 657, "end_line": 666, "is_async": false, "is_method": false}], "classes": [{"name": "_BaseDiff", "bases": [], "methods": ["__init__", "__bool__", "fromdiff", "identical", "report", "_writeln", "_diff", "_report"], "docstring": "Base class for all FITS diff objects.\n\nWhen instantiating a FITS diff object, the first two arguments are always\nthe two objects to diff (two FITS files, two FITS headers, etc.).\nInstantiating a ``_BaseDiff`` also causes the diff itself to be executed.\nThe returned ``_BaseDiff`` instance has a numbe", "start_line": 51, "end_line": 196}, {"name": "FITSDiff", "bases": ["_BaseDiff"], "methods": ["__init__", "_diff", "_report"], "docstring": "Diff two FITS files by filename, or two `HDUList` objects.\n\n`FITSDiff` objects have the following diff attributes:\n\n- ``diff_hdu_count``: If the FITS files being compared have different\n  numbers of HDUs, this contains a 2-tuple of the number of HDUs in each\n  file.\n\n- ``diff_hdus``: If any HDUs wit", "start_line": 199, "end_line": 399}, {"name": "HDUDiff", "bases": ["_BaseDiff"], "methods": ["__init__", "_diff", "_report"], "docstring": "Diff two HDU objects, including their headers and their data (but only if\nboth HDUs contain the same type of data (image, table, or unknown).\n\n`HDUDiff` objects have the following diff attributes:\n\n- ``diff_extnames``: If the two HDUs have different EXTNAME values, this\n  contains a 2-tuple of the d", "start_line": 402, "end_line": 524}, {"name": "HeaderDiff", "bases": ["_BaseDiff"], "methods": ["__init__", "_diff", "_report"], "docstring": "Diff two `Header` objects.\n\n`HeaderDiff` objects have the following diff attributes:\n\n- ``diff_keyword_count``: If the two headers contain a different number of\n  keywords, this contains a 2-tuple of the keyword count for each header.\n\n- ``diff_keywords``: If either header contains one or more keywo", "start_line": 527, "end_line": 787}, {"name": "ImageDataDiff", "bases": ["_BaseDiff"], "methods": ["__init__", "_diff", "_report"], "docstring": "Diff two image data arrays (really any array from a PRIMARY HDU or an IMAGE\nextension HDU, though the data unit is assumed to be \"pixels\").\n\n`ImageDataDiff` objects have the following diff attributes:\n\n- ``diff_dimensions``: If the two arrays contain either a different number\n  of dimensions or diff", "start_line": 795, "end_line": 918}, {"name": "RawDataDiff", "bases": ["ImageDataDiff"], "methods": ["__init__", "_diff", "_report"], "docstring": "`RawDataDiff` is just a special case of `ImageDataDiff` where the images\nare one-dimensional, and the data is treated as a 1-dimensional array of\nbytes instead of pixel values.  This is used to compare the data of two\nnon-standard extension HDUs that were not recognized as containing image or\ntable ", "start_line": 921, "end_line": 983}, {"name": "TableDataDiff", "bases": ["_BaseDiff"], "methods": ["__init__", "_diff", "_report"], "docstring": "Diff two table data arrays. It doesn't matter whether the data originally\ncame from a binary or ASCII table--the data should be passed in as a\nrecarray.\n\n`TableDataDiff` objects have the following diff attributes:\n\n- ``diff_column_count``: If the tables being compared have different\n  numbers of col", "start_line": 986, "end_line": 1269}], "calls": [], "module_docstring": "Facilities for diffing two FITS files.  Includes objects for diffing entire\nFITS files, individual HDUs, FITS headers, or just FITS data.\n\nUsed to implement the fitsdiff program.", "parse_error": ""}, {"file_path": "astropy/io/fits/util.py", "file_hash": "ef448ddff2d4153d7713fa0e608603c7d0a9d7ee53a818017c0be75676bfcc60", "imports": [{"module": "gzip", "names": [], "is_from": false, "alias": ""}, {"module": "itertools", "names": [], "is_from": false, "alias": ""}, {"module": "io", "names": [], "is_from": false, "alias": ""}, {"module": "mmap", "names": [], "is_from": false, "alias": ""}, {"module": "operator", "names": [], "is_from": false, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "platform", "names": [], "is_from": false, "alias": ""}, {"module": "signal", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "tempfile", "names": [], "is_from": false, "alias": ""}, {"module": "textwrap", "names": [], "is_from": false, "alias": ""}, {"module": "threading", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "weakref", "names": [], "is_from": false, "alias": ""}, {"module": "contextlib", "names": ["contextmanager", "suppress"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["data"], "is_from": true, "alias": ""}, {"module": "distutils.version", "names": ["LooseVersion"], "is_from": true, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "utils", "names": ["wraps"], "is_from": true, "alias": ""}, {"module": "utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}], "functions": [{"name": "first", "qualified_name": "first", "args": ["iterable"], "decorators": [], "docstring": "Returns the first item returned by iterating over an iterable object.\n\nExample:\n\n>>> a = [1, 2, 3]\n>>> first(a)\n1", "start_line": 150, "end_line": 161, "is_async": false, "is_method": false}, {"name": "itersubclasses", "qualified_name": "itersubclasses", "args": ["cls", "_seen"], "decorators": [], "docstring": "Generator over all subclasses of a given class, in depth first order.\n\n>>> class A: pass\n>>> class B(A): pass\n>>> class C(A): pass\n>>> class D(B,C): pass\n>>> class E(D): pass\n>>>\n>>> for cls in itersubclasses(A):\n...     print(cls.__name__)\nB\nD\nE\nC\n>>> # get ALL classes currently defined\n>>> [cls.__", "start_line": 164, "end_line": 198, "is_async": false, "is_method": false}, {"name": "ignore_sigint", "qualified_name": "ignore_sigint", "args": ["func"], "decorators": [], "docstring": "This decorator registers a custom SIGINT handler to catch and ignore SIGINT\nuntil the wrapped function is completed.", "start_line": 201, "end_line": 244, "is_async": false, "is_method": false}, {"name": "pairwise", "qualified_name": "pairwise", "args": ["iterable"], "decorators": [], "docstring": "Return the items of an iterable paired with its next item.\n\nEx: s -> (s0,s1), (s1,s2), (s2,s3), ....", "start_line": 247, "end_line": 258, "is_async": false, "is_method": false}, {"name": "encode_ascii", "qualified_name": "encode_ascii", "args": ["s"], "decorators": [], "docstring": "", "start_line": 261, "end_line": 273, "is_async": false, "is_method": false}, {"name": "decode_ascii", "qualified_name": "decode_ascii", "args": ["s"], "decorators": [], "docstring": "", "start_line": 276, "end_line": 309, "is_async": false, "is_method": false}, {"name": "isreadable", "qualified_name": "isreadable", "args": ["f"], "decorators": [], "docstring": "Returns True if the file-like object can be read from.  This is a common-\nsense approximation of io.IOBase.readable.", "start_line": 312, "end_line": 333, "is_async": false, "is_method": false}, {"name": "iswritable", "qualified_name": "iswritable", "args": ["f"], "decorators": [], "docstring": "Returns True if the file-like object can be written to.  This is a common-\nsense approximation of io.IOBase.writable.", "start_line": 336, "end_line": 357, "is_async": false, "is_method": false}, {"name": "isfile", "qualified_name": "isfile", "args": ["f"], "decorators": [], "docstring": "Returns True if the given object represents an OS-level file (that is,\n``isinstance(f, file)``).\n\nOn Python 3 this also returns True if the given object is higher level\nwrapper on top of a FileIO object, such as a TextIOWrapper.", "start_line": 360, "end_line": 375, "is_async": false, "is_method": false}, {"name": "fileobj_open", "qualified_name": "fileobj_open", "args": ["filename", "mode"], "decorators": [], "docstring": "A wrapper around the `open()` builtin.\n\nThis exists because `open()` returns an `io.BufferedReader` by default.\nThis is bad, because `io.BufferedReader` doesn't support random access,\nwhich we need in some cases.  We must call open with buffering=0 to get\na raw random-access file reader.", "start_line": 378, "end_line": 388, "is_async": false, "is_method": false}, {"name": "fileobj_name", "qualified_name": "fileobj_name", "args": ["f"], "decorators": [], "docstring": "Returns the 'name' of file-like object f, if it has anything that could be\ncalled its name.  Otherwise f's class or type is returned.  If f is a\nstring f itself is returned.", "start_line": 391, "end_line": 416, "is_async": false, "is_method": false}, {"name": "fileobj_closed", "qualified_name": "fileobj_closed", "args": ["f"], "decorators": [], "docstring": "Returns True if the given file-like object is closed or if f is a string\n(and assumed to be a pathname).\n\nReturns False for all other types of objects, under the assumption that\nthey are file-like objects with no sense of a 'closed' state.", "start_line": 419, "end_line": 438, "is_async": false, "is_method": false}, {"name": "fileobj_mode", "qualified_name": "fileobj_mode", "args": ["f"], "decorators": [], "docstring": "Returns the 'mode' string of a file-like object if such a thing exists.\nOtherwise returns None.", "start_line": 441, "end_line": 471, "is_async": false, "is_method": false}, {"name": "_fileobj_normalize_mode", "qualified_name": "_fileobj_normalize_mode", "args": ["f"], "decorators": [], "docstring": "Takes care of some corner cases in Python where the mode string\nis either oddly formatted or does not truly represent the file mode.", "start_line": 474, "end_line": 496, "is_async": false, "is_method": false}, {"name": "fileobj_is_binary", "qualified_name": "fileobj_is_binary", "args": ["f"], "decorators": [], "docstring": "Returns True if the give file or file-like object has a file open in binary\nmode.  When in doubt, returns True by default.", "start_line": 499, "end_line": 517, "is_async": false, "is_method": false}, {"name": "translate", "qualified_name": "translate", "args": ["s", "table", "deletechars"], "decorators": [], "docstring": "", "start_line": 520, "end_line": 525, "is_async": false, "is_method": false}, {"name": "fill", "qualified_name": "fill", "args": ["text", "width"], "decorators": [], "docstring": "Like :func:`textwrap.wrap` but preserves existing paragraphs which\n:func:`textwrap.wrap` does not otherwise handle well.  Also handles section\nheaders.", "start_line": 528, "end_line": 543, "is_async": false, "is_method": false}, {"name": "_array_from_file", "qualified_name": "_array_from_file", "args": ["infile", "dtype", "count"], "decorators": [], "docstring": "Create a numpy array from a file or a file-like object.", "start_line": 554, "end_line": 589, "is_async": false, "is_method": false}, {"name": "_array_to_file", "qualified_name": "_array_to_file", "args": ["arr", "outfile"], "decorators": [], "docstring": "Write a numpy array to a file or a file-like object.\n\nParameters\n----------\narr : `~numpy.ndarray`\n    The Numpy array to write.\noutfile : file-like\n    A file-like object such as a Python file object, an `io.BytesIO`, or\n    anything else with a ``write`` method.  The file object must support\n    t", "start_line": 596, "end_line": 644, "is_async": false, "is_method": false}, {"name": "_array_to_file_like", "qualified_name": "_array_to_file_like", "args": ["arr", "fileobj"], "decorators": [], "docstring": "Write a `~numpy.ndarray` to a file-like object (which is not supported by\n`numpy.ndarray.tofile`).", "start_line": 647, "end_line": 687, "is_async": false, "is_method": false}, {"name": "_write_string", "qualified_name": "_write_string", "args": ["f", "s"], "decorators": [], "docstring": "Write a string to a file, encoding to ASCII if the file is open in binary\nmode, or decoding if the file is open in text mode.", "start_line": 690, "end_line": 705, "is_async": false, "is_method": false}, {"name": "_convert_array", "qualified_name": "_convert_array", "args": ["array", "dtype"], "decorators": [], "docstring": "Converts an array to a new dtype--if the itemsize of the new dtype is\nthe same as the old dtype and both types are not numeric, a view is\nreturned.  Otherwise a new array must be created.", "start_line": 708, "end_line": 724, "is_async": false, "is_method": false}, {"name": "_unsigned_zero", "qualified_name": "_unsigned_zero", "args": ["dtype"], "decorators": [], "docstring": "Given a numpy dtype, finds its \"zero\" point, which is exactly in the\nmiddle of its range.", "start_line": 727, "end_line": 734, "is_async": false, "is_method": false}, {"name": "_is_pseudo_unsigned", "qualified_name": "_is_pseudo_unsigned", "args": ["dtype"], "decorators": [], "docstring": "", "start_line": 737, "end_line": 738, "is_async": false, "is_method": false}, {"name": "_is_int", "qualified_name": "_is_int", "args": ["val"], "decorators": [], "docstring": "", "start_line": 741, "end_line": 742, "is_async": false, "is_method": false}, {"name": "_str_to_num", "qualified_name": "_str_to_num", "args": ["val"], "decorators": [], "docstring": "Converts a given string to either an int or a float if necessary.", "start_line": 745, "end_line": 753, "is_async": false, "is_method": false}, {"name": "_words_group", "qualified_name": "_words_group", "args": ["input", "strlen"], "decorators": [], "docstring": "Split a long string into parts where each part is no longer\nthan ``strlen`` and no word is cut into two pieces.  But if\nthere is one single word which is longer than ``strlen``, then\nit will be split in the middle of the word.", "start_line": 756, "end_line": 792, "is_async": false, "is_method": false}, {"name": "_tmp_name", "qualified_name": "_tmp_name", "args": ["input"], "decorators": [], "docstring": "Create a temporary file name which should not already exist.  Use the\ndirectory of the input file as the base name of the mkstemp() output.", "start_line": 795, "end_line": 805, "is_async": false, "is_method": false}, {"name": "_get_array_mmap", "qualified_name": "_get_array_mmap", "args": ["array"], "decorators": [], "docstring": "If the array has an mmap.mmap at base of its base chain, return the mmap\nobject; otherwise return None.", "start_line": 808, "end_line": 821, "is_async": false, "is_method": false}, {"name": "_free_space_check", "qualified_name": "_free_space_check", "args": ["hdulist", "dirname"], "decorators": ["contextmanager"], "docstring": "", "start_line": 825, "end_line": 844, "is_async": false, "is_method": false}, {"name": "_extract_number", "qualified_name": "_extract_number", "args": ["value", "default"], "decorators": [], "docstring": "Attempts to extract an integer number from the given value. If the\nextraction fails, the value of the 'default' argument is returned.", "start_line": 847, "end_line": 858, "is_async": false, "is_method": false}, {"name": "get_testdata_filepath", "qualified_name": "get_testdata_filepath", "args": ["filename"], "decorators": [], "docstring": "Return a string representing the path to the file requested from the\nio.fits test data set.\n\n.. versionadded:: 2.0.3\n\nParameters\n----------\nfilename : str\n    The filename of the test data file.\n\nReturns\n-------\nfilepath : str\n    The path to the requested file.", "start_line": 861, "end_line": 879, "is_async": false, "is_method": false}, {"name": "_rstrip_inplace", "qualified_name": "_rstrip_inplace", "args": ["array"], "decorators": [], "docstring": "Performs an in-place rstrip operation on string arrays. This is necessary\nsince the built-in `np.char.rstrip` in Numpy does not perform an in-place\ncalculation.", "start_line": 882, "end_line": 929, "is_async": false, "is_method": false}, {"name": "_add_listener", "qualified_name": "_add_listener", "args": ["self", "listener"], "decorators": [], "docstring": "Add an object to the list of listeners to notify of changes to this\nobject.  This adds a weakref to the list of listeners that is\nremoved from the listeners list when the listener has no other\nreferences to it.", "start_line": 80, "end_line": 91, "is_async": false, "is_method": false}, {"name": "_remove_listener", "qualified_name": "_remove_listener", "args": ["self", "listener"], "decorators": [], "docstring": "Removes the specified listener from the listeners list.  This relies\non object identity (i.e. the ``is`` operator).", "start_line": 93, "end_line": 103, "is_async": false, "is_method": false}, {"name": "_notify", "qualified_name": "_notify", "args": ["self", "notification"], "decorators": [], "docstring": "Notify all listeners of some particular state change by calling their\n``_update_<notification>`` method with the given ``*args`` and\n``**kwargs``.\n\nThe notification does not by default include the object that actually\nchanged (``self``), but it certainly may if required.", "start_line": 105, "end_line": 129, "is_async": false, "is_method": false}, {"name": "__getstate__", "qualified_name": "__getstate__", "args": ["self"], "decorators": [], "docstring": "Exclude listeners when saving the listener's state, since they may be\nephemeral.", "start_line": 131, "end_line": 147, "is_async": false, "is_method": false}, {"name": "wrapped", "qualified_name": "wrapped", "args": [], "decorators": ["wraps(func)"], "docstring": "", "start_line": 208, "end_line": 242, "is_async": false, "is_method": false}, {"name": "maybe_fill", "qualified_name": "maybe_fill", "args": ["t"], "decorators": [], "docstring": "", "start_line": 537, "end_line": 541, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 216, "end_line": 217, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "signum", "frame"], "decorators": [], "docstring": "", "start_line": 219, "end_line": 223, "is_async": false, "is_method": false}], "classes": [{"name": "NotifierMixin", "bases": [], "methods": ["_add_listener", "_remove_listener", "_notify", "__getstate__"], "docstring": "Mixin class that provides services by which objects can register\nlisteners to changes on that object.\n\nAll methods provided by this class are underscored, since this is intended\nfor internal use to communicate between classes in a generic way, and is\nnot machinery that should be exposed to users of ", "start_line": 33, "end_line": 147}, {"name": "SigintHandler", "bases": [], "methods": ["__init__", "__call__"], "docstring": "", "start_line": 215, "end_line": 223}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/io/fits/card.py", "file_hash": "b45b4d3ed9663a31316d7c7dd252e7af09849581aabb04f14dfc81de1a27c3db", "imports": [{"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "util", "names": ["_str_to_num", "_is_int", "translate", "_words_group"], "is_from": true, "alias": ""}, {"module": "verify", "names": ["_Verify", "_ErrList", "VerifyError", "VerifyWarning"], "is_from": true, "alias": ""}, {"module": "", "names": ["conf"], "is_from": true, "alias": ""}, {"module": "utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}], "functions": [{"name": "_int_or_float", "qualified_name": "_int_or_float", "args": ["s"], "decorators": [], "docstring": "Converts an a string to an int if possible, or to a float.\n\nIf the string is neither a string or a float a value error is raised.", "start_line": 1163, "end_line": 1180, "is_async": false, "is_method": false}, {"name": "_format_value", "qualified_name": "_format_value", "args": ["value"], "decorators": [], "docstring": "Converts a card value to its appropriate string representation as\ndefined by the FITS format.", "start_line": 1183, "end_line": 1217, "is_async": false, "is_method": false}, {"name": "_format_float", "qualified_name": "_format_float", "args": ["value"], "decorators": [], "docstring": "Format a floating number to make sure it gets the decimal point.", "start_line": 1220, "end_line": 1249, "is_async": false, "is_method": false}, {"name": "_pad", "qualified_name": "_pad", "args": ["input"], "decorators": [], "docstring": "Pad blank space to the input string to be multiple of 80.", "start_line": 1252, "end_line": 1268, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 33, "end_line": 35, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "keyword", "value", "comment"], "decorators": [], "docstring": "", "start_line": 154, "end_line": 198, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 200, "end_line": 201, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 203, "end_line": 204, "is_async": false, "is_method": false}, {"name": "__len__", "qualified_name": "__len__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 206, "end_line": 207, "is_async": false, "is_method": false}, {"name": "__getitem__", "qualified_name": "__getitem__", "args": ["self", "index"], "decorators": [], "docstring": "", "start_line": 209, "end_line": 210, "is_async": false, "is_method": false}, {"name": "keyword", "qualified_name": "keyword", "args": ["self"], "decorators": ["property"], "docstring": "Returns the keyword name parsed from the card image.", "start_line": 213, "end_line": 222, "is_async": false, "is_method": false}, {"name": "keyword", "qualified_name": "keyword", "args": ["self", "keyword"], "decorators": ["keyword.setter"], "docstring": "Set the key attribute; once set it cannot be modified.", "start_line": 225, "end_line": 272, "is_async": false, "is_method": false}, {"name": "value", "qualified_name": "value", "args": ["self"], "decorators": ["property"], "docstring": "The value associated with the keyword stored in this card.", "start_line": 275, "end_line": 292, "is_async": false, "is_method": false}, {"name": "value", "qualified_name": "value", "args": ["self", "value"], "decorators": ["value.setter"], "docstring": "", "start_line": 295, "end_line": 369, "is_async": false, "is_method": false}, {"name": "value", "qualified_name": "value", "args": ["self"], "decorators": ["value.deleter"], "docstring": "", "start_line": 372, "end_line": 382, "is_async": false, "is_method": false}, {"name": "rawkeyword", "qualified_name": "rawkeyword", "args": ["self"], "decorators": ["property"], "docstring": "On record-valued keyword cards this is the name of the standard <= 8\ncharacter FITS keyword that this RVKC is stored in.  Otherwise it is\nthe card's normal keyword.", "start_line": 385, "end_line": 397, "is_async": false, "is_method": false}, {"name": "rawvalue", "qualified_name": "rawvalue", "args": ["self"], "decorators": ["property"], "docstring": "On record-valued keyword cards this is the raw string value in\nthe ``<field-specifier>: <value>`` format stored in the card in order\nto represent a RVKC.  Otherwise it is the card's normal value.", "start_line": 400, "end_line": 412, "is_async": false, "is_method": false}, {"name": "comment", "qualified_name": "comment", "args": ["self"], "decorators": ["property"], "docstring": "Get the comment attribute from the card image if not already set.", "start_line": 415, "end_line": 425, "is_async": false, "is_method": false}, {"name": "comment", "qualified_name": "comment", "args": ["self", "comment"], "decorators": ["comment.setter"], "docstring": "", "start_line": 428, "end_line": 451, "is_async": false, "is_method": false}, {"name": "comment", "qualified_name": "comment", "args": ["self"], "decorators": ["comment.deleter"], "docstring": "", "start_line": 454, "end_line": 460, "is_async": false, "is_method": false}, {"name": "field_specifier", "qualified_name": "field_specifier", "args": ["self"], "decorators": ["property"], "docstring": "The field-specifier of record-valued keyword cards; always `None` on\nnormal cards.", "start_line": 463, "end_line": 474, "is_async": false, "is_method": false}, {"name": "field_specifier", "qualified_name": "field_specifier", "args": ["self", "field_specifier"], "decorators": ["field_specifier.setter"], "docstring": "", "start_line": 477, "end_line": 490, "is_async": false, "is_method": false}, {"name": "field_specifier", "qualified_name": "field_specifier", "args": ["self"], "decorators": ["field_specifier.deleter"], "docstring": "", "start_line": 493, "end_line": 495, "is_async": false, "is_method": false}, {"name": "image", "qualified_name": "image", "args": ["self"], "decorators": ["property"], "docstring": "The card \"image\", that is, the 80 byte character string that represents\nthis card in an actual FITS header.", "start_line": 498, "end_line": 508, "is_async": false, "is_method": false}, {"name": "is_blank", "qualified_name": "is_blank", "args": ["self"], "decorators": ["property"], "docstring": "`True` if the card is completely blank--that is, it has no keyword,\nvalue, or comment.  It appears in the header as 80 spaces.\n\nReturns `False` otherwise.", "start_line": 511, "end_line": 529, "is_async": false, "is_method": false}, {"name": "fromstring", "qualified_name": "fromstring", "args": ["cls", "image"], "decorators": ["classmethod"], "docstring": "Construct a `Card` object from a (raw) string. It will pad the string\nif it is not the length of a card image (80 columns).  If the card\nimage is longer than 80 columns, assume it contains ``CONTINUE``\ncard(s).", "start_line": 532, "end_line": 543, "is_async": false, "is_method": false}, {"name": "normalize_keyword", "qualified_name": "normalize_keyword", "args": ["cls", "keyword"], "decorators": ["classmethod"], "docstring": "`classmethod` to convert a keyword value that may contain a\nfield-specifier to uppercase.  The effect is to raise the key to\nuppercase and leave the field specifier in its original case.\n\nParameters\n----------\nkeyword : or str\n    A keyword value or a ``keyword.field-specifier`` value", "start_line": 546, "end_line": 577, "is_async": false, "is_method": false}, {"name": "_check_if_rvkc", "qualified_name": "_check_if_rvkc", "args": ["self"], "decorators": [], "docstring": "Determine whether or not the card is a record-valued keyword card.\n\nIf one argument is given, that argument is treated as a full card image\nand parsed as such.  If two arguments are given, the first is treated\nas the card keyword (including the field-specifier if the card is\nintended as a RVKC), and", "start_line": 579, "end_line": 627, "is_async": false, "is_method": false}, {"name": "_check_if_rvkc_image", "qualified_name": "_check_if_rvkc_image", "args": ["self"], "decorators": [], "docstring": "Implements `Card._check_if_rvkc` for the case of an unparsed card\nimage.  If given one argument this is the full intact image.  If given\ntwo arguments the card has already been split between keyword and\nvalue+comment at the standard value indicator '= '.", "start_line": 629, "end_line": 660, "is_async": false, "is_method": false}, {"name": "_init_rvkc", "qualified_name": "_init_rvkc", "args": ["self", "keyword", "field_specifier", "field", "value"], "decorators": [], "docstring": "Sort of addendum to Card.__init__ to set the appropriate internal\nattributes if the card was determined to be a RVKC.", "start_line": 662, "end_line": 673, "is_async": false, "is_method": false}, {"name": "_parse_keyword", "qualified_name": "_parse_keyword", "args": ["self"], "decorators": [], "docstring": "", "start_line": 675, "end_line": 713, "is_async": false, "is_method": false}, {"name": "_parse_value", "qualified_name": "_parse_value", "args": ["self"], "decorators": [], "docstring": "Extract the keyword value from the card image.", "start_line": 715, "end_line": 780, "is_async": false, "is_method": false}, {"name": "_parse_comment", "qualified_name": "_parse_comment", "args": ["self"], "decorators": [], "docstring": "Extract the keyword value from the card image.", "start_line": 782, "end_line": 804, "is_async": false, "is_method": false}, {"name": "_split", "qualified_name": "_split", "args": ["self"], "decorators": [], "docstring": "Split the card image between the keyword and the rest of the card.", "start_line": 806, "end_line": 836, "is_async": false, "is_method": false}, {"name": "_fix_keyword", "qualified_name": "_fix_keyword", "args": ["self"], "decorators": [], "docstring": "", "start_line": 838, "end_line": 844, "is_async": false, "is_method": false}, {"name": "_fix_value", "qualified_name": "_fix_value", "args": ["self"], "decorators": [], "docstring": "Fix the card image for fixable non-standard compliance.", "start_line": 846, "end_line": 884, "is_async": false, "is_method": false}, {"name": "_format_keyword", "qualified_name": "_format_keyword", "args": ["self"], "decorators": [], "docstring": "", "start_line": 886, "end_line": 896, "is_async": false, "is_method": false}, {"name": "_format_value", "qualified_name": "_format_value", "args": ["self"], "decorators": [], "docstring": "", "start_line": 898, "end_line": 926, "is_async": false, "is_method": false}, {"name": "_format_comment", "qualified_name": "_format_comment", "args": ["self"], "decorators": [], "docstring": "", "start_line": 928, "end_line": 932, "is_async": false, "is_method": false}, {"name": "_format_image", "qualified_name": "_format_image", "args": ["self"], "decorators": [], "docstring": "", "start_line": 934, "end_line": 981, "is_async": false, "is_method": false}, {"name": "_format_long_image", "qualified_name": "_format_long_image", "args": ["self"], "decorators": [], "docstring": "Break up long string value/comment into ``CONTINUE`` cards.\nThis is a primitive implementation: it will put the value\nstring in one block and the comment string in another.  Also,\nit does not break at the blank space between words.  So it may\nnot look pretty.", "start_line": 983, "end_line": 1033, "is_async": false, "is_method": false}, {"name": "_format_long_commentary_image", "qualified_name": "_format_long_commentary_image", "args": ["self"], "decorators": [], "docstring": "If a commentary card's value is too long to fit on a single card, this\nwill render the card as multiple consecutive commentary card of the\nsame type.", "start_line": 1035, "end_line": 1049, "is_async": false, "is_method": false}, {"name": "_verify", "qualified_name": "_verify", "args": ["self", "option"], "decorators": [], "docstring": "", "start_line": 1051, "end_line": 1139, "is_async": false, "is_method": false}, {"name": "_itersubcards", "qualified_name": "_itersubcards", "args": ["self"], "decorators": [], "docstring": "If the card image is greater than 80 characters, it should consist of a\nnormal card followed by one or more CONTINUE card.  This method returns\nthe subcards that make up this logical card.", "start_line": 1141, "end_line": 1160, "is_async": false, "is_method": false}], "classes": [{"name": "Undefined", "bases": [], "methods": ["__init__"], "docstring": "Undefined value.", "start_line": 30, "end_line": 35}, {"name": "Card", "bases": ["_Verify"], "methods": ["__init__", "__repr__", "__str__", "__len__", "__getitem__", "keyword", "keyword", "value", "value", "value", "rawkeyword", "rawvalue", "comment", "comment", "comment", "field_specifier", "field_specifier", "field_specifier", "image", "is_blank", "fromstring", "normalize_keyword", "_check_if_rvkc", "_check_if_rvkc_image", "_init_rvkc", "_parse_keyword", "_parse_value", "_parse_comment", "_split", "_fix_keyword", "_fix_value", "_format_keyword", "_format_value", "_format_comment", "_format_image", "_format_long_image", "_format_long_commentary_image", "_verify", "_itersubcards"], "docstring": "", "start_line": 41, "end_