 ["self"], "decorators": [], "docstring": "", "start_line": 122, "end_line": 128, "is_async": false, "is_method": false}, {"name": "_perform_clip", "qualified_name": "_perform_clip", "args": ["self", "_filtered_data", "axis"], "decorators": [], "docstring": "Perform sigma clip by comparing the data to the minimum and\nmaximum values (median + sig * standard deviation). Use\nsigma_lower and sigma_upper to get the correct limits. Data\nvalues less or greater than the minimum / maximum values\nwill have True set in the mask array.", "start_line": 130, "end_line": 158, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "data", "axis", "copy"], "decorators": [], "docstring": "Perform sigma clipping on the provided data.\n\nParameters\n----------\ndata : array-like\n    The data to be sigma clipped.\naxis : int or `None`, optional\n    If not `None`, clip along the given axis.  For this case,\n    ``axis`` will be passed on to ``cenfunc`` and ``stdfunc``,\n    which are expected t", "start_line": 160, "end_line": 213, "is_async": false, "is_method": false}], "classes": [{"name": "SigmaClip", "bases": [], "methods": ["__init__", "__repr__", "__str__", "_perform_clip", "__call__"], "docstring": "Class to perform sigma clipping.\n\nThe data will be iterated over, each time rejecting points that are\ndiscrepant by more than a specified number of standard deviations\nfrom a center value. If the data contains invalid values (NaNs or\ninfs), they are automatically masked before performing the sigma\nc", "start_line": 11, "end_line": 213}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/stats/circstats.py", "file_hash": "fae1ea9b444cb1ad61241a0e5ebc647c23d560c2d6f1c435ba970dc0ae9514e5", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "astropy.units", "names": ["Quantity"], "is_from": true, "alias": ""}, {"module": "scipy.stats", "names": ["norm"], "is_from": true, "alias": ""}], "functions": [{"name": "_components", "qualified_name": "_components", "args": ["data", "p", "phi", "axis", "weights"], "decorators": [], "docstring": "", "start_line": 21, "end_line": 34, "is_async": false, "is_method": false}, {"name": "_angle", "qualified_name": "_angle", "args": ["data", "p", "phi", "axis", "weights"], "decorators": [], "docstring": "", "start_line": 37, "end_line": 48, "is_async": false, "is_method": false}, {"name": "_length", "qualified_name": "_length", "args": ["data", "p", "phi", "axis", "weights"], "decorators": [], "docstring": "", "start_line": 51, "end_line": 54, "is_async": false, "is_method": false}, {"name": "circmean", "qualified_name": "circmean", "args": ["data", "axis", "weights"], "decorators": [], "docstring": "Computes the circular mean angle of an array of circular data.\n\nParameters\n----------\ndata : numpy.ndarray or Quantity\n    Array of circular (directional) data, which is assumed to be in\n    radians whenever ``data`` is ``numpy.ndarray``.\naxis : int, optional\n    Axis along which circular means are ", "start_line": 57, "end_line": 96, "is_async": false, "is_method": false}, {"name": "circvar", "qualified_name": "circvar", "args": ["data", "axis", "weights"], "decorators": [], "docstring": "Computes the circular variance of an array of circular data.\n\nThere are some concepts for defining measures of dispersion for circular\ndata. The variance implemented here is based on the definition given by\n[1]_, which is also the same used by the R package 'CircStats' [2]_.\n\nParameters\n----------\nd", "start_line": 99, "end_line": 149, "is_async": false, "is_method": false}, {"name": "circmoment", "qualified_name": "circmoment", "args": ["data", "p", "centered", "axis", "weights"], "decorators": [], "docstring": "Computes the ``p``-th trigonometric circular moment for an array\nof circular data.\n\nParameters\n----------\ndata : numpy.ndarray or Quantity\n    Array of circular (directional) data, which is assumed to be in\n    radians whenever ``data`` is ``numpy.ndarray``.\np : float, optional\n    Order of the circ", "start_line": 152, "end_line": 204, "is_async": false, "is_method": false}, {"name": "circcorrcoef", "qualified_name": "circcorrcoef", "args": ["alpha", "beta", "axis", "weights_alpha", "weights_beta"], "decorators": [], "docstring": "Computes the circular correlation coefficient between two array of\ncircular data.\n\nParameters\n----------\nalpha : numpy.ndarray or Quantity\n    Array of circular (directional) data, which is assumed to be in\n    radians whenever ``data`` is ``numpy.ndarray``.\nbeta : numpy.ndarray or Quantity\n    Arra", "start_line": 207, "end_line": 268, "is_async": false, "is_method": false}, {"name": "rayleightest", "qualified_name": "rayleightest", "args": ["data", "axis", "weights"], "decorators": [], "docstring": "Performs the Rayleigh test of uniformity.\n\nThis test is  used to identify a non-uniform distribution, i.e. it is\ndesigned for detecting an unimodal deviation from uniformity. More\nprecisely, it assumes the following hypotheses:\n- H0 (null hypothesis): The population is distributed uniformly around t", "start_line": 271, "end_line": 335, "is_async": false, "is_method": false}, {"name": "vtest", "qualified_name": "vtest", "args": ["data", "mu", "axis", "weights"], "decorators": [], "docstring": "Performs the Rayleigh test of uniformity where the alternative\nhypothesis H1 is assumed to have a known mean angle ``mu``.\n\nParameters\n----------\ndata : numpy.ndarray or Quantity\n    Array of circular (directional) data, which is assumed to be in\n    radians whenever ``data`` is ``numpy.ndarray``.\nm", "start_line": 338, "end_line": 398, "is_async": false, "is_method": false}, {"name": "_A1inv", "qualified_name": "_A1inv", "args": ["x"], "decorators": [], "docstring": "", "start_line": 401, "end_line": 409, "is_async": false, "is_method": false}, {"name": "vonmisesmle", "qualified_name": "vonmisesmle", "args": ["data", "axis"], "decorators": [], "docstring": "Computes the Maximum Likelihood Estimator (MLE) for the parameters of\nthe von Mises distribution.\n\nParameters\n----------\ndata : numpy.ndarray or Quantity\n    Array of circular (directional) data, which is assumed to be in\n    radians whenever ``data`` is ``numpy.ndarray``.\naxis : int, optional\n    A", "start_line": 412, "end_line": 451, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This module contains simple functions for dealing with circular statistics, for\ninstance, mean, variance, standard deviation, correlation coefficient, and so\non. This module also cover tests of uniformity, e.g., the Rayleigh and V tests.\nThe Maximum Likelihood Estimator for the Von Mises distribution along with the\nCramer-Rao Lower Bounds are also implemented. Almost all of the implementations\nare based on reference [1]_, which is also the basis for the R package\n'CircStats' [2]_.", "parse_error": ""}, {"file_path": "astropy/stats/bayesian_blocks.py", "file_hash": "e3e6eb66476d9d5040c0a4a432615db8e3acb985ad92129119ac911007683332", "imports": [{"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "inspect", "names": ["signature"], "is_from": true, "alias": ""}, {"module": "utils.exceptions", "names": ["AstropyUserWarning"], "is_from": true, "alias": ""}], "functions": [{"name": "bayesian_blocks", "qualified_name": "bayesian_blocks", "args": ["t", "x", "sigma", "fitness"], "decorators": [], "docstring": "Compute optimal segmentation of data with Scargle's Bayesian Blocks\n\nThis is a flexible implementation of the Bayesian Blocks algorithm\ndescribed in Scargle 2012 [1]_.\n\nParameters\n----------\nt : array_like\n    data times (one dimensional, length N)\nx : array_like (optional)\n    data values\nsigma : a", "start_line": 54, "end_line": 154, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "p0", "gamma", "ncp_prior"], "decorators": [], "docstring": "", "start_line": 193, "end_line": 196, "is_async": false, "is_method": false}, {"name": "validate_input", "qualified_name": "validate_input", "args": ["self", "t", "x", "sigma"], "decorators": [], "docstring": "Validate inputs to the model.\n\nParameters\n----------\nt : array_like\n    times of observations\nx : array_like (optional)\n    values observed at each time\nsigma : float or array_like (optional)\n    errors in values x\n\nReturns\n-------\nt, x, sigma : array_like, float or None\n    validated and perhaps mo", "start_line": 198, "end_line": 265, "is_async": false, "is_method": false}, {"name": "fitness", "qualified_name": "fitness", "args": ["self"], "decorators": [], "docstring": "", "start_line": 267, "end_line": 268, "is_async": false, "is_method": false}, {"name": "p0_prior", "qualified_name": "p0_prior", "args": ["self", "N"], "decorators": [], "docstring": "Empirical prior, parametrized by the false alarm probability ``p0``\nSee  eq. 21 in Scargle (2012)\n\nNote that there was an error in this equation in the original Scargle\npaper (the \"log\" was missing). The following corrected form is taken\nfrom https://arxiv.org/abs/1304.2818", "start_line": 270, "end_line": 279, "is_async": false, "is_method": false}, {"name": "_fitness_args", "qualified_name": "_fitness_args", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 284, "end_line": 285, "is_async": false, "is_method": false}, {"name": "compute_ncp_prior", "qualified_name": "compute_ncp_prior", "args": ["self", "N"], "decorators": [], "docstring": "If ``ncp_prior`` is not explicitly defined, compute it from ``gamma``\nor ``p0``.", "start_line": 287, "end_line": 300, "is_async": false, "is_method": false}, {"name": "fit", "qualified_name": "fit", "args": ["self", "t", "x", "sigma"], "decorators": [], "docstring": "Fit the Bayesian Blocks model given the specified fitness function.\n\nParameters\n----------\nt : array_like\n    data times (one dimensional, length N)\nx : array_like (optional)\n    data values\nsigma : array_like or float (optional)\n    data errors\n\nReturns\n-------\nedges : ndarray\n    array containing ", "start_line": 302, "end_line": 394, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "p0", "gamma", "ncp_prior"], "decorators": [], "docstring": "", "start_line": 421, "end_line": 428, "is_async": false, "is_method": false}, {"name": "fitness", "qualified_name": "fitness", "args": ["self", "N_k", "T_k"], "decorators": [], "docstring": "", "start_line": 430, "end_line": 432, "is_async": false, "is_method": false}, {"name": "validate_input", "qualified_name": "validate_input", "args": ["self", "t", "x", "sigma"], "decorators": [], "docstring": "", "start_line": 434, "end_line": 438, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "dt", "p0", "gamma", "ncp_prior"], "decorators": [], "docstring": "", "start_line": 462, "end_line": 464, "is_async": false, "is_method": false}, {"name": "validate_input", "qualified_name": "validate_input", "args": ["self", "t", "x", "sigma"], "decorators": [], "docstring": "", "start_line": 466, "end_line": 470, "is_async": false, "is_method": false}, {"name": "fitness", "qualified_name": "fitness", "args": ["self", "T_k", "N_k"], "decorators": [], "docstring": "", "start_line": 472, "end_line": 486, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "p0", "gamma", "ncp_prior"], "decorators": [], "docstring": "", "start_line": 504, "end_line": 505, "is_async": false, "is_method": false}, {"name": "fitness", "qualified_name": "fitness", "args": ["self", "a_k", "b_k"], "decorators": [], "docstring": "", "start_line": 507, "end_line": 509, "is_async": false, "is_method": false}, {"name": "validate_input", "qualified_name": "validate_input", "args": ["self", "t", "x", "sigma"], "decorators": [], "docstring": "", "start_line": 511, "end_line": 514, "is_async": false, "is_method": false}], "classes": [{"name": "FitnessFunc", "bases": [], "methods": ["__init__", "validate_input", "fitness", "p0_prior", "_fitness_args", "compute_ncp_prior", "fit"], "docstring": "Base class for bayesian blocks fitness functions\n\nDerived classes should overload the following method:\n\n``fitness(self, **kwargs)``:\n  Compute the fitness given a set of named arguments.\n  Arguments accepted by fitness must be among ``[T_k, N_k, a_k, b_k, c_k]``\n  (See [1]_ for details on the meani", "start_line": 157, "end_line": 394}, {"name": "Events", "bases": ["FitnessFunc"], "methods": ["__init__", "fitness", "validate_input"], "docstring": "Bayesian blocks fitness for binned or unbinned events\n\nParameters\n----------\np0 : float (optional)\n    False alarm probability, used to compute the prior on\n    :math:`N_{\\rm blocks}` (see eq. 21 of Scargle 2012). For the Events\n    type data, ``p0`` does not seem to be an accurate representation of", "start_line": 397, "end_line": 438}, {"name": "RegularEvents", "bases": ["FitnessFunc"], "methods": ["__init__", "validate_input", "fitness"], "docstring": "Bayesian blocks fitness for regular events\n\nThis is for data which has a fundamental \"tick\" length, so that all\nmeasured values are multiples of this tick length.  In each tick, there\nare either zero or one counts.\n\nParameters\n----------\ndt : float\n    tick rate for data\np0 : float (optional)\n    Fa", "start_line": 441, "end_line": 486}, {"name": "PointMeasures", "bases": ["FitnessFunc"], "methods": ["__init__", "fitness", "validate_input"], "docstring": "Bayesian blocks fitness for point measures\n\nParameters\n----------\np0 : float (optional)\n    False alarm probability, used to compute the prior on :math:`N_{\\rm\n    blocks}` (see eq. 21 of Scargle 2012). If gamma is specified, p0 is\n    ignored.\nncp_prior : float (optional)\n    If specified, use the ", "start_line": 489, "end_line": 514}], "calls": [], "module_docstring": "Bayesian Blocks for Time Series Analysis\n========================================\n\nDynamic programming algorithm for solving a piecewise-constant model for\nvarious datasets. This is based on the algorithm presented in Scargle\net al 2012 [1]_. This code was ported from the astroML project [2]_.\n\nApplications include:\n\n- finding an optimal histogram with adaptive bin widths\n- finding optimal segmentation of time series data\n- detecting inflection points in the rate of event data\n\nThe primary interface to these routines is the :func:`bayesian_blocks`\nfunction. This module provides fitness functions suitable for three types\nof data:\n\n- Irregularly-spaced event data via the :class:`Events` class\n- Regularly-spaced event data via the :class:`RegularEvents` class\n- Irregularly-spaced point measurements via the :class:`PointMeasures` class\n\nFor more fine-tuned control over the fitness functions used, it is possible\nto define custom :class:`FitnessFunc` classes directly and use them with\nthe :func:`bayesian_blocks` routine.\n\nOne common application of the Bayesian Blocks algorithm is the determination\nof optimal adaptive-width histogram bins. This uses the same fitness function\nas for irregularly-spaced time series events. The easiest interface for\ncreating Bayesian Blocks histograms is the :func:`astropy.stats.histogram`\nfunction.\n\nReferences\n----------\n.. [1] http://adsabs.harvard.edu/abs/2012arXiv1207.5578S\n.. [2] http://astroML.org/ https://github.com//astroML/astroML/", "parse_error": ""}, {"file_path": "astropy/stats/__init__.py", "file_hash": "57290e5210c5681afd7178c4491ad792ac1b14e257c1a1b94cc1985dcdbc47da", "imports": [{"module": "funcs", "names": ["*"], "is_from": true, "alias": ""}, {"module": "biweight", "names": ["*"], "is_from": true, "alias": ""}, {"module": "sigma_clipping", "names": ["*"], "is_from": true, "alias": ""}, {"module": "jackknife", "names": ["*"], "is_from": true, "alias": ""}, {"module": "circstats", "names": ["*"], "is_from": true, "alias": ""}, {"module": "bayesian_blocks", "names": ["*"], "is_from": true, "alias": ""}, {"module": "histogram", "names": ["*"], "is_from": true, "alias": ""}, {"module": "info_theory", "names": ["*"], "is_from": true, "alias": ""}, {"module": "lombscargle", "names": ["*"], "is_from": true, "alias": ""}, {"module": "spatial", "names": ["*"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "This subpackage contains statistical tools provided for or used by Astropy.\n\nWhile the `scipy.stats` package contains a wide range of statistical\ntools, it is a general-purpose package, and is missing some that are\nparticularly useful to astronomy or are used in an atypical way in\nastronomy. This package is intended to provide such functionality, but\n*not* to replace `scipy.stats` if its implementation satisfies\nastronomers' needs.", "parse_error": ""}, {"file_path": "astropy/stats/histogram.py", "file_hash": "7e5b44e45cab1846754f344d45f9a03e2a140c511445b28b6571316019f948b6", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "", "names": ["bayesian_blocks"], "is_from": true, "alias": ""}, {"module": "scipy", "names": ["optimize"], "is_from": true, "alias": ""}, {"module": "scipy", "names": ["special"], "is_from": true, "alias": ""}], "functions": [{"name": "histogram", "qualified_name": "histogram", "args": ["a", "bins", "range", "weights"], "decorators": [], "docstring": "Enhanced histogram function, providing adaptive binnings\n\nThis is a histogram function that enables the use of more sophisticated\nalgorithms for determining bins.  Aside from the ``bins`` argument allowing\na string specified how bins are computed, the parameters are the same\nas ``numpy.histogram()``", "start_line": 18, "end_line": 90, "is_async": false, "is_method": false}, {"name": "scott_bin_width", "qualified_name": "scott_bin_width", "args": ["data", "return_bins"], "decorators": [], "docstring": "Return the optimal histogram bin width using Scott's rule\n\nScott's rule is a normal reference rule: it minimizes the integrated\nmean squared error in the bin approximation under the assumption that the\ndata is approximately Gaussian.\n\nParameters\n----------\ndata : array-like, ndim=1\n    observed (one", "start_line": 93, "end_line": 151, "is_async": false, "is_method": false}, {"name": "freedman_bin_width", "qualified_name": "freedman_bin_width", "args": ["data", "return_bins"], "decorators": [], "docstring": "Return the optimal histogram bin width using the Freedman-Diaconis rule\n\nThe Freedman-Diaconis rule is a normal reference rule like Scott's\nrule, but uses rank-based statistics for results which are more robust\nto deviations from a normal distribution.\n\nParameters\n----------\ndata : array-like, ndim=", "start_line": 154, "end_line": 215, "is_async": false, "is_method": false}, {"name": "knuth_bin_width", "qualified_name": "knuth_bin_width", "args": ["data", "return_bins", "quiet"], "decorators": [], "docstring": "Return the optimal histogram bin width using Knuth's rule.\n\nKnuth's rule is a fixed-width, Bayesian approach to determining\nthe optimal bin width of a histogram.\n\nParameters\n----------\ndata : array-like, ndim=1\n    observed (one-dimensional) data\nreturn_bins : bool (optional)\n    if True, then retur", "start_line": 218, "end_line": 278, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "data"], "decorators": [], "docstring": "", "start_line": 306, "end_line": 319, "is_async": false, "is_method": false}, {"name": "bins", "qualified_name": "bins", "args": ["self", "M"], "decorators": [], "docstring": "Return the bin edges given a width dx", "start_line": 321, "end_line": 323, "is_async": false, "is_method": false}, {"name": "__call__", "qualified_name": "__call__", "args": ["self", "M"], "decorators": [], "docstring": "", "start_line": 325, "end_line": 326, "is_async": false, "is_method": false}, {"name": "eval", "qualified_name": "eval", "args": ["self", "M"], "decorators": [], "docstring": "Evaluate the Knuth function\n\nParameters\n----------\ndx : float\n    Width of bins\n\nReturns\n-------\nF : float\n    evaluation of the negative Knuth likelihood function:\n    smaller values indicate a better fit.", "start_line": 328, "end_line": 354, "is_async": false, "is_method": false}], "classes": [{"name": "_KnuthF", "bases": [], "methods": ["__init__", "bins", "__call__", "eval"], "docstring": "Class which implements the function minimized by knuth_bin_width\n\nParameters\n----------\ndata : array-like, one dimension\n    data to be histogrammed\n\nNotes\n-----\nthe function F is given by\n\n.. math::\n    F(M|x,I) = n\\log(M) + \\log\\Gamma(\\frac{M}{2})\n    - M\\log\\Gamma(\\frac{1}{2})\n    - \\log\\Gamma(\\f", "start_line": 281, "end_line": 354}], "calls": [], "module_docstring": "Methods for selecting the bin width of histograms\n\nPorted from the astroML project: http://astroML.org/", "parse_error": ""}, {"file_path": "astropy/stats/info_theory.py", "file_hash": "2f536f287346a69180458203b7f150bd7c7607a25aab558ce1720e4ce0d18c75", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}], "functions": [{"name": "bayesian_info_criterion", "qualified_name": "bayesian_info_criterion", "args": ["log_likelihood", "n_params", "n_samples"], "decorators": [], "docstring": "Computes the Bayesian Information Criterion (BIC) given the log of the\nlikelihood function evaluated at the estimated (or analytically derived)\nparameters, the number of parameters, and the number of samples.\n\nThe BIC is usually applied to decide whether increasing the number of free\nparameters (hen", "start_line": 16, "end_line": 112, "is_async": false, "is_method": false}, {"name": "bayesian_info_criterion_lsq", "qualified_name": "bayesian_info_criterion_lsq", "args": ["ssr", "n_params", "n_samples"], "decorators": [], "docstring": "Computes the Bayesian Information Criterion (BIC) assuming that the\nobservations come from a Gaussian distribution.\n\nIn this case, BIC is given as\n\n.. math::\n\n    \\mathrm{BIC} = n\\ln\\left(\\dfrac{\\mathrm{SSR}}{n}\\right) + k\\ln(n)\n\nin which :math:`n` is the sample size, :math:`k` is the number of free", "start_line": 115, "end_line": 196, "is_async": false, "is_method": false}, {"name": "akaike_info_criterion", "qualified_name": "akaike_info_criterion", "args": ["log_likelihood", "n_params", "n_samples"], "decorators": [], "docstring": "Computes the Akaike Information Criterion (AIC).\n\nLike the Bayesian Information Criterion, the AIC is a measure of\nrelative fitting quality which is used for fitting evaluation and model\nselection. The decision is in favor of the model with the lowest AIC.\n\nAIC is given as\n\n.. math::\n\n    \\mathrm{AI", "start_line": 199, "end_line": 302, "is_async": false, "is_method": false}, {"name": "akaike_info_criterion_lsq", "qualified_name": "akaike_info_criterion_lsq", "args": ["ssr", "n_params", "n_samples"], "decorators": [], "docstring": "Computes the Akaike Information Criterion assuming that the observations\nare Gaussian distributed.\n\nIn this case, AIC is given as\n\n.. math::\n\n    \\mathrm{AIC} = n\\ln\\left(\\dfrac{\\mathrm{SSR}}{n}\\right) + 2k\n\nIn case that the sample size is not \"large enough\", a correction is\napplied, i.e.\n\n.. math::", "start_line": 305, "end_line": 401, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "This module contains simple functions for model selection.", "parse_error": ""}, {"file_path": "astropy/stats/spatial.py", "file_hash": "c7e7f05997296765746f4db5c2598e350b6aa478e4d3b73d08804b2ff68600cb", "imports": [{"module": "numpy", "names": [], "is_from": false, "ali