 all remote tests. With this metaclass, we can modify sys.argv\nbefore di", "start_line": 17, "end_line": 41}, {"name": "AstropyTest", "bases": ["Command"], "methods": ["initialize_options", "finalize_options", "generate_testing_command", "run", "_build_temp_install", "_generate_coverage_commands"], "docstring": "", "start_line": 44, "end_line": 303}], "calls": [], "module_docstring": "Implements the wrapper for the Astropy test runner in the form of the\n``./setup.py test`` distutils command.", "parse_error": ""}, {"file_path": "astropy/tests/image_tests.py", "file_hash": "038f4928440cba205888d217cb38a6eec161733d643346ed5df13b3720a4c832", "imports": [{"module": "distutils.version", "names": ["LooseVersion"], "is_from": true, "alias": ""}, {"module": "matplotlib", "names": [], "is_from": false, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/tests/disable_internet.py", "file_hash": "764720ca5eb566100d7c4ab7a6cf4e6bd965521d1e16e6632c150dc5aa28e703", "imports": [{"module": "warnings", "names": ["warn"], "is_from": true, "alias": ""}, {"module": "utils.exceptions", "names": ["AstropyDeprecationWarning"], "is_from": true, "alias": ""}, {"module": "pytest_remotedata.disable_internet", "names": ["*"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "This is retained only for backwards compatibility. Affiliated packages\nshould no longer import ``disable_internet`` from ``astropy.tests``. It is\nnow available from ``pytest_remotedata``. However, this is not the\nrecommended mechanism for controlling access to remote data in tests.\nInstead, packages should make use of decorators provided by the\npytest_remotedata plugin: - ``@pytest.mark.remote_data`` for tests that\nrequire remote data access - ``@pytest.mark.internet_off`` for tests that\nshould only run when remote data access is disabled.  Remote data access for\nthe test suite is controlled by the ``--remote-data`` command line flag. This\nis either passed to ``pytest`` directly or to the ``setup.py test`` command.\n\nTODO: This module should eventually be removed once backwards compatibility\nis no longer supported.", "parse_error": ""}, {"file_path": "astropy/tests/test_logger.py", "file_hash": "2a7784b155ea6b5268bd954bb46cf5da42f5de95b7d967f44fdd3aed5bc97483", "imports": [{"module": "importlib", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "pytest", "names": [], "is_from": false, "alias": ""}, {"module": "helper", "names": ["catch_warnings"], "is_from": true, "alias": ""}, {"module": "", "names": ["log"], "is_from": true, "alias": ""}, {"module": "logger", "names": ["LoggingError", "conf"], "is_from": true, "alias": ""}, {"module": "utils.exceptions", "names": ["AstropyWarning", "AstropyUserWarning"], "is_from": true, "alias": ""}, {"module": "io.votable.exceptions", "names": ["W02", "vo_warn"], "is_from": true, "alias": ""}, {"module": "utils.collections", "names": ["HomogeneousList"], "is_from": true, "alias": ""}], "functions": [{"name": "setup_function", "qualified_name": "setup_function", "args": ["function"], "decorators": [], "docstring": "", "start_line": 29, "end_line": 46, "is_async": false, "is_method": false}, {"name": "test_warnings_logging_disable_no_enable", "qualified_name": "test_warnings_logging_disable_no_enable", "args": [], "decorators": [], "docstring": "", "start_line": 52, "end_line": 55, "is_async": false, "is_method": false}, {"name": "test_warnings_logging_enable_twice", "qualified_name": "test_warnings_logging_enable_twice", "args": [], "decorators": [], "docstring": "", "start_line": 58, "end_line": 62, "is_async": false, "is_method": false}, {"name": "test_warnings_logging_overridden", "qualified_name": "test_warnings_logging_overridden", "args": [], "decorators": [], "docstring": 