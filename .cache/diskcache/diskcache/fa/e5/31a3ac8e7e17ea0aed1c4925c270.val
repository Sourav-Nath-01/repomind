is_async": false, "is_method": false}, {"name": "isatty", "qualified_name": "isatty", "args": ["file"], "decorators": [], "docstring": "Returns `True` if ``file`` is a tty.\n\nMost built-in Python file-like objects have an `isatty` member,\nbut some user-defined types may not, so this assumes those are not\nttys.", "start_line": 133, "end_line": 171, "is_async": false, "is_method": false}, {"name": "terminal_size", "qualified_name": "terminal_size", "args": ["file"], "decorators": [], "docstring": "Returns a tuple (height, width) containing the height and width of\nthe terminal.\n\nThis function will look for the width in height in multiple areas\nbefore falling back on the width and height in astropy's\nconfiguration.", "start_line": 174, "end_line": 212, "is_async": false, "is_method": false}, {"name": "_color_text", "qualified_name": "_color_text", "args": ["text", "color"], "decorators": [], "docstring": "Returns a string wrapped in ANSI color codes for coloring the\ntext in a terminal::\n\n    colored_text = color_text('Here is a message', 'blue')\n\nThis won't actually effect the text until it is printed to the\nterminal.\n\nParameters\n----------\ntext : str\n    The string to return, bounded by the color co", "start_line": 215, "end_line": 259, "is_async": false, "is_method": false}, {"name": "_decode_preferred_encoding", "qualified_name": "_decode_preferred_encoding", "args": ["s"], "decorators": [], "docstring": "Decode the supplied byte string using the preferred encoding\nfor the locale (`locale.getpreferredencoding`) or, if the default encoding\nis invalid, fall back first on utf-8, then on latin-1 if the message cannot\nbe decoded with utf-8.", "start_line": 262, "end_line": 277, "is_async": false, "is_method": false}, {"name": "_write_with_fallback", "qualified_name": "_write_with_fallback", "args": ["s", "write", "fileobj"], "decorators": [], "docstring": "Write the supplied string with the given write function like\n``write(s)``, but use a writer for the locale's preferred encoding in case\nof a UnicodeEncodeError.  Failing that attempt to write with 'utf-8' or\n'latin-1'.", "start_line": 280, "end_line": 321, "is_async": false, "is_method": false}, {"name": "color_print", "qualified_name": "color_print", "args": [], "decorators": [], "docstring": "Prints colors and styles to the terminal uses ANSI escape\nsequences.\n\n::\n\n   color_print('This is the color ', 'default', 'GREEN', 'green')\n\nParameters\n----------\npositional args : str\n    The positional arguments come in pairs (*msg*, *color*), where\n    *msg* is the string to display and *color* i", "start_line": 324, "end_line": 380, "is_async": false, "is_method": false}, {"name": "strip_ansi_codes", "qualified_name": "strip_ansi_codes", "args": ["s"], "decorators": [], "docstring": "Remove ANSI color codes from the string.", "start_line": 383, "end_line": 387, "is_async": false, "is_method": false}, {"name": "human_time", "qualified_name": "human_time", "args": ["seconds"], "decorators": [], "docstring": "Returns a human-friendly time string that is always exactly 6\ncharacters long.\n\nDepending on the number of seconds given, can be one of::\n\n    1w 3d\n    2d 4h\n    1h 5m\n    1m 4s\n      15s\n\nWill be in color if console coloring is turned on.\n\nParameters\n----------\nseconds : int\n    The number of seco", "start_line": 390, "end_line": 436, "is_async": false, "is_method": false}, {"name": "human_file_size", "qualified_name": "human_file_size", "args": ["size"], "decorators": [], "docstring": "Returns a human-friendly string representing a file size\nthat is 2-4 characters long.\n\nFor example, depending on the number of bytes given, can be one\nof::\n\n    256b\n    64k\n    1.1G\n\nParameters\n----------\nsize : int\n    The size of the file (in bytes)\n\nReturns\n-------\nsize : str\n    A human-friendl", "start_line": 439, "end_line": 485, "is_async": false, "is_method": false}, {"name": "print_code_line", "qualified_name": "print_code_line", "args": ["line", "col", "file", "tabwidth", "width"], "decorators": [], "docstring": "Prints a line of source code, highlighting a particular character\nposition in the line.  Useful for displaying the context of error\nmessages.\n\nIf the line is more than ``width`` characters, the line is truncated\naccordingly and '\u2026' characters are inserted at the front and/or\nend.\n\nIt looks like this", "start_line": 944, "end_line": 1019, "is_async": false, "is_method": false}, {"name": "get_ipython", "qualified_name": "get_ipython", "args": ["cls"], "decorators": ["classproperty"], "docstring": "", "start_line": 44, "end_line": 49, "is_async": false, "is_method": false}, {"name": "OutStream", "qualified_name": "OutStream", "args": ["cls"], "decorators": ["classproperty"], "docstring": "", "start_line": 52, "end_line": 77, "is_async": false, "is_method": false}, {"name": "ipyio", "qualified_name": "ipyio", "args": ["cls"], "decorators": ["classproperty"], "docstring": "", "start_line": 80, "end_line": 88, "is_async": false, "is_method": false}, {"name": "IOStream", "qualified_name": "IOStream", "args": ["cls"], "decorators": ["classproperty"], "docstring": "", "start_line": 91, "end_line": 95, "is_async": false, "is_method": false}, {"name": "get_stream", "qualified_name": "get_stream", "args": ["cls", "stream"], "decorators": ["classmethod"], "docstring": "", "start_line": 98, "end_line": 99, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "total_or_items", "ipython_widget", "file"], "decorators": [], "docstring": "Parameters\n----------\ntotal_or_items : int or sequence\n    If an int, the number of increments in the process being\n    tracked.  If a sequence, the items to iterate over.\n\nipython_widget : bool, optional\n    If `True`, the progress bar will display as an IPython\n    notebook widget.\n\nfile : writabl", "start_line": 504, "end_line": 557, "is_async": false, "is_method": false}, {"na