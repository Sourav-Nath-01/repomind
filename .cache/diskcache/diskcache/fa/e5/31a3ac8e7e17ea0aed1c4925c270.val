a2 <http://jinja.pocoo.org/>`_ must be installed for this\nmodule/script to function.\n\nNote that this does *not* currently automate the process of creating structs\nor dtypes for those structs.  They should be added manually in the template file.", "parse_error": ""}, {"file_path": "astropy/_erfa/setup_package.py", "file_hash": "8fd36b492cbee8454f9cbee7fd14dbb5892d80cc2e2a04325e905b9d67feb423", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "glob", "names": [], "is_from": false, "alias": ""}, {"module": "distutils", "names": ["log"], "is_from": true, "alias": ""}, {"module": "distutils.extension", "names": ["Extension"], "is_from": true, "alias": ""}, {"module": "astropy_helpers", "names": ["setup_helpers"], "is_from": true, "alias": ""}, {"module": "astropy_helpers.version_helpers", "names": ["get_pkg_version_module"], "is_from": true, "alias": ""}, {"module": "importlib", "names": ["machinery"], "is_from": true, "alias": ""}, {"module": "jinja2", "names": [], "is_from": false, "alias": ""}, {"module": "imp", "names": [], "is_from": false, "alias": ""}], "functions": [{"name": "pre_build_py_hook", "qualified_name": "pre_build_py_hook", "args": ["cmd_obj"], "decorators": [], "docstring": "", "start_line": 23, "end_line": 24, "is_async": false, "is_method": false}, {"name": "pre_build_ext_hook", "qualified_name": "pre_build_ext_hook", "args": ["cmd_obj"], "decorators": [], "docstring": "", "start_line": 27, "end_line": 28, "is_async": false, "is_method": false}, {"name": "pre_sdist_hook", "qualified_name": "pre_sdist_hook", "args": ["cmd_obj"], "decorators": [], "docstring": "", "start_line": 31, "end_line": 32, "is_async": false, "is_method": false}, {"name": "preprocess_source", "qualified_name": "preprocess_source", "args": [], "decorators": [], "docstring": "", "start_line": 35, "end_line": 85, "is_async": false, "is_method": false}, {"name": "get_extensions", "qualified_name": "get_extensions", "args": [], "decorators": [], "docstring": "", "start_line": 88, "end_line": 109, "is_async": false, "is_method": false}, {"name": "get_external_libraries", "qualified_name": "get_external_libraries", "args": [], "decorators": [], "docstring": "", "start_line": 112, "end_line": 113, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/stats/jackknife.py", "file_hash": "88ce92a9dfeda529e18ce5a7734e783744571da83453bfaac208dc7e775ddba6", "imports": [{"module": "numpy", "names": [], "is_from": false, "alias": "np"}, {"module": "scipy.special", "names": ["erfinv"], "is_from": true, "alias": ""}], "functions": [{"name": "jackknife_resampling", "qualified_name": "jackknife_resampling", "args": ["data"], "decorators": [], "docstring": "Performs jackknife resampling on numpy arrays.\n\nJackknife resampling is a technique to generate 'n' deterministic samples\nof size 'n-1' from a measured sample of size 'n'. Basically, the i-th\nsample, (1<=i<=n), is generated by means of removing the i-th measurement\nof the original sample. Like the b", "start_line": 10, "end_line": 53, "is_async": false, "is_method": false}, {"name": "jackknife_stats", "qualified_name": "jackknife_stats", "args": ["data", "statistic", "conf_lvl"], "decorators": [], "docstring": "Performs jackknife estimation on the basis of jackknife resamples.\n\nThis function requires `SciPy <https://www.scipy.org/>`_ to be installed.\n\nParameters\n----------\ndata : numpy.ndarray\n    Original sample (1-D array).\nstatistic : function\n    Any function (or vector of functions) on the basis of th", "start_line": 56, "end_line": 177, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "astropy/stats/funcs.py", "file_hash": "444bd19dfcdf9ff143504d21a1e3a6dc27c27906dadbda28319af231a7291d4e", "imports": [{"module": "math", "names": [], "is_from": false, "alias": ""}, {"module": "itertools", "nam