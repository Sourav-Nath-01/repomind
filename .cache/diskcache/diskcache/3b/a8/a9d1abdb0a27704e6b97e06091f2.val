irective to the response.", "start_line": 103, "end_line": 110, "is_async": false, "is_method": false}, {"name": "test_sts_preload", "qualified_name": "test_sts_preload", "args": ["self"], "decorators": ["override_settings(SECURE_HSTS_SECONDS=10886400, SECURE_HSTS_PRELOAD=True)"], "docstring": "With SECURE_HSTS_SECONDS non-zero and SECURE_HSTS_PRELOAD True, the\nmiddleware adds a \"Strict-Transport-Security\" header with the \"preload\"\ndirective to the response.", "start_line": 113, "end_line": 123, "is_async": false, "is_method": false}, {"name": "test_sts_subdomains_and_preload", "qualified_name": "test_sts_subdomains_and_preload", "args": ["self"], "decorators": ["override_settings(SECURE_HSTS_SECONDS=10886400, SECURE_HSTS_INCLUDE_SUBDOMAINS=True, SECURE_HSTS_PRELOAD=True)"], "docstring": "With SECURE_HSTS_SECONDS non-zero, SECURE_HSTS_INCLUDE_SUBDOMAINS and\nSECURE_HSTS_PRELOAD True, the middleware adds a\n\"Strict-Transport-Security\" header containing both the\n\"includeSubDomains\" and \"preload\" directives to the response.", "start_line": 130, "end_line": 141, "is_async": false, "is_method": false}, {"name": "test_sts_no_preload", "qualified_name": "test_sts_no_preload", "args": ["self"], "decorators": ["override_settings(SECURE_HSTS_SECONDS=10886400, SECURE_HSTS_PRELOAD=False)"], "docstring": "With SECURE_HSTS_SECONDS non-zero and SECURE_HSTS_PRELOAD\nFalse, the middleware adds a \"Strict-Transport-Security\" header without\nthe \"preload\" directive to the response.", "start_line": 144, "end_line": 154, "is_async": false, "is_method": false}, {"name": "test_content_type_on", "qualified_name": "test_content_type_on", "args": ["self"], "decorators": ["override_settings(SECURE_CONTENT_TYPE_NOSNIFF=True)"], "docstring": "With SECURE_CONTENT_TYPE_NOSNIFF set to True, the middleware adds\n\"X-Content-Type-Options: nosniff\" header to the response.", "start_line": 157, "end_line": 165, "is_async": false, "is_method": false}, {"name": "test_content_type_already_present", "qualified_name": "test_content_type_already_present", "args": ["self"], "decorators": ["override_settings(SECURE_CONTENT_TYPE_NOSNIFF=True)"], "docstring": "The middleware will not override an \"X-Content-Type-Options\" header\nalready present in the response.", "start_line": 168, "end_line": 176, "is_async": false, "is_method": false}, {"name": "test_content_type_off", "qualified_name": "test_content_type_off", "args": ["self"], "decorators": ["override_settings(SECURE_CONTENT_TYPE_NOSNIFF=False)"], "docstring": "With SECURE_CONTENT_TYPE_NOSNIFF False, the middleware does not add an\n\"X-Content-Type-Options\" header to the response.", "start_line": 179, "end_line": 184, "is_async": false, "is_method": false}, {"name": "test_ssl_redirect_on", "qualified_name": "test_ssl_redirect_on", "args": ["self"], "decorators": ["override_settings(SECURE_SSL_REDIRECT=True)"], "docstring": "With SECURE_SSL_REDIRECT True, the middleware redirects any non-secure\nrequests to the https:// version of the same URL.", "start_line": 187, "end_line": 194, "is_async": false, "is_method": false}, {"name": "test_no_redirect_ssl", "qualified_name": "test_no_redirect_ssl", "args": ["self"], "decorators": ["override_settings(SECURE_SSL_REDIRECT=True)"], "docstring": "The middleware does not redirect secure requests.", "start_line": 197, "end_line": 202, "is_async": false, "is_method": false}, {"name": "test_redirect_exempt", "qualified_name": "test_redirect_exempt", "args": ["self"], "decorators": ["override_settings(SECURE_SSL_REDIRECT=True, SECURE_REDIRECT_EXEMPT=['^insecure/'])"], "docstring": "The middleware does not redirect requests with URL path matching an\nexempt pattern.", "start_line": 205, "end_line": 211, "is_async": false, "is_method": false}, {"name": "test_redirect_ssl_host", "qualified_name": "test_redirect_ssl_host", "args": ["self"], "decorators": ["override_settings(SECURE_SSL_REDIRECT=True, SECURE_SSL_HOST='secure.example.com')"], "docstring": "The middleware 