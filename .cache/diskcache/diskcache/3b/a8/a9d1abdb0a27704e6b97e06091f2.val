d_line": 42, "is_async": false, "is_method": false}, {"name": "rollback", "qualified_name": "rollback", "args": ["using"], "decorators": [], "docstring": "Roll back a transaction.", "start_line": 45, "end_line": 47, "is_async": false, "is_method": false}, {"name": "savepoint", "qualified_name": "savepoint", "args": ["using"], "decorators": [], "docstring": "", "start_line": 50, "end_line": 56, "is_async": false, "is_method": false}, {"name": "savepoint_create", "qualified_name": "savepoint_create", "args": ["using"], "decorators": [], "docstring": "Create a savepoint (if supported and required by the backend) inside the\ncurrent transaction. Return an identifier for the savepoint that will be\nused for the subsequent rollback or commit.", "start_line": 59, "end_line": 65, "is_async": false, "is_method": false}, {"name": "savepoint_rollback", "qualified_name": "savepoint_rollback", "args": ["sid", "using"], "decorators": [], "docstring": "Roll back the most recent savepoint (if one exists). Do nothing if\nsavepoints are not supported.", "start_line": 68, "end_line": 73, "is_async": false, "is_method": false}, {"name": "savepoint_commit", "qualified_name": "savepoint_commit", "args": ["sid", "using"], "decorators": [], "docstring": "Commit the most recent savepoint (if one exists). Do nothing if\nsavepoints are not supported.", "start_line": 76, "end_line": 81, "is_async": false, "is_method": false}, {"name": "clean_savepoints", "qualified_name": "clean_savepoints", "args": ["using"], "decorators": [], "docstring": "Reset the counter used to generate unique savepoint ids in this thread.", "start_line": 84, "end_line": 88, "is_async": false, "is_method": false}, {"name": "get_rollback", "qualified_name": "get_rollback", "args": ["using"], "decorators": [], "docstring": "Get the \"needs rollback\" flag -- for *advanced use* only.", "start_line": 91, "end_line": 93, "is_async": false, "is_method": false}, {"name": "set_rollback", "qualified_name": "set_rollback", "args": ["rollback", "using"], "decorators": [], "docstring": "Set or unset the \"needs rollback\" flag -- for *advanced use* only.\n\nWhen `rollback` is `True`, trigger a rollback when exiting the innermost\nenclosing atomic block that has `savepoint=True` (that's the default). Use\nthis to force a rollback without raising an exception.\n\nWhen `rollback` is `False`, ", "start_line": 96, "end_line": 108, "is_async": false, "is_method": false}, {"name": "mark_for_rollback_on_error", "qualified_name": "mark_for_rollback_on_error", "args": ["using"], "decorators": ["contextmanager"], "docstring": "Internal low-level utility to mark a transaction as \"needs rollback\" when\nan exception is raised while not enforcing the enclosed block to be in a\ntransaction. This is needed by Model.save() and friends to avoid starting a\ntransaction when in autocommit mode and a single query is executed.\n\nIt's equ", "start_line": 112, "end_line": 137, "is_async": false, "is_method": false}, {"name": "on_commit", "qualified_name": "on_commit", "args": ["func", "using", "robust"], "decorators": [], "docstring": "Register `func` to be called when the current transaction is committed.\nIf the current transaction is rolled back, `func` will not be called.", "start_line": 140, "end_line": 145, "is_async": false, "is_method": false}, {"name": "atomic", "qualified_name": "atomic", "args": ["using", "savepoint", "durable"], "decorators": [], "docstring": "", "start_line": 327, "end_line": 334, "is_async": false, "is_method": false}, {"name": "_non_atomic_requests", "qualified_name": "_non_atomic_requests", "args": ["view", "using"], "decorators": [], "docstring": "", "start_line": 337, "end_line": 342, "is_async": false, "is_method": false}, {"name": "non_atomic_requests", "qualified_name": "non_atomic_requests", "args": ["using"], "decorators": [], "docstring": "", "start_line": 345, "end_line": 351, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args":