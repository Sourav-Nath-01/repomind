e"], "decorators": [], "docstring": "", "start_line": 149, "end_line": 158, "is_async": false, "is_method": false}, {"name": "is_internal_request", "qualified_name": "is_internal_request", "args": ["self", "domain", "referer"], "decorators": [], "docstring": "Return True if the referring URL is the same domain as the current\nrequest.", "start_line": 160, "end_line": 166, "is_async": false, "is_method": false}, {"name": "is_ignorable_request", "qualified_name": "is_ignorable_request", "args": ["self", "request", "uri", "domain", "referer"], "decorators": [], "docstring": "Return True if the given request *shouldn't* notify the site managers\naccording to project settings or in situations outlined by the inline\ncomments.", "start_line": 168, "end_line": 193, "is_async": false, "is_method": false}], "classes": [{"name": "CommonMiddleware", "bases": ["MiddlewareMixin"], "methods": ["process_request", "should_redirect_with_slash", "get_full_path_with_slash", "process_response"], "docstring": "\"Common\" middleware for taking care of some basic operations:\n\n    - Forbid access to User-Agents in settings.DISALLOWED_USER_AGENTS\n\n    - URL rewriting: Based on the APPEND_SLASH and PREPEND_WWW settings,\n      append missing slashes and/or prepends missing \"www.\"s.\n\n        - If APPEND_SLASH is s", "start_line": 13, "end_line": 117}, {"name": "BrokenLinkEmailsMiddleware", "bases": ["MiddlewareMixin"], "methods": ["process_response", "send_mail", "is_internal_request", "is_ignorable_request"], "docstring": "", "start_line": 120, "end_line": 193}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/middleware/http.py", "file_hash": "6525d34e042c4fa64a62c228aff2411e3fb96f91371ca759db3bd31fd518a671", "imports": [{"module": "django.utils.cache", "names": ["cc_delim_re", "get_conditional_response", "set_response_etag"], "is_from": true, "alias": ""}, {"module": "django.utils.deprecation", "names": ["MiddlewareMixin"], "is_from": true, "alias": ""}, {"module": "django.utils.http", "names": ["parse_http_date_safe"], "is_from": true, "alias": ""}], "functions": [{"name": "process_response", "qualified_name": "process_response", "args": ["self", "request", "response"], "decorators": [], "docstring": "", "start_line": 14, "end_line": 36, "is_async": false, "is_method": false}, {"name": "needs_etag", "qualified_name": "needs_etag", "args": ["self", "response"], "decorators": [], "docstring": "Return True if an ETag header should be added to response.", "start_line": 38, "end_line": 41, "is_async": false, "is_method": false}], "classes": [{"name": "ConditionalGetMiddleware", "bases": ["MiddlewareMixin"], "methods": ["process_response", "needs_etag"], "docstring": "Handle conditional GET operations. If the response has an ETag or\nLast-Modified header and the request has If-None-Match or\nIf-Modified-Since, replace the response with HttpNotModified. Add an ETag\nheader if needed.", "start_line": 6, "end_line": 41}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/middleware/cache.py", "file_hash": "329da0308611666597bd734ee1a1d932346e40cb9a2e509e286f3248f5dc7533", "imports": [{"module": "time", "names": [], "is_from": false, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.core.cache", "names": ["DEFAULT_CACHE_ALIAS", "caches"], "is_from": true, "alias": ""}, {"module": "django.utils.cache", "names": ["get_cache_key", "get_max_age", "has_vary_header", "learn_cache_key", "patch_response_headers"], "is_from": true, "alias": ""}, {"module": "django.utils.deprecation", "names": ["MiddlewareMixin"], "is_from": true, "alias": ""}, {"module": "django.utils.http", "names": ["parse_http_date_safe"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "get_response"], "decorators": [], "docstring": "", "start_line": 71, "end_line": 76, "is_async": false, "is_method": false}, {"name": "cache", "qualified_name": "cache", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 79, "end_line": 80, "is_async": false, "is_method": false}, {"name": "_should_update_cache", "qualified_name": "_should_update_cache", "args": ["self", "request", "response"], "decorators": [], "docstring": "", "start_line": 82, "end_line": 83, "is_async": false, "is_method": false}, {"name": "process_response", "qualified_name": "process_response", "args": ["self", "request", "response"], "decorators": [], "docstring": "Set the cache, if needed.", "start_line": 85, "end_line": 143, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "get_response"], "decorators": [], "docstring": "", "start_line": 155, "end_line": 158, "is_async": false, "is_method": false}, {"name": "cache", "qualified_name": "cache", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 161, "end_line": 162, "is_async": false, "is_method": false}, {"name": "process_request", "qualified_name": "process_request", "args": ["self", "request"], "decorators": [], "docstring": "Check whether the page is already cached and return the cached\nversion if available.", "start_line": 164, "end_line": 202, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "get_response", "cache_timeout", "page_timeout"], "decorators": [], "docstring": "", "start_line": 213, "end_line": 237, "is_async": false, "is_method": false}], "classes": [{"name": "UpdateCacheMiddleware", "bases": ["MiddlewareMixin"], "methods": ["__init__", "cache", "_should_update_cache", "process_response"], "docstring": "Response-phase cache middleware that updates the cache if the response is\ncacheable.\n\nMust be used as part of the two-part update/fetch cache middleware.\nUpdateCacheMiddleware must be the first piece of middleware in MIDDLEWARE\nso that it'll get called last during the response phase.", "start_line": 61, "end_line": 143}, {"name": "FetchFromCacheMiddleware", "bases": ["MiddlewareMixin"], "methods": ["__init__", "cache", "process_request"], "docstring": "Request-phase cache middleware that fetches a page from the cache.\n\nMust be used as part of the two-part update/fetch cache middleware.\nFetchFromCacheMiddleware must be the last piece of middleware in MIDDLEWARE\nso that it'll get called last during the request phase.", "start_line": 146, "end_line": 202}, {"name": "CacheMiddleware", "bases": ["UpdateCacheMiddleware", "FetchFromCacheMiddleware"], "methods": ["__init__"], "docstring": "Cache middleware that provides basic behavior for many simple sites.\n\nAlso used as the hook point for the cache decorator, which is generated\nusing the decorator-from-middleware utility.", "start_line": 205, "end_line": 237}], "calls": [], "module_docstring": "Cache middleware. If enabled, each Django-powered page will be cached based on\nURL. The canonical way to enable cache middleware is to set\n``UpdateCacheMiddleware`` as your first piece of middleware, and\n``FetchFromCacheMiddleware`` as the last::\n\n    MIDDLEWARE = [\n        'django.middleware.cache.UpdateCacheMiddleware',\n        ...\n        'django.middleware.cache.FetchFromCacheMiddleware'\n    ]\n\nThis is counterintuitive, but correct: ``UpdateCacheMiddleware`` needs to run\nlast during the response phase, which processes middleware bottom-up;\n``FetchFromCacheMiddleware`` needs to run last during the request phase, which\nprocesses middleware top-down.\n\nThe single-class ``CacheMiddleware`` can be used for some simple sites.\nHowever, if any other piece of middleware needs to affect the cache key, you'll\nneed to use the two-part ``UpdateCacheMiddleware`` and\n``FetchFromCacheMiddleware``. This'll most often happen when you're using\nDjango's ``LocaleMiddleware``.\n\nMore details about how the caching works:\n\n* Only GET or HEAD-requests with status code 200 are cached.\n\n* The number of seconds each page is stored for is set by the \"max-age\" section\n  of the response's \"Cache-Control\" header, falling back to the\n  CACHE_MIDDLEWARE_SECONDS setting if the section was not found.\n\n* This middleware expects that a HEAD request is answered with the same\n  response headers exactly like the corresponding GET request.\n\n* When a hit occurs, a shallow copy of the original response object is returned\n  from process_request.\n\n* Pages will be cached based on the contents of the request headers listed in\n  the response's \"Vary\" header.\n\n* This middleware also sets ETag, Last-Modified, Expires and Cache-Control\n  headers on the response object.", "parse_error": ""}, {"file_path": "django/middleware/clickjacking.py", "file_hash": "ac89b65656db94b5ab31345827524122e8b9c6c84033eda6a7225ff7cf713a06", "imports": [{"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.utils.deprecation", "names": ["MiddlewareMixin"], "is_from": true, "alias": ""}], "functions": [{"name": "process_response", "qualified_name": "process_response", "args": ["self", "request", "response"], "decorators": [], "docstring": "", "start_line": 25, "end_line": 38, "is_async": false, "is_method": false}, {"name": "get_xframe_options_value", "qualified_name": "get_xframe_options_value", "args": ["self", "request", "response"], "decorators": [], "docstring": "Get the value to set for the X_FRAME_OPTIONS header. Use the value from\nthe X_FRAME_OPTIONS setting, or 'DENY' if not set.\n\nThis method can be overridden if needed, allowing it to vary based on\nthe request or response.", "start_line": 40, "end_line": 48, "is_async": false, "is_method": false}], "classes": [{"name": "XFrameOptionsMiddleware", "bases": ["MiddlewareMixin"], "methods": ["process_response", "get_xframe_options_value"], "docstring": "Set the X-Frame-Options HTTP header in HTTP responses.\n\nDo not set the header if it's already set or if the response contains\na xframe_options_exempt value set to True.\n\nBy default, set the X-Frame-Options header to 'DENY', meaning the response\ncannot be displayed in a frame, regardless of the site ", "start_line": 12, "end_line": 48}], "calls": [], "module_docstring": "Clickjacking Protection Middleware.\n\nThis module provides a middleware that implements protection against a\nmalicious site loading resources from your site in a hidden frame.", "parse_error": ""}, {"file_path": "django/middleware/csp.py", "file_hash": "481f4c4cbe2d81b0ac3ca8845e8657a5b902379f0dfeda8296096137e988e258", "imports": [{"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.utils.csp", "names": ["CSP", "LazyNonce", "build_policy"], "is_from": true, "alias": ""}, {"module": "django.utils.deprecation", "names": ["MiddlewareMixin"], "is_from": true, "alias": ""}], "functions": [{"name": "get_nonce", "qualified_name": "get_nonce", "args": ["request"], "decorators": [], "docstring": "", "start_line": 6, "end_line": 7, "is_async": false, "is_method": false}, {"name": "process_request", "qualified_name": "process_request", "args": ["self", "request"], "decorators": [], "docstring": "", "start_line": 11, "end_line": 12, "is_async": false, "is_method": false}, {"name": "process_response", "qualified_name": "process_response", "args": ["self", "request", "response"], "decorators": [], "docstring": "", "start_line": 14, "end_line": 33, "is_async": false, "is_method": false}], "classes": [{"name": "ContentSecurityPolicyMiddleware", "bases": ["MiddlewareMixin"], "methods": ["process_request", "process_response"], "docstring": "", "start_line": 10, "end_line": 33}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/middleware/csrf.py", "file_hash": "ae1d82bd6dabbd7f3f67d8294b9f2f2d57a76693fe71edb90f41fd57b6887ebf", "imports": [{"module": "logging", "names": [], "is_from": false, "alias": ""}, {"module": "string", "names": [], "is_from": false, "alias": ""}, {"module": "collections", "names": ["defaultdict"], "is_from": true, "alias": ""}, {"module": "urllib.parse", "names": ["urlsplit"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.core.exceptions", "names": ["DisallowedHost", "ImproperlyConfigured"], "is_from": true, "alias": ""}, {"module": "django.http", "names": ["HttpHeaders", "UnreadablePostError"], "is_from": true, "alias": ""}, {"module": "django.urls", "names": ["get_callable"], "is_from": true, "alias": ""}, {"module": "django.utils.cache", "names": ["patch_vary_headers"], "is_from": true, "alias": ""}, {"module": "django.utils.crypto", "names": ["constant_time_compare", "get_random_string"], "is_from": true, "alias": ""}, {"module": "django.utils.deprecation", "names": ["MiddlewareMixin"], "is_from": true, "alias": ""}, {"module": "django.utils.functional", "names": ["cached_property"], "is_from": true, "alias": ""}, {"module": "django.utils.http", "names": ["is_same_domain"], "is_from": true, "alias": ""}, {"module": "django.utils.log", "names": ["log_response"], "is_from": true, "alias": ""}, {"module": "django.utils.regex_helper", "names": ["_lazy_re_compile"], "is_from": true, "alias": ""}], "functions": [{"name": "_get_failure_view", "qualified_name": "_get_failure_view", "args": [], "decorators": [], "docstring": "Return the view to be used for CSRF rejections.", "start_line": 50, "end_line": 52, "is_async": false, "is_method": false}, {"name": "_get_new_csrf_string", "qualified_name": "_get_new_csrf_string", "args": [], "decorators": [], "docstring": "", "start_line": 55, "end_line": 56, "is_async": false, "is_method": false}, {"name": "_mask_cipher_secret", "qualified_name": "_mask_cipher_secret", "args": ["secret"], "decorators": [], "docstring": "Given a secret (assumed to be a string of CSRF_ALLOWED_CHARS), generate a\ntoken by adding a mask and applying it to the secret.", "start_line": 59, "end_line"