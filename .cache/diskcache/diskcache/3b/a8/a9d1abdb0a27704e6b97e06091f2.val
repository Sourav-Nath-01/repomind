ERROR", "LEVEL_WARNING", "MISSING_AI_DESCRIPTION", "MISSING_AI_DISCLOSURE", "MISSING_DESCRIPTION", "MISSING_HAS_PATCH_FLAG", "MISSING_TICKET_IN_PR_TITLE", "MISSING_TRAC_TICKET", "Message"], "is_from": true, "alias": ""}], "functions": [{"name": "setup_logging", "qualified_name": "setup_logging", "args": ["logger", "gha_formatter"], "decorators": [], "docstring": "", "start_line": 66, "end_line": 86, "is_async": false, "is_method": false}, {"name": "github_request", "qualified_name": "github_request", "args": ["method", "path", "token", "repo", "data", "params"], "decorators": [], "docstring": "Make an authenticated GitHub API request.", "start_line": 89, "end_line": 107, "is_async": false, "is_method": false}, {"name": "get_recent_commit_count", "qualified_name": "get_recent_commit_count", "args": ["pr_author", "repo", "token", "since_days", "max_count"], "decorators": [], "docstring": "Return the number of recent commits by the author, up to max_count.", "start_line": 110, "end_line": 125, "is_async": false, "is_method": false}, {"name": "get_pr_total_changes", "qualified_name": "get_pr_total_changes", "args": ["pr_number", "repo", "token"], "decorators": [], "docstring": "Return total lines changed in the PR (additions + deletions).", "start_line": 128, "end_line": 146, "is_async": false, "is_method": false}, {"name": "get_comment_ids_to_delete", "qualified_name": "get_comment_ids_to_delete", "args": ["pr_number", "repo", "token"], "decorators": [], "docstring": "", "start_line": 149, "end_line": 166, "is_async": false, "is_method": false}, {"name": "strip_html_comments", "qualified_name": "strip_html_comments", "args": ["text"], "decorators": [], "docstring": "Return text with all HTML comments removed.", "start_line": 169, "end_line": 171, "is_async": false, "is_method": false}, {"name": "extract_ticket_id", "qualified_name": "extract_ticket_id", "args": ["pr_body"], "decorators": [], "docstring": "Return the Trac ticket ID string from the PR body, or None.", "start_line": 174, "end_line": 177, "is_async": false, "is_method": false}, {"name": "fetch_trac_ticket", "qualified_name": "fetch_trac_ticket", "args": ["ticket_id"], "decorators": [], "docstring": "Fetch ticket data from the Trac JSON API.\n\nReturns a dict with ticket data on success, TICKET_NOT_FOUND if the\nticket does not exist (HTTP 404), or None on a non-fatal network error\n(the caller should skip the check).", "start_line": 180, "end_line": 208, "is_async": false, "is_method": false}, {"name": "check_trac_ticket", "qualified_name": "check_trac_ticket", "args": ["pr_body", "total_changes", "threshold"], "decorators": [], "docstring": "A Trac ticket must be referenced in the ticket section.\n\nFor PRs with fewer than threshold lines changed, \"N/A\" is also accepted\n(e.g. for typo fixes). Larger PRs must reference a ticket.", "start_line": 211, "end_line": 238, "is_async": false, "is_method": false}, {"name": "check_trac_status", "qualified_name": "check_trac_status", "args": ["ticket_id", "ticket_data"], "decorators": [], "docstring": "The referenced Trac ticket must be Accepted or Ready for checkin,\nunresolved, and assigned.\n\nticket_data is the dict returned by fetch_trac_ticket(). Passing None\nskips the check (non-fatal fetch error). Passing TICKET_NOT_FOUND fails\nwith a generic not-ready message.", "start_line": 241, "end_line": 271, "is_async": false, "is_method": false}, {"name": "check_trac_has_patch", "qualified_name": "check_trac_has_patch", "args": ["ticket_id", "initial_data", "poll_interval", "poll_timeout"], "decorators": [], "docstring": "The referenced Trac ticket must have has_patch=1.\n\nUses initial_data (the dict returned by fetch_trac_ticket()) on the first\ncheck, then polls via fetch_trac_ticket() every poll_interval seconds for\nup to poll_timeout seconds. Set poll_timeout=0 for a single check with no\nretries. Passing None for i", "start_line": 274, "end_line": 318, "is_async": false, "is_method": false}, {"name": "check_pr_title_has_ticket", "qualified_name": "check_pr_title_has_ticket", "args": ["pr_title", "ticket_id"], "decorators": [], "docstring": "The PR title must include the ticket number (e.g. #36991).\n\nThis enables Trac's auto-link feature, which associates the PR with the\nticket when the title follows the commit message format.", "start_line": 321, "end_line": 329, "is_async": false, "is_method": false}, {"name": "check_branch_description", "qualified_name": "check_branch_description", "args": ["pr_body"], "decorators": [], "docstring": "The branch description must be present.\n\nThe description should not contain the placeholder, and should be at least\n5 words long.", "start_line": 332, "end_line": 357, "is_async": false, "is_method": false}, {"name": "check_ai_disclosure", "qualified_name": "check_ai_disclosure", "args": ["pr_body"], "decorators": [], "docstring": "Exactly one AI disclosure checkbox must be selected.\n\nIf the \"AI tools were used\" option is checked, at least 5 words of\nadditional description must be present in that section.", "start_line": 360, "end_line": 397, "is_async": false, "is_method": false}, {"name": "check_checklist", "qualified_name": "check_checklist", "args": ["pr_body"], "decorators": [], "docstring": "The first five items in the Checklist section must be checked.", "start_line": 400, "end_line": 413, "is_async": false, "is_method": false}, {"name": "write_job_summary", "qualified_name": "write_job_summary", "args": ["pr_number", "results", "summary_file"], "decorators": [], "docstring": "Write a Markdown job summary to the given file path (if provided).", "start_line": 416, "end_line": 436, "is_async": false, "is_method": false}, {"name": "main", "qualified_name": "main", "args": ["repo", "token", "pr_author", "pr_body", "pr_number", "pr_title", "pr_created_at", "autoclose", "summary_file", "gha_formatter"], "decorators": [], "docstring": "", "start_line": 439, "end_line": 569, "is_async": false, "is_method": false}, {"name": "format", "qualified_name": "format", "args": ["self", "record"], "decorators": [], "docstring": "", "start_line": 79, "end_line": 82, "is_async": false, "is_method": false}], "classes": [{"name": "GHAFormatter", "bases": ["logging.Formatter"], "methods": ["format"], "docstring": "", "start_line": 71, "end_line": 82}], "calls": [], "module_docstring": "PR quality checks for Django pull requests.\n\nEach check is an independent function that returns None on success, or an\nerror message on failure. Independent checks are all run so that all issues\nare reported in a single pass. Trac status and has_patch checks are skipped\nwhen no ticket is found, since they require a ticket ID to be meaningful.\n\nRequired environment variables:\n    GITHUB_TOKEN  GitHub API token\n    PR_NUMBER     Pull request number\n    PR_REPO       Repository in \"owner/repo\" format\n\nOptional environment variables:\n    AUTOCLOSE     Set to \"true\" to close failing PRs (default: false)\n    PR_AUTHOR     PR author's GitHub login\n    PR_BODY       Pull request body text\n    PR_CREATED_AT PR creation timestamp (ISO 8601)\n    PR_TITLE      Pull request title", "parse_error": ""}, {"file_path": "scripts/pr_quality/errors.py", "file_hash": "78241bd19eb99fb4ece2a1421dbf4558dab87bc22c13f9f06aeca8385386fde8", "imports": [], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "title", "body"], "decorators": [], "docstring": "", "start_line": 15, "end_line": 18, "is_async": false, "is_method": false}, {"name": "as_details", "qualified_name": "as_details", "args": ["self", "level"], "decorators": [], "docstring": "", "start_line": 20, "end_line": 26, "is_async": false, "is_method": false}], "classes": [{"name": "Message", "bases": [], "methods": ["__init__", "as_details"], "docstring": "A PR quality check message bound to its runtime formatting kwargs.", "start_line": 12, "end_line": 26}], "calls": [], "module_docstring": "Error and notification messages for PR quality checks.\n\nMessage constants are plain 2-tuples of (title, body). Body strings use\nstr.format() placeholders; kwargs are supplied at Message() construction time.", "parse_error": ""}, {"file_path": "scripts/pr_quality/tests/__init__.py", "file_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "scripts/pr_quality/tests/test_check_pr.py", "file_hash": "450d69e2fb625fad3c1fad701c4184bd11f290c13718c778424724d69997c26a", "imports": [{"module": "json", "names": [], "is_from": false, "alias": ""}, {"module": "logging", "names": [], "is_from": false, "alias": ""}, {"module": "tempfile", "names": [], "is_from": false, "alias": ""}, {"module": "unittest", "names": [], "is_from": false, "alias": ""}, {"module": "urllib.error", "names": [], "is_from": false, "alias": ""}, {"module": "pathlib", "names": ["Path"], "is_from": true, "alias": ""}, {"module": "unittest", "names": ["mock"], "is_from": true, "alias": ""}, {"module": "pr_quality", "names": ["check_pr"], "is_from": true, "alias": ""}, {"module": "pr_quality.errors", "names": ["LEVEL_ERROR", "LEVEL_WARNING", "MISSING_TRAC_TICKET", "Message"], "is_from": true, "alias": ""}], "functions": [{"name": "make_pr_body", "qualified_name": "make_pr_body", "args": ["ticket", "description", "no_ai_checked", "ai_used_checked", "ai_description", "checked_items"], "decorators": [], "docstring": "", "start_line": 21, "end_line": 83, "is_async": false, "is_method": false}, {"name": "make_trac_json", "qualified_name": "make_trac_json", "args": ["ticket_id", "stage", "status", "resolution", "has_patch", "needs_docs", "needs_tests", "needs_better_patch"], "decorators": [], "docstring": "", "start_line": 90, "end_line": 112, "is_async": false, "is_method": false}, {"name": "patch_urlopen", "qualified_name": "patch_urlopen", "args": ["json_responses", "status_code"], "decorators": [], "docstring": "", "start_lin