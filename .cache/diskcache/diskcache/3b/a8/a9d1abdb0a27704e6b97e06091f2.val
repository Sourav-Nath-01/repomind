": "_filter_or_exclude_inplace", "args": ["self", "negate", "args", "kwargs"], "decorators": [], "docstring": "", "start_line": 1674, "end_line": 1681, "is_async": false, "is_method": false}, {"name": "complex_filter", "qualified_name": "complex_filter", "args": ["self", "filter_obj"], "decorators": [], "docstring": "Return a new QuerySet instance with filter_obj added to the filters.\n\nfilter_obj can be a Q object or a dictionary of keyword lookup\narguments.\n\nThis exists to support framework features such as 'limit_choices_to',\nand usually it will be more natural to use other methods.", "start_line": 1683, "end_line": 1698, "is_async": false, "is_method": false}, {"name": "_combinator_query", "qualified_name": "_combinator_query", "args": ["self", "combinator"], "decorators": [], "docstring": "", "start_line": 1700, "end_line": 1710, "is_async": false, "is_method": false}, {"name": "union", "qualified_name": "union", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1712, "end_line": 1723, "is_async": false, "is_method": false}, {"name": "intersection", "qualified_name": "intersection", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1725, "end_line": 1732, "is_async": false, "is_method": false}, {"name": "difference", "qualified_name": "difference", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1734, "end_line": 1738, "is_async": false, "is_method": false}, {"name": "select_for_update", "qualified_name": "select_for_update", "args": ["self", "nowait", "skip_locked", "of", "no_key"], "decorators": [], "docstring": "Return a new QuerySet instance that will select objects with a\nFOR UPDATE lock.", "start_line": 1740, "end_line": 1754, "is_async": false, "is_method": false}, {"name": "select_related", "qualified_name": "select_related", "args": ["self"], "decorators": [], "docstring": "Return a new QuerySet instance that will select related objects.\n\nIf fields are specified, they must be ForeignKey fields and only those\nrelated objects are included in the selection.\n\nIf select_related(None) is called, clear the list.", "start_line": 1756, "end_line": 1786, "is_async": false, "is_method": false}, {"name": "prefetch_related", "qualified_name": "prefetch_related", "args": ["self"], "decorators": [], "docstring": "Return a new QuerySet instance that will prefetch the specified\nMany-To-One and Many-To-Many related objects when the QuerySet is\nevaluated.\n\nWhen prefetch_related() is called more than once, append to the list of\nprefetch lookups. If prefetch_related(None) is called, clear the list.", "start_line": 1788, "end_line": 1811, "is_async": false, "is_method": false}, {"name": "annotate", "qualified_name": "annotate", "args": ["self"], "decorators": [], "docstring": "Return a query set in which the returned objects have been annotated\nwith extra data or aggregations.", "start_line": 1813, "end_line": 1819, "is_async": false, "is_method": false}, {"name": "alias", "qualified_name": "alias", "args": ["self"], "decorators": [], "docstring": "Return a query set with added aliases for extra data or aggregations.", "start_line": 1821, "end_line": 1826, "is_async": false, "is_method": false}, {"name": "_annotate", "qualified_name": "_annotate", "args": ["self", "args", "kwargs", "select"], "decorators": [], "docstring": "", "start_line": 1828, "end_line": 1884, "is_async": false, "is_method": false}, {"name": "order_by", "qualified_name": "order_by", "args": ["self"], "decorators": [], "docstring": "Return a new QuerySet instance with the ordering changed.", "start_line": 1886, "end_line": 1893, "is_async": false, "is_method": false}, {"name": "distinct", "qualified_name": "distinct", "args": ["self"], "decorators": [], "docstring": "Return a new QuerySet instance that will select only distinct results.", "start_line": 1895, "end_line": 1906, "is_async": false, "is_method": false}, {"name": "extra", "qualified_name": "extra", "args": ["self", "select", "where", "params", "tables", "order_by", "select_params"], "decorators": [], "docstring": "Add extra SQL fragments to the query.", "start_line": 1908, "end_line": 1923, "is_async": false, "is_method": false}, {"name": "reverse", "qualified_name": "reverse", "args": ["self"], "decorators": [], "docstring": "Reverse the ordering of the QuerySet.", "start_line": 1925, "end_line": 1931, "is_async": false, "is_method": false}, {"name": "defer", "qualified_name": "defer", "args": ["self"], "decorators": [], "docstring": "Defer the loading of data for certain fields until they are accessed.\nAdd the set of deferred fields to any existing set of deferred fields.\nThe only exception to this is if None is passed in as the only\nparameter, in which case remove all deferrals.", "start_line": 1933, "end_line": 1948, "is_async": false, "is_method": false}, {"name": "only", "qualified_name": "only", "args": ["self"], "decorators": [], "docstring": "Essentially, the opposite of defer(). Only the fields passed into this\nmethod and that are not already specified as deferred are loaded\nimmediately when the queryset is evaluated.", "start_line": 1950, "end_line": 1969, "is_async": false, "is_method": false}, {"name": "using", "qualified_name": "using", "args": ["self", "alias"], "decorators": [], "docstring": "Select which database this QuerySet should execute against.", "start_line": 1971, "end_line": 1975, "is_async": false, "is_method": false}, {"name": "fetch_mode", "qualified_name": "fetch_mode", "args": ["self", "fetch_mode"], "decorators": [], "docstring": "Set the fetch mode for the QuerySet.", "start_line": 1977, "end_line": 1981, "is_async": false, "is_method": false}, {"name": "ordered", "qualified_name": "ordered", "args": ["self"], "decorators": ["property"], "docstring": "Return True if the QuerySet is ordered -- i.e. has an order_by()\nclause or a default ordering on the model (or is empty).", "start_line": 1988, "end_line": 2006, "is_async": false, "is_method": false}, {"name": "totally_ordered", "qualified_name": "totally_ordered", "args": ["self"], "decorators": ["property"], "docstring": "Returns True if the QuerySet is ordered and the ordering is\ndeterministic. This requires that the ordering includes a field\n(or set of fields) that is unique and non-nullable.\n\nFor queries involving a GROUP BY clause, the model's default\nordering is ignored. Ordering specified via .extra(order_by=..", "start_line": 2009, "end_line": 2080, "is_async": false, "is_method": false}, {"name": "db", "qualified_name": "db", "args": ["self"], "decorators": ["property"], "docstring": "Return the database used if this query is executed now.", "start_line": 2083, "end_line": 2087, "is_async": false, "is_method": false}, {"name": "_insert", "qualified_name": "_insert", "args": ["self", "objs", "fields", "returning_fields", "raw", "using", "on_conflict", "update_fields", "unique_fields"], "decorators": [], "docstring": "Insert a new record for the given model. This provides an interface to\nthe InsertQuery class and is how Model.save() is implemented.", "start_line": 2093, "end_line": 2118, "is_async": false, "is_method": false}, {"name": "_batched_insert", "qualified_name": "_batched_insert", "args": ["self", "objs", "fields", "batch_size", "on_conflict", "update_fields", "unique_fields"], "decorators": [], "docstring": "Helper method for bulk_create() to insert objs one batch at a time.", "start_line": 2123, "end_line": 2166, "is_async": false, "is_method": false}, {"name": "_disable_cloning", "qualified_name": "_disable_cloning", "args": ["self"], "decorators": [], "docstring": "Prevent calls to _chain() from creating a new QuerySet via _clone().\nAll subsequent QuerySet mutations will occur on this instance until\n_enable_cloning() is used.", "start_line": 2168, "end_line": 2175, "is_async": false, "is_method": false}, {"name": "_enable_cloning", "qualified_name": "_enable_cloning", "args": ["self"], "decorators": [], "docstring": "Allow calls to _chain() to create a new QuerySet via _clone(). Restores\nthe default behavior where any QuerySet mutation will return a new\nQuerySet instance. Necessary only when there has been a\n_disable_cloning() call previously.", "start_line": 2177, "end_line": 2185, "is_async": false, "is_method": false}, {"name": "_avoid_cloning", "qualified_name": "_avoid_cloning", "args": ["self"], "decorators": [], "docstring": "Temporarily prevent QuerySet _clone() operations, restoring the default\nbehavior on exit. For the duration of the context managed statement,\nall operations (e.g. filter(), exclude(), etc.) will mutate the same\nQuerySet instance.\n\n@contextlib.contextmanager is intentionally not used for performance\nr", "start_line": 2187, "end_line": 2197, "is_async": false, "is_method": false}, {"name": "_chain", "qualified_name": "_chain", "args": ["self"], "decorators": [], "docstring": "Return a copy of the current QuerySet that's ready for another\noperation.\n\nIf the QuerySet has opted in to in-place mutations via\n_disable_cloning() temporarily, the copy doesn't occur and instead the\nsame QuerySet instance will be modified.", "start_line": 2199, "end_line": 2215, "is_async": false, "is_method": false}, {"name": "_clone", "qualified_name": "_clone", "args": ["self"], "decorators": [], "docstring": "Return a copy of the current QuerySet. A lightweight alternative\nto deepcopy().", "start_line": 2217, "end_line": 2235, "is_async": false, "is_method": false}, {"name": "_fetch_all", "qualified_name": "_fetch_all", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2237, "end_line": 2241, "is_async": false, "is_method": false}, {"name": "_next_is_sticky", "qualified_name": "_next_is_sticky", "args": ["self"], "decorators": [], "docstring": "Indicate that the next filter call and the one following that should\nbe treated as a single filter. This is only important when it comes to\ndetermining when to reuse tables for many-to-many filters. Required so\nthat we can filter naturally on the results of related managers.\n\nThis doesn't return a c", "start_line": 2243, "end_line": 2255, "is_async": false, "is_method": false}, {"name": "_merge_sanity_check", "qualified_name": "_merge_sanity_check", "args": ["self", "other"], "decorators": [], "docstring": "Check that two QuerySet classes may be merged.", "start_line": 2257, "end_line": 2267, "is_async": false, "is_method": false}, {"name": "_merge_known_related_objects", "qualified_name": "_merge_known_related_objects", "args": ["self", "other"], "decorators": [], "docstring": "Keep track of all known related objects from either QuerySet instance.", "start_line": 2269, "end_line": 2274, "is_async": false, "is_method": false}, {"name": "resolve_expression", "qualified_name": "resolve_expression", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2276, "end_line": 2279, "is_async": false, "is_method": false}, {"name": "_add_hints", "qualified_name": "_add_hints", "args": ["self"], "decorators": [], "docstring": "Update hinting information for use by routers. Add new key/values or\noverwrite existing key/values.", "start_line": 2283, "end_line": 2288, "is_async": false, "is_method": false}, {"name": "_has_filters", "qualified_name": "_has_filters", "args": ["self"], "decorators": [], "docstring": "Check if this QuerySet has any filtering going on. This isn't\nequivalent with checking if all objects are present in results, for\nexample, qs[1:]._has_filters() -> False.", "start_line": 2290, "end_line": 2296, "is_async": false, "is_method": false}, {"name": "_validate_values_are_expressions", "qualified_name": "_validate_values_are_expressions", "args": ["values", "method_name"], "decorators": ["staticmethod"], "docstring": "", "start_line": 2299, "end_line": 2310, "is_async": false, "is_method": false}, {"name": "_not_support_combined_queries", "qualified_name": "_not_support_combined_queries", "args": ["self", "operation_name"], "decorators": [], "docstring": "", "start