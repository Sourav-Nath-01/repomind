mit", "qualified_name": "get_autocommit", "args": ["self"], "decorators": [], "docstring": "Get the autocommit state.", "start_line": 452, "end_line": 455, "is_async": false, "is_method": false}, {"name": "set_autocommit", "qualified_name": "set_autocommit", "args": ["self", "autocommit", "force_begin_transaction_with_broken_autocommit"], "decorators": [], "docstring": "Enable or disable autocommit.\n\nThe usual way to start a transaction is to turn autocommit off.\nSQLite does not properly start a transaction when disabling\nautocommit. To avoid this buggy behavior and to actually enter a new\ntransaction, an explicit BEGIN is required. Using\nforce_begin_transaction_wi", "start_line": 457, "end_line": 492, "is_async": false, "is_method": false}, {"name": "get_rollback", "qualified_name": "get_rollback", "args": ["self"], "decorators": [], "docstring": "Get the \"needs rollback\" flag -- for *advanced use* only.", "start_line": 494, "end_line": 500, "is_async": false, "is_method": false}, {"name": "set_rollback", "qualified_name": "set_rollback", "args": ["self", "rollback"], "decorators": [], "docstring": "Set or unset the \"needs rollback\" flag -- for *advanced use* only.", "start_line": 502, "end_line": 510, "is_async": false, "is_method": false}, {"name": "validate_no_atomic_block", "qualified_name": "validate_no_atomic_block", "args": ["self"], "decorators": [], "docstring": "Raise an error if an atomic block is active.", "start_line": 512, "end_line": 517, "is_async": false, "is_method": false}, {"name": "validate_no_broken_transaction", "qualified_name": "validate_no_broken_transaction", "args": ["self"], "decorators": [], "docstring": "", "start_line": 519, "end_line": 524, "is_async": false, "is_method": false}, {"name": "constraint_checks_disabled", "qualified_name": "constraint_checks_disabled", "args": ["self"], "decorators": ["contextmanager"], "docstring": "Disable foreign key constraint checking.", "start_line": 529, "end_line": 538, "is_async": fal