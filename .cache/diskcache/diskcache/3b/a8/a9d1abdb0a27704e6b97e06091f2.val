e"], "decorators": [], "docstring": "Store all unread messages.\n\nIf the backend has yet to be iterated, store previously stored messages\nagain. Otherwise, only store messages added after the last iteration.", "start_line": 128, "end_line": 140, "is_async": false, "is_method": false}, {"name": "add", "qualified_name": "add", "args": ["self", "level", "message", "extra_tags"], "decorators": [], "docstring": "Queue a message to be stored.\n\nThe message is only queued if it contained something and its level is\nnot less than the recording level (``self.level``).", "start_line": 142, "end_line": 158, "is_async": false, "is_method": false}, {"name": "_get_level", "qualified_name": "_get_level", "args": ["self"], "decorators": [], "docstring": "Return the minimum recorded level.\n\nThe default level is the ``MESSAGE_LEVEL`` setting. If this is\nnot found, the ``INFO`` level is used.", "start_line": 160, "end_line": 169, "is_async": false, "is_method": false}, {"name": "_set_level", "qualified_name": "_set_level", "args": ["self", "value"], "decorators": [], "docstring": "Set a custom minimum recorded level.\n\nIf set to ``None``, the default level will be used (see the\n``_get_level`` method).", "start_line": 171, "end_line": 181, "is_async": false, "is_method": false}], "classes": [{"name": "Message", "bases": [], "methods": ["__init__", "_prepare", "__eq__", "__str__", "__repr__", "tags", "level_tag"], "docstring": "Represent an actual message that can be stored in any of the supported\nstorage classes (typically session- or cookie-based) and rendered in a view\nor template.", "start_line": 8, "end_line": 46}, {"name": "BaseStorage", "bases": [], "methods": ["__init__", "__len__", "__iter__", "__contains__", "__repr__", "_loaded_messages", "_get", "_store", "_prepare_messages", "update", "add", "_get_level", "_set_level"], "docstring": "This is the base backend for temporary message storage.\n\nThis is not a complete class; to be a usable storage backend, it must be\