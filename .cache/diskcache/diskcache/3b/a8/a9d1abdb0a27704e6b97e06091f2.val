Pv4-mapped address is found,\n    r", "start_line": 17, "end_line": 51, "is_async": false, "is_method": false}, {"name": "is_valid_ipv6_address", "qualified_name": "is_valid_ipv6_address", "args": ["ip_addr"], "decorators": [], "docstring": "Return whether the `ip_addr` object is a valid IPv6 address.", "start_line": 54, "end_line": 64, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/utils/timezone.py", "file_hash": "ceaad7cc041ee1856e38f16519e6a59e844672c83b2f401f9b451ef1d27a086d", "imports": [{"module": "functools", "names": [], "is_from": false, "alias": ""}, {"module": "zoneinfo", "names": [], "is_from": false, "alias": ""}, {"module": "contextlib", "names": ["ContextDecorator"], "is_from": true, "alias": ""}, {"module": "datetime", "names": ["UTC", "datetime", "timedelta", "timezone", "tzinfo"], "is_from": true, "alias": ""}, {"module": "asgiref.local", "names": ["Local"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}], "functions": [{"name": "get_fixed_timezone", "qualified_name": "get_fixed_timezone", "args": ["offset"], "decorators": [], "docstring": "Return a tzinfo instance with a fixed offset from UTC.", "start_line": 33, "end_line": 40, "is_async": false, "is_method": false}, {"name": "get_default_timezone", "qualified_name": "get_default_timezone", "args": [], "decorators": ["functools.lru_cache"], "docstring": "Return the default time zone as a tzinfo instance.\n\nThis is the time zone defined by settings.TIME_ZONE.", "start_line": 46, "end_line": 52, "is_async": false, "is_method": false}, {"name": "get_default_timezone_name", "qualified_name": "get_default_timezone_name", "args": [], "decorators": [], "docstring": "Return the name of the default time zone.", "start_line": 56, "end_line": 58, "is_async": false, "is_method": false}, {"name": "get_current_timezone", "qualified_name": "get_current_timezone", "args": [], "decorators": [], "docstring": "Return the currently active time zone as a tzinfo instance.", "start_line": 64, "end_line": 66, "is_async": false, "is_method": false}, {"name": "get_current_timezone_name", "qualified_name": "get_current_timezone_name", "args": [], "decorators": [], "docstring": "Return the name of the currently active time zone.", "start_line": 69, "end_line": 71, "is_async": false, "is_method": false}, {"name": "_get_timezone_name", "qualified_name": "_get_timezone_name", "args": ["timezone"], "decorators": [], "docstring": "Return the offset for fixed offset timezones, or the name of timezone if\nnot set.", "start_line": 74, "end_line": 79, "is_async": false, "is_method": false}, {"name": "activate", "qualified_name": "activate", "args": ["timezone"], "decorators": [], "docstring": "Set the time zone for the current thread.\n\nThe ``timezone`` argument must be an instance of a tzinfo subclass or a\ntime zone name.", "start_line": 88, "end_line": 100, "is_async": false, "is_method": false}, {"name": "deactivate", "qualified_name": "deactivate", "args": [], "decorators": [], "docstring": "Unset the time zone for the current thread.\n\nDjango will then use the time zone defined by settings.TIME_ZONE.", "start_line": 103, "end_line": 110, "is_async": false, "is_method": false}, {"name": "template_localtime", "qualified_name": "template_localtime", "args": ["value", "use_tz"], "decorators": [], "docstring": "Check if value is a datetime and converts it to local time if necessary.\n\nIf use_tz is provided and is not None, that will force the value to\nbe converted (or not), overriding the value of settings.USE_TZ.\n\nThis function is designed for use by the template engine.", "start_line": 146, "end_line": 161, "is_async": false, "is_method": false}, {"name": "localtime", "qualified_name": "localtime", "args": ["value", "timezone"], "decorators": [], "docstring": "Convert an aware datetime.datetime to local time.\n\nOnly aware datetimes are allowed. When value is omitted, it defaults to\nnow().\n\nLocal time is defined by the current time zone, unless another time zone\nis specified.", "start_line": 167, "end_line": 184, "is_async": false, "is_method": false}, {"name": "localdate", "qualified_name": "localdate", "args": ["value", "timezone"], "decorators": [], "docstring": "Convert an aware datetime to local time and return the value's date.\n\nOnly aware datetimes are allowed. When value is omitted, it defaults to\nnow().\n\nLocal time is defined by the current time zone, unless another time zone is\nspecified.", "start_line": 187, "end_line": 197, "is_async": false, "is_method": false}, {"name": "now", "qualified_name": "now", "args": [], "decorators": [], "docstring": "Return an aware or naive datetime.datetime, depending on settings.USE_TZ.", "start_line": 200, "end_line": 204, "is_async": false, "is_method": false}, {"name": "is_aware", "qualified_name": "is_aware", "args": ["value"], "decorators": [], "docstring": "Determine if a given datetime.datetime is aware.\n\nThe concept is defined in Python's docs:\nhttps://docs.python.org/library/datetime.html#datetime.tzinfo\n\nAssuming value.tzinfo is either None or a proper datetime.tzinfo,\nvalue.utcoffset() implements the appropriate logic.", "start_line": 211, "end_line": 221, "is_async": false, "is_method": false}, {"name": "is_naive", "qualified_name": "is_naive", "args": ["value"], "decorators": [], "docstring": "Determine if a given datetime.datetime is naive.\n\nThe concept is defined in Python's docs:\nhttps://docs.python.org/library/datetime.html#datetime.tzinfo\n\nAssuming value.tzinfo is either None or a proper datetime.tzinfo,\nvalue.utcoffset() implements the appropriate logic.", "start_line": 224, "end_line": 234, "is_async": false, "is_method": false}, {"name": "make_aware", "qualified_name": "make_aware", "args": ["value", "timezone"], "decorators": [], "docstring": "Make a naive datetime.datetime in a given time zone aware.", "sta