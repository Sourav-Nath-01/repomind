dule_loading", "names": ["import_string"], "is_from": true, "alias": ""}, {"module": "django.utils.regex_helper", "names": ["_lazy_re_compile"], "is_from": true, "alias": ""}], "functions": [{"name": "default_key_func", "qualified_name": "default_key_func", "args": ["key", "key_prefix", "version"], "decorators": [], "docstring": "Default function to generate keys.\n\nConstruct the key used by all other methods. By default, prepend\nthe `key_prefix`. KEY_FUNCTION can be used to specify an alternate\nfunction with custom key making behavior.", "start_line": 33, "end_line": 41, "is_async": false, "is_method": false}, {"name": "get_key_func", "qualified_name": "get_key_func", "args": ["key_func"], "decorators": [], "docstring": "Function to decide which key function to use.\n\nDefault to ``default_key_func``.", "start_line": 44, "end_line": 55, "is_async": false, "is_method": false}, {"name": "memcache_key_warnings", "qualified_name": "memcache_key_warnings", "args": ["key"], "decorators": [], "docstring": "", "start_line": 424, "end_line": 434, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "params"], "decorators": [], "docstring": "", "start_line": 61, "end_line": 85, "is_async": false, "is_method": false}, {"name": "get_backend_timeout", "qualified_name": "get_backend_timeout", "args": ["self", "timeout"], "decorators": [], "docstring": "Return the timeout value usable by this backend based upon the provided\ntimeout.", "start_line": 87, "end_line": 97, "is_async": false, "is_method": false}, {"name": "make_key", "qualified_name": "make_key", "args": ["self", "key", "version"], "decorators": [], "docstring": "Construct the key used by all other methods. By default, use the\nkey_func to generate a key (which, by default, prepends the\n`key_prefix' and 'version'). A different key function can be provided\nat the time of cache construction; alternatively, you can subclass the\ncache backend to provide custom ke", "start_line": 99, "end_line": 110, "is_async": false, "is_method": false}, {"name": "validate_key", "qualified_name": "validate_key", "args": ["self", "key"], "decorators": [], "docstring": "Warn about keys that would not be portable to the memcached\nbackend. This encourages (but does not force) writing backend-portable\ncache code.", "start_line": 112, "end_line": 119, "is_async": false, "is_method": false}, {"name": "make_and_validate_key", "qualified_name": "make_and_validate_key", "args": ["self", "key", "version"], "decorators": [], "docstring": "Helper to make and validate keys.", "start_line": 121, "end_line": 125, "is_async": false, "is_method": false}, {"name": "add", "qualified_name": "add", "args": ["self", "key", "value", "timeout", "version"], "decorators": [], "docstring": "Set a value in the cache if the key does not already exist. If\ntimeout is given, use that timeout for the key; otherwise use the\ndefault cache timeout.\n\nReturn True if the value was stored, False otherwise.", "start_line": 127, "end_line": 137, "is_async": false, "is_method": false}, {"name": "aadd", "qualified_name": "aadd", "args": ["self", "key", "value", "timeout", "version"], "decorators": [], "docstring": "", "start_line": 139, "end_line": 142, "is_async": true, "is_method": false}, {"name": "get", "qualified_name": "get", "args": ["self", "key", "default", "version"], "decorators": [], "docstring": "Fetch a given key from the cache. If the key does not exist, return\ndefault, which itself defaults to None.", "start_line": 144, "end_line": 149, "is_async": false, "is_method": false}, {"name": "aget", "qualified_name": "aget", "args": ["self", "key", "default", "version"], "decorators": [], "docstring": "", "start_line": 151, "end_line": 154, "is_async": true, "is_method": false}, {"name": "set", "qualified_name": "set", "args": ["self", "key", "value", "timeout", "version"], "decorators": [], "docstring": "Set a value in the cache. If timeout is given, use that timeout for the\nkey; otherwise use the default cache timeout.", "start_line": 156, "end_line": 161, "is_async": false, "is_method": false}, {"name": "aset", "qualified_name": "aset", "args": ["self", "key", "value", "timeout", "version"], "decorators": [], "docstring": "", "start_line": 163, "end_line": 166, "is_async": true, "is_method": false}, {"name": "touch", "qualified_name": "touch", "args": ["self", "key", "timeout", "version"], "decorators": [], "docstring": "Update the key's expiry time using timeout. Return True if successful\nor False if the key does not exist.", "start_line": 168, "end_line": 175, "is_async": false, "is_method": false}, {"name": "atouch", "qualified_name": "atouch", "args": ["self", "key", "timeout", "version"], "decorators": [], "docstring": "", "start_line": 177, "end_line": 180, "is_async": true, "is_method": false}, {"name": "delete", "qualified_name": "delete", "args": ["self", "key", "version"], "decorators": [], "docstring": "Delete a key from the cache and return whether it succeeded, failing\nsilently.", "start_line": 182, "end_line": 189, "is_async": false, "is_method": false}, {"name": "adelete", "qualified_name": "adelete", "args": ["self", "key", "version"], "decorators": [], "docstring": "", "start_line": 191, "end_line": 192, "is_async": true, "is_method": false}, {"name": "get_many", "qualified_name": "get_many", "args": ["self", "keys", "version"], "decorators": [], "docstring": "Fetch a bunch of keys from the cache. For certain backends (memcached,\npgsql) this can be *much* faster when fetching multiple values.\n\nReturn a dict mapping each key in keys to its value. If the given\nkey is missing, it will be missing from the response dict.", "start_line": 194, "end_line": 207, "is_async": false, "is_method": false}, {"name": "aget_many", "qualified_name": "aget_many", "args": ["self", "keys", "version"], "decorators": [], "docstring": "See get_many().", "start_line": 209, "end_line": 220, "is_async": true, "is_method": false}, {"name": "get_or_set", "qualified_name": "get_or_set", "args": ["self", "key", "default", "timeout", "version"], "decorators": [], "docstring": "Fetch a given key from the cache. If the key does not exist,\nadd the key and set it to the default value. The default value can\nalso be any callable. If timeout is given, use that timeout for the\nkey; otherwise use the default cache timeout.\n\nReturn the value of the key stored or retrieved.", "start_line": 222, "end_line": 239, "is_async": false, "is_method": false}, {"name": "aget_or_set", "qualified_name": "aget_or_set", "args": ["self", "key", "default", "timeout", "version"], "decorators": [], "docstring": "See get_or_set().", "start_line": 241, "end_line": 255, "is_async": true, "is_method": false}, {"name": "has_key", "qualified_name": "has_key", "args": ["self", "key", "version"], "decorators": [], "docstring": "Return True if the key is in the cache and has not expired.", "start_line": 257, "end_line": 263, "is_async": false, "is_method": false}, {"name": "ahas_key", "qualified_name": "ahas_key", "args": ["self", "key", "version"], "decorators": [], "docstring": "", "start_line": 265, "end_line": 273, "is_async": true, "is_method": false}, {"name": "incr", "qualified_name": "incr", "args": ["self", "key", "delta", "version"], "decorators": [], "docstring": "Add delta to value in the cache. If the key does not exist, raise a\nValueError exception.", "start_line": 275, "end_line": 285, "is_async": false, "is_method": false}, {"name": "aincr", "qualified_name": "aincr", "args": ["self", "key", "delta", "version"], "decorators": [], "docstring": "See incr().", "start_line": 287, "end_line": 298, "is_async": true, "is_method": false}, {"name": "decr", "qualified_name": "decr", "args": ["self", "key", "delta", "version"], "decorators": [], "docstring": "Subtract delta from value in the cache. If the key does not exist,\nraise a ValueError exception.", "start_line": 300, "end_line": 305, "is_async": false, "is_method": false}, {"name": "adecr", "qualified_name": "adecr", "args": ["self", "key", "delta", "version"], "decorators": [], "docstring": "", "start_line": 307, "end_line": 308, "is_async": true, "is_method": false}, {"name": "__contains__", "qualified_name": "__contains__", "args": ["self", "key"], "decorators": [], "docstring": "Return True if the key is in the cache and has not expired.", "start_line": 310, "end_line": 317, "is_async": false, "is_method": false}, {"name": "set_many", "qualified_name": "set_many", "args": ["self", "data", "timeout", "version"], "decorators": [], "docstring": "Set a bunch of values in the cache at once from a dict of key/value\npairs. For certain backends (memcached), this is much more efficient\nthan calling set() multiple times.\n\nIf timeout is given, use that timeout for the key; otherwise use the\ndefault cache timeout.\n\nOn backends that support it, retur", "start_line": 319, "end_line": 333, "is_async": false, "is_method": false}, {"name": "aset_many", "qualified_name": "aset_many", "args": ["self", "data", "timeout", "version"], "decorators": [], "docstring": "", "start_line": 335, "end_line": 342, "is_async": true, "is_method": false}, {"name": "delete_many", "qualified_name": "delete_many", "args": ["self", "keys", "version"], "decorators": [], "docstring": "Delete a bunch of values in the cache at once. For certain backends\n(memcached), this is much more efficient than calling delete() multiple\ntimes.", "start_line": 344, "end_line": 351, "is_async": false, "is_method": false}, {"name": "adelete_many", "qualified_name": "adelete_many", "args": ["self", "keys", "version"], "decorators": [], "docstring": "", "start_line": 353, "end_line": 359, "is_async": true, "is_method": false}, {"name": "clear", "qualified_name": "clear", "args": ["self"], "decorators": [], "docstring": "Remove *all* values from the cache at once.", "start_line": 361, "end_line": 365, "is_async": false, "is_method": false}, {"name": "aclear", "qualified