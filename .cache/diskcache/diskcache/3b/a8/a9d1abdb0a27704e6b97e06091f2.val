e": "adapt_json_value", "qualified_name": "adapt_json_value", "args": ["self", "value", "encoder"], "decorators": [], "docstring": "", "start_line": 625, "end_line": 626, "is_async": false, "is_method": false}, {"name": "year_lookup_bounds_for_date_field", "qualified_name": "year_lookup_bounds_for_date_field", "args": ["self", "value", "iso_year"], "decorators": [], "docstring": "Return a two-elements list with the lower and upper bound to be used\nwith a BETWEEN operator to query a DateField value using a year\nlookup.\n\n`value` is an int, containing the looked-up year.\nIf `iso_year` is True, return bounds for ISO-8601 week-numbering years.", "start_line": 628, "end_line": 647, "is_async": false, "is_method": false}, {"name": "year_lookup_bounds_for_datetime_field", "qualified_name": "year_lookup_bounds_for_datetime_field", "args": ["self", "value", "iso_year"], "decorators": [], "docstring": "Return a two-elements list with the lower and upper bound to be used\nwith a BETWEEN operator to query a DateTimeField value using a year\nlookup.\n\n`value` is an int, containing the looked-up year.\nIf `iso_year` is True, return bounds for ISO-8601 week-numbering years.", "start_line": 649, "end_line": 672, "is_async": false, "is_method": false}, {"name": "get_db_converters", "qualified_name": "get_db_converters", "args": ["self", "expression"], "decorators": [], "docstring": "Return a list of functions needed to convert field data.\n\nSome field types on some backends do not provide data in the correct\nformat, this is the hook for converter functions.", "start_line": 674, "end_line": 681, "is_async": false, "is_method": false}, {"name": "convert_durationfield_value", "qualified_name": "convert_durationfield_value", "args": ["self", "value", "expression", "connection"], "decorators": [], "docstring": "", "start_line": 683, "end_line": 685, "is_async": false, "is_method": false}, {"name": "convert_trunc_expression", "qualified_name": "convert_trunc_expression", "args": ["