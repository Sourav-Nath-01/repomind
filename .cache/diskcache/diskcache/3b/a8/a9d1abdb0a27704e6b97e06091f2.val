": ""}, {"module": "django.utils.regex_helper", "names": ["_lazy_re_compile"], "is_from": true, "alias": ""}], "functions": [{"name": "b62_encode", "qualified_name": "b62_encode", "args": ["s"], "decorators": [], "docstring": "", "start_line": 67, "end_line": 76, "is_async": false, "is_method": false}, {"name": "b62_decode", "qualified_name": "b62_decode", "args": ["s"], "decorators": [], "docstring": "", "start_line": 79, "end_line": 89, "is_async": false, "is_method": false}, {"name": "b64_encode", "qualified_name": "b64_encode", "args": ["s"], "decorators": [], "docstring": "", "start_line": 92, "end_line": 93, "is_async": false, "is_method": false}, {"name": "b64_decode", "qualified_name": "b64_decode", "args": ["s"], "decorators": [], "docstring": "", "start_line": 96, "end_line": 98, "is_async": false, "is_method": false}, {"name": "base64_hmac", "qualified_name": "base64_hmac", "args": ["salt", "value", "key", "algorithm"], "decorators": [], "docstring": "", "start_line": 102, "end_line": 114, "is_async": false, "is_method": false}, {"name": "_cookie_signer_key", "qualified_name": "_cookie_signer_key", "args": ["key"], "decorators": [], "docstring": "", "start_line": 117, "end_line": 119, "is_async": false, "is_method": false}, {"name": "get_cookie_signer", "qualified_name": "get_cookie_signer", "args": ["salt"], "decorators": [], "docstring": "", "start_line": 122, "end_line": 128, "is_async": false, "is_method": false}, {"name": "dumps", "qualified_name": "dumps", "args": ["obj", "key", "salt", "serializer", "compress"], "decorators": [], "docstring": "Return URL-safe, hmac signed base64 compressed JSON string. If key is\nNone, use settings.SECRET_KEY instead. The hmac algorithm is the default\nSigner algorithm.\n\nIf compress is True (not the default), check if compressing using zlib can\nsave some space. Prepend a '.' to signify compression. This is ", "start_line": 144, "end_line": 165, "is_async": false, "is_method": false}, {"name": "loads", "qualified_name": "loads", "args": ["s", "key", "salt", "serializer", "max_age", "fallback_keys"], "decorators": [], "docstring": "Reverse of dumps(), raise BadSignature if signature fails.\n\nThe serializer is expected to accept a bytestring.", "start_line": 168, "end_line": 187, "is_async": false, "is_method": false}, {"name": "dumps", "qualified_name": "dumps", "args": ["self", "obj"], "decorators": [], "docstring": "", "start_line": 137, "end_line": 138, "is_async": false, "is_method": false}, {"name": "loads", "qualified_name": "loads", "args": ["self", "data"], "decorators": [], "docstring": "", "start_line": 140, "end_line": 141, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 191, "end_line": 210, "is_async": false, "is_method": false}, {"name": "signature", "qualified_name": "signature", "args": ["self", "value", "key"], "decorators": [], "docstring": "", "start_line": 212, "end_line": 214, "is_async": false, "is_method": false}, {"name": "sign", "qualified_name": "sign", "args": ["self", "value"], "decorators": [], "docstring": "", "start_line": 216, "end_line": 217, "is_async": false, "is_method": false}, {"name": "unsign", "qualified_name": "unsign", "args": ["self", "signed_value"], "decorators": [], "docstring": "", "start_line": 219, "end_line": 226, "is_async": false, "is_method": false}, {"name": "sign_object", "qualified_name": "sign_object", "args": ["self", "obj", "serializer", "compress"], "decorators": [], "docstring": "Return URL-safe, hmac signed base64 compressed JSON string.\n\nIf compress is True (not the default), check if compressing using zlib\ncan save some space. Prepend a '.' to signify compression. This is\nincluded in the signature, to protect against zip bombs.\n\nThe serializer is expected to return a byte", "start_line": 228, "end_line": 251, "is_async": false, "is_method": false}, {"name": "unsign_object", "qualified_name": "unsign_object", "args": ["self", "signed_obj", "serializer"], "decorators": [], "docstring": "", "start_line": 253, "end_line": 264, "is_async": false, "is_method": false}, {"name": "timestamp", "qualified_name": "timestamp", "args": ["self"], "decorators": [], "docstring": "", "start_line": 268, "end_line": 269, "is_async": false, "is_method": false}, {"name": "sign", "qualified_name": "sign", "args": ["self", "value"], "decorators": [], "docstring": "", "start_line": 271, "end_line": 273, "is_async": false, "is_method": false}, {"name": "unsign", "qualified_name": "unsign", "args": ["self", "value", "max_age"], "decorators": [], "docstring": "Retrieve original value and check it wasn't signed more\nthan max_age seconds ago.", "start_line": 275, "end_line": 290, "is_async": false, "is_method": false}], "classes": [{"name": "BadSignature", "bases": ["Exception"], "methods": [], "docstring": "Signature does not match.", "start_line": 55, "end_line": 58}, {"name": "SignatureExpired", "bases": ["BadSignature"], "methods": [], "docstring": "Signature timestamp is older than required max_age.", "start_line": 61, "end_line": 64}, {"name": "JSONSerializer", "bases": [], "methods": ["dumps", "loads"], "docstring": "Simple wrapper around json to be used in signing.dumps and\nsigning.loads.", "start_line": 131, "end_line": 141}, {"name": "Signer", "bases": [], "methods": ["__init__", "signature", "sign", "unsign", "sign_object", "unsign_object"], "docstring": "", "start_line": 190, "end_line": 264}, {"name": "TimestampSigner", "bases": ["Signer"], "methods": ["timestamp", "sign", "unsign"], "docstring": "", "start_line": 267, "end_line": 290}], "calls": [], "module_docstring": "Functions for creating and restoring url-safe signed JSON objects.\n\nThe format used looks like this:\n\n>>> signing.dumps(\"hello\")\n'ImhlbGxvIg:1QaUZC:YIye-ze3TTx7gtSv422nZA4sgmk'\n\nThere are two components here, separated by a ':'. The first component is a\nURLsafe base64 encoded JSON of the object passed to dumps(). The second\ncomponent is a base64 encoded hmac/SHA-256 hash of \"$first_component:$secret\"\n\nsigning.loads(s) checks the signature and returns the deserialized object.\nIf the signature fails, a BadSignature exception is raised.\n\n>>> signing.loads(\"ImhlbGxvIg:1QaUZC:YIye-ze3TTx7gtSv422nZA4sgmk\")\n'hello'\n>>> signing.loads(\"ImhlbGxvIg:1QaUZC:YIye-ze3TTx7gtSv42-modified\")\n...\nBadSignature: Signature \"ImhlbGxvIg:1QaUZC:YIye-ze3TTx7gtSv42-modified\" does\nnot match\n\nYou can optionally compress the JSON prior to base64 encoding it to save\nspace, using the compress=True argument. This checks if compression actually\nhelps and only applies compression if the result is a shorter string:\n\n>>> signing.dumps(list(range(1, 20)), compress=True)\n'.eJwFwcERACAIwLCF-rCiILN47r-GyZVJsNgkxaFxoDgxcOHGxMKD_T7vhAml:1QaUaL:BA0thEZrp4FQVXIXuOvYJtLJSrQ'\n\nThe fact that the string is compressed is signalled by the prefixed '.' at the\nstart of the base64 JSON.\n\nThere are 65 url-safe characters: the 64 used by url-safe base64 and the ':'.\nThese functions make use of all of them.", "parse_error": ""}, {"file_path": "django/core/__init__.py", "file_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/core/paginator.py", "file_hash": "e1415c0b9d593a9debeae4346cd82c533c42f7bdb01efb6126a7b517e50d836e", "imports": [{"module": "collections.abc", "names": [], "is_from": false, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "math", "names": ["ceil"], "is_from": true, "alias": ""}, {"module": "asgiref.sync", "names": ["sync_to_async"], "is_from": true, "alias": ""}, {"module": "django.utils.deprecation", "names": ["RemovedInDjango70Warning"], "is_from": true, "alias": ""}, {"module": "django.utils.functiona