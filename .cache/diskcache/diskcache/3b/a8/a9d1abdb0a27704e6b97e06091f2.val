_line": 72}], "calls": [], "module_docstring": "Portable file locking utilities.\n\nBased partially on an example by Jonathan Feignberg in the Python\nCookbook [1] (licensed under the Python Software License) and a ctypes port by\nAnatoly Techtonik for Roundup [2] (license [3]).\n\n[1] https://code.activestate.com/recipes/65203/\n[2] https://sourceforge.net/p/roundup/code/ci/default/tree/roundup/backends/portalocker.py  # NOQA\n[3] https://sourceforge.net/p/roundup/code/ci/default/tree/COPYING.txt\n\nExample Usage::\n\n    >>> from django.core.files import locks\n    >>> with open('./file', 'wb') as f:\n    ...     locks.lock(f, locks.LOCK_EX)\n    ...     f.write('Django')", "parse_error": ""}, {"file_path": "django/core/files/uploadhandler.py", "file_hash": "c8d989eef378ad5f28b8b071ea935582e418d3de5908d190b30dcf28bed0d21a", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "io", "names": ["BytesIO", "UnsupportedOperation"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.core.files.uploadedfile", "names": ["InMemoryUploadedFile", "TemporaryUploadedFile"], "is_from": true, "alias": ""}, {"module": "django.utils.module_loading", "names": ["import_string"], "is_from": true, "alias": ""}], "functions": [{"name": "load_handler", "qualified_name": "load_handler", "args": ["path"], "decorators": [], "docstring": "Given a path to a handler, return an instance of that handler.\n\nE.g.::\n    >>> from django.http import HttpRequest\n    >>> request = HttpRequest()\n    >>> load_handler(\n    ...     'django.core.files.uploadhandler.TemporaryFileUploadHandler',\n    ...     request,\n    ... )\n    <TemporaryFileUploadHa", "start_line": 255, "end_line": 268, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "connection_reset"], "decorators": [], "docstring": "If ``connection_reset`` is ``True``, Django knows will halt the upload\nwithout consuming the rest of the upload. This will cause the browser\nto show a \"connection reset\" error.", "start_line": 37, "end_line": 43, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 45, "end_line": 49, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "request"], "decorators": [], "docstring": "", "start_line": 77, "end_line": 83, "is_async": false, "is_method": false}, {"name": "handle_raw_input", "qualified_name": "handle_raw_input", "args": ["self", "input_data", "META", "content_length", "boundary", "encoding"], "decorators": [], "docstring": "Handle the raw input from the client.\n\nParameters:\n\n    :input_data:\n        An object that supports reading via .read().\n    :META:\n        ``request.META``.\n    :content_length:\n        The (integer) value of the Content-Length header from the\n        client.\n    :boundary: The boundary from the C", "start_line": 85, "end_line": 103, "is_async": false, "is_method": false}, {"name": "new_file", "qualified_name": "new_file", "args": ["self", "field_name", "file_name", "content_type", "content_length", "charset", "content_type_extra"], "decorators": [], "docstring": "Signal that a new file has been started.\n\nWarning: As with any data from the client, you should not trust\ncontent_length (and sometimes won't even get it).", "start_line": 105, "end_line": 125, "is_async": false, "is_method": false}, {"name": "receive_data_chunk", "qualified_name": "receive_data_chunk", "args": ["self", "raw_data", "start"], "decorators": [], "docstring": "Receive data from the streamed upload parser. ``start`` is the position\nin the file of the chunk.", "start_line": 127, "end_line": 134, "is_async": false, "is_method": false}, {"name": "file_complete", "qualified_name": "file_complete", "args": ["self", "file_size"], "decorato