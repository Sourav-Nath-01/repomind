lified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 49, "end_line": 50, "is_async": false, "is_method": false}], "classes": [{"name": "Author", "bases": ["models.Model"], "methods": ["__str__"], "docstring": "", "start_line": 21, "end_line": 31}, {"name": "Article", "bases": ["models.Model"], "methods": ["__str__"], "docstring": "", "start_line": 34, "end_line": 50}, {"name": "Meta", "bases": [], "methods": [], "docstring": "", "start_line": 26, "end_line": 28}, {"name": "Meta", "bases": [], "methods": [], "docstring": "", "start_line": 46, "end_line": 47}], "calls": [], "module_docstring": "Custom column/table names\n\nIf your database column name is different than your model attribute, use the\n``db_column`` parameter. Note that you'll use the field's name, not its column\nname, in API usage.\n\nIf your database table name is different than your model name, use the\n``db_table`` Meta attribute. This has no effect on the API used to\nquery the database.\n\nIf you need to use a table name for a many-to-many relationship that differs\nfrom the default generated name, use the ``db_table`` parameter on the\n``ManyToManyField``. This has no effect on the API for querying the database.", "parse_error": ""}, {"file_path": "tests/select_related_regress/tests.py", "file_hash": "13a03cc0abdf639dd87b81ea42dfaa40d8fe95346bdf5edc8e11e1cc38d20c49", "imports": [{"module": "django.test", "names": ["TestCase"], "is_from": true, "alias": ""}, {"module": "models", "names": ["A", "B", "Building", "C", "Chick", "Child", "Class", "Client", "ClientStatus", "Connection", "Country", "Device", "Enrollment", "Hen", "Item", "Organizer", "Person", "Port", "SpecialClient", "State", "Student", "TUser"], "is_from": true, "alias": ""}], "functions": [{"name": "test_regression_7110", "qualified_name": "test_regression_7110", "args": ["self"], "decorators": [], "docstring": "Regression test for bug #7110.\n\nWhen using select_related(), we must query the\nDevice and Building tables using two different aliases (each) in order\nto differentiate the start and end Connection fields. The net result is\nthat both the \"connections = ...\" queries here should give the same\nresults wi", "start_line": 30, "end_line": 76, "is_async": false, "is_method": false}, {"name": "test_regression_8106", "qualified_name": "test_regression_8106", "args": ["self"], "decorators": [], "docstring": "Regression test for bug #8106.\n\nSame sort of problem as the previous test, but this time there are\nmore extra tables to pull in as part of the select_related() and some\nof them could potentially clash (so need to be kept separate).", "start_line": 78, "end_line": 98, "is_async": false, "is_method": false}, {"name": "test_regression_8036", "qualified_name": "test_regression_8036", "args": ["self"], "decorators": [], "docstring": "Regression test for bug #8036\n\nthe first related model in the tests below\n(\"state\") is empty and we try to select the more remotely related\nstate__country. The regression here was not skipping the empty column\nresults for country before getting status.", "start_line": 100, "end_line": 128, "is_async": false, "is_method": false}, {"name": "test_multi_table_inheritance", "qualified_name": "test_multi_table_inheritance", "args": ["self"], "decorators": [], "docstring": "Exercising select_related() with multi-table model inheritance.", "start_line": 130, "end_line": 139, "is_async": false, "is_method": false}, {"name": "test_regression_12851", "qualified_name": "test_regression_12851", "args": ["self"], "decorators": [], "docstring": "Regression for #12851\n\nDeferred fields are used correctly if you select_related a subset\nof fields.", "start_line": 141, "end_line": 196, "is_async": false, "is_method": false}, {"name": "test_null_join_promotion", "qualified_name": "test_null_join_promotion", "args": ["self"], "decorators": [], "docstring": "", "start_line": 198, "end_line": 219, "is_async": false, "is_method": false}