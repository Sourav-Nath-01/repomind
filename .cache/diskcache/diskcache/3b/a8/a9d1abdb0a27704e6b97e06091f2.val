ions until\none is found that has an outgoing dependency that isn't in another\napp's migration yet (hasn't been chopped off its list). Then chop off\nthe operations before i", "start_line": 297, "end_line": 415, "is_async": false, "is_method": false}, {"name": "_sort_migrations", "qualified_name": "_sort_migrations", "args": ["self"], "decorators": [], "docstring": "Reorder to make things possible. Reordering may be needed so FKs work\nnicely inside the same app.", "start_line": 417, "end_line": 433, "is_async": false, "is_method": false}, {"name": "_optimize_migrations", "qualified_name": "_optimize_migrations", "args": ["self"], "decorators": [], "docstring": "", "start_line": 435, "end_line": 451, "is_async": false, "is_method": false}, {"name": "check_dependency", "qualified_name": "check_dependency", "args": ["self", "operation", "dependency"], "decorators": [], "docstring": "Return True if the given operation depends on the given dependency,\nFalse otherwise.", "start_line": 453, "end_line": 547, "is_async": false, "is_method": false}, {"name": "add_operation", "qualified_name": "add_operation", "args": ["self", "app_label", "operation", "dependencies", "beginning"], "decorators": [], "docstring": "", "start_line": 549, "end_line": 556, "is_async": false, "is_method": false}, {"name": "swappable_first_key", "qualified_name": "swappable_first_key", "args": ["self", "item"], "decorators": [], "docstring": "Place potential swappable models first in lists of created models (only\nreal way to solve #22783).", "start_line": 558, "end_line": 579, "is_async": false, "is_method": false}, {"name": "generate_renamed_models", "qualified_name": "generate_renamed_models", "args": ["self"], "decorators": [], "docstring": "Find any renamed models, generate the operations for them, and remove\nthe old entry from the model lists. Must be run before other\nmodel-level generation.", "start_line": 581, "end_line": 647, "is_async": false, "is_method": false}, {"name": "generate_cr