 template source into a nodelist. If debug\nis True and an exception occurs during parsing, the exception is\nannotated with contextual line information where it occurred in the\ntemplate source.", "start_line": 178, "end_line": 213, "is_async": false, "is_method": false}, {"name": "get_exception_info", "qualified_name": "get_exception_info", "args": ["self", "exception", "token"], "decorators": [], "docstring": "Return a dictionary containing contextual line information of where\nthe exception occurred in the template. The following information is\nprovided:\n\nmessage\n    The message of the exception raised.\n\nsource_lines\n    The lines before, after, and including the line the exception\n    occurred on.\n\nline\n", "start_line": 215, "end_line": 291, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "nodelist", "origin", "name", "source_start", "source_end"], "decorators": [], "docstring": "", "start_line": 301, "end_line": 308, "is_async": false, "is_method": false}, {"name": "get_exception_info", "qualified_name": "get_exception_info", "args": ["self", "exception", "token"], "decorators": [], "docstring": "", "start_line": 310, "end_line": 312, "is_async": false, "is_method": false}, {"name": "find_partial_source", "qualified_name": "find_partial_source", "args": ["self", "full_source"], "decorators": [], "docstring": "", "start_line": 314, "end_line": 322, "is_async": false, "is_method": false}, {"name": "source", "qualified_name": "source", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 325, "end_line": 334, "is_async": false, "is_method": false}, {"name": "_render", "qualified_name": "_render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 336, "end_line": 337, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 339, "end_line": 346, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "token_type", "contents", "position", "lineno"], "decorators": [], "docstring": "A token representing a string from the template.\n\ntoken_type\n    A TokenType, either .TEXT, .VAR, .BLOCK, or .COMMENT.\n\ncontents\n    The token source string.\n\nposition\n    An optional tuple containing the start and end index of the token\n    in the template source. This is used for traceback informa", "start_line": 359, "end_line": 381, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 383, "end_line": 388, "is_async": false, "is_method": false}, {"name": "split_contents", "qualified_name": "split_contents", "args": ["self"], "decorators": [], "docstring": "", "start_line": 390, "end_line": 403, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "template_string"], "decorators": [], "docstring": "", "start_line": 407, "end_line": 409, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 411, "end_line": 416, "is_async": false, "is_method": false}, {"name": "tokenize", "qualified_name": "tokenize", "args": ["self"], "decorators": [], "docstring": "Return a list of tokens from a given template_string.", "start_line": 418, "end_line": 430, "is_async": false, "is_method": false}, {"name": "create_token", "qualified_name": "create_token", "args": ["self", "token_string", "position", "lineno", "in_tag"], "decorators": [], "docstring": "Convert the given token string into a new Token object and return it.\nIf in_tag is True, we are processing something that matched a tag,\notherwise it should be treated as a literal string.", "start_line": 432, "end_line": 464, "is_async": false, "is_method": false}, {"name": "_tag_re_split_positions", "qualified_name": "_tag_re_split_positions", "args": ["self"], "decorators": [], "docstring": "", "start_line": 468, "end_line": 475, "is_async": false, "is_method": false}, {"name": "_tag_re_split", "qualified_name": "_tag_re_split", "args": ["self"], "decorators": [], "docstring": "", "start_line": 478, "end_line": 480, "is_async": false, "is_method": false}, {"name": "tokenize", "qualified_name": "tokenize", "args": ["self"], "decorators": [], "docstring": "Split a template string into tokens and annotates each token with its\nstart and end position in the source. This is slower than the default\nlexer so only use it when debug is True.", "start_line": 482, "end_line": 498, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "tokens", "libraries", "builtins", "origin"], "decorators": [], "docstring": "", "start_line": 502, "end_line": 524, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 526, "end_line": 527, "is_async": false, "is_method": false}, {"name": "parse", "qualified_name": "parse", "args": ["self", "parse_until"], "decorators": [], "docstring": "Iterate through the parser tokens and compiles each one into a node.\n\nIf parse_until is provided, parsing will stop once one of the\nspecified tokens has been reached. This is formatted as a list of\ntokens, e.g. ['elif', 'else', 'endif']. If no matching token is\nreached, raise an exception with the u", "start_line": 529, "end_line": 608, "is_async": false, "is_method": false}, {"name": "skip_past", "qualified_name": "skip_past", "args": ["self", "endtag"], "decorators": [], "docstring": "", "start_line": 610, "end_line": 615, "is_async": false, "is_method": false}, {"name": "extend_nodelist", "qualified_name": "extend_nodelist", "args": ["self", "nodelist", "node", "token"], "decorators": [], "docstring": "", "start_line": 617, "end_line": 634, "is_async": false, "is_method": false}, {"name": "error", "qualified_name": "error", "args": ["self", "token", "e"], "decorators": [], "docstring": "Return an exception annotated with the originating token. Since the\nparser can be called recursively, check if a token is already set. This\nensures the innermost token is highlighted if an exception occurs,\ne.g. a compile error within the body of an if statement.", "start_line": 636, "end_line": 647, "is_async": false, "is_method": false}, {"name": "invalid_block_tag", "qualified_name": "invalid_block_tag", "args": ["self", "token", "command", "parse_until"], "decorators": [], "docstring": "", "start_line": 649, "end_line": 665, "is_async": false, "is_method": false}, {"name": "unclosed_block_tag", "qualified_name": "unclosed_block_tag", "args": ["self", "parse_until"], "decorators": [], "docstring": "", "start_line": 667, "end_line": 674, "is_async": false, "is_method": false}, {"name": "next_token", "qualified_name": "next_token", "args": ["self"], "decorators": [], "docstring": "", "start_line": 676, "end_line": 677, "is_async": false, "is_method": false}, {"name": "prepend_token", "qualified_name": "prepend_token", "args": ["self", "token"], "decorators": [], "docstring": "", "start_line": 679, "end_line": 680, "is_async": false, "is_method": false}, {"name": "delete_first_token", "qualified_name": "delete_first_token", "args": ["self"], "decorators": [], "docstring": "", "start_line": 682, "end_line": 683, "is_async": false, "is_method": false}, {"name": "add_library", "qualified_name": "add_library", "args": ["self", "lib"], "decorators": [], "docstring": "", "start_line": 685, "end_line": 687, "is_async": false, "is_method": false}, {"name": "compile_filter", "qualified_name": "compile_filter", "args": ["self", "token"], "decorators": [], "docstring": "Convenient wrapper for FilterExpression", "start_line": 689, "end_line": 693, "is_async": false, "is_method": false}, {"name": "find_filter", "qualified_name": "find_filter", "args": ["self", "filter_name"], "decorators": [], "docstring": "", "start_line": 695, "end_line": 699, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "token", "parser"], "decorators": [], "docstring": "", "start_line": 756, "end_line": 800, "is_async": false, "is_method": false}, {"name": "resolve", "qualified_name": "resolve", "args": ["self", "context", "ignore_failures"], "decorators": [], "docstring": "", "start_line": 802, "end_line": 837, "is_async": false, "is_method": false}, {"name": "args_check", "qualified_name": "args_check", "args": ["name", "func", "provided"], "decorators": [], "docstring": "", "start_line": 839, "end_line": 855, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 859, "end_line": 860, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 862, "end_line": 863, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "var"], "decorators": [], "docstring": "", "start_line": 887, "end_line": 938, "is_async": false, "is_method": false}, {"name": "resolve", "qualified_name": "resolve", "args": ["self", "context"], "decorators": [], "docstring": "Resolve this variable against a given context.", "start_line": 940, "end_line": 956, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 958, "end_line": 959, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 961, "end_line": 962, "is_async": false, "is_method": false}, {"name": "_resolve_lookup", "qualified_name": "_resolve_lookup", "args": ["self", "context"], "decorators": [], "docstring": "Perform resolution of a real variable (i.e. not a literal) against the\ngiven context.\n\nAs indicated by the method's name, this method is an implementation\ndetail and shouldn't be called by external code. Use Variable.resolve()\ninstead.", "start_line": 964, "end_line": 1044, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "Return the node rendered as a string.", "start_line": 1054, "end_line": 1058, "is_async": false, "is_method": false}, {"name": "render_annotated", "qualified_name": "render_annotated", "args": ["self", "context"], "decorators": [], "docstring": "Render the node. If debug is True and an exception occurs during\nrendering, the exception is annotated with contextual line information\nwhere it occurred in the template. For internal usage this method is\npreferred over using the render method directly.", "start_line": 1060, "end_line": 1084, "is_async": false, "is_method": false}, {"name": "get_nodes_by_type", "qualified_name": "get_nodes_by_type", "args": ["self", "nodetype"], "decorators": [], "docstring": "Return a list of all nodes (within this node and its nodelist)\nof the given type", "start_line": 1086, "end_line": 1098, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 1106, "end_line": 1107, "is_async": false, "is_method": false}, {"name": "get_nodes_by_type", "qualified_name": "get_nodes_by_type", "args": ["self", "nodetype"], "decorators": [], "docstring": "Return a list of all nodes of the given type", "start_line": 1109, "end_line": 1114, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "s"], "decorators": [], "docstring": "", "start_line": 1120, "end_line": 1121, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1123, "end_line": 1124, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 1126, "end_line": 1127, "is_async": false, "is_method": false}, {"name": "render_annotated", "qualified_name": "render_annotated", "args": ["self", "context"], "decorators": [], "docstring": "Return the given value.\n\nThe default implementation of this method handles exceptions raised\nduring rendering, which is not necessary for text nodes.", "start_line": 1129, "end_line": 1136, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "filter_expression"], "decorators": [], "docstring": "", "start_line": 1158, "end_line": 1159, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1161, "end_line": 1162, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 1164, "end_line": 1172, "is_async": false, "is_method": false}], "classes": [{"name": "TokenType", "bases": ["Enum"], "methods": [], "docstring": "", "start_line": 97, "end_line": 101}, {"name": "VariableDoesNotExist", "bases": ["Exception"], "methods": ["__init__", "__str__"], "docstring": "", "start_line": 104, "end_line": 110}, {"name": "Origin", "bases": [], "methods": ["__init__", "__str__", "__repr__", "__eq__", "loader_name"], "docstring": "", "start_line": 113, "end_line": 138}, {"name": "Template", "bases": [], "methods": ["__init__", "__repr__", "_render", "render", "compile_nodelist", "get_exception_info"], "docstring": "", "start_line": 141, "end_line": 291}, {"name": "PartialTemplate", "bases": [], "methods": ["__init__", "get_exception_info", "find_partial_source", "source", "_render", "render"], "docstring": "A lightweight Template lookalike used for template partials.\n\nWraps nodelist as a partial, in order to be able to bind context.", "start_line": 294, "end_line": 346}, {"name": "Token", "bases": [], "methods": ["__init__", "__repr__", "split_contents"], "docstring": "", "start_line": 358, "end_line": 403}, {"name": "Lexer", "bases": [], "methods": ["__init__", "__repr__", "tokenize", "create_token"], "docstring": "", "start_line": 406, "end_line": 464}, {"name": "DebugLexer", "bases": ["Lexer"], "methods": ["_tag_re_split_positions", "_tag_re_split", "tokenize"], "docstring": "", "start_line": 467, "end_line": 498}, {"name": "Parser", "bases": [], "methods": ["__init__", "__repr__", "parse", "skip_past", "extend_nodelist", "error", "invalid_block_tag", "unclosed_block_tag", "next_token", "prepend_token", "delete_first_token", "add_library", "compile_filter", "find_filter"], "docstring": "", "start_line": 501, "end_line": 699}, {"name": "FilterExpression", "bases": [], "methods": ["__init__", "resolve", "args_check", "__str__", "__repr__"], "docstring": "Parse a variable token and its optional filters (all as a single string),\nand return a list of tuples of the filter name and arguments.\nSample::\n\n    >>> token = 'variable|default:\"Default value\"|date:\"Y-m-d\"'\n    >>> p = Parser('')\n    >>> fe = FilterExpression(token, p)\n    >>> len(fe.filters)\n   ", "start_line": 739, "end_line": 863}, {"name": "Variable", "bases": [], "methods": ["__init__", "resolve", "__repr__", "__str__", "_resolve_lookup"], "docstring": "A template variable, resolvable against a given context. The variable may\nbe a hard-coded string (if it begins and ends with single or double quote\nmarks)::\n\n    >>> c = {'article': {'section':'News'}}\n    >>> Variable('article.section').resolve(c)\n    'News'\n    >>> Variable('article').resolve(c)\n ", "start_line": 866, "end_line": 1044}, {"name": "Node", "bases": [], "methods": ["render", "render_annotated", "get_nodes_by_type"], "docstring": "", "start_line": 1047, "end_line": 1098}, {"name": "NodeList", "bases": ["list"], "methods": ["render", "get_nodes_by_type"], "docstring": "", "start_line": 1101, "end_line": 1114}, {"name": "TextNode", "bases": ["Node"], "methods": ["__init__", "__repr__", "render", "render_annotated"], "docstring": "", "start_line": 1117, "end_line": 1136}, {"name": "VariableNode", "bases": ["Node"], "methods": ["__init__", "__repr__", "render"], "docstring": "", "start_line": 1155, "end_line": 1172}], "calls": [], "module_docstring": "This is the Django template system.\n\nHow it works:\n\nThe Lexer.tokenize() method converts a template string (i.e., a string\ncontaining markup with custom template tags) to tokens, which can be either\nplain text (TokenType.TEXT), variables (TokenType.VAR), or block statements\n(TokenType.BLOCK).\n\nThe Parser() class takes a list of tokens in its constructor, and its parse()\nmethod returns a compiled template -- which is, under the hood, a list of\nNode objects.\n\nEach Node is responsible for creating some sort of output -- e.g. simple text\n(TextNode), variable values in a given context (VariableNode), results of basic\nlogic (IfNode), results of looping (ForNode), or anything else. The core Node\ntypes are TextNode, VariableNode, IfNode and ForNode, but plugin modules can\ndefine their own custom node types.\n\nEach Node has a render() method, which takes a Context and returns a string of\nthe rendered node. For example, the render() method of a Variable Node returns\nthe variable's value as a string. The render() method of a ForNode returns the\nrendered output of whatever was inside the loop, recursively.\n\nThe Template class is a convenient wrapper that takes care of template\ncompilation and rendering.\n\nUsage:\n\nThe only thing you should ever use directly in this file is the Template class.\nCreate a compiled template object with a template_string, then call render()\nwith a context. In the compilation stage, the TemplateSyntaxError exception\nwill be raised if the template doesn't have proper syntax.\n\nSample code:\n\n>>> from django import template\n>>> s = '<html>{% if test %}<h1>{{ varvalue }}</h1>{% endif %}</html>'\n>>> t = template.Template(s)\n\n(t is now a compiled template, and its render() method can be called multiple\ntimes with multiple contexts)\n\n>>> c = template.Context({'test':True, 'varvalue': 'Hello'})\n>>> t.render(c)\n'<html><h1>Hello</h1></html>'\n>>> c = template.Context({'test':False, 'varvalue': 'Hello'})\n>>> t.render(c)\n'<html></html>'", "parse_error": ""}, {"file_path": "django/template/__init__.py", "file_hash": "8fa3e48869837867ae26155905303139953f71c86d52fb4c80e38858d06eac09", "imports": [{"module": "engine", "names": ["Engine"], "is_from": true, "alias": ""}, {"module": "utils", "names": ["EngineHandler"], "is_from": true, "alias": ""}, {"module": "base", "names": ["VariableDoesNotExist"], "is_from": true, "alias": ""}, {"module": "context", "names": ["Context", "ContextPopException", "RequestContext"], "is_from": true, "alias": ""}, {"module": "exceptions", "names": ["TemplateDoesNotExist", "TemplateSyntaxError"], "is_from": true, "alias": ""}, {"module": "base", "names": ["Node", "NodeList", "Origin", "PartialTemplate", "Template", "Variable"], "is_from": true, "alias": ""}, {"module": "library", "names": ["Library"], "is_from": true, "alias": ""}, {"module": "", "names": ["autoreload"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "Django's support for templates.\n\nThe django.template namespace contains two independent subsystems:\n\n1. Multiple Template Engines: support for pluggable template backends,\n   built-in backends and backend-independent APIs\n2. Django Template Language: Django's own template engine, including its\n   built-in loaders, context processors, tags and filters.\n\nIdeally these subsystems would be implemented in distinct packages. However\nkeeping them together made the implementation of Multiple Template Engines\nless disruptive .\n\nHere's a breakdown of which modules belong to which subsystem.\n\nMultiple Template Engines:\n\n- django.template.backends.*\n- django.template.loader\n- django.template.response\n\nDjango Template Language:\n\n- django.template.base\n- django.template.context\n- django.template.context_processors\n- django.template.loaders.*\n- django.template.debug\n- django.template.defaultfilters\n- django.template.defaulttags\n- django.template.engine\n- django.template.loader_tags\n- django.template.smartif\n\nShared:\n\n- django.template.utils", "parse_error": ""}, {"file_path": "django/template/defaultfilters.py", "file_hash": "040aeab122c4db17116c8259b06d53682c98449286092f339911c09ed301ebb9", "imports": [{"module": "random", "names": [], "is_from": false, "alias": "random_module"}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "types", "names": [], "is_from": false, "alias": ""}, {"module": "decimal", "names": ["ROUND_HALF_UP", "Context", "Decimal", "InvalidOperation", "getcontext"], "is_from": true, "alias": ""}, {"module": "functools", "names": ["wraps"], "is_from": true, "alias": ""}, {"module": "inspect", "names": ["unwrap"], "is_from": true, "alias": ""}, {"module": "operator", "names": ["itemgetter"], "is_from": true, "alias": ""}, {"module": "pprint", "names": ["pformat"], "is_from": true, "alias": ""}, {"module": "urllib.parse", "names": ["quote"], "is_from": true, "alias": ""}, {"module": "django.utils", "names": ["formats"], "is_from": true, "alias": ""}, {"module": "django.utils.dateformat", "names": ["format", "time_format"], "is_from": true, "alias": ""}, {"module": "django.utils.encoding", "names": ["iri_to_uri"], "is_from": true, "alias": ""}, {"module": "django.utils.html", "names": ["avoid_wrapping", "conditional_escape", "escape", "escapejs"], "is_from": true, "alias": ""}, {"module": "django.utils.html", "names": ["json_script"], "is_from": true, "alias": ""}, {"module": "django.utils.html", "names": ["linebreaks", "strip_tags"], "is_from": true, "alias": ""}, {"module": "django.utils.html", "names": ["urlize"], "is_from": true, "alias": ""}, {"module": "django.utils.safestring", "names": ["SafeData", "mark_safe"], "is_from": true, "alias": ""}, {"module": "django.utils.text", "names": ["Truncator", "normalize_newlines", "phone2numeric"], "is_from": true, "alias": ""}, {"module": "django.utils.text", "names": ["slugify"], "is_from": true, "alias": ""}, {"module": "django.utils.text", "names": ["wrap"], "is_from": true, "alias": ""}, {"module": "django.utils.timesince", "names": ["timesince", "timeuntil"], "is_from": true, "alias": ""}, {"module": "django.utils.translation", "names": ["gettext", "ngettext"], "is_from": true, "alias": ""}, {"module": "base", "names": ["VARIABLE_ATTRIBUTE_SEPARATOR"], "is_from": true, "alias": ""}, {"module": "library", "names": ["Library"], "is_from": true, "alias": ""}], "functions": [{"name": "stringfilter", "qualified_name": "stringfilter", "args": ["func"], "decorators": [], "docstring": "Decorator for filters which should only receive strings. The object\npassed as the first positional argument will be converted to a string.", "start_line": 38, "end_line": 52, "is_async": false, "is_method": false}, {"name": "addslashes", "qualified_name": "addslashes", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Add slashes before quotes. Useful for escaping strings in CSV, for\nexample. Less useful for escaping JavaScript; use the ``escapejs``\nfilter instead.", "start_line": 62, "end_line": 68, "is_async": false, "is_method": false}, {"name": "capfirst", "qualified_name": "capfirst", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Capitalize the first character of the value.", "start_line": 73, "end_line": 75, "is_async": false, "is_method": false}, {"name": "escapejs_filter", "qualified_name": "escapejs_filter", "args": ["value"], "decorators": ["register.filter('escapejs')", "stringfilter"], "docstring": "Hex encode characters for use in JavaScript strings.", "start_line": 80, "end_line": 82, "is_async": false, "is_method": false}, {"name": "json_script", "qualified_name": "json_script", "args": ["value", "element_id"], "decorators": ["register.filter(is_safe=True)"], "docstring": "Output value JSON-encoded, wrapped in a <script type=\"application/json\">\ntag (with an optional id).", "start_line": 86, "end_line": 91, "is_async": false, "is_method": false}, {"name": "floatformat", "qualified_name": "floatformat", "args": ["text", "arg"], "decorators": ["register.filter(is_safe=True)"], "docstring": "Display a float to a specified number of decimal places.\n\nIf called without an argument, display the floating point number with one\ndecimal place -- but only if there's a decimal place to be displayed:\n\n* num1 = 34.23234\n* num2 = 34.00000\n* num3 = 34.26000\n* {{ num1|floatformat }} displays \"34.2\"\n* ", "start_line": 95, "end_line": 220, "is_async": false, "is_method": false}, {"name": "iriencode", "qualified_name": "iriencode", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Escape an IRI value for use in a URL.", "start_line": 225, "end_line": 227, "is_async": false, "is_method": false}, {"name": "linenumbers", "qualified_name": "linenumbers", "args": ["value", "autoescape"], "decorators": ["register.filter(is_safe=True, needs_autoescape=True)", "stringfilter"], "docstring": "Display text with line numbers.", "start_line": 232, "end_line": 244, "is_async": false, "is_method": false}, {"name": "lower", "qualified_name": "lower", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Convert a string into all lowercase.", "start_line": 249, "end_line": 251, "is_async": false, "is_method": false}, {"name": "make_list", "qualified_name": "make_list", "args": ["value"], "decorators": ["register.filter(is_safe=False)", "stringfilter"], "docstring": "Return the value turned into a list.\n\nFor an integer, it's a list of digits.\nFor a string, it's a list of characters.", "start_line": 256, "end_line": 263, "is_async": false, "is_method": false}, {"name": "slugify", "qualified_name": "slugify", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Convert to ASCII. Convert spaces to hyphens. Remove characters that aren't\nalphanumerics, underscores, or hyphens. Convert to lowercase. Also strip\nleading and trailing whitespace.", "start_line": 268, "end_line": 274, "is_async": false, "is_method": false}, {"name": "stringformat", "qualified_name": "stringformat", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)"], "docstring": "Format the variable according to the arg, a string formatting specifier.\n\nThis specifier uses Python string formatting syntax, with the exception\nthat the leading \"%\" is dropped.\n\nSee\nhttps://docs.python.org/library/stdtypes.html#printf-style-string-formatting\nfor documentation of Python string form", "start_line": 278, "end_line": 294, "is_async": false, "is_method": false}, {"name": "title", "qualified_name": "title", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Convert a string into titlecase.", "start_line": 299, "end_line": 302, "is_async": false, "is_method": false}, {"name": "truncatechars", "qualified_name": "truncatechars", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Truncate a string after `arg` number of characters.", "start_line": 307, "end_line": 313, "is_async": false, "is_method": false}, {"name": "truncatechars_html", "qualified_name": "truncatechars_html", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Truncate HTML after `arg` number of chars.\nPreserve newlines in the HTML.", "start_line": 318, "end_line": 327, "is_async": false, "is_method": false}, {"name": "truncatewords", "qualified_name": "truncatewords", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Truncate a string after `arg` number of words.\nRemove newlines within the string.", "start_line": 332, "end_line": 341, "is_async": false, "is_method": false}, {"name": "truncatewords_html", "qualified_name": "truncatewords_html", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Truncate HTML after `arg` number of words.\nPreserve newlines in the HTML.", "start_line": 346, "end_line": 355, "is_async": false, "is_method": false}, {"name": "upper", "qualified_name": "upper", "args": ["value"], "decorators": ["register.filter(is_safe=False)", "stringfilter"], "docstring": "Convert a string into all uppercase.", "start_line": 360, "end_line": 362, "is_async": false, "is_method": false}, {"name": "urlencode", "qualified_name": "urlencode", "args": ["value", "safe"], "decorators": ["register.filter(is_safe=False)", "stringfilter"], "docstring": "Escape a value for use in a URL.\n\nThe ``safe`` parameter determines the characters which should not be\nescaped by Python's quote() function. If not provided, use the default safe\ncharacters (but an empty string can be provided when *all* characters\nshould be escaped).", "start_line": 367, "end_line": 379, "is_async": false, "is_method": false}, {"name": "urlize", "qualified_name": "urlize", "args": ["value", "autoescape"], "decorators": ["register.filter(is_safe=True, needs_autoescape=True)", "stringfilter"], "docstring": "Convert URLs in plain text into clickable links.", "start_line": 384, "end_line": 386, "is_async": false, "is_method": false}, {"name": "urlizetrunc", "qualified_name": "urlizetrunc", "args": ["value", "limit", "autoescape"], "decorators": ["register.filter(is_safe=True, needs_autoescape=True)", "stringfilter"], "docstring": "Convert URLs into clickable links, truncating URLs to the given character\nlimit, and adding 'rel=nofollow' attribute to discourage spamming.\n\nArgument: Length to truncate URLs to.", "start_line": 391, "end_line": 400, "is_async": false, "is_method": false}, {"name": "wordcount", "qualified_name": "wordcount", "args": ["value"], "decorators": ["register.filter(is_safe=False)", "stringfilter"], "docstring": "Return the number of words.", "start_line": 405, "end_line": 407, "is_async": false, "is_method": false}, {"name": "wordwrap", "qualified_name": "wordwrap", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Wrap words at `arg` line length.", "start_line": 412, "end_line": 414, "is_async": false, "is_method": false}, {"name": "ljust", "qualified_name": "ljust", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Left-align the value in a field of a given width.", "start_line": 419, "end_line": 421, "is_async": false, "is_method": false}, {"name": "rjust", "qualified_name": "rjust", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Right-align the value in a field of a given width.", "start_line": 426, "end_line": 428, "is_async": false, "is_method": false}, {"name": "center", "qualified_name": "center", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Center the value in a field of a given width.", "start_line": 433, "end_line": 438, "is_async": false, "is_method": false}, {"name": "cut", "qualified_name": "cut", "args": ["value", "arg"], "decorators": ["register.filter", "stringfilter"], "docstring": "Remove all values of arg from the given string.", "start_line": 443, "end_line": 449, "is_async": false, "is_method": false}, {"name": "escape_filter", "qualified_name": "escape_filter", "args": ["value"], "decorators": ["register.filter('escape', is_safe=True)", "stringfilter"], "docstring": "Mark the value as a string that should be auto-escaped.", "start_line": 459, "end_line": 461, "is_async": false, "is_method": false}, {"name": "escapeseq", "qualified_name": "escapeseq", "args": ["value"], "decorators": ["register.filter(is_safe=True)"], "docstring": "An \"escape\" filter for sequences. Mark each element in the sequence,\nindividually, as a string that should be auto-escaped. Return a list with\nthe results.", "start_line": 465, "end_line": 471, "is_async": false, "is_method": false}, {"name": "force_escape", "qualified_name": "force_escape", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Escape a string's HTML. Return a new string containing the escaped\ncharacters (as opposed to \"escape\", which marks the content for later\npossible escaping).", "start_line": 476, "end_line": 482, "is_async": false, "is_method": false}, {"name": "linebreaks_filter", "qualified_name": "linebreaks_filter", "args": ["value", "autoescape"], "decorators": ["register.filter('linebreaks', is_safe=True, needs_autoescape=True)", "stringfilter"], "docstring": "Replace line breaks in plain text with appropriate HTML; a single\nnewline becomes an HTML line break (``<br>``) and a new line\nfollowed by a blank line becomes a paragraph break (``</p>``).", "start_line": 487, "end_line": 494, "is_async": false, "is_method": false}, {"name": "linebreaksbr", "qualified_name": "linebreaksbr", "args": ["value", "autoescape"], "decorators": ["register.filter(is_safe=True, needs_autoescape=True)", "stringfilter"], "docstring": "Convert all newlines in a piece of plain text to HTML line breaks\n(``<br>``).", "start_line": 499, "end_line": 508, "is_async": false, "is_method": false}, {"name": "safe", "qualified_name": "safe", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Mark the value as a string that should not be auto-escaped.", "start_line": 513, "end_line": 515, "is_async": false, "is_method": false}, {"name": "safeseq", "qualified_name": "safeseq", "args": ["value"], "decorators": ["register.filter(is_safe=True)"], "docstring": "A \"safe\" filter for sequences. Mark each element in the sequence,\nindividually, as safe, after converting them to strings. Return a list\nwith the results.", "start_line": 519, "end_line": 525, "is_async": false, "is_method": false}, {"name": "striptags", "qualified_name": "striptags", "args": ["value"], "decorators": ["register.filter(is_safe=True)", "stringfilter"], "docstring": "Strip all [X]HTML tags.", "start_line": 530, "end_line": 532, "is_async": false, "is_method": false}, {"name": "_property_resolver", "qualified_name": "_property_resolver", "args": ["arg"], "decorators": [], "docstring": "When arg is convertible to float, behave like operator.itemgetter(arg)\nOtherwise, chain __getitem__() and getattr().\n\n>>> _property_resolver(1)('abc')\n'b'\n>>> _property_resolver('1')('abc')\nTraceback (most recent call last):\n...\nTypeError: string indices must be integers\n>>> class Foo:\n...     a = 4", "start_line": 540, "end_line": 575, "is_async": false, "is_method": false}, {"name": "dictsort", "qualified_name": "dictsort", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=False)"], "docstring": "Given a list of dicts, return that list sorted by the property given in\nthe argument.", "start_line": 579, "end_line": 587, "is_async": false, "is_method": false}, {"name": "dictsortreversed", "qualified_name": "dictsortreversed", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=False)"], "docstring": "Given a list of dicts, return that list sorted in reverse order by the\nproperty given in the argument.", "start_line": 591, "end_line": 599, "is_async": false, "is_method": false}, {"name": "first", "qualified_name": "first", "args": ["value"], "decorators": ["register.filter(is_safe=False)"], "docstring": "Return the first item in a list.", "start_line": 603, "end_line": 608, "is_async": false, "is_method": false}, {"name": "join", "qualified_name": "join", "args": ["value", "arg", "autoescape"], "decorators": ["register.filter(is_safe=True, needs_autoescape=True)"], "docstring": "Join a list with a string, like Python's ``str.join(list)``.", "start_line": 612, "end_line": 621, "is_async": false, "is_method": false}, {"name": "last", "qualified_name": "last", "args": ["value"], "decorators": ["register.filter(is_safe=True)"], "docstring": "Return the last item in a list.", "start_line": 625, "end_line": 630, "is_async": false, "is_method": false}, {"name": "length", "qualified_name": "length", "args": ["value"], "decorators": ["register.filter(is_safe=False)"], "docstring": "Return the length of the value - useful for lists.", "start_line": 634, "end_line": 639, "is_async": false, "is_method": false}, {"name": "random", "qualified_name": "random", "args": ["value"], "decorators": ["register.filter(is_safe=True)"], "docstring": "Return a random item from the list.", "start_line": 643, "end_line": 648, "is_async": false, "is_method": false}, {"name": "slice_filter", "qualified_name": "slice_filter", "args": ["value", "arg"], "decorators": ["register.filter('slice', is_safe=True)"], "docstring": "Return a slice of the list using the same syntax as Python's list slicing.", "start_line": 652, "end_line": 666, "is_async": false, "is_method": false}, {"name": "_walk_items", "qualified_name": "_walk_items", "args": ["item_list"], "decorators": [], "docstring": "", "start_line": 669, "end_line": 691, "is_async": false, "is_method": false}, {"name": "unordered_list", "qualified_name": "unordered_list", "args": ["value", "autoescape"], "decorators": ["register.filter(is_safe=True, needs_autoescape=True)"], "docstring": "Recursively take a self-nested list and return an HTML unordered list --\nWITHOUT opening and closing <ul> tags.\n\nAssume the list is in the proper format. For example, if ``var`` contains:\n``['States', ['Kansas', ['Lawrence', 'Topeka'], 'Illinois']]``, then\n``{{ var|unordered_list }}`` returns::\n\n   ", "start_line": 695, "end_line": 738, "is_async": false, "is_method": false}, {"name": "add", "qualified_name": "add", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=False)"], "docstring": "Add the arg to the value.", "start_line": 747, "end_line": 755, "is_async": false, "is_method": false}, {"name": "get_digit", "qualified_name": "get_digit", "args": ["value", "arg"], "decorators": ["register.filter(is_safe=False)"], "docstring": "Given a whole number, return the requested digit of it, where 1 is the\nright-most digit, 2 is the second-right-most digit, etc. Return the\noriginal value for invalid input (if input or argument is not an integer,\nor if argument is less than 1). Otherwise, output is always an integer.", "start_line": 759, "end_line": 776, "is_async": false, "is_method": false}, {"name": "date", "qualified_name": "date", "args": ["value", "arg"], "decorators": ["register.filter(expects_localtime=True, is_safe=False)"], "docstring": "Format a date according to the given format.", "start_line": 785, "end_line": 795, "is_async": false, "is_method": false}, {"name": "time", "qualified_name": "time", "args": ["value", "arg"], "decorators": ["register.filter(expects_localtime=True, is_safe=False)"], "docstring": "Format a time according to the given format.", "start_line": 799, "end_line": 809, "is_async": false, "is_method": false}, {"name": "timesince_filter", "qualified_name": "timesince_filter", "args": ["value", "arg"], "decorators": ["register.filter('timesince', is_safe=False)"], "docstring": "Format a date as the time since that date (i.e. \"4 days, 6 hours\").", "start_line": 813, "end_line": 822, "is_async": false, "is_method": false}, {"name": "timeuntil_filter", "qualified_name": "timeuntil_filte