], "docstring": "Return a list of SQL statements required to remove all data from\nthe given database tables (without actually removing the tables\nthemselves).\n\nThe `style` argument is a Style object as returned by either\ncolor_style() or no_style() in django.core.management.color.\n\nIf `reset_sequences` is True, the ", "start_line": 463, "end_line": 481, "is_async": false, "is_method": false}, {"name": "execute_sql_flush", "qualified_name": "execute_sql_flush", "args": ["self", "sql_list"], "decorators": [], "docstring": "Execute a list of SQL statements to flush the database.", "start_line": 483, "end_line": 491, "is_async": false, "is_method": false}, {"name": "sequence_reset_by_name_sql", "qualified_name": "sequence_reset_by_name_sql", "args": ["self", "style", "sequences"], "decorators": [], "docstring": "Return a list of the SQL statements required to reset sequences\npassed in `sequences`.\n\nThe `style` argument is a Style object as returned by either\ncolor_style() or no_style() in django.core.management.color.", "start_line": 493, "end_line": 501, "is_async": false, "is_method": false}, {"name": "sequence_reset_sql", "qualified_name": "sequence_reset_sql", "args": ["self", "style", "model_list"], "decorators": [], "docstring": "Return a list of the SQL statements required to reset sequences for\nthe given models.\n\nThe `style` argument is a Style object as returned by either\ncolor_style() or no_style() in django.core.management.color.", "start_line": 503, "end_line": 511, "is_async": false, "is_method": false}, {"name": "start_transaction_sql", "qualified_name": "start_transaction_sql", "args": ["self"], "decorators": [], "docstring": "Return the SQL statement required to start a transaction.", "start_line": 513, "end_line": 515, "is_async": false, "is_method": false}, {"name": "end_transaction_sql", "qualified_name": "end_transaction_sql", "args": ["self", "success"], "decorators": [], "docstring": "Return the SQL statement required to end a transaction.", "start_line": 517, "end_line": 521, "is_async": false, "is_method": false}, {"name": "tablespace_sql", "qualified_name": "tablespace_sql", "args": ["self", "tablespace", "inline"], "decorators": [], "docstring": "Return the SQL that will be used in a query to define the tablespace.\n\nReturn '' if the backend doesn't support tablespaces.\n\nIf `inline` is True, append the SQL to a row; otherwise append it to\nthe entire CREATE TABLE or CREATE INDEX statement.", "start_line": 523, "end_line": 532, "is_async": false, "is_method": false}, {"name": "prep_for_like_query", "qualified_name": "prep_for_like_query", "args": ["self", "x"], "decorators": [], "docstring": "Prepare a value for use in a LIKE query.", "start_line": 534, "end_line": 536, "is_async": false, "is_method": false}, {"name": "validate_autopk_value", "qualified_name": "validate_autopk_value", "args": ["self", "value"], "decorators": [], "docstring": "Certain backends do not accept some values for \"serial\" fields\n(for example zero in MySQL). Raise a ValueError if the value is\ninvalid, otherwise return the validated value.", "start_line": 542, "end_line": 548, "is_async": false, "is_method": false}, {"name": "adapt_unknown_value", "qualified_name": "adapt_unknown_value", "args": ["self", "value"], "decorators": [], "docstring": "Transform a value to something compatible with the backend driver.\n\nThis method only depends on the type of the value. It's designed for\ncases where the target type isn't known, such as .raw() SQL queries.\nAs a consequence it may not work perfectly in all circumstances.", "start_line": 550, "end_line": 567, "is_async": false, "is_method": false}, {"name": "adapt_integerfield_value", "qualified_name": "adapt_integerfield_value", "args": ["self", "value", "internal_type"], "decorators": [], "docstring": "", "start_line": 569, "end_line": 570, "is_async": false, "is_method": false}, {"name": "adapt_datefield_value", "qualified_name": "adapt_datefield_value", "args": ["