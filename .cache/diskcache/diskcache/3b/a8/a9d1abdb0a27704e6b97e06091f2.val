_async": false, "is_method": false}, {"name": "test_defaults_sameorigin", "qualified_name": "test_defaults_sameorigin", "args": ["self"], "decorators": [], "docstring": "If the X_FRAME_OPTIONS setting is not set then it defaults to\nDENY.", "start_line": 808, "end_line": 816, "is_async": false, "is_method": false}, {"name": "test_dont_set_if_set", "qualified_name": "test_dont_set_if_set", "args": ["self"], "decorators": [], "docstring": "If the X-Frame-Options header is already set then the middleware does\nnot attempt to override it.", "start_line": 818, "end_line": 840, "is_async": false, "is_method": false}, {"name": "test_response_exempt", "qualified_name": "test_response_exempt", "args": ["self"], "decorators": [], "docstring": "If the response has an xframe_options_exempt attribute set to False\nthen it still sets the header, but if it's set to True then it doesn't.", "start_line": 842, "end_line": 863, "is_async": false, "is_method": false}, {"name": "test_is_extendable", "qualified_name": "test_is_extendable", "args": ["self"], "decorators": [], "docstring": "The XFrameOptionsMiddleware method that determines the X-Frame-Options\nheader value can be overridden based on something in the request or\nresponse.", "start_line": 865, "end_line": 897, "is_async": false, "is_method": false}, {"name": "setUp", "qualified_name": "setUp", "args": ["self"], "decorators": [], "docstring": "", "start_line": 914, "end_line": 923, "is_async": false, "is_method": false}, {"name": "get_response", "qualified_name": "get_response", "args": ["self", "request"], "decorators": [], "docstring": "", "start_line": 925, "end_line": 926, "is_async": false, "is_method": false}, {"name": "decompress", "qualified_name": "decompress", "args": ["gzipped_string"], "decorators": ["staticmethod"], "docstring": "", "start_line": 929, "end_line": 931, "is_async": false, "is_method": false}, {"name": "get_mtime", "qualified_name": "get_mtime", "args": ["gzipped_string"], "decorators": ["staticmethod"], "docstring": "", "start_line": 934, "end_line": 937, "is_async": false, "is_method": false}, {"name": "test_compress_response", "qualified_name": "test_compress_response", "args": ["self"], "decorators": [], "docstring": "Compression is performed on responses with compressible content.", "start_line": 939, "end_line": 946, "is_async": false, "is_method": false}, {"name": "test_compress_streaming_response", "qualified_name": "test_compress_streaming_response", "args": ["self"], "decorators": [], "docstring": "Compression is performed on responses with streaming content.", "start_line": 948, "end_line": 961, "is_async": false, "is_method": false}, {"name": "test_compress_async_streaming_response", "qualified_name": "test_compress_async_streaming_response", "args": ["self"], "decorators": [], "docstring": "Compression is performed on responses with async streaming content.", "start_line": 963, "end_line": 983, "is_async": true, "is_method": false}, {"name": "test_compress_streaming_response_unicode", "qualified_name": "test_compress_streaming_response_unicode", "args": ["self"], "decorators": [], "docstring": "Compression is performed on responses with streaming Unicode content.", "start_line": 985, "end_line": 1001, "is_async": false, "is_method": false}, {"name": "test_compress_file_response", "qualified_name": "test_compress_file_response", "args": ["self"], "decorators": [], "docstring": "Compression is performed on FileResponse.", "start_line": 1003, "end_line": 1018, "is_async": false, "is_method": false}, {"name": "test_compress_non_200_response", "qualified_name": "test_compress_non_200_response", "args": ["self"], "decorators": [], "docstring": "Compression is performed on responses with a status other than 200\n(#10762).", "start_line": 1020, "end_line": 1028, "is_async": false, "is_method": false}, {"name": "test_no_compress_short_response", "qualified_name": "test_no_compress_short_response", "args": ["self"], "decorators": [], "docstring": "Compression isn't performed on responses with short content.", "start_line": 1030, "end_line": 1037, "is_async": false, "is_method": false}, {"name": "test_no_compress_compressed_response", "qualified_name": "test_no_compress_compressed_response", "args": ["self"], "decorators": [], "docstring": "Compression isn't performed on responses that are already compressed.", "start_line": 1039, "end_line": 1046, "is_async": false, "is_method": false}, {"name": "test_no_compress_incompressible_response", "qualified_name": "test_no_compress_incompressible_response", "args": ["self"], "decorators": [], "docstring": "Compression isn't performed on responses with incompressible content.", "start_line": 1048, "end_line": 1055, "is_async": false, "is_method": false}, {"name": "test_compress_deterministic", "qualified_name": "test_compress_deterministic", "args": ["self"], "decorators": [], "docstring": "Compression results are the same for the same content and don't\ninclude a modification time (since that would make the results\nof compression non-deterministic and prevent\nConditionalGetMiddleware from recognizing conditional matches\non gzipped content).", "start_line": 1057, "end_line": 1073, "is_async": false, "is_method": false}, {"name": "test_random_bytes", "qualified_name": "test_random_bytes", "args": ["self"], "decorators": [], "docstring": "A random number of bytes is added to mitigate the BREACH attack.", "start_line": 1075, "end_line": 1085, "is_async": false, "is_method": false}, {"name": "test_random_bytes_streaming_response", "qualified_name": "test_random_bytes_streaming_response", "args": ["self"], "decorators": [], "docstring": "A random number of bytes is added to mitigate the BREACH attack.", "start_line": 1087, "end_line": 1104, "is_async": false, "is_method": false}, {"name": "test_strong_etag_modified", "qualified_name": "test_strong_etag_modified", "args": ["self"], "decorators": [], "docstring": "GZipMiddleware makes a strong ETag weak.", "start_line": 1115, "en