ments", "qualified_name": "add_arguments", "args": ["self", "parser"], "decorators": [], "docstring": "", "start_line": 639, "end_line": 645, "is_async": false, "is_method": false}, {"name": "handle", "qualified_name": "handle", "args": ["self"], "decorators": [], "docstring": "", "start_line": 647, "end_line": 661, "is_async": false, "is_method": false}, {"name": "handle_app_config", "qualified_name": "handle_app_config", "args": ["self", "app_config"], "decorators": [], "docstring": "Perform the command's actions for app_config, an AppConfig instance\ncorresponding to an application label given on the command line.", "start_line": 663, "end_line": 670, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 689, "end_line": 693, "is_async": false, "is_method": false}, {"name": "add_arguments", "qualified_name": "add_arguments", "args": ["self", "parser"], "decorators": [], "docstring": "", "start_line": 695, "end_line": 696, "is_async": false, "is_method": false}, {"name": "handle", "qualified_name": "handle", "args": ["self"], "decorators": [], "docstring": "", "start_line": 698, "end_line": 704, "is_async": false, "is_method": false}, {"name": "handle_label", "qualified_name": "handle_label", "args": ["self", "label"], "decorators": [], "docstring": "Perform the command's actions for ``label``, which will be the\nstring as given on the command line.", "start_line": 706, "end_line": 713, "is_async": false, "is_method": false}], "classes": [{"name": "CommandError", "bases": ["Exception"], "methods": ["__init__"], "docstring": "Exception class indicating a problem while executing a management\ncommand.\n\nIf this exception is raised during the execution of a management\ncommand, it will be caught and turned into a nicely-printed error\nmessage to the appropriate output stream (i.e., stderr); as a\nresult, raising this exception ", "start_line": 23, "end_line": 38}, {"name": "SystemCheckError", "bases": ["CommandError"], "methods": [], "docstring": "The system check framework detected unrecoverable errors.", "start_line": 41, "end_line": 46}, {"name": "CommandParser", "bases": ["ArgumentParser"], "methods": ["__init__", "parse_args", "error", "add_subparsers"], "docstring": "Customized ArgumentParser class to improve some error messages and prevent\nSystemExit in several occasions, as SystemExit is unacceptable when a\ncommand is called programmatically.", "start_line": 49, "end_line": 89}, {"name": "DjangoHelpFormatter", "bases": ["HelpFormatter"], "methods": ["_reordered_actions", "add_usage", "add_arguments"], "docstring": "Customized formatter so that command-specific arguments appear in the\n--help output before arguments common to all commands.", "start_line": 122, "end_line": 148}, {"name": "OutputWrapper", "bases": [], "methods": ["style_func", "style_func", "__init__", "__getattr__", "flush", "isatty", "write"], "docstring": "Wrapper around stdout/stderr", "start_line": 151, "end_line": 187}, {"name": "BaseCommand", "bases": [], "methods": ["__init__", "get_version", "create_parser", "add_arguments", "add_base_argument", "print_help", "run_from_argv", "execute", "get_check_kwargs", "check", "check_migrations", "handle"], "docstring": "The base class from which all management commands ultimately\nderive.\n\nUse this class if you want access to all of the mechanisms which\nparse the command-line arguments and work out what code to call in\nresponse; if you don't need to change any of that behavior,\nconsider using one of the subclasses d", "start_line": 193, "end_line": 625}, {"name": "AppCommand", "bases": ["BaseCommand"], "methods": ["add_arguments", "handle", "handle_app_config"], "docstring": "A management command which takes one or more installed application labels\nas arguments, and does something with each of them.\n\nRather than implementing ``handle()``, subclasses must implement\n``handle_app_config()``, which