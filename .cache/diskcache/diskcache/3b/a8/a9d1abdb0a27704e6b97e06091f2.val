n_fallback_language_plural", "qualified_name": "test_i18n_fallback_language_plural", "args": ["self"], "decorators": [], "docstring": "The fallback to a language with less plural forms maintains the real\nlanguage's number of plural forms and correct translations.", "start_line": 372, "end_line": 396, "is_async": false, "is_method": false}, {"name": "test_i18n_english_variant", "qualified_name": "test_i18n_english_variant", "args": ["self"], "decorators": [], "docstring": "", "start_line": 398, "end_line": 404, "is_async": false, "is_method": false}, {"name": "test_i18n_language_non_english_default", "qualified_name": "test_i18n_language_non_english_default", "args": ["self"], "decorators": [], "docstring": "Check if the JavaScript i18n view returns an empty language catalog\nif the default language is non-English, the selected language\nis English and there is not 'en' translation available. See #13388,\n#3594 and #13726 for more details.", "start_line": 406, "end_line": 415, "is_async": false, "is_method": false}, {"name": "test_non_english_default_english_userpref", "qualified_name": "test_non_english_default_english_userpref", "args": ["self"], "decorators": ["modify_settings(INSTALLED_APPS={'append': 'view_tests.app0'})"], "docstring": "Same as above with the difference that there IS an 'en' translation\navailable. The JavaScript i18n view must return a NON empty language\ncatalog with the proper English translations. See #13726 for more\ndetails.", "start_line": 418, "end_line": 427, "is_async": false, "is_method": false}, {"name": "test_i18n_language_non_english_fallback", "qualified_name": "test_i18n_language_non_english_fallback", "args": ["self"], "decorators": [], "docstring": "Makes sure that the fallback language is still working properly\nin cases where the selected language cannot be found.", "start_line": 429, "end_line": 436, "is_async": false, "is_method": false}, {"name": "test_escaping", "qualified_name": "test_escaping", "args": ["self"], "decor