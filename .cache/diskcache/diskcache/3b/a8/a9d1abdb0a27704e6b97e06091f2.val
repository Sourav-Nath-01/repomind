": false, "is_method": false}, {"name": "test_form_kwargs_formset_dynamic", "qualified_name": "test_form_kwargs_formset_dynamic", "args": ["self"], "decorators": [], "docstring": "Form kwargs can be passed dynamically in a formset.", "start_line": 169, "end_line": 182, "is_async": false, "is_method": false}, {"name": "test_form_kwargs_empty_form", "qualified_name": "test_form_kwargs_empty_form", "args": ["self"], "decorators": [], "docstring": "", "start_line": 184, "end_line": 188, "is_async": false, "is_method": false}, {"name": "test_empty_permitted_ignored_empty_form", "qualified_name": "test_empty_permitted_ignored_empty_form", "args": ["self"], "decorators": [], "docstring": "", "start_line": 190, "end_line": 192, "is_async": false, "is_method": false}, {"name": "test_formset_validation", "qualified_name": "test_formset_validation", "args": ["self"], "decorators": [], "docstring": "", "start_line": 194, "end_line": 199, "is_async": false, "is_method": false}, {"name": "test_formset_validation_count", "qualified_name": "test_formset_validation_count", "args": ["self"], "decorators": [], "docstring": "A formset's ManagementForm is validated once per FormSet.is_valid()\ncall and each form of the formset is cleaned once.", "start_line": 201, "end_line": 234, "is_async": false, "is_method": false}, {"name": "test_formset_has_changed", "qualified_name": "test_formset_has_changed", "args": ["self"], "decorators": [], "docstring": "FormSet.has_changed() is True if any data is passed to its forms, even\nif the formset didn't validate.", "start_line": 236, "end_line": 250, "is_async": false, "is_method": false}, {"name": "test_formset_initial_data", "qualified_name": "test_formset_initial_data", "args": ["self"], "decorators": [], "docstring": "A FormSet can be prefilled with existing data by providing a list of\ndicts to the `initial` argument. By default, an extra blank form is\nincluded.", "start_line": 252, "end_line": 268, "is_async": false, "is_method": false}, {"name": "test_blank_form_unfilled", "qualified_name": "test_blank_form_unfilled", "args": ["self"], "decorators": [], "docstring": "A form that's displayed as blank may be submitted as blank.", "start_line": 270, "end_line": 279, "is_async": false, "is_method": false}, {"name": "test_second_form_partially_filled", "qualified_name": "test_second_form_partially_filled", "args": ["self"], "decorators": [], "docstring": "If at least one field is filled out on a blank form, it will be\nvalidated.", "start_line": 281, "end_line": 290, "is_async": false, "is_method": false}, {"name": "test_delete_prefilled_data", "qualified_name": "test_delete_prefilled_data", "args": ["self"], "decorators": [], "docstring": "Deleting prefilled data is an error. Removing data from form fields\nisn't the proper way to delete it.", "start_line": 292, "end_line": 308, "is_async": false, "is_method": false}, {"name": "test_displaying_more_than_one_blank_form", "qualified_name": "test_displaying_more_than_one_blank_form", "args": ["self"], "decorators": [], "docstring": "More than 1 empty form can be displayed using formset_factory's\n`extra` argument.", "start_line": 310, "end_line": 343, "is_async": false, "is_method": false}, {"name": "test_min_num_displaying_more_than_one_blank_form", "qualified_name": "test_min_num_displaying_more_than_one_blank_form", "args": ["self"], "decorators": [], "docstring": "More than 1 empty form can also be displayed using formset_factory's\nmin_num argument. It will (essentially) increment the extra argument.", "start_line": 345, "end_line": 361, "is_async": false, "is_method": false}, {"name": "test_min_num_displaying_more_than_one_blank_form_with_zero_extra", "qualified_name": "test_min_num_displaying_more_than_one_blank_form_with_zero_extra", "args": ["self"], "decorators": [], "docstring": "More than 1 empty form can be displayed using min_num.", "start_line": 363, "end_line": 375, "is_async": false, "is_method": false}, {"name": "test_single_form_completed", "qualified_name": "test_single_form_completed", "args": ["self"], "decorators": [], "docstring": "Just one form may be completed.", "start_line": 377, "end_line": 397, "is_async": false, "is_method": false}, {"name": "test_formset_validate_max_flag", "qualified_name": "test_formset_validate_max_flag", "args": ["self"], "decorators": [], "docstring": "If validate_max is set and max_num is less than TOTAL_FORMS in the\ndata, a ValidationError is raised. MAX_NUM_FORMS in the data is\nirrelevant here (it's output as a hint for the client but its value\nin the returned data is not checked).", "start_line": 399, "end_line": 423, "is_async": false, "is_method": false}, {"name": "test_formset_validate_max_flag_custom_error", "qualified_name": "test_formset_validate_max_flag_custom_error", "args": ["self"], "decorators": [], "docstring": "", "start_line": 425, "end_line": 454, "is_async": false, "is_method": false}, {"name": "test_formset_validate_min_flag", "qualified_name": "test_formset_validate_min_flag", "args": ["self"], "decorators": [], "docstring": "If validate_min is set and min_num is more than TOTAL_FORMS in the\ndata, a ValidationError is raised. MIN_NUM_FORMS in the data is\nirrelevant here (it's output as a hint for the client but its value\nin the returned data is not checked).", "start_line": 456, "end_line": 481, "is_async": false, "is_method": false}, {"name": "test_formset_validate_min_flag_custom_formatted_error", "qualified_name": "test_formset_validate_min_flag_custom_formatted_error", "args": ["self"], "decorators": [], "docstring": "", "start_line": 483, "end_line": 512, "is_async": false, "is_method": false}, {"name": "test_formset_validate_min_unchanged_forms", "qualified_name": "test_formset_validate_min_unchanged_forms", "args": ["self"], "decorators": [], "docstring": "min_num validation doesn't consider unchanged forms with initial data\nas \"empty\".", "start_line": 514, "end_line": 537, "is_async": false, "is_method": false}, {"name": "test_formset_validate_min_excludes_empty_forms", "qualified_name": "test_formset_validate_min_excludes_empty_forms", "args": ["self"], "decorators": [], "docstring": "", "start_line": 539, "end_line": 550, "is_async": false, "is_method": false}, {"name": "test_second_form_partially_filled_2", "qualified_name": "test_second_form_partially_filled_2", "args": ["self"], "decorators": [], "docstring": "A partially completed form is invalid.", "start_line": 552, "end_line": 571, "is_async": false, "is_method": false}, {"name": "test_more_initial_data", "qualified_name": "test_more_initial_data", "args": ["self"], "decorators": [], "docstring": "The extra argument works when the formset is pre-filled with initial\ndata.", "start_line": 573, "end_line": 599, "is_async": false, "is_method": false}, {"name": "test_formset_with_deletion", "qualified_name": "test_formset_with_deletion", "args": ["self"], "decorators": [], "docstring": "formset_factory's can_delete argument adds a boolean \"delete\" field to\neach form. When that boolean field is True, the form will be in\nformset.deleted_forms.", "start_line": 601, "end_line": 657, "is_async": false, "is_method": false}, {"name": "test_formset_with_deletion_remove_deletion_flag", "qualified_name": "test_formset_with_deletion_remove_deletion_flag", "args": ["self"], "decorators": [], "docstring": "If a form is filled with something and can_delete is also checked, that\nform's errors shouldn't make the entire formset invalid since it's\ngoing to be deleted.", "start_line": 659, "end_line": 687, "is_async": false, "is_method": false}, {"name": "test_formset_with_deletion_invalid_deleted_form", "qualified_name": "test_formset_with_deletion_invalid_deleted_form", "args": ["self"], "decorators": [], "docstring": "deleted_forms works on a valid formset even if a deleted form would\nhave been invalid.", "start_line": 689, "end_line": 707, "is_async": false, "is_method": false}, {"name": "test_formset_with_deletion_custom_widget", "qualifi