>> print(srs.proj)\n+proj=longlat +ellps=WGS84 +datum=WGS84 +no_defs\n>>> print(srs.ellipsoid)\n(6378137.0, 6356752.3142451793, 298.25722356300003)\n>>> print(srs.projected, srs.geographic)\nFalse True\n>>> srs.import_epsg(32140)\n>>> print(srs.name)\nNAD83 / Texas South Central", "parse_error": ""}, {"file_path": "django/contrib/gis/gdal/geometries.py", "file_hash": "12d16673c09d40e6fe1c9f070952288e3460d87dd2c1d56cc79f6fc14581d834", "imports": [{"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "binascii", "names": ["b2a_hex"], "is_from": true, "alias": ""}, {"module": "ctypes", "names": ["byref", "c_char_p", "c_double", "c_ubyte", "c_void_p", "string_at"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.base", "names": ["GDALBase"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.envelope", "names": ["Envelope", "OGREnvelope"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.error", "names": ["GDALException", "SRSException"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.geomtype", "names": ["OGRGeomType"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.prototypes", "names": ["geom"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.prototypes", "names": ["srs"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.srs", "names": ["CoordTransform", "SpatialReference"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.geometry", "names": ["hex_regex", "json_regex", "wkt_regex"], "is_from": true, "alias": ""}, {"module": "django.utils.encoding", "names": ["force_bytes"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.geos", "names": ["GEOSGeometry"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis", "names": ["geos"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.geos", "names": ["GEOSGeometry"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.g