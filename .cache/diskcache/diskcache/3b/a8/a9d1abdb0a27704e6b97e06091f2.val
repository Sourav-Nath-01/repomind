e the messages and return any unstored messages after trying all\nbackends.\n\nFor each storage backend, any messages not stored are passed on to the\nnext backend.", "start_line": 40, "end_line": 56, "is_async": false, "is_method": false}], "classes": [{"name": "FallbackStorage", "bases": ["BaseStorage"], "methods": ["__init__", "_get", "_store"], "docstring": "Try to store all messages in the first backend. Store any unstored\nmessages in each subsequent backend.", "start_line": 6, "end_line": 56}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/contrib/messages/storage/cookie.py", "file_hash": "ecd85fc9f7df46a7850f0c1f51cae62693a2f60853b8c60ca5268a5b518e38e5", "imports": [{"module": "binascii", "names": [], "is_from": false, "alias": ""}, {"module": "json", "names": [], "is_from": false, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.contrib.messages.storage.base", "names": ["BaseStorage", "Message"], "is_from": true, "alias": ""}, {"module": "django.core", "names": ["signing"], "is_from": true, "alias": ""}, {"module": "django.http", "names": ["SimpleCookie"], "is_from": true, "alias": ""}, {"module": "django.utils.safestring", "names": ["SafeData", "mark_safe"], "is_from": true, "alias": ""}], "functions": [{"name": "bisect_keep_left", "qualified_name": "bisect_keep_left", "args": ["a", "fn"], "decorators": [], "docstring": "Find the index of the first element from the start of the array that\nverifies the given condition.\nThe function is applied from the start of the array to the pivot.", "start_line": 217, "end_line": 231, "is_async": false, "is_method": false}, {"name": "bisect_keep_right", "qualified_name": "bisect_keep_right", "args": ["a", "fn"], "decorators": [], "docstring": "Find the index of the first element from the end of the array that verifies\nthe given condition.\nThe function is applied from the pivot to the end of array.", "start_line": 234, "end_line": 248, "is_async": false, "is_method": false}, {"name": "default", "qualified_name": "default", "args": ["self", "obj"], "decorators": [], "docstring": "", "start_line": 18, "end_line": 26, "is_async": false, "is_method": false}, {"name": "process_messages", "qualified_name": "process_messages", "args": ["self", "obj"], "decorators": [], "docstring": "", "start_line": 34, "end_line": 43, "is_async": false, "is_method": false}, {"name": "decode", "qualified_name": "decode", "args": ["self", "s"], "decorators": [], "docstring": "", "start_line": 45, "end_line": 47, "is_async": false, "is_method": false}, {"name": "dumps", "qualified_name": "dumps", "args": ["self", "obj"], "decorators": [], "docstring": "", "start_line": 51, "end_line": 59, "is_async": false, "is_method": false}, {"name": "dumps", "qualified_name": "dumps", "args": ["self", "obj"], "decorators": [], "docstring": "The parameter is an already serialized list of Message objects. No need\nto serialize it again, only join the list together and encode it.", "start_line": 63, "end_line": 68, "is_async": false, "is_method": false}, {"name": "loads", "qualified_name": "loads", "args": ["self", "data"], "decorators": [], "docstring": "", "start_line": 72, "end_line": 73, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 90, "end_line": 92, "is_async": false, "is_method": false}, {"name": "_get", "qualified_name": "_get", "args": ["self"], "decorators": [], "docstring": "Retrieve a list of messages from the messages cookie. If the\nnot_finished sentinel value is found at the end of the message list,\nremove it and return a result indicating that not all messages were\nretrieved by this storage.", "start_line": 94, "end_line": 107, "is_async": false, "is_method": false}, {"name": "_update_cookie", "qualified_name": "_update_cookie", "args": ["self", "encoded_data", "response"], "decorators": [], "docstring": "Either set the cookie with the encoded data if there is any data to\nstore, or delete the cookie.", "start_line": 109, "end_line": 128, "is_async": false, "is_method": false}, {"name": "_store", "qualified_name": "_store", "args": ["self", "messages", "response", "remove_oldest"], "decorators": [], "docstring": "Store the messages to a cookie and return a list of any messages which\ncould not be stored.\n\nIf the encoded data is larger than ``max_cookie_size``, remove\nmessages until the data fits (these are the messages which are\nreturned), and add the not_finished sentinel value to indicate as much.", "start_line": 130, "end_line": 173, "is_async": false, "is_method": false}, {"name": "_encode_parts", "qualified_name": "_encode_parts", "args": ["self", "messages", "encode_empty"], "decorators": [], "docstring": "Return an encoded version of the serialized messages list which can be\nstored as plain text.\n\nSince the data will be retrieved from the client-side, the encoded data\nalso contains a hash to ensure that the data was not tampered with.", "start_line": 175, "end_line": 186, "is_async": false, "is_method": false}, {"name": "_encode", "qualified_name": "_encode", "args": ["self", "messages", "encode_empty"], "decorators": [], "docstring": "Return an encoded version of the messages list which can be stored as\nplain text.\n\nProxies MessagePartSerializer.dumps and _encoded_parts.", "start_line": 188, "end_line": 196, "is_async": false, "is_method": false}, {"name": "_decode", "qualified_name": "_decode", "args": ["self", "data"], "decorators": [], "docstring": "Safely decode an encoded text stream back into a list of messages.\n\nIf the encoded text stream contained an invalid hash or was in an\ninvalid format, return None.", "start_line": 198, "end_line": 214, "is_async": false, "is_method": false}, {"name": "is_too_large_for_cookie", "qualified_name": "is_too_large_for_cookie", "args": ["data"], "decorators": [], "docstring": "", "start_line": 1