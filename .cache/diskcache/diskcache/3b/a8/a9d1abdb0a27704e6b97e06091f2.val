mple of a symmetrical\n``ManyToManyField``.\n\nA ``Person`` can also have many idols - but while I may idolize you, you may\nnot think the same of me. Here, ``idols`` is an example of a non-symmetrical\n``ManyToManyField``. Only recursive ``ManyToManyField`` fields may be\nnon-symmetrical, and they are symmetrical by default.\n\nThis test validates that the many-to-many table is created using a mangled name\nif there is a name clash, and tests that symmetry is preserved where\nappropriate.", "parse_error": ""}, {"file_path": "tests/servers/tests.py", "file_hash": "6eda77c2365260457cd4f40570e6bc2eb1cb8a5f9fcb6248cebca50d79e20311", "imports": [{"module": "errno", "names": [], "is_from": false, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "socket", "names": [], "is_from": false, "alias": ""}, {"module": "threading", "names": [], "is_from": false, "alias": ""}, {"module": "unittest", "names": [], "is_from": false, "alias": ""}, {"module": "http.client", "names": ["HTTPConnection"], "is_from": true, "alias": ""}, {"module": "urllib.error", "names": ["HTTPError"], "is_from": true, "alias": ""}, {"module": "urllib.parse", "names": ["urlencode"], "is_from": true, "alias": ""}, {"module": "urllib.request", "names": ["urlopen"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.core.servers.basehttp", "names": ["ThreadedWSGIServer", "WSGIServer"], "is_from": true, "alias": ""}, {"module": "django.db", "names": ["DEFAULT_DB_ALIAS", "connection", "connections"], "is_from": true, "alias": ""}, {"module": "django.test", "names": ["LiveServerTestCase", "override_settings"], "is_from": true, "alias": ""}, {"module": "django.test.testcases", "names": ["LiveServerThread", "QuietWSGIRequestHandler"], "is_from": true, "alias": ""}, {"module": "models", "names": ["Person"], "is_from": true, "alias": ""}], "functions": [{"name": "urlopen", "qualified_name": "urlopen", "args": ["self", "url"], "decorators": [], "docstring": "", "start_line": 42, "end_line": 43, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 47, "end_line": 51, "is_async": false, "is_method": false}, {"name": "_close_connections", "qualified_name": "_close_connections", "args": ["self"], "decorators": [], "docstring": "", "start_line": 53, "end_line": 55, "is_async": false, "is_method": false}, {"name": "_create_server", "qualified_name": "_create_server", "args": ["self", "connections_override"], "decorators": [], "docstring": "", "start_line": 61, "end_line": 62, "is_async": false, "is_method": false}, {"name": "_make_connections_override", "qualified_name": "_make_connections_override", "args": ["cls"], "decorators": ["classmethod"], "docstring": "", "start_line": 69, "end_line": 80, "is_async": false, "is_method": false}, {"name": "tearDownConnectionTest", "qualified_name": "tearDownConnectionTest", "args": ["cls"], "decorators": ["classmethod"], "docstring": "", "start_line": 83, "end_line": 84, "is_async": false, "is_method": false}, {"name": "tearDownClass", "qualified_name": "tearDownClass", "args": ["cls"], "decorators": ["classmethod"], "docstring": "", "start_line": 87, "end_line": 89, "is_async": false, "is_method": false}, {"name": "test_closes_connections", "qualified_name": "test_closes_connections", "args": ["self"], "decorators": [], "docstring": "", "start_line": 91, "end_line": 106, "is_async": false, "is_method": false}, {"name": "test_in_memory_database_lock", "qualified_name": "test_in_memory_database_lock", "args": ["self"], "decorators": [], "docstring": "With a threaded LiveServer and an in-memory database, an error can\noccur when 2 requests reach the server and try to lock the database\nat the same time, if the requests do not share the same database\nconnection.", "start_line": 112, "end_line": 132, "is_async": false, "is_metho