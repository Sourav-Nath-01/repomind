t_line": 142, "end_line": 145, "is_async": false, "is_method": false}, {"name": "get_hasher", "qualified_name": "get_hasher", "args": ["algorithm"], "decorators": [], "docstring": "Return an instance of a loaded password hasher.\n\nIf algorithm is 'default', return the default hasher. Lazily import hashers\nspecified in the project's settings file if needed.", "start_line": 148, "end_line": 170, "is_async": false, "is_method": false}, {"name": "identify_hasher", "qualified_name": "identify_hasher", "args": ["encoded"], "decorators": [], "docstring": "Return an instance of a loaded password hasher.\n\nIdentify hasher algorithm by examining encoded hash, and call\nget_hasher() to return hasher. Raise ValueError if\nalgorithm cannot be identified, or if hasher is not loaded.", "start_line": 173, "end_line": 192, "is_async": false, "is_method": false}, {"name": "mask_hash", "qualified_name": "mask_hash", "args": ["hash", "show", "char"], "decorators": [], "docstring": "Return the given hash, with only the first ``show`` number shown. The\nrest are masked with ``char`` for security reasons.", "start_line": 195, "end_line": 202, "is_async": false, "is_method": false}, {"name": "must_update_salt", "qualified_name": "must_update_salt", "args": ["salt", "expected_entropy"], "decorators": [], "docstring": "", "start_line": 205, "end_line": 207, "is_async": false, "is_method": false}, {"name": "_load_library", "qualified_name": "_load_library", "args": ["self"], "decorators": [], "docstring": "", "start_line": 224, "end_line": 240, "is_async": false, "is_method": false}, {"name": "salt", "qualified_name": "salt", "args": ["self"], "decorators": [], "docstring": "Generate a cryptographically secure nonce salt in ASCII with an entropy\nof at least `salt_entropy` bits.", "start_line": 242, "end_line": 250, "is_async": false, "is_method": false}, {"name": "verify", "qualified_name": "verify", "args": ["self", "password", "encoded"], "decorators": [], "docstring": "Check if the giv