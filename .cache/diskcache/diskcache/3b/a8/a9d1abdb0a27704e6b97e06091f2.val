_method": false}, {"name": "_add_items", "qualified_name": "_add_items", "args": ["self", "source_field_name", "target_field_name"], "decorators": [], "docstring": "", "start_line": 1580, "end_line": 1657, "is_async": false, "is_method": false}, {"name": "_remove_items", "qualified_name": "_remove_items", "args": ["self", "source_field_name", "target_field_name"], "decorators": [], "docstring": "", "start_line": 1659, "end_line": 1710, "is_async": false, "is_method": false}, {"name": "check_and_update_obj", "qualified_name": "check_and_update_obj", "args": ["obj"], "decorators": [], "docstring": "", "start_line": 850, "end_line": 859, "is_async": false, "is_method": false}, {"name": "remove", "qualified_name": "remove", "args": ["self"], "decorators": [], "docstring": "", "start_line": 933, "end_line": 955, "is_async": false, "is_method": false}, {"name": "aremove", "qualified_name": "aremove", "args": ["self"], "decorators": [], "docstring": "", "start_line": 959, "end_line": 960, "is_async": true, "is_method": false}, {"name": "clear", "qualified_name": "clear", "args": ["self"], "decorators": [], "docstring": "", "start_line": 964, "end_line": 966, "is_async": false, "is_method": false}, {"name": "aclear", "qualified_name": "aclear", "args": ["self"], "decorators": [], "docstring": "", "start_line": 970, "end_line": 971, "is_async": true, "is_method": false}, {"name": "_clear", "qualified_name": "_clear", "args": ["self", "queryset", "bulk"], "decorators": [], "docstring": "", "start_line": 975, "end_line": 986, "is_async": false, "is_method": false}], "classes": [{"name": "ForeignKeyDeferredAttribute", "bases": ["DeferredAttribute"], "methods": ["__set__"], "docstring": "", "start_line": 87, "end_line": 93}, {"name": "ForwardManyToOneDescriptor", "bases": [], "methods": ["__init__", "RelatedObjectDoesNotExist", "is_cached", "get_queryset", "get_prefetch_querysets", "get_object", "__get__", "fetch_one", "fetch_many", "__set__", "__reduce__"], "docstring": "Accessor to the related object on the forward side of a many-to-one or\none-to-one (via ForwardOneToOneDescriptor subclass) relation.\n\nIn the example::\n\n    class Child(Model):\n        parent = ForeignKey(Parent, related_name='children')\n\n``Child.parent`` is a ``ForwardManyToOneDescriptor`` instance.", "start_line": 132, "end_line": 375}, {"name": "ForwardOneToOneDescriptor", "bases": ["ForwardManyToOneDescriptor"], "methods": ["get_object", "__set__"], "docstring": "Accessor to the related object on the forward side of a one-to-one\nrelation.\n\nIn the example::\n\n    class Restaurant(Model):\n        place = OneToOneField(Place, related_name='restaurant')\n\n``Restaurant.place`` is a ``ForwardOneToOneDescriptor`` instance.", "start_line": 378, "end_line": 428}, {"name": "ReverseOneToOneDescriptor", "bases": [], "methods": ["__init__", "RelatedObjectDoesNotExist", "is_cached", "get_queryset", "get_prefetch_querysets", "__get__", "field", "fetch_one", "fetch_many", "__set__", "__reduce__"], "docstring": "Accessor to the related object on the reverse side of a one-to-one\nrelation.\n\nIn the example::\n\n    class Restaurant(Model):\n        place = OneToOneField(Place, related_name='restaurant')\n\n``Place.restaurant`` is a ``ReverseOneToOneDescriptor`` instance.", "start_line": 431, "end_line": 652}, {"name": "ReverseManyToOneDescriptor", "bases": [], "methods": ["__init__", "related_manager_cls", "__get__", "_get_set_deprecation_msg_params", "__set__"], "docstring": "Accessor to the related objects manager on the reverse side of a\nmany-to-one relation.\n\nIn the example::\n\n    class Child(Model):\n        parent = ForeignKey(Parent, related_name='children')\n\n``Parent.children`` is a ``ReverseManyToOneDescriptor`` instance.\n\nMost of the implementation is delegated t", "start_line": 655, "end_line": 709}, {"name": "ManyToManyDescriptor", "bases": ["ReverseManyToOneDescriptor"], "methods": ["__init__", "through", "related_manager_cls", "_get_set_deprecation_msg_params"], "docstring": "Accessor to the related objects manager on the forward and reverse sides of\na many-to-many relation.\n\nIn the example::\n\n    class Pizza(Model):\n        toppings = ManyToManyField(Topping, related_name='pizzas')\n\n``Pizza.toppings`` and ``Topping.pizzas`` are ``ManyToManyDescriptor``\ninstances.\n\nMost ", "start_line": 1026, "end_line": 1070}, {"name": "RelatedManager", "bases": ["superclass", "AltersData"], "methods": ["__init__", "__call__", "_check_fk_val", "_apply_rel_filters", "_remove_prefetched_objects", "get_queryset", "get_prefetch_querysets", "add", "aadd", "create", "acreate", "get_or_create", "aget_or_create", "update_or_create", "aupdate_or_create", "set", "aset"], "docstring": "", "start_line": 720, "end_line": 1021}, {"name": "ManyRelatedManager", "bases": ["superclass", "AltersData"], "methods": ["__init__", "__call__", "_build_remove_filters", "_apply_rel_filters", "get_prefetch_cache", "_remove_prefetched_objects", "get_queryset", "get_prefetch_querysets", "constrained_target", "exists", "count", "_add_base", "add", "aadd", "_remove_base", "remove", "aremove", "_clear_base", "clear", "aclear", "set_base", "set", "aset", "create", "acreate", "get_or_create", "aget_or_create", "update_or_create", "aupdate_or_create", "_get_target_ids", "_get_missing_target_ids", "_get_add_plan", "_add_items", "_remove_items"], "docstring": "", "start_line": 1081, "end_line": 1710}], "calls": [], "module_docstring": "Accessors for related objects.\n\nWhen a field defines a relation between two models, each model class provides\nan attribute to access related instances of the other model class (unless the\nreverse accessor has been disabled with related_name='+').\n\nAccessors are implemented as descriptors in order to customize access and\nassignment. This module defines the descriptor classes.\n\nForward accessors follow foreign keys. Reverse accessors trace them back. For\nexample, with the following models::\n\n    class Parent(Model):\n        pass\n\n    class Child(Model):\n        parent = ForeignKey(Parent, related_name='children')\n\n ``child.parent`` is a forward many-to-one relation. ``parent.children`` is a\nreverse many-to-one relation.\n\nThere are three types of relations (many-to-one, one-to-one, and many-to-many)\nand two directions (forward and reverse) for a total of six combinations.\n\n1. Related instance on the forward side of a many-to-one relation:\n   ``ForwardManyToOneDescriptor``.\n\n   Uniqueness of foreign key values is irrelevant to accessing the related\n   instance, making the many-to-one and one-to-one cases identical as far as\n   the descriptor is concerned. The constraint is checked upstream (unicity\n   validation in forms) or downstream (unique indexes in the database).\n\n2. Related instance on the forward side of a one-to-one\n   relation: ``ForwardOneToOneDescriptor``.\n\n   It avoids querying the database when accessing the parent link field in\n   a multi-table inheritance scenario.\n\n3. Related instance on the reverse side of a one-to-one relation:\n   ``ReverseOneToOneDescriptor``.\n\n   One-to-one relations are asymmetrical, despite the apparent symmetry of the\n   name, because they're implemented in the database with a foreign key from\n   one table to another. As a consequence ``ReverseOneToOneDescriptor`` is\n   slightly different from ``ForwardManyToOneDescriptor``.\n\n4. Related objects manager for related instances on the reverse side of a\n   many-to-one relation: ``ReverseManyToOneDescriptor``.\n\n   Unlike the previous two classes, this one provides access to a collection\n   of objects. It returns a manager rather than an instance.\n\n5. Related objects manager for related instances on the forward or reverse\n   sides of a many-to-many relation: ``ManyToManyDescriptor``.\n\n   Many-to-many relations are symmetrical. The syntax of Django models\n   requires declaring them on one side but that's an implementation detail.\n   They could be declared on the other side without any change in behavior.\n   Therefore the forward and reverse descriptors can be the same.\n\n   If you're looking for ``ForwardManyToManyDescriptor`` or\n   ``ReverseManyToManyDescriptor``, use ``ManyToManyDescriptor`` instead.", "parse_error": ""}, {"file_path": "django/db/models/fields/related.py", "file_hash": "ec8350235a0f3b3b17dcb6eb797fb1097c25a99ad5105d54174e68b94b24e1e3", "imports": [{"module": "functools", "names": [], "is_from": false, "alias": ""}, {"module": "inspect", "names": [], "is_from": false, "alias": ""}, {"module": "functools", "names": ["partial"], "is_from": true, "alias": ""}, {"module": "django", "names": ["forms"], "is_from": true, "alias": ""}, {"module": "django.apps", "names": ["apps"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["SettingsReference", "settings"], "is_from": true, "alias": ""}, {"module": "django.core", "names": ["checks", "exceptions"], "is_from": true, "alias": ""}, {"module": "django.db", "names": ["connection", "connections", "router"], "is_from": true, "alias": ""}, {"module": "django.db.backends", "names": ["utils"], "is_from": true, "alias": ""}, {"module": "django.db.models", "names": ["NOT_PROVIDED", "Q"], "is_from": true, "alias": ""}, {"module": "django.db.models.constants", "names": ["LOOKUP_SEP"], "is_from": true, "alias": ""}, {"module": "django.db.models.deletion", "names": ["CASCADE", "DB_CASCADE", "DB_SET_DEFAULT", "DB_SET_NULL", "DO_NOTHING", "SET_DEFAULT", "SET_NULL", "DatabaseOnDelete"], "is_from": true, "alias": ""}, {"module": "django.db.models.query_utils", "names": ["PathInfo"], "is_from": true, "alias": ""}, {"module": "django.db.models.utils", "names": ["make_model_tuple"], "is_from": true, "alias": ""}, {"module": "django.utils.functional", "names": ["cached_property"], "is_from": true, "alias": ""}, {"module": "django.utils.translation", "names": ["gettext_lazy"], "is_from": true, "alias": ""}, {"module": "", "names": ["Field"], "is_fro