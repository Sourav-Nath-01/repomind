: "test_row_number_no_ordering", "qualified_name": "test_row_number_no_ordering", "args": ["self"], "decorators": [], "docstring": "The row number window function computes the number based on the order\nin which the tuples were inserted.", "start_line": 236, "end_line": 264, "is_async": false, "is_method": false}, {"name": "test_avg_salary_department", "qualified_name": "test_avg_salary_department", "args": ["self"], "decorators": [], "docstring": "", "start_line": 266, "end_line": 296, "is_async": false, "is_method": false}, {"name": "test_lag", "qualified_name": "test_lag", "args": ["self"], "decorators": [], "docstring": "Compute the difference between an employee's salary and the next\nhighest salary in the employee's department. Return None if the\nemployee has the lowest salary.", "start_line": 298, "end_line": 328, "is_async": false, "is_method": false}, {"name": "test_lag_decimalfield", "qualified_name": "test_lag_decimalfield", "args": ["self"], "decorators": [], "docstring": "", "start_line": 330, "end_line": 355, "is_async": false, "is_method": false}, {"name": "test_order_by_decimalfield", "qualified_name": "test_order_by_decimalfield", "args": ["self"], "decorators": [], "docstring": "", "start_line": 357, "end_line": 378, "is_async": false, "is_method": false}, {"name": "test_first_value", "qualified_name": "test_first_value", "args": ["self"], "decorators": [], "docstring": "", "start_line": 380, "end_line": 411, "is_async": false, "is_method": false}, {"name": "test_last_value", "qualified_name": "test_last_value", "args": ["self"], "decorators": [], "docstring": "", "start_line": 413, "end_line": 517, "is_async": false, "is_method": false}, {"name": "test_function_list_of_values", "qualified_name": "test_function_list_of_values", "args": ["self"], "decorators": [], "docstring": "", "start_line": 519, "end_line": 548, "is_async": false, "is_method": false}, {"name": "test_min_department", "qualified_name": "test_min_department", "args": ["self"], "decorators": [], "docstring": "An alternative way to specify a query for FirstValue.", "start_line": 550, "end_line": 576, "is_async": false, "is_method": false}, {"name": "test_max_per_year", "qualified_name": "test_max_per_year", "args": ["self"], "decorators": [], "docstring": "Find the maximum salary awarded in the same year as the\nemployee was hired, regardless of the department.", "start_line": 578, "end_line": 613, "is_async": false, "is_method": false}, {"name": "test_cume_dist", "qualified_name": "test_cume_dist", "args": ["self"], "decorators": [], "docstring": "Compute the cumulative distribution for the employees based on the\nsalary in increasing order. Equal to rank/total number of rows (12).", "start_line": 615, "end_line": 649, "is_async": false, "is_method": false}, {"name": "test_nthvalue", "qualified_name": "test_nthvalue", "args": ["self"], "decorators": [], "docstring": "", "start_line": 651, "end_line": 682, "is_async": false, "is_method": false}, {"name": "test_lead", "qualified_name": "test_lead", "args": ["self"], "decorators": [], "docstring": "Determine what the next person hired in the same department makes.\nBecause the dataset is ambiguous, the name is also part of the\nordering clause. No default is provided, so None/NULL should be\nreturned.", "start_line": 684, "end_line": 721, "is_async": false, "is_method": false}, {"name": "test_lead_offset", "qualified_name": "test_lead_offset", "args": ["self"], "decorators": [], "docstring": "Determine what the person hired after someone makes. Due to\nambiguity, the name is also included in the ordering.", "start_line": 723, "end_line": 759, "is_async": false, "is_method": false}, {"name": "test_lead_default", "qualified_name": "test_lead_default", "args": ["self"], "decorators": ["skipUnlessDBFeature('supports_default_in_lead_lag')"], "docstring": "", "start_line": 762, "end_line": 772, "is_async": false, "is_method": false}, {"name": "test_ntile", "qualified_name": "test_ntile", "args": ["self"], "decorators": [], "docstring": "Compute the group for each of the employees across the entire company,\nbased on how high the salary is for them. There are twelve employees\nso it divides evenly into four groups.", "start_line": 774, "end_line": 803, "is_async": false, "is_method": false}, {"name": "test_percent_rank", "qualified_name": "test_percent_rank", "args": ["self"], "decorators": [], "docstring": "Calculate the percentage rank of the employees across the entire\ncompany based on salary and name (in case of ambiguity).", "start_line": 805, "end_line": 839, "is_async": false, "is_method": false}, {"name": "test_nth_returns_null", "qualified_name": "test_nth_returns_null", "args": ["self"], "decorators": [], "docstring": "Find the nth row of the data set. None is returned since there are\nfewer than 20 rows in the test data.", "start_line": 841, "end_line": 853, "is_async": false, "is_method": false}, {"name": "test_multiple_partitioning", "qualified_name": "test_multiple_partitioning", "args": ["self"], "decorators": [], "docstring": "Find the maximum salary for each department for people hired in the\nsame year.", "start_line": 855, "end_line": 891, "is_async": false, "is_method": false}, {"name": "test_multiple_ordering", "qualified_name": "test_multiple_ordering", "args": ["self"], "decorators": [], "docstring": "Accumulate the salaries over the departments based on hire_date.\nIf two people were hired on the same date in the same department, the\nordering clause will render a different result for those people.", "start_line": 893, "end_line": 929, "is_async": false, "is_method": false}, {"name": "test_empty_ordering", "qualified_name": "test_empty_ordering", "args": ["self"], "decorators": [], "docstring": "Explicit empty ordering makes little sense but it is something that\nwas historically allowed.", "start_line": 931, "end_line": 943, "is_async": false, "is_method": false}, {"name": "test_related_ordering_with_count", "qualified_name": "test_relat