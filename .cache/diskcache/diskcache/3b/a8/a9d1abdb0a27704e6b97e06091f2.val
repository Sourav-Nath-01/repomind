eq__", "__str__", "dimension", "coord_dim", "geom_count", "point_count", "num_points", "num_coords", "geom_type", "geom_name", "area", "envelope", "empty", "extent", "is_3d", "set_3d", "is_measured", "set_measured", "has_curve", "get_linear_geometry", "get_curve_geometry", "_get_srs", "_set_srs", "_get_srid", "_set_srid", "_geos_ptr", "geos", "gml", "hex", "json", "kml", "wkb_size", "wkb", "wkt", "ewkt", "clone", "close_rings", "transform", "_topology", "intersects", "equals", "disjoint", "touches", "crosses", "within", "contains", "overlaps", "_geomgen", "boundary", "convex_hull", "difference", "intersection", "sym_difference", "union", "centroid"], "docstring": "Encapsulate an OGR geometry.", "start_line": 65, "end_line": 589}, {"name": "Point", "bases": ["OGRGeometry"], "methods": ["_geos_ptr", "_create_empty", "x", "y", "z", "m", "tuple"], "docstring": "", "start_line": 593, "end_line": 636}, {"name": "LineString", "bases": ["OGRGeometry"], "methods": ["__getitem__", "__len__", "tuple", "_listarr", "x", "y", "z", "m"], "docstring": "", "start_line": 639, "end_line": 699}, {"name": "LinearRing", "bases": ["LineString"], "methods": [], "docstring": "", "start_line": 703, "end_line": 704}, {"name": "Polygon", "bases": ["OGRGeometry"], "methods": ["__len__", "__getitem__", "shell", "tuple", "point_count"], "docstring": "", "start_line": 707, "end_line": 742}, {"name": "CircularString", "bases": ["LineString"], "methods": [], "docstring": "", "start_line": 745, "end_line": 746}, {"name": "CurvePolygon", "bases": ["Polygon"], "methods": [], "docstring": "", "start_line": 749, "end_line": 750}, {"name": "CompoundCurve", "bases": ["OGRGeometry"], "methods": [], "docstring": "", "start_line": 753, "end_line": 754}, {"name": "GeometryCollection", "bases": ["OGRGeometry"], "methods": ["__getitem__", "__len__", "add", "point_count", "tuple"], "docstring": "The Geometry Collection class.", "start_line": 758, "end_line": 802}, {"name": "MultiPoint", "bases": ["GeometryCollection"], "methods": [], "docstring": "", "start_line": 806, "end_line": 807}, {"name": "MultiLineString", "bases": ["GeometryCollection"], "methods": [], "docstring": "", "start_line": 810, "end_line": 811}, {"name": "MultiPolygon", "bases": ["GeometryCollection"], "methods": [], "docstring": "", "start_line": 814, "end_line": 815}, {"name": "MultiSurface", "bases": ["GeometryCollection"], "methods": [], "docstring": "", "start_line": 818, "end_line": 819}, {"name": "MultiCurve", "bases": ["GeometryCollection"], "methods": [], "docstring": "", "start_line": 822, "end_line": 823}], "calls": [], "module_docstring": "The OGRGeometry is a wrapper for using the OGR Geometry class\n(see https://gdal.org/api/ogrgeometry_cpp.html#_CPPv411OGRGeometry).\nOGRGeometry may be instantiated when reading geometries from OGR Data Sources\n(e.g. SHP files), or when given OGC WKT (a string).\n\nWhile the 'full' API is not present yet, the API is \"pythonic\" unlike\nthe traditional and \"next-generation\" OGR Python bindings. One major\nadvantage OGR Geometries have over their GEOS counterparts is support\nfor spatial reference systems and their transformation.\n\nExample:\n >>> from django.contrib.gis.gdal import (\n ...     OGRGeometry, OGRGeomType, SpatialReference\n ... )\n >>> wkt1, wkt2 = 'POINT(-90 30)', 'POLYGON((0 0, 5 0, 5 5, 0 5)'\n >>> pnt = OGRGeometry(wkt1)\n >>> print(pnt)\n POINT (-90 30)\n >>> mpnt = OGRGeometry(OGRGeomType('MultiPoint'), SpatialReference('WGS84'))\n >>> mpnt.add(wkt1)\n >>> mpnt.add(wkt1)\n >>> print(mpnt)\n MULTIPOINT (-90 30,-90 30)\n >>> print(mpnt.srs.name)\n WGS 84\n >>> print(mpnt.srs.proj)\n +proj=longlat +ellps=WGS84 +datum=WGS84 +no_defs\n >>> mpnt.transform(SpatialReference('NAD27'))\n >>> print(mpnt.proj)\n +proj=longlat +ellps=clrk66 +datum=NAD27 +no_defs\n >>> print(mpnt)\n MULTIPOINT (-89.99993037860248 29.99979788655764,-89.99993037860248\n 29.99979788655764)\n\n The OGRGeomType class is to make it easy to specify an OGR geometry type:\n >>> from django.contrib.gis.gdal import OGRGeomType\n >>> gt1 = OGRGeomType(3) # Using an integer for the type\n >>> gt2 = OGRGeomType('Polygon') # Using a string\n >>> gt3 = OGRGeomType('POLYGON') # It's case-insensitive\n >>> # Equivalence works w/non-OGRGeomType objects:\n >>> print(gt1 == 3, gt1 == 'Polygon')\n True True", "parse_error": ""}, {"file_path": "django/contrib/gis/gdal/libgdal.py", "file_hash": "c35e1428ed12c11823df3b48394e35dbe21ce8a790dad8d51b50cc5893cc75ca", "imports": [{"module": "logging", "names": [], "is_from": false, "alias": ""}, {"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "ctypes", "names": ["CDLL", "CFUNCTYPE", "c_char_p", "c_int"], "is_from": true, "alias": ""}, {"module": "ctypes.util", "names": ["find_library"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.error", "names": ["GDALException"], "is_from": true, "alias": ""}, {"module": "django.core.exceptions", "names": ["ImproperlyConfigured"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "ctypes", "names": ["WinDLL"], "is_from": true, "alias": ""}], "functions": [{"name": "std_call", "qualified_name": "std_call", "args": ["func"], "decorators": [], "docstring": "Return the correct STDCALL function for certain OSR routines on Win32\nplatforms.", "start_line": 85, "end_line": 93, "is_async": false, "is_method": false}, {"name": "gdal_version", "qualified_name": "gdal_version", "args": [], "decorators": [], "docstring": "Return only the GDAL version number information.", "start_line": 104, "end_line": 106, "is_async": false, "is_method": false}, {"name": "gdal_full_version", "qualified_name": "gdal_full_version", "args": [], "decorators": [], "docstring": "Return the full GDAL version information.", "start_line": 109, "end_line": 111, "is_async": false, "is_method": false}, {"name": "gdal_version_info",