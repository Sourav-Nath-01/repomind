d_name": "validate_consistency", "args": ["self"], "decorators": [], "docstring": "Ensure there are no dummy nodes remaining in the graph.", "start_line": 198, "end_line": 200, "is_async": false, "is_method": false}, {"name": "forwards_plan", "qualified_name": "forwards_plan", "args": ["self", "target"], "decorators": [], "docstring": "Given a node, return a list of which previous nodes (dependencies) must\nbe applied, ending with the node itself. This is the list you would\nfollow if applying the migrations to a database.", "start_line": 202, "end_line": 210, "is_async": false, "is_method": false}, {"name": "backwards_plan", "qualified_name": "backwards_plan", "args": ["self", "target"], "decorators": [], "docstring": "Given a node, return a list of which dependent nodes (dependencies)\nmust be unapplied, ending with the node itself. This is the list you\nwould follow if removing the migrations from a database.", "start_line": 212, "end_line": 220, "is_async": false, "is_method": false}, {"name": "iterative_dfs", "qualified_name": "iterative_dfs", "args": ["self", "start", "forwards"], "decorators": [], "docstring": "Iterative depth-first search for finding dependencies.", "start_line": 222, "end_line": 240, "is_async": false, "is_method": false}, {"name": "root_nodes", "qualified_name": "root_nodes", "args": ["self", "app"], "decorators": [], "docstring": "Return all root nodes - that is, nodes with no dependencies inside\ntheir app. These are the starting point for an app.", "start_line": 242, "end_line": 253, "is_async": false, "is_method": false}, {"name": "leaf_nodes", "qualified_name": "leaf_nodes", "args": ["self", "app"], "decorators": [], "docstring": "Return all leaf nodes - that is, nodes with no dependents in their app.\nThese are the \"most current\" version of an app's schema.\nHaving more than one per app is technically an error, but one that\ngets handled further up, in the interactive command - it's usually the\nresult of a VCS merge and needs s", 