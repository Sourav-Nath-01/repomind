, "id_list"], "decorators": [], "docstring": "", "start_line": 1304, "end_line": 1308, "is_async": true, "is_method": false}, {"name": "delete", "qualified_name": "delete", "args": ["self"], "decorators": [], "docstring": "Delete the records in the current QuerySet.", "start_line": 1310, "end_line": 1338, "is_async": false, "is_method": false}, {"name": "adelete", "qualified_name": "adelete", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1343, "end_line": 1344, "is_async": true, "is_method": false}, {"name": "_raw_delete", "qualified_name": "_raw_delete", "args": ["self", "using"], "decorators": [], "docstring": "Delete objects found from the given queryset in single direct SQL\nquery. No signals are sent and there is no protection for cascades.", "start_line": 1349, "end_line": 1356, "is_async": false, "is_method": false}, {"name": "update", "qualified_name": "update", "args": ["self"], "decorators": [], "docstring": "Update all elements in the current QuerySet, setting all the given\nfields to the appropriate values.", "start_line": 1360, "end_line": 1400, "is_async": false, "is_method": false}, {"name": "aupdate", "qualified_name": "aupdate", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1404, "end_line": 1405, "is_async": true, "is_method": false}, {"name": "_update", "qualified_name": "_update", "args": ["self", "values", "returning_fields"], "decorators": [], "docstring": "A version of update() that accepts field objects instead of field\nnames. Used primarily for model saving and not intended for use by\ngeneral code (it requires too much poking around at model internals to\nbe useful at that level).", "start_line": 1409, "end_line": 1425, "is_async": false, "is_method": false}, {"name": "exists", "qualified_name": "exists", "args": ["self"], "decorators": [], "docstring": "Return True if the QuerySet would have any results, False otherwise.", "start_line": 1430, "end_line": 1436, "is_async": false, "is_method": false}, {"name": "aexists", "qualified_name": "aexists", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1438, "end_line": 1439, "is_async": true, "is_method": false}, {"name": "contains", "qualified_name": "contains", "args": ["self", "obj"], "decorators": [], "docstring": "Return True if the QuerySet contains the provided obj,\nFalse otherwise.", "start_line": 1441, "end_line": 1460, "is_async": false, "is_method": false}, {"name": "acontains", "qualified_name": "acontains", "args": ["self", "obj"], "decorators": [], "docstring": "", "start_line": 1462, "end_line": 1463, "is_async": true, "is_method": false}, {"name": "_prefetch_related_objects", "qualified_name": "_prefetch_related_objects", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1465, "end_line": 1468, "is_async": false, "is_method": false}, {"name": "explain", "qualified_name": "explain", "args": ["self"], "decorators": [], "docstring": "Runs an EXPLAIN on the SQL query this QuerySet would perform, and\nreturns the results.", "start_line": 1470, "end_line": 1475, "is_async": false, "is_method": false}, {"name": "aexplain", "qualified_name": "aexplain", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1477, "end_line": 1478, "is_async": true, "is_method": false}, {"name": "raw", "qualified_name": "raw", "args": ["self", "raw_query", "params", "translations", "using"], "decorators": [], "docstring": "", "start_line": 1484, "end_line": 1496, "is_async": false, "is_method": false}, {"name": "_values", "qualified_name": "_values", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1498, "end_line": 1509, "is_async": false, "is_method": false}, {"name": "values", "qualified_name": "values", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1511, "end_line": 1515, "is_async": false, "is_method": false}, {"name": "values_list", "qualified_name": "values_list", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1