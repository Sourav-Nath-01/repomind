__init__", "add", "remove", "discard", "__iter__", "__reversed__", "__contains__", "__bool__", "__len__", "__repr__"], "docstring": "A set which keeps the ordering of the inserted items.", "start_line": 5, "end_line": 42}, {"name": "MultiValueDictKeyError", "bases": ["KeyError"], "methods": [], "docstring": "", "start_line": 45, "end_line": 46}, {"name": "MultiValueDict", "bases": ["dict"], "methods": ["__init__", "__repr__", "__getitem__", "__setitem__", "__copy__", "__deepcopy__", "__getstate__", "__setstate__", "get", "_getlist", "getlist", "setlist", "setdefault", "setlistdefault", "appendlist", "items", "lists", "values", "copy", "update", "dict"], "docstring": "A subclass of dictionary customized to handle multiple values for the\nsame key.\n\n>>> d = MultiValueDict(\n...    {'name': ['Adrian', 'Simon'], 'position': ['Developer']}\n... )\n>>> d['name']\n'Simon'\n>>> d.getlist('name')\n['Adrian', 'Simon']\n>>> d.getlist('doesnotexist')\n[]\n>>> d.getlist('doesnotexist'", "start_line": 49, "end_line": 219}, {"name": "ImmutableList", "bases": ["tuple"], "methods": ["__new__", "complain"], "docstring": "A tuple-like object that raises useful errors when it is asked to mutate.\n\nExample::\n\n    >>> a = ImmutableList(range(5), warning=\"You cannot mutate this.\")\n    >>> a[3] = '4'\n    Traceback (most recent call last):\n        ...\n    AttributeError: You cannot mutate this.", "start_line": 222, "end_line": 256}, {"name": "DictWrapper", "bases": ["dict"], "methods": ["__init__", "__getitem__"], "docstring": "Wrap accesses to a dictionary so that certain values (those starting with\nthe specified prefix) are passed through a function before being returned.\nThe prefix is removed before looking up the real value.\n\nUsed by the SQL construction code to ensure that values are correctly\nquoted before being used", "start_line": 259, "end_line": 285}, {"name": "CaseInsensitiveMapping", "bases": ["Mapping"], "methods": ["__init__", "__getitem__", "__len__", "__eq__", "__iter__", "__repr__", "copy", "_unpack_items"], "docstring": "Mapping allowing case-insensitive key lookups. Original case of keys is\npreserved for iteration and string representation.\n\nExample::\n\n    >>> ci_map = CaseInsensitiveMapping({'name': 'Jane'})\n    >>> ci_map['Name']\n    Jane\n    >>> ci_map['NAME']\n    Jane\n    >>> ci_map['name']\n    Jane\n    >>> ci_", "start_line": 288, "end_line": 347}, {"name": "DeferredSubDict", "bases": [], "methods": ["__init__", "__getitem__"], "docstring": "Wrap a dict, allowing deferred access to a sub-dict under a given key.\n\nThe value at ``deferred_key`` must itself be a dict. Accessing\n``DeferredSubDict(parent_dict, deferred_key)[key]`` retrieves\n``parent_dict[deferred_key][key]`` at access time, so updates to\nthe parent dict are reflected.", "start_line": 350, "end_line": 365}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/utils/asyncio.py", "file_hash": "d2094e8377869a6b3e814bf4e19803bd9b75f4865b74f042eb83e768aa9e1837", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "asyncio", "names": ["get_running_loop"], "is_from": true, "alias": ""}, {"module": "functools", "names": ["wraps"], "is_from": true, "alias": ""}, {"module": "django.core.exceptions", "names": ["SynchronousOnlyOperation"], "is_from": true, "alias": ""}], "functions": [{"name": "async_unsafe", "qualified_name": "async_unsafe", "args": ["message"], "decorators": [], "docstring": "Decorator to mark functions as async-unsafe. Someone trying to access\nthe function while in an async context will get an error message.", "start_line": 8, "end_line": 39, "is_async": false, "is_method": false}, {"name": "decorator", "qualified_name": "decorator", "args": ["func"], "decorators": [], "docstring": "", "start_line": 14, "end_line": 28, "is_async": false, "is_method": false}, {"name": "inner", "qualified_name": "inner", "args": [], "decorators": ["wraps(func)"], "docstring": "", "start