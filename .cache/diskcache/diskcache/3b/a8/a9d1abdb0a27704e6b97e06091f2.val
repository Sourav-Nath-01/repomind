changed\nby subclasses.", "start_line": 378, "end_line": 385, "is_async": false, "is_method": false}, {"name": "clone", "qualified_name": "clone", "args": ["self"], "decorators": [], "docstring": "Return a copy of the current Query. A lightweight alternative to\ndeepcopy().", "start_line": 387, "end_line": 430, "is_async": false, "is_method": false}, {"name": "chain", "qualified_name": "chain", "args": ["self", "klass"], "decorators": [], "docstring": "Return a copy of the current Query that's ready for another operation.\nThe klass argument changes the type of the Query, e.g. UpdateQuery.", "start_line": 432, "end_line": 445, "is_async": false, "is_method": false}, {"name": "relabeled_clone", "qualified_name": "relabeled_clone", "args": ["self", "change_map"], "decorators": [], "docstring": "", "start_line": 447, "end_line": 450, "is_async": false, "is_method": false}, {"name": "_get_col", "qualified_name": "_get_col", "args": ["self", "target", "field", "alias"], "decorators": [], "docstring": "", "start_line": 452, "end_line": 455, "is_async": false, "is_method": false}, {"name": "get_aggregation", "qualified_name": "get_aggregation", "args": ["self", "using", "aggregate_exprs"], "decorators": [], "docstring": "Return the dictionary with the values of the existing aggregations.", "start_line": 457, "end_line": 649, "is_async": false, "is_method": false}, {"name": "get_count", "qualified_name": "get_count", "args": ["self", "using"], "decorators": [], "docstring": "Perform a COUNT() query using the current filter constraints.", "start_line": 651, "end_line": 656, "is_async": false, "is_method": false}, {"name": "has_filters", "qualified_name": "has_filters", "args": ["self"], "decorators": [], "docstring": "", "start_line": 658, "end_line": 659, "is_async": false, "is_method": false}, {"name": "exists", "qualified_name": "exists", "args": ["self", "limit"], "decorators": [], "docstring": "", "start_line": 661, "end_line": 681, "is_async": false, "is_method": false