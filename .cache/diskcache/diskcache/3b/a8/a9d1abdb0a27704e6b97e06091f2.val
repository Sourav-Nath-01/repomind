y"], "docstring": "A Producer that is sensitive to boundaries.\n\nWill happily yield bytes until a boundary is found. Will yield the bytes\nbefore the boundary, throw away the boundary bytes themselves, and push the\npost-boundary bytes back on the stream.\n\nThe future calls to next() after locating the boundary will raise", "start_line": 584, "end_line": 677}, {"name": "Parser", "bases": [], "methods": ["__init__", "__iter__"], "docstring": "", "start_line": 750, "end_line": 759}], "calls": [], "module_docstring": "Multi-part parsing for file uploads.\n\nExposes one class, ``MultiPartParser``, which feeds chunks of uploaded data to\nfile upload handlers for processing.", "parse_error": ""}, {"file_path": "django/http/cookie.py", "file_hash": "b7bc863911829549c2615290ab22c194462cc502cb1e7f5caec3125aa2bf1227", "imports": [{"module": "http", "names": ["cookies"], "is_from": true, "alias": ""}], "functions": [{"name": "parse_cookie", "qualified_name": "parse_cookie", "args": ["cookie"], "decorators": [], "docstring": "Return a dictionary parsed from a `Cookie:` header string.", "start_line": 7, "end_line": 23, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/middleware/common.py", "file_hash": "a1c6947b6be52a5eef82a21c0aaaa11440708127f5ef8176873409f66f69aa3c", "imports": [{"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "urllib.parse", "names": ["urlsplit"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.core.exceptions", "names": ["PermissionDenied"], "is_from": true, "alias": ""}, {"module": "django.core.mail", "names": ["MailerDoesNotExist", "mail_managers", "mailers"], "is_from": true, "alias": ""}, {"module": "django.http", "names": ["HttpResponsePermanentRedirect"], "is_from": true, "alias": ""}, {"module": "django.urls", "names": ["is_valid_path"], "is_from": true, "alias