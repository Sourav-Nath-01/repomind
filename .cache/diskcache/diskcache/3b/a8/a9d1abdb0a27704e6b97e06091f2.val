7979ced777a81b17b1036aa0413a3f68aaf6322afb2429b1a1cbe", "imports": [{"module": "django.utils.translation", "names": ["gettext"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "tests/i18n/resolution/__init__.py", "file_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "tests/i18n/sampleproject/update_catalogs.py", "file_hash": "dba56205c322ed10b2e999166c02c8a214c8ee9992c3dc9de60f1d3246755417", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "django.core.management", "names": ["call_command"], "is_from": true, "alias": ""}], "functions": [{"name": "update_translation_catalogs", "qualified_name": "update_translation_catalogs", "args": [], "decorators": [], "docstring": "Run makemessages and compilemessages in sampleproject.", "start_line": 38, "end_line": 57, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "Helper script to update sampleproject's translation catalogs.\n\nWhen a bug has been identified related to i18n, this helps capture the issue\nby using catalogs created from management commands.\n\nExample:\n\nThe string \"Two %% Three %%%\" renders differently using translate and\nblocktranslate. This issue is difficult to debug, it could be a problem with\nextraction, interpolation, or both.\n\nHow this script helps:\n * Add {% translate \"Two %% Three %%%\" %} and blocktranslate equivalent to\n   templates.\n * Run this script.\n * Test extraction - verify the new msgid in sampleproject's django.po.\n * Add a translation to sampleproject's django.po.\n * Run this script.\n * Test interpolation - verify templatetag rendering, test each in a template\n   that is rendered using an activated language from sampleproject's locale.\n * Tests should fail, issue captured.\n * Fix issue.\n * Run this script.\n * Tests all pass.", "parse_error": ""}, {"file_path": "tests/i18n/sampleproject/manage.py", "file_hash": "d8efd86c5bced5d3b692945ec658fda38bec2183f4f594a8de2a3ca1cb36e855", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "django.core.management", "names": ["execute_from_command_line"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "tests/i18n/obsolete_translations/__init__.py", "file_hash": "b336a95478fbc08f8134c1be6465f6b69073b4f80386964e8f99e1ebb6633f72", "imports": [{"module": "django.utils.translation", "names": ["gettext"], "is_from": true, "alias": ""}], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "tests/i18n/patterns/tests.py", "file_hash": "af9727357deda9523bdc6f35abadf5818cdf3557113e2815013e9b09f9ba2b25", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.core.exceptions", "names": ["ImproperlyConfigured"], "is_from": true, "alias": ""}, {"module": "django.http", "names": ["HttpResponse", "HttpResponsePermanentRedirect"], "is_from": true, "alias": ""}, {"module": "django.middleware.locale", "names": ["LocaleMiddleware"], "is_from": true, "alias": ""}, {"module": "django.template", "names": ["Context", "Template"], "is_from": true, "alias": ""}, {"module": "django.test", "names": ["SimpleTestCase", "override_settings"], "is_from": true, "alias": ""}, {"module": "django.test.client", "names": ["RequestFactory"], "is_from": true, "alias": ""}, {"module": "django.test.utils", "names": ["override_script_prefix"], "is_from": true, "ali