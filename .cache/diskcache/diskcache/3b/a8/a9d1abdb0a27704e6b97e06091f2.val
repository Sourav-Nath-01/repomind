 {"name": "parse_http_date_safe", "qualified_name": "parse_http_date_safe", "args": ["date"], "decorators": [], "docstring": "Same as parse_http_date, but return None if the input is invalid.", "start_line": 140, "end_line": 147, "is_async": false, "is_method": false}, {"name": "base36_to_int", "qualified_name": "base36_to_int", "args": ["s"], "decorators": [], "docstring": "Convert a base 36 string to an int. Raise ValueError if the input won't fit\ninto an int.", "start_line": 153, "end_line": 163, "is_async": false, "is_method": false}, {"name": "int_to_base36", "qualified_name": "int_to_base36", "args": ["i"], "decorators": [], "docstring": "Convert an integer to a base36 string.", "start_line": 166, "end_line": 177, "is_async": false, "is_method": false}, {"name": "urlsafe_base64_encode", "qualified_name": "urlsafe_base64_encode", "args": ["s"], "decorators": [], "docstring": "Encode a bytestring to a base64 string for use in URLs. Strip any trailing\nequal signs.", "start_line": 180, "end_line": 185, "is_async": false, "is_method": false}, {"name": "urlsafe_base64_decode", "qualified_name": "urlsafe_base64_decode", "args": ["s"], "decorators": [], "docstring": "Decode a base64 encoded string. Add back any trailing equal signs that\nmight have been stripped.", "start_line": 188, "end_line": 197, "is_async": false, "is_method": false}, {"name": "parse_etags", "qualified_name": "parse_etags", "args": ["etag_str"], "decorators": [], "docstring": "Parse a string of ETags given in an If-None-Match or If-Match header as\ndefined by RFC 9110. Return a list of quoted ETags, or ['*'] if all ETags\nshould be matched.", "start_line": 200, "end_line": 211, "is_async": false, "is_method": false}, {"name": "quote_etag", "qualified_name": "quote_etag", "args": ["etag_str"], "decorators": [], "docstring": "If the provided string is already a quoted ETag, return it. Otherwise, wrap\nthe string in quotes, making it a strong ETag.", "start_line": 214, "end_line": 222, "is_async": false, "is_method": false}, {"name": "is_same_domain", "qualified_name": "is_same_domain", "args": ["host", "pattern"], "decorators": [], "docstring": "Return ``True`` if the host is either an exact match or a match\nto the wildcard pattern.\n\nAny pattern beginning with a period matches a domain and all of its\nsubdomains. (e.g. ``.example.com`` matches ``example.com`` and\n``foo.example.com``). Anything else is an exact string match.", "start_line": 225, "end_line": 242, "is_async": false, "is_method": false}, {"name": "url_has_allowed_host_and_scheme", "qualified_name": "url_has_allowed_host_and_scheme", "args": ["url", "allowed_hosts", "require_https"], "decorators": [], "docstring": "Return ``True`` if the url uses an allowed host and a safe scheme.\n\nAlways return ``False`` on an empty url.\n\nIf ``require_https`` is ``True``, only 'https' will be considered a valid\nscheme, as opposed to 'http' and 'https' with the default, ``False``.\n\nNote: \"True\" doesn't entail that a URL is \"sa", "start_line": 245, "end_line": 272, "is_async": false, "is_method": false}, {"name": "_url_has_allowed_host_and_scheme", "qualified_name": "_url_has_allowed_host_and_scheme", "args": ["url", "allowed_hosts", "require_https"], "decorators": [], "docstring": "", "start_line": 275, "end_line": 305, "is_async": false, "is_method": false}, {"name": "escape_leading_slashes", "qualified_name": "escape_leading_slashes", "args": ["url"], "decorators": [], "docstring": "If redirecting to an absolute path (two leading slashes), a slash must be\nescaped to prevent browsers from handling the path as schemaless and\nredirecting to another host.", "start_line": 308, "end_line": 316, "is_async": false, "is_method": false}, {"name": "_parseparam", "qualified_name": "_parseparam", "args": ["s"], "decorators": [], "docstring": "", "start_line": 319, "end_line": 329, "is_async": false, "is_method": false}, {"name": "parse_header_parameters", "qualified_name": "parse_header_parameters", "args":