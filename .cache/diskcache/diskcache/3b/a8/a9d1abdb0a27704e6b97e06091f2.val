= feature['description']\n\n         # We can also increment through all of the fields\n         #  attached to this feature.\n         for field in feature:\n             # Get the name of the field (e.g. 'description')\n             nm = field.name\n\n             # Get the type (integer) of the field, e.g. 0 => OFTInteger\n             t = field.type\n\n             # Returns the value the field; OFTIntegers return ints,\n             #  OFTReal returns floats, all else returns string.\n             val = field.value", "parse_error": ""}, {"file_path": "django/contrib/gis/gdal/field.py", "file_hash": "bc20aaa2933ea136a18776f02f67926d92853debd0ab7676c04abb7f041a7532", "imports": [{"module": "ctypes", "names": ["byref", "c_int"], "is_from": true, "alias": ""}, {"module": "datetime", "names": ["date", "datetime", "time"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.base", "names": ["GDALBase"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.error", "names": ["GDALException"], "is_from": true, "alias": ""}, {"module": "django.contrib.gis.gdal.prototypes", "names": ["ds"], "is_from": true, "alias": ""}, {"module": "django.utils.encoding", "names": ["force_str"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "feat", "index"], "decorators": [], "docstring": "Initialize on the feature object and the integer index of\nthe field within the feature.", "start_line": 19, "end_line": 35, "is_async": false, "is_method": false}, {"name": "__str__", "qualified_name": "__str__", "args": ["self"], "decorators": [], "docstring": "Return the string representation of the Field.", "start_line": 37, "end_line": 39, "is_async": false, "is_method": false}, {"name": "as_double", "qualified_name": "as_double", "args": ["self"], "decorators": [], "docstring": "Retrieve the Field's value as a double (float).", "start_line": 42, "end_line": 48, "is_async": false, "is_method": false}, 