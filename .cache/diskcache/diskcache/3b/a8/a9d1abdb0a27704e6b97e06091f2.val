\nThe algorithm takes into account the vary", "start_line": 28, "end_line": 135, "is_async": false, "is_method": false}, {"name": "timeuntil", "qualified_name": "timeuntil", "args": ["d", "now", "time_strings", "depth"], "decorators": [], "docstring": "Like timesince, but return a string measuring the time until the given\ntime.", "start_line": 138, "end_line": 143, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/utils/_os.py", "file_hash": "9060ff37e14d29dd66be7b225ef1af9d34d8d445b6d250f524d61174827ee46d", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "tempfile", "names": [], "is_from": false, "alias": ""}, {"module": "os.path", "names": ["abspath", "curdir", "dirname", "join", "normcase", "sep"], "is_from": true, "alias": ""}, {"module": "pathlib", "names": ["Path"], "is_from": true, "alias": ""}, {"module": "django.core.exceptions", "names": ["SuspiciousFileOperation"], "is_from": true, "alias": ""}], "functions": [{"name": "makedirs", "qualified_name": "makedirs", "args": ["name", "mode", "exist_ok"], "decorators": [], "docstring": "makedirs(name [, mode=0o777][, exist_ok=False][, parent_mode=None])\n\nSuper-mkdir; create a leaf directory and all intermediate ones.  Works like\nmkdir, except that any intermediate path segment (not just the rightmost)\nwill be created if it does not exist. If the target directory already\nexists, rai", "start_line": 13, "end_line": 57, "is_async": false, "is_method": false}, {"name": "safe_makedirs", "qualified_name": "safe_makedirs", "args": ["name", "mode", "exist_ok"], "decorators": [], "docstring": "Create directories recursively with explicit `mode` on each level.", "start_line": 60, "end_line": 62, "is_async": false, "is_method": false}, {"name": "safe_join", "qualified_name": "safe_join", "args": ["base"], "decorators": [], "docstring": "Join one or more path components to the base path component in