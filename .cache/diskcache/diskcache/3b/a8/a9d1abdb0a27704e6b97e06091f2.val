string": "Return a table alias for the given table_name and whether this is a\nnew alias or not.\n\nIf 'create' is true, a new alias is always created. Otherwise, the\nmost recently created alias for the table (if one exists) is reused.", "start_line": 899, "end_line": 924, "is_async": false, "is_method": false}, {"name": "ref_alias", "qualified_name": "ref_alias", "args": ["self", "alias"], "decorators": [], "docstring": "Increases the reference count for this alias.", "start_line": 926, "end_line": 928, "is_async": false, "is_method": false}, {"name": "unref_alias", "qualified_name": "unref_alias", "args": ["self", "alias", "amount"], "decorators": [], "docstring": "Decreases the reference count for this alias.", "start_line": 930, "end_line": 932, "is_async": false, "is_method": false}, {"name": "promote_joins", "qualified_name": "promote_joins", "args": ["self", "aliases"], "decorators": [], "docstring": "Promote recursively the join type of given aliases and its children to\nan outer join. If 'unconditional' is False, only promote the join if\nit is nullable or the parent join is an outer join.\n\nThe children promotion is done to avoid join chains that contain a\nLOUTER b INNER c. So, if we have current", "start_line": 934, "end_line": 970, "is_async": false, "is_method": false}, {"name": "demote_joins", "qualified_name": "demote_joins", "args": ["self", "aliases"], "decorators": [], "docstring": "Change join type from LOUTER to INNER for all joins in aliases.\n\nSimilarly to promote_joins(), this method must ensure no join chains\ncontaining first an outer, then an inner join are generated. If we\nare demoting b->c join in chain a LOUTER b LOUTER c then we must\ndemote a->b automatically, or othe", "start_line": 972, "end_line": 989, "is_async": false, "is_method": false}, {"name": "reset_refcounts", "qualified_name": "reset_refcounts", "args": ["self", "to_counts"], "decorators": [], "docstring": "Reset reference counts for aliases so that they match the value passed\nin `to_counts`.", "start_line": 991, "end_line": 998, "is_async": false, "is_method": false}, {"name": "change_aliases", "qualified_name": "change_aliases", "args": ["self", "change_map"], "decorators": [], "docstring": "Change the aliases in change_map (which maps old-alias -> new-alias),\nrelabelling any references to them in select columns and the where\nclause.", "start_line": 1000, "end_line": 1055, "is_async": false, "is_method": false}, {"name": "bump_prefix", "qualified_name": "bump_prefix", "args": ["self", "other_query", "exclude"], "decorators": [], "docstring": "Change the alias prefix to the next letter in the alphabet in a way\nthat the other query's aliases and this query's aliases will not\nconflict. Even tables that previously had no alias will get an alias\nafter this call. To prevent changing aliases use the exclude parameter.", "start_line": 1057, "end_line": 1110, "is_async": false, "is_method": false}, {"name": "get_initial_alias", "qualified_name": "get_initial_alias", "args": ["self"], "decorators": [], "docstring": "Return the first alias for this query, after increasing its reference\ncount.", "start_line": 1112, "end_line": 1124, "is_async": false, "is_method": false}, {"name": "count_active_tables", "qualified_name": "count_active_tables", "args": ["self"], "decorators": [], "docstring": "Return the number of tables in this query with a non-zero reference\ncount. After execution, the reference counts are zeroed, so tables\nadded in compiler will not be seen by this method.", "start_line": 1126, "end_line": 1132, "is_async": false, "is_method": false}, {"name": "join", "qualified_name": "join", "args": ["self", "join", "reuse"], "decorators": [], "docstring": "Return an alias for the 'join', either reusing an existing alias for\nthat join or creating a new one. 'join' is either a base_table_class or\njoin_class.\n\nThe 'reuse' parameter can be either None which means all joins are\nreusable, or it can be a set containing the aliases that can be reused.\n\nA join", "start_line": 1134, "end_line": 1186, "is_async": false, "is_method": false}, {"name": "join_parent_model", "qualified_name": "join_parent_model", "args": ["self", "opts", "model", "alias", "seen"], "decorators": [], "docstring": "Make sure the given 'model' is joined in the query. If 'model' isn't\na parent of 'opts' or if it is None this method is a no-op.\n\nThe 'alias' is the root alias for starting the join, 'seen' is a dict\nof model -> alias of existing joins. It must also contain a mapping\nof None -> some alias. This will", "start_line": 1188, "end_line": 1219, "is_async": false, "is_method": false}, {"name": "check_alias", "qualified_name": "check_alias", "args": ["self", "alias"], "decorators": [], "docstring": "", "start_line": 1221, "end_line": 1237, "is_async": false, "is_method": false}, {"name": "add_annotation", "qualified_name": "add_annotation", "args": ["self", "annotation", "alias", "select"], "decorators": [], "docstring": "Add a single annotation expression to the Query.", "start_line": 1239, "end_line": 1249, "is_async": false, "is_method": false}, {"name": "_subquery_fields_len", "qualified_name": "_subquery_fields_len", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 1252, "end_line": 1257, "is_async": false, "is_method": false}, {"name": "resolve_expression", "qualified_name": "resolve_expression", "args": ["self", "query"], "decorators": [], "docstring": "", "start_line": 1259, "end_line": 1287, "is_async": false, "is_method": false}, {"name": "get_external_cols", "qualified_name": "get_external_cols", "args": ["self"], "decorators": [], "docstring": "", "start_line": 1289, "end_line": 1295, "is_async": false, "is_method": false}, {"name": "get_group_by_cols", "qualified_name": "get_group_by_cols", "args": ["self", "wrapper"], "decorators": [], "docstring": "", "start_line": 1297, "end_line": 1305, "is_async": false, "is_method": false}, {"name": "as_sql", "qualified_name":