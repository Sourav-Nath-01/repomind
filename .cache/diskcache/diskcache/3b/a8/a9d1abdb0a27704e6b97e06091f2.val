arily add paths to sys.path.", "start_line": 791, "end_line": 798, "is_async": false, "is_method": false}, {"name": "isolate_lru_cache", "qualified_name": "isolate_lru_cache", "args": ["lru_cache_object"], "decorators": ["contextmanager"], "docstring": "Clear the cache of an LRU cache object on entering and exiting.", "start_line": 802, "end_line": 808, "is_async": false, "is_method": false}, {"name": "captured_output", "qualified_name": "captured_output", "args": ["stream_name"], "decorators": ["contextmanager"], "docstring": "Return a context manager used by captured_stdout/stdin/stderr\nthat temporarily replaces the sys stream *stream_name* with a StringIO.\n\nNote: This function and the following ``captured_std*`` are copied\n      from CPython's ``test.support`` module.", "start_line": 812, "end_line": 823, "is_async": false, "is_method": false}, {"name": "captured_stdout", "qualified_name": "captured_stdout", "args": [], "decorators": [], "docstring": "Capture the output of sys.stdout:\n\n    with captured_stdout() as stdout:\n        print(\"hello\")\n    self.assertEqual(stdout.getvalue(), \"hello\n\")\n    ", "start_line": 826, "end_line": 833, "is_async": false, "is_method": false}, {"name": "captured_stderr", "qualified_name": "captured_stderr", "args": [], "decorators": [], "docstring": "Capture the output of sys.stderr:\n\n    with captured_stderr() as stderr:\n        print(\"hello\", file=sys.stderr)\n    self.assertEqual(stderr.getvalue(), \"hello\n\")\n    ", "start_line": 836, "end_line": 843, "is_async": false, "is_method": false}, {"name": "captured_stdin", "qualified_name": "captured_stdin", "args": [], "decorators": [], "docstring": "Capture the input to sys.stdin:\n\n    with captured_stdin() as stdin:\n        stdin.write('hello\n')\n        stdin.seek(0)\n        # call test code that consumes from sys.stdin\n        captured = input()\n    self.assertEqual(captured, \"hello\")\n    ", "start_line": 846, "end_line": 856, "is_async": false, "is_method": false}, {"name": "freeze_time", "qualified_name": "freeze_time", "args": ["t"], "decorators": ["contextmanager"], "docstring": "Context manager to temporarily freeze time.time(). This temporarily\nmodifies the time function of the time module. Modules which import the\ntime function directly (e.g. `from time import time`) won't be affected\nThis isn't meant as a public API, but helps reduce some repetitive code in\nDjango's test", "start_line": 860, "end_line": 873, "is_async": false, "is_method": false}, {"name": "require_jinja2", "qualified_name": "require_jinja2", "args": ["test_func"], "decorators": [], "docstring": "Decorator to enable a Jinja2 template engine in addition to the regular\nDjango template engine for a test or skip it if Jinja2 isn't available.", "start_line": 876, "end_line": 894, "is_async": false, "is_method": false}, {"name": "tag", "qualified_name": "tag", "args": [], "decorators": [], "docstring": "Decorator to add tags to a test class or method.", "start_line": 989, "end_line": 999, "is_async": false, "is_method": false}, {"name": "register_lookup", "qualified_name": "register_lookup", "args": ["field"], "decorators": ["contextmanager"], "docstring": "Context manager to temporarily register lookups on a model field using\nlookup_name (or the lookup's lookup_name if not provided).", "start_line": 1003, "end_line": 1014, "is_async": false, "is_method": false}, {"name": "garbage_collect", "qualified_name": "garbage_collect", "args": [], "decorators": [], "docstring": "", "start_line": 1017, "end_line": 1021, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "val", "places"], "decorators": [], "docstring": "", "start_line": 61, "end_line": 63, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 65, "end_line": 66, "is_async": false, "is_method": false}, {"name": "__eq__",