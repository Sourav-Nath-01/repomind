erable errors have occurred\nor if it outlived its maximum age.", "start_line": 591, "end_line": 616, "is_async": false, "is_method": false}, {"name": "allow_thread_sharing", "qualified_name": "allow_thread_sharing", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 621, "end_line": 623, "is_async": false, "is_method": false}, {"name": "inc_thread_sharing", "qualified_name": "inc_thread_sharing", "args": ["self"], "decorators": [], "docstring": "", "start_line": 625, "end_line": 627, "is_async": false, "is_method": false}, {"name": "dec_thread_sharing", "qualified_name": "dec_thread_sharing", "args": ["self"], "decorators": [], "docstring": "", "start_line": 629, "end_line": 635, "is_async": false, "is_method": false}, {"name": "validate_thread_sharing", "qualified_name": "validate_thread_sharing", "args": ["self"], "decorators": [], "docstring": "Validate that the connection isn't accessed by another thread than the\none which originally created it, unless the connection was explicitly\nauthorized to be shared between threads (via the `inc_thread_sharing()`\nmethod). Raise an exception if the validation fails.", "start_line": 637, "end_line": 650, "is_async": false, "is_method": false}, {"name": "prepare_database", "qualified_name": "prepare_database", "args": ["self"], "decorators": [], "docstring": "Hook to do any database check or preparation, generally called before\nmigrating a project or an app.", "start_line": 654, "end_line": 659, "is_async": false, "is_method": false}, {"name": "wrap_database_errors", "qualified_name": "wrap_database_errors", "args": ["self"], "decorators": ["cached_property"], "docstring": "Context manager and decorator that re-throws backend-specific database\nexceptions using Django's common wrappers.", "start_line": 662, "end_line": 667, "is_async": false, "is_method": false}, {"name": "chunked_cursor", "qualified_name": "chunked_cursor", "args": ["self"], "decorators": [], "docstring": "Return a cursor that 