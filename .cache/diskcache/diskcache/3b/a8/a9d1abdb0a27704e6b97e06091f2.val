k_name"], "decorators": [], "docstring": "Given a cursor object that has just performed an INSERT statement into\na table that has an auto-incrementing ID, return the newly created ID.\n\n`pk_name` is the name of the primary-key column.", "start_line": 308, "end_line": 315, "is_async": false, "is_method": false}, {"name": "lookup_cast", "qualified_name": "lookup_cast", "args": ["self", "lookup_type", "internal_type"], "decorators": [], "docstring": "Return the string to use in a query when performing lookups\n(\"contains\", \"like\", etc.). It should contain a '%s' placeholder for\nthe column being searched against.", "start_line": 317, "end_line": 323, "is_async": false, "is_method": false}, {"name": "max_in_list_size", "qualified_name": "max_in_list_size", "args": ["self"], "decorators": [], "docstring": "Return the maximum number of items that can be passed in a single 'IN'\nlist condition, or None if the backend does not impose a limit.", "start_line": 325, "end_line": 330, "is_async": false, "is_method": false}, {"name": "max_name_length", "qualified_name": "max_name_length", "args": ["self"], "decorators": [], "docstring": "Return the maximum length of table and column names, or None if there\nis no limit.", "start_line": 332, "end_line": 337, "is_async": false, "is_method": false}, {"name": "no_limit_value", "qualified_name": "no_limit_value", "args": ["self"], "decorators": [], "docstring": "Return the value to use for the LIMIT when we are wanting \"LIMIT\ninfinity\". Return None if the limit clause can be omitted in this case.", "start_line": 339, "end_line": 346, "is_async": false, "is_method": false}, {"name": "pk_default_value", "qualified_name": "pk_default_value", "args": ["self"], "decorators": [], "docstring": "Return the value to use during an INSERT statement to specify that\nthe field should use its default value.", "start_line": 348, "end_line": 353, "is_async": false, "is_method": false}, {"name": "prepare_sql_script", "qualified_name": "prepare_sql_script", "args": ["self", "sql"], "decorators": [], "docstring": "Take an SQL script that may contain multiple lines and return a list\nof statements to feed to successive cursor.execute() calls.\n\nSince few databases are able to process raw SQL scripts in a single\ncursor.execute() call and PEP 249 doesn't talk about this use case,\nthe default implementation is cons", "start_line": 355, "end_line": 368, "is_async": false, "is_method": false}, {"name": "process_clob", "qualified_name": "process_clob", "args": ["self", "value"], "decorators": [], "docstring": "Return the value of a CLOB column, for backends that return a locator\nobject that requires additional processing.", "start_line": 370, "end_line": 375, "is_async": false, "is_method": false}, {"name": "returning_columns", "qualified_name": "returning_columns", "args": ["self", "fields"], "decorators": [], "docstring": "For backends that support returning columns as part of an insert or\nupdate query, return the SQL and params to append to the query.\nThe returned fragment should contain a format string to hold the\nappropriate column.", "start_line": 377, "end_line": 394, "is_async": false, "is_method": false}, {"name": "fetch_returned_rows", "qualified_name": "fetch_returned_rows", "args": ["self", "cursor", "returning_params"], "decorators": [], "docstring": "Given a cursor object for a DML query with a RETURNING statement,\nreturn the selected returning rows of tuples.", "start_line": 396, "end_line": 401, "is_async": false, "is_method": false}, {"name": "compiler", "qualified_name": "compiler", "args": ["self", "compiler_name"], "decorators": [], "docstring": "Return the SQLCompiler class corresponding to the given name,\nin the namespace corresponding to the `compiler_module` attribute\non this backend.", "start_line": 403, "end_line": 411, "is_async": false, "is_method": false}, {"name": "quote_name", "qualified_name": "quote_name", "args": ["self", "name"], "decorators": [], "docstring": "Return