__", "__bool__", "_get_name", "_set_name"], "docstring": "An abstract uploaded file (``TemporaryUploadedFile`` and\n``InMemoryUploadedFile`` are the built-in concrete subclasses).\n\nAn ``UploadedFile`` object behaves somewhat like a file object and\nrepresents some file data that the user submitted with a form.", "start_line": 21, "end_line": 71}, {"name": "TemporaryUploadedFile", "bases": ["UploadedFile"], "methods": ["__init__", "temporary_file_path", "close"], "docstring": "A file uploaded to a temporary location (i.e. stream-to-disk).", "start_line": 74, "end_line": 97}, {"name": "InMemoryUploadedFile", "bases": ["UploadedFile"], "methods": ["__init__", "open", "chunks", "multiple_chunks"], "docstring": "A file uploaded into memory (i.e. stream-to-memory).", "start_line": 100, "end_line": 128}, {"name": "SimpleUploadedFile", "bases": ["InMemoryUploadedFile"], "methods": ["__init__", "from_dict"], "docstring": "A simple representation of a file, which just has content, size, and a\nname.", "start_line": 131, "end_line": 155}], "calls": [], "module_docstring": "Classes representing uploaded files.", "parse_error": ""}, {"file_path": "django/core/files/temp.py", "file_hash": "238eb74761eeab3033ae9222e45037bd3f12f26d997526195ce702f77d853b5c", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "tempfile", "names": [], "is_from": false, "alias": ""}, {"module": "django.core.files.utils", "names": ["FileProxyMixin"], "is_from": true, "alias": ""}], "functions": [{"name": "__init__", "qualified_name": "__init__", "args": ["self", "mode", "bufsize", "suffix", "prefix", "dir"], "decorators": [], "docstring": "", "start_line": 42, "end_line": 46, "is_async": false, "is_method": false}, {"name": "close", "qualified_name": "close", "args": ["self"], "decorators": [], "docstring": "", "start_line": 53, "end_line": 63, "is_async": false, "is_method": false}, {"name": "__del__", "qualified_name": "__del__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 65, "end_line": 66, "is_async": false, "is_method": false}, {"name": "__enter__", "qualified_name": "__enter__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 68, "end_line": 70, "is_async": false, "is_method": false}, {"name": "__exit__", "qualified_name": "__exit__", "args": ["self", "exc", "value", "tb"], "decorators": [], "docstring": "", "start_line": 72, "end_line": 73, "is_async": false, "is_method": false}], "classes": [{"name": "TemporaryFile", "bases": ["FileProxyMixin"], "methods": ["__init__", "close", "__del__", "__enter__", "__exit__"], "docstring": "Temporary file object constructor that supports reopening of the\ntemporary file in Windows.\n\nUnlike tempfile.NamedTemporaryFile from the standard library,\n__init__() doesn't support the 'delete', 'buffering', 'encoding', or\n'newline' keyword arguments.", "start_line": 32, "end_line": 73}], "calls": [], "module_docstring": "The temp module provides a NamedTemporaryFile that can be reopened in the same\nprocess on any platform. Most platforms use the standard Python\ntempfile.NamedTemporaryFile class, but Windows users are given a custom class.\n\nThis is needed because the Python implementation of NamedTemporaryFile uses the\nO_TEMPORARY flag under Windows, which prevents the file from being reopened\nif the same flag is not provided [1][2]. Note that this does not address the\nmore general issue of opening a file for writing and reading in multiple\nprocesses in a manner that works across platforms.\n\nThe custom version of NamedTemporaryFile doesn't support the same keyword\narguments available in tempfile.NamedTemporaryFile.\n\n1: https://mail.python.org/pipermail/python-list/2005-December/336955.html\n2: https://bugs.python.org/issue14243", "parse_error": ""}, {"file_path": "django/core/files/utils.py", "file_hash": "1df5a1b37a46aeb25e01c36a5afc1fe1088cc141b56f3662c54bafe28e482966", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "pathlib", "names": [], "is_from": false, "alias": ""}, {"module": "django.core.exceptions", "names": ["SuspiciousFileOperation"], "is_from": true, "alias": ""}], "functions": [{"name": "validate_file_name", "qualified_name": "validate_file_name", "args": ["name", "allow_relative_path"], "decorators": [], "docstring": "", "start_line": 7, "end_line": 23, "is_async": false, "is_method": false}, {"name": "closed", "qualified_name": "closed", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 52, "end_line": 53, "is_async": false, "is_method": false}, {"name": "readable", "qualified_name": "readable", "args": ["self"], "decorators": [], "docstring": "", "start_line": 55, "end_line": 60, "is_async": false, "is_method": false}, {"name": "writable", "qualified_name": "writable", "args": ["self"], "decorators": [], "docstring": "", "start_line": 62, "end_line": 67, "is_async": false, "is_method": false}, {"name": "seekable", "qualified_name": "seekable", "args": ["self"], "decorators": [], "docstring": "", "start_line": 69, "end_line": 74, "is_async": false, "is_method": false}, {"name": "__iter__", "qualified_name": "__iter__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 76, "end_line": 77, "is_async": false, "is_method": false}], "classes": [{"name": "FileProxyMixin", "bases": [], "methods": ["closed", "readable", "writable", "seekable", "__iter__"], "docstring": "A mixin class used to forward file methods to an underlying file\nobject. The internal file object has to be called \"file\"::\n\n    class FileProxy(FileProxyMixin):\n        def __init__(self, file):\n            self.file = file", "start_line": 26, "end_line": 77}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/core/files/locks.py", "file_hash": "9a9f7a85cf273286fc70c1128804855944d49ff69f5bc0386a0fef896cf4a235", "imports": [{"module": "os", "names": [], "is_from": false, "alias": ""}, {"module": "msvcrt", "n