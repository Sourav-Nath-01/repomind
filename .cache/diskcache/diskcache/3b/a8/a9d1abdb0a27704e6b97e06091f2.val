ualified_name": "dec", "args": ["func"], "decorators": [], "docstring": "", "start_line": 39, "end_line": 40, "is_async": false, "is_method": false}, {"name": "dec", "qualified_name": "dec", "args": ["func"], "decorators": [], "docstring": "", "start_line": 78, "end_line": 79, "is_async": false, "is_method": false}], "classes": [{"name": "InvalidTemplateLibrary", "bases": ["Exception"], "methods": [], "docstring": "", "start_line": 13, "end_line": 14}, {"name": "Library", "bases": [], "methods": ["__init__", "tag", "tag_function", "filter", "filter_function", "simple_tag", "simple_block_tag", "inclusion_tag"], "docstring": "A class for registering template tags and filters. Compiled filter and\ntemplate tag functions are stored in the filters and tags attributes.\nThe filter, simple_tag, and inclusion_tag methods provide a convenient\nway to register callables as tags.", "start_line": 17, "end_line": 310}, {"name": "TagHelperNode", "bases": ["Node"], "methods": ["__init__", "get_resolved_arguments"], "docstring": "Base class for tag helper nodes such as SimpleNode and InclusionNode.\nManages the positional and keyword arguments to be passed to the decorated\nfunction.", "start_line": 313, "end_line": 331}, {"name": "SimpleNode", "bases": ["TagHelperNode"], "methods": ["__init__", "render"], "docstring": "", "start_line": 334, "end_line": 349}, {"name": "SimpleBlockNode", "bases": ["SimpleNode"], "methods": ["__init__", "get_resolved_arguments"], "docstring": "", "start_line": 352, "end_line": 366}, {"name": "InclusionNode", "bases": ["TagHelperNode"], "methods": ["__init__", "render"], "docstring": "", "start_line": 369, "end_line": 403}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "django/template/context_processors.py", "file_hash": "c07f8479da9f146c011bbf4f41780aebbe3faa81ddf5c8f01e19604d73864a65", "imports": [{"module": "itertools", "names": [], "is_from": false, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.middleware.csp", "names": ["get_nonce"], "is_from": true, "alias": ""}, {"module": "django.middleware.csrf", "names": ["get_token"], "is_from": true, "alias": ""}, {"module": "django.utils.csp", "names": ["CONTEXT_KEY"], "is_from": true, "alias": ""}, {"module": "django.utils.functional", "names": ["SimpleLazyObject", "lazy"], "is_from": true, "alias": ""}, {"module": "django.utils", "names": ["translation"], "is_from": true, "alias": ""}, {"module": "django.utils", "names": ["timezone"], "is_from": true, "alias": ""}, {"module": "django.db", "names": ["connections"], "is_from": true, "alias": ""}], "functions": [{"name": "csrf", "qualified_name": "csrf", "args": ["request"], "decorators": [], "docstring": "Context processor that provides a CSRF token, or the string 'NOTPROVIDED'\nif it has not been provided by either a view decorator or the middleware", "start_line": 19, "end_line": 35, "is_async": false, "is_method": false}, {"name": "debug", "qualified_name": "debug", "args": ["request"], "decorators": [], "docstring": "Return context variables helpful for debugging.", "start_line": 38, "end_line": 57, "is_async": false, "is_method": false}, {"name": "i18n", "qualified_name": "i18n", "args": ["request"], "decorators": [], "docstring": "", "start_line": 60, "end_line": 67, "is_async": false, "is_method": false}, {"name": "tz", "qualified_name": "tz", "args": ["request"], "decorators": [], "docstring": "", "start_line": 70, "end_line": 73, "is_async": false, "is_method": false}, {"name": "static", "qualified_name": "static", "args": ["request"], "decorators": [], "docstring": "Add static-related context variables to the context.", "start_line": 76, "end_line": 80, "is_async": false, "is_method": false}, {"name": "media", "qualified_name": "media", "args": ["request"], "decorators": [], "docstring": "Add media-related context variables to the context.", "start_line": 83, "end_line": 87, "is_async": false, "is_method": false}, {"name": "request", "qualified_name": "request", "args": ["request"], "decorators": [], "docstring": "", "start_line": 90, "end_line": 91, "is_async": false, "is_method": false}, {"name": "csp", "qualified_name": "csp", "args": ["request"], "decorators": [], "docstring": "Add the CSP nonce to the context.", "start_line": 94, "end_line": 98, "is_async": false, "is_method": false}, {"name": "_get_val", "qualified_name": "_get_val", "args": [], "decorators": [], "docstring": "", "start_line": 25, "end_line": 33, "is_async": false, "is_method": false}], "classes": [], "calls": [], "module_docstring": "A set of request processors that return dictionaries to be merged into a\ntemplate context. Each function takes the request object as its only parameter\nand returns a dictionary to add to the context.\n\nThese are referenced from the 'context_processors' option of the configuration\nof a DjangoTemplates backend and used by RequestContext.", "parse_error": ""}, {"file_path": "django/template/defaulttags.py", "file_hash": "f29135015f1d2dd58accd916729d7990c2e759063fa55559fabb821b2f4ec20d", "imports": [{"module": "re", "names": [], "is_from": false, "alias": ""}, {"module": "sys", "names": [], "is_from": false, "alias": ""}, {"module": "warnings", "names": [], "is_from": false, "alias": ""}, {"module": "collections", "names": ["namedtuple"], "is_from": true, "alias": ""}, {"module": "collections.abc", "names": ["Iterable", "Mapping"], "is_from": true, "alias": ""}, {"module": "datetime", "names": ["datetime"], "is_from": true, "alias": ""}, {"module": "itertools", "names": ["cycle"], "is_from": true, "alias": ""}, {"module": "itertools", "names": ["groupby"], "is_from": true, "alias": ""}, {"module": "django.conf", "names": ["settings"], "is_from": true, "alias": ""}, {"module": "django.http", "names": ["QueryDict"], "is_from": true, "alias": ""}, {"module": "django.utils", "names": ["csp", "timezone"], "is_from": true, "alias": ""}, {"module": "django.utils.datastructures", "names": ["DeferredSubDict"], "is_from": true, "alias": ""}, {"module": "django.utils.html", "names": ["conditional_escape", "escape", "format_html"], "is_from": true, "alias": ""}, {"module": "django.utils.lorem_ipsum", "names": ["paragraphs", "words"], "is_from": true, "alias": ""}, {"module": "django.utils.safestring", "names": ["mark_safe"], "is_from": true, "alias": ""}, {"module": "base", "names": ["BLOCK_TAG_END", "BLOCK_TAG_START", "COMMENT_TAG_END", "COMMENT_TAG_START", "FILTER_SEPARATOR", "SINGLE_BRACE_END", "SINGLE_BRACE_START", "VARIABLE_ATTRIBUTE_SEPARATOR", "VARIABLE_TAG_END", "VARIABLE_TAG_START", "Node", "NodeList", "PartialTemplate", "TemplateSyntaxError", "VariableDoesNotExist", "kwarg_re", "render_value_in_context", "token_kwargs"], "is_from": true, "alias": ""}, {"module": "context", "names": ["Context"], "is_from": true, "alias": ""}, {"module": "defaultfilters", "names": ["date"], "is_from": true, "alias": ""}, {"module": "library", "names": ["Library"], "is_from": true, "alias": ""}, {"module": "smartif", "names": ["IfParser", "Literal"], "is_from": true, "alias": ""}, {"module": "pprint", "names": ["pformat"], "is_from": true, "alias": ""}, {"module": "django.utils.html", "names": ["strip_spaces_between_tags"], "is_from": true, "alias": ""}, {"module": "django.urls", "names": ["NoReverseMatch", "reverse"], "is_from": true, "alias": ""}], "functions": [{"name": "autoescape", "qualified_name": "autoescape", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Force autoescape behavior for this block.", "start_line": 585, "end_line": 599, "is_async": false, "is_method": false}, {"name": "comment", "qualified_name": "comment", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Ignore everything between ``{% comment %}`` and ``{% endcomment %}``.", "start_line": 603, "end_line": 608, "is_async": false, "is_method": false}, {"name": "cycle", "qualified_name": "cycle", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Cycle among the given strings each time this tag is encountered.\n\nWithin a loop, cycles among the given strings each time through\nthe loop::\n\n    {% for o in some_list %}\n        <tr class=\"{% cycle 'row1' 'row2' %}\">\n            ...\n        </tr>\n    {% endfor %}\n\nOutside of a loop, give the values", "start_line": 612, "end_line": 701, "is_async": false, "is_method": false}, {"name": "csrf_token", "qualified_name": "csrf_token", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "", "start_line": 705, "end_line": 706, "is_async": false, "is_method": false}, {"name": "debug", "qualified_name": "debug", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Output a whole load of debugging information, including the current\ncontext and imported modules.\n\nSample usage::\n\n    <pre>\n        {% debug %}\n    </pre>", "start_line": 710, "end_line": 721, "is_async": false, "is_method": false}, {"name": "do_filter", "qualified_name": "do_filter", "args": ["parser", "token"], "decorators": ["register.tag('filter')"], "docstring": "Filter the contents of the block through variable filters.\n\nFilters can also be piped through each other, and they can have\narguments -- just like in variable syntax.\n\nSample usage::\n\n    {% filter force_escape|lower %}\n        This text will be HTML-escaped, and will appear in lowercase.\n    {% end", "start_line": 725, "end_line": 755, "is_async": false, "is_method": false}, {"name": "firstof", "qualified_name": "firstof", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Output the first variable passed that is not False.\n\nOutput nothing if all the passed variables are False.\n\nSample usage::\n\n    {% firstof var1 var2 var3 as myvar %}\n\nThis is equivalent to::\n\n    {% if var1 %}\n        {{ var1 }}\n    {% elif var2 %}\n        {{ var2 }}\n    {% elif var3 %}\n        {{ v", "start_line": 759, "end_line": 804, "is_async": false, "is_method": false}, {"name": "do_for", "qualified_name": "do_for", "args": ["parser", "token"], "decorators": ["register.tag('for')"], "docstring": "Loop over each item in an array.\n\nFor example, to display a list of athletes given ``athlete_list``::\n\n    <ul>\n    {% for athlete in athlete_list %}\n        <li>{{ athlete.name }}</li>\n    {% endfor %}\n    </ul>\n\nYou can loop over a list in reverse by using\n``{% for obj in list reversed %}``.\n\nYou ", "start_line": 808, "end_line": 906, "is_async": false, "is_method": false}, {"name": "do_if", "qualified_name": "do_if", "args": ["parser", "token"], "decorators": ["register.tag('if')"], "docstring": "Evaluate a variable, and if that variable is \"true\" (i.e., exists, is not\nempty, and is not a false boolean value), output the contents of the block:\n\n::\n\n    {% if athlete_list %}\n        Number of athletes: {{ athlete_list|count }}\n    {% elif athlete_in_locker_room_list %}\n        Athletes should", "start_line": 933, "end_line": 1020, "is_async": false, "is_method": false}, {"name": "ifchanged", "qualified_name": "ifchanged", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Check if a value has changed from the last iteration of a loop.\n\nThe ``{% ifchanged %}`` block tag is used within a loop. It has two\npossible uses.\n\n1. Check its own rendered contents against its previous state and only\n   displays the content if it has changed. For example, this displays a\n   list ", "start_line": 1024, "end_line": 1062, "is_async": false, "is_method": false}, {"name": "find_library", "qualified_name": "find_library", "args": ["parser", "name"], "decorators": [], "docstring": "", "start_line": 1065, "end_line": 1075, "is_async": false, "is_method": false}, {"name": "load_from_library", "qualified_name": "load_from_library", "args": ["library", "label", "names"], "decorators": [], "docstring": "Return a subset of tags and filters from a library.", "start_line": 1078, "end_line": 1099, "is_async": false, "is_method": false}, {"name": "load", "qualified_name": "load", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Load a custom template tag library into the parser.\n\nFor example, to load the template tags in\n``django/templatetags/news/photos.py``::\n\n    {% load news.photos %}\n\nCan also be used to load an individual tag/filter from\na library::\n\n    {% load byline from news %}", "start_line": 1103, "end_line": 1131, "is_async": false, "is_method": false}, {"name": "lorem", "qualified_name": "lorem", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Create random Latin text useful for providing test data in templates.\n\nUsage format::\n\n    {% lorem [count] [method] [random] %}\n\n``count`` is a number (or variable) containing the number of paragraphs or\nwords to generate (default is 1).\n\n``method`` is either ``w`` for words, ``p`` for HTML paragra", "start_line": 1135, "end_line": 1178, "is_async": false, "is_method": false}, {"name": "now", "qualified_name": "now", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Display the date, formatted according to the given string.\n\nUse the same format as PHP's ``date()`` function; see https://php.net/date\nfor all the possible values.\n\nSample usage::\n\n    It is {% now \"jS F Y H:i\" %}", "start_line": 1182, "end_line": 1201, "is_async": false, "is_method": false}, {"name": "partialdef_func", "qualified_name": "partialdef_func", "args": ["parser", "token"], "decorators": ["register.tag(name='partialdef')"], "docstring": "Declare a partial that can be used in the template.\n\nUsage::\n\n    {% partialdef partial_name %}\n    Content goes here.\n    {% endpartialdef %}\n\nStore the nodelist in the context under the key \"partials\". It can be\nretrieved using the ``{% partial %}`` tag.\n\nThe optional ``inline`` argument renders t", "start_line": 1205, "end_line": 1265, "is_async": false, "is_method": false}, {"name": "partial_func", "qualified_name": "partial_func", "args": ["parser", "token"], "decorators": ["register.tag(name='partial')"], "docstring": "Render a partial previously declared with the ``{% partialdef %}`` tag.\n\nUsage::\n\n    {% partial partial_name %}", "start_line": 1269, "end_line": 1283, "is_async": false, "is_method": false}, {"name": "querystring", "qualified_name": "querystring", "args": ["context"], "decorators": ["register.simple_tag(name='querystring', takes_context=True)"], "docstring": "Build a query string using `args` and `kwargs` arguments.\n\nThis tag constructs a new query string by adding, removing, or modifying\nparameters from the given positional and keyword arguments. Positional\narguments must be mappings (such as `QueryDict` or `dict`), and\n`request.GET` is used as the star", "start_line": 1287, "end_line": 1349, "is_async": false, "is_method": false}, {"name": "regroup", "qualified_name": "regroup", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Regroup a list of alike objects by a common attribute.\n\nThis complex tag is best illustrated by use of an example: say that\n``musicians`` is a list of ``Musician`` objects that have ``name`` and\n``instrument`` attributes, and you'd like to display a list that\nlooks like:\n\n    * Guitar:\n        * Dja", "start_line": 1353, "end_line": 1417, "is_async": false, "is_method": false}, {"name": "resetcycle", "qualified_name": "resetcycle", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Reset a cycle tag.\n\nIf an argument is given, reset the last rendered cycle tag whose name\nmatches the argument, else reset the last rendered cycle tag (named or\nunnamed).", "start_line": 1421, "end_line": 1443, "is_async": false, "is_method": false}, {"name": "spaceless", "qualified_name": "spaceless", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Remove whitespace between HTML tags, including tab and newline characters.\n\nExample usage::\n\n    {% spaceless %}\n        <p>\n            <a href=\"foo/\">Foo</a>\n        </p>\n    {% endspaceless %}\n\nThis example returns this HTML::\n\n    <p><a href=\"foo/\">Foo</a></p>\n\nOnly space between *tags* is norma", "start_line": 1447, "end_line": 1474, "is_async": false, "is_method": false}, {"name": "templatetag", "qualified_name": "templatetag", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Output one of the bits used to compose template tags.\n\nSince the template system has no concept of \"escaping\", to display one of\nthe bits used in template tags, you must use the ``{% templatetag %}`` tag.\n\nThe argument tells which template bit to output:\n\n    ==================  =======\n    Argument", "start_line": 1478, "end_line": 1511, "is_async": false, "is_method": false}, {"name": "url", "qualified_name": "url", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Return an absolute URL matching the given view with its parameters.\n\nThis is a way to define links that aren't tied to a particular URL\nconfiguration::\n\n    {% url \"url_name\" arg1 arg2 %}\n\n    or\n\n    {% url \"url_name\" name1=value1 name2=value2 %}\n\nThe first argument is a URL pattern name. Other arg", "start_line": 1515, "end_line": 1584, "is_async": false, "is_method": false}, {"name": "verbatim", "qualified_name": "verbatim", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "Stop the template engine from rendering the contents of this block tag.\n\nUsage::\n\n    {% verbatim %}\n        {% don't process this %}\n    {% endverbatim %}\n\nYou can also designate a specific closing tag block (allowing the\nunrendered use of ``{% endverbatim %}``)::\n\n    {% verbatim myblock %}\n      ", "start_line": 1588, "end_line": 1607, "is_async": false, "is_method": false}, {"name": "widthratio", "qualified_name": "widthratio", "args": ["parser", "token"], "decorators": ["register.tag"], "docstring": "For creating bar charts and such. Calculate the ratio of a given value to a\nmaximum value, and then apply that ratio to a constant.\n\nFor example::\n\n    <img src=\"bar.png\" alt=\"Bar\"\n         height=\"10\"\n         width=\"{% widthratio this_value max_value max_width %}\">\n\nIf ``this_value`` is 175, ``max", "start_line": 1611, "end_line": 1650, "is_async": false, "is_method": false}, {"name": "do_with", "qualified_name": "do_with", "args": ["parser", "token"], "decorators": ["register.tag('with')"], "docstring": "Add one or more values to the context (inside of this block) for caching\nand easy access.\n\nFor example::\n\n    {% with total=person.some_sql_method %}\n        {{ total }} object{{ total|pluralize }}\n    {% endwith %}\n\nMultiple values can be added to the context::\n\n    {% with foo=1 bar=2 %}\n        .", "start_line": 1654, "end_line": 1687, "is_async": false, "is_method": false}, {"name": "csp_nonce_attr", "qualified_name": "csp_nonce_attr", "args": ["context", "media"], "decorators": ["register.simple_tag(takes_context=True)"], "docstring": "", "start_line": 1691, "end_line": 1692, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "setting", "nodelist"], "decorators": [], "docstring": "", "start_line": 51, "end_line": 53, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 55, "end_line": 63, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 69, "end_line": 70, "is_async": false, "is_method": false}, {"name": "render", "qualified_name": "render", "args": ["self", "context"], "decorators": [], "docstring": "", "start_line": 76, "end_line": 95, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_na