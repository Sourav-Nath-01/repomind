 "end_line": 111}], "calls": [], "module_docstring": "Specifying ordering\n\nSpecify default ordering for a model using the ``ordering`` attribute, which\nshould be a list or tuple of field names. This tells Django how to order\n``QuerySet`` results.\n\nIf a field name in ``ordering`` starts with a hyphen, that field will be\nordered in descending order. Otherwise, it'll be ordered in ascending order.\nThe special-case field name ``\"?\"`` specifies random order.\n\nThe ordering attribute is not required. If you leave it off, ordering will be\nundefined -- not random, just undefined.", "parse_error": ""}, {"file_path": "tests/datetimes/tests.py", "file_hash": "237254f8e4dad7bc34e66d65b33ccd804f1e2ca04430d105537d313cd0508601", "imports": [{"module": "datetime", "names": [], "is_from": false, "alias": ""}, {"module": "django.test", "names": ["TestCase", "override_settings"], "is_from": true, "alias": ""}, {"module": "django.utils", "names": ["timezone"], "is_from": true, "alias": ""}, {"module": "models", "names": ["Article", "Category", "Comment"], "is_from": true, "alias": ""}], "functions": [{"name": "test_related_model_traverse", "qualified_name": "test_related_model_traverse", "args": ["self"], "decorators": [], "docstring": "", "start_line": 10, "end_line": 89, "is_async": false, "is_method": false}, {"name": "test_21432", "qualified_name": "test_21432", "args": ["self"], "decorators": ["override_settings(USE_TZ=True)"], "docstring": "", "start_line": 92, "end_line": 96, "is_async": false, "is_method": false}, {"name": "test_datetimes_returns_available_dates_for_given_scope_and_given_field", "qualified_name": "test_datetimes_returns_available_dates_for_given_scope_and_given_field", "args": ["self"], "decorators": [], "docstring": "", "start_line": 98, "end_line": 146, "is_async": false, "is_method": false}, {"name": "test_datetimes_has_lazy_iterator", "qualified_name": "test_datetimes_has_lazy_iterator", "args": ["self"], "decorators": [], "docstring": "", "star