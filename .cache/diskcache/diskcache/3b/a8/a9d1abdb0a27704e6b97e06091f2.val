e": "Meta", "bases": [], "methods": [], "docstring": "", "start_line": 163, "end_line": 164}, {"name": "Meta", "bases": [], "methods": [], "docstring": "", "start_line": 181, "end_line": 183}, {"name": "Meta", "bases": [], "methods": [], "docstring": "", "start_line": 187, "end_line": 189}, {"name": "Meta", "bases": [], "methods": [], "docstring": "", "start_line": 223, "end_line": 224}], "calls": [], "module_docstring": "Giving models a custom manager\n\nYou can use a custom ``Manager`` in a particular model by extending the base\n``Manager`` class and instantiating your custom ``Manager`` in your model.\n\nThere are two reasons you might want to customize a ``Manager``: to add extra\n``Manager`` methods, and/or to modify the initial ``QuerySet`` the ``Manager``\nreturns.", "parse_error": ""}, {"file_path": "tests/m2m_intermediary/tests.py", "file_hash": "fbb07b811308e4722fd38df68ab02d06e13b334374b21ddd595e8b8ffbd8a800", "imports": [{"module": "datetime", "names": ["datetime"], "is_from": true, "alias": ""}, {"module": "django.test", "names": ["TestCase"], "is_from": true, "alias": ""}, {"module": "models", "names": ["Article", "Reporter", "Writer"], "is_from": true, "alias": ""}], "functions": [{"name": "test_intermediary", "qualified_name": "test_intermediary", "args": ["self"], "decorators": [], "docstring": "", "start_line": 9, "end_line": 38, "is_async": false, "is_method": false}], "classes": [{"name": "M2MIntermediaryTests", "bases": ["TestCase"], "methods": ["test_intermediary"], "docstring": "", "start_line": 8, "end_line": 38}], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "tests/m2m_intermediary/__init__.py", "file_hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "imports": [], "functions": [], "classes": [], "calls": [], "module_docstring": "", "parse_error": ""}, {"file_path": "tests/m2m_intermediary/models.py", "file_hash": "383304a013f2af5a48e7e1dc85825c57c9ad017034f5bfde0623ab5203ecdf77", "imports"