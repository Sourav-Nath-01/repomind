roup_by", "args": ["self", "allow_aliases"], "decorators": [], "docstring": "Expand the GROUP BY clause required by the query.\n\nThis will usually be the set of all non-aggregate fields in the\nreturn data. If the database backend supports grouping by the\nprimary key, and the query would be equivalent, the optimization\nwill be made automatically.", "start_line": 2411, "end_line": 2445, "is_async": false, "is_method": false}, {"name": "add_select_related", "qualified_name": "add_select_related", "args": ["self", "fields"], "decorators": [], "docstring": "Set up the select_related data structure so that we only select\ncertain related models (as opposed to all models, when\nself.select_related=True).", "start_line": 2447, "end_line": 2461, "is_async": false, "is_method": false}, {"name": "add_extra", "qualified_name": "add_extra", "args": ["self", "select", "select_params", "where", "params", "tables", "order_by"], "decorators": [], "docstring": "Add data to the various extra_* attributes for user-created additions\nto the query.", "start_line": 2463, "end_line": 2494, "is_async": false, "is_method": false}, {"name": "clear_deferred_loading", "qualified_name": "clear_deferred_loading", "args": ["self"], "decorators": [], "docstring": "Remove any fields from the deferred loading set.", "start_line": 2496, "end_line": 2498, "is_async": false, "is_method": false}, {"name": "add_deferred_loading", "qualified_name": "add_deferred_loading", "args": ["self", "field_names"], "decorators": [], "docstring": "Add the given list of model field names to the set of fields to\nexclude from loading from the database when automatic column selection\nis done. Add the new field names to any existing field names that\nare deferred (or removed from any existing field names that are marked\nas the only ones for immedia", "start_line": 2500, "end_line": 2523, "is_async": false, "is_method": false}, {"name": "add_immediate_loading", "qualified_name": "add_immediate_loading", "args": ["self", "field_names"], "decorators": [], "docstring": "Add the given list of model field names to the set of fields to\nretrieve when the SQL is executed (\"immediate loading\" fields). The\nfield names replace any existing immediate loading field names. If\nthere are field names already specified for deferred loading, remove\nthose names from the new field_n", "start_line": 2525, "end_line": 2547, "is_async": false, "is_method": false}, {"name": "set_annotation_mask", "qualified_name": "set_annotation_mask", "args": ["self", "names"], "decorators": [], "docstring": "Set the mask of annotations that will be returned by the SELECT.", "start_line": 2549, "end_line": 2566, "is_async": false, "is_method": false}, {"name": "append_annotation_mask", "qualified_name": "append_annotation_mask", "args": ["self", "names"], "decorators": [], "docstring": "", "start_line": 2568, "end_line": 2570, "is_async": false, "is_method": false}, {"name": "set_extra_mask", "qualified_name": "set_extra_mask", "args": ["self", "names"], "decorators": [], "docstring": "Set the mask of extra select items that will be returned by SELECT.\nDon't remove them from the Query since they might be used later.", "start_line": 2572, "end_line": 2581, "is_async": false, "is_method": false}, {"name": "has_select_fields", "qualified_name": "has_select_fields", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 2584, "end_line": 2585, "is_async": false, "is_method": false}, {"name": "set_values", "qualified_name": "set_values", "args": ["self", "fields"], "decorators": [], "docstring": "", "start_line": 2587, "end_line": 2660, "is_async": false, "is_method": false}, {"name": "annotation_select", "qualified_name": "annotation_select", "args": ["self"], "decorators": ["property"], "docstring": "Return the dictionary of aggregate columns that are not masked and\nshould be used in the SELECT clause. Cache this result for performance.", "start_line": 2663, "end_line": 2680, "is_async": false, "is_method": false}, {"name": "extra_select", "qualified_name": "extra_select", "args": ["self"], "decorators": ["property"], "docstring": "", "start_line": 2683, "end_line": 2694, "is_async": false, "is_method": false}, {"name": "trim_start", "qualified_name": "trim_start", "args": ["self", "names_with_path"], "decorators": [], "docstring": "Trim joins from the start of the join path. The candidates for trim\nare the PathInfos in names_with_path structure that are m2m joins.\n\nAlso set the select column so the start matches the join.\n\nThis method is meant to be used for generating the subquery joins &\ncols in split_exclude().\n\nReturn a lo", "start_line": 2696, "end_line": 2773, "is_async": false, "is_method": false}, {"name": "is_nullable", "qualified_name": "is_nullable", "args": ["self", "field"], "decorators": [], "docstring": "Check if the given field should be treated as nullable.\n\nSome backends treat '' as null and Django treats such fields as\nnullable for those backends. In such situations field.null can be\nFalse even if we should treat the field as nullable.", "start_line": 2775, "end_line": 2791, "is_async": false, "is_method": false}, {"name": "__init__", "qualified_name": "__init__", "args": ["self", "connector", "num_children", "negated"], "decorators": [], "docstring": "", "start_line": 2814, "end_line": 2827, "is_async": false, "is_method": false}, {"name": "__repr__", "qualified_name": "__repr__", "args": ["self"], "decorators": [], "docstring": "", "start_line": 2829, "end_line": 2833, "is_async": false, "is_method": false}, {"name": "add_votes", "qualified_name": "add_votes", "args": ["self", "votes"], "decorators": [], "docstring": "Add single vote per item to self.votes. Parameter can be any\niterable.", "start_line": 2835, "end_line": 2840, "is_async": false, "is_method": false}, {"name": "update_join_types", "qualified_name": "update_join_types", "args": ["self", "query"], "decorators": [], "docstring": "Change join types so that